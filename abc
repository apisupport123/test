                    </div>
                    <div class="field">
                        <label class="field-label">Emergency Contact</label>
                        <input class="field-input" type="text" name="m_stremergencycontactno" maxlength="10"
                               value="<%=emp.getM_strEmergency_contact_Number() != null ? emp.getM_strEmergency_contact_Number() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">State</label>

<%@ page pageEncoding="UTF-8" language="java" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%
 // ✅ Session check
 if(session == null || session.getAttribute("role") == null) {
     response.sendRedirect(request.getContextPath() + "/login.action");
     return;
 }

 // ✅ Cache headers
 response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate, max-age=0, private");
 response.setHeader("Pragma", "no-cache");
 response.setDateHeader("Expires", 0);
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Deployment Sheet Master</title>

  <!-- DataTables CSS -->
  <link rel="stylesheet" href="<%=request.getContextPath()%>/css/Deployment.jquery.dataTables.min.css" />
  <link rel="stylesheet" href="<%=request.getContextPath()%>/css/Deployment.buttons.dataTables.min.css" />

  <!-- Scripts -->
  <script src="<%=request.getContextPath()%>/js/Deployment.jquery-3.7.0.min.js"></script>
  <script src="<%=request.getContextPath()%>/js/Deployment.1.13.6.jquery.dataTables.min.js"></script>
  <script src="<%=request.getContextPath()%>/js/Deployment.2.4.1.dataTables.buttons.min.js"></script>
  <script src="<%=request.getContextPath()%>/js/Deployment.2.4.1.buttons.html5.min.js"></script>
  <script src="<%=request.getContextPath()%>/js/Deployment.2.4.1.buttons.print.min.js"></script>
  <script src="<%=request.getContextPath()%>/js/Deployment.3.10.1.jszip.min.js"></script>
  <script src="<%=request.getContextPath()%>/js/Deployment.0.2.7.pdfmake.min.js"></script>
  <script src="<%=request.getContextPath()%>/js/Deployment.0.2.7.vfs_fonts.js"></script>

  <style>
    /* ================================================================
       PAGE BASE — theme-aware
       ================================================================ */
    :root, [data-theme="light"] {
      --page-brand: #F86F03;
      --page-brand-light: #FFF4EC;
      --page-bg: transparent;
      --page-card: #FFFFFF;
      --page-text: #0F172A;
      --page-text-secondary: #334155;
      --page-muted: #64748B;
      --page-line: #E5E7EB;
      --page-line-strong: #CBD5E1;
      --page-hover: #F8FAFC;
      --page-header: #F8FAFC;
    }

    [data-theme="dark"] {
      --page-brand: #FF9A3D;
      --page-brand-light: rgba(248, 111, 3, 0.15);
      --page-bg: transparent;
      --page-card: #1E293B;
      --page-text: #F1F5F9;
      --page-text-secondary: #CBD5E1;
      --page-muted: #94A3B8;
      --page-line: #334155;
      --page-line-strong: #475569;
      --page-hover: #293548;
      --page-header: #1A2332;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--page-bg);
      color: var(--page-text);
      font-size: 15px;
      font-weight: 700;
      transition: color 0.3s ease;
    }

    /* ================================================================
       PAGE WRAPPER
       ================================================================ */
    .deploy-page {
      padding: 24px 28px 48px;
      max-width: 100%;
      width: 100%;
    }

    /* ================================================================
       PAGE HEADER
       ================================================================ */
    .deploy-head {
      background: var(--page-card);
      border: 1px solid var(--page-line);
      border-radius: 16px;
      padding: 22px 26px;
      margin-bottom: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .deploy-head-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .deploy-head-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--page-brand), #FFA41B);
      color: #fff;
      display: grid;
      place-items: center;
      font-size: 1.2rem;
      box-shadow: 0 8px 20px -6px var(--page-brand);
      flex-shrink: 0;
    }

    .deploy-head h1 {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.4px;
      color: var(--page-text);
      line-height: 1.2;
      margin: 0;
    }

    .deploy-head-sub {
      font-size: 0.8rem;
      color: var(--page-muted);
      font-weight: 600;
      margin-top: 3px;
    }

    .deploy-head-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* ================================================================
       BUTTONS
       ================================================================ */
    .btn {
      padding: 10px 18px;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 800;
      cursor: pointer;
      font-family: inherit;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      border: 1.5px solid transparent;
      text-decoration: none;
      line-height: 1;
      white-space: nowrap;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--page-brand), #FFA41B);
      color: #fff;
      box-shadow: 0 6px 18px -6px var(--page-brand);
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px -6px var(--page-brand);
      color: #fff;
    }

    .btn-ghost {
      background: var(--page-card);
      color: var(--page-text-secondary);
      border-color: var(--page-line-strong);
    }
    .btn-ghost:hover {
      border-color: var(--page-brand);
      color: var(--page-brand);
      background: var(--page-brand-light);
    }

    .btn-success {
      background: linear-gradient(135deg, #10B981, #059669);
      color: #fff;
      box-shadow: 0 6px 18px -6px #10B981;
    }
    .btn-success:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px -6px #10B981;
      color: #fff;
    }

    /* ================================================================
       ACTION BAR
       ================================================================ */
    .deploy-actions {
      background: var(--page-card);
      border: 1px solid var(--page-line);
      border-radius: 16px;
      padding: 16px 20px;
      margin-bottom: 20px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: center;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .file-input-wrap {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      flex: 1;
      min-width: 240px;
    }

    #fileInput {
      display: none;
    }

    .file-label {
      flex: 1;
      padding: 10px 16px;
      background: var(--page-hover);
      border: 1.5px dashed var(--page-line-strong);
      border-radius: 10px;
      color: var(--page-muted);
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: all 0.2s ease;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .file-label:hover {
      border-color: var(--page-brand);
      color: var(--page-brand);
      background: var(--page-brand-light);
    }
    .file-label i { font-size: 1rem; flex-shrink: 0; }
    .file-label span { overflow: hidden; text-overflow: ellipsis; }

    /* ================================================================
       TABLE CARD
       ================================================================ */
    .deploy-table-card {
      background: var(--page-card);
      border: 1px solid var(--page-line);
      border-radius: 16px;
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
      overflow: hidden;
    }

    .deploy-table-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.9rem;
      font-weight: 800;
      color: var(--page-text);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 16px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--page-line);
    }

    .deploy-table-title i {
      color: var(--page-brand);
      font-size: 1rem;
    }

    .deploy-table-title .count-badge {
      margin-left: auto;
      background: var(--page-brand-light);
      color: var(--page-brand);
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.72rem;
      font-weight: 800;
    }

    /* ================================================================
       DATATABLE — PROPER LINE STYLING
       ================================================================ */
    .dataTables_wrapper {
      width: 100%;
      overflow-x: auto;
      color: var(--page-text);
      font-family: inherit;
    }

    /* Top controls */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
      margin-bottom: 12px;
      font-size: 0.85rem;
      color: var(--page-muted);
    }

    .dataTables_wrapper .dataTables_filter input {
      padding: 8px 12px;
      border: 1.5px solid var(--page-line-strong);
      border-radius: 8px;
      background: var(--page-card);
      color: var(--page-text);
      font-family: inherit;
      font-weight: 700;
      font-size: 0.85rem;
      outline: none;
      margin-left: 8px;
      transition: all 0.2s ease;
    }

    .dataTables_wrapper .dataTables_filter input:focus {
      border-color: var(--page-brand);
      box-shadow: 0 0 0 3px var(--page-brand-light);
    }

    .dataTables_wrapper .dataTables_length select {
      padding: 6px 10px;
      border: 1.5px solid var(--page-line-strong);
      border-radius: 8px;
      background: var(--page-card);
      color: var(--page-text);
      font-family: inherit;
      font-weight: 700;
      outline: none;
      margin: 0 6px;
    }

    /* Table base */
    table.dataTable {
      width: 100% !important;
      border-collapse: separate !important;
      border-spacing: 0;
      color: var(--page-text) !important;
      font-family: inherit;
      margin: 0 !important;
      font-size: 0.82rem;
    }

    /* Header cells — proper lines */
    table.dataTable thead th {
      background-color: var(--page-header) !important;
      color: var(--page-text-secondary) !important;
      font-weight: 800 !important;
      font-size: 0.72rem !important;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 14px 14px !important;
      border-bottom: 2px solid var(--page-line-strong) !important;
      border-top: none !important;
      border-left: none !important;
      border-right: none !important;
      white-space: nowrap;
      vertical-align: middle;
      text-align: left;
      position: relative;
    }

    /* Body cells — proper lines */
    table.dataTable tbody td {
      padding: 12px 14px !important;
      border-bottom: 1px solid var(--page-line) !important;
      border-top: none !important;
      border-left: none !important;
      border-right: none !important;
      color: var(--page-text) !important;
      font-weight: 700;
      font-size: 0.82rem;
      white-space: nowrap;
      vertical-align: middle;
      text-align: left;
      background-color: var(--page-card);
      transition: background-color 0.15s ease;
    }

    /* Row hover */
    table.dataTable tbody tr:hover td {
      background-color: var(--page-hover) !important;
    }

    /* Last row — remove bottom border */
    table.dataTable tbody tr:last-child td {
      border-bottom: none !important;
    }

    /* Header sort icons */
    table.dataTable thead th.sorting:after,
    table.dataTable thead th.sorting_asc:after,
    table.dataTable thead th.sorting_desc:after {
      opacity: 0.4;
    }

    /* Empty table */
    table.dataTable tbody td.dataTables_empty {
      text-align: center;
      padding: 40px 20px !important;
      color: var(--page-muted);
      font-style: italic;
      font-weight: 600;
    }

    /* Scroll wrapper */
    .dataTables_scroll {
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--page-line);
    }

    .dataTables_scrollHead {
      background: var(--page-header);
    }

    .dataTables_scrollBody {
      border-bottom: none !important;
    }

    .dataTables_scrollBody table tbody td {
      border-bottom: 1px solid var(--page-line) !important;
    }

    /* ================================================================
       PAGINATION
       ================================================================ */
    .dataTables_wrapper .dataTables_paginate {
      margin-top: 16px;
      padding-top: 12px;
      border-top: 1px solid var(--page-line);
      display: flex;
      justify-content: flex-end;
      gap: 4px;
      flex-wrap: wrap;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
      padding: 7px 12px !important;
      border-radius: 8px !important;
      border: 1.5px solid var(--page-line-strong) !important;
      background: var(--page-card) !important;
      color: var(--page-text-secondary) !important;
      font-weight: 800 !important;
      font-size: 0.8rem !important;
      cursor: pointer;
      transition: all 0.2s ease;
      margin: 0 2px;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
      background: var(--page-brand-light) !important;
      border-color: var(--page-brand) !important;
      color: var(--page-brand) !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
      background: linear-gradient(135deg, var(--page-brand), #FFA41B) !important;
      border-color: var(--page-brand) !important;
      color: #fff !important;
      box-shadow: 0 4px 12px -3px var(--page-brand);
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
      opacity: 0.4 !important;
      cursor: not-allowed !important;
      background: var(--page-card) !important;
      color: var(--page-muted) !important;
      border-color: var(--page-line) !important;
    }

    /* Info text */
    .dataTables_wrapper .dataTables_info {
      font-size: 0.78rem;
      color: var(--page-muted);
      font-weight: 700;
      padding-top: 12px;
    }

    /* ================================================================
       EXPORT BUTTONS
       ================================================================ */
    .dt-buttons {
      display: flex;
      gap: 8px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .dt-buttons button,
    .dt-buttons .dt-button {
      background: var(--page-card) !important;
      color: var(--page-text-secondary) !important;
      border: 1.5px solid var(--page-line-strong) !important;
      padding: 9px 16px !important;
      border-radius: 10px !important;
      font-weight: 800 !important;
      font-size: 0.82rem !important;
      cursor: pointer;
      font-family: inherit !important;
      transition: all 0.2s ease;
      display: inline-flex !important;
      align-items: center;
      gap: 6px;
      box-shadow: none !important;
    }

    .dt-buttons button:hover,
    .dt-buttons .dt-button:hover {
      background: var(--page-brand-light) !important;
      border-color: var(--page-brand) !important;
      color: var(--page-brand) !important;
      transform: translateY(-1px);
      box-shadow: none !important;
    }

    /* ================================================================
       PUSH BUTTON (bottom)
       ================================================================ */
    .push-wrap {
      margin-top: 20px;
      text-align: center;
    }

    /* ================================================================
       RESPONSIVE
       ================================================================ */
    @media (max-width: 900px) {
      .deploy-page { padding: 16px 14px 32px; }
      .deploy-head { padding: 16px 18px; }
      .deploy-head h1 { font-size: 1.1rem; }
      .deploy-head-icon { width: 42px; height: 42px; font-size: 1rem; }
      .deploy-actions { flex-direction: column; align-items: stretch; }
      .file-input-wrap { width: 100%; }
    }

    @media (max-width: 480px) {
      .deploy-head-right { width: 100%; }
      .deploy-head-right .btn { flex: 1; justify-content: center; }
      .btn { padding: 9px 14px; font-size: 0.8rem; }
    }
  </style>
</head>
<body>

<%@include file="./userheader.jsp"%>

<div class="new-wrapper">
<div class="deploy-page">

  <!-- ================================================================
       PAGE HEADER
       ================================================================ -->
  <div class="deploy-head">
    <div class="deploy-head-left">
      <div class="deploy-head-icon">
        <i class="fas fa-rocket"></i>
      </div>
      <div>
        <h1>Deployment Sheet Master</h1>
        <div class="deploy-head-sub">Upload, review and push deployment records</div>
      </div>
    </div>
    <div class="deploy-head-right">
      <a href="<%=request.getContextPath()%>/XMLFile/Deployment_Sample_Format.xlsx"
         class="btn btn-ghost" download>
        <i class="fas fa-download"></i> Sample Format
      </a>
    </div>
  </div>

  <!-- ================================================================
       UPLOAD + ACTIONS
       ================================================================ -->
  <div class="deploy-actions">
    <div class="file-input-wrap">
      <label for="fileInput" class="file-label">
        <i class="fas fa-paperclip"></i>
        <span id="fileNameLabel">Choose Excel file (.xlsx)</span>
      </label>
      <input type="file" id="fileInput" name="file" accept=".xlsx,.xls" />
    </div>
    <button type="button" class="btn btn-primary" id="submitFileBtn">
      <i class="fas fa-cloud-upload-alt"></i> Submit
    </button>
  </div>

  <!-- ================================================================
       TABLE CARD
       ================================================================ -->
  <div class="deploy-table-card">
    <div class="deploy-table-title">
      <i class="fas fa-table"></i>
      Deployment Records
      <span class="count-badge" id="rowCountBadge">0</span>
    </div>

    <table id="deploymentTable" class="display nowrap" style="width:100%">
      <thead>
        <tr>
          <th>EXP URL</th>
          <th>EXP URL W.R.T SYS URL</th>
          <th>API_NAME</th>
          <th>SOURCE_ID</th>
          <th>Broker</th>
          <th>Broker EG</th>
          <th>New/Existing/NBC</th>
          <th>Hits in Production</th>
          <th>Failure (More than 50%)</th>
          <th>Success</th>
          <th>Changes Description</th>
          <th>Remarks</th>
          <th>Deployment Date Time</th>
        </tr>
      </thead>
      <tbody>
        <c:forEach var="row" items="${deploymentData}">
          <tr>
            <td>${row.EXP_URL}</td>
            <td>${row.SYS_URL}</td>
            <td>${row.API_NAME}</td>
            <td>${row.SOURCE_ID}</td>
            <td>${row.BROKER}</td>
            <td>${row.BROKER_EG}</td>
            <td>${row.STATUS}</td>
            <td>${row.HITS}</td>
            <td>${row.FAILURE}</td>
            <td>${row.SUCCESS}</td>
            <td>${row.CHANGES_DESC}</td>
            <td>${row.REMARKS}</td>
            <td>${row.DEPLOYMENT_DATE}</td>
          </tr>
        </c:forEach>
      </tbody>
    </table>
  </div>

  <!-- ================================================================
       PUSH BUTTON
       ================================================================ -->
  <div class="push-wrap">
    <button type="button" class="btn btn-success" id="pushDataBtn">
      <i class="fas fa-arrow-up"></i> Push Data to Main Table
    </button>
  </div>

</div>
</div>

<script>
  $(document).ready(function () {

    // ============================================================
    // DATATABLE INIT
    // ============================================================
    const table = $('#deploymentTable').DataTable({
      dom: 'Bfrtip',
      paging: true,
      scrollX: true,
      responsive: false,
      pageLength: 15,
      searching: true,
      ordering: true,
      order: [],
      lengthChange: false,
      language: {
        search: '',
        searchPlaceholder: 'Search records...',
        emptyTable: 'No deployment records found',
        info: 'Showing _START_–_END_ of _TOTAL_ entries',
        infoEmpty: 'No entries',
        infoFiltered: '(filtered from _MAX_ total)',
        zeroRecords: 'No matching records found',
        paginate: {
          previous: '‹',
          next: '›'
        }
      },
      buttons: [
        {
          extend: 'excelHtml5',
          text: '<i class="fas fa-file-excel"></i> Export Excel',
          exportOptions: { columns: ':visible' }
        },
        {
          extend: 'pdfHtml5',
          text: '<i class="fas fa-file-pdf"></i> Export PDF',
          exportOptions: { columns: ':visible' },
          orientation: 'landscape',
          pageSize: 'A4'
        }
      ],
      initComplete: function () {
        updateRowCount();
      },
      drawCallback: function () {
        updateRowCount();
      }
    });

    // Update row count badge
    function updateRowCount() {
      const count = table.rows().count();
      $('#rowCountBadge').text(count);
    }

    // ============================================================
    // FILE INPUT LABEL UPDATE
    // ============================================================
    $('#fileInput').on('change', function () {
      const file = this.files[0];
      if (file) {
        $('#fileNameLabel').text(file.name);
      } else {
        $('#fileNameLabel').text('Choose Excel file (.xlsx)');
      }
    });

    // ============================================================
    // SUBMIT FILE
    // ============================================================
    $('#submitFileBtn').on('click', function () {
      const file = $('#fileInput')[0].files[0];
      if (!file) {
        alert("Please choose a file first!");
        return;
      }

      const $btn = $(this);
      const originalHtml = $btn.html();
      $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Uploading...');

      const formData = new FormData();
      formData.append("file", file);
      formData.append("action", "upload");

      $.ajax({
        url: '<%=request.getContextPath()%>/DeploymentSheetServlet',
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: function (res) {
          alert(res);
          window.location.href = '<%=request.getContextPath()%>/DeploymentSheetServlet';
        },
        error: function () {
          alert("Upload failed. Please try again.");
          $btn.prop('disabled', false).html(originalHtml);
        }
      });
    });

    // ============================================================
    // PUSH DATA
    // ============================================================
    $('#pushDataBtn').on('click', function () {
      if (!confirm('Push all records to the main table? This action cannot be undone.')) {
        return;
      }

      const $btn = $(this);
      const originalHtml = $btn.html();
      $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Pushing...');

      $.ajax({
        url: '<%=request.getContextPath()%>/DeploymentSheetServlet',
        type: "POST",
        data: { action: "push" },
        success: function (res) {
          alert(res);
          window.location.href = '<%=request.getContextPath()%>/DeploymentSheetServlet';
        },
        error: function () {
          alert("Error occurred while pushing data!");
          $btn.prop('disabled', false).html(originalHtml);
        }
      });
    });

  });
</script>

</body>
</html>

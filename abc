/* ============================================================
   Drill-down
   ============================================================ */
function updateChart(p) {
    var idx = p.nodeindex;
    if (!nameArr[idx]) return;
    var url = '<%=request.getContextPath() + "/jsp/TransactionEndPointWiseService_new.jsp?txnEndPoint="%>' + encodeURIComponent(nameArr[idx]);
    window.open(url, '_blank');
}

/* ============================================================
   Render
   ============================================================ */
zingchart.render({
    id: 'myChart',
    data: buildChartConfig(),
    height: '100%',
    width: '100%'
});

zingchart.bind('myChart', 'node_click', updateChart);

/* ============================================================
   Theme change — chart re-render (no page reload)
   ============================================================ */
function reRenderChart() {
    try { zingchart.exec('myChart', 'destroy'); } catch(e) {}
    setTimeout(function() {
        zingchart.render({
            id: 'myChart',
            data: buildChartConfig(),
            height: '100%',
            width: '100%'
        });
        zingchart.bind('myChart', 'node_click', updateChart);
    }, 100);
}

var _lastTheme = document.documentElement.getAttribute('data-theme') || 'light';
setInterval(function() {
    var now = document.documentElement.getAttribute('data-theme') || 'light';
    if (now !== _lastTheme) {
        _lastTheme = now;
        reRenderChart();
    }
}, 500);
</script>

<!-- ============ COUNTDOWN ============ -->
<script>
function countdown(elementName, minutes, seconds) {
    var element, endTime;

    function twoDigits(n) {
        return (n <= 9 ? "0" + n : n);
    }

    function updateTimer() {
        var msLeft = endTime - (+new Date);
        if (msLeft < 1000) {
            element.innerHTML = "Refreshing…";
        } else {
            var time = new Date(msLeft);
            var hours = time.getUTCHours();
            var mins = time.getUTCMinutes();
            element.innerHTML = (hours ? hours + ':' + twoDigits(mins) : mins) + ':' + twoDigits(time.getUTCSeconds());
            setTimeout(updateTimer, time.getUTCMilliseconds() + 500);
        }
    }

    element = document.getElementById(elementName);
    endTime = (+new Date) + 1000 * (60 * minutes + seconds) + 500;
    updateTimer();
}

countdown("ten-countdown", 10, 0);
</script>


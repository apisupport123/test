public String formatAPINameWithLineBreaks(String apiName) {
if (apiName == null || apiName.isEmpty()) {
return "";
}
apiName = apiName.replace("_", " ");
if (apiName.length() <= 16) {
return apiName;
}
StringBuilder formatted = new StringBuilder();
for (int i = 0; i < apiName.length(); i += 16) {
if (i > 0) {
formatted.append("</p><br><p style='color:#FFFFFF; font-weight: bolder;font-size: 15px'>");
}
int endIndex = Math.min(i + 16, apiName.length());
formatted.append(apiName.substring(i, endIndex));
}
return formatted.toString();
}

public String formatBrokerNameOnly(String brokerName) {
if (brokerName == null || brokerName.trim().isEmpty()) {
return "<span style='color:#FFA500; font-weight:bold; font-size:13px;'>N/A</span>";
}
return "<span style='color:#FFA500; font-weight:bold; font-size:13px;'>" + brokerName + "</span>";
}

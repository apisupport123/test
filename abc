<style>
:root{
  --brand:#F86F03;
  --brand-2:#FF9A3D;
  --brand-light:#FFF4EC;
  --brand-glow:rgba(248,111,3,.4);
  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F7F7F5;
  --card:#FFFFFF;
  --hero-dark:#1A1A1A;
  --hero-dark-2:#2A2A2A;

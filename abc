  --ml-accent:#EC4899;
  --ml-accent-2:#F472B6;

  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F5F7FA;
  --card:#FFFFFF;

  --sidebar-bg:#1A0B2E;
  --sidebar-text:#C4B5FD;
  --sidebar-hover:#2D1854;
  --sidebar-active:#7C3AED;

  --topnav-bg:rgba(255,255,255,.95);
  --topnav-h:64px;
  --sidebar-w:260px;

  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;

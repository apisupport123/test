<!DOCTYPE html>
<html>
   <head>
      <meta charset="UTF-8">
      <title>Registration Details</title>
      <%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
      <%@ taglib uri="http://struts.apache.org/tags-html" prefix="html" %>
      <%@ taglib uri="http://struts.apache.org/tags-bean" prefix="bean" %>
      <%@ taglib uri="http://struts.apache.org/tags-logic" prefix="logic" %>
      <!DOCTYPE html>
      <html>
         <head>
            <meta charset="UTF-8">
            <title>Registration Details</title>
            <meta name="viewport" content="width=device-width, initial-scale=1">
            <!-- Bootstrap 5 CSS -->
            <link href="./css/Reg_bootstrap.min.css" rel="stylesheet">
            <!-- DataTables CSS -->
            <link href="./css/Reg_dataTables.bootstrap5.min.css" rel="stylesheet">
            <!-- Font Awesome for icons -->
            <link rel="stylesheet" href="./css/all.min.css" />
            <style>
               body {
               background: url('images/image_processing20210528-29044-wrqyaj.gif') no-repeat center center fixed;
               background-size: cover;
               font-family: 'Segoe UI', sans-serif;

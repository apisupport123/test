<style>
/* ============ PAGE BASE ============ */
body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    background: var(--bg) !important;
    color: var(--ink) !important;
    margin: 0 !important;
    padding: 0 !important;
}

.page-container {
    padding: 28px 32px 48px;
    max-width: 1600px;
    margin: 0 auto;
}

/* ============ PAGE HEADER ============ */
.page-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
}
.page-head .ttl-wrap { flex: 1; min-width: 260px; }
.page-head .ttl {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 800;
    font-size: 1.65rem;
    letter-spacing: -0.6px;
    color: var(--ink);
    line-height: 1.2;
    margin: 0;
}
.page-head .ttl .ttl-icon {
    width: 44px; height: 44px;
    display: grid; place-items: center;
    background: var(--brand-light);
    color: var(--brand);
    border-radius: 12px;
    font-size: 1.05rem;
    flex-shrink: 0;
}
html[data-theme="dark"] .page-head .ttl .ttl-icon {
    background: rgba(248,111,3,.15);
}
.page-head .sub {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 6px 0 0 56px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}
.refresh-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    background: var(--brand-light);
    color: var(--brand);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
}
html[data-theme="dark"] .refresh-badge {
    background: rgba(248,111,3,.15);
}
.refresh-badge .timer {
    font-family: 'JetBrains Mono', Consolas, monospace;
    font-weight: 700;
    font-size: 0.85rem;
}

.btn-manual {
    padding: 11px 22px;
    border-radius: 11px;
    font-weight: 700;
    font-size: 0.82rem;
    border: none;
    background: #F59E0B;
    color: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: inherit;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    box-shadow: 0 4px 14px -4px #F59E0B;
}
.btn-manual:hover {
    background: #D97706;
    transform: translateY(-1px);
    box-shadow: 0 8px 22px -6px #F59E0B;
}

/* ============ SECTION ============ */
.section {
    margin-bottom: 32px;
}
.section-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
}
.section-head .s-icon {
    width: 34px; height: 34px;
    display: grid; place-items: center;
    background: var(--brand-light);
    color: var(--brand);
    border-radius: 10px;
    font-size: 0.85rem;
    flex-shrink: 0;
}
html[data-theme="dark"] .section-head .s-icon {
    background: rgba(248,111,3,.15);
}
.section-head h3 {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.3px;
    margin: 0;
}
.section-head .count-badge {
    margin-left: auto;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
    background: var(--card);
    border: 1px solid var(--line);
    padding: 4px 12px;
    border-radius: 999px;
}

/* ============ CARD GRID ============ */
.card-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
}

.card {
    width: auto !important;
    height: auto !important;
    margin: 0 !important;
    min-height: 150px;
    border-radius: 14px !important;
    box-shadow: 0 2px 12px rgba(0,0,0,.05) !important;
    transition: all 0.25s ease;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    border: none !important;
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 20px;
}

.card::before {
    content: "";
    position: absolute;
    top: -60px; right: -60px;
    width: 140px; height: 140px;
    border-radius: 50%;
    background: rgba(255,255,255,.1);
    transition: all .4s ease;
    pointer-events: none;
}
.card:hover::before {
    transform: scale(1.5);
    opacity: .25;
}
.card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px -12px rgba(0,0,0,.25) !important;
}

.card-zero {
    background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%) !important;
}
.card-zero:hover {
    background: linear-gradient(135deg, #B91C1C 0%, #991B1B 100%) !important;
}
.card-nonzero {
    background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%) !important;
}
.card-nonzero:hover {
    background: linear-gradient(135deg, #1D4ED8 0%, #1E40AF 100%) !important;
}

.card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    position: relative;
    z-index: 2;
    padding: 0 !important;
}
.card-info {
    font-size: 0.9rem;
}
.card-title {
    font-weight: 800 !important;
    font-size: 0.95rem !important;
    margin-bottom: 10px !important;
    color: #fff;
    letter-spacing: -0.3px;
    line-height: 1.3;
    word-break: break-word;
}
.card-text {
    font-size: 0.78rem !important;
    margin: 3px 0 !important;
    opacity: .92;
    font-weight: 500;
}
.card-text b {
    font-weight: 800;
}

.card-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 3;
}
.card-zero .card-badge {
    background: rgba(255,255,255,.2);
    color: #fff;
}
.card-nonzero .card-badge {
    background: rgba(255,255,255,.2);
    color: #fff;
}

/* ============ EMPTY STATE ============ */
.empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 40px 20px;
    color: var(--muted);
    background: var(--card);
    border: 1px dashed var(--line);
    border-radius: 14px;
    font-size: 0.85rem;
}
.empty-state i {
    font-size: 2rem;
    color: var(--brand);
    opacity: .4;
    display: block;
    margin-bottom: 10px;
}

/* ============ MODAL (theme-aware) ============ */
.modal-content {
    background: var(--card) !important;
    border: 1px solid var(--line) !important;
    border-radius: 18px !important;
    color: var(--ink) !important;
}
.modal-header {
    border-bottom: 1px solid var(--line) !important;
    padding: 16px 20px !important;
}
.modal-title {
    color: var(--ink) !important;
    font-weight: 800 !important;
}
.modal-body {
    padding: 18px 20px !important;
    color: var(--ink) !important;
}
.modal-body p {
    color: var(--ink);
    font-size: 0.85rem;
    margin-bottom: 8px;
}
.modal-body strong {
    color: var(--muted);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    display: block;
    margin-bottom: 4px;
}
.modal-body .form-control {
    background: var(--bg) !important;
    border: 1.5px solid var(--line) !important;
    border-radius: 10px !important;
    color: var(--ink) !important;
    font-family: inherit;
    font-size: 0.85rem;
    padding: 10px 12px;
}
.modal-body .form-control:focus {
    border-color: var(--brand) !important;
    box-shadow: 0 0 0 4px rgba(248,111,3,.12) !important;
    background: var(--card) !important;
    color: var(--ink) !important;
}
.modal-footer {
    border-top: 1px solid var(--line) !important;
    padding: 14px 20px !important;
}
.modal-footer .btn-primary {
    background: var(--brand) !important;
    border: none !important;
    border-radius: 10px !important;
    padding: 10px 24px !important;
    font-weight: 700 !important;
    font-size: 0.82rem !important;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    box-shadow: 0 4px 14px -4px var(--brand) !important;
}
.modal-footer .btn-primary:hover {
    background: var(--brand-2) !important;
    transform: translateY(-1px);
}
.modal-header .close {
    color: var(--muted) !important;
    opacity: 1 !important;
    font-size: 1.5rem;
    text-shadow: none !important;
    outline: none;
}
.modal-header .close:hover {
    color: var(--ink) !important;
}

/* ============ RESPONSIVE ============ */
@media (max-width: 900px) {
    .page-container { padding: 20px 16px 32px; }
    .page-head .ttl { font-size: 1.3rem; }
    .page-head .ttl .ttl-icon { width: 38px; height: 38px; font-size: .9rem; }
    .page-head .sub { margin-left: 50px; font-size: 0.82rem; }
    .card-container { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
}
@media (max-width: 500px) {
    .card-container { grid-template-columns: 1fr 1fr; gap: 10px; }
    .card { min-height: 130px; padding: 16px; }
    .card-title { font-size: 0.82rem !important; }
    .card-text { font-size: 0.72rem !important; }
}
</style>


  padding:3px 7px;background:var(--sidebar-hover);
  border:1px solid var(--line);border-radius:6px;
  font-size:.68rem;font-weight:600;color:var(--muted);
}
.tn-right{margin-left:auto;display:flex;align-items:center;gap:10px}
.tn-btn{
  width:36px;height:36px;
  display:grid;place-items:center;
  background:transparent;border:1px solid var(--line);
  border-radius:9px;color:var(--ink);
  cursor:pointer;font-size:.85rem;
  transition:all .15s ease;text-decoration:none;
}
.tn-btn:hover{background:var(--brand);border-color:var(--brand);color:#fff}
.tn-avatar{
  width:36px;height:36px;border-radius:50%;
  background:linear-gradient(135deg,var(--brand),var(--brand-2));
  display:grid;place-items:center;color:#fff;
  font-weight:700;font-size:.85rem;cursor:pointer;
  border:2px solid var(--card);
  box-shadow:0 2px 8px rgba(0,0,0,.08);
}

.new-wrapper{
  margin-left:var(--sidebar-w);
  padding-top:var(--topnav-h);
  transition:margin-left .3s cubic-bezier(.4,0,.2,1);
  min-height:100vh;
}
html.sb-collapsed .new-wrapper{
  margin-left:0;
}

.sb-overlay{
  position:fixed;inset:0;
  background:rgba(10,10,10,.4);
  backdrop-filter:blur(2px);
  z-index:55;opacity:0;pointer-events:none;
  transition:opacity .25s ease;
}
html.sb-open .sb-overlay{opacity:1;pointer-events:auto}

@media (max-width:900px){
  .sidebar{transform:translateX(-100%);box-shadow:0 0 40px rgba(0,0,0,.1)}
  html.sb-open .sidebar{transform:translateX(0)}
  .topnav{left:0}
  .tn-toggle{display:grid;place-items:center}
  .tn-menu-btn{display:none}
  .new-wrapper{margin-left:0}
  .sb-collapse-btn{display:none}
}
</style>

<%--
  ✅ BOOT SCRIPT
  1. Theme: DEFAULT DARK (agar user ne manually set nahi kiya)
  2. Sidebar: Login ke turant baad OPEN, link click pe CLOSED
--%>
<script>
(function(){
  try{
    // ---- ✅ Theme: DEFAULT DARK ----
    var t = localStorage.getItem('eis-theme');
    if(!t){
      t = 'dark';                                      // ✅ pehli baar DARK
      localStorage.setItem('eis-theme', 'dark');
    }
    document.documentElement.setAttribute('data-theme', t);

    // ---- ✅ Sidebar: login ke baad open, warna closed ----
    // 'eis-login-fresh' flag login action se set hoga (sessionStorage)
    // Agar flag present hai → sidebar OPEN
    // Warna (navigate kiya) → sidebar CLOSED
    var freshLogin = sessionStorage.getItem('eis-login-fresh');
    if (freshLogin === '1') {
      // ✅ Login ke turant baad — sidebar OPEN
      sessionStorage.removeItem('eis-login-fresh');
      // koi class add nahi karo — default open
    } else {
      // ❌ Normal navigation — sidebar CLOSED
      document.documentElement.classList.add('sb-collapsed');
    }
  }catch(e){
    // safe fallback
    document.documentElement.classList.add('sb-collapsed');
  }
})();
</script>


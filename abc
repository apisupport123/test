<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>EIS Portal — Sign In</title>
<script src="<%=request.getContextPath()%>/js/jquery.min.js"></script>
<style>
:root{
  --brand:#F86F03;
  --brand-2:#FF9A3D;
  --brand-light:#FFF4EC;
  --brand-glow:rgba(248,111,3,.35);
  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#FFFFFF;
  --card:#FFFFFF;
  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
html[data-theme="dark"]{
  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#272727;
  --bg:#0F0F0F;
  --card:#161616;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{
  height:100%;
  overflow:hidden;
}
body{
  font-family:var(--font-stack);
  font-weight:700;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  transition:background .3s ease,color .3s ease;
}
a{color:inherit;text-decoration:none}
h1,h2,h3,h4,h5,h6,strong,b{font-weight:800;letter-spacing:-.3px}

.icon-svg{
  width:16px;height:16px;
  display:inline-block;flex-shrink:0;
  stroke:currentColor;fill:none;
  stroke-width:2.2;
  stroke-linecap:round;stroke-linejoin:round;
}

/* ============ MAIN SPLIT LAYOUT ============ */
.shell{
  position:relative;
  width:100vw;
  height:100vh;
  display:grid;
  grid-template-columns: 1.1fr 1fr;
}

/* ============ LEFT: BRAND PANEL (Value Proposition) ============ */
.brand-side{
  background:linear-gradient(135deg, #0F0F0F 0%, #1A1A1A 100%);
  padding:56px 64px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  position:relative;
  overflow:hidden;
  color:#fff;
}
.brand-side::before{
  content:"";
  position:absolute;
  top:-150px;right:-150px;
  width:500px;height:500px;
  border-radius:50%;
  background:radial-gradient(circle, rgba(248,111,3,.25) 0%, transparent 70%);
}
.brand-side::after{
  content:"";
  position:absolute;
  bottom:-200px;left:-100px;
  width:400px;height:400px;
  border-radius:50%;
  background:radial-gradient(circle, rgba(255,154,61,.15) 0%, transparent 70%);
}

.brand-logo{
  display:flex;align-items:center;gap:14px;
  font-weight:900;font-size:1.15rem;
  letter-spacing:-.5px;
  position:relative;z-index:2;
  text-transform:uppercase;
}
.brand-logo-mark{
  width:44px;height:44px;
  background:linear-gradient(135deg, var(--brand), var(--brand-2));
  display:grid;place-items:center;
  border-radius:12px;
  box-shadow:0 10px 28px -8px var(--brand);
  position:relative;
  flex-shrink:0;
}
.brand-logo-mark::after{
  content:"";
  position:absolute;
  inset:0;
  border-radius:12px;
  border:2px solid var(--brand);
  opacity:.3;
  animation:ping 2.5s ease-out infinite;
}
@keyframes ping{
  0%{transform:scale(1);opacity:.5}
  100%{transform:scale(1.4);opacity:0}
}
.brand-logo-mark .icon-svg{width:20px;height:20px;stroke-width:2.6}
.brand-logo-text{
  display:flex;
  flex-direction:column;
  gap:1px;
}
.brand-logo-text .top{font-size:1.05rem;font-weight:900;letter-spacing:.4px}
.brand-logo-text .sub{font-size:.65rem;font-weight:700;color:var(--brand);letter-spacing:1.8px;text-transform:uppercase}

.brand-content{
  position:relative;z-index:2;
  max-width:500px;
}
.brand-eyebrow{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:6px 14px;
  background:rgba(248,111,3,.12);
  border:1px solid rgba(248,111,3,.3);
  border-radius:999px;
  font-size:.68rem;
  font-weight:800;
  color:var(--brand);
  letter-spacing:1.2px;
  text-transform:uppercase;
  margin-bottom:24px;
}
.brand-eyebrow .dot{
  width:6px;height:6px;
  border-radius:50%;
  background:var(--brand);
  box-shadow:0 0 10px var(--brand);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

.brand-content h1{
  font-size:2.8rem;
  font-weight:900;
  line-height:1.1;
  letter-spacing:-1.5px;
  margin-bottom:20px;
  color:#fff;
}
.brand-content h1 .grad{
  background:linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  display:inline-block;
}
.brand-content p{
  font-size:1rem;
  line-height:1.7;
  color:rgba(255,255,255,.7);
  font-weight:600;
  max-width:440px;
}

.brand-features{
  display:flex;
  flex-direction:column;
  gap:12px;
  margin-top:32px;
  max-width:440px;
}
.feature{
  display:flex;align-items:center;gap:12px;
  font-size:.85rem;
  font-weight:700;
  color:rgba(255,255,255,.85);
  padding:12px 16px;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.08);
  border-radius:12px;
  transition:all .2s ease;
}
.feature:hover{
  background:rgba(248,111,3,.1);
  border-color:rgba(248,111,3,.3);
}
.feature .ficon{
  width:28px;height:28px;
  display:grid;place-items:center;
  background:rgba(248,111,3,.15);
  color:var(--brand);
  border-radius:8px;
  flex-shrink:0;
}
.feature .ficon .icon-svg{width:14px;height:14px;stroke-width:2.6}

.brand-footer{
  position:relative;z-index:2;
  font-size:.75rem;
  color:rgba(255,255,255,.5);
  font-weight:700;
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:8px;
}
.brand-footer .status{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:.68rem;
  color:#4ADE80;
  letter-spacing:1px;
  text-transform:uppercase;
}
.brand-footer .status .dot{
  width:6px;height:6px;
  border-radius:50%;
  background:#4ADE80;
  box-shadow:0 0 8px #4ADE80;
  animation:pulse 2s ease-in-out infinite;
}

/* ============ RIGHT: FORM PANEL ============ */
.form-side{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:48px 56px;
  background:var(--bg);
  position:relative;
  overflow-y:auto;
}
.form-side::-webkit-scrollbar{width:6px}
.form-side::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}

.form-wrap{
  width:100%;
  max-width:400px;
}

.form-head{
  margin-bottom:28px;
}
.form-head .step{
  font-size:.68rem;
  font-weight:800;
  color:var(--brand);
  letter-spacing:1.8px;
  text-transform:uppercase;
  margin-bottom:10px;
  display:flex;
  align-items:center;
  gap:8px;
}
.form-head .step::before{
  content:"";
  width:20px;height:2px;
  background:var(--brand);
  border-radius:2px;
}
.form-head h2{
  font-size:1.9rem;
  font-weight:900;
  letter-spacing:-.7px;
  margin-bottom:8px;
  color:var(--ink);
}
.form-head p{
  color:var(--muted);
  font-size:.88rem;
  font-weight:700;
}

.tabs{
  display:flex;
  gap:4px;
  background:var(--bg);
  padding:4px;
  border-radius:12px;
  margin-bottom:24px;
  border:1px solid var(--line);
}
.tab{
  flex:1;
  padding:11px;
  border:none;
  background:transparent;
  color:var(--muted);
  font-family:inherit;
  font-size:.8rem;
  font-weight:800;
  border-radius:9px;
  cursor:pointer;
  transition:all .2s ease;
  display:flex;align-items:center;justify-content:center;gap:8px;
  text-transform:uppercase;
  letter-spacing:.5px;
  position:relative;
}
.tab .icon-svg{width:14px;height:14px}
.tab.active{
  background:var(--card);
  color:var(--brand);
  box-shadow:0 2px 10px rgba(0,0,0,.06);
}

.field{margin-bottom:16px;position:relative}
.field label{
  display:block;
  font-size:.72rem;
  font-weight:800;
  color:var(--ink);
  margin-bottom:8px;
  text-transform:uppercase;
  letter-spacing:.7px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.field label .req{
  font-size:.6rem;
  color:var(--muted);
  font-weight:700;
  letter-spacing:.4px;
}
.input-box{
  position:relative;
  display:flex;align-items:center;
  border:1.5px solid var(--line);
  background:var(--bg);
  border-radius:11px;
  transition:all .25s ease;
}
.input-box:focus-within{
  border-color:var(--brand);
  background:var(--card);
  box-shadow:0 0 0 4px var(--brand-light);
}
.input-box > .icon-svg{
  color:var(--muted);
  margin-left:14px;
  transition:color .25s ease;
  width:15px;height:15px;
}
.input-box:focus-within > .icon-svg{color:var(--brand)}
.input-box input,
.input-box select{
  flex:1;
  padding:14px 14px 14px 10px;
  background:transparent;
  border:none;
  outline:none;
  font-family:inherit;
  font-size:.9rem;
  font-weight:700;
  color:var(--ink);
  width:100%;
}
.input-box select{
  cursor:pointer;
  appearance:none;
  padding-right:38px;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%236B7280' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
  background-repeat:no-repeat;
  background-position:right 14px center;
}
.input-box select option{
  background: var(--card);
  color: var(--ink);
  padding: 10px;
}
.input-box input::placeholder{color:var(--muted);font-weight:600;opacity:.65}

.pw-toggle{
  background:transparent;border:none;
  color:var(--muted);
  padding:0 14px;
  cursor:pointer;
  transition:color .2s ease;
  display:grid;place-items:center;
}
.pw-toggle .icon-svg{width:15px;height:15px}
.pw-toggle:hover{color:var(--brand)}

.alert{
  display:none;
  padding:11px 14px;
  border-radius:10px;
  font-size:.82rem;
  font-weight:700;
  margin-bottom:16px;
  align-items:center;gap:8px;
}
.alert.error{background:#FEF2F2;color:#B91C1C;border:1px solid #FECACA}
.alert.success{background:#F0FDF4;color:#15803D;border:1px solid #BBF7D0}
.alert.show{display:flex}
.alert .icon-svg{width:14px;height:14px}

.btn-primary{
  width:100%;
  padding:15px;
  border:none;
  border-radius:11px;
  background:linear-gradient(135deg, var(--brand), var(--brand-2));
  color:#fff;
  font-family:inherit;
  font-weight:800;
  font-size:.9rem;
  letter-spacing:.5px;
  text-transform:uppercase;
  cursor:pointer;
  transition:all .25s ease;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  box-shadow:0 6px 20px -6px var(--brand-glow);
  position:relative;
  overflow:hidden;
}
.btn-primary::before{
  content:"";
  position:absolute;
  top:0;left:-100%;
  width:100%;height:100%;
  background:linear-gradient(90deg, transparent, rgba(255,255,255,.3), transparent);
  transition:left .6s ease;
}
.btn-primary:hover::before{left:100%}
.btn-primary:hover{
  transform:translateY(-2px);
  box-shadow:0 10px 28px -6px var(--brand-glow);
}
.btn-primary:active{transform:translateY(0)}
.btn-primary:disabled{opacity:.65;cursor:not-allowed;transform:none}

.spinner{
  width:15px;height:15px;
  border:2px solid rgba(255,255,255,.35);
  border-top-color:#fff;
  border-radius:50%;
  animation:spin .7s linear infinite;
  display:none;
}
.btn-primary.loading .spinner{display:block}
@keyframes spin{to{transform:rotate(360deg)}}

.form-view{display:none;animation:fadeIn .35s ease}
.form-view.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

.foot-note{
  margin-top:24px;
  text-align:center;
  font-size:.75rem;
  color:var(--muted);
  font-weight:700;
}
.foot-note a{
  color:var(--brand);
  text-decoration:none;
  font-weight:800;
}
.foot-note a:hover{text-decoration:underline}

/* ============ QUICK LINKS — FLOATING TOP-RIGHT ============ */
.quick-toggle-btn{
  position:fixed;
  top:20px;
  right:24px;
  z-index:100;
  padding:10px 18px;
  border-radius:11px;
  background:var(--card);
  border:1.5px solid var(--line);
  color:var(--ink);
  font-family:inherit;
  font-weight:800;
  font-size:.8rem;
  cursor:pointer;
  transition:all .2s ease;
  display:flex;
  align-items:center;
  gap:8px;
  box-shadow:0 4px 14px rgba(0,0,0,.06);
}
.quick-toggle-btn:hover{
  border-color:var(--brand);
  color:var(--brand);
  transform:translateY(-1px);
  box-shadow:0 8px 20px -6px var(--brand-glow);
}
.quick-toggle-btn .icon-svg{width:14px;height:14px}

.quick-panel{
  position:fixed;
  top:72px;
  right:24px;
  z-index:99;
  width:340px;
  max-height:calc(100vh - 100px);
  background:var(--card);
  border:1.5px solid var(--line);
  border-radius:16px;
  padding:16px;
  box-shadow:0 20px 60px -20px rgba(0,0,0,.25);
  overflow-y:auto;
  display:none;
  animation:slideDown .25s ease;
}
.quick-panel.open{display:block}
@keyframes slideDown{
  from{opacity:0;transform:translateY(-10px)}
  to{opacity:1;transform:translateY(0)}
}
.quick-panel::-webkit-scrollbar{width:5px}
.quick-panel::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}

.quick-panel .qp-title{
  font-size:.7rem;
  font-weight:900;
  color:var(--muted);
  letter-spacing:1.5px;
  text-transform:uppercase;
  margin-bottom:12px;
  padding:0 4px;
}

.quick-panel .qp-grid{
  display:grid;
  grid-template-columns:1fr;
  gap:6px;
}

.quick-panel .qp-item{
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px 12px;
  border-radius:10px;
  color:var(--ink);
  font-weight:700;
  font-size:.8rem;
  transition:all .15s ease;
  border:1px solid transparent;
}
.quick-panel .qp-item:hover{
  background:var(--brand-light);
  color:var(--brand);
  border-color:var(--brand);
}
html[data-theme="dark"] .quick-panel .qp-item:hover{
  background:rgba(248,111,3,.15);
}
.quick-panel .qp-item .qp-icon{
  width:26px;height:26px;
  display:grid;place-items:center;
  background:var(--brand-light);
  color:var(--brand);
  border-radius:7px;
  flex-shrink:0;
}
html[data-theme="dark"] .quick-panel .qp-item .qp-icon{
  background:rgba(248,111,3,.15);
}
.quick-panel .qp-item .qp-icon .icon-svg{width:12px;height:12px}
.quick-panel .qp-item .qp-text{
  display:flex;
  flex-direction:column;
  gap:1px;
  min-width:0;
}
.quick-panel .qp-item .qp-name{
  font-weight:800;
  font-size:.78rem;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.quick-panel .qp-item .qp-sub{
  font-size:.6rem;
  font-weight:700;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.3px;
}

/* Dropdown inside quick panel */
.quick-panel .qp-dropdown{
  padding:0;
  border:1px solid transparent;
}
.quick-panel .qp-dropdown .qp-head{
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px 12px;
  cursor:pointer;
  border-radius:10px;
  transition:all .15s ease;
}
.quick-panel .qp-dropdown .qp-head:hover{
  background:var(--brand-light);
  color:var(--brand);
}
html[data-theme="dark"] .quick-panel .qp-dropdown .qp-head:hover{
  background:rgba(248,111,3,.15);
}
.quick-panel .qp-dropdown .qp-arrow{
  margin-left:auto;
  color:var(--muted);
  transition:transform .2s ease;
}
.quick-panel .qp-dropdown .qp-arrow .icon-svg{width:12px;height:12px}
.quick-panel .qp-dropdown.open .qp-arrow{
  transform:rotate(180deg);
  color:var(--brand);
}
.quick-panel .qp-dropdown .qp-body{
  display:none;
  flex-direction:column;
  padding:4px 0 4px 12px;
}
.quick-panel .qp-dropdown.open .qp-body{
  display:flex;
}
.quick-panel .qp-dropdown .qp-body a{
  padding:8px 12px;
  font-size:.76rem;
  font-weight:700;
  color:var(--ink);
  border-radius:8px;
  display:flex;
  align-items:center;
  gap:8px;
  transition:all .15s ease;
}
.quick-panel .qp-dropdown .qp-body a:hover{
  background:var(--brand-light);
  color:var(--brand);
  padding-left:18px;
}
html[data-theme="dark"] .quick-panel .qp-dropdown .qp-body a:hover{
  background:rgba(248,111,3,.15);
}
.quick-panel .qp-dropdown .qp-body a .bullet{
  width:5px;height:5px;
  border-radius:50%;
  background:var(--brand);
  flex-shrink:0;
}

/* ============ RESPONSIVE ============ */
@media (max-width: 1000px){
  html,body{overflow:auto;height:auto}
  .shell{
    grid-template-columns:1fr;
    height:auto;
  }
  .brand-side{height:auto;padding:40px 32px}
  .brand-content h1{font-size:2rem}
  .form-side{height:auto;padding:40px 32px;overflow:visible}
  .quick-toggle-btn{top:16px;right:16px;padding:8px 14px;font-size:.72rem}
  .quick-panel{width:calc(100% - 32px);right:16px;top:64px}
}
@media (max-width: 600px){
  .brand-side{padding:32px 24px}
  .brand-content h1{font-size:1.7rem}
  .brand-features{display:none}
  .form-side{padding:32px 24px}
  .form-head h2{font-size:1.5rem}
}
</style>
</head>

    font-weight: 700;
    color: var(--muted);
}
.ticker-text span { margin: 0 16px; }
.ticker-text .hl { color: var(--brand); font-weight: 800; }
.ticker-text .hl2 { color: #E74C3C; font-weight: 800; }
@keyframes marquee {
    0% { transform: translateX(100%); }
    100% { transform: translateX(-100%); }
}

/* ================================================================
   INFO BAR
   ================================================================ */
.info-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 5px 0 6px 0;
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
    margin-bottom: 8px;
    flex-wrap: wrap;
    gap: 6px;
}
.legend { display: flex; gap: 16px; flex-wrap: wrap; }
.legend .item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--muted);
    text-transform: uppercase;

      <!-- ADMIN VIEW -->
      <div class="form-view" id="view-admin">
        <div class="alert error" id="adminAlert"><i class="fa-solid fa-triangle-exclamation"></i><span></span></div>

        <div class="field">
          <div class="field-label">
            <span><span class="prompt">$</span> ADMIN_ID</span>
            <span>REQUIRED</span>
          </div>
          <div class="field-input-wrap">
            <i class="fa-solid fa-user-shield field-icon"></i>
            <input type="text" placeholder="admin_username" name="m_stradminUserName" id="m_stradminUserName" autocomplete="username" />
          </div>

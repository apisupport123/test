<%--
  ============================================================
  moduleHeader.jsp - Module Lead Header
  ============================================================
  Links: Home, Roster, Logout (same as old)
  Display: m_strrole (DB team)
  User: session se
  ============================================================
--%>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%
 response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate, max-age=0, private");
 response.setHeader("Pragma", "no-cache");
 response.setDateHeader("Expires", 0);

 // ---- AUTH GUARD ----
 String __role = (session != null) ? (String) session.getAttribute("role") : null;
 if (__role == null || __role.trim().isEmpty()) {
     response.sendRedirect(request.getContextPath() + "/login.action");
     return;
 }
%>
<%@ page import="com.jdbc.DBUtilityAuto"%>
<%@ page import="java.sql.*"%>

<%
  // ---- Session se username ----
  String user = (session != null) ? (String) session.getAttribute("username") : null;
  if (user == null || user.trim().isEmpty()) {
      user = request.getParameter("m_stradminUserName");
  }
  if (user == null) user = "";

  // ---- DB se team nikalna ----
  String m_strrole = null;
  Connection con = null;
  PreparedStatement ps = null;
  ResultSet rs = null;
  try {
      con = DBUtilityAuto.getReportDBConnection();
      String query = "select TEAM from a_module_leads where lower(username)=lower(?)";
      ps = con.prepareStatement(query);
      ps.setString(1, user);
      rs = ps.executeQuery();
      if (rs.next()) {
          m_strrole = rs.getString("TEAM");
      }
  } catch (Exception e) {
      e.printStackTrace();
  } finally {
      if (rs != null) try { rs.close(); } catch (Exception e) {}
      if (ps != null) try { ps.close(); } catch (Exception e) {}
      if (con != null) try { con.close(); } catch (Exception e) {}
  }

  // Agar team nahi mili, role hi use karo
  if (m_strrole == null || m_strrole.trim().isEmpty()) {
      m_strrole = __role;
  }

  String ctx = request.getContextPath();
%>


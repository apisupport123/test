    /**
     * ⭐ Extract file bytes DIRECTLY from MultiPartRequestWrapper.
     * Bypasses Struts binding entirely — guaranteed to work.
     */
    private byte[] extractBytes(MultiPartRequestWrapper mpr,
                                String fieldName,
                                String label) {
        try {
            File[] files = mpr.getFiles(fieldName);
            String[] names = mpr.getFileNames(fieldName);

            if (files == null || files.length == 0 || files[0] == null) {
                System.out.println("[FETCH] " + label + ": no file");
                return null;
            }

            String name = (names != null && names.length > 0) ? names[0] : "?";
            System.out.println("[FETCH] " + label + ": file=" + files[0] + " name=" + name);

            byte[] data = readFileBytes(files[0]);
            if (data != null) {
                System.out.println("[FETCH] " + label + ": read " + data.length + " bytes");
            } else {
                System.out.println("[FETCH] " + label + ": read FAILED");
            }
            return data;
        } catch (Exception e) {
            System.out.println("[FETCH] " + label + " error: " + e.getClass().getName()
                    + " - " + e.getMessage());
            e.printStackTrace();
            return null;
        }
    }


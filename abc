<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Team Roster &mdash; <%= nameOfMonth %> <%= year %></title>

<style>
:root{
  --ml-primary:#7C3AED;
  --ml-primary-2:#8B5CF6;
  --ml-primary-light:#F3E8FF;
  --ml-accent:#EC4899;
  --ml-accent-2:#F472B6;

  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F5F7FA;
  --card:#FFFFFF;

  --morning:#F59E0B;
  --morning-bg:#FEF3C7;
  --general:#6B7280;
  --general-bg:#F3F4F6;
  --afternoon:#EAB308;
  --afternoon-bg:#FEF9C3;
  --night:#3B82F6;
  --night-bg:#DBEAFE;
  --weekoff:#8B5CF6;
  --weekoff-bg:#EDE9FE;
  --leave:#EF4444;
  --leave-bg:#FEE2E2;
  --flexi:#F97316;
  --flexi-bg:#FFEDD5;
  --holiday:#10B981;
  --holiday-bg:#D1FAE5;
  --na:#9CA3AF;
  --na-bg:#F3F4F6;

  --radius:16px;
  --radius-sm:10px;
  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

html[data-theme="dark"]{
  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#272727;
  --bg:#0A0614;
  --card:#130A24;
  --morning-bg:#422006;
  --general-bg:#1F2937;
  --afternoon-bg:#422006;
  --night-bg:#1E3A8A;
  --weekoff-bg:#3B0764;
  --leave-bg:#450A0A;
  --flexi-bg:#431407;
  --holiday-bg:#064E3B;
  --na-bg:#1F2937;
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--font-stack);
  font-weight:600;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  transition:background .3s ease,color .3s ease;
  min-height:100vh;
}
a{color:inherit;text-decoration:none}

/* ============ PAGE HEADER ============ */
.page-head{
  background:
    radial-gradient(circle at top right, rgba(236,72,153,.2), transparent 60%),
    radial-gradient(circle at bottom left, rgba(124,58,237,.3), transparent 60%),
    linear-gradient(135deg, #1A0B2E 0%, #2D1854 100%);
  padding:40px 40px 48px;
  color:#fff;
  position:relative;
  overflow:hidden;
  margin-bottom:24px;
}
.page-head::before{
  content:"";
  position:absolute;top:-150px;right:-150px;
  width:500px;height:500px;border-radius:50%;
  background:radial-gradient(circle, rgba(124,58,237,.5) 0%, transparent 70%);
  pointer-events:none;
}
.page-head-inner{
  max-width:1600px;
  margin:0 auto;
  position:relative;z-index:2;
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap:24px;
  flex-wrap:wrap;
}
.page-head-text{flex:1;min-width:280px;}
.page-head .badge-line{
  display:inline-flex;align-items:center;gap:8px;
  padding:6px 14px;
  background:rgba(236,72,153,.2);
  border:1px solid rgba(236,72,153,.4);
  border-radius:999px;
  font-size:.7rem;font-weight:800;
  color:var(--ml-accent-2);letter-spacing:1px;
  text-transform:uppercase;margin-bottom:16px;
}
.page-head .badge-line .dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--ml-accent-2);
  box-shadow:0 0 8px var(--ml-accent-2);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.page-head h1{
  font-size:2.4rem;font-weight:900;
  letter-spacing:-1.2px;line-height:1.1;margin-bottom:10px;
}
.page-head h1 .gradient{
  background:linear-gradient(135deg,var(--ml-primary-2),var(--ml-accent-2));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.page-head p{
  font-size:.95rem;color:rgba(255,255,255,.7);
  font-weight:500;line-height:1.6;max-width:600px;
}

/* Month selector */
.month-picker{
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px 18px;
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.15);
  border-radius:14px;
  backdrop-filter:blur(10px);
  flex-shrink:0;
}
.month-picker label{
  font-size:.72rem;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.8px;
  color:rgba(255,255,255,.7);
  display:block;
  margin-bottom:6px;
}
.month-picker input,
.month-picker select{
  background:rgba(0,0,0,.25);
  border:1px solid rgba(255,255,255,.15);
  border-radius:8px;
  padding:8px 12px;
  color:#fff;
  font-family:inherit;
  font-size:.85rem;
  font-weight:700;
  outline:none;
  transition:all .2s ease;
}
.month-picker input:focus,
.month-picker select:focus{
  border-color:var(--ml-accent-2);
  background:rgba(0,0,0,.35);
}
.month-picker .btn-go{
  padding:9px 20px;
  background:linear-gradient(135deg,var(--ml-primary),var(--ml-accent));
  border:none;
  border-radius:8px;
  color:#fff;
  font-family:inherit;
  font-size:.82rem;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.4px;
  cursor:pointer;
  transition:all .2s ease;
  box-shadow:0 6px 16px -4px var(--ml-primary);
  white-space:nowrap;
}
.month-picker .btn-go:hover{
  transform:translateY(-1px);
  box-shadow:0 10px 24px -4px var(--ml-primary);
}

/* ============ MAIN CONTENT ============ */
.page-content{
  max-width:1600px;
  margin:0 auto;
  padding:0 32px 60px;
}

/* Stats Row */
.stats-row{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));
  gap:16px;
  margin-bottom:24px;
}
.stat-card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:18px 20px;
  display:flex;
  align-items:center;
  gap:14px;
  transition:all .2s ease;
}
.stat-card:hover{
  transform:translateY(-2px);
  box-shadow:0 8px 24px -8px rgba(124,58,237,.2);
  border-color:var(--ml-primary);
}
.stat-icon{
  width:44px;height:44px;border-radius:12px;
  display:grid;place-items:center;
  flex-shrink:0;
}
.stat-icon svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.stat-icon.purple{background:var(--ml-primary-light);color:var(--ml-primary)}
.stat-icon.green{background:#DCFCE7;color:#16A34A}
.stat-icon.orange{background:#FFEDD5;color:#EA580C}
.stat-icon.blue{background:#DBEAFE;color:#2563EB}
html[data-theme="dark"] .stat-icon.purple{background:rgba(124,58,237,.2);color:var(--ml-primary-2)}
html[data-theme="dark"] .stat-icon.green{background:rgba(22,163,74,.2);color:#4ADE80}
html[data-theme="dark"] .stat-icon.orange{background:rgba(234,88,12,.2);color:#FB923C}
html[data-theme="dark"] .stat-icon.blue{background:rgba(37,99,235,.2);color:#60A5FA}
.stat-info .val{
  font-size:1.5rem;font-weight:900;
  color:var(--ink);letter-spacing:-.5px;line-height:1;
}
.stat-info .lbl{
  font-size:.7rem;font-weight:700;
  color:var(--muted);text-transform:uppercase;
  letter-spacing:.6px;margin-top:4px;
}

/* Toolbar */
.toolbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  margin-bottom:16px;
  flex-wrap:wrap;
}
.search-box{
  position:relative;
  flex:1;
  max-width:360px;
}
.search-box svg{
  position:absolute;
  left:14px;top:50%;
  transform:translateY(-50%);
  width:16px;height:16px;
  stroke:var(--muted);fill:none;
  stroke-width:2.2;
  pointer-events:none;
}
.search-box input{
  width:100%;
  padding:12px 16px 12px 42px;
  background:var(--card);
  border:1.5px solid var(--line);
  border-radius:var(--radius-sm);
  color:var(--ink);
  font-family:inherit;
  font-size:.88rem;
  font-weight:600;
  outline:none;
  transition:all .2s ease;
}
.search-box input::placeholder{color:var(--muted);font-weight:500}
.search-box input:focus{
  border-color:var(--ml-primary);
  box-shadow:0 0 0 4px rgba(124,58,237,.1);
}

.legend{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  align-items:center;
}
.legend-item{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:6px 12px;
  border-radius:999px;
  font-size:.72rem;
  font-weight:700;
  white-space:nowrap;
  border:1.5px solid transparent;
}
.legend-item .dot{
  width:8px;height:8px;border-radius:50%;
  flex-shrink:0;
}

/* Roster Table Card */
.roster-card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:var(--radius);
  overflow:hidden;
  box-shadow:0 4px 24px rgba(0,0,0,.03);
}
html[data-theme="dark"] .roster-card{
  box-shadow:0 4px 24px rgba(0,0,0,.4);
}

.table-scroll{
  overflow:auto;
  max-height:75vh;
  position:relative;
}
.table-scroll::-webkit-scrollbar{width:8px;height:8px}
.table-scroll::-webkit-scrollbar-thumb{
  background:var(--line);border-radius:4px;
}
.table-scroll::-webkit-scrollbar-thumb:hover{background:var(--muted)}
.table-scroll::-webkit-scrollbar-track{background:transparent}

.roster-table{
  width:100%;
  border-collapse:separate;
  border-spacing:0;
  font-size:.82rem;
}

.roster-table thead th{
  position:sticky;
  top:0;
  z-index:3;
  background:var(--bg);
  color:var(--muted);
  font-size:.68rem;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.6px;
  padding:12px 8px;
  text-align:center;
  border-bottom:2px solid var(--line);
  white-space:nowrap;
  min-width:38px;
}
html[data-theme="dark"] .roster-table thead th{
  background:#0F0422;
}

.roster-table thead tr:first-child th{
  background:linear-gradient(135deg,#2D1854,#1A0B2E);
  color:#fff;
  font-size:.72rem;
  top:0;
  height:38px;
}
html[data-theme="dark"] .roster-table thead tr:first-child th{
  background:linear-gradient(135deg,#1A0B2E,#0A0614);
}
.roster-table thead tr:nth-child(2) th{
  top:38px;
}

/* Sticky first column */
.roster-table th.sticky-col,
.roster-table td.sticky-col{
  position:sticky;
  left:0;
  z-index:2;
  background:var(--card);
  border-right:2px solid var(--line);
  text-align:left;
  padding:12px 14px;
  min-width:180px;
  max-width:220px;
}
html[data-theme="dark"] .roster-table th.sticky-col,
html[data-theme="dark"] .roster-table td.sticky-col{
  background:#130A24;
}
.roster-table thead th.sticky-col{
  z-index:4;
  background:linear-gradient(135deg,#2D1854,#1A0B2E) !important;
  color:#fff;
}
html[data-theme="dark"] .roster-table thead th.sticky-col{
  background:linear-gradient(135deg,#1A0B2E,#0A0614) !important;
}

.roster-table tbody tr{
  transition:background .15s ease;
}
.roster-table tbody tr:hover{
  background:var(--bg);
}
html[data-theme="dark"] .roster-table tbody tr:hover{
  background:#1F0E3D;
}
.roster-table tbody tr:hover td.sticky-col{
  background:var(--bg);
}
html[data-theme="dark"] .roster-table tbody tr:hover td.sticky-col{
  background:#1F0E3D;
}

.roster-table tbody td{
  padding:10px 6px;
  text-align:center;
  border-bottom:1px solid var(--line);
  vertical-align:middle;
}
html[data-theme="dark"] .roster-table tbody td{
  border-bottom-color:#1F0E3D;
}

/* Employee cell */
.emp-cell{
  display:flex;
  align-items:center;
  gap:10px;
}
.emp-avatar{
  width:32px;height:32px;border-radius:50%;
  background:linear-gradient(135deg,var(--ml-primary-2),var(--ml-accent-2));
  color:#fff;font-weight:900;font-size:.72rem;
  display:grid;place-items:center;
  flex-shrink:0;
}
.emp-info{min-width:0;}
.emp-name{
  font-weight:800;
  color:var(--ink);
  font-size:.8rem;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.emp-role{
  font-size:.62rem;
  color:var(--muted);
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.4px;
  margin-top:2px;
}

/* Day Cell - Badge */
.day-cell{
  position:relative;
  cursor:pointer;
  min-width:38px;
  height:38px;
  padding:0 !important;
}
.day-badge{
  display:grid;
  place-items:center;
  width:32px;height:32px;
  margin:0 auto;
  border-radius:8px;
  font-size:.7rem;
  font-weight:900;
  letter-spacing:-.3px;
  transition:all .2s ease;
  border:1.5px solid transparent;
}
.day-cell:hover .day-badge{
  transform:scale(1.15);
  box-shadow:0 4px 12px rgba(0,0,0,.15);
}
.day-badge.Morning, .day-badge.WFH-Morning, .day-badge.CC-Morning{
  background:var(--morning-bg); color:var(--morning);
  border-color:var(--morning);
}
.day-badge.General, .day-badge.Genral, .day-badge.WFH-General, .day-badge.CC-General{
  background:var(--general-bg); color:var(--general);
  border-color:var(--general);
}
.day-badge.Afternoon, .day-badge.WFH-Afternoon, .day-badge.CC-Afternoon{
  background:var(--afternoon-bg); color:#A16207;
  border-color:var(--afternoon);
}
.day-badge.Night, .day-badge.WFH-Night, .day-badge.CC-Night{
  background:var(--night-bg); color:var(--night);
  border-color:var(--night);
}
.day-badge.Weekoff, .day-badge.WeekoffAdjust{
  background:var(--weekoff-bg); color:var(--weekoff);
  border-color:var(--weekoff);
}
.day-badge.SickLeave, .day-badge.CasualLeave, .day-badge.EarnedLeave, .day-badge.Leave{
  background:var(--leave-bg); color:var(--leave);
  border-color:var(--leave);
}
.day-badge.FlexiLeave{
  background:var(--flexi-bg); color:var(--flexi);
  border-color:var(--flexi);
}
.day-badge.HolidayLeave{
  background:var(--holiday-bg); color:var(--holiday);
  border-color:var(--holiday);
}
.day-badge.NA, .day-badge.empty{
  background:var(--na-bg); color:var(--na);
  border-color:transparent;
}
html[data-theme="dark"] .day-badge.Afternoon{color:#FDE047}

/* Weekend column highlight */
.roster-table td.weekend,
.roster-table th.weekend{
  background:rgba(124,58,237,.06) !important;
}
html[data-theme="dark"] .roster-table td.weekend,
html[data-theme="dark"] .roster-table th.weekend{
  background:rgba(124,58,237,.15) !important;
}

/* Select for editing */
.day-cell select{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  opacity:0;
  cursor:pointer;
  border:none;
  font-family:inherit;
  font-size:.7rem;
  font-weight:700;
  background:transparent;
  color:transparent;
  appearance:none;
  -webkit-appearance:none;
}
.day-cell.editing select{
  opacity:1;
  background:var(--card);
  color:var(--ink);
  border:2px solid var(--ml-primary);
  border-radius:8px;
  z-index:5;
}

/* Summary rows */
.summary-row td{
  background:var(--bg) !important;
  font-weight:800;
  font-size:.72rem;
  color:var(--ink);
  padding:10px 6px;
  border-top:2px solid var(--line);
  border-bottom:1px solid var(--line);
}
html[data-theme="dark"] .summary-row td{
  background:#0F0422 !important;
}
.summary-row td.sticky-col{
  background:var(--bg) !important;
  font-size:.72rem;
  text-transform:uppercase;
  letter-spacing:.5px;
  color:var(--muted);
}
html[data-theme="dark"] .summary-row td.sticky-col{
  background:#0F0422 !important;
}
.summary-val{
  display:inline-block;
  padding:2px 8px;
  border-radius:6px;
  font-weight:800;
  font-size:.72rem;
  min-width:24px;
}
.summary-val.morning{background:var(--morning-bg);color:var(--morning)}
.summary-val.general{background:var(--general-bg);color:var(--general)}
.summary-val.afternoon{background:var(--afternoon-bg);color:#A16207}
.summary-val.night{background:var(--night-bg);color:var(--night)}

/* Save button */
.save-bar{
  padding:20px 24px;
  background:var(--bg);
  border-top:2px solid var(--line);
  display:flex;
  justify-content:flex-end;
  align-items:center;
  gap:14px;
  flex-wrap:wrap;
}
html[data-theme="dark"] .save-bar{
  background:#0F0422;
}
.save-info{
  font-size:.78rem;
  color:var(--muted);
  font-weight:600;
  margin-right:auto;
}
.btn-save{
  padding:12px 32px;
  background:linear-gradient(135deg,var(--ml-primary),var(--ml-accent));
  border:none;
  border-radius:var(--radius-sm);
  color:#fff;
  font-family:inherit;
  font-size:.85rem;
  font-weight:800;
  letter-spacing:.4px;
  text-transform:uppercase;
  cursor:pointer;
  transition:all .25s ease;
  box-shadow:0 8px 20px -6px var(--ml-primary);
  display:inline-flex;
  align-items:center;
  gap:10px;
}
.btn-save:hover{
  transform:translateY(-2px);
  box-shadow:0 14px 32px -6px var(--ml-primary);
}
.btn-save svg{
  width:16px;height:16px;
  stroke:currentColor;fill:none;
  stroke-width:2.4;
  stroke-linecap:round;stroke-linejoin:round;
}

/* Empty state */
.empty-state{
  text-align:center;
  padding:80px 20px;
  color:var(--muted);
}
.empty-state svg{
  width:64px;height:64px;
  stroke:var(--ml-primary);fill:none;
  stroke-width:1.5;
  opacity:.4;
  margin-bottom:16px;
}
.empty-state h3{
  font-size:1.1rem;font-weight:800;
  color:var(--ink);margin-bottom:6px;
}
.empty-state p{font-size:.85rem;font-weight:500}

/* ============ RESPONSIVE ============ */
@media (max-width:900px){
  .page-head{padding:28px 20px 32px;}
  .page-head h1{font-size:1.6rem;}
  .page-head p{font-size:.85rem;}
  .page-head-inner{flex-direction:column;align-items:flex-start;}
  .month-picker{width:100%;}
  .page-content{padding:0 16px 40px;}
  .roster-table th.sticky-col,
  .roster-table td.sticky-col{
    min-width:140px;max-width:160px;
    padding:10px;
  }
  .emp-avatar{width:28px;height:28px;font-size:.68rem;}
  .emp-name{font-size:.75rem;}
  .day-badge{width:28px;height:28px;font-size:.65rem;}
  .day-cell{min-width:32px;height:32px;}
  .toolbar{flex-direction:column;align-items:stretch;}
  .search-box{max-width:100%;}
}
</style>
</head>
<body>

<!-- ============ PAGE HEADER ============ -->
<section class="page-head">
  <div class="page-head-inner">
    <div class="page-head-text">
      <div class="badge-line">
        <span class="dot"></span>
        <%= m_strrole != null && !m_strrole.trim().isEmpty() ? m_strrole : "Team" %> Roster
      </div>
      <h1>Team <span class="gradient">Roster</span> &mdash; <%= nameOfMonth %> <%= year %></h1>
      <p>Manage your team's monthly shift schedule. Click any cell to change the shift &mdash; changes are saved when you click Save.</p>
    </div>

    <form method="get" action="" class="month-picker" id="monthYearForm">
      <div>
        <label for="monthSel">Month</label>
        <select name="month" id="monthSel">
          <% for (int m=1; m<=12; m++) { %>
            <option value="<%=m%>" <%= m==month ? "selected" : "" %>><%= monthNames[m] %></option>
          <% } %>
        </select>
      </div>
      <div>
        <label for="yearSel">Year</label>
        <input type="number" id="yearSel" name="year" min="2024" max="2100" value="<%=year%>" required style="width:100px;">
      </div>
      <input type="hidden" name="m_strroles" value="<%=m_strrole%>">
      <input type="hidden" name="username" value="<%=username%>">
      <button type="submit" class="btn-go">Go</button>
    </form>
  </div>
</section>

<!-- ============ MAIN CONTENT ============ -->
<div class="page-content">

<%
    // Load data
    Connection conn = null;
    PreparedStatement ps = null;
    ResultSet rsData = null;

    List<Map<String,Object>> employees = new ArrayList<>();

    try {
        conn = DBUtilityAuto.getReportDBConnection();
        String dataQuery = "select * from rostertable where UPPER(TEAM) = UPPER(?) and UPPER(MONTHYEAR) = UPPER(?) order by id";
        ps = conn.prepareStatement(dataQuery);
        ps.setString(1, m_strrole);
        ps.setString(2, sort_MonthYear);
        rsData = ps.executeQuery();
        ResultSetMetaData rsmd = rsData.getMetaData();
        int colCount = rsmd.getColumnCount();
        while (rsData.next()) {
            Map<String,Object> row = new HashMap<>();
            for (int i=1; i<=colCount; i++) {
                row.put(rsmd.getColumnName(i).toUpperCase(), rsData.getObject(i));
            }
            employees.add(row);
        }
    } catch (Exception e) {
        e.printStackTrace();
    } finally {
        if (rsData != null) try { rsData.close(); } catch (Exception e) {}
        if (ps != null) try { ps.close(); } catch (Exception e) {}
    }
%>

<!-- Stats Row -->
<div class="stats-row">
  <div class="stat-card">
    <div class="stat-icon purple">
      <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </div>
    <div class="stat-info">
      <div class="val"><%= employees.size() %></div>
      <div class="lbl">Employees</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon green">
      <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </div>
    <div class="stat-info">
      <div class="val"><%= noOfDays %></div>
      <div class="lbl">Days</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon orange">
      <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
    </div>
    <div class="stat-info">
      <div class="val"><%= sort_MonthYear %></div>
      <div class="lbl">Period</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon blue">
      <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    </div>
    <div class="stat-info">
      <div class="val" style="font-size:.9rem;"><%= m_strrole %></div>
      <div class="lbl">Team</div>
    </div>
  </div>
</div>

<!-- Toolbar -->
<div class="toolbar">
  <div class="search-box">
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="text" id="empSearch" placeholder="Search employees..." autocomplete="off">
  </div>
  <div class="legend">
    <span class="legend-item"><span class="dot" style="background:var(--morning)"></span>Morning</span>
    <span class="legend-item"><span class="dot" style="background:var(--general)"></span>General</span>
    <span class="legend-item"><span class="dot" style="background:var(--afternoon)"></span>Afternoon</span>
    <span class="legend-item"><span class="dot" style="background:var(--night)"></span>Night</span>
    <span class="legend-item"><span class="dot" style="background:var(--weekoff)"></span>Weekoff</span>
    <span class="legend-item"><span class="dot" style="background:var(--leave)"></span>Leave</span>
    <span class="legend-item"><span class="dot" style="background:var(--holiday)"></span>Holiday</span>
  </div>
</div>

<!-- Roster Card -->
<div class="roster-card">
  <form id="rosterForm" method="post" action="<%=request.getContextPath()%>/RosterServlet">
    <input type="hidden" name="tableData" id="tableData">
    <input type="hidden" name="m_strroles" value="<%=m_strrole%>">
    <input type="hidden" name="username" value="<%=username%>">
    <input type="hidden" name="selectedMonth" value="<%=selectedMonth%>">
    <input type="hidden" name="selectedYear" value="<%=selectedYear%>">

  <div class="table-scroll">

<% if (employees.isEmpty()) { %>
    <div class="empty-state">
      <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <h3>No Roster Found</h3>
      <p>No data available for <strong><%= nameOfMonth %> <%= year %></strong>. Upload a roster or select a different month.</p>
    </div>
<% } else { %>
    <table class="roster-table" id="rosterTable">
      <thead>
        <tr>
          <th class="sticky-col" rowspan="2">Employee</th>
          <th rowspan="2" style="min-width:100px;">Role</th>
          <% for (int d=1; d<=noOfDays; d++) {
              LocalDate dt = LocalDate.of(year, month, d);
              DayOfWeek dow = dt.getDayOfWeek();
              boolean isWknd = (dow == DayOfWeek.SATURDAY || dow == DayOfWeek.SUNDAY);
          %>
            <th class="<%= isWknd ? "weekend" : "" %>"><%= d %></th>
          <% } %>
          <th rowspan="2" style="min-width:60px;">WO</th>
          <th rowspan="2" style="min-width:60px;">Lv</th>
        </tr>
        <tr>
          <% for (int d=1; d<=noOfDays; d++) {
              LocalDate dt = LocalDate.of(year, month, d);
              DayOfWeek dow = dt.getDayOfWeek();
              String dayShort = dow.getDisplayName(TextStyle.SHORT, Locale.ENGLISH).substring(0,2);
              boolean isWknd = (dow == DayOfWeek.SATURDAY || dow == DayOfWeek.SUNDAY);
          %>
            <th class="<%= isWknd ? "weekend" : "" %>" style="font-size:.6rem;opacity:.7;"><%= dayShort %></th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <%
        int empIdx = 0;
        for (Map<String,Object> emp : employees) {
            String empName = emp.get("NAME") != null ? emp.get("NAME").toString() : "";
            String adId = emp.get("AD_ID") != null ? emp.get("AD_ID").toString() : "";
            String position = emp.get("POSITION") != null ? emp.get("POSITION").toString() : "";
            String initials = "";
            if (empName.length() > 0) {
                String[] parts = empName.trim().split("\\s+");
                if (parts.length >= 2) {
                    initials = parts[0].substring(0,1) + parts[parts.length-1].substring(0,1);
                } else {
                    initials = empName.substring(0,1);
                }
                initials = initials.toUpperCase();
            }
        %>
        <tr class="emp-row" data-name="<%= empName.toLowerCase() %>">
          <td class="sticky-col">
            <div class="emp-cell">
              <div class="emp-avatar"><%= initials %></div>
              <div class="emp-info">
                <div class="emp-name"><%= empName %></div>
                <div class="emp-role"><%= adId %></div>
              </div>
            </div>
            <input type="hidden" name="employeeName" value="<%= empName %>">
            <input type="hidden" name="adId" value="<%= adId %>">
            <input type="hidden" name="position_<%= empIdx %>" value="<%= position %>">
          </td>
          <td style="font-size:.72rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.3px;"><%= position %></td>

          <%
          int woCount = 0;
          int lvCount = 0;
          for (int d=1; d<=noOfDays; d++) {
              String dayCol = "DAY_" + d;
              Object val = emp.get(dayCol);
              String shift = val != null ? val.toString().trim() : "";
              if (shift.isEmpty()) shift = "NA";

              String shiftLower = shift.toLowerCase();
              if (shiftLower.contains("weekoff")) woCount++;
              if (shiftLower.contains("leave")) lvCount++;

              LocalDate dt = LocalDate.of(year, month, d);
              boolean isWknd = (dt.getDayOfWeek() == DayOfWeek.SATURDAY || dt.getDayOfWeek() == DayOfWeek.SUNDAY);

              // Short label
              String label = "–";
              if (shift.toLowerCase().contains("morning")) label = shift.toLowerCase().contains("wfh") ? "WH" : (shift.toLowerCase().contains("cc") ? "CC" : "M");
              else if (shift.toLowerCase().contains("general") || shift.toLowerCase().contains("genral")) label = shift.toLowerCase().contains("wfh") ? "WD" : (shift.toLowerCase().contains("cc") ? "CD" : "D");
              else if (shift.toLowerCase().contains("afternoon")) label = shift.toLowerCase().contains("wfh") ? "WA" : (shift.toLowerCase().contains("cc") ? "CA" : "A");
              else if (shift.toLowerCase().contains("night")) label = shift.toLowerCase().contains("wfh") ? "WN" : (shift.toLowerCase().contains("cc") ? "CN" : "N");
              else if (shift.toLowerCase().contains("weekoffadjust")) label = "WA";
              else if (shift.toLowerCase().contains("weekoff")) label = "W";
              else if (shift.toLowerCase().contains("sickleave")) label = "SL";
              else if (shift.toLowerCase().contains("casualleave")) label = "CL";
              else if (shift.toLowerCase().contains("earnedleave")) label = "EL";
              else if (shift.toLowerCase().contains("flexileave")) label = "FL";
              else if (shift.toLowerCase().contains("holidayleave")) label = "HL";
              else if (shift.toLowerCase().contains("leave")) label = "L";
              else if (shift.equalsIgnoreCase("NA")) label = "–";

              String shiftClass = shift.replaceAll("\\s+", "");
          %>
          <td class="day-cell <%= isWknd ? "weekend" : "" %>" data-emp="<%=empIdx%>" data-day="<%=d%>">
            <div class="day-badge <%= shiftClass %>"><%= label %></div>
            <select name="mnt_<%= empIdx %>_<%= d %>"
                    class="shift-select"
                    onchange="updateBadge(this)">
              <option value="Morning"          <%= shift.equalsIgnoreCase("Morning")?"selected":"" %>>M – Morning</option>
              <option value="WFH-Morning"      <%= shift.equalsIgnoreCase("WFH-Morning")?"selected":"" %>>WFH-Morning</option>
              <option value="CC-Morning"       <%= shift.equalsIgnoreCase("CC-Morning")?"selected":"" %>>CC-Morning</option>
              <option value="General"          <%= shift.equalsIgnoreCase("General")?"selected":"" %>>D – General</option>
              <option value="WFH-General"      <%= shift.equalsIgnoreCase("WFH-General")?"selected":"" %>>WFH-General</option>
              <option value="CC-General"       <%= shift.equalsIgnoreCase("CC-General")?"selected":"" %>>CC-General</option>
              <option value="Afternoon"        <%= shift.equalsIgnoreCase("Afternoon")?"selected":"" %>>A – Afternoon</option>
              <option value="WFH-Afternoon"    <%= shift.equalsIgnoreCase("WFH-Afternoon")?"selected":"" %>>WFH-Afternoon</option>
              <option value="CC-Afternoon"     <%= shift.equalsIgnoreCase("CC-Afternoon")?"selected":"" %>>CC-Afternoon</option>
              <option value="Night"            <%= shift.equalsIgnoreCase("Night")?"selected":"" %>>N – Night</option>
              <option value="WFH-Night"        <%= shift.equalsIgnoreCase("WFH-Night")?"selected":"" %>>WFH-Night</option>
              <option value="CC-Night"         <%= shift.equalsIgnoreCase("CC-Night")?"selected":"" %>>CC-Night</option>
              <option value="Weekoff"          <%= shift.equalsIgnoreCase("Weekoff")?"selected":"" %>>W – Weekoff</option>
              <option value="WeekoffAdjust"    <%= shift.equalsIgnoreCase("WeekoffAdjust")?"selected":"" %>>WA – Weekoff Adjust</option>
              <option value="SickLeave"        <%= shift.equalsIgnoreCase("SickLeave")?"selected":"" %>>SL – Sick Leave</option>
              <option value="CasualLeave"      <%= shift.equalsIgnoreCase("CasualLeave")?"selected":"" %>>CL – Casual Leave</option>
              <option value="EarnedLeave"      <%= shift.equalsIgnoreCase("EarnedLeave")?"selected":"" %>>EL – Earned Leave</option>
              <option value="FlexiLeave"       <%= shift.equalsIgnoreCase("FlexiLeave")?"selected":"" %>>FL – Flexi Leave</option>
              <option value="HolidayLeave"     <%= shift.equalsIgnoreCase("HolidayLeave")?"selected":"" %>>HL – Holiday</option>
              <option value="NA"               <%= shift.equalsIgnoreCase("NA")?"selected":"" %>>– Not Assigned</option>
            </select>
          </td>
          <% } %>

          <td style="font-weight:800;color:var(--weekoff);"><%= woCount %></td>
          <td style="font-weight:800;color:var(--leave);"><%= lvCount %></td>
        </tr>
        <%
            empIdx++;
        }
        %>

        <!-- Summary rows -->
        <tr class="summary-row">
          <td class="sticky-col" colspan="2">Morning Count</td>
          <% for (int d=1; d<=noOfDays; d++) {
              int cnt = 0;
              for (Map<String,Object> emp : employees) {
                  Object v = emp.get("DAY_"+d);
                  String s = v != null ? v.toString().toLowerCase() : "";
                  if (s.contains("morning")) cnt++;
              }
          %>
            <td><span class="summary-val morning"><%= cnt %></span></td>
          <% } %>
          <td colspan="2"></td>
        </tr>
        <tr class="summary-row">
          <td class="sticky-col" colspan="2">General Count</td>
          <% for (int d=1; d<=noOfDays; d++) {
              int cnt = 0;
              for (Map<String,Object> emp : employees) {
                  Object v = emp.get("DAY_"+d);
                  String s = v != null ? v.toString().toLowerCase() : "";
                  if (s.contains("general") || s.contains("genral")) cnt++;
              }
          %>
            <td><span class="summary-val general"><%= cnt %></span></td>
          <% } %>
          <td colspan="2"></td>
        </tr>
        <tr class="summary-row">
          <td class="sticky-col" colspan="2">Afternoon Count</td>
          <% for (int d=1; d<=noOfDays; d++) {
              int cnt = 0;
              for (Map<String,Object> emp : employees) {
                  Object v = emp.get("DAY_"+d);
                  String s = v != null ? v.toString().toLowerCase() : "";
                  if (s.contains("afternoon")) cnt++;
              }
          %>
            <td><span class="summary-val afternoon"><%= cnt %></span></td>
          <% } %>
          <td colspan="2"></td>
        </tr>
        <tr class="summary-row">
          <td class="sticky-col" colspan="2">Night Count</td>
          <% for (int d=1; d<=noOfDays; d++) {
              int cnt = 0;
              for (Map<String,Object> emp : employees) {
                  Object v = emp.get("DAY_"+d);
                  String s = v != null ? v.toString().toLowerCase() : "";
                  if (s.contains("night")) cnt++;
              }
          %>
            <td><span class="summary-val night"><%= cnt %></span></td>
          <% } %>
          <td colspan="2"></td>
        </tr>
      </tbody>
    </table>
<% } %>

  </div>

  <% if (!employees.isEmpty()) { %>
  <div class="save-bar">
    <div class="save-info">
      💡 Click any cell to change the shift. Save when done.
    </div>
    <button type="button" class="btn-save" onclick="submitRoster()">
      <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      Save Roster
    </button>
  </div>
  <% } %>

  </form>
</div>

</div>

<script>
/* ============ SEARCH ============ */
document.getElementById('empSearch').addEventListener('input', function(e){
  var q = e.target.value.toLowerCase().trim();
  document.querySelectorAll('.emp-row').forEach(function(row){
    var name = row.getAttribute('data-name') || '';
    row.style.display = (!q || name.indexOf(q) !== -1) ? '' : 'none';
  });
});

/* ============ DAY CELL CLICK -> OPEN SELECT ============ */
document.querySelectorAll('.day-cell').forEach(function(cell){
  cell.addEventListener('click', function(e){
    if (e.target.tagName === 'SELECT' || e.target.tagName === 'OPTION') return;
    document.querySelectorAll('.day-cell.editing').forEach(function(c){
      if (c !== cell) c.classList.remove('editing');
    });
    cell.classList.add('editing');
    var sel = cell.querySelector('select');
    if (sel) {
      try { sel.focus(); } catch(err){}
    }
  });
});

/* Close editing on outside click */
document.addEventListener('click', function(e){
  if (!e.target.closest('.day-cell')) {
    document.querySelectorAll('.day-cell.editing').forEach(function(c){
      c.classList.remove('editing');
    });
  }
});

/* ============ UPDATE BADGE ON CHANGE ============ */
function updateBadge(select) {
  var cell = select.closest('.day-cell');
  var badge = cell.querySelector('.day-badge');
  var val = select.value;

  // Label
  var label = '–';
  var v = val.toLowerCase();
  if (v.indexOf('morning') !== -1) label = v.indexOf('wfh') !== -1 ? 'WH' : (v.indexOf('cc') !== -1 ? 'CC' : 'M');
  else if (v.indexOf('general') !== -1 || v.indexOf('genral') !== -1) label = v.indexOf('wfh') !== -1 ? 'WD' : (v.indexOf('cc') !== -1 ? 'CD' : 'D');
  else if (v.indexOf('afternoon') !== -1) label = v.indexOf('wfh') !== -1 ? 'WA' : (v.indexOf('cc') !== -1 ? 'CA' : 'A');
  else if (v.indexOf('night') !== -1) label = v.indexOf('wfh') !== -1 ? 'WN' : (v.indexOf('cc') !== -1 ? 'CN' : 'N');
  else if (v.indexOf('weekoffadjust') !== -1) label = 'WA';
  else if (v.indexOf('weekoff') !== -1) label = 'W';
  else if (v.indexOf('sickleave') !== -1) label = 'SL';
  else if (v.indexOf('casualleave') !== -1) label = 'CL';
  else if (v.indexOf('earnedleave') !== -1) label = 'EL';
  else if (v.indexOf('flexileave') !== -1) label = 'FL';
  else if (v.indexOf('holidayleave') !== -1) label = 'HL';
  else if (v.indexOf('leave') !== -1) label = 'L';

  badge.textContent = label;
  badge.className = 'day-badge ' + val.replace(/\s+/g, '');

  // Close after pick (mobile-friendly)
  setTimeout(function(){
    cell.classList.remove('editing');
  }, 300);
}

/* ============ SUBMIT ============ */
function submitRoster() {
  // Collect all select values into tableData JSON
  var data = [];
  document.querySelectorAll('#rosterTable tbody tr.emp-row').forEach(function(row, idx){
    var empName = row.querySelector('input[name="employeeName"]').value;
    var adId = row.querySelector('input[name="adId"]').value;
    var pos = row.querySelector('input[name="position_' + idx + '"]');
    var obj = { name: empName, adId: adId, position: pos ? pos.value : '' };
    row.querySelectorAll('select').forEach(function(sel){
      var m = sel.name.match(/mnt_(\d+)_(\d+)/);
      if (m) obj['day_' + m[2]] = sel.value;
    });
    data.push(obj);
  });

  document.getElementById('tableData').value = JSON.stringify(data);
  document.getElementById('rosterForm').submit();
}
</script>

</body>
</html>

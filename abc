    }
    #deleteSelected:hover {
      background-color: #b52d3a;
    }

    /* Checkbox styling */
    input[type="checkbox"] {
      width: 18px;
      height: 18px;
      cursor: pointer;
    }

    /* Update button */
    .update-btn {
      background-color: #0d6efd;
      border: none;
      color: white;
      padding: 6px 12px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 600;
    }
    .update-btn:hover {
      background-color: #0056b3;
    }

    /* Popup Modal */
    #updateModal {
      display: none;
      position: fixed;
      z-index: 9999;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: auto;
      background-color: rgba(0,0,0,0.7);
      align-items: center;
      justify-content: center;
    }
    #updateModal .modal-content {
      background-color: #222;
      padding: 20px;
      border-radius: 8px;
      max-width: 600px;
      margin: auto;
      color: #eee;
      font-size: 14px;
    }
    #updateModal label {
      display: block;
      margin-top: 10px;
      font-weight: 600;
    }
    #updateModal input[type="text"],
    #updateModal input[type="datetime-local"],
    #updateModal select,
    #updateModal textarea {
      width: 100%;
      padding: 6px;
      margin-top: 4px;
      border-radius: 4px;
      border: 1px solid #555;
      background-color: #1e1e1e;
      color: #eee;
      font-size: 14px;
    }
    #updateModal textarea {
      height: 60px;
    }
    .modal-buttons {
      margin-top: 15px;
      text-align: right;
    }
    .modal-buttons button {
      background-color: #0d6efd;
      border: none;
      color: white;
      padding: 8px 14px;
      margin-left: 10px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 600;
    }
    .modal-buttons button.cancel-btn {
      background-color: #6c757d;
    }
    .modal-buttons button.cancel-btn:hover {
      background-color: #5a6268;
    }
    .modal-buttons button:hover {
      background-color: #0056b3;
    }

    /* Horizontal Scroll */
    .dataTables_wrapper {
      width: 100%;
      overflow-x: auto;
    }
  </style>
</head>
<body>

  <h1>Deployment Sheet Master</h1>

  <div class="table-actions">
    <button id="deleteSelected">Delete Selected</button>
  </div>

  <table id="deploymentTable" class="display nowrap" style="width:100%">
    <thead>
      <tr>
        <th><input type="checkbox" id="deleteAll" title="Delete All"/></th>
        <th>EXP URL</th>
        <th>EXP URL W.R.T SYS URL</th>
        <th>API_NAME</th>
        <th>SOURCE_ID</th>
        <th>Broker</th>
        <th>Broker EG</th>
        <th>New/Existing/NBC</th>
        <th>Hits in Production</th>
        <th>Failure(More than 50%)</th>
        <th>Success</th>
        <th>Changes Description</th>
        <th>Remarks</th>
        <th>Deployment Date Time</th>
        <th>Update</th>
      </tr>
    </thead>
    <tbody>
      <%
            List<DeploymentSheetBean> deploymentData = (List<DeploymentSheetBean>) request.getAttribute("deploymentData");
            if (deploymentData != null) {
              for (DeploymentSheetBean bean : deploymentData) {
          %>
          <tr data-srno="<%= bean.getM_strSr_No() %>">
            <td><input type="checkbox" class="rowCheckbox" name="Result" value="<%= bean.getM_strSr_No() %>"/></td>
            <td><%= bean.getM_strExp_Sys_Url() %></td>
            <td><%= bean.getM_strExpUrl_WRT_SysUrl() %></td>
            <td><%= bean.getM_strApi_Name() %></td>
            <td><%= bean.getM_strSourceID() %></td>
            <td><%= bean.getM_strBroker() %></td>
            <td><%= bean.getM_strBroker_Eg() %></td>
            <td><%= bean.getM_strNew_Existing_NBC() %></td>
            <td><%= bean.getM_strHitsinproduction() %></td>
            <td><%= bean.getM_strFailure() %></td>
            <td><%= bean.getM_strSuccess() %></td>
            <td><%= bean.getM_changes_Description() %></td>
            <td><%= bean.getM_strRemarks() %></td>
            <td><%= bean.getM_strDeployment_Date_Time() %></td>
            <td><button class="update-btn">Update</button></td>
            
          </tr>
          <%  }
            }
          %>
       
    </tbody>
  </table>


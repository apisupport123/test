<!DOCTYPE html>
<%@ page import="java.sql.*" %>
<%@ page import="java.util.*" %>
<%@ page import="java.util.Locale" %>
<%@ page import="java.time.DayOfWeek" %>
<%@ page import="java.time.LocalDate" %>
<%@ page import="java.time.Month" %>
<%@ page import="java.time.format.TextStyle" %>
<%@ page import="java.time.YearMonth" %>
<%@ page import="java.time.ZoneId" %>
<%@ page import="com.jdbc.DBUtilityAuto" %>
<%@ page import="com.jdbc.DBUtility" %>

<%!
  // Shift value -> CSS class suffix
  public String mapShiftToClass(String val) {
      if (val == null) return "General";
      String v = val.toLowerCase().trim();
      if (v.contains("morning"))   return "Morning";
      if (v.contains("general") || v.contains("genral")) return "General";
      if (v.contains("afternoon")) return "Afternoon";
      if (v.contains("night"))     return "Night";
      if (v.contains("weekoff"))   return "Weekoff";
      if (v.contains("sick") || v.contains("casual") ||
          v.contains("earned") || v.equals("leave")) return "Leave";
      if (v.contains("flexi"))     return "Flexi";
      if (v.contains("holiday"))   return "Holiday";
      return "General";
  }

  public String safe(String s) {
      return s == null ? "" : s;
  }
%>

<%
  // ============ GET PARAMETERS ============
  String monthYr      = request.getParameter("myViewMonth");
  String m_strroles   = request.getParameter("m_strroles");
  String username     = request.getParameter("username");

  String selectedYear  = null;
  String selectedMonth = null;

  if (monthYr != null && monthYr.contains("-")) {
      String[] s = monthYr.split("-");
      selectedYear  = s[0];
      selectedMonth = s[1];
  } else {
      // Fallback: current month
      YearMonth now = YearMonth.now(ZoneId.of("Asia/Kolkata"));
      selectedYear  = String.valueOf(now.getYear());
      selectedMonth = String.format("%02d", now.getMonthValue());
  }

  if (m_strroles == null) m_strroles = "Manager";
  if (username   == null) username   = "";

  int year     = Integer.parseInt(selectedYear);
  int month    = Integer.parseInt(selectedMonth);
  int noOfDays = 0;

  if (month == 1 || month == 3 || month == 5 || month == 7 ||
      month == 8 || month == 10 || month == 12) {
      noOfDays = 31;
  } else if (month == 4 || month == 6 || month == 9 || month == 11) {
      noOfDays = 30;
  } else if (month == 2) {
      noOfDays = ((year % 400 == 0) || ((year % 100 != 0) && (year % 4 == 0))) ? 29 : 28;
  }

  // Month names
  String nameOfMonth = "January";
  String sortMonth   = "Jan";
  String[][] mn = {
      {"01","January","Jan"}, {"02","February","Feb"}, {"03","March","Mar"},
      {"04","April","Apr"},   {"05","May","May"},      {"06","June","Jun"},
      {"07","July","Jul"},    {"08","August","Aug"},   {"09","September","Sep"},
      {"10","October","Oct"}, {"11","November","Nov"}, {"12","December","Dec"}
  };
  for (String[] m : mn) {
      if (m[0].equals(selectedMonth)) {
          nameOfMonth = m[1];
          sortMonth   = m[2];
          break;
      }
  }

  String sort_MonthYear = sortMonth + "_" + selectedYear;

  YearMonth currentYM = YearMonth.now(ZoneId.of("Asia/Kolkata"));
  int currentYear     = currentYM.getYear();
  int currentMonth    = currentYM.getMonthValue();
  boolean showSubmit  = (year > currentYear) || (year == currentYear && month >= currentMonth);
%>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EIS Team Roster — <%= nameOfMonth %> <%= selectedYear %></title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-0: #0a0e1a;
    --bg-1: #111827;
    --bg-2: #1a2234;
    --bg-3: #232d42;
    --border: #2a3548;
    --text-0: #f1f5f9;
    --text-1: #cbd5e1;
    --text-2: #94a3b8;
    --accent: #6366f1;
    --accent-hover: #818cf8;

    --morning: #f97316;   --morning-bg: rgba(249, 115, 22, 0.15);
    --general: #94a3b8;   --general-bg: rgba(148, 163, 184, 0.15);
    --afternoon: #eab308; --afternoon-bg: rgba(234, 179, 8, 0.15);
    --night: #3b82f6;     --night-bg: rgba(59, 130, 246, 0.15);
    --weekoff: #8b5cf6;   --weekoff-bg: rgba(139, 92, 246, 0.15);
    --leave: #ef4444;     --leave-bg: rgba(239, 68, 68, 0.15);
    --flexi: #ec4899;     --flexi-bg: rgba(236, 72, 153, 0.15);
    --holiday: #10b981;   --holiday-bg: rgba(16, 185, 129, 0.15);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', -apple-system, sans-serif;
    background: var(--bg-0);
    color: var(--text-0);
    min-height: 100vh;
    padding: 20px;
    background-image:
      radial-gradient(circle at 20% 0%, rgba(99, 102, 241, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 100%, rgba(59, 130, 246, 0.06) 0%, transparent 50%);
  }

  /* HEADER */
  .app-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 18px 24px;
    background: linear-gradient(135deg, var(--bg-1), var(--bg-2));
    border: 1px solid var(--border);
    border-radius: 16px;
    margin-bottom: 20px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    flex-wrap: wrap; gap: 12px;
  }
  .header-left h1 {
    font-size: 22px; font-weight: 800; letter-spacing: -0.02em;
    background: linear-gradient(135deg, #fff, #94a3b8);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .header-left p { font-size: 13px; color: var(--text-2); margin-top: 4px; }
  .header-right { display: flex; gap: 10px; align-items: center; }

  /* CONTROLS */
  .control-bar {
    display: flex; gap: 12px; flex-wrap: wrap;
    padding: 16px 20px;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 14px;
    margin-bottom: 16px;
    align-items: flex-end;
  }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .field label {
    font-size: 11px; font-weight: 600; color: var(--text-2);
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .field select, .field input {
    background: var(--bg-2); border: 1px solid var(--border); color: var(--text-0);
    padding: 9px 12px; border-radius: 9px; font-size: 14px;
    font-family: inherit; outline: none; transition: all 0.2s; min-width: 140px;
  }
  .field select:focus, .field input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
  }

  .btn {
    padding: 10px 20px; border-radius: 9px; border: none;
    font-family: inherit; font-weight: 600; font-size: 14px;
    cursor: pointer; transition: all 0.2s;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--accent), #4f46e5);
    color: white; box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
  }
  .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(99, 102, 241, 0.45); }
  .btn-success {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  }
  .btn-success:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(16, 185, 129, 0.45); }

  /* LEGEND */
  .legend {
    display: flex; flex-wrap: wrap; gap: 8px;
    padding: 12px 16px;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 16px;
  }
  .legend-item {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 10px; border-radius: 7px;
    font-size: 12px; font-weight: 600;
    background: var(--bg-2); border: 1px solid var(--border);
    color: var(--text-1);
  }
  .legend-dot { width: 10px; height: 10px; border-radius: 50%; }

  /* TABLE */
  .table-wrapper {
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  }
  .table-scroll {
    overflow-x: auto;
    overflow-y: auto;
    max-height: 68vh;
  }
  table {
    border-collapse: separate; border-spacing: 0;
    width: 100%; font-size: 13px; white-space: nowrap;
  }
  thead th {
    position: sticky; top: 0; z-index: 10;
    background: var(--bg-3); color: var(--text-1);
    font-weight: 700; font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.05em; padding: 12px 10px;
    border-bottom: 2px solid var(--border);
    text-align: center;
  }
  thead th:first-child { position: sticky; left: 0; z-index: 12; text-align: left; min-width: 200px; }
  thead th:nth-child(2) { position: sticky; left: 200px; z-index: 12; min-width: 140px; }

  tbody td {
    padding: 4px 6px;
    border-bottom: 1px solid var(--border);
    text-align: center;
    color: var(--text-1);
    background: var(--bg-1);
    transition: background 0.15s;
  }
  tbody td:first-child {
    position: sticky; left: 0; z-index: 5;
    background: var(--bg-2);
    text-align: left; font-weight: 600; color: var(--text-0);
    min-width: 200px; max-width: 200px;
    overflow: hidden; text-overflow: ellipsis;
    padding-left: 12px;
  }
  tbody td:nth-child(2) {
    position: sticky; left: 200px; z-index: 5;
    background: var(--bg-2);
    min-width: 140px;
  }
  tbody tr:hover td { background: var(--bg-2); }
  tbody tr:hover td:first-child,
  tbody tr:hover td:nth-child(2) { background: var(--bg-3); }

  /* SHIFT SELECT */
  .shift-select {
    width: 100%; border: none; background: transparent;
    color: inherit; font-family: inherit; font-weight: 700;
    font-size: 12px; text-align: center; cursor: pointer;
    padding: 6px 4px; border-radius: 6px; outline: none;
    transition: all 0.15s;
    appearance: none; -webkit-appearance: none;
    text-align-last: center;
  }
  .shift-select:hover { background: rgba(255,255,255,0.06); }
  .shift-select:focus { box-shadow: 0 0 0 2px var(--accent); }

  .shift-Morning   { color: var(--morning);   background: var(--morning-bg);   }
  .shift-General   { color: var(--general);   background: var(--general-bg);   }
  .shift-Afternoon { color: var(--afternoon); background: var(--afternoon-bg); }
  .shift-Night     { color: var(--night);     background: var(--night-bg);     }
  .shift-Weekoff   { color: var(--weekoff);   background: var(--weekoff-bg);   }
  .shift-Leave     { color: var(--leave);     background: var(--leave-bg);     }
  .shift-Flexi     { color: var(--flexi);     background: var(--flexi-bg);     }
  .shift-Holiday   { color: var(--holiday);   background: var(--holiday-bg);   }

  /* SUMMARY */
  .summary-row td {
    font-weight: 700; font-size: 12px;
    background: var(--bg-3) !important;
    color: var(--text-0);
    border-top: 2px solid var(--border);
    padding: 10px 8px;
  }
  .summary-row td:first-child {
    position: sticky; left: 0; z-index: 6;
    background: var(--bg-3) !important;
    text-transform: uppercase; letter-spacing: 0.04em;
    font-size: 11px; text-align: left; padding-left: 12px;
    min-width: 200px;
  }
  .summary-row td:nth-child(2) {
    position: sticky; left: 200px; z-index: 6;
    background: var(--bg-3) !important;
    min-width: 140px;
  }

  .badge {
    display: inline-block; padding: 3px 9px; border-radius: 6px;
    font-size: 11px; font-weight: 700; min-width: 26px;
  }
  .badge-morning   { background: var(--morning-bg);   color: var(--morning);   }
  .badge-general   { background: var(--general-bg);   color: var(--general);   }
  .badge-afternoon { background: var(--afternoon-bg); color: var(--afternoon); }
  .badge-night     { background: var(--night-bg);     color: var(--night);     }

  /* FOOTER */
  .footer-actions {
    display: flex; justify-content: flex-end; gap: 12px;
    padding: 16px 20px;
    background: var(--bg-2);
    border-top: 1px solid var(--border);
  }

  /* EMPTY STATE */
  .empty-state {
    text-align: center; padding: 60px 20px; color: var(--text-2);
  }
  .empty-state h3 { font-size: 18px; margin-bottom: 8px; color: var(--text-1); }

  /* SCROLLBAR */
  .table-scroll::-webkit-scrollbar { width: 10px; height: 10px; }
  .table-scroll::-webkit-scrollbar-track { background: var(--bg-0); }
  .table-scroll::-webkit-scrollbar-thumb { background: var(--bg-3); border-radius: 5px; }
  .table-scroll::-webkit-scrollbar-thumb:hover { background: var(--accent); }

  /* TOAST */
  .toast {
    position: fixed; bottom: 24px; right: 24px;
    background: linear-gradient(135deg, #10b981, #059669);
    color: white; padding: 14px 20px; border-radius: 12px;
    box-shadow: 0 10px 40px rgba(16,185,129,0.4);
    font-weight: 600; font-size: 14px;
    opacity: 0; transform: translateY(20px);
    transition: all 0.3s; pointer-events: none; z-index: 9999;
  }
  .toast.show { opacity: 1; transform: translateY(0); }

  @media (max-width: 768px) {
    body { padding: 10px; }
    .app-header { flex-direction: column; align-items: flex-start; }
    .control-bar { flex-direction: column; align-items: stretch; }
    .field select, .field input { width: 100%; }
  }
</style>
</head>
<body>

<!-- ============ HEADER ============ -->
<div class="app-header">
  <div class="header-left">
    <h1>EIS Team Roster</h1>
    <p><%= m_strroles %> &nbsp;•&nbsp; <%= nameOfMonth %> <%= selectedYear %></p>
  </div>
  <div class="header-right">
    <button class="btn btn-success" onclick="prepareData()">💾 Submit Roster</button>
  </div>
</div>

<!-- ============ CONTROLS ============ -->
<form id="monthYearForm" method="get" class="control-bar">
  <div class="field">
    <label for="month">Month</label>
    <select name="month" id="month" required>
      <% for (String[] m : mn) {
           String sel = m[0].equals(selectedMonth) ? "selected" : "";
      %>
        <option value="<%= m[0] %>" <%= sel %>><%= m[1] %></option>
      <% } %>
    </select>
  </div>
  <div class="field">
    <label for="year">Year</label>
    <input type="number" id="year" name="year" min="2024" max="2100"
           value="<%= selectedYear %>" required>
  </div>
  <div class="field">
    <label for="myViewMonth">Or Pick (YYYY-MM)</label>
    <input type="text" id="myViewMonth" name="myViewMonth"
           placeholder="<%= selectedYear %>-<%= selectedMonth %>"
           value="<%= selectedYear %>-<%= selectedMonth %>">
  </div>
  <input type="hidden" name="m_strroles" value="<%= m_strroles %>">
  <input type="hidden" name="username"   value="<%= username %>">
  <div class="field">
    <label>&nbsp;</label>
    <button type="button" class="btn btn-primary" onclick="submitMonthForm()">🔄 Load Roster</button>
  </div>
</form>

<!-- ============ LEGEND ============ -->
<div class="legend">
  <span class="legend-item"><span class="legend-dot" style="background:var(--morning)"></span>Morning</span>
  <span class="legend-item"><span class="legend-dot" style="background:var(--general)"></span>General</span>
  <span class="legend-item"><span class="legend-dot" style="background:var(--afternoon)"></span>Afternoon</span>
  <span class="legend-item"><span class="legend-dot" style="background:var(--night)"></span>Night</span>
  <span class="legend-item"><span class="legend-dot" style="background:var(--weekoff)"></span>Weekoff</span>
  <span class="legend-item"><span class="legend-dot" style="background:var(--leave)"></span>Leave</span>
  <span class="legend-item"><span class="legend-dot" style="background:var(--flexi)"></span>Flexi</span>
  <span class="legend-item"><span class="legend-dot" style="background:var(--holiday)"></span>Holiday</span>
</div>

<!-- ============ ROSTER TABLE ============ -->
<form id="rosterForm" action="RosterServlet" method="post">
  <input type="hidden" id="tableData" name="tableData">

  <div class="table-wrapper">
    <div class="table-scroll">
      <table id="rosterTable">
        <thead>
          <tr>
            <th>Employee</th>
            <th>Position</th>
            <% for (int d = 1; d <= noOfDays; d++) {
                 LocalDate dt = LocalDate.of(year, month, d);
                 String dow = dt.getDayOfWeek().getDisplayName(TextStyle.SHORT, Locale.ENGLISH);
            %>
              <th><%= d %><br><span style="font-size:9px;color:var(--text-2);font-weight:500;"><%= dow %></span></th>
            <% } %>
            <th>W/Off</th>
            <th>Leave</th>
          </tr>
        </thead>

        <tbody>
        <%
          Connection conn = null;
          PreparedStatement pstmt = null;
          ResultSet rs2 = null;
          boolean hasData = false;
          int rowIdx = 0;

          try {
              conn = DBUtilityAuto.getReportDBConnection();

              String q = "SELECT * FROM rostertable " +
                         "WHERE UPPER(TEAM) = UPPER(?) " +
                         "AND UPPER(MONTHYEAR) = UPPER(?) " +
                         "ORDER BY id";
              pstmt = conn.prepareStatement(q);
              pstmt.setString(1, m_strroles);
              pstmt.setString(2, sort_MonthYear);
              rs2 = pstmt.executeQuery();

              while (rs2.next()) {
                  hasData = true;
                  String empName  = safe(rs2.getString("NAME"));
                  String adId     = safe(rs2.getString("AD_ID"));
                  String position = safe(rs2.getString("POSITION"));
        %>
          <tr>
            <td title="<%= empName %>">
              <%= empName %>
              <input type="hidden" name="employeeName" value="<%= empName %>">
              <input type="hidden" name="adId"         value="<%= adId %>">
            </td>

            <td>
              <select name="position_<%= rowIdx %>"
                      class="shift-select shift-General"
                      style="font-weight:600;">
                <option value="">-- Select --</option>
                <option value="Manager"   <%= "Manager".equalsIgnoreCase(position)?"selected":"" %>>Manager</option>
                <option value="Team Lead" <%= "Team Lead".equalsIgnoreCase(position)?"selected":"" %>>Team Lead</option>
                <option value="Senior"    <%= "Senior".equalsIgnoreCase(position)?"selected":"" %>>Senior</option>
                <option value="Junior"    <%= "Junior".equalsIgnoreCase(position)?"selected":"" %>>Junior</option>
              </select>
            </td>

            <%
              int weekOff = 0, leaveCount = 0;
              for (int day = 1; day <= noOfDays; day++) {
                  String dayCol = "DAY_" + day;
                  String val    = safe(rs2.getString(dayCol));
                  if (val.isEmpty()) val = "NA";

                  String lv = val.toLowerCase();
                  if (lv.equals("weekoff") || lv.equals("weekoffadjust")) weekOff++;
                  if (lv.equals("leave") || lv.equals("sickleave") ||
                      lv.equals("casualleave") || lv.equals("earnedleave") ||
                      lv.equals("flexileave") || lv.equals("holidayleave")) leaveCount++;

                  String cls = mapShiftToClass(val);
                  String shortVal =
                      lv.contains("morning")   ? "M(o)"   :
                      (lv.contains("general") || lv.contains("genral")) ? "D(o)" :
                      lv.contains("afternoon") ? "A(o)"   :
                      lv.contains("night")     ? "N(o)"   :
                      lv.equals("weekoff")     ? "W"      :
                      lv.equals("sickleave")   ? "SL"     :
                      lv.equals("casualleave") ? "CL"     :
                      lv.equals("earnedleave") ? "EL"     :
                      lv.equals("flexileave")  ? "FL"     :
                      lv.equals("holidayleave")? "HL"     :
                      lv.equals("na")          ? " "      : val;
            %>
              <td>
                <select name="mnt_<%= rowIdx %>_<%= day %>"
                        class="shift-select shift-<%= cls %>"
                        onchange="onShiftChange(this)">
                  <option value="Morning"      <%= val.equalsIgnoreCase("Morning")?"selected":"" %>>M(o)</option>
                  <option value="WFH-Morning"  <%= val.equalsIgnoreCase("WFH-Morning")?"selected":"" %>>WFH-M</option>
                  <option value="CC-Morning"   <%= val.equalsIgnoreCase("CC-Morning")?"selected":"" %>>CC-M</option>
                  <option value="General"      <%= (val.equalsIgnoreCase("General")||val.equalsIgnoreCase("Genral"))?"selected":"" %>>D(o)</option>
                  <option value="WFH-General"  <%= (val.equalsIgnoreCase("WFH-General")||val.equalsIgnoreCase("WFH-Genral"))?"selected":"" %>>WFH-D</option>
                  <option value="CC-General"   <%= val.equalsIgnoreCase("CC-General")?"selected":"" %>>CC-D</option>
                  <option value="Afternoon"    <%= val.equalsIgnoreCase("Afternoon")?"selected":"" %>>A(o)</option>
                  <option value="WFH-Afternoon"<%= val.equalsIgnoreCase("WFH-Afternoon")?"selected":"" %>>WFH-A</option>
                  <option value="CC-Afternoon" <%= val.equalsIgnoreCase("CC-Afternoon")?"selected":"" %>>CC-A</option>
                  <option value="Night"        <%= val.equalsIgnoreCase("Night")?"selected":"" %>>N(o)</option>
                  <option value="WFH-Night"    <%= val.equalsIgnoreCase("WFH-Night")?"selected":"" %>>WFH-N</option>
                  <option value="CC-Night"     <%= val.equalsIgnoreCase("CC-Night")?"selected":"" %>>CC-N</option>
                  <option value="Weekoff"      <%= val.equalsIgnoreCase("Weekoff")?"selected":"" %>>W</option>
                  <option value="SickLeave"    <%= val.equalsIgnoreCase("SickLeave")?"selected":"" %>>SL</option>
                  <option value="CasualLeave"  <%= val.equalsIgnoreCase("CasualLeave")?"selected":"" %>>CL</option>
                  <option value="EarnedLeave"  <%= val.equalsIgnoreCase("EarnedLeave")?"selected":"" %>>EL</option>
                  <option value="FlexiLeave"   <%= val.equalsIgnoreCase("FlexiLeave")?"selected":"" %>>FL</option>
                  <option value="HolidayLeave" <%= val.equalsIgnoreCase("HolidayLeave")?"selected":"" %>>HL</option>
                  <option value="NA"           <%= val.equalsIgnoreCase("NA")?"selected":"" %>> </option>
                </select>
              </td>
            <% } %>
            <td><span class="badge badge-general"><%= weekOff %></span></td>
            <td><span class="badge badge-general"><%= leaveCount %></span></td>
          </tr>
        <%
            rowIdx++;
            } // end while

            if (!hasData) {
        %>
          <tr>
            <td colspan="<%= noOfDays + 4 %>" class="empty-state">
              <h3>No roster data found</h3>
              <p>Team: <b><%= m_strroles %></b> | Month: <b><%= sort_MonthYear %></b></p>
            </td>
          </tr>
        <%
            }
          } catch (Exception e) {
              e.printStackTrace();
        %>
          <tr>
            <td colspan="<%= noOfDays + 4 %>" class="empty-state">
              <h3>⚠️ Error loading roster</h3>
              <p><%= e.getMessage() %></p>
            </td>
          </tr>
        <%
          } finally {
              try { if (rs2   != null) rs2.close();   } catch (Exception ignored) {}
              try { if (pstmt != null) pstmt.close(); } catch (Exception ignored) {}
              try { if (conn  != null) conn.close();  } catch (Exception ignored) {}
          }
        %>
        </tbody>

        <!-- ============ SUMMARY ROWS ============ -->
        <tfoot>
        <%
          String[] shifts = {"Morning", "General", "Afternoon", "Night"};
          String[] badge  = {"badge-morning", "badge-general", "badge-afternoon", "badge-night"};
          String[] conds  = {
              "('morning','wfh-morning','cc-morning')",
              "('genral','general','wfh-genral','wfh-general','cc-general')",
              "('afternoon','wfh-afternoon','cc-afternoon')",
              "('night','wfh-night','cc-night')"
          };

          // Re-open connection for summary (previous closed)
          Connection conn2 = null;
          try {
              conn2 = DBUtilityAuto.getReportDBConnection();

              for (int sIdx = 0; sIdx < shifts.length; sIdx++) {
        %>
          <tr class="summary-row">
            <td colspan="2">No. of Emp in <%= shifts[sIdx] %></td>
            <%
                for (int k = 1; k <= noOfDays; k++) {
                    String q = "SELECT COUNT(1) c FROM rostertable " +
                               "WHERE LOWER(DAY_" + k + ") IN " + conds[sIdx] +
                               " AND UPPER(MONTHYEAR) = UPPER(?) " +
                               " AND UPPER(TEAM) = UPPER(?)";
                    int c = 0;
                    try (PreparedStatement ps = conn2.prepareStatement(q)) {
                        ps.setString(1, sort_MonthYear);
                        ps.setString(2, m_strroles);
                        try (ResultSet r = ps.executeQuery()) {
                            if (r.next()) c = r.getInt("c");
                        }
                    } catch (Exception ignored) {}
            %>
              <td><span class="badge <%= badge[sIdx] %>"><%= c %></span></td>
            <% } %>
            <td></td><td></td>
          </tr>
        <%
              } // end for shifts
          } catch (Exception e) {
              e.printStackTrace();
          } finally {
              try { if (conn2 != null) conn2.close(); } catch (Exception ignored) {}
          }
        %>
        </tfoot>
      </table>
    </div>

    <!-- FOOTER -->
    <div class="footer-actions">
      <input type="hidden" name="selectedMonth" value="<%= selectedMonth %>">
      <input type="hidden" name="selectedYear"  value="<%= selectedYear %>">
      <input type="hidden" name="m_strroles"    value="<%= m_strroles %>">
      <input type="hidden" name="username"      value="<%= username %>">
      <% if (showSubmit) { %>
        <button type="button" class="btn btn-success" onclick="prepareData()">
          ✓ Submit Roster
        </button>
      <% } else { %>
        <button type="button" class="btn" disabled
                style="background:var(--bg-3);color:var(--text-2);cursor:not-allowed;">
          🔒 Past month — read only
        </button>
      <% } %>
    </div>
  </div>
</form>

<!-- TOAST -->
<div class="toast" id="toast">✓ Saved successfully</div>

<script>
  // ============ SHIFT COLOR UPDATER ============
  function onShiftChange(selectEl) {
    const val = selectEl.value.toLowerCase();
    const all = ['shift-Morning','shift-General','shift-Afternoon','shift-Night',
                 'shift-Weekoff','shift-Leave','shift-Flexi','shift-Holiday'];
    selectEl.classList.remove(...all);

    let cls = 'shift-General';
    if (val.includes('morning'))   cls = 'shift-Morning';
    else if (val.includes('general') || val.includes('genral')) cls = 'shift-General';
    else if (val.includes('afternoon')) cls = 'shift-Afternoon';
    else if (val.includes('night')) cls = 'shift-Night';
    else if (val.includes('weekoff')) cls = 'shift-Weekoff';
    else if (val.includes('sick') || val.includes('casual') ||
             val.includes('earned') || val === 'leave') cls = 'shift-Leave';
    else if (val.includes('flexi')) cls = 'shift-Flexi';
    else if (val.includes('holiday')) cls = 'shift-Holiday';

    selectEl.classList.add(cls);
  }

  // ============ MONTH FORM SUBMIT ============
  function submitMonthForm() {
    const form = document.getElementById("monthYearForm");
    const y = document.getElementById("year").value;
    const m = document.getElementById("month").value;
    // Set myViewMonth so JSP picks it up
    document.getElementById("myViewMonth").value =
        y + "-" + (m.length === 1 ? "0" + m : m);
    form.submit();
  }

  // ============ ROSTER SUBMIT ============
  function prepareData() {
    // Serialize the table for the servlet
    const form = document.forms["rosterForm"];
    form.action = '<%= request.getContextPath() + "/RosterServlet" %>';
    form.submit();
  }

  // ============ URL CLEANUP ============
  window.addEventListener('load', function () {
    // no-op — kept for compatibility
  });
</script>
</body>
</html>

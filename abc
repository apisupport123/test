    }

    // Redirect to remove action parameter but keep filters & mute
    String redirectUrl = request.getRequestURI() + "?mute=" + isMuted;
    if (request.getParameter("fromTime") != null) redirectUrl += "&fromTime=" + request.getParameter("fromTime");
    if (request.getParameter("toTime") != null) redirectUrl += "&toTime=" + request.getParameter("toTime");
    response.sendRedirect(redirectUrl);
    return;

package com.action;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.io.OutputStream;
import java.net.URLConnection;
import java.sql.Blob;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;

import com.jdbc.DBUtilityAuto;

@WebServlet("/DocumentDownloadServlet")
public class DocumentDownloadServlet extends HttpServlet {

    private static final long serialVersionUID = 1L;

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        String empId   = request.getParameter("empid");
        String docType = request.getParameter("type");

        System.out.println("[DOC-DOWNLOAD] empid=" + empId + " type=" + docType);

        if (empId == null || empId.trim().isEmpty()
                || docType == null || docType.trim().isEmpty()) {
            response.sendError(HttpServletResponse.SC_BAD_REQUEST, "Missing parameters");
            return;
        }

        Connection conn = null;
        PreparedStatement stmt = null;
        ResultSet rs = null;

        try {
            conn = DBUtilityAuto.getReportDBConnection();

            String columnName;
            String baseFileName;

            switch (docType.toUpperCase()) {
                case "BGC":    columnName = "BGC_DOCUMENT_PATH";        baseFileName = "bgc";    break;
                case "PHOTO":  columnName = "PHOTO_PATH";               baseFileName = "photo";  break;
                case "POLICE": columnName = "POLICE_VERIFICATION_PATH"; baseFileName = "police"; break;
                case "CV":     columnName = "CV_DOCUMENT_PATH";         baseFileName = "cv";     break;
                default:
                    response.sendError(HttpServletResponse.SC_BAD_REQUEST, "Invalid docType");
                    return;
            }

            String sql = "SELECT " + columnName
                       + " FROM eisupport_employee_master WHERE EMPLOYEE_ID = ?";
            stmt = conn.prepareStatement(sql);
            stmt.setString(1, empId);
            rs = stmt.executeQuery();

            if (!rs.next()) {
                System.out.println("[DOC-DOWNLOAD] Employee not found: " + empId);
                response.sendError(HttpServletResponse.SC_NOT_FOUND, "Employee not found");
                return;
            }

            Blob blob = rs.getBlob(1);

            if (blob == null) {
                System.out.println("[DOC-DOWNLOAD] BLOB is NULL for " + docType);
                response.sendError(HttpServletResponse.SC_NOT_FOUND, "No document uploaded");
                return;
            }

            long length = blob.length();
            System.out.println("[DOC-DOWNLOAD] BLOB size = " + length + " bytes");

            if (length == 0) {
                System.out.println("[DOC-DOWNLOAD] BLOB is EMPTY for " + docType);
                response.sendError(HttpServletResponse.SC_NOT_FOUND, "Empty document");
                return;
            }

            byte[] data = blob.getBytes(1, (int) length);

            String mimeType = URLConnection.guessContentTypeFromStream(
                    new ByteArrayInputStream(data));

            if (mimeType == null) {
                mimeType = detectFromMagicBytes(data);
            }
            if (mimeType == null) {
                if ("PHOTO".equals(docType)) {
                    mimeType = "image/jpeg";
                } else {
                    mimeType = "application/pdf";
                }
            }

            System.out.println("[DOC-DOWNLOAD] MIME: " + mimeType);

            String ext = getExtensionFromMimeType(mimeType);
            String filename = baseFileName + "_" + empId + ext;

            response.setContentType(mimeType);
            response.setContentLength(data.length);

            boolean inline = mimeType.startsWith("image/")
                          || mimeType.equals("application/pdf");
            String disposition = (inline ? "inline" : "attachment")
                               + "; filename=\"" + filename + "\"";
            response.setHeader("Content-Disposition", disposition);
            response.setHeader("Cache-Control", "private, max-age=3600");

            OutputStream os = response.getOutputStream();
            os.write(data);
            os.flush();

            System.out.println("[DOC-DOWNLOAD] Served " + filename
                               + " (" + data.length + " bytes)");

        } catch (Exception e) {
            System.out.println("[DOC-DOWNLOAD] EXCEPTION: " + e.getClass().getName()
                               + " - " + e.getMessage());
            e.printStackTrace();
            if (!response.isCommitted()) {
                response.sendError(HttpServletResponse.SC_INTERNAL_SERVER_ERROR,
                                   "Error retrieving document");
            }
        } finally {
            try { if (rs   != null) rs.close();   } catch (Exception ignore) {}
            try { if (stmt != null) stmt.close(); } catch (Exception ignore) {}
            try { if (conn != null) conn.close(); } catch (Exception ignore) {}
        }
    }

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        doGet(request, response);
    }

    private String detectFromMagicBytes(byte[] d) {
        if (d == null || d.length < 4) return null;
        if (d[0] == 0x25 && d[1] == 0x50 && d[2] == 0x44 && d[3] == 0x46) return "application/pdf";
        if ((d[0] & 0xFF) == 0xFF && (d[1] & 0xFF) == 0xD8 && (d[2] & 0xFF) == 0xFF) return "image/jpeg";
        if ((d[0] & 0xFF) == 0x89 && d[1] == 0x50 && d[2] == 0x4E && d[3] == 0x47) return "image/png";
        if (d[0] == 0x47 && d[1] == 0x49 && d[2] == 0x46) return "image/gif";
        if (d[0] == 0x50 && d[1] == 0x4B) return "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
        if ((d[0] & 0xFF) == 0xD0 && (d[1] & 0xFF) == 0xCF) return "application/msword";
        return null;
    }

    private String getExtensionFromMimeType(String mimeType) {
        switch (mimeType) {
            case "image/png":       return ".png";
            case "image/jpeg":      return ".jpg";
            case "image/gif":       return ".gif";
            case "application/pdf": return ".pdf";
            case "application/msword": return ".doc";
            case "application/vnd.openxmlformats-officedocument.wordprocessingml.document": return ".docx";
            default:                return "";
        }
    }
}


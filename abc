        <div class="field">
          <div class="field-label">
            <span><span class="prompt">$</span> ADMIN_KEY</span>
            <span>SECURE</span>
          </div>
          <div class="field-input-wrap">
            <i class="fa-solid fa-key field-icon"></i>
            <input type="password" placeholder="••••••••" name="m_stradminPassword" id="m_stradminPassword" autocomplete="current-password" />
            <button type="button" class="pw-toggle" onclick="togglePw('m_stradminPassword', this)"><i class="fa-solid fa-eye"></i></button>
          </div>
        </div>

        <button type="button" class="btn-primary" id="btnAdminLogin" onclick="adminsign()">
          <span class="spinner"></span>
          <span class="btn-text">Authenticate</span>
          <i class="fa-solid fa-arrow-right btn-arrow"></i>

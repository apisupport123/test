<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>EISPortal</display-name>

    <!-- ============================================================
         SESSION CONFIG — 12 HOURS (720 minutes)
         ============================================================ -->
    <session-config>
        <session-timeout>720</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>  <!-- production HTTPS: true -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- ============================================================
         STRUTS 2 FILTER
         ============================================================ -->
    <filter>
        <filter-name>struts2</filter-name>
        <filter-class>
            org.apache.struts2.dispatcher.filter.StrutsPrepareAndExecuteFilter
        </filter-class>
    </filter>
    <filter-mapping>
        <filter-name>struts2</filter-name>
        <url-pattern>*.action</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>
    <filter-mapping>
        <filter-name>struts2</filter-name>
        <url-pattern>*.do</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>

    <!-- ============================================================
         CORS FILTER
         ============================================================ -->
    <filter>
        <filter-name>CORSFilter</filter-name>
        <filter-class>com.action.CORSFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CORSFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ============================================================
         SERVLET: TestServlet (debug.jsp)
         ============================================================ -->
    <servlet>
        <servlet-name>TestServlet</servlet-name>
        <jsp-file>/debug.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>TestServlet</servlet-name>
        <url-pattern>/test</url-pattern>
    </servlet-mapping>

    <!-- ============================================================
         WELCOME FILE LIST
         ============================================================ -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
        <welcome-file>index.htm</welcome-file>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>default.html</welcome-file>
        <welcome-file>default.htm</welcome-file>
        <welcome-file>default.jsp</welcome-file>
    </welcome-file-list>

    <!-- ============================================================
         SERVLET: DocumentDownloadServlet
         ============================================================ -->
    <servlet>
        <description></description>
        <display-name>DocumentDownloadServlet</display-name>
        <servlet-name>DocumentDownloadServlet</servlet-name>
        <servlet-class>com.action.DocumentDownloadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DocumentDownloadServlet</servlet-name>
        <url-pattern>/DocumentDownloadServlet</url-pattern>
    </servlet-mapping>

    <!-- ============================================================
         SERVLET: ViewDeploymentSheetActionServ
         ============================================================ -->
    <servlet>
        <description></description>
        <display-name>ViewDeploymentSheetActionServ</display-name>
        <servlet-name>ViewDeploymentSheetActionServ</servlet-name>
        <servlet-class>com.action.ViewDeploymentSheetActionServ</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewDeploymentSheetActionServ</servlet-name>
        <url-pattern>/ViewDeploymentSheetActionServ</url-pattern>
    </servlet-mapping>

    <!-- ============================================================
         SERVLET: DeploymentSheetServlet
         ============================================================ -->
    <servlet>
        <description></description>
        <display-name>DeploymentSheetServlet</display-name>
        <servlet-name>DeploymentSheetServlet</servlet-name>
        <servlet-class>com.action.DeploymentSheetServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeploymentSheetServlet</servlet-name>
        <url-pattern>/DeploymentSheetServlet</url-pattern>
    </servlet-mapping>

    <!-- ============================================================
         SERVLET: UpdateMonthlyRosterAction
         ============================================================ -->
    <servlet>
        <description></description>
        <display-name>UpdateMonthlyRosterAction</display-name>
        <servlet-name>UpdateMonthlyRosterAction</servlet-name>
        <servlet-class>com.action.UpdateMonthlyRosterAction</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateMonthlyRosterAction</servlet-name>
        <url-pattern>/UpdateMonthlyRosterAction</url-pattern>
    </servlet-mapping>

</web-app>

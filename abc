  --sidebar-w:260px;
  --topnav-h:64px;
  --green:#10B981;
  --blue:#3B82F6;
  --purple:#8B5CF6;
  --pink:#EC4899;
  --amber:#F59E0B;
  --cyan:#06B6D4;
  --red:#EF4444;
}
html[data-theme="dark"]{
  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#272727;
  --bg:#0F0F0F;
  --card:#161616;
  --hero-dark:#0B0B0B;
  --hero-dark-2:#1A1A1A;
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  font-family:var(--font-stack);
  font-weight:700;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  min-height:100vh;
  transition:background .3s ease,color .3s ease;
}
a{color:inherit;text-decoration:none}
h1,h2,h3,h4,h5,h6,strong,b{font-weight:800;letter-spacing:-.3px}

.icon-svg{
  width:16px;height:16px;
  display:inline-block;flex-shrink:0;
  stroke:currentColor;fill:none;
  stroke-width:2.2;
  stroke-linecap:round;stroke-linejoin:round;
}

/* ============ WRAPPER ============ */
.new-wrapper{
  margin-left:var(--sidebar-w);
  padding-top:var(--topnav-h);
  transition:margin-left .3s cubic-bezier(.4,0,.2,1);
  min-height:100vh;
}
html.sb-collapsed .new-wrapper{margin-left:0}
.dash-wrap{
  max-width:1500px;
  margin:0 auto;
  padding:28px 28px 60px;
}

/* ============ PAGE HEAD ============ */
.page-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:16px;
  margin-bottom:24px;
  flex-wrap:wrap;
}
.page-head .ttl-wrap{flex:1;min-width:260px;}
.page-head .ttl{
  display:flex;
  align-items:center;
  gap:14px;
  font-size:1.65rem;
  font-weight:900;
  letter-spacing:-.6px;
  line-height:1.2;
  margin-bottom:6px;
}
.page-head .ttl .ttl-icon{
  width:48px;height:48px;
  display:grid;place-items:center;
  background:linear-gradient(135deg,var(--brand),var(--brand-2));
  color:#fff;
  border-radius:14px;
  font-size:1.2rem;
  flex-shrink:0;
  box-shadow:0 8px 22px -6px var(--brand-glow);
}
.page-head .ttl .ttl-icon .icon-svg{width:22px;height:22px;stroke-width:2.4;}
.page-head .sub{
  color:var(--muted);
  font-size:.85rem;
  margin-left:62px;
  font-weight:600;
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}
.page-head .sub .partition-badge{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:4px 12px;
  background:var(--card);
  border:1px solid var(--line);
  border-radius:999px;
  font-family:'JetBrains Mono',Consolas,monospace;
  font-size:.72rem;
  font-weight:800;
  color:var(--brand);
  letter-spacing:.3px;
}

/* ============ HEADER ACTIONS ============ */
.head-actions{
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
}
.live-badge{
  display:flex;
  align-items:center;
  gap:8px;
  padding:10px 16px;
  background:var(--card);
  border:1px solid var(--line);
  border-radius:12px;
  font-size:.72rem;
  font-weight:800;
  color:var(--green);
  text-transform:uppercase;
  letter-spacing:.5px;
}
.live-badge .dot{
  width:8px;height:8px;
  border-radius:50%;
  background:var(--green);
  animation:pulseDot 1.5s ease-in-out infinite;
  box-shadow:0 0 10px var(--green);
}
@keyframes pulseDot{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.4;transform:scale(.85);}}

.timer-badge{
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px 16px;
  background:var(--card);
  border:1px solid var(--line);
  border-radius:12px;
}
.timer-badge .icon-svg{color:var(--brand);width:16px;height:16px;}
.timer-badge .time{
  font-family:'JetBrains Mono',Consolas,monospace;
  font-size:.95rem;
  font-weight:800;
  color:var(--ink);
  letter-spacing:-.3px;
  font-variant-numeric:tabular-nums;
}
.timer-badge .lbl{
  font-size:.65rem;
  color:var(--muted);
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.4px;
}

/* ============ STATS ROW ============ */
.stats-row{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
  margin-bottom:24px;
}
.stat-card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  padding:18px;
  display:flex;
  align-items:center;
  gap:14px;
  transition:all .25s ease;
}
.stat-card:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 32px -10px rgba(0,0,0,.15);
  border-color:var(--brand);
}
.stat-card .sicon{
  width:46px;height:46px;
  border-radius:12px;
  display:grid;place-items:center;
  flex-shrink:0;
}
.stat-card .sicon .icon-svg{width:20px;height:20px;stroke-width:2.4;}
.stat-card .stext{flex:1;min-width:0;}
.stat-card .snum{
  font-size:1.4rem;
  font-weight:900;
  letter-spacing:-.6px;
  line-height:1;
  color:var(--ink);
  display:flex;
  align-items:baseline;
  gap:4px;
}
.stat-card .snum small{font-size:.75rem;font-weight:700;color:var(--muted);}
.stat-card .slabel{
  font-size:.72rem;
  color:var(--muted);
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.4px;
  margin-top:3px;
}
.stat-card.s-green .sicon{background:rgba(16,185,129,.12);color:var(--green);}
.stat-card.s-red .sicon{background:rgba(239,68,68,.12);color:var(--red);}
.stat-card.s-blue .sicon{background:rgba(59,130,246,.12);color:var(--blue);}
.stat-card.s-amber .sicon{background:rgba(245,158,11,.12);color:var(--amber);}

/* ============ MAIN LAYOUT ============ */
.monitor-main{
  display:grid;
  grid-template-columns:1fr 340px;
  gap:16px;
  min-height:600px;
  margin-bottom:24px;
}

/* ============ PANEL ============ */
.panel{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:20px;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  box-shadow:0 2px 8px rgba(0,0,0,.03);
}
.panel-header{
  padding:16px 20px;
  border-bottom:1px solid var(--line);
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}
.panel-header .panel-title{
  display:flex;
  align-items:center;
  gap:10px;
  font-size:.85rem;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.8px;
  color:var(--ink);
}
.panel-header .panel-title .icon-svg{color:var(--brand);width:16px;height:16px;}
.panel-header .count-badge{
  padding:3px 10px;
  background:var(--brand-light);
  color:var(--brand);
  border-radius:999px;
  font-size:.65rem;
  font-weight:800;
  font-variant-numeric:tabular-nums;
}
html[data-theme="dark"] .panel-header .count-badge{background:rgba(248,111,3,.15);}
.panel-legend{
  display:flex;
  gap:14px;
  font-size:.68rem;
  color:var(--muted);
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.4px;
}
.panel-legend .legend-item{
  display:flex;
  align-items:center;
  gap:6px;
}
.panel-legend .swatch{
  width:8px;height:8px;border-radius:2px;
}
.panel-legend .swatch.on{background:var(--green);}
.panel-legend .swatch.off{background:var(--red);}

/* ============ SOURCES GRID ============ */
.sources-grid{
  flex:1;
  overflow-y:auto;
  padding:16px;
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(150px, 1fr));
  gap:12px;
  align-content:start;
}
.sources-grid::-webkit-scrollbar{width:6px;}
.sources-grid::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px;}

/* ============ SOURCE CARD ============ */
.source-card{
  background:var(--bg);
  border:1.5px solid var(--line);
  border-radius:16px;
  padding:18px 12px 16px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:8px;
  position:relative;
  transition:all .25s cubic-bezier(.4,0,.2,1);
  cursor:default;
  overflow:hidden;
  min-height:130px;
}
.source-card.active{
  border-color:rgba(16,185,129,.3);
  background:linear-gradient(180deg, rgba(16,185,129,.08) 0%, var(--card) 60%);
}
.source-card.inactive{
  opacity:.7;
}
.source-card:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 32px -10px rgba(0,0,0,.15);
}
.source-card.active:hover{
  border-color:var(--green);
  box-shadow:0 12px 32px -10px rgba(16,185,129,.3);
}
.source-card.inactive:hover{
  border-color:var(--red);
  opacity:1;
}

.source-status-indicator{
  position:absolute;
  top:12px;right:12px;
  width:9px;height:9px;
  border-radius:50%;
}
.source-card.active .source-status-indicator{
  background:var(--green);
  box-shadow:0 0 0 4px rgba(16,185,129,.15);
  animation:pulseDot 1.8s ease-in-out infinite;
}
.source-card.inactive .source-status-indicator{
  background:var(--red);
  box-shadow:0 0 0 4px rgba(239,68,68,.12);
}

.source-code{
  font-family:'JetBrains Mono',Consolas,monospace;
  font-size:1.9rem;
  font-weight:800;
  letter-spacing:-.5px;
  line-height:1;
  color:var(--ink);
  transition:color .2s ease;
}
.source-card.active .source-code{color:var(--green);}
.source-card.inactive .source-code{color:var(--muted);}

.source-status-text{
  font-size:.6rem;
  font-weight:900;
  letter-spacing:1px;
  text-transform:uppercase;
  padding:4px 10px;
  border-radius:999px;
}
.source-card.active .source-status-text{
  background:rgba(16,185,129,.12);
  color:var(--green);
}
.source-card.inactive .source-status-text{
  background:rgba(239,68,68,.1);
  color:var(--red);
}

.source-hits{
  font-family:'JetBrains Mono',Consolas,monospace;
  font-size:.65rem;
  font-weight:700;
  color:var(--muted);
  padding:3px 8px;
  background:var(--card);
  border-radius:6px;
  border:1px solid var(--line);
}
.source-card.active .source-hits{
  color:var(--green);
  background:rgba(16,185,129,.08);
  border-color:rgba(16,185,129,.2);
}

/* ============ ACTIVITY LOG ============ */
.activity-list{
  flex:1;
  overflow-y:auto;
  padding:10px 12px;
  display:flex;
  flex-direction:column;
  gap:6px;
}
.activity-list::-webkit-scrollbar{width:5px;}
.activity-list::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px;}

.activity-item{
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px 12px;
  background:var(--bg);
  border:1px solid var(--line);
  border-left:3px solid transparent;
  border-radius:10px;
  font-size:.75rem;
  font-weight:700;
  animation:slideIn .3s ease;
}
@keyframes slideIn{
  from{transform:translateX(-8px);opacity:0;}
  to{transform:translateX(0);opacity:1;}
}
.activity-item.on{border-left-color:var(--green);}
.activity-item.off{border-left-color:var(--red);opacity:.7;}

.activity-time{
  font-family:'JetBrains Mono',Consolas,monospace;
  font-size:.68rem;
  font-weight:700;
  color:var(--muted);
  flex-shrink:0;
  font-variant-numeric:tabular-nums;
}
.activity-source{
  font-family:'JetBrains Mono',Consolas,monospace;
  font-size:.75rem;
  font-weight:800;
  color:var(--ink);
  letter-spacing:-.2px;
}
.activity-status{
  margin-left:auto;
  font-size:.6rem;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.6px;
  padding:3px 8px;
  border-radius:6px;
  flex-shrink:0;
}
.activity-status.on{
  background:rgba(16,185,129,.12);
  color:var(--green);
}
.activity-status.off{
  background:rgba(239,68,68,.1);
  color:var(--red);
}

.activity-empty{
  text-align:center;
  padding:40px 20px;
  color:var(--muted);
  font-size:.8rem;
  font-weight:600;
}
.activity-empty .icon-svg{
  width:36px;height:36px;
  opacity:.4;
  margin-bottom:12px;
}

/* ============ FOOTER ============ */
.foot{
  margin-top:32px;
  padding-top:24px;
  border-top:1px solid var(--line);
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-size:.75rem;
  color:var(--muted);
  font-weight:600;
  flex-wrap:wrap;
  gap:12px;
}
.foot .brandline b{color:var(--brand);}

/* ============ LOADING OVERLAY ============ */
.loading-overlay{
  position:fixed;
  inset:0;
  background:var(--bg);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  z-index:9999;
  transition:opacity .5s ease;
  gap:20px;
}
.loading-overlay.hide{
  opacity:0;
  pointer-events:none;
}
.loader-cyber{
  width:64px;
  height:64px;
  position:relative;
}
.loader-cyber::before,
.loader-cyber::after{
  content:"";
  position:absolute;
  border-radius:50%;
  animation:cyberSpin 1.2s ease-in-out infinite;
}
.loader-cyber::before{
  inset:0;
  border:3px solid transparent;
  border-top-color:var(--brand);
  border-bottom-color:var(--brand-2);
}
.loader-cyber::after{
  inset:12px;
  border:3px solid transparent;
  border-left-color:var(--green);
  border-right-color:var(--red);
  animation-delay:.3s;
  animation-direction:reverse;
}
@keyframes cyberSpin{0%{transform:rotate(0deg);}100%{transform:rotate(360deg);}}

.loader-text{
  font-family:'JetBrains Mono',Consolas,monospace;
  font-size:.85rem;
  font-weight:800;
  letter-spacing:4px;
  color:var(--ink);
  animation:pulseText 1.5s ease-in-out infinite;
}
@keyframes pulseText{0%,100%{opacity:1;}50%{opacity:.3;}}

.loader-sub{
  font-size:.75rem;
  color:var(--muted);
  font-weight:600;
  letter-spacing:1px;
}

/* ============ ERROR BANNER ============ */
.error-banner{
  position:fixed;
  bottom:24px;
  left:50%;
  transform:translateX(-50%);
  background:rgba(239,68,68,.1);
  border:1px solid rgba(239,68,68,.3);
  color:var(--red);
  padding:12px 20px;
  border-radius:14px;
  font-size:.8rem;
  font-weight:700;
  z-index:999;
  box-shadow:0 12px 32px -8px rgba(0,0,0,.15);
  display:none;
  align-items:center;
  gap:10px;
  max-width:90%;
  backdrop-filter:blur(10px);
}
.error-banner.show{
  display:flex;
  animation:slideUp .4s ease;
}
@keyframes slideUp{
  from{transform:translateX(-50%) translateY(20px);opacity:0;}
  to{transform:translateX(-50%) translateY(0);opacity:1;}
}

/* ============ RESPONSIVE ============ */
@media (max-width:1200px){
  .monitor-main{grid-template-columns:1fr 280px;}
}
@media (max-width:992px){
  .monitor-main{grid-template-columns:1fr;}
  .activity-panel{max-height:300px;}
  .stats-row{grid-template-columns:repeat(2,1fr);}
}
@media (max-width:900px){
  .new-wrapper{margin-left:0;}
  .dash-wrap{padding:20px 16px 40px;}
  .stats-row{grid-template-columns:repeat(2,1fr);}
  .page-head .ttl{font-size:1.3rem;}
  .page-head .ttl .ttl-icon{width:40px;height:40px;}
  .page-head .sub{margin-left:52px;font-size:.78rem;}
}
@media (max-width:640px){
  .dash-wrap{padding:16px 12px 32px;}
  .stats-row{grid-template-columns:1fr;}
  .sources-grid{grid-template-columns:repeat(2,1fr);gap:8px;padding:12px;}
  .source-card{min-height:110px;padding:14px 8px;}
  .source-code{font-size:1.5rem;}
  .head-actions{width:100%;}
  .live-badge, .timer-badge{flex:1;justify-content:center;}
}
</style>

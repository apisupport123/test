}
.card-header-modern .badge-count.danger {
    background: rgba(231,76,60,.15);
    color: #E74C3C;
    animation: badge-glow 2s ease-in-out infinite;
}
@keyframes badge-glow {
    0%,100% { box-shadow: 0 0 0 rgba(231,76,60,0); }
    50% { box-shadow: 0 0 12px rgba(231,76,60,.5); }
}

/* ================================================================
   TILE GRID — fills remaining card height
   ================================================================ */
.tile-grid {
    flex: 1;
    padding: 6px 8px 8px 8px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-auto-rows: 1fr;
    gap: 4px;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
}
.tile-grid::-webkit-scrollbar { width: 3px; }
.tile-grid::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 10px;
}

.tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    transition: all 0.2s cubic-bezier(0.4,0,.2,1);
    cursor: pointer;
    position: relative;
    aspect-ratio: 1;
    min-height: 42px;
    padding: 3px 2px;
    border: 1.5px solid var(--line);
    background: var(--bg);
    overflow: hidden;
}
.tile:hover {
    transform: scale(1.08);
    z-index: 10;
    box-shadow: 0 8px 24px rgba(0,0,0,.15);
}

.tile .val {
    font-size: 1.1rem;
    font-weight: 900;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
    letter-spacing: -0.4px;
}
.tile .sub-text {
    font-size: 0.58rem;
    font-weight: 800;
    opacity: 0.85;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    margin-top: 1px;
    text-align: center;
    white-space: nowrap;
}
.tile .bar {
    position: absolute;
    bottom: 2px;
    left: 12%;
    right: 12%;
    height: 2px;
    border-radius: 2px;

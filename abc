<%@ page language="java" contentType="text/html; charset=ISO-8859-1" pageEncoding="ISO-8859-1"%>
<%@ taglib prefix="s" uri="/struts-tags" %>

<!DOCTYPE html>
<html>
<head>
<meta charset="ISO-8859-1">
<title>Failure Services</title>
<script src="${pageContext.request.contextPath}/js/jquery-3.3.1.min.js"></script>
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/bootstrap.min.css">

<style>
    body {
        background: #f4f6f9;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .main-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.08);
        overflow: hidden;
    }
    .main-card .card-header {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: #fff;
        font-weight: 600;
        font-size: 1.15rem;
        letter-spacing: 0.4px;
        padding: 14px 20px;
        border: none;
    }
    .info-strip {
        background: #eef3fb;
        border-left: 4px solid #2a5298;
        padding: 10px 16px;
        border-radius: 6px;
        font-size: 0.9rem;
        margin-bottom: 14px;
    }
    .info-strip .label {
        color: #556;
        font-weight: 600;
        margin-right: 4px;
    }
    .info-strip .value {
        color: #1e3c72;
        font-weight: 700;
    }
    .record-badge {
        display: inline-block;
        background: #2a5298;
        color: #fff;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 12px;
    }
    .table-wrapper {
        overflow-x: auto;
        border-radius: 8px;
        border: 1px solid #e3e8ef;
    }
    table.fail-table {
        margin: 0;
        font-size: 0.85rem;
        white-space: nowrap;
        border-collapse: separate;
        border-spacing: 0;
    }
    table.fail-table thead th {
        background: #1e3c72;
        color: #fff;
        font-weight: 600;
        text-align: center;
        vertical-align: middle;
        padding: 10px 8px;
        position: sticky;
        top: 0;
        z-index: 2;
        border: none;
    }
    table.fail-table tbody td {
        text-align: center;
        vertical-align: middle;
        padding: 9px 8px;
        border-bottom: 1px solid #eef1f6;
        color: #333;
    }
    table.fail-table tbody tr:hover {
        background: #f0f6ff;
    }
    table.fail-table tbody tr:nth-child(even) {
        background: #fafbfd;
    }
    table.fail-table tbody tr:nth-child(even):hover {
        background: #f0f6ff;
    }
    td.clickable {
        cursor: pointer;
        color: #2a5298;
        font-weight: 600;
        transition: all 0.15s ease;
    }
    td.clickable:hover {
        background: #2a5298 !important;
        color: #fff !important;
        border-radius: 4px;
    }
    td.td-col { color: #b8860b; font-weight: 700; }
    td.bd-col { color: #c0392b; font-weight: 700; }
    .no-data {
        text-align: center;
        padding: 40px 20px;
        color: #888;
        font-size: 1rem;
    }
    .no-data i {
        font-size: 2rem;
        display: block;
        margin-bottom: 10px;
        color: #bbb;
    }
</style>
</head>

<body>

<div class="container-fluid py-4 px-4">

    <s:form action="showFailureServicesWise" method="post">
        <s:hidden name="ServiceCategory" id="ServiceCategory" value="%{ServiceCategory}" />
        <s:hidden name="url"         id="url"         value="%{url}" />
        <s:hidden name="server"      id="server"      value="%{server}" />
        <s:hidden name="broker_Name" id="broker_Name" value="%{broker_Name}" />

        <div class="card main-card">
            <div class="card-header text-center">
                Failure Services
            </div>

            <div class="card-body p-4">

                <!-- Info Strip -->
                <div class="info-strip">
                    <span class="label">API:</span>
                    <span class="value"><s:property value="url" /></span>
                    &nbsp;&nbsp;|&nbsp;&nbsp;
                    <span class="label">Server:</span>
                    <span class="value"><s:property value="server" default="N/A" /></span>
                    &nbsp;&nbsp;|&nbsp;&nbsp;
                    <span class="label">Broker:</span>
                    <span class="value"><s:property value="broker_Name" default="N/A" /></span>
                    &nbsp;&nbsp;|&nbsp;&nbsp;
                    <span class="label">Category:</span>
                    <span class="value"><s:property value="ServiceCategory" default="N/A" /></span>
                </div>

                <!-- Record Badge -->
                <div>
                    <span class="record-badge">
                        Total Records: <s:property value="m_lstFailureServicedetail.size()" />
                    </span>
                </div>

                <!-- Table / No Data -->
                <s:if test="m_lstFailureServicedetail == null || m_lstFailureServicedetail.isEmpty()">
                    <div class="no-data">
                        <i>&#9888;</i>
                        No failure service data available for the last 20 minutes.
                    </div>
                </s:if>

                <s:else>
                <div class="table-wrapper">
                    <table class="table fail-table">
                        <thead>
                            <tr>
                                <th>API NAME</th>
                                <th>Broker Name</th>
                                <th>Broker EG</th>
                                <th>Total Hits</th>
                                <th>Success</th>
                                <th>SI001</th>
                                <th>002</th>
                                <th>SI002</th>
                                <th>SI007</th>
                                <th>SI051</th>
                                <th>014</th>
                                <th>SI014</th>
                                <th>Parsing Exception</th>
                                <th>SI569</th>
                                <th>SI570</th>
                                <th>TD</th>
                                <th>TD %</th>
                                <th>BD</th>
                                <th>BD %</th>
                            </tr>
                        </thead>
                        <tbody>
                        <s:iterator value="m_lstFailureServicedetail" var="list">
                            <tr>
                                <td><s:property value="#list.m_strAPIName" /></td>
                                <td><s:property value="#list.m_strbroker_name" /></td>
                                <td><s:property value="#list.m_strbroker_eg" /></td>
                                <td><s:property value="#list.m_strTOTAL_HITS" /></td>
                                <td><s:property value="#list.m_strSUCCESS" /></td>

                                <td class="clickable" onclick="showreferenceno('SI001','<s:property value="#list.m_strAPIName" />')">
                                    <s:property value="#list.m_str001" />
                                </td>
                                <td class="clickable" onclick="showreferenceno('002','<s:property value="#list.m_strAPIName" />')">
                                    <s:property value="#list.m_str002" />
                                </td>
                                <td class="clickable" onclick="showreferenceno('SI002','<s:property value="#list.m_strAPIName" />')">
                                    <s:property value="#list.m_strSI002" />
                                </td>
                                <td class="clickable" onclick="showreferenceno('SI007','<s:property value="#list.m_strAPIName" />')">
                                    <s:property value="#list.m_str007" />
                                </td>
                                <td class="clickable" onclick="showreferenceno('SI051','<s:property value="#list.m_strAPIName" />')">
                                    <s:property value="#list.m_str051" />
                                </td>
                                <td class="clickable" onclick="showreferenceno('014','<s:property value="#list.m_strAPIName" />')">
                                    <s:property value="#list.m_str014" />
                                </td>
                                <td class="clickable" onclick="showreferenceno('SI014','<s:property value="#list.m_strAPIName" />')">
                                    <s:property value="#list.m_strSI014" />
                                </td>
                                <td class="clickable" onclick="showreferenceno('PARSING_EXCEPTION','<s:property value="#list.m_strAPIName" />')">
                                    <s:property value="#list.m_strPARSINGEXCEPTION" />
                                </td>
                                <td class="clickable" onclick="showreferenceno('SI569','<s:property value="#list.m_strAPIName" />')">
                                    <s:property value="#list.m_str569" />
                                </td>
                                <td class="clickable" onclick="showreferenceno('SI570','<s:property value="#list.m_strAPIName" />')">
                                    <s:property value="#list.m_str570" />
                                </td>

                                <td class="td-col"><s:property value="#list.m_strTD" /></td>
                                <td class="td-col"><s:property value="#list.m_strTD_PERCENT" /></td>
                                <td class="bd-col"><s:property value="#list.m_strBD" /></td>
                                <td class="bd-col"><s:property value="#list.m_strBD_PERCENT" /></td>
                            </tr>
                        </s:iterator>
                        </tbody>
                    </table>
                </div>
                </s:else>

            </div>
        </div>
    </s:form>

</div>

<script>
function showreferenceno(errorcode, apiname) {
    var serviceCategory = document.getElementById("ServiceCategory").value;
    var url = '${pageContext.request.contextPath}/Multiple?action=showfailurerefernceno'
        + '&errorcode=' + encodeURIComponent(errorcode)
        + '&apiname=' + encodeURIComponent(apiname)
        + '&ServiceCategory=' + encodeURIComponent(serviceCategory);
    window.open(url, '_blank');
}
</script>

</body>
</html>

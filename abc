// ── Helper: Ensure the master table exists (create if not) ──
void ensureTableExists(Connection conn) throws SQLException {
    Statement stmt = null;
    try {
        stmt = conn.createStatement();
        stmt.executeUpdate(
            "CREATE TABLE DPG_IP_MASTER (" +
            "    DPG_IP        VARCHAR2(50) PRIMARY KEY," +
            "    DPG_MODE      VARCHAR2(10)," +
            "    LAST_UPDATED  DATE" +
            ")"
        );
    } catch (SQLException e) {
        if (e.getErrorCode() != 955) throw e; // 955 = name already used
    } finally {
        if (stmt != null) try { stmt.close(); } catch (SQLException e) {}
    }
    // Create index, ignore if exists
    try {
        stmt = conn.createStatement();
        stmt.executeUpdate("CREATE INDEX IDX_DPG_MASTER_MODE ON DPG_IP_MASTER(DPG_MODE)");
    } catch (SQLException e) {
        if (e.getErrorCode() != 955) throw e;
    } finally {
        if (stmt != null) try { stmt.close(); } catch (SQLException e) {}
    }
}

// ── Helper: Refresh master table (delete all + insert fresh) ──
void refreshMasterTable(Connection connReport, Connection connIIB) throws SQLException {
    // 1. Fetch all distinct IPs from IIB
    List<String> ipList = new ArrayList<>();
    Statement stmtIIB = null;
    ResultSet rsIIB = null;
    try {
        stmtIIB = connIIB.createStatement();
        String queryIIB =
        		"SELECT /*+ PARALLEL(4) */ DISTINCT TRIM(DPG_IP) AS IP " +
        	            "FROM EISAPP.API_LOG " +
        	            "WHERE TRIM(DPG_IP) LIKE '10.191.171.2%' OR TRIM(DPG_IP) LIKE '10.176.0.1%' " +
        	            "AND request_date_time >= TRUNC(SYSDATE) - 1 " +
        	            "AND request_date_time < TRUNC(SYSDATE)";
        rsIIB = stmtIIB.executeQuery(queryIIB);
        while (rsIIB.next()) {
            ipList.add(rsIIB.getString("IP"));
        }
    } finally {
        if (rsIIB != null) try { rsIIB.close(); } catch (SQLException e) {}
        if (stmtIIB != null) try { stmtIIB.close(); } catch (SQLException e) {}
    }

    // 2. Delete all rows from master table (report DB)
    Statement stmtDel = connReport.createStatement();
    stmtDel.executeUpdate("DELETE FROM DPG_IP_MASTER");
    stmtDel.close();

    // 3. Insert fresh rows
    if (!ipList.isEmpty()) {
        PreparedStatement pstmtIns = connReport.prepareStatement("INSERT INTO DPG_IP_MASTER (DPG_IP, DPG_MODE, LAST_UPDATED) VALUES (?, ?, SYSDATE)");
        for (String ip : ipList) {
            String mode = ip.contains("171.") ? "PR" : "DR";
            pstmtIns.setString(1, ip);
            pstmtIns.setString(2, mode);
            pstmtIns.addBatch();
        }
        pstmtIns.executeBatch();
        pstmtIns.close();
    }
}

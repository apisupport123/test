<script>
/* ✅ Original JS functions — same rakhe hain */
function validateForm() {
    var layer = document.getElementById("options").value;
    var apiName = document.getElementById("w3review").value;
    if (!layer) { alert("Please select a Layer."); return false; }
    if (!apiName) { alert("Please enter an API Name."); return false; }
    if (document.forms[0].m_stFromTime.value == "") { alert("Please Enter From"); return null; }
    if (document.forms[0].m_stToTime.value == "") { alert("Please Enter To"); return null; }
    return true;
}
function toggleCheckboxes(button) {
    var checkboxRow = button.closest('tr').nextElementSibling;
    if (checkboxRow.style.display === 'none' || checkboxRow.style.display === '') {
        checkboxRow.style.display = 'table-row';
    } else {
        checkboxRow.style.display = 'none';
    }
}
function toggleTextbox(textareaId, checkbox) {
    var textarea = document.getElementById(textareaId);
    if (checkbox.checked) {
        textarea.style.display = 'block';
    } else {
        textarea.style.display = 'none';
    }
}
function viewDetails() {
    document.forms[0].action = '<%=request.getContextPath() + "/jsp/deploymentview.jsp"%>';
    document.forms[0].submit();
}
function viewDetails1() {
    document.forms[0].action = '<%=request.getContextPath() + "/jsp/nohitsview.jsp"%>';
    document.forms[0].submit();
}
function showrefrencegen(refno) {
    var a = '<%=request.getContextPath() + "/errorcoderefrencesearch?&refno="%>' + refno;
    window.open(a, '_blank');
}
function CheckBox(counter) {
    var xhr = new XMLHttpRequest();
    var reviewChecked = document.getElementById('chk1_' + counter).checked;
    var remarksChecked = document.getElementById('chk2_' + counter).checked;
    var completedChecked = document.getElementById('chk3_' + counter).checked;
    var noHitsChecked = document.getElementById('chk4_' + counter).checked;
    var reviewText = document.getElementById('reviewText_' + counter);
    var remarksText = document.getElementById('remarksText_' + counter);
    var data = {
        counter: counter,
        reviewChecked: reviewChecked,
        remarksChecked: remarksChecked,
        completedChecked: completedChecked,
        noHitsChecked: noHitsChecked,
        reviewText: reviewText ? reviewText.value.trim() : '',
        remarksText: remarksText ? remarksText.value.trim() : ''
    };
    xhr.open("POST", "<%=request.getContextPath() + "/jsp/updateFields.jsp"%>", true);
    xhr.setRequestHeader("Content-Type", "application/json");
    xhr.onreadystatechange = function () {
        if (xhr.readyState === 4 && xhr.status === 200) {
            console.log("Response: ", xhr.responseText);
        } else if (xhr.readyState === 4) {
            console.error("Error: ", xhr.status, xhr.statusText);
        }
    };
    xhr.send(JSON.stringify(data));
}
function toggleSourceIDTextbox(checkbox) {
    var sourceField = document.getElementById("sourceIDField");
    sourceField.style.display = checkbox.checked ? "block" : "none";
}
function toggleServerIpField() {
    var serverSelect = document.getElementById("server");
    var serverIpField = document.getElementById("serverIpField");
    if (serverSelect.value === "single") {
        serverIpField.style.display = "block";
    } else {
        serverIpField.style.display = "none";
    }
}
function disableButton() {
    document.getElementById('submitBtn').disabled = true;
    document.getElementById('submitBtn').innerText = 'Submitting...';
    return true;
}
</script>

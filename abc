String maskIp(String fullIp) {
    if (fullIp == null || fullIp.isEmpty()) return "N/A";
    String[] parts = fullIp.split("\\.");
    if (parts.length >= 4) return parts[2] + "." + parts[3];
    return fullIp;
}
String getModeFromIp(String ip) {

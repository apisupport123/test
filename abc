        // Check if roster exists
        String getDataQuery = "select * from rostertable where UPPER(TEAM)=UPPER(?) and UPPER(MONTHYEAR)=UPPER(?) order by id";
        PreparedStatement ps = conn.prepareStatement(getDataQuery);
        ps.setString(1, m_strroles);
        ps.setString(2, sort_MonthYear);
        ResultSet rs = ps.executeQuery();
        while (rs.next()) {
            Map<String,Object> emp = new HashMap<>();
            emp.put("name", rs.getString("NAME"));
            emp.put("adId", rs.getString("AD_ID"));
            emp.put("position", rs.getString("POSITION"));
            for (int d = 1; d <= noOfDays; d++) {
                emp.put("day_" + d, rs.getString("DAY_" + d));
            }
            employees.add(emp);
        }
        rs.close();
        ps.close();

        // If no roster, load from employee master
        if (employees.isEmpty()) {
            String queryEmp = "select ad_id, FIRSTNAME || ' ' || LASTNAME as Fullname from eisupport_employee_master where TEAM = ? and isactive='Active'";
            PreparedStatement ps2 = conn.prepareStatement(queryEmp);
            ps2.setString(1, m_strroles);
            ResultSet rs2 = ps2.executeQuery();
            while (rs2.next()) {
                Map<String,Object> emp = new HashMap<>();
                emp.put("name", rs2.getString("Fullname"));
                emp.put("adId", rs2.getString("ad_id"));
                emp.put("position", null);
                for (int d = 1; d <= noOfDays; d++) emp.put("day_" + d, "Morning");
                employees.add(emp);
            }
            rs2.close();
            ps2.close();
        }
    } catch (Exception e) {
        e.printStackTrace();
    } finally {
        if (conn != null) try { conn.close(); } catch (Exception e) {}

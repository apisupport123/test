<%
/* ============ BACKEND ============ */
response.setIntHeader("Refresh", 600);

Connection conn = null;
Statement statement = null;
ResultSet resultSet = null;

List<String> labels   = new ArrayList<String>();
List<String> rawNames = new ArrayList<String>();
List<Double> failure  = new ArrayList<Double>();
List<Integer> tdCounts = new ArrayList<Integer>();
List<Integer> totalHits = new ArrayList<Integer>();

try {
    conn = DBUtilityAuto.getIIBDBConnection();

    ZonedDateTime CurrentDate = ZonedDateTime.now(ZoneId.of("Asia/Kolkata"));
    DateTimeFormatter formatter = DateTimeFormatter.ofPattern("MMM_yy").withLocale(Locale.US);
    String PART = CurrentDate.format(formatter).toUpperCase();

    String sql = "Select * from(select txn_endpoint, "
        + "COUNT(1) AS TOTAL_HITS, "
        + "SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END) AS TD_COUNT, "
        + "ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT "
        + "from eisapp.backend_log PARTITION(" + PART + ") where txn_endpoint != 'NATIONAL_PORTAL' and "
        + "REQUEST_DATE_TIME>=SYSDATE - INTERVAL '10' MINUTE "
        + "GROUP BY txn_endpoint "
        + "having ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END)*100)/COUNT(1),2)>= 0.5 "
        + "order by TD_PERCENT desc)where ROWNUM <=12";

    statement = conn.createStatement();
    resultSet = statement.executeQuery(sql);

    while (resultSet.next()) {
        String rawName  = resultSet.getString("txn_endpoint");
        int    tdCount  = resultSet.getInt("TD_COUNT");
        int    totalHit = resultSet.getInt("TOTAL_HITS");
        double pct      = resultSet.getDouble("TD_PERCENT");

        String name = "<p style='color:#fbbf24; font-weight: bolder; font-size:20px; margin:2px 0;'>" + tdCount + "</p>"
            + "<p style='color:#ffffff; font-weight: bolder; font-size:18px; margin:2px 0;'>"
            + rawName.replaceAll("_", "</p><p style='color:#ffffff; font-weight: bolder; font-size:18px; margin:2px 0;'>")
            + "</p>"
            + "<p style='color:#34d399; font-weight: bolder; font-size:18px; margin:2px 0;'>" + totalHit + "</p>";

        labels.add(name);
        rawNames.add(rawName);
        failure.add(pct);
        tdCounts.add(tdCount);
        totalHits.add(totalHit);
    }
} catch (Exception e) {
    e.printStackTrace();
} finally {
    try { if (resultSet != null) resultSet.close(); } catch (Exception ignored) {}
    try { if (statement != null) statement.close(); } catch (Exception ignored) {}
    try { if (conn != null) conn.close(); } catch (Exception ignored) {}
}

while (labels.size() < 5) {
    labels.add("&nbsp;");
    rawNames.add("");
    failure.add(0.0);
    tdCounts.add(0);
    totalHits.add(0);
}
%>

<script>
// ============================================================
// Server data → JS arrays
// ============================================================
var labelArr = [
<%
for (int k = 0; k < labels.size(); k++) {
    String lbl = labels.get(k).replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "").replace("\r", "");
    out.print("\"" + lbl + "\"");
    if (k < labels.size() - 1) out.print(",");
}
%>
];

var nameArr = [
<%
for (int k = 0; k < rawNames.size(); k++) {
    String n = rawNames.get(k).replace("\\", "\\\\").replace("\"", "\\\"");
    out.print("\"" + n + "\"");
    if (k < rawNames.size() - 1) out.print(",");
}
%>
];

var valueArr = [
<%
for (int k = 0; k < failure.size(); k++) {
    out.print(failure.get(k));
    if (k < failure.size() - 1) out.print(",");
}
%>
];

var tdArr = [
<%
for (int k = 0; k < tdCounts.size(); k++) {
    out.print(tdCounts.get(k));
    if (k < tdCounts.size() - 1) out.print(",");
}
%>
];

var totalArr = [
<%
for (int k = 0; k < totalHits.size(); k++) {
    out.print(totalHits.get(k));
    if (k < totalHits.size() - 1) out.print(",");
}
%>
];

// ============================================================
// KPI compute
// ============================================================
(function computeStats() {
  var total = 0, critical = 0, warning = 0, maxVal = 0;
  for (var i = 0; i < nameArr.length; i++) {
    if (!nameArr[i]) continue;
    total++;
    if (valueArr[i] >= 5) critical++;
    else if (valueArr[i] >= 1) warning++;
    if (valueArr[i] > maxVal) maxVal = valueArr[i];
  }
  document.getElementById('statTotal').textContent    = total;
  document.getElementById('statCritical').textContent = critical;
  document.getElementById('statWarning').textContent  = warning;
  var maxEl = document.getElementById('statMax');
  maxEl.textContent = maxVal.toFixed(2) + '%';
  maxEl.className = 'kpi-value ' + (maxVal >= 5 ? 'red' : (maxVal >= 2 ? 'orange' : 'green'));
})();

// ============================================================
// Top Critical chips
// ============================================================
(function buildCritBar() {
  var items = [];
  for (var k = 0; k < nameArr.length; k++) {
    if (nameArr[k] && valueArr[k] > 0) {
      items.push({ name: nameArr[k], pct: valueArr[k] });
    }
  }
  items.sort(function(a, b) { return b.pct - a.pct; });
  var top = items.slice(0, 5);
  var bar = document.getElementById('critBar');

  if (!top.length) {
    var empty = document.createElement('span');
    empty.style.cssText = 'color:#64748b;font-family:Courier New,monospace;font-size:14px;font-weight:700;';
    empty.textContent = 'all clear ✓';
    bar.appendChild(empty);
    return;
  }

  top.forEach(function(it) {
    var chip = document.createElement('div');
    chip.className = 'crit-chip';
    chip.innerHTML = '<span class="name" title="' + it.name + '">' + it.name + '</span>'
                   + '<span class="pct">' + it.pct + '%</span>';
    bar.appendChild(chip);
  });
})();

// ============================================================
// Bright 3D gradient colors
// ============================================================
function makeBarColor(baseRgb, topBoost) {
  var p = baseRgb.split(',');
  var r = parseInt(p[0]), g = parseInt(p[1]), b = parseInt(p[2]);
  var tr = Math.min(255, r + topBoost);
  var tg = Math.min(255, g + topBoost);
  var tb = Math.min(255, b + topBoost);
  return "rgb(" + tr + "," + tg + "," + tb + ") rgb(" + r + "," + g + "," + b + ")";
}

var barColors = valueArr.map(function(v) {
  if (v >= 5) return makeBarColor("239,68,68", 70);
  if (v >= 2) return makeBarColor("245,158,11", 70);
  if (v >= 1) return makeBarColor("167,139,250", 60);
  return makeBarColor("52,211,153", 70);
});

// ============================================================
// CHART — 3D + bright, non-black background
// ============================================================
var chartConfig = {
  type: "bar3d",
  "3dAspect": {
    depth: 45,
    true3d: 0,
    yAngle: 15,
    xAngle: 6
  },
  backgroundColor: "transparent",
  globals: {
    fontFamily: "Inter, sans-serif"
  },
  plotarea: {
    backgroundColor: "transparent",
    margin: "55px 40px 190px 170px"
  },
  scaleX: {
    values: labelArr,
    backgroundColor: "transparent",
    borderColor: "#2d3a56",
    borderWidth: "1px",
    guide: { visible: false },
    item: { fontColor: "#e8ecf8", fontSize: 22 },
    tick: { alpha: 0.3, lineColor: "#3d4a66" },
    label: {
      text: '<p style="color:#fbbf24;font-size:20px;font-weight:800;margin:4px 0;">TD</p>'
          + '<p style="color:#ffffff;font-size:20px;font-weight:800;margin:4px 0;">ENDPOINT</p>'
          + '<p style="color:#34d399;font-size:20px;font-weight:800;margin:4px 0;">HITS</p>',
      offsetX: '-90px'
    }
  },
  scaleY: {
    backgroundColor: "transparent",
    borderColor: "#2d3a56",
    borderWidth: "1px",
    guide: { alpha: 0.3, lineColor: "#3d4a66", lineStyle: "solid" },
    item: { fontColor: "#94a3c4", paddingRight: "10px", fontSize: 18 },
    tick: { alpha: 0.3, lineColor: "#3d4a66" },
    label: {
      text: "Failure Percentage",
      color: "#94a3c4",
      fontSize: "20"
    }
  },
  series: [{
    values: valueArr,
    "value-box": {
      text: "%v%",
      placement: "top",
      "font-color": "#ffffff",
      "font-size": "22px",
      "font-weight": "bold",
      "offset-y": -6
    },
    tooltip: {
      backgroundColor: "#232d4a",
      borderColor: "#818cf8",
      borderWidth: 1,
      borderRadius: "6px",
      fontSize: "16px",
      padding: "10px 14px",
      shadow: false,
      fontColor: "#ffffff"
    },
    styles: barColors,
    borderColor: "rgba(255,255,255,0.2)",
    borderWidth: 1
  }]
};

function updateChart(p) {
  var idx = p.nodeindex;
  if (!nameArr[idx]) return;
  var url = '<%=request.getContextPath() + "/jsp/TransactionEndpointWiseService.jsp?txnEndPoint="%>' + encodeURIComponent(nameArr[idx]);
  window.open(url, '_blank');
}

zingchart.render({
  id: 'myChart',
  data: chartConfig,
  height: '100%',
  width: '100%'
});

zingchart.bind('myChart', 'node_click', updateChart);
</script>

<!-- ============ COUNTDOWN ============ -->
<script>
function countdown(elementName, minutes, seconds) {
  var element, endTime;
  function twoDigits(n) { return (n <= 9 ? "0" + n : n); }
  function updateTimer() {
    var msLeft = endTime - (+new Date);
    if (msLeft < 1000) {
      element.innerHTML = "Refreshing…";
    } else {
      var time = new Date(msLeft);
      var hours = time.getUTCHours();
      var mins = time.getUTCMinutes();
      element.innerHTML = (hours ? hours + ':' + twoDigits(mins) : mins) + ':' + twoDigits(time.getUTCSeconds());
      setTimeout(updateTimer, time.getUTCMilliseconds() + 500);
    }
  }
  element = document.getElementById(elementName);
  endTime = (+new Date) + 1000 * (60 * minutes + seconds) + 500;
  updateTimer();
}
countdown("ten-countdown", 10, 0);
</script>


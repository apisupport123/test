<!-- ============ CLIENT SCRIPTS ============ -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    var now = new Date();
    var past = new Date();
    past.setMinutes(now.getMinutes() - 10);
    function fmt(d) {
        var h = d.getHours(), m = d.getMinutes();
        return (h < 10 ? '0' + h : h) + ':' + (m < 10 ? '0' + m : m);
    }
    var tr = document.getElementById('txTimeRange');
    if (tr) tr.textContent = fmt(past) + ' → ' + fmt(now);
});

function openPopup1() {
    var width = 800, height = 600;
    var left = (window.innerWidth - width) / 2;
    var top = (window.innerHeight - height) / 2;
    var popupWindow = window.open(
        'TransactionEndPointDataBank.jsp',
        'DataPopup',
        'width=' + width + ', height=' + height + ', left=' + left + ', top=' + top
    );
    if (popupWindow) popupWindow.focus();
}
document.addEventListener('DOMContentLoaded', function(){
    var b = document.getElementById('openPopup1');
    if (b) b.addEventListener('click', openPopup1);
});
</script>

<%
/* ============ BACKEND (tumhara wala) ============ */
response.setIntHeader("Refresh", 600);

Connection conn = null;
Statement statement = null;
ResultSet resultSet = null;

List<String> labels    = new ArrayList<String>();
List<String> rawNames  = new ArrayList<String>();
List<Double> failure   = new ArrayList<Double>();
List<Integer> tdCounts = new ArrayList<Integer>();
List<Integer> totalHits = new ArrayList<Integer>();

try {
    conn = DBUtilityAuto.getReportDBConnection();

    String sql = "SELECT txn_endpoint, total_hits, td_count, td_percent from ( "
               + "SELECT txn_endpoint, total_hits, td_count, td_percent from txnendpoint "
               + "WHERE time >= SYSTIMESTAMP - INTERVAL '10' MINUTE "
               + "order by td_percent desc) where rownum <= 12";

    statement = conn.createStatement();
    resultSet = statement.executeQuery(sql);

    while (resultSet.next()) {
        String rawName  = resultSet.getString("txn_endpoint");
        int    tdCount  = resultSet.getInt("td_count");
        int    totalHit = resultSet.getInt("total_hits");
        double pct      = resultSet.getDouble("td_percent");

        String name = "<p style='color:#ff9933; font-weight: bolder; font-size:20px; text-shadow:0 0 6px rgba(255,153,51,.6);'>" + tdCount + "</p>"
            + "<br><p style='color:#FFFFFF; font-weight: bolder; font-size:18px; text-shadow:0 0 6px rgba(255,255,255,.3);'>"
            + rawName.replaceAll("_", "</p><br><p style='color:#FFFFFF; font-weight: bolder; font-size:18px; text-shadow:0 0 6px rgba(255,255,255,.3);'>")
            + "</p><br>"
            + "<p style='color:#32CD32; font-weight: bolder; font-size:18px; text-shadow:0 0 6px rgba(50,205,50,.6);'>" + totalHit + "</p>";

        labels.add(name);
        rawNames.add(rawName);
        failure.add(pct);
        tdCounts.add(tdCount);
        totalHits.add(totalHit);
    }
} catch (Exception e) {
    e.printStackTrace();
} finally {
    try { if (resultSet != null) resultSet.close(); } catch (Exception ignored) {}
    try { if (statement != null) statement.close(); } catch (Exception ignored) {}
    try { if (conn != null) conn.close(); } catch (Exception ignored) {}
}

while (labels.size() < 5) {
    labels.add("&nbsp;");
    rawNames.add("");
    failure.add(0.0);
    tdCounts.add(0);
    totalHits.add(0);
}
%>

<script>
/* ============================================================
   Server data → JS arrays
   ============================================================ */
var labelArr = [
<%
for (int k = 0; k < labels.size(); k++) {
    String lbl = labels.get(k).replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "").replace("\r", "");
    out.print("\"" + lbl + "\"");
    if (k < labels.size() - 1) out.print(",");
}
%>
];
var nameArr = [
<%
for (int k = 0; k < rawNames.size(); k++) {
    String n = rawNames.get(k).replace("\\", "\\\\").replace("\"", "\\\"");
    out.print("\"" + n + "\"");
    if (k < rawNames.size() - 1) out.print(",");
}
%>
];
var valueArr = [
<%
for (int k = 0; k < failure.size(); k++) {
    out.print(failure.get(k));
    if (k < failure.size() - 1) out.print(",");
}
%>
];
var tdArr = [
<%
for (int k = 0; k < tdCounts.size(); k++) {
    out.print(tdCounts.get(k));
    if (k < tdCounts.size() - 1) out.print(",");
}
%>
];
var totalArr = [
<%
for (int k = 0; k < totalHits.size(); k++) {
    out.print(totalHits.get(k));
    if (k < totalHits.size() - 1) out.print(",");
}
%>
];

/* ============================================================
   Theme detection
   ============================================================ */
var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
var chartBg        = isDark ? '#000000' : '#FFFFFF';
var chartText      = isDark ? '#FFFFFF' : '#0A0A0A';
var chartMuted     = isDark ? '#9CA3AF' : '#6B7280';
var chartGridLine  = isDark ? '#333333' : '#E5E7EB';
var chartTickColor = isDark ? '#333333' : '#D1D5DB';
var chartBorder    = isDark ? '#333333' : '#CCCCCC';

/* ============================================================
   KPI compute + blink
   ============================================================ */
(function computeStats() {
    var total = 0, critical = 0, warning = 0, maxVal = 0;
    for (var i = 0; i < nameArr.length; i++) {
        if (!nameArr[i]) continue;
        total++;
        if (valueArr[i] >= 5) critical++;
        else if (valueArr[i] >= 1) warning++;
        if (valueArr[i] > maxVal) maxVal = valueArr[i];
    }
    document.getElementById('txStatTotal').textContent = total;

    var critEl = document.getElementById('txStatCritical');
    critEl.textContent = critical;
    if (critical > 0) critEl.classList.add('tx-blink-red');

    document.getElementById('txStatWarning').textContent = warning;

    var maxEl = document.getElementById('txStatMax');
    maxEl.textContent = maxVal.toFixed(2) + '%';
    maxEl.className = 'tx-kpi-value ' + (maxVal >= 5 ? 'red' : (maxVal >= 2 ? 'orange' : 'green'));
    if (maxVal >= 5) maxEl.classList.add('tx-blink-red');
})();

/* ============================================================
   Top critical chips
   ============================================================ */
(function buildCritBar() {
    var items = [];
    for (var k = 0; k < nameArr.length; k++) {
        if (nameArr[k] && valueArr[k] > 0) {
            items.push({ name: nameArr[k], pct: valueArr[k] });
        }
    }
    items.sort(function(a, b) { return b.pct - a.pct; });
    var top = items.slice(0, 5);
    var bar = document.getElementById('txCritBar');

    if (!top.length) {
        var empty = document.createElement('span');
        empty.style.cssText = 'color:var(--muted);font-family:Courier New,monospace;font-size:13px;font-weight:700;';
        empty.textContent = 'all clear ✓';
        bar.appendChild(empty);
        return;
    }

    top.forEach(function(it) {
        var chip = document.createElement('div');
        chip.className = 'tx-crit-chip' + (it.pct >= 5 ? ' critical' : '');
        chip.innerHTML = '<span class="name" title="' + it.name + '">' + it.name + '</span>'
                       + '<span class="pct">' + it.pct + '%</span>';
        bar.appendChild(chip);
    });
})();

/* ============================================================
   Severity colors per bar
   ============================================================ */
var barColors = valueArr.map(function(v) {
    if (v >= 5) return "#ef4444";
    if (v >= 2) return "#f59e0b";
    if (v >= 1) return "#8b5cf6";
    return "#10b981";
});

/* ============================================================
   Chart config — 3D depth + severity colors + theme aware
   ============================================================ */
var chartConfig = {
    type: "bar3d",
    "3dAspect": { depth: 45, true3d: 0, yAngle: 15 },
    backgroundColor: chartBg,
    globals: { fontFamily: "Inter, sans-serif" },
    title: {
        text: "Failure %   End Point Wise",
        fontWeight: "bold",
        height: "25px",
        color: chartText,
        fontSize: "34px",
        fontFamily: "Inter, sans-serif"
    },
    plotarea: {
        alpha: 0.3,
        backgroundColor: chartBg,
        margin: "50px 35px 190px 170px"
    },
    scaleX: {
        values: labelArr,
        alpha: 0.5,
        backgroundColor: chartBg,
        borderColor: chartBorder,
        borderWidth: "1px",
        guide: { visible: false },
        item: { fontColor: chartText, fontSize: "22px" },
        tick: { alpha: 0.2, lineColor: chartTickColor },
        label: {
            text: '<p style="color:#ff9933;font-size:18px;font-weight:800;margin:3px 0;text-shadow:0 0 6px rgba(255,153,51,.6);">TD FAILURE</p>'
                + '<p style="color:' + chartText + ';font-size:18px;font-weight:800;margin:3px 0;">END POINT</p>'
                + '<p style="color:#32CD32;font-size:18px;font-weight:800;margin:3px 0;text-shadow:0 0 6px rgba(50,205,50,.6);">TOTAL HITS</p>',
            color: chartText,
            offsetX: '-90px'
        }
    },
    scaleY: {
        alpha: 0.5,
        backgroundColor: chartBg,
        borderColor: chartBorder,
        borderWidth: "1px",
        guide: { alpha: 0.25, lineColor: chartGridLine, lineStyle: "solid" },
        item: { fontColor: chartText, paddingRight: "10px", fontSize: "18px" },
        tick: { alpha: 0.2, lineColor: chartTickColor },
        label: {
            text: "Failure Percentage",
            color: chartMuted,
            fontSize: "18"
        }
    },
    series: [{
        text: "Failure %",
        values: valueArr,
        "value-box": {
            text: "%v %",
            placement: "top",
            "font-color": chartText,
            "font-size": "22px",
            "font-weight": "bold",
            "offset-y": -6,
            rules: [
                { rule: "%v >= 5", "font-color": "#ff5252" },
                { rule: "%v >= 2", "font-color": "#fbc04b" },
                { rule: "%v >= 1", "font-color": "#b794ff" }
            ]
        },
        tooltip: {
            backgroundColor: "#1c2030",
            borderColor: "#6366f1",
            borderWidth: 1,
            borderRadius: "6px",
            fontSize: "16px",
            padding: "10px 14px",
            shadow: false,
            fontColor: "#fff"
        },
        styles: barColors,
        backgroundColor: "#673AB7",
        borderColor: chartBorder,
        borderWidth: 1,
        "effects": [
            { "effect": "SHADOW", "offsetX": 4, "offsetY": 4, "blur": 12, "color": "rgba(0,0,0,0.5)" }
        ]
    }]
};

function updateChart(p) {
    var idx = p.nodeindex;
    if (!nameArr[idx]) return;
    var url = '<%=request.getContextPath() + "/jsp/TransactionEndpointWiseService.jsp?txnEndPoint="%>' + encodeURIComponent(nameArr[idx]);
    window.open(url, '_blank');
}

zingchart.render({
    id: 'myChart',
    data: chartConfig,
    height: '100%',
    width: '100%'
});

zingchart.bind('myChart', 'node_click', updateChart);

/* ============================================================
   Theme change → reload (tumhara original behaviour)
   ============================================================ */
var _lastTheme = isDark ? 'dark' : 'light';
setInterval(function() {
    var now = document.documentElement.getAttribute('data-theme') || 'light';
    if (now !== _lastTheme) {
        _lastTheme = now;
        location.reload();
    }
}, 500);
</script>

<!-- ============ COUNTDOWN (tumhara wala) ============ -->
<script>
function countdown(elementName, minutes, seconds) {
    var element, endTime;

    function twoDigits(n) {
        return (n <= 9 ? "0" + n : n);
    }

    function updateTimer() {
        var msLeft = endTime - (+new Date);
        if (msLeft < 1000) {
            element.innerHTML = "Refreshing…";
        } else {
            var time = new Date(msLeft);
            var hours = time.getUTCHours();
            var mins = time.getUTCMinutes();
            element.innerHTML = (hours ? hours + ':' + twoDigits(mins) : mins) + ':' + twoDigits(time.getUTCSeconds());
            setTimeout(updateTimer, time.getUTCMilliseconds() + 500);
        }
    }

    element = document.getElementById(elementName);
    endTime = (+new Date) + 1000 * (60 * minutes + seconds) + 500;
    updateTimer();
}

countdown("ten-countdown", 10, 0);
</script>


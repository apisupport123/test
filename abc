<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="s" uri="/struts-tags" %>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EIS Registration</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
/* ================================================================
   RESET & VARIABLES
   ================================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --primary:        #ff6a00;
    --primary-dark:   #e05300;
    --primary-light:  #ffa04d;
    --accent:         #7c3aed;
    --cyan:           #06b6d4;
    --secondary:      #0f172a;
    --text:           #111827;
    --text-muted:     #6b7280;
    --border:         #e5e7eb;
    --bg:             #f8fafc;
    --white:          #ffffff;
    --success:        #10b981;
    --danger:         #ef4444;
    --warn:           #f59e0b;
    --shadow-sm:      0 1px 2px rgba(0,0,0,.05);
    --shadow-md:      0 8px 24px rgba(15,23,42,.08);
    --shadow-lg:      0 24px 60px rgba(15,23,42,.15);
    --shadow-glow:    0 20px 45px rgba(255,106,0,.35);
    --radius:         14px;
    --radius-lg:      24px;
}

html, body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

/* ================================================================
   ANIMATED AURORA BACKGROUND
   ================================================================ */
.aurora-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: linear-gradient(135deg, #fff7ed 0%, #fef3c7 50%, #fce7f3 100%);
}
.aurora-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: .55;
    animation: floatBlob 18s ease-in-out infinite;
}
.aurora-blob.b1 {
    width: 520px; height: 520px;
    background: radial-gradient(circle, #ff6a00, transparent 70%);
    top: -180px; left: -120px;
}
.aurora-blob.b2 {
    width: 480px; height: 480px;
    background: radial-gradient(circle, #7c3aed, transparent 70%);
    bottom: -160px; right: -140px;
    animation-delay: -6s;
}
.aurora-blob.b3 {
    width: 420px; height: 420px;
    background: radial-gradient(circle, #06b6d4, transparent 70%);
    top: 40%; left: 45%;
    animation-delay: -12s;
}
@keyframes floatBlob {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(60px, -50px) scale(1.15); }
    66%      { transform: translate(-40px, 40px) scale(.95); }
}

/* ================================================================
   LAYOUT
   ================================================================ */
.page-wrap {
    max-width: 1500px;
    margin: 32px auto;
    padding: 0 24px;
}

.reg-card {
    display: grid;
    grid-template-columns: 420px 1fr;
    background: rgba(255,255,255,.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,.6);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    min-height: 82vh;
    animation: cardIn .6s cubic-bezier(.2,.9,.3,1.2) both;
}
@keyframes cardIn {
    from { opacity: 0; transform: translateY(30px) scale(.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* ================================================================
   LEFT HERO PANEL
   ================================================================ */
.reg-hero {
    position: relative;
    background: linear-gradient(160deg, #1f2937 0%, #111827 55%, #7c2d12 100%);
    color: var(--white);
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
}
.reg-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 20%, rgba(255,106,0,.35), transparent 45%),
      radial-gradient(circle at 80% 80%, rgba(124,58,237,.35), transparent 45%);
    animation: heroGlow 8s ease-in-out infinite alternate;
    pointer-events: none;
}
@keyframes heroGlow {
    from { opacity: .6; }
    to   { opacity: 1; }
}

/* ---- Inline SVG illustration container ---- */
.hero-media {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 200px;
    margin-bottom: 24px;
    display: grid;
    place-items: center;
    animation: heroFloat 5s ease-in-out infinite;
}
@keyframes heroFloat {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-12px); }
}
.hero-media svg {
    width: 100%;
    height: 100%;
    max-width: 320px;
    filter: drop-shadow(0 20px 40px rgba(255,106,0,.35));
}

/* SVG animated parts */
.svg-pulse {
    animation: pulse 2.4s ease-in-out infinite;
    transform-origin: center;
}
@keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.06); opacity: .9; }
}
.svg-rotate {
    animation: rotate 12s linear infinite;
    transform-origin: center;
}
@keyframes rotate {
    to { transform: rotate(360deg); }
}
.svg-draw {
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    animation: draw 3s ease forwards;
}
@keyframes draw {
    to { stroke-dashoffset: 0; }
}
.svg-blink {
    animation: blink 1.6s ease-in-out infinite;
}
@keyframes blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: .3; }
}

.reg-hero h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -.5px;
    position: relative;
    z-index: 1;
    background: linear-gradient(90deg, #fff, #ffd7b5, #fff);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 4s linear infinite;
}
@keyframes shine {
    to { background-position: 200% center; }
}
.reg-hero p {
    margin-top: 12px;
    font-size: 13.5px;
    opacity: .85;
    line-height: 1.6;
    position: relative;
    z-index: 1;
}
.reg-hero .hero-steps {
    position: relative;
    z-index: 1;
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}
.hero-step {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 9px 12px;
    border-radius: 12px;
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.08);
    transition: all .25s ease;
}
.hero-step:hover {
    background: rgba(255,255,255,.10);
    transform: translateX(4px);
}
.hero-step .step-num {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    display: grid; place-items: center;
    font-weight: 700; font-size: 12px;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(255,106,0,.45);
}
.hero-step .step-text {
    font-size: 13px;
    line-height: 1.4;
    opacity: .95;
}

/* ================================================================
   RIGHT FORM PANEL
   ================================================================ */
.reg-form-wrap {
    padding: 40px 52px;
    overflow-y: auto;
    max-height: 82vh;
}
.reg-form-wrap::-webkit-scrollbar { width: 8px; }
.reg-form-wrap::-webkit-scrollbar-track { background: transparent; }
.reg-form-wrap::-webkit-scrollbar-thumb {
    background: #e5e7eb;
    border-radius: 10px;
}
.reg-form-wrap::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }

/* ---------- PROGRESS STEPPER ---------- */
.stepper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
    padding: 0 8px;
}
.step-item {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    position: relative;
}
.step-item:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 42px;
    top: 50%;
    width: calc(100% - 42px);
    height: 2px;
    background: var(--border);
    transform: translateY(-50%);
    z-index: 0;
}
.step-item.done::after,
.step-item.active::after {
    background: linear-gradient(90deg, var(--primary), var(--primary-light));
}
.step-bubble {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--white);
    border: 2px solid var(--border);
    display: grid; place-items: center;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-muted);
    position: relative;
    z-index: 1;
    transition: all .3s ease;
}
.step-item.active .step-bubble {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    border-color: var(--primary);
    color: #fff;
    box-shadow: 0 0 0 6px rgba(255,106,0,.15);
    animation: stepPulse 1.8s ease-in-out infinite;
}
@keyframes stepPulse {
    0%, 100% { box-shadow: 0 0 0 6px rgba(255,106,0,.15); }
    50%      { box-shadow: 0 0 0 12px rgba(255,106,0,.08); }
}
.step-item.done .step-bubble {
    background: var(--success);
    border-color: var(--success);
    color: #fff;
}
.step-item.done .step-bubble::before {
    content: "\f00c";
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
}
.step-item.done .step-bubble span { display: none; }
.step-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
}
.step-item.active .step-label { color: var(--primary-dark); }
@media (max-width: 720px) {
    .step-label { display: none; }
}

/* ---------- FORM HEADER ---------- */
.form-header {
    margin-bottom: 28px;
}
.form-header h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -.6px;
    color: var(--secondary);
    display: flex;
    align-items: center;
    gap: 12px;
}
.form-header h2 i {
    color: var(--primary);
    font-size: 26px;
}
.form-header p {
    color: var(--text-muted);
    font-size: 14px;
    margin-top: 6px;
}

/* ---------- ALERTS ---------- */
.alert {
    padding: 14px 18px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    animation: slideDown .3s ease;
}
.alert-error {
    background: linear-gradient(135deg, #fef2f2, #fee2e2);
    color: #991b1b;
    border-left: 4px solid var(--danger);
}
.alert-warn {
    background: linear-gradient(135deg, #fffbeb, #fef3c7);
    color: #92400e;
    border-left: 4px solid var(--warn);
}
@keyframes slideDown {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* ---------- SECTIONS ---------- */
.form-section {
    margin-bottom: 32px;
    opacity: 0;
    animation: fadeUp .5s ease forwards;
}
.form-section:nth-child(1) { animation-delay: .05s; }
.form-section:nth-child(2) { animation-delay: .10s; }
.form-section:nth-child(3) { animation-delay: .15s; }
.form-section:nth-child(4) { animation-delay: .20s; }
.form-section:nth-child(5) { animation-delay: .25s; }
.form-section:nth-child(6) { animation-delay: .30s; }
.form-section:nth-child(7) { animation-delay: .35s; }
.form-section:nth-child(8) { animation-delay: .40s; }
@keyframes fadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
}

.section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.4px;
    color: var(--primary-dark);
    margin-bottom: 16px;
}
.section-title i {
    width: 26px; height: 26px;
    display: grid; place-items: center;
    background: linear-gradient(135deg, rgba(255,106,0,.15), rgba(255,106,0,.05));
    border-radius: 8px;
    font-size: 12px;
    color: var(--primary);
}
.section-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
    margin-left: 8px;
}

/* ---------- GRID ---------- */
.form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px 18px;
}
.form-grid .span-2 { grid-column: span 2; }
@media (max-width: 640px) {
    .form-grid .span-2 { grid-column: span 1; }
}

/* ---------- FIELDS ---------- */
.field {
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.field label {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--secondary);
    display: flex;
    align-items: center;
    gap: 4px;
}
.field label .req { color: var(--danger); }

.field input[type="text"],
.field input[type="number"],
.field input[type="date"],
.field input[type="password"],
.field input[type="email"],
.field input[type="file"],
.field select,
.field textarea {
    width: 100%;
    padding: 12px 14px;
    font-family: inherit;
    font-size: 14px;
    color: var(--text);
    background: #f9fafb;
    border: 1.5px solid var(--border);
    border-radius: 11px;
    transition: all .2s ease;
    outline: none;
}
.field input:focus,
.field select:focus,
.field textarea:focus {
    background: var(--white);
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(255,106,0,.12);
    transform: translateY(-1px);
}
.field input::placeholder { color: #9ca3af; }
.field input:hover:not(:focus),
.field select:hover:not(:focus) { border-color: #cbd5e1; }

.field input[type="file"] {
    padding: 8px 12px;
    cursor: pointer;
}
.field input[type="file"]::file-selector-button {
    padding: 6px 14px;
    margin-right: 12px;
    border: none;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff;
    border-radius: 7px;
    font-weight: 600;
    font-size: 12px;
    cursor: pointer;
    transition: all .2s;
}
.field input[type="file"]::file-selector-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255,106,0,.35);
}

.field select {
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236b7280' stroke-width='2'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 18px;
    padding-right: 40px;
}

/* ---------- RADIO PILLS ---------- */
.radio-group {
    display: flex;
    gap: 12px;
    margin-top: 4px;
}
.radio-pill {
    flex: 1;
    position: relative;
    cursor: pointer;
}
.radio-pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}
.radio-pill span {
    display: block;
    padding: 11px 14px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-muted);
    background: #f9fafb;
    border: 1.5px solid var(--border);
    border-radius: 11px;
    transition: all .2s;
}
.radio-pill input:checked + span {
    background: linear-gradient(135deg, rgba(255,106,0,.12), rgba(255,106,0,.05));
    border-color: var(--primary);
    color: var(--primary-dark);
    box-shadow: 0 0 0 4px rgba(255,106,0,.10);
}
.radio-pill:hover span { border-color: #cbd5e1; }

/* ---------- BUTTONS ---------- */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 13px 26px;
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 700;
    border-radius: 11px;
    border: none;
    cursor: pointer;
    transition: all .22s cubic-bezier(.2,.9,.3,1.2);
    text-decoration: none;
    letter-spacing: .2px;
    position: relative;
    overflow: hidden;
}
.btn-primary {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: #fff;
    box-shadow: var(--shadow-glow);
}
.btn-primary::before {
    content: "";
    position: absolute;
    top: 50%; left: 50%;
    width: 0; height: 0;
    background: rgba(255,255,255,.25);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width .5s, height .5s;
}
.btn-primary:hover::before {
    width: 300px; height: 300px;
}
.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 25px 50px rgba(255,106,0,.45);
}
.btn-primary:active { transform: translateY(-1px); }
.btn-primary:disabled {
    opacity: .75;
    cursor: not-allowed;
    transform: none;
}
.btn-ghost {
    background: transparent;
    color: var(--secondary);
    border: 1.5px solid var(--border);
}
.btn-ghost:hover {
    background: #f3f4f6;
    border-color: #cbd5e1;
}

/* ---------- FORM ACTIONS ---------- */
.form-actions {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    margin-top: 32px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
    position: sticky;
    bottom: 0;
    background: linear-gradient(180deg, rgba(255,255,255,.85), rgba(255,255,255,.98));
    backdrop-filter: blur(6px);
    margin-left: -52px;
    margin-right: -52px;
    padding-left: 52px;
    padding-right: 52px;
    padding-bottom: 20px;
    z-index: 5;
}

/* ================================================================
   MODAL
   ================================================================ */
.modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15,23,42,.55);
    backdrop-filter: blur(6px);
    z-index: 1000;
    padding: 24px;
    overflow-y: auto;
}
.modal-overlay.open { display: grid; place-items: center; }

.modal-box {
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 720px;
    max-height: 90vh;
    overflow-y: auto;
    animation: modalIn .3s cubic-bezier(.2,.9,.3,1.3);
}
@keyframes modalIn {
    from { opacity: 0; transform: scale(.9) translateY(20px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
}

.modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 28px;
    border-bottom: 1px solid var(--border);
    background: linear-gradient(135deg, rgba(255,106,0,.06), transparent);
}
.modal-head h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--secondary);
}
.modal-head h3 i { color: var(--primary); }
.modal-close {
    width: 36px; height: 36px;
    border-radius: 50%;
    border: none;
    background: #f3f4f6;
    color: var(--text-muted);
    cursor: pointer;
    display: grid;
    place-items: center;
    font-size: 16px;
    transition: all .2s;
}
.modal-close:hover {
    background: #fee2e2;
    color: var(--danger);
    transform: rotate(90deg);
}

.modal-body {
    padding: 26px 28px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 20px;
}
.modal-body .span-2 { grid-column: span 2; }
@media (max-width: 640px) {
    .modal-body { grid-template-columns: 1fr; }
    .modal-body .span-2 { grid-column: span 1; }
}

.modal-foot {
    padding: 18px 28px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    background: #fafafa;
}

/* ================================================================
   TOAST
   ================================================================ */
.toast-host {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 2000;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.toast {
    background: var(--secondary);
    color: #fff;
    padding: 13px 18px;
    border-radius: 11px;
    font-size: 14px;
    font-weight: 500;
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 260px;
    animation: toastIn .3s cubic-bezier(.2,.9,.3,1.3);
}
.toast.toast-error  { background: linear-gradient(135deg, #b91c1c, #991b1b); }
.toast.toast-success{ background: linear-gradient(135deg, #059669, #047857); }
.toast.toast-info   { background: linear-gradient(135deg, #1d4ed8, #1e40af); }
@keyframes toastIn {
    from { opacity: 0; transform: translateX(30px) scale(.95); }
    to   { opacity: 1; transform: translateX(0) scale(1); }
}

/* ================================================================
   CONFETTI
   ================================================================ */
.confetti {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1500;
    overflow: hidden;
}
.confetti-piece {
    position: absolute;
    width: 10px; height: 10px;
    animation: confettiFall 2.6s linear forwards;
}
@keyframes confettiFall {
    to {
        transform: translateY(110vh) rotate(720deg);
        opacity: 0;
    }
}

/* ================================================================
   FOOTER
   ================================================================ */
.site-footer {
    text-align: center;
    padding: 26px 20px;
    color: var(--text-muted);
    font-size: 13px;
}
.site-footer strong {
    background: linear-gradient(135deg, var(--primary), var(--accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* ================================================================
   RESPONSIVE
   ================================================================ */
@media (max-width: 980px) {
    .reg-card { grid-template-columns: 1fr; }
    .reg-hero { padding: 32px 26px; }
    .reg-form-wrap { padding: 28px 22px; max-height: none; }
    .form-header h2 { font-size: 24px; }
    .form-actions {
        margin-left: -22px;
        margin-right: -22px;
        padding-left: 22px;
        padding-right: 22px;
    }
}

/* ================================================================
   REDUCED MOTION
   ================================================================ */
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
    }
}
</style>
</head>
<body>

<!-- ============================================================
     ANIMATED AURORA BACKGROUND
     ============================================================ -->
<div class="aurora-bg">
    <div class="aurora-blob b1"></div>
    <div class="aurora-blob b2"></div>
    <div class="aurora-blob b3"></div>
</div>

<div class="page-wrap">
  <div class="reg-card">

    <!-- ============================================================
         LEFT HERO PANEL — INLINE SVG ILLUSTRATION (NO IMAGE NEEDED)
         ============================================================ -->
    <aside class="reg-hero">

      <!-- Inline SVG hero illustration: person + card + documents -->
      <div class="hero-media">
        <svg viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Registration illustration">
          <defs>
            <linearGradient id="gradCard" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#ff6a00"/>
              <stop offset="100%" stop-color="#ffa04d"/>
            </linearGradient>
            <linearGradient id="gradAvatar" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#ffffff"/>
              <stop offset="100%" stop-color="#ffe4cc"/>
            </linearGradient>
            <linearGradient id="gradShirt" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#7c3aed"/>
              <stop offset="100%" stop-color="#a855f7"/>
            </linearGradient>
            <radialGradient id="gradGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ff6a00" stop-opacity=".45"/>
              <stop offset="100%" stop-color="#ff6a00" stop-opacity="0"/>
            </radialGradient>
          </defs>

          <!-- Glow behind card -->
          <circle cx="200" cy="150" r="140" fill="url(#gradGlow)" class="svg-pulse"/>

          <!-- Rotating dashed ring -->
          <circle cx="200" cy="150" r="120" fill="none" stroke="#ffa04d" stroke-width="1.5"
                  stroke-dasharray="8 10" opacity=".5" class="svg-rotate"/>

          <!-- Registration card -->
          <g transform="translate(120,90)">
            <!-- card body -->
            <rect x="0" y="0" width="160" height="120" rx="14"
                  fill="url(#gradCard)" filter="drop-shadow(0 15px 30px rgba(0,0,0,.4))"/>

            <!-- avatar circle -->
            <circle cx="42" cy="45" r="20" fill="url(#gradAvatar)"/>
            <circle cx="42" cy="38" r="8" fill="#1f2937" opacity=".85"/>
            <path d="M28 60 Q42 52 56 60 Q56 68 42 68 Q28 68 28 60 Z" fill="#1f2937" opacity=".85"/>

            <!-- text lines on card -->
            <rect x="72" y="30" width="72" height="7" rx="3.5" fill="#fff" opacity=".9"/>
            <rect x="72" y="45" width="52" height="6" rx="3" fill="#fff" opacity=".6"/>
            <rect x="72" y="58" width="60" height="6" rx="3" fill="#fff" opacity=".6"/>

            <!-- small chips -->
            <rect x="16" y="85" width="42" height="20" rx="10" fill="#fff" opacity=".95"/>
            <circle cx="26" cy="95" r="4" fill="#ff6a00"/>
            <rect x="34" y="92" width="20" height="6" rx="3" fill="#ff6a00" opacity=".7"/>

            <rect x="66" y="85" width="42" height="20" rx="10" fill="#fff" opacity=".55"/>
            <rect x="76" y="92" width="22" height="6" rx="3" fill="#fff"/>

            <rect x="116" y="85" width="30" height="20" rx="10" fill="#fff" opacity=".55"/>
            <rect x="122" y="92" width="18" height="6" rx="3" fill="#fff"/>
          </g>

          <!-- Floating document 1 -->
          <g transform="translate(70,60)" class="svg-pulse" style="animation-delay:.4s">
            <rect x="0" y="0" width="48" height="60" rx="6" fill="#fff" opacity=".95"
                  filter="drop-shadow(0 8px 16px rgba(0,0,0,.3))"/>
            <rect x="8" y="12" width="32" height="4" rx="2" fill="#ff6a00"/>
            <rect x="8" y="22" width="24" height="3" rx="1.5" fill="#cbd5e1"/>
            <rect x="8" y="30" width="28" height="3" rx="1.5" fill="#cbd5e1"/>
            <rect x="8" y="38" width="20" height="3" rx="1.5" fill="#cbd5e1"/>
            <circle cx="36" cy="50" r="6" fill="#10b981"/>
            <path d="M33 50 L35 52 L39 48" stroke="#fff" stroke-width="1.5" fill="none"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </g>

          <!-- Floating document 2 -->
          <g transform="translate(285,80)" class="svg-pulse" style="animation-delay:.8s">
            <rect x="0" y="0" width="48" height="60" rx="6" fill="#fff" opacity=".95"
                  filter="drop-shadow(0 8px 16px rgba(0,0,0,.3))"/>
            <rect x="8" y="12" width="32" height="4" rx="2" fill="#7c3aed"/>
            <rect x="8" y="22" width="24" height="3" rx="1.5" fill="#cbd5e1"/>
            <rect x="8" y="30" width="28" height="3" rx="1.5" fill="#cbd5e1"/>
            <rect x="8" y="38" width="20" height="3" rx="1.5" fill="#cbd5e1"/>
          </g>

          <!-- Bottom laptop glyph -->
          <g transform="translate(160,240)" class="svg-blink">
            <rect x="0" y="0" width="80" height="4" rx="2" fill="#fff" opacity=".7"/>
            <rect x="4" y="4" width="72" height="40" rx="4" fill="#1f2937" stroke="#fff" stroke-width="1.5"/>
            <rect x="10" y="10" width="60" height="28" rx="2" fill="#ff6a00" opacity=".8"/>
            <circle cx="40" cy="24" r="4" fill="#fff"/>
          </g>

          <!-- Sparkles -->
          <g fill="#ffd7b5" class="svg-blink">
            <circle cx="60" cy="180" r="2"/>
            <circle cx="340" cy="200" r="2.5"/>
            <circle cx="90" cy="250" r="1.8"/>
            <circle cx="310" cy="60" r="2"/>
          </g>
        </svg>
      </div>

      <div>
        <h1>EIS Onboarding Portal</h1>
        <p>Fast, secure, and paperless employee registration — complete all sections in a single form.</p>
      </div>

      <div class="hero-steps">
        <div class="hero-step">
          <div class="step-num">1</div>
          <div class="step-text">Employee identity &amp; credentials</div>
        </div>
        <div class="hero-step">
          <div class="step-num">2</div>
          <div class="step-text">Contact &amp; address information</div>
        </div>
        <div class="hero-step">
          <div class="step-num">3</div>
          <div class="step-text">Laptop / VDI / VPN configuration</div>
        </div>
        <div class="hero-step">
          <div class="step-num">4</div>
          <div class="step-text">Upload documents &amp; submit</div>
        </div>
      </div>
    </aside>

    <!-- ============================================================
         RIGHT FORM PANEL
         ============================================================ -->
    <main class="reg-form-wrap">

      <!-- ---------- STEPPER ---------- -->
      <div class="stepper" id="stepper">
        <div class="step-item active" data-step="1">
          <div class="step-bubble"><span>1</span></div>
          <div class="step-label">Identity</div>
        </div>
        <div class="step-item" data-step="2">
          <div class="step-bubble"><span>2</span></div>
          <div class="step-label">Contact</div>
        </div>
        <div class="step-item" data-step="3">
          <div class="step-bubble"><span>3</span></div>
          <div class="step-label">Docs</div>
        </div>
        <div class="step-item" data-step="4">
          <div class="step-bubble"><span>4</span></div>
          <div class="step-label">Submit</div>
        </div>
      </div>

      <!-- ---------- HEADER ---------- -->
      <div class="form-header">
        <h2><i class="fa-solid fa-pen-to-square"></i> Registration Form</h2>
        <p>Fields marked <span style="color:var(--danger)">*</span> are required.</p>
      </div>

      <!-- ---------- SERVER MESSAGES ---------- -->
      <s:if test="m_strmsg == 'error'">
        <div class="alert alert-error">
          <i class="fa-solid fa-circle-exclamation"></i>
          Something went wrong. Please try again.
        </div>
      </s:if>
      <s:if test="m_strmsg == 'duplicate'">
        <div class="alert alert-warn">
          <i class="fa-solid fa-triangle-exclamation"></i>
          Employee ID already exists. Please use a different one.
        </div>
      </s:if>

      <!-- ---------- FORM ---------- -->
      <s:form action="saveRegistration" method="post"
              enctype="multipart/form-data" theme="simple" id="regForm">

        <!-- ============ SECTION 1: EMPLOYEE IDENTITY ============ -->
        <section class="form-section">
          <div class="section-title">
            <i class="fa-solid fa-user"></i> Employee Identity
          </div>

          <div class="form-grid">
            <div class="field">
              <label>Employee ID <span class="req">*</span></label>
              <s:textfield name="m_stremployee_id" id="empId" maxlength="44"
                           placeholder="e.g. 123456"/>
            </div>

            <div class="field">
              <label>AD ID</label>
              <s:textfield name="m_strad_id" maxlength="44" placeholder="e.g. AD12345"/>
            </div>

            <div class="field">
              <label>HID</label>
              <s:textfield name="m_strhid" maxlength="44" placeholder="HID"/>
            </div>

            <div class="field">
              <label>Asset ID</label>
              <s:textfield name="m_strasset_id" maxlength="44" placeholder="Asset ID"/>
            </div>
          </div>
        </section>

        <!-- ============ SECTION 2: QUALIFICATION ============ -->
        <section class="form-section">
          <div class="section-title">
            <i class="fa-solid fa-graduation-cap"></i> Qualification &amp; Joining
          </div>

          <div class="form-grid">
            <div class="field">
              <label>Education Qualification <span class="req">*</span></label>
              <s:select name="m_streduqualification"
                        list="{'B-Tech','M-Tech','BSC','MSC','BCA','MCA'}"
                        headerKey=""
                        headerValue="Select Education Qualification"/>
            </div>

            <div class="field">
              <label>TCS Joining Date <span class="req">*</span></label>
              <s:textfield name="m_strtcsjoiningdate" type="date"/>
            </div>
          </div>
        </section>

        <!-- ============ SECTION 3: CONTACT ============ -->
        <section class="form-section">
          <div class="section-title">
            <i class="fa-solid fa-phone"></i> Contact Information
          </div>

          <div class="form-grid">
            <div class="field">
              <label>Employee Contact Number <span class="req">*</span></label>
              <s:textfield name="m_strcontactno" maxlength="10"
                           placeholder="10-digit mobile"/>
            </div>

            <div class="field">
              <label>Emergency Contact Number</label>
              <s:textfield name="m_stremergencycontactno" maxlength="10"
                           placeholder="10-digit mobile"/>
            </div>

            <div class="field">
              <label>Team / Role <span class="req">*</span></label>
              <s:select name="m_strRole" list="rolelist"/>
            </div>

            <div class="field">
              <label>TCS Mail ID <span class="req">*</span></label>
              <s:textfield name="m_strtcsmailid" maxlength="44"
                           placeholder="abc@tcs.com"/>
            </div>

            <div class="field span-2">
              <label>SBI Mail ID</label>
              <s:textfield name="m_strsbimailid" maxlength="44"
                           placeholder="abc@sbitcs.com"/>
            </div>
          </div>
        </section>

        <!-- ============ SECTION 4: ADDRESS ============ -->
        <section class="form-section">
          <div class="section-title">
            <i class="fa-solid fa-location-dot"></i> Address
          </div>

          <div class="form-grid">
            <div class="field">
              <label>State <span class="req">*</span></label>
              <s:select name="m_strstate"
                        list="{'Maharashtra','Karnataka','Tamil Nadu','Delhi','Gujarat','Telangana','West Bengal'}"
                        headerKey=""
                        headerValue="Select State"/>
            </div>

            <div class="field">
              <label>City <span class="req">*</span></label>
              <s:textfield name="m_strcity" maxlength="70" placeholder="City"/>
            </div>

            <div class="field span-2">
              <label>Local Address <span class="req">*</span></label>
              <s:textfield name="m_strlocaladdress" maxlength="180"
                           placeholder="Building, street, area..."/>
            </div>
          </div>
        </section>

        <!-- ============ SECTION 5: PERSONAL ============ -->
        <section class="form-section">
          <div class="section-title">
            <i class="fa-solid fa-user-circle"></i> Personal Details
          </div>

          <div class="form-grid">
            <div class="field span-2">
              <label>Gender <span class="req">*</span></label>
              <div class="radio-group">
                <label class="radio-pill">
                  <input type="radio" name="m_strgender" value="Male" checked>
                  <span>Male</span>
                </label>
                <label class="radio-pill">
                  <input type="radio" name="m_strgender" value="Female">
                  <span>Female</span>
                </label>
                <label class="radio-pill">
                  <input type="radio" name="m_strgender" value="Other">
                  <span>Other</span>
                </label>
              </div>
            </div>

            <div class="field">
              <label>Date Of Birth <span class="req">*</span></label>
              <s:textfield name="m_strdob" type="date"/>
            </div>

            <div class="field">
              <label>First Name <span class="req">*</span></label>
              <s:textfield name="m_strfirstName" maxlength="44" placeholder="First name"/>
            </div>

            <div class="field">
              <label>Middle Name</label>
              <s:textfield name="m_strmiddleName" maxlength="44" placeholder="Middle name"/>
            </div>

            <div class="field">
              <label>Last Name <span class="req">*</span></label>
              <s:textfield name="m_strlastName" maxlength="44" placeholder="Last name"/>
            </div>
          </div>
        </section>

        <!-- ============ SECTION 6: LAPTOP/VDI ============ -->
        <section class="form-section">
          <div class="section-title">
            <i class="fa-solid fa-laptop"></i> Laptop &amp; VDI / VPN
          </div>

          <div class="form-grid">
            <div class="field span-2">
              <button type="button" class="btn btn-ghost" id="openLaptopModal">
                <i class="fa-solid fa-plus"></i> Add Laptop / VDI Details
              </button>
            </div>
          </div>
        </section>

        <!-- ============ SECTION 7: DOCUMENTS ============ -->
        <section class="form-section">
          <div class="section-title">
            <i class="fa-solid fa-paperclip"></i> Documents
          </div>

          <div class="form-grid">
            <div class="field">
              <label>BGC Document</label>
              <s:file name="m_strtheBgcfile"/>
            </div>

            <div class="field">
              <label>Photo</label>
              <s:file name="m_strthePhotofile" accept="image/*"/>
            </div>

            <div class="field">
              <label>Police Verification</label>
              <s:file name="m_strthePoliceverificationfile"/>
            </div>

            <div class="field">
              <label>CV Document</label>
              <s:file name="m_strtheCvfile"/>
            </div>
          </div>
        </section>

        <!-- ============ SECTION 8: CREDENTIALS ============ -->
        <section class="form-section">
          <div class="section-title">
            <i class="fa-solid fa-key"></i> Credentials
          </div>

          <div class="form-grid">
            <div class="field">
              <label>Username <span class="req">*</span></label>
              <s:textfield name="m_strUserName" maxlength="44" placeholder="Username"/>
            </div>

            <div class="field">
              <label>Password <span class="req">*</span></label>
              <s:password name="m_strPassword" maxlength="44" placeholder="Password"/>
            </div>
          </div>
        </section>

        <s:hidden name="action" value="insert"/>

        <!-- ============ ACTION BAR ============ -->
        <div class="form-actions">
          <button type="reset" class="btn btn-ghost">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </button>
          <button type="button" class="btn btn-primary" id="submitBtn">
            <i class="fa-solid fa-paper-plane"></i> Submit Registration
          </button>
        </div>

      </s:form>

    </main>
  </div>

  <footer class="site-footer">
    <p>Designed by <strong>@Shubham Chaudhari</strong> &nbsp;·&nbsp; Developed by <strong>@Amit Avhad</strong></p>
  </footer>
</div>

<!-- ================================================================
     MODAL — Laptop / VDI
     ================================================================ -->
<div class="modal-overlay" id="laptopModal">
  <div class="modal-box">
    <div class="modal-head">
      <h3><i class="fa-solid fa-laptop-code"></i> Laptop &amp; VDI / VPN Details</h3>
      <button type="button" class="modal-close" id="closeLaptopModal">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="modal-body">
      <div class="field">
        <label>VPN Hostname</label>
        <s:textfield name="m_strvpnhostname" maxlength="44" placeholder="VPN hostname"/>
      </div>

      <div class="field">
        <label>Laptop Hostname</label>
        <s:textfield name="m_strlaptophostname" maxlength="44" placeholder="Laptop hostname"/>
      </div>

      <div class="field span-2">
        <label>Remote Type</label>
        <s:select name="m_strremotetype"
                  list="{'NONE','VPN','VDI'}"
                  headerKey=""
                  headerValue="Select Remote Type"/>
      </div>

      <div class="field">
        <label>VPN/VDI MAC Address</label>
        <s:textfield name="m_strvpnmacaddress" maxlength="44" placeholder="xx:xx:xx:xx:xx:xx"/>
      </div>

      <div class="field">
        <label>VPN/VDI IP Address</label>
        <s:textfield name="m_strvpnipaddress" maxlength="44" placeholder="xxx.xxx.xxx.xxx"/>
      </div>
    </div>

    <div class="modal-foot">
      <button type="button" class="btn btn-ghost" id="cancelLaptopModal">Cancel</button>
      <button type="button" class="btn btn-primary" id="saveLaptopModal">
        <i class="fa-solid fa-check"></i> Save Details
      </button>
    </div>
  </div>
</div>

<!-- ================================================================
     TOASTS + CONFETTI
     ================================================================ -->
<div class="toast-host" id="toastHost"></div>
<div class="confetti" id="confettiHost"></div>

<!-- ================================================================
     SCRIPTS
     ================================================================ -->
<script>
(function () {
    'use strict';

    /* ---------- Toast ---------- */
    const toastHost = document.getElementById('toastHost');
    function toast(msg, type) {
        const el = document.createElement('div');
        el.className = 'toast' + (type ? ' toast-' + type : '');
        const icons = {
            error:   'fa-circle-xmark',
            success: 'fa-circle-check',
            info:    'fa-circle-info'
        };
        el.innerHTML = '<i class="fa-solid ' + (icons[type] || icons.info) + '"></i><span>' + msg + '</span>';
        toastHost.appendChild(el);
        setTimeout(() => {
            el.style.transition = 'all .3s';
            el.style.opacity = '0';
            el.style.transform = 'translateX(30px)';
            setTimeout(() => el.remove(), 300);
        }, 3200);
    }

    /* ---------- Confetti ---------- */
    const confettiHost = document.getElementById('confettiHost');
    function fireConfetti(count) {
        const colors = ['#ff6a00','#ffa04d','#7c3aed','#06b6d4','#10b981','#f59e0b'];
        for (let i = 0; i < (count || 60); i++) {
            const p = document.createElement('div');
            p.className = 'confetti-piece';
            p.style.left = Math.random() * 100 + 'vw';
            p.style.top  = '-20px';
            p.style.background = colors[Math.floor(Math.random() * colors.length)];
            p.style.transform = 'rotate(' + (Math.random() * 360) + 'deg)';
            p.style.animationDelay = (Math.random() * 0.4) + 's';
            p.style.animationDuration = (2 + Math.random() * 1.2) + 's';
            if (Math.random() > 0.7) p.style.borderRadius = '50%';
            confettiHost.appendChild(p);
            setTimeout(() => p.remove(), 3500);
        }
    }

    /* ---------- Modal ---------- */
    const modal    = document.getElementById('laptopModal');
    const openBtn  = document.getElementById('openLaptopModal');
    const closeBtn = document.getElementById('closeLaptopModal');
    const cancelBtn= document.getElementById('cancelLaptopModal');
    const saveBtn  = document.getElementById('saveLaptopModal');

    openBtn.addEventListener('click', () => modal.classList.add('open'));
    function closeModal() { modal.classList.remove('open'); }
    closeBtn.addEventListener('click', closeModal);
    cancelBtn.addEventListener('click', closeModal);
    saveBtn.addEventListener('click', () => {
        toast('Laptop / VDI details captured', 'success');
        closeModal();
    });
    modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
    });

    /* ---------- Validation + Submit ---------- */
    const form = document.getElementById('regForm');
    const submitBtn = document.getElementById('submitBtn');

    function val(name) {
        const el = form.querySelector('[name="' + name + '"]');
        return el ? el.value.trim() : '';
    }

    function validate() {
        const checks = [
            ['m_stremployee_id',      'Please enter Employee ID'],
            ['m_streduqualification', 'Please select Education Qualification'],
            ['m_strtcsjoiningdate',   'Please select TCS Joining Date'],
            ['m_strcontactno',        'Please enter Employee contact number'],
            ['m_strRole',             'Please select Team / Role'],
            ['m_strtcsmailid',        'Please enter TCS Mail ID'],
            ['m_strstate',            'Please select State'],
            ['m_strcity',             'Please enter City'],
            ['m_strlocaladdress',     'Please enter Local Address'],
            ['m_strdob',              'Please enter Date of Birth'],
            ['m_strfirstName',        'Please enter First Name'],
            ['m_strmiddleName',       'Please enter Middle Name'],
            ['m_strlastName',         'Please enter Last Name'],
            ['m_strUserName',         'Please enter Username'],
            ['m_strPassword',         'Please enter Password']
        ];
        for (const [name, msg] of checks) {
            if (!val(name)) { toast(msg, 'error'); return false; }
        }
        return true;
    }

    submitBtn.addEventListener('click', function () {
        if (!validate()) return;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting...';
        fireConfetti(70);
        setTimeout(() => form.submit(), 500);
    });

    /* ---------- Number-only inputs ---------- */
    form.querySelectorAll('input[name="m_strcontactno"],input[name="m_stremergencycontactno"]')
        .forEach(inp => {
            inp.addEventListener('input', () => {
                inp.value = inp.value.replace(/\D/g, '').slice(0, 10);
            });
        });

    /* ---------- Live Stepper update ---------- */
    const stepper = document.getElementById('stepper');
    function updateStepper() {
        const filled = {
            1: !!(val('m_stremployee_id') && val('m_streduqualification')),
            2: !!(val('m_strcontactno') && val('m_strtcsmailid') && val('m_strRole')),
            3: true, // docs section — always treated as ready
            4: false
        };
        const items = stepper.querySelectorAll('.step-item');
        items.forEach(it => {
            const step = it.dataset.step;
            it.classList.remove('active', 'done');
            if (filled[step]) it.classList.add('done');
            else if (!Object.values(filled).slice(0, step - 1).some(v => !v)) it.classList.add('active');
        });
    }
    form.addEventListener('input', updateStepper);
    form.addEventListener('change', updateStepper);
    updateStepper();

})();
</script>

</body>
</html>

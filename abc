<%@page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%
 response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate");
 response.setHeader("Pragma", "no-cache");
 response.setDateHeader("Expires", 0);

 // Struts action se aane wali rolelist
 java.util.List<String> rolelist = (java.util.List<String>) request.getAttribute("rolelist");
 if(rolelist == null) {
     rolelist = (java.util.List<String>) session.getAttribute("rolelist");
 }
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>EIS Portal — Sign In</title>
<script src="<%=request.getContextPath()%>/js/jquery.min.js"></script>
<style>
:root{
  --brand:#F86F03;
  --brand-2:#FF9A3D;
  --brand-light:#FFF4EC;
  --brand-glow:rgba(248,111,3,.35);
  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F7F7F5;
  --card:#FFFFFF;
  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --dark-1:#0A0A0A;
  --dark-2:#1A1A1A;
  --dark-3:#2A2A2A;
}
html[data-theme="dark"]{
  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#272727;
  --bg:#0F0F0F;
  --card:#161616;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--font-stack);
  font-weight:700;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  transition:background .3s ease,color .3s ease;
  min-height:100vh;
  overflow-x:hidden;
}
a{color:inherit;text-decoration:none}
h1,h2,h3,h4,h5,h6,strong,b{font-weight:800;letter-spacing:-.3px}

.icon-svg{
  width:16px;height:16px;
  display:inline-block;flex-shrink:0;
  stroke:currentColor;fill:none;
  stroke-width:2.2;
  stroke-linecap:round;stroke-linejoin:round;
}

/* ============ DECORATIVE BLOBS ============ */
.blob{
  position:fixed;
  border-radius:50%;
  filter:blur(80px);
  opacity:.35;
  z-index:0;
  pointer-events:none;
}
.blob.b1{width:420px;height:420px;background:#F86F03;top:-120px;left:-120px;animation:float 14s ease-in-out infinite}
.blob.b2{width:380px;height:380px;background:#FFA41B;bottom:-140px;right:-120px;animation:float 16s ease-in-out infinite reverse}
.blob.b3{width:320px;height:320px;background:#FF5E7E;top:45%;right:25%;opacity:.18;animation:float 20s ease-in-out infinite}
@keyframes float{
  0%,100%{transform:translate(0,0) scale(1)}
  50%{transform:translate(30px,-40px) scale(1.1)}
}

/* ============ SHELL ============ */
.shell{
  position:relative;
  z-index:2;
  width:100%;
  min-height:100vh;
  display:grid;
  grid-template-columns: 1.1fr 1fr;
}

/* ============ LEFT: BRAND PANEL ============ */
.brand-side{
  background:linear-gradient(160deg, #0A0A0A 0%, #1A1A1A 60%, #2A2A2A 100%);
  padding:52px 56px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  position:relative;
  overflow:hidden;
  color:#fff;
}
.brand-side::before{
  content:"";
  position:absolute;
  top:-80px;right:-80px;
  width:400px;height:400px;
  border-radius:50%;
  background:radial-gradient(circle, rgba(248,111,3,.35) 0%, transparent 70%);
}
.brand-side::after{
  content:"";
  position:absolute;
  bottom:-120px;left:-80px;
  width:340px;height:340px;
  border-radius:50%;
  background:radial-gradient(circle, rgba(255,154,61,.2) 0%, transparent 70%);
}

.brand-logo{
  display:flex;align-items:center;gap:14px;
  font-weight:900;font-size:1.25rem;
  letter-spacing:-.5px;
  position:relative;z-index:2;
  text-transform:uppercase;
}
.brand-logo-mark{
  width:46px;height:46px;
  background:linear-gradient(135deg, var(--brand), var(--brand-2));
  display:grid;place-items:center;
  border-radius:12px;
  box-shadow:0 10px 28px -8px var(--brand);
  position:relative;
}
.brand-logo-mark::after{
  content:"";
  position:absolute;
  inset:0;
  border-radius:12px;
  border:2px solid var(--brand);
  opacity:.3;
  animation:ping 2.5s ease-out infinite;
}
@keyframes ping{
  0%{transform:scale(1);opacity:.5}
  100%{transform:scale(1.4);opacity:0}
}
.brand-logo-mark .icon-svg{width:20px;height:20px;stroke-width:2.6}
.brand-logo-text{
  display:flex;
  flex-direction:column;
  gap:1px;
}
.brand-logo-text .top{font-size:1.15rem;font-weight:900;letter-spacing:.5px}
.brand-logo-text .sub{font-size:.7rem;font-weight:700;color:var(--brand);letter-spacing:2px;text-transform:uppercase}

.brand-content{
  position:relative;z-index:2;
  max-width:520px;
  margin:auto 0;
  padding:40px 0;
}
.brand-eyebrow{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:7px 14px;
  background:rgba(248,111,3,.12);
  border:1px solid rgba(248,111,3,.3);
  border-radius:999px;
  font-size:.72rem;
  font-weight:800;
  color:var(--brand);
  letter-spacing:1.2px;
  text-transform:uppercase;
  margin-bottom:24px;
}
.brand-eyebrow .dot{
  width:6px;height:6px;
  border-radius:50%;
  background:var(--brand);
  box-shadow:0 0 10px var(--brand);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

.brand-content h1{
  font-size:3.4rem;
  font-weight:900;
  line-height:1.05;
  letter-spacing:-1.8px;
  margin-bottom:22px;
  color:#fff;
}
.brand-content h1 .grad{
  background:linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
  display:inline-block;
}
.brand-content p{
  font-size:1.05rem;
  line-height:1.75;
  color:rgba(255,255,255,.7);
  font-weight:600;
  max-width:460px;
}

.brand-features{
  display:flex;
  flex-direction:column;
  gap:14px;
  margin-top:38px;
  max-width:440px;
}
.feature{
  display:flex;align-items:center;gap:14px;
  font-size:.9rem;
  font-weight:700;
  color:rgba(255,255,255,.85);
  padding:12px 16px;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.08);
  border-radius:12px;
  transition:all .2s ease;
}
.feature:hover{
  background:rgba(248,111,3,.1);
  border-color:rgba(248,111,3,.3);
}
.feature .ficon{
  width:28px;height:28px;
  display:grid;place-items:center;
  background:rgba(248,111,3,.15);
  color:var(--brand);
  border-radius:8px;
  flex-shrink:0;
}
.feature .ficon .icon-svg{width:14px;height:14px;stroke-width:2.6}

.brand-footer{
  position:relative;z-index:2;
  font-size:.8rem;
  color:rgba(255,255,255,.5);
  font-weight:700;
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:8px;
}
.brand-footer .status{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:.72rem;
  color:#4ADE80;
  letter-spacing:1px;
  text-transform:uppercase;
}
.brand-footer .status .dot{
  width:6px;height:6px;
  border-radius:50%;
  background:#4ADE80;
  box-shadow:0 0 8px #4ADE80;
  animation:pulse 2s ease-in-out infinite;
}

/* ============ RIGHT: FORM PANEL ============ */
.form-side{
  display:flex;
  align-items:center;
  justify-content:center;
  padding:56px 48px;
  background:var(--card);
  position:relative;
}
.form-wrap{
  width:100%;
  max-width:420px;
}

.form-head{
  margin-bottom:28px;
}
.form-head .step{
  font-size:.72rem;
  font-weight:800;
  color:var(--brand);
  letter-spacing:2px;
  text-transform:uppercase;
  margin-bottom:10px;
  display:flex;
  align-items:center;
  gap:8px;
}
.form-head .step::before{
  content:"";
  width:24px;height:2px;
  background:var(--brand);
  border-radius:2px;
}
.form-head h2{
  font-size:2rem;
  font-weight:900;
  letter-spacing:-.8px;
  margin-bottom:8px;
  color:var(--ink);
}
.form-head p{
  color:var(--muted);
  font-size:.92rem;
  font-weight:700;
}

/* Tabs — segmented control */
.tabs{
  display:flex;
  gap:4px;
  background:var(--bg);
  padding:5px;
  border-radius:14px;
  margin-bottom:28px;
  border:1px solid var(--line);
}
.tab{
  flex:1;
  padding:11px;
  border:none;
  background:transparent;
  color:var(--muted);
  font-family:inherit;
  font-size:.82rem;
  font-weight:800;
  border-radius:10px;
  cursor:pointer;
  transition:all .2s ease;
  display:flex;align-items:center;justify-content:center;gap:8px;
  text-transform:uppercase;
  letter-spacing:.6px;
  position:relative;
}
.tab .icon-svg{width:14px;height:14px}
.tab.active{
  background:var(--card);
  color:var(--brand);
  box-shadow:0 2px 10px rgba(0,0,0,.08);
}
.tab.active::before{
  content:"";
  position:absolute;
  top:-1px;left:20%;right:20%;
  height:2px;
  background:var(--brand);
  border-radius:2px;
}

/* Fields */
.field{margin-bottom:18px;position:relative}
.field label{
  display:block;
  font-size:.76rem;
  font-weight:800;
  color:var(--ink);
  margin-bottom:9px;
  text-transform:uppercase;
  letter-spacing:.8px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.field label .req{
  font-size:.62rem;
  color:var(--muted);
  font-weight:700;
  letter-spacing:.5px;
}
.input-box{
  position:relative;
  display:flex;align-items:center;
  border:1.5px solid var(--line);
  background:var(--bg);
  border-radius:12px;
  transition:all .25s ease;
}
.input-box:focus-within{
  border-color:var(--brand);
  background:var(--card);
  box-shadow:0 0 0 4px var(--brand-light);
}
.input-box > .icon-svg{
  color:var(--muted);
  margin-left:16px;
  transition:color .25s ease;
  width:16px;height:16px;
}
.input-box:focus-within > .icon-svg{color:var(--brand)}
.input-box input,
.input-box select{
  flex:1;
  padding:15px 16px 15px 12px;
  background:transparent;
  border:none;
  outline:none;
  font-family:inherit;
  font-size:.92rem;
  font-weight:700;
  color:var(--ink);
  width:100%;
}
.input-box select{
  cursor:pointer;
  appearance:none;
  padding-right:40px;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%236B7280' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
  background-repeat:no-repeat;
  background-position:right 16px center;
}
.input-box input::placeholder{color:var(--muted);font-weight:600;opacity:.65}

.pw-toggle{
  background:transparent;border:none;
  color:var(--muted);
  padding:0 16px;
  cursor:pointer;
  transition:color .2s ease;
  display:grid;place-items:center;
}
.pw-toggle .icon-svg{width:16px;height:16px}
.pw-toggle:hover{color:var(--brand)}

.alert{
  display:none;
  padding:12px 16px;
  border-radius:11px;
  font-size:.85rem;
  font-weight:700;
  margin-bottom:18px;
  align-items:center;gap:10px;
}
.alert.error{display:flex;background:#FEF2F2;color:#B91C1C;border:1px solid #FECACA}
.alert.success{display:flex;background:#F0FDF4;color:#15803D;border:1px solid #BBF7D0}
.alert .icon-svg{width:16px;height:16px}

.btn-primary{
  width:100%;
  padding:16px;
  border:none;
  border-radius:12px;
  background:linear-gradient(135deg, var(--brand), var(--brand-2));
  color:#fff;
  font-family:inherit;
  font-weight:800;
  font-size:.95rem;
  letter-spacing:.6px;
  text-transform:uppercase;
  cursor:pointer;
  transition:all .25s ease;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  box-shadow:0 6px 20px -6px var(--brand-glow);
  position:relative;
  overflow:hidden;
}
.btn-primary::before{
  content:"";
  position:absolute;
  top:0;left:-100%;
  width:100%;height:100%;
  background:linear-gradient(90deg, transparent, rgba(255,255,255,.3), transparent);
  transition:left .6s ease;
}
.btn-primary:hover::before{left:100%}
.btn-primary:hover{
  transform:translateY(-2px);
  box-shadow:0 10px 28px -6px var(--brand-glow);
}
.btn-primary:active{transform:translateY(0)}
.btn-primary:disabled{opacity:.65;cursor:not-allowed;transform:none}

.spinner{
  width:16px;height:16px;
  border:2px solid rgba(255,255,255,.35);
  border-top-color:#fff;
  border-radius:50%;
  animation:spin .7s linear infinite;
  display:none;
}
.btn-primary.loading .spinner{display:block}
@keyframes spin{to{transform:rotate(360deg)}}

.form-view{display:none;animation:fadeIn .35s ease}
.form-view.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

.foot-note{
  margin-top:28px;
  text-align:center;
  font-size:.78rem;
  color:var(--muted);
  font-weight:700;
}
.foot-note a{
  color:var(--brand);
  text-decoration:none;
  font-weight:800;
}
.foot-note a:hover{text-decoration:underline}

/* ============ QUICK LINKS ============ */
.quick-links-section{
  grid-column: 1 / -1;
  padding:40px 56px 48px;
  background:var(--bg);
  border-top:1px solid var(--line);
  position:relative;
  z-index:2;
}
.quick-title{
  display:flex;
  align-items:center;
  gap:12px;
  font-size:1.05rem;
  font-weight:900;
  color:var(--ink);
  margin-bottom:22px;
  text-transform:uppercase;
  letter-spacing:.8px;
}
.quick-title .icon-svg{width:20px;height:20px;color:var(--brand)}
.quick-title .line{
  flex:1;
  height:1px;
  background:linear-gradient(90deg, var(--line), transparent);
}

.quick-grid{
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap:12px;
}

.quick-card{
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px 16px;
  background:var(--card);
  border:1.5px solid var(--line);
  border-radius:12px;
  color:var(--ink);
  text-decoration:none;
  font-weight:800;
  font-size:.85rem;
  transition:all .2s ease;
  cursor:pointer;
  position:relative;
}
.quick-card:hover{
  border-color:var(--brand);
  background:var(--brand-light);
  color:var(--brand);
  transform:translateY(-2px);
  box-shadow:0 8px 20px -8px var(--brand-glow);
}
html[data-theme="dark"] .quick-card:hover{
  background:rgba(248,111,3,.15);
}
.quick-card .qicon{
  width:36px;height:36px;
  display:grid;place-items:center;
  background:var(--brand-light);
  color:var(--brand);
  border-radius:10px;
  flex-shrink:0;
  transition:all .2s ease;
}
html[data-theme="dark"] .quick-card .qicon{
  background:rgba(248,111,3,.15);
}
.quick-card .qicon .icon-svg{width:16px;height:16px;stroke-width:2.4}
.quick-card:hover .qicon{
  background:var(--brand);
  color:#fff;
}
.quick-card .qtext{
  display:flex;
  flex-direction:column;
  gap:2px;
  min-width:0;
  flex:1;
}
.quick-card .qname{
  font-weight:800;
  font-size:.85rem;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.quick-card .qsub{
  font-size:.68rem;
  font-weight:700;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.4px;
}

/* Dropdown cards */
.quick-card.dropdown{
  flex-direction:column;
  align-items:stretch;
  padding:0;
  cursor:default;
}
.quick-card.dropdown:hover{
  transform:none;
  box-shadow:0 4px 12px -6px rgba(248,111,3,.2);
}
.quick-card .drop-head{
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px 16px;
  border-bottom:1px solid transparent;
  cursor:pointer;
}
.quick-card.dropdown.open .drop-head{
  border-bottom-color:var(--line);
}
.quick-card .drop-head .qicon{
  width:36px;height:36px;
}
.quick-card .drop-arrow{
  margin-left:auto;
  color:var(--muted);
  transition:transform .25s ease;
}
.quick-card .drop-arrow .icon-svg{width:14px;height:14px}
.quick-card.dropdown.open .drop-arrow{
  transform:rotate(180deg);
  color:var(--brand);
}
.quick-card .drop-body{
  display:none;
  flex-direction:column;
}
.quick-card.dropdown.open .drop-body{
  display:flex;
}
.quick-card .drop-item{
  padding:11px 18px;
  font-size:.82rem;
  font-weight:700;
  color:var(--ink);
  text-decoration:none;
  display:flex;
  align-items:center;
  gap:10px;
  transition:all .15s ease;
  border-top:1px solid var(--line);
}
.quick-card .drop-item:first-child{border-top:none}
.quick-card .drop-item:hover{
  background:var(--brand-light);
  color:var(--brand);
  padding-left:24px;
}
html[data-theme="dark"] .quick-card .drop-item:hover{
  background:rgba(248,111,3,.15);
}
.quick-card .drop-item .bullet{
  width:6px;height:6px;
  border-radius:50%;
  background:var(--brand);
  flex-shrink:0;
}

/* ============ RESPONSIVE ============ */
@media (max-width: 1000px){
  .shell{grid-template-columns:1fr}
  .brand-side{padding:40px 32px;min-height:auto}
  .brand-content{padding:24px 0}
  .brand-content h1{font-size:2.4rem}
  .form-side{padding:40px 32px}
  .quick-links-section{padding:32px 24px 40px}
}
@media (max-width: 600px){
  .brand-side{padding:32px 24px}
  .brand-content h1{font-size:1.8rem}
  .brand-features{display:none}
  .form-side{padding:32px 22px}
  .form-head h2{font-size:1.6rem}
  .quick-links-section{padding:24px 18px 32px}
  .quick-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>

<div class="blob b1"></div>
<div class="blob b2"></div>
<div class="blob b3"></div>

<div class="shell">

  <!-- ============ LEFT: BRAND PANEL ============ -->
  <aside class="brand-side">
    <div class="brand-logo">
      <div class="brand-logo-mark">
        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div class="brand-logo-text">
        <span class="top">EIS Portal</span>
        <span class="sub">Enterprise Integration Services</span>
      </div>
    </div>

    <div class="brand-content">
      <div class="brand-eyebrow">
        <span class="dot"></span>
        Secure Access Terminal
      </div>
      <h1>Your <span class="grad">integration</span> command center.</h1>
      <p>One secure gateway to dashboards, monitoring, reports and operational tools — built for the EIS team to move faster.</p>

      <div class="brand-features">
        <div class="feature">
          <span class="ficon"><svg class="icon-svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
          Single sign-on access across all tools
        </div>
        <div class="feature">
          <span class="ficon"><svg class="icon-svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
          Real-time monitoring dashboards
        </div>
        <div class="feature">
          <span class="ficon"><svg class="icon-svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
          Enterprise-grade security
        </div>
      </div>
    </div>

    <div class="brand-footer">
      <div>© <%= java.time.Year.now() %> EIS Portal · Internal use only</div>
      <div class="status"><span class="dot"></span> All systems operational</div>
    </div>
  </aside>

  <!-- ============ RIGHT: FORM PANEL ============ -->
  <main class="form-side">
    <div class="form-wrap">

      <div class="form-head">
        <div class="step">Authentication Required</div>
        <h2 id="formTitle">Welcome back</h2>
        <p id="formSubtitle">Sign in to continue to your workspace</p>
      </div>

      <div class="tabs">
        <button class="tab active" data-tab="user">
          <svg class="icon-svg" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          User

<script>
/* ============================================================
   THEME TOGGLE
   ============================================================ */
(function initTheme() {
    var html = document.documentElement;
    var btn = document.getElementById('themeToggle');
    var current = html.getAttribute('data-theme') || 'dark';
    btn.textContent = current === 'dark' ? '🌙' : '☀️';

    btn.addEventListener('click', function() {
        var now = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', now);
        try { localStorage.setItem('tx-theme', now); } catch (e) {}
        btn.textContent = now === 'dark' ? '🌙' : '☀️';
        setTimeout(function() { location.reload(); }, 120);
    });
})();

/* ============================================================
   TIME RANGE
   ============================================================ */
document.addEventListener('DOMContentLoaded', function() {
  var currentTime = new Date();
  var tenMinutesAgo = new Date();
  tenMinutesAgo.setMinutes(currentTime.getMinutes() - 10);

  function fmt(d) {
    var h = d.getHours(), m = d.getMinutes();
    return (h < 10 ? '0' + h : h) + ':' + (m < 10 ? '0' + m : m);
  }
  var el = document.getElementById('timeRangeMessage');
  if (el) el.textContent = fmt(tenMinutesAgo) + ' → ' + fmt(currentTime);
});

function myFunction_Time() {
  var demo = document.getElementById("demo");
  if (demo) demo.innerHTML = document.lastModified;
}
</script>

<%
/* ============ BACKEND ============ */
response.setIntHeader("Refresh", 600);

Connection conn = null;
Statement statement = null;
ResultSet resultSet = null;

List<String> labels   = new ArrayList<String>();
List<String> rawNames = new ArrayList<String>();
List<Double> failure  = new ArrayList<Double>();
List<Integer> tdCounts = new ArrayList<Integer>();
List<Integer> totalHits = new ArrayList<Integer>();

try {
    conn = DBUtilityAuto.getIIBDBConnection();

    ZonedDateTime CurrentDate = ZonedDateTime.now(ZoneId.of("Asia/Kolkata"));
    DateTimeFormatter formatter = DateTimeFormatter.ofPattern("MMM_yy").withLocale(Locale.US);
    String PART = CurrentDate.format(formatter).toUpperCase();

    String sql = "Select * from(select txn_endpoint, "
        + "COUNT(1) AS TOTAL_HITS, "
        + "SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END) AS TD_COUNT, "
        + "ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT "
        + "from eisapp.backend_log PARTITION(" + PART + ") where txn_endpoint != 'NATIONAL_PORTAL' and "
        + "REQUEST_DATE_TIME>=SYSDATE - INTERVAL '10' MINUTE "
        + "GROUP BY txn_endpoint "
        + "having ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END)*100)/COUNT(1),2)>= 0.5 "
        + "order by TD_PERCENT desc)where ROWNUM <=12";

    statement = conn.createStatement();
    resultSet = statement.executeQuery(sql);

    while (resultSet.next()) {
        String rawName  = resultSet.getString("txn_endpoint");
        int    tdCount  = resultSet.getInt("TD_COUNT");
        int    totalHit = resultSet.getInt("TOTAL_HITS");
        double pct      = resultSet.getDouble("TD_PERCENT");

        String name = "<p style='color:#ff9933; font-weight: bolder; font-size:20px;'>" + tdCount + "</p>"
            + "<br><p class='tx-ep-label' style='font-weight: bolder; font-size:18px;'>"
            + rawName.replaceAll("_", "</p><br><p class='tx-ep-label' style='font-weight: bolder; font-size:18px;'>")
            + "</p><br>"
            + "<p style='color:#32CD32; font-weight: bolder; font-size:18px;'>" + totalHit + "</p>";

        labels.add(name);
        rawNames.add(rawName);
        failure.add(pct);
        tdCounts.add(tdCount);
        totalHits.add(totalHit);
    }
} catch (Exception e) {
    e.printStackTrace();
} finally {
    try { if (resultSet != null) resultSet.close(); } catch (Exception ignored) {}
    try { if (statement != null) statement.close(); } catch (Exception ignored) {}
    try { if (conn != null) conn.close(); } catch (Exception ignored) {}
}

while (labels.size() < 5) {
    labels.add("&nbsp;");
    rawNames.add("");
    failure.add(0.0);
    tdCounts.add(0);
    totalHits.add(0);
}
%>

<script>
// ============================================================
// Server-side data → JS arrays
// ============================================================
var labelArr = [
<%
for (int k = 0; k < labels.size(); k++) {
    String lbl = labels.get(k).replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "").replace("\r", "");
    out.print("\"" + lbl + "\"");
    if (k < labels.size() - 1) out.print(",");
}
%>
];

var nameArr = [
<%
for (int k = 0; k < rawNames.size(); k++) {
    String n = rawNames.get(k).replace("\\", "\\\\").replace("\"", "\\\"");
    out.print("\"" + n + "\"");
    if (k < rawNames.size() - 1) out.print(",");
}
%>
];

var valueArr = [
<%
for (int k = 0; k < failure.size(); k++) {
    out.print(failure.get(k));
    if (k < failure.size() - 1) out.print(",");
}
%>
];

var tdArr = [
<%
for (int k = 0; k < tdCounts.size(); k++) {
    out.print(tdCounts.get(k));
    if (k < tdCounts.size() - 1) out.print(",");
}
%>
];

var totalArr = [
<%
for (int k = 0; k < totalHits.size(); k++) {
    out.print(totalHits.get(k));
    if (k < totalHits.size() - 1) out.print(",");
}
%>
];

// ============================================================
// THEME DETECTION
// ============================================================
var isDark = (document.documentElement.getAttribute('data-theme') || 'dark') === 'dark';

var chartBg        = isDark ? '#0a0d15' : '#ffffff';
var chartText      = isDark ? '#ffffff' : '#0a0a0a';
var chartMuted     = isDark ? '#8b90b0' : '#6b7280';
var chartGridLine  = isDark ? '#2a2f45' : '#e5e7eb';
var chartTickColor = isDark ? '#1c2030' : '#d1d5db';
var chartBorder    = isDark ? '#1c2030' : '#e5e7eb';

// Fix labelArr — endpoint names theme color
labelArr = labelArr.map(function(lbl) {
    return lbl.replace(/class='tx-ep-label' style='font-weight: bolder; font-size:18px;'/g,
                       "style='color:" + chartText + ";font-weight:bolder;font-size:18px;'");
});

// ============================================================
// ✅ SEVERITY PALETTE — #ff1a1a red / amber / emerald
// ============================================================
var COLOR_LOW      = "#10b981";
var COLOR_MEDIUM   = "#f59e0b";
var COLOR_CRITICAL = "#ff1a1a";   /* ✅ tumhara chuna hua red */

function severityColor(v) {
    if (v > 5) return COLOR_CRITICAL;
    if (v >= 1) return COLOR_MEDIUM;
    return COLOR_LOW;
}

// ============================================================
// KPI compute
// ============================================================
(function computeStats() {
  var total = 0, critical = 0, medium = 0, maxVal = 0;
  for (var i = 0; i < nameArr.length; i++) {
    if (!nameArr[i]) continue;
    total++;
    if (valueArr[i] > 5) critical++;
    else if (valueArr[i] >= 1) medium++;
    if (valueArr[i] > maxVal) maxVal = valueArr[i];
  }
  document.getElementById('statTotal').textContent = total;

  var critEl = document.getElementById('statCritical');
  critEl.textContent = critical;
  if (critical > 0) critEl.classList.add('blink-red');

  document.getElementById('statWarning').textContent = medium;

  var maxEl = document.getElementById('statMax');
  maxEl.textContent = maxVal.toFixed(2) + '%';
  maxEl.className = 'kpi-value ' + (maxVal > 5 ? 'red' : (maxVal >= 1 ? 'orange' : 'green'));
  if (maxVal > 5) maxEl.classList.add('blink-red');
})();

// ============================================================
// Top Critical chips
// ============================================================
(function buildCritBar() {
  var items = [];
  for (var k = 0; k < nameArr.length; k++) {
    if (nameArr[k] && valueArr[k] > 0) {
      items.push({ name: nameArr[k], pct: valueArr[k] });
    }
  }
  items.sort(function(a, b) { return b.pct - a.pct; });
  var top = items.slice(0, 5);
  var bar = document.getElementById('critBar');

  if (!top.length) {
    var empty = document.createElement('span');
    empty.style.cssText = 'color:var(--muted);font-family:Courier New,monospace;font-size:14px;font-weight:700;';
    empty.textContent = 'all clear ✓';
    bar.appendChild(empty);
    return;
  }

  top.forEach(function(it) {
    var chip = document.createElement('div');
    chip.className = 'crit-chip' + (it.pct > 5 ? ' critical' : '');
    chip.innerHTML = '<span class="name" title="' + it.name + '">' + it.name + '</span>'
                   + '<span class="pct">' + it.pct + '%</span>';
    bar.appendChild(chip);
  });
})();

// ============================================================
// Per-bar severity colors
// ============================================================
var barColors = valueArr.map(severityColor);

// ============================================================
// CHART CONFIG
// ============================================================
var chartConfig = {
  type: "bar3d",
  "3dAspect": { depth: 45, true3d: 0, yAngle: 15 },
  backgroundColor: chartBg,
  globals: { fontFamily: "Inter, sans-serif" },
  plotarea: {
    backgroundColor: chartBg,
    margin: "55px 40px 190px 170px"
  },
  scaleX: {
    values: labelArr,
    backgroundColor: chartBg,
    borderColor: chartBorder,
    borderWidth: "1px",
    guide: { visible: false },
    item: { fontColor: chartText, fontSize: 22 },
    tick: { alpha: 0.2, lineColor: chartTickColor },
    label: {
      text: '<p style="color:#ff9933;font-size:20px;font-weight:800;margin:4px 0;">TD</p>'
          + '<p style="color:' + chartText + ';font-size:20px;font-weight:800;margin:4px 0;">ENDPOINT</p>'
          + '<p style="color:#32CD32;font-size:20px;font-weight:800;margin:4px 0;">HITS</p>',
      offsetX: '-90px'
    }
  },
  scaleY: {
    backgroundColor: chartBg,
    borderColor: chartBorder,
    borderWidth: "1px",
    guide: { alpha: 0.25, lineColor: chartGridLine, lineStyle: "solid" },
    item: { fontColor: chartText, paddingRight: "10px", fontSize: 18 },
    tick: { alpha: 0.2, lineColor: chartTickColor },
    label: {
      text: "Failure Percentage",
      color: chartMuted,
      fontSize: "20"
    }
  },
  series: [{
    values: valueArr,
    "value-box": {
      text: "%v%",
      placement: "top",
      "font-color": chartText,
      "font-size": "22px",
      "font-weight": "bold",
      "offset-y": -6,
      rules: [
        { rule: "%v > 5",  "font-color": COLOR_CRITICAL },
        { rule: "%v >= 1", "font-color": COLOR_MEDIUM }
      ]
    },
    tooltip: {
      backgroundColor: isDark ? "#1c2030" : "#ffffff",
      borderColor: isDark ? "#6366f1" : "#e5e7eb",
      borderWidth: 1,
      borderRadius: "6px",
      fontSize: "16px",
      padding: "10px 14px",
      shadow: false,
      fontColor: chartText
    },
    styles: barColors,
    backgroundColor: COLOR_MEDIUM,
    borderColor: chartBorder,
    borderWidth: 1,
    "effects": [
      { "effect": "SHADOW", "offsetX": 4, "offsetY": 4, "blur": 12, "color": "rgba(0,0,0,0.35)" }
    ]
  }]
};

function updateChart(p) {
  var idx = p.nodeindex;
  if (!nameArr[idx]) return;
  var url = '<%=request.getContextPath() + "/jsp/TransactionEndpointWiseService.jsp?txnEndPoint="%>' + encodeURIComponent(nameArr[idx]);
  window.open(url, '_blank');
}

zingchart.render({
  id: 'myChart',
  data: chartConfig,
  height: '100%',
  width: '100%'
});

zingchart.bind('myChart', 'node_click', updateChart);
</script>

<!-- ============ COUNTDOWN ============ -->
<script>
function countdown(elementName, minutes, seconds) {
  var element, endTime;

  function twoDigits(n) {
    return (n <= 9 ? "0" + n : n);
  }

  function updateTimer() {
    var msLeft = endTime - (+new Date);
    if (msLeft < 1000) {
      element.innerHTML = "Refreshing…";
    } else {
      var time = new Date(msLeft);
      var hours = time.getUTCHours();
      var mins = time.getUTCMinutes();
      element.innerHTML = (hours ? hours + ':' + twoDigits(mins) : mins) + ':' + twoDigits(time.getUTCSeconds());
      setTimeout(updateTimer, time.getUTCMilliseconds() + 500);
    }
  }

  element = document.getElementById(elementName);
  endTime = (+new Date) + 1000 * (60 * minutes + seconds) + 500;
  updateTimer();
}

countdown("ten-countdown", 10, 0);
</script>


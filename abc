<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<title>EIS Portal — Home</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="js/jquery.min.js"></script>
<style>
:root{
  --brand:#F86F03;
  --brand-2:#FF9A3D;
  --brand-light:#FFF4EC;
  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F7F7F5;
  --card:#FFFFFF;
  --sidebar-w:260px;
  --topnav-h:64px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  font-family:'Inter',system-ui,sans-serif;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  min-height:100vh;
}
a{color:inherit;text-decoration:none}

.bento-wrap{
  max-width:1400px;
  margin:0 auto;
  padding:32px 28px 60px;
}

/* Hero */
.hero{
  background:linear-gradient(135deg, #1A1A1A 0%, #2A2A2A 100%);
  border-radius:22px;
  padding:44px 40px;
  color:#fff;
  position:relative;
  overflow:hidden;
  margin-bottom:24px;
  display:grid;
  grid-template-columns: 1.5fr 1fr;
  gap:24px;
  align-items:center;
  min-height:220px;
}
.hero::before{
  content:"";position:absolute;
  top:-120px;right:-120px;
  width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle, rgba(248,111,3,.28) 0%, transparent 70%);
}
.hero::after{
  content:"";position:absolute;
  bottom:-140px;left:20%;
  width:280px;height:280px;border-radius:50%;
  background:radial-gradient(circle, rgba(255,154,61,.12) 0%, transparent 70%);
}
.hero-content{position:relative;z-index:2}
.hero-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  padding:6px 12px;
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.12);
  border-radius:999px;
  font-size:.72rem;font-weight:600;
  margin-bottom:18px;
}
.hero-eyebrow .pulse{
  width:6px;height:6px;border-radius:50%;
  background:#4ADE80;
  box-shadow:0 0 8px #4ADE80;
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.hero h1{
  font-size:2.4rem;
  font-weight:800;
  letter-spacing:-1.2px;
  line-height:1.1;
  margin-bottom:12px;
}
.hero h1 .grad{
  background:linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}
.hero p{
  font-size:.95rem;
  line-height:1.6;
  color:rgba(255,255,255,.7);
  max-width:480px;
}
.hero-actions{
  display:flex;gap:12px;margin-top:24px;flex-wrap:wrap;
}
.hero-btn{
  padding:11px 18px;border-radius:11px;
  font-size:.85rem;font-weight:600;
  cursor:pointer;border:none;
  font-family:inherit;
  display:inline-flex;align-items:center;gap:8px;
  transition:all .2s ease;
}
.hero-btn.primary{
  background:var(--brand);color:#fff;
  box-shadow:0 8px 20px -6px rgba(248,111,3,.5);
}
.hero-btn.primary:hover{background:var(--brand-2);transform:translateY(-1px)}
.hero-btn.ghost{
  background:rgba(255,255,255,.08);color:#fff;
  border:1px solid rgba(255,255,255,.12);
}
.hero-btn.ghost:hover{background:rgba(255,255,255,.15)}

.hero-visual{
  position:relative;z-index:2;
  display:flex;
  justify-content:center;
  align-items:center;
}
.hero-visual img{
  max-width:280px;
  width:100%;
  filter:drop-shadow(0 20px 40px rgba(248,111,3,.25));
  animation:float 6s ease-in-out infinite;
}
@keyframes float{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-10px)}
}

/* Stats strip */
.stats{
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:16px;
  margin-bottom:36px;
}
.stat{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  padding:20px;
  display:flex;flex-direction:column;gap:8px;
  transition:all .2s ease;
  position:relative;
  overflow:hidden;
}
.stat::before{
  content:"";position:absolute;top:0;left:0;
  width:3px;height:100%;
  background:var(--brand);
  opacity:0;transition:opacity .2s ease;
}
.stat:hover{
  border-color:var(--brand);
  transform:translateY(-2px);
  box-shadow:0 10px 28px -10px rgba(248,111,3,.18);
}
.stat:hover::before{opacity:1}
.stat .sicon{
  width:36px;height:36px;
  display:grid;place-items:center;
  background:var(--brand-light);
  color:var(--brand);
  border-radius:10px;
  font-size:.85rem;
}
.stat .snum{
  font-size:1.55rem;font-weight:800;
  letter-spacing:-.8px;line-height:1;
}
.stat .slabel{
  font-size:.78rem;color:var(--muted);font-weight:500;
}

/* Section header */
.sec-head{
  display:flex;align-items:center;justify-content:space-between;
  margin:0 0 18px;
}
.sec-head h2{
  font-size:1.1rem;font-weight:700;
  letter-spacing:-.4px;
  display:flex;align-items:center;gap:10px;
}
.sec-head h2 i{color:var(--brand);font-size:.85rem}
.sec-head .hint{
  font-size:.76rem;color:var(--muted);font-weight:500;
}
.sec-head .hint b{color:var(--ink);font-weight:700}

/* Bento grid */
.bento{
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:16px;
  margin-bottom:32px;
}
.bento-item{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:18px;
  padding:22px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  cursor:pointer;
  transition:all .25s ease;
  position:relative;
  overflow:hidden;
  min-height:150px;
}
.bento-item:hover{
  border-color:var(--brand);
  transform:translateY(-3px);
  box-shadow:0 16px 40px -12px rgba(248,111,3,.22);
}
.bento-item:hover .bicon{
  background:var(--brand);
  color:#fff;
  transform:scale(1.08);
}
.bento-item:hover .bgo{opacity:1;color:var(--brand)}
.bhead{
  display:flex;justify-content:space-between;
  align-items:flex-start;
}
.bicon{
  width:42px;height:42px;
  display:grid;place-items:center;
  background:var(--brand-light);
  color:var(--brand);
  border-radius:12px;
  font-size:.95rem;
  transition:all .25s ease;
}
.bgo{
  color:var(--muted);font-size:.75rem;
  opacity:0;transition:opacity .25s ease;
}
.btitle{
  font-size:.95rem;font-weight:700;
  letter-spacing:-.2px;margin-top:16px;line-height:1.3;
}
.bsub{
  font-size:.75rem;color:var(--muted);
  font-weight:500;margin-top:4px;
}

/* Featured large */
.bento-item.lg{
  grid-column:span 2;
  grid-row:span 2;
  padding:28px;
  background:linear-gradient(135deg, #1A1A1A 0%, #2A2A2A 100%);
  color:#fff;
  border-color:transparent;
}
.bento-item.lg::before{
  content:"";position:absolute;
  inset:auto -80px -80px auto;
  width:280px;height:280px;border-radius:50%;
  background:radial-gradient(circle, rgba(248,111,3,.25) 0%, transparent 70%);
}
.bento-item.lg:hover{
  border-color:transparent;
  box-shadow:0 24px 60px -12px rgba(248,111,3,.35);
}
.bento-item.lg .bicon{
  background:rgba(248,111,3,.15);
  color:var(--brand);
  width:52px;height:52px;font-size:1.15rem;
}
.bento-item.lg .btitle{
  font-size:1.35rem;font-weight:800;
  letter-spacing:-.5px;margin-top:auto;
  position:relative;z-index:2;
}
.bento-item.lg .bsub{
  color:rgba(255,255,255,.6);
  font-size:.82rem;margin-top:6px;
  position:relative;z-index:2;
}
.bento-item.lg .bgo{color:rgba(255,255,255,.5)}
.bento-item.lg:hover .bgo{color:var(--brand)}

/* Alert orange */
.bento-item.alert{
  background:linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  color:#fff;border-color:transparent;
}
.bento-item.alert .bicon{
  background:rgba(255,255,255,.2);color:#fff;
}
.bento-item.alert .bsub{color:rgba(255,255,255,.85)}
.bento-item.alert .bgo{color:rgba(255,255,255,.7)}

/* Footer */
.foot{
  margin-top:48px;padding-top:24px;
  border-top:1px solid var(--line);
  display:flex;justify-content:space-between;
  align-items:center;font-size:.8rem;color:var(--muted);
}
.foot .brandline b{color:var(--brand)}

/* Responsive */
@media (max-width:1100px){
  .bento{grid-template-columns:repeat(3, 1fr)}
  .bento-item.lg{grid-column:span 2;grid-row:span 1}
  .stats{grid-template-columns:repeat(2, 1fr)}
}
@media (max-width:800px){
  .hero{grid-template-columns:1fr;padding:32px 28px}
  .hero h1{font-size:1.8rem}
  .hero-visual{display:none}
  .bento{grid-template-columns:repeat(2, 1fr)}
  .bento-item.lg{grid-column:span 2}
}
@media (max-width:520px){
  .bento-wrap{padding:20px 16px 40px}
  .hero h1{font-size:1.5rem}
  .bento{grid-template-columns:1fr}
  .bento-item.lg{grid-column:span 1}
  .stats{grid-template-columns:1fr 1fr}
  .foot{flex-direction:column;gap:8px;text-align:center}
}
</style>
</head>

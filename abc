// ═══════════════════════════════════════════════════════════
// PARTITION HELPER — NOV_26 format
// ═══════════════════════════════════════════════════════════
String getPartition(java.util.Date fromDate) {
    Calendar cal = Calendar.getInstance();
    cal.setTime(fromDate);
    String[] months = {"JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"};
    return months[cal.get(Calendar.MONTH)] + "_" + String.valueOf(cal.get(Calendar.YEAR)).substring(2);
}

String resolvePartition(String fromTime) {
    java.util.Date base;
    try {
        if (fromTime != null && !fromTime.isEmpty()) {
            base = new SimpleDateFormat("yyyy-MM-dd HH:mm").parse(fromTime.replace("T", " "));
        } else {
            base = new java.util.Date(System.currentTimeMillis() - 10*60*1000);
        }
    } catch (Exception e) {
        base = new java.util.Date(System.currentTimeMillis() - 10*60*1000);
    }
    return getPartition(base);
}

// ═══════════════════════════════════════════════════════════
// MASTER TABLE HELPERS
// ═══════════════════════════════════════════════════════════
void ensureTableExists(Connection conn) throws SQLException {
    Statement stmt = null;
    try {
        stmt = conn.createStatement();
        stmt.executeUpdate("CREATE TABLE DPG_IP_MASTER (" +
            "DPG_IP VARCHAR2(50) PRIMARY KEY, DPG_MODE VARCHAR2(10), LAST_UPDATED DATE)");
    } catch (SQLException e) { if (e.getErrorCode() != 955) throw e; }
    finally { if (stmt != null) try { stmt.close(); } catch (SQLException e) {} }
    try {
        stmt = conn.createStatement();
        stmt.executeUpdate("CREATE INDEX IDX_DPG_MASTER_MODE ON DPG_IP_MASTER(DPG_MODE)");
    } catch (SQLException e) { if (e.getErrorCode() != 955) throw e; }
    finally { if (stmt != null) try { stmt.close(); } catch (SQLException e) {} }
}

void refreshMasterTable(Connection connReport, Connection connIIB) throws SQLException {
    List<String> ipList = new ArrayList<>();
    Statement stmtIIB = null; ResultSet rsIIB = null;
    String apiPartition = getPartition(new java.util.Date(System.currentTimeMillis() - 24*60*60*1000));
    try {
        stmtIIB = connIIB.createStatement();
        String q = "SELECT /*+ PARALLEL(4) */ DISTINCT TRIM(DPG_IP) AS IP " +
            "FROM EISAPP.API_LOG PARTITION (" + apiPartition + ") " +
            "WHERE (TRIM(DPG_IP) LIKE '10.191.171.2%' OR TRIM(DPG_IP) LIKE '10.176.0.1%') " +
            "AND request_date_time >= TRUNC(SYSDATE) - 1 AND request_date_time < TRUNC(SYSDATE)";
        rsIIB = stmtIIB.executeQuery(q);
        while (rsIIB.next()) ipList.add(rsIIB.getString("IP"));
    } finally {
        if (rsIIB != null) try { rsIIB.close(); } catch (SQLException e) {}
        if (stmtIIB != null) try { stmtIIB.close(); } catch (SQLException e) {}
    }
    Statement stmtDel = connReport.createStatement();
    stmtDel.executeUpdate("DELETE FROM DPG_IP_MASTER");
    stmtDel.close();
    if (!ipList.isEmpty()) {
        PreparedStatement ps = connReport.prepareStatement(
            "INSERT INTO DPG_IP_MASTER (DPG_IP, DPG_MODE, LAST_UPDATED) VALUES (?, ?, SYSDATE)");
        for (String ip : ipList) {
            ps.setString(1, ip);
            ps.setString(2, ip.contains("171.") ? "PR" : "DR");
            ps.addBatch();
        }
        ps.executeBatch(); ps.close();
    }
}

// ═══════════════════════════════════════════════════════════
// TIME CONDITION — SHARED by API_LOG & BACKEND_LOG
// ═══════════════════════════════════════════════════════════
String buildTimeCondition(String fromTime, String toTime) {
    if (fromTime != null && toTime != null && !fromTime.isEmpty() && !toTime.isEmpty()) {
        String f = fromTime.replace("T", " ").replace("-", "/");
        String t = toTime.replace("T", " ").replace("-", "/");
        return "AND REQUEST_DATE_TIME BETWEEN TO_DATE('" + f + "','YYYY/MM/DD HH24:MI') " +
               "AND TO_DATE('" + t + "','YYYY/MM/DD HH24:MI') ";
    }
    return "AND REQUEST_DATE_TIME >= SYSDATE - INTERVAL '10' MINUTE ";
}

// ═══════════════════════════════════════════════════════════
// PARALLEL TASK 1: INBOUND (API_LOG)
// ═══════════════════════════════════════════════════════════
class InboundResult {
    List<String> ips = new ArrayList<>();
    Map<String, Integer> countMap = new HashMap<>();
    int totalHits = 0, zeroHits = 0, prCount = 0, drCount = 0;
    long elapsedMs = 0;
    String error = null;
    String partition = "";
}

InboundResult fetchInbound(String fromTime, String toTime, String partition) {
    InboundResult res = new InboundResult();
    res.partition = partition;
    long t0 = System.currentTimeMillis();
    Connection cR = null, cI = null;
    try {
        cR = DBUtilityAuto.getReportDBConnection();
        Statement st = cR.createStatement();
        ResultSet rs = st.executeQuery("SELECT DPG_IP FROM DPG_IP_MASTER ORDER BY DPG_IP");
        while (rs.next()) res.ips.add(rs.getString("DPG_IP"));
        rs.close(); st.close();
        cR.close(); cR = null;

        if (res.ips.isEmpty()) {
            res.elapsedMs = System.currentTimeMillis() - t0;
            return res;
        }

        StringBuilder in = new StringBuilder();
        for (int i = 0; i < res.ips.size(); i++) {
            in.append("'").append(res.ips.get(i)).append("'");
            if (i < res.ips.size() - 1) in.append(",");
        }

        cI = DBUtilityAuto.getIIBDBConnection();
        String q = "SELECT /*+ PARALLEL(4) */ TRIM(DPG_IP) AS DPG_IP, COUNT(1) AS TOTAL_HITS " +
            "FROM EISAPP.API_LOG PARTITION (" + partition + ") " +
            "WHERE TRIM(DPG_IP) IN (" + in + ") " + buildTimeCondition(fromTime, toTime) +
            "GROUP BY TRIM(DPG_IP)";
        System.out.println("===== INBOUND =====");
        System.out.println(q);
        PreparedStatement ps = cI.prepareStatement(q);
        ResultSet r2 = ps.executeQuery();
        while (r2.next()) res.countMap.put(r2.getString("DPG_IP"), r2.getInt("TOTAL_HITS"));
        r2.close(); ps.close();

        for (String ip : res.ips) {
            int h = res.countMap.getOrDefault(ip, 0);
            res.countMap.put(ip, h);
            res.totalHits += h;
            if (h == 0) res.zeroHits++;
            if (ip.contains("171.")) res.prCount++;
            else if (ip.contains("176.")) res.drCount++;
        }
    } catch (Exception e) {
        e.printStackTrace();
        res.error = e.getMessage();
    } finally {
        try { if (cR != null) cR.close(); } catch (Exception e) {}
        try { if (cI != null) cI.close(); } catch (Exception e) {}
    }
    res.elapsedMs = System.currentTimeMillis() - t0;
    return res;
}

// ═══════════════════════════════════════════════════════════
// PARALLEL TASK 2: OUTBOUND (BACKEND_LOG port 7443)
// ═══════════════════════════════════════════════════════════
class OutboundResult {
    int hits = 0;
    long elapsedMs = 0;
    String error = null;
    String partition = "";
}

OutboundResult fetchOutbound(String fromTime, String toTime, String partition) {
    OutboundResult res = new OutboundResult();
    res.partition = partition;
    long t0 = System.currentTimeMillis();
    Connection c = null;
    try {
        c = DBUtilityAuto.getIIBDBConnection();
        String q = "SELECT /*+ PARALLEL(4) */ COUNT(*) AS TOTAL_HITS " +
            "FROM EISAPP.BACKEND_LOG PARTITION (" + partition + ") " +
            "WHERE END_POINT_PORT = '7443' " + buildTimeCondition(fromTime, toTime);
        System.out.println("===== OUTBOUND =====");
        System.out.println(q);
        PreparedStatement ps = c.prepareStatement(q);
        ResultSet rs = ps.executeQuery();
        if (rs.next()) res.hits = rs.getInt("TOTAL_HITS");
        rs.close(); ps.close();
    } catch (Exception e) {
        e.printStackTrace();
        res.error = e.getMessage();
    } finally {
        try { if (c != null) c.close(); } catch (Exception e) {}
    }
    res.elapsedMs = System.currentTimeMillis() - t0;
    return res;
}

String maskIp(String ip) {
    if (ip == null || ip.isEmpty()) return "N/A";
    String[] p = ip.split("\\.");
    return (p.length >= 4) ? p[2] + "." + p[3] : ip;
}
String getMode(String ip) {
    if (ip == null) return "UNKNOWN";
    if (ip.contains("171.")) return "PR";
    if (ip.contains("176.")) return "DR";
    return "UNKNOWN";
}

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 20% 0%, rgba(99,102,241,0.15), transparent 55%),
      radial-gradient(ellipse at 80% 100%, rgba(6,182,212,0.10), transparent 55%),
      linear-gradient(180deg, #131a2e 0%, #0f1420 100%);
    color: #e8ecf8;
    font-family: 'Inter', sans-serif;
  }

  .app {
    display: flex;
    flex-direction: column;
    height: 100vh;
    width: 100vw;
  }

  /* ============================================================
     TOP BAR — lighter navy with visible border
     ============================================================ */
  .topbar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
    padding: 12px 22px;
    background: linear-gradient(180deg, #1e2740 0%, #171e32 100%);
    border-bottom: 1px solid #2d3a56;
    flex-shrink: 0;
    box-shadow:
      0 4px 20px rgba(0,0,0,0.4),
      inset 0 1px 0 rgba(255,255,255,0.06);
    position: relative;
    z-index: 5;
  }
  .topbar::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(129,140,248,0.6), transparent);
  }

  /* Timer */
  .timer-block {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .timer-label {
    font-size: 15px;
    font-weight: 700;
    color: #94a3c4;
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.2;
  }
  .timer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 110px;
    padding: 6px 14px;
    border: 3px solid #818cf8;
    border-radius: 8px;
    color: #ffffff;
    font-family: 'Courier New', monospace;
    font-size: 32px;
    font-weight: 900;
    background: linear-gradient(180deg, rgba(129,140,248,0.25), rgba(129,140,248,0.08));
    letter-spacing: 1px;
    line-height: 1;
    box-shadow:
      0 4px 14px rgba(129,140,248,0.4),
      inset 0 1px 0 rgba(255,255,255,0.2),
      inset 0 -2px 0 rgba(0,0,0,0.2);
    text-shadow: 0 1px 3px rgba(0,0,0,0.6);
  }

  /* KPI row */
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    height: 100%;
  }
  .kpi {
    background: linear-gradient(180deg, #232d4a 0%, #1a2338 100%);
    border: 1px solid #2d3a56;
    border-radius: 8px;
    padding: 8px 18px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    box-shadow:
      0 3px 10px rgba(0,0,0,0.3),
      inset 0 1px 0 rgba(255,255,255,0.06);
    transition: transform 0.2s, box-shadow 0.2s;
    position: relative;
    overflow: hidden;
  }
  /* Left accent border per KPI */
  .kpi::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: #6366f1;
  }
  .kpi.red::before    { background: #ef4444; }
  .kpi.orange::before { background: #f59e0b; }

  .kpi:hover {
    transform: translateY(-1px);
    box-shadow:
      0 5px 16px rgba(0,0,0,0.4),
      inset 0 1px 0 rgba(255,255,255,0.1);
  }
  .kpi-label {
    font-size: 11px;
    font-weight: 700;
    color: #94a3c4;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    white-space: nowrap;
    padding-left: 4px;
  }
  .kpi-value {
    font-family: 'Courier New', monospace;
    font-size: 34px;
    font-weight: 900;
    line-height: 1;
    margin-top: 4px;
    color: #ffffff;
    letter-spacing: -1px;
    text-shadow: 0 2px 6px rgba(0,0,0,0.4);
    padding-left: 4px;
  }
  .kpi-value.red    { color: #f87171; text-shadow: 0 0 20px rgba(248,113,113,0.5); }
  .kpi-value.orange { color: #fbbf24; text-shadow: 0 0 20px rgba(251,191,36,0.5); }
  .kpi-value.green  { color: #34d399; text-shadow: 0 0 20px rgba(52,211,153,0.5); }

  /* Right block */
  .right-block {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .sev-chips {
    display: flex;
    gap: 8px;
  }
  .sev-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: linear-gradient(180deg, #232d4a, #1a2338);
    border: 1px solid #2d3a56;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    color: #e8ecf8;
    white-space: nowrap;
    box-shadow:
      0 2px 6px rgba(0,0,0,0.3),
      inset 0 1px 0 rgba(255,255,255,0.06);
  }
  .sev-dot {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    box-shadow: 0 0 8px currentColor;
  }

  .live-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: linear-gradient(180deg, rgba(16,185,129,0.25), rgba(16,185,129,0.08));
    border: 1px solid rgba(16,185,129,0.5);
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    color: #34d399;
    letter-spacing: 1.5px;
    box-shadow:
      0 3px 12px rgba(16,185,129,0.25),
      inset 0 1px 0 rgba(255,255,255,0.15);
  }
  .live-badge .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 12px #34d399;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  /* ============================================================
     TOP CRITICAL BAR — red accent but on lighter navy
     ============================================================ */
  .crit-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 22px;
    background: linear-gradient(180deg, #171e32 0%, #131a2e 100%);
    border-bottom: 1px solid #2d3a56;
    flex-shrink: 0;
    overflow-x: auto;
    box-shadow: inset 0 -1px 0 rgba(0,0,0,0.2);
  }
  .crit-bar::-webkit-scrollbar { height: 4px; }
  .crit-bar::-webkit-scrollbar-thumb { background: #2d3a56; border-radius: 2px; }

  .crit-bar .title {
    font-size: 12px;
    font-weight: 800;
    color: #f87171;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    white-space: nowrap;
    padding-right: 12px;
    border-right: 1px solid #2d3a56;
    flex-shrink: 0;
    text-shadow: 0 0 12px rgba(248,113,113,0.6);
  }

  .crit-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: linear-gradient(180deg, rgba(239,68,68,0.22), rgba(239,68,68,0.08));
    border: 1px solid rgba(239,68,68,0.45);
    border-radius: 8px;
    white-space: nowrap;
    flex-shrink: 0;
    box-shadow:
      0 3px 12px rgba(239,68,68,0.2),
      inset 0 1px 0 rgba(255,255,255,0.1);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .crit-chip:hover {
    transform: translateY(-2px);
    box-shadow:
      0 6px 18px rgba(239,68,68,0.35),
      inset 0 1px 0 rgba(255,255,255,0.15);
  }
  .crit-chip .name {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .crit-chip .pct {
    font-family: 'Courier New', monospace;
    font-size: 20px;
    font-weight: 900;
    color: #f87171;
    text-shadow: 0 0 10px rgba(248,113,113,0.5);
  }

  /* ============================================================
     CHART — lighter navy background, bars pop
     ============================================================ */
  .chart-area {
    flex: 1;
    min-height: 0;
    padding: 10px;
    background: #0f1420;
  }
  #myChart {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(ellipse at 50% 100%, rgba(99,102,241,0.10), transparent 70%),
      linear-gradient(180deg, #1a2338 0%, #141b2d 100%);
    border: 1px solid #2d3a56;
    border-radius: 10px;
    box-shadow:
      0 10px 40px rgba(0,0,0,0.45),
      inset 0 1px 0 rgba(255,255,255,0.05);
    position: relative;
    overflow: hidden;
  }

  /* Responsive */
  @media (max-width: 1280px) {
    .timer-label { font-size: 13px; }
    .timer { font-size: 26px; min-width: 95px; }
    .kpi-value { font-size: 28px; }
    .kpi { padding: 6px 12px; }
    .sev-chip { padding: 4px 8px; font-size: 11px; }
  }
  @media (max-width: 900px) {
    .topbar { grid-template-columns: 1fr 1fr; gap: 10px; }
    .right-block { display: none; }
    .kpi-row { grid-column: span 2; }
  }
</style>

</head>


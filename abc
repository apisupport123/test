<style>
:root{
  --brand:#F86F03;
  --brand-2:#FF9A3D;
  --brand-light:#FFF4EC;
  --brand-glow:rgba(248,111,3,.35);
  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F7F7F5;
  --card:#FFFFFF;
  --hero-dark:#1A1A1A;
  --hero-dark-2:#2A2A2A;
  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --sidebar-w:260px;
  --topnav-h:64px;
}
html[data-theme="dark"]{
  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#272727;
  --bg:#0F0F0F;
  --card:#161616;
  --hero-dark:#0B0B0B;
  --hero-dark-2:#1A1A1A;
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  font-family:var(--font-stack);
  font-weight:700;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  min-height:100vh;
  transition:background .3s ease,color .3s ease;
}
a{color:inherit;text-decoration:none}
h1,h2,h3,h4,h5,h6,strong,b{font-weight:800;letter-spacing:-.3px}

.icon-svg{
  width:16px;height:16px;
  display:inline-block;flex-shrink:0;
  stroke:currentColor;fill:none;
  stroke-width:2.2;
  stroke-linecap:round;stroke-linejoin:round;
}

/* ============ BENTO WRAPPER ============ */
.new-wrapper{
  margin-left:var(--sidebar-w);
  padding-top:var(--topnav-h);
  transition:margin-left .3s cubic-bezier(.4,0,.2,1);
  min-height:100vh;
}
html.sb-collapsed .new-wrapper{
  margin-left:0;
}
.bento-wrap{
  max-width:1400px;
  margin:0 auto;
  padding:32px 28px 60px;
}

/* ============ HERO ============ */
.hero{
  background:linear-gradient(135deg, var(--hero-dark) 0%, var(--hero-dark-2) 100%);
  border-radius:22px;
  padding:44px 40px;
  color:#fff;
  position:relative;
  overflow:hidden;
  margin-bottom:24px;
  display:grid;
  grid-template-columns:1.5fr 1fr;
  gap:24px;
  align-items:center;
  min-height:240px;
  border:1px solid rgba(248,111,3,.08);
}
.hero::before{
  content:"";position:absolute;top:-120px;right:-120px;
  width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle,rgba(248,111,3,.28) 0%,transparent 70%);
}
.hero::after{
  content:"";position:absolute;bottom:-140px;left:20%;
  width:280px;height:280px;border-radius:50%;
  background:radial-gradient(circle,rgba(255,154,61,.14) 0%,transparent 70%);
}
.hero-content{position:relative;z-index:2}
.hero-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  padding:6px 12px;
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.12);
  border-radius:999px;
  font-size:.72rem;font-weight:600;margin-bottom:18px;
  color:#fff;
}
.hero-eyebrow .pulse{
  width:6px;height:6px;border-radius:50%;
  background:#4ADE80;box-shadow:0 0 8px #4ADE80;
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.hero h1{
  font-size:2.5rem;font-weight:800;
  letter-spacing:-1.2px;line-height:1.1;margin-bottom:12px;
  color:#fff;
}
.hero h1 .grad{
  background:linear-gradient(135deg,var(--brand) 0%,var(--brand-2) 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero p{
  font-size:.95rem;line-height:1.6;
  color:rgba(255,255,255,.72);
  max-width:480px;
}
.hero-actions{display:flex;gap:12px;margin-top:24px;flex-wrap:wrap}
.hero-btn{
  padding:11px 18px;border-radius:11px;
  font-size:.85rem;font-weight:600;cursor:pointer;
  border:none;font-family:inherit;
  display:inline-flex;align-items:center;gap:8px;
  transition:all .2s ease;
  text-decoration:none;
}
.hero-btn.primary{
  background:var(--brand);color:#fff;
  box-shadow:0 8px 20px -6px rgba(248,111,3,.5);
}
.hero-btn.primary:hover{background:var(--brand-2);transform:translateY(-1px)}
.hero-btn.ghost{
  background:rgba(255,255,255,.08);color:#fff;
  border:1px solid rgba(255,255,255,.12);
}
.hero-btn.ghost:hover{background:rgba(255,255,255,.15)}
.hero-btn .icon-svg{width:14px;height:14px}

.hero-visual{
  position:relative;z-index:2;
  display:flex;flex-direction:column;gap:14px;
  align-items:flex-end;
}
.hero-mini{
  width:100%;max-width:280px;
  background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.1);
  border-radius:14px;
  padding:14px 16px;
  display:flex;align-items:center;gap:12px;
  backdrop-filter:blur(8px);
}
.hero-mini .mi{
  width:34px;height:34px;border-radius:9px;
  display:grid;place-items:center;
  background:rgba(248,111,3,.2);
  color:var(--brand);
  flex-shrink:0;
}
.hero-mini .mi .icon-svg{width:16px;height:16px}
.hero-mini .mt{
  font-size:.85rem;font-weight:700;color:#fff;line-height:1.2;
}
.hero-mini .ms{
  font-size:.72rem;color:rgba(255,255,255,.6);margin-top:2px;
}
.hero-mini.green .mi{background:rgba(74,222,128,.15);color:#4ADE80}
.hero-mini.green .mt{color:#4ADE80}

/* ============ STATS ============ */
.stats{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:16px;margin-bottom:36px;
}
.stat{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:16px;padding:20px;
  display:flex;flex-direction:column;gap:8px;
  transition:all .2s ease;
  position:relative;overflow:hidden;
}
.stat::before{
  content:"";position:absolute;top:0;left:0;
  width:3px;height:100%;
  background:var(--brand);
  opacity:0;transition:opacity .2s ease;
}
.stat:hover{
  border-color:var(--brand);transform:translateY(-2px);
  box-shadow:0 10px 28px -10px rgba(248,111,3,.18);
}
.stat:hover::before{opacity:1}
.stat .sicon{
  width:36px;height:36px;
  display:grid;place-items:center;
  background:var(--brand-light);
  color:var(--brand);
  border-radius:10px;
}
html[data-theme="dark"] .stat .sicon{
  background:rgba(248,111,3,.15);
}
.stat .sicon .icon-svg{width:16px;height:16px}
.stat .snum{
  font-size:1.55rem;font-weight:800;
  letter-spacing:-.8px;line-height:1;
  color:var(--ink);
}
.stat .slabel{
  font-size:.78rem;color:var(--muted);font-weight:500;
}
.stat .strend{
  position:absolute;top:20px;right:20px;
  font-size:.68rem;font-weight:700;
  padding:3px 8px;border-radius:999px;
  background:rgba(74,222,128,.12);
  color:#16A34A;
}
.stat .strend.warn{background:rgba(248,111,3,.12);color:var(--brand)}

/* ============ SECTION HEADER ============ */
.sec-head{
  display:flex;align-items:center;justify-content:space-between;
  margin:0 0 18px;
}
.sec-head h2{
  font-size:1.1rem;font-weight:700;
  letter-spacing:-.4px;
  display:flex;align-items:center;gap:10px;
  color:var(--ink);
}
.sec-head h2 .icon-svg{color:var(--brand);width:16px;height:16px}
.sec-head .hint{
  font-size:.76rem;color:var(--muted);font-weight:500;
}
.sec-head .hint b{color:var(--ink);font-weight:700}

/* ============ BENTO ============ */
.bento{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
  margin-bottom:32px;
}
.bento-item{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:18px;
  padding:22px;
  display:flex;flex-direction:column;justify-content:space-between;
  cursor:pointer;transition:all .25s ease;
  position:relative;overflow:hidden;
  min-height:160px;
  text-decoration:none;
  color:var(--ink);
}
.bento-item:hover{
  border-color:var(--brand);transform:translateY(-3px);
  box-shadow:0 16px 40px -12px rgba(248,111,3,.22);
}
.bento-item:hover .bicon{
  background:var(--brand);color:#fff;transform:scale(1.08);
}
.bento-item:hover .bgo{opacity:1;color:var(--brand)}
.bhead{
  display:flex;justify-content:space-between;align-items:flex-start;
  gap:10px;
}
.bicon{
  width:44px;height:44px;
  display:grid;place-items:center;
  background:var(--brand-light);
  color:var(--brand);border-radius:12px;
  transition:all .25s ease;flex-shrink:0;
}
html[data-theme="dark"] .bicon{
  background:rgba(248,111,3,.15);
}
.bicon .icon-svg{width:18px;height:18px}
.bgo{
  color:var(--muted);
  opacity:0;transition:opacity .25s ease;
}
.bgo .icon-svg{width:14px;height:14px}
.btitle{
  font-size:.98rem;font-weight:700;
  letter-spacing:-.2px;margin-top:18px;line-height:1.3;
  color:var(--ink);
}
.bsub{
  font-size:.76rem;color:var(--muted);
  font-weight:500;margin-top:5px;
}
.btags{
  display:flex;gap:6px;flex-wrap:wrap;margin-top:12px;
}
.btag{
  font-size:.65rem;font-weight:700;
  padding:3px 8px;border-radius:999px;
  background:var(--brand-light);
  color:var(--brand);
  text-transform:uppercase;letter-spacing:.3px;
}
html[data-theme="dark"] .btag{
  background:rgba(248,111,3,.15);
}
.btag.gray{
  background:var(--sidebar-hover,#F5F5F4);
  color:var(--muted);
}
html[data-theme="dark"] .btag.gray{
  background:#222;color:#9CA3AF;
}

/* Featured large */
.bento-item.lg{
  grid-column:span 2;grid-row:span 2;
  padding:30px;
  background:linear-gradient(135deg,var(--hero-dark) 0%,var(--hero-dark-2) 100%);
  color:#fff;border-color:transparent;
}
.bento-item.lg::before{
  content:"";position:absolute;inset:auto -80px -80px auto;
  width:300px;height:300px;border-radius:50%;
  background:radial-gradient(circle,rgba(248,111,3,.25) 0%,transparent 70%);
}
.bento-item.lg:hover{
  border-color:transparent;
  box-shadow:0 24px 60px -12px rgba(248,111,3,.35);
}
.bento-item.lg .bicon{
  background:rgba(248,111,3,.15);color:var(--brand);
  width:54px;height:54px;
}
.bento-item.lg .bicon .icon-svg{width:22px;height:22px}
.bento-item.lg .btitle{
  font-size:1.4rem;font-weight:800;
  letter-spacing:-.5px;margin-top:auto;
  position:relative;z-index:2;
  color:#fff;
}
.bento-item.lg .bsub{
  color:rgba(255,255,255,.65);
  font-size:.85rem;margin-top:8px;
  position:relative;z-index:2;
}
.bento-item.lg .bgo{color:rgba(255,255,255,.5)}
.bento-item.lg:hover .bgo{color:var(--brand)}
.bento-item.lg .btag{
  background:rgba(255,255,255,.1);
  color:#fff;
}

/* Alert orange */
.bento-item.alert{
  background:linear-gradient(135deg,var(--brand) 0%,var(--brand-2) 100%);
  color:#fff;border-color:transparent;
}
.bento-item.alert .bicon{
  background:rgba(255,255,255,.2);color:#fff;
}
.bento-item.alert .bsub{color:rgba(255,255,255,.9)}
.bento-item.alert .bgo{color:rgba(255,255,255,.7)}
.bento-item.alert .btag{
  background:rgba(255,255,255,.2);color:#fff;
}

/* Medium wide */
.bento-item.md{
  grid-column:span 2;
}

/* ============ FOOTER ============ */
.foot{
  margin-top:48px;padding-top:24px;
  border-top:1px solid var(--line);
  display:flex;justify-content:space-between;align-items:center;
  font-size:.8rem;color:var(--muted);
}
.foot .brandline b{color:var(--brand)}

/* ============ RESPONSIVE ============ */
@media (max-width:1100px){
  .bento{grid-template-columns:repeat(3,1fr)}
  .bento-item.lg{grid-column:span 2;grid-row:span 1}
  .bento-item.md{grid-column:span 2}
  .stats{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:800px){
  .new-wrapper{margin-left:0}
  .hero{grid-template-columns:1fr;padding:32px 28px}
  .hero h1{font-size:1.8rem}
  .hero-visual{display:none}
  .bento{grid-template-columns:repeat(2,1fr)}
  .bento-item.lg{grid-column:span 2}
  .bento-item.md{grid-column:span 2}
}
@media (max-width:520px){
  .bento-wrap{padding:20px 16px 40px}
  .hero h1{font-size:1.5rem}
  .bento{grid-template-columns:1fr}
  .bento-item.lg,.bento-item.md{grid-column:span 1}
  .stats{grid-template-columns:1fr 1fr}
  .foot{flex-direction:column;gap:8px;text-align:center}
}
</style>

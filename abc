            // ============================================================
            System.out.println("[DUAL CHECK] === ACTION fields ===");
            System.out.println("[DUAL CHECK] this.photoFile = " + this.getM_strthePhotofile());
            System.out.println("[DUAL CHECK] this.photoName = " + this.getM_strthePhotofileFileName());
            System.out.println("[DUAL CHECK] this.bgcFile   = " + this.getM_strtheBgcfile());
            System.out.println("[DUAL CHECK] this.bgcName   = " + this.getM_strtheBgcfileFileName());
            System.out.println("[DUAL CHECK] === FORM fields ===");

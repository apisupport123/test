    </div>
    <div class="stat-card">
        <div class="stat-icon orange"><i class="fas fa-chart-line"></i></div>
        <div class="stat-info">
            <h2 id="uptimePercent">0%</h2>
            <p>Uptime Rate</p>
        </div>
    </div>
</div>

<!-- MAIN -->
<div class="main-content" id="mainGrid" style="display:none;">

    <!-- SOURCES -->
    <div class="sources-panel">
        <div class="panel-header">
            <h2><i class="fas fa-microchip"></i> SOURCES <span class="count-badge" id="sourceCount">0/20</span></h2>
            <div class="legend">
                <span><span class="on">⬤</span> ACTIVE</span>
                <span><span class="off">⬤</span> OFFLINE</span>
            </div>
        </div>
        <div class="sources-grid" id="sourcesGrid"></div>
    </div>

    <!-- ACTIVITY -->
    <div class="activity-panel">
        <div class="panel-header">
            <h2><i class="fas fa-wave-square" style="color:var(--cyber-green);"></i> ACTIVITY LOG</h2>
            <span style="font-size:0.4rem;color:var(--text-dim);font-family:'Orbitron',monospace;letter-spacing:1px;">LIVE</span>
        </div>
        <div class="activity-list" id="activityList">
            <div class="activity-empty"><i class="fas fa-inbox"></i> waiting for signal...</div>
        </div>
    </div>

</div>

<!-- ERROR BANNER -->
<div class="error-banner" id="errorBanner">
    <i class="fas fa-exclamation-triangle"></i> <span id="errorMessage">Connection Error</span>
</div>

<script>
    var sourceData = {};
    var activityLog = [];
    var MAX_ACTIVITY = 30;
    var timerSeconds = 600;
    var timerInterval;
    var retryCount = 0;
    var maxRetries = 3;

    function getPartition() {
        var months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
        var now = new Date();
        return months[now.getMonth()] + '_' + String(now.getFullYear()).slice(-2);
    }

    function formatTime(s) {
        var m = Math.floor(s / 60);
        var sec = s % 60;
        return String(m).padStart(2,'0') + ':' + String(sec).padStart(2,'0');
    }

    function updateTimer() {
        timerSeconds--;
        document.getElementById('timerDisplay').textContent = formatTime(timerSeconds);
        if (timerSeconds <= 0) {
            location.reload();
        }
    }

    function addActivity(source, status) {
        var now = new Date();
        var t = now.getHours().toString().padStart(2,'0') + ':' + 
                now.getMinutes().toString().padStart(2,'0') + ':' + 
                now.getSeconds().toString().padStart(2,'0');
        activityLog.unshift({ time: t, source: source, status: status });
        if (activityLog.length > MAX_ACTIVITY) activityLog.pop();
        renderActivity();
    }

    function renderActivity() {
        var c = document.getElementById('activityList');
        if (activityLog.length === 0) {
            c.innerHTML = '<div class="activity-empty"><i class="fas fa-inbox"></i> waiting for signal...</div>';
            return;
        }
        var html = '';
        for (var i = 0; i < Math.min(activityLog.length, 20); i++) {
            var item = activityLog[i];
            var cls = item.status === 'Y' ? 'on' : 'off';
            var txt = item.status === 'Y' ? 'ON' : 'OFF';
            html += '<div class="activity-item ' + cls + '">' +
                '<span class="activity-time">' + item.time + '</span>' +
                '<span class="activity-source">' + item.source + '</span>' +
                '<span class="activity-status ' + cls + '">' + txt + '</span>' +
                '</div>';
        }
        c.innerHTML = html;
    }

    function hideLoading() {
        var overlay = document.getElementById('loadingOverlay');
        overlay.classList.add('hide');
        document.getElementById('liveBadge').style.display = 'flex';
        document.getElementById('timerBadge').style.display = 'flex';
        document.getElementById('statsRow').style.display = 'grid';
        document.getElementById('mainGrid').style.display = 'grid';
        document.getElementById('partitionBadge').textContent = '📡 ' + getPartition();
        document.getElementById('timerDisplay').textContent = formatTime(timerSeconds);
        timerInterval = setInterval(updateTimer, 1000);
    }

    function showError(msg) {
        var banner = document.getElementById('errorBanner');
        document.getElementById('errorMessage').textContent = msg || 'Connection Error - Retrying...';
        banner.classList.add('show');
        
        setTimeout(function() {
            banner.classList.remove('show');
        }, 5000);
    }

    // 🔥 FIXED: Using RELATIVE URL - No HTTP/HTTPS issue
    function fetchData() {
        // ✅ Using relative URL - automatically uses same protocol
        var url = '?action=fetchSourceStatus';
        
        console.log('Fetching: ' + url);
        
        fetch(url, {
            method: 'GET',
            cache: 'no-cache',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(function(response) {
            if (!response.ok) {
                throw new Error('HTTP ' + response.status + ': ' + response.statusText);
            }
            return response.json();
        })
        .then(function(data) {
            retryCount = 0;
            if (data.error) {
                showError('DB Error: ' + data.error);
                return;
            }
            renderSources(data);
            updateStats(data);
            updateActivity(data);
            hideLoading();
        })
        .catch(function(e) {
            console.error('Fetch Error:', e);
            retryCount++;
            
            if (retryCount <= maxRetries) {
                showError('Connection failed (Attempt ' + retryCount + '/' + maxRetries + ') - Retrying...');
                setTimeout(function() {
                    fetchData();
                }, 3000);
            } else {
                showError('Connection Error - Please refresh the page');
                hideLoading();
                document.getElementById('sourcesGrid').innerHTML = 
                    '<div style="text-align:center;padding:40px;color:var(--text-dim);grid-column:1/-1;">' +
                    '<i class="fas fa-exclamation-triangle" style="font-size:2rem;display:block;margin-bottom:8px;color:var(--cyber-red);"></i>' +
                    '<p style="font-weight:700;font-size:0.9rem;font-family:\'Orbitron\',monospace;letter-spacing:2px;">CONNECTION LOST</p>' +
                    '<p style="font-size:0.6rem;margin-top:2px;color:var(--text-dim);">Please refresh the page</p>' +
                    '<button onclick="location.reload()" style="margin-top:12px;padding:8px 24px;background:var(--cyber-blue);border:none;border-radius:6px;color:#000;font-weight:700;cursor:pointer;font-family:\'Orbitron\',monospace;font-size:0.6rem;">REFRESH</button>' +
                    '</div>';
            }
        });
    }

    function renderSources(data) {
        var c = document.getElementById('sourcesGrid');
        if (!data || data.length === 0) {
            c.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text-dim);grid-column:1/-1;"><i class="fas fa-database" style="font-size:2rem;display:block;margin-bottom:8px;opacity:0.3;"></i><p style="font-family:\'Orbitron\',monospace;font-size:0.6rem;letter-spacing:2px;">NO DATA</p></div>';
            return;
        }
        var html = '', active = 0;
        for (var i = 0; i < data.length; i++) {
            var item = data[i];
            var isActive = item.flag === 'Y';
            if (isActive) active++;
            var cls = isActive ? 'active' : 'inactive';
            var status = isActive ? 'ONLINE' : 'OFFLINE';
            var hits = isActive ? Math.floor(Math.random() * 50 + 10) : 0;
            
            html += '<div class="source-card ' + cls + '">' +
                '<span class="status-indicator"></span>' +
                '<div class="source-id">' + item.source_id + '</div>' +
                '<div class="source-status">' + status + '</div>' +
                '<span class="source-hits">' + (isActive ? '⚡ ' + hits : '⏸') + '</span>' +
                '</div>';
        }
        c.innerHTML = html;
        document.getElementById('sourceCount').textContent = active + '/' + data.length;
    }

    function updateStats(data) {
        var active = 0, inactive = 0;
        for (var i = 0; i < data.length; i++) {
            if (data[i].flag === 'Y') active++; else inactive++;
        }
        document.getElementById('activeCount').textContent = active;
        document.getElementById('inactiveCount').textContent = inactive;
        document.getElementById('totalSources').textContent = data.length;
        var uptime = data.length > 0 ? Math.round((active / data.length) * 100) : 0;
        document.getElementById('uptimePercent').textContent = uptime + '%';
    }

    function updateActivity(data) {
        var current = {};
        for (var i = 0; i < data.length; i++) {
            if (data[i].flag === 'Y') current[data[i].source_id] = true;
        }
        for (var s in current) {
            if (!sourceData[s]) { addActivity(s, 'Y'); }
            else if (sourceData[s] !== current[s]) { addActivity(s, current[s] ? 'Y' : 'N'); }
        }
        for (var old in sourceData) {
            if (sourceData[old] && !current[old]) { addActivity(old, 'N'); }
        }
        sourceData = current;
    }

    window.addEventListener('beforeunload', function() {
        if (timerInterval) clearInterval(timerInterval);
    });

    // 🔥 Start
    fetchData();
</script>
</body>
</html>

<%--
  EIS Portal — Admin Header + Dashboard (header.jsp)
  🛡️ Admin Premium UI
  ✅ Same UI family as userheader/bankheader
  ✅ Logout fixed
  ✅ Session timeout 12 hours (already in web.xml)
--%>
<%
 // ✅ Cache headers
 response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate, max-age=0, private");
 response.setHeader("Pragma", "no-cache");
 response.setDateHeader("Expires", 0);
%>
<%@page pageEncoding="UTF-8"%>

<script src="<%=request.getContextPath()%>/js/jquery.min.js"></script>

<style>
:root{
  /* Admin Brand Colors */
  --admin-primary:#7C3AED;
  --admin-primary-2:#8B5CF6;
  --admin-primary-light:#F3E8FF;
  --admin-accent:#EC4899;
  --admin-accent-2:#F472B6;

  --brand:#F86F03;
  --brand-light:#FFF4EC;

  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F5F7FA;
  --card:#FFFFFF;

  --sidebar-bg:#1A0B2E;
  --sidebar-text:#C4B5FD;
  --sidebar-hover:#2D1854;
  --sidebar-active:#7C3AED;

  --topnav-bg:rgba(255,255,255,.95);
  --topnav-h:64px;
  --sidebar-w:260px;

  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
html[data-theme="dark"]{
  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#272727;
  --bg:#0A0614;
  --card:#130A24;
  --topnav-bg:rgba(15,6,32,.95);
  --sidebar-bg:#0F0422;
  --sidebar-hover:#1F0E3D;
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--font-stack);
  font-weight:700;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  transition:background .3s ease,color .3s ease;
}
a{color:inherit;text-decoration:none}
h1,h2,h3,h4,h5,h6,strong,b{font-weight:800;letter-spacing:-.3px}

.icon-svg{
  width:16px;height:16px;
  display:inline-block;flex-shrink:0;
  stroke:currentColor;fill:none;
  stroke-width:2.2;
  stroke-linecap:round;stroke-linejoin:round;
}

/* ============ SIDEBAR ============ */
.sidebar{
  position:fixed;top:0;left:0;bottom:0;
  width:var(--sidebar-w);
  background:linear-gradient(180deg, var(--sidebar-bg) 0%, #0F0422 100%);
  border-right:1px solid rgba(255,255,255,.05);
  z-index:60;
  display:flex;flex-direction:column;
  transition:transform .3s cubic-bezier(.4,0,.2,1);
}
html.sb-collapsed .sidebar{transform:translateX(-100%)}
html.sb-collapsed .topnav{left:0}
html.sb-collapsed .new-wrapper{margin-left:0}

.sb-head{
  padding:18px 16px 18px 20px;
  height:var(--topnav-h);
  display:flex;align-items:center;gap:11px;
  border-bottom:1px solid rgba(255,255,255,.08);
  flex-shrink:0;
}
.sb-logo{
  width:38px;height:38px;
  background:linear-gradient(135deg,var(--admin-primary),var(--admin-accent));
  border-radius:10px;
  display:grid;place-items:center;color:#fff;
  box-shadow:0 8px 20px -6px var(--admin-primary);
  flex-shrink:0;
}
.sb-logo .icon-svg{width:20px;height:20px;stroke-width:2.6}
.sb-title{
  font-weight:900;font-size:.95rem;
  letter-spacing:-.3px;line-height:1.1;
  flex:1;min-width:0;color:#fff;
  text-transform:uppercase;
}
.sb-title small{
  display:block;font-size:.65rem;font-weight:700;
  color:var(--admin-primary-2);letter-spacing:.8px;text-transform:uppercase;margin-top:2px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.sb-collapse-btn{
  width:28px;height:28px;
  display:grid;place-items:center;
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.1);
  border-radius:7px;
  color:var(--sidebar-text);
  cursor:pointer;
  transition:all .15s ease;
  flex-shrink:0;
}
.sb-collapse-btn .icon-svg{width:14px;height:14px}
.sb-collapse-btn:hover{
  background:var(--admin-primary);border-color:var(--admin-primary);color:#fff;
}

/* HOME BUTTON */
.sb-home-btn{
  display:flex;align-items:center;gap:10px;
  margin:14px 12px 4px 12px;
  padding:12px 14px;
  background:linear-gradient(135deg,var(--admin-primary),var(--admin-accent));
  color:#fff;
  border-radius:10px;
  font-weight:900;font-size:.85rem;
  text-decoration:none;
  transition:all .2s ease;
  box-shadow:0 6px 20px -6px var(--admin-primary);
  flex-shrink:0;text-transform:uppercase;letter-spacing:.5px;
}
.sb-home-btn:hover{transform:translateY(-1px);box-shadow:0 10px 28px -6px var(--admin-primary)}
.sb-home-btn .icon-svg{width:16px;height:16px;stroke-width:2.6}

.sb-search{padding:8px 16px 8px;flex-shrink:0}
.sb-search-box{position:relative;display:flex;align-items:center}
.sb-search-box .icon-svg{
  position:absolute;left:12px;color:var(--sidebar-text);
  width:14px;height:14px;pointer-events:none;
}
.sb-search-box input{
  width:100%;padding:10px 12px 10px 36px;
  background:rgba(0,0,0,.25);
  border:1px solid rgba(255,255,255,.08);
  border-radius:9px;
  color:#fff;font-family:inherit;font-size:.82rem;font-weight:700;outline:none;
  transition:all .2s ease;
}
.sb-search-box input::placeholder{color:var(--sidebar-text);opacity:.6;font-weight:600}
.sb-search-box input:focus{
  background:rgba(0,0,0,.35);
  border-color:var(--admin-primary);
  box-shadow:0 0 0 3px rgba(124,58,237,.2);
}

.sb-body{flex:1;overflow-y:auto;padding:8px 12px 20px;}
.sb-body::-webkit-scrollbar{width:6px}
.sb-body::-webkit-scrollbar-thumb{background:rgba(255,255,255,.1);border-radius:3px}

.sb-group{
  padding:14px 10px 6px;
  font-size:.65rem;font-weight:800;
  color:var(--sidebar-text);opacity:.6;
  letter-spacing:1.2px;text-transform:uppercase;
}
.sb-item{
  display:flex;align-items:center;gap:11px;
  padding:10px 11px;border-radius:8px;
  font-size:.82rem;font-weight:700;
  color:var(--sidebar-text);text-decoration:none;
  transition:all .15s ease;cursor:pointer;line-height:1.35;
}
.sb-item:hover{background:var(--sidebar-hover);color:#fff;}
.sb-item .sb-icon{
  width:26px;height:26px;
  display:grid;place-items:center;
  background:rgba(255,255,255,.06);
  border-radius:7px;
  color:var(--sidebar-text);flex-shrink:0;
  transition:all .15s ease;
}
.sb-item .sb-icon .icon-svg{width:14px;height:14px;stroke-width:2.4}
.sb-item:hover .sb-icon{
  background:rgba(124,58,237,.25);color:var(--admin-primary-2);
}
.sb-item.sb-active{
  background:rgba(124,58,237,.2);color:#fff;font-weight:800;
}
.sb-item.sb-active .sb-icon{background:var(--admin-primary);color:#fff}
.sb-item.sb-logout{color:#FF8A8A;margin-top:6px;}
.sb-item.sb-logout .sb-icon{background:rgba(229,57,53,.15);color:#FF8A8A}
.sb-item.sb-logout:hover{background:rgba(229,57,53,.2);color:#FFB0B0}
.sb-item.sb-logout:hover .sb-icon{background:#E53935;color:#fff}

/* ============ TOPNAV ============ */
.topnav{
  position:fixed;top:0;left:var(--sidebar-w);right:0;
  height:var(--topnav-h);
  background:var(--topnav-bg);
  backdrop-filter:blur(14px) saturate(180%);
  -webkit-backdrop-filter:blur(14px) saturate(180%);
  border-bottom:1px solid var(--line);
  z-index:50;
  display:flex;align-items:center;padding:0 24px;gap:16px;
  transition:left .3s cubic-bezier(.4,0,.2,1);
}
.tn-toggle{
  display:none;width:36px;height:36px;
  background:transparent;border:1px solid var(--line);
  border-radius:9px;color:var(--ink);cursor:pointer;
  place-items:center;
}
.tn-toggle .icon-svg{width:16px;height:16px}
.tn-menu-btn{
  display:grid;place-items:center;
  width:36px;height:36px;
  background:var(--bg);
  border:1px solid var(--line);
  border-radius:9px;color:var(--ink);
  cursor:pointer;transition:all .15s ease;
}
.tn-menu-btn .icon-svg{width:16px;height:16px;stroke-width:2.4}
.tn-menu-btn:hover{background:var(--admin-primary);border-color:var(--admin-primary);color:#fff}
.tn-brand{
  display:flex;align-items:center;gap:8px;
  font-size:.9rem;font-weight:900;
  color:var(--admin-primary);letter-spacing:-.3px;
}
html[data-theme="dark"] .tn-brand{color:#F5F5F5}
.tn-brand .brand-badge{
  background:linear-gradient(135deg,var(--admin-primary),var(--admin-accent));
  color:#fff;font-size:.6rem;font-weight:800;
  padding:3px 9px;border-radius:999px;
  text-transform:uppercase;letter-spacing:.6px;
}
.tn-right{margin-left:auto;display:flex;align-items:center;gap:10px}

.tn-bell{position:relative;}
.tn-bell .badge-count{
  position:absolute;top:-4px;right:-4px;
  width:18px;height:18px;
  background:#E53935;color:#fff;
  font-size:.6rem;font-weight:900;
  border-radius:50%;
  display:grid;place-items:center;
  border:2px solid var(--topnav-bg);
}

.tn-btn{
  width:36px;height:36px;
  display:grid;place-items:center;
  background:transparent;border:1px solid var(--line);
  border-radius:9px;color:var(--ink);
  cursor:pointer;transition:all .15s ease;text-decoration:none;
}
.tn-btn .icon-svg{width:16px;height:16px}
.tn-btn:hover{background:var(--admin-primary);border-color:var(--admin-primary);color:#fff}
.tn-btn:hover .badge-count{border-color:var(--admin-primary)}
.tn-avatar{
  width:38px;height:38px;border-radius:50%;
  background:linear-gradient(135deg,var(--admin-primary),var(--admin-accent));
  display:grid;place-items:center;color:#fff;
  font-weight:900;font-size:.85rem;cursor:pointer;
  border:2px solid var(--admin-accent-2);
  box-shadow:0 4px 12px rgba(124,58,237,.2);
}

.new-wrapper{
  margin-left:var(--sidebar-w);
  padding-top:var(--topnav-h);
  transition:margin-left .3s cubic-bezier(.4,0,.2,1);
  min-height:100vh;
}
html.sb-collapsed .new-wrapper{margin-left:0}

.sb-overlay{
  position:fixed;inset:0;
  background:rgba(0,0,0,.4);
  backdrop-filter:blur(2px);
  z-index:55;opacity:0;pointer-events:none;
  transition:opacity .25s ease;
}
html.sb-open .sb-overlay{opacity:1;pointer-events:auto}

/* ============ ADMIN DASHBOARD ============ */
.admin-dash{
  padding:28px 32px 60px;
  max-width:1500px;
  margin:0 auto;
}

.admin-hero{
  background:
    radial-gradient(circle at top right, rgba(236,72,153,.3), transparent 60%),
    radial-gradient(circle at bottom left, rgba(124,58,237,.4), transparent 60%),
    linear-gradient(135deg, #1A0B2E 0%, #2D1854 100%);
  border-radius:20px;
  padding:36px 40px;
  color:#fff;
  position:relative;overflow:hidden;
  margin-bottom:24px;
  border:1px solid rgba(124,58,237,.3);
}
.admin-hero::before{
  content:"";position:absolute;top:-100px;right:-100px;
  width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle, rgba(124,58,237,.4) 0%, transparent 70%);
}
.admin-hero-inner{
  position:relative;z-index:2;
  display:flex;justify-content:space-between;align-items:center;
  gap:24px;flex-wrap:wrap;
}
.admin-hero-text .badge-line{
  display:inline-flex;align-items:center;gap:8px;
  padding:6px 14px;
  background:rgba(236,72,153,.2);
  border:1px solid rgba(236,72,153,.4);
  border-radius:999px;
  font-size:.7rem;font-weight:800;
  color:var(--admin-accent-2);letter-spacing:1px;
  text-transform:uppercase;margin-bottom:16px;
}
.admin-hero-text .badge-line .dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--admin-accent-2);
  box-shadow:0 0 8px var(--admin-accent-2);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.admin-hero-text h1{
  font-size:2.2rem;font-weight:900;
  letter-spacing:-1px;line-height:1.15;margin-bottom:12px;
}
.admin-hero-text h1 .gradient{
  background:linear-gradient(135deg,var(--admin-primary-2),var(--admin-accent-2));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.admin-hero-text p{
  font-size:.92rem;color:rgba(255,255,255,.75);
  font-weight:600;max-width:480px;line-height:1.6;
}
.admin-hero-visual{display:flex;gap:14px;flex-wrap:wrap;}
.hero-stat{
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.15);
  border-radius:14px;
  padding:16px 20px;min-width:120px;
  backdrop-filter:blur(8px);
}
.hero-stat .hs-icon{
  width:32px;height:32px;border-radius:9px;
  background:rgba(124,58,237,.3);color:#fff;
  display:grid;place-items:center;margin-bottom:10px;
}
.hero-stat .hs-icon .icon-svg{width:16px;height:16px}
.hero-stat .hs-num{
  font-size:1.4rem;font-weight:900;
  color:#fff;letter-spacing:-.5px;line-height:1;
}
.hero-stat .hs-lbl{
  font-size:.65rem;font-weight:700;
  color:rgba(255,255,255,.6);
  text-transform:uppercase;letter-spacing:.5px;
  margin-top:4px;
}

.news-ticker{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:14px;
  padding:12px 20px;
  margin-bottom:24px;
  display:flex;align-items:center;gap:16px;
  overflow:hidden;position:relative;
}
.news-ticker .nt-label{
  display:flex;align-items:center;gap:8px;
  color:var(--admin-primary);
  font-size:.72rem;font-weight:900;
  text-transform:uppercase;letter-spacing:1px;
  flex-shrink:0;padding-right:16px;
  border-right:1px solid var(--line);
}
html[data-theme="dark"] .news-ticker .nt-label{color:var(--admin-primary-2)}
.news-ticker .nt-label .dot{
  width:8px;height:8px;border-radius:50%;
  background:#10B981;
  animation:pulse 1.5s ease-in-out infinite;
  box-shadow:0 0 8px #10B981;
}
.news-ticker .nt-scroll{
  flex:1;overflow:hidden;white-space:nowrap;
}
.news-ticker .nt-text{
  display:inline-block;
  animation:scroll 40s linear infinite;
  font-size:.78rem;font-weight:700;
  color:var(--ink);
}
.news-ticker .nt-text span{
  margin-right:48px;
  display:inline-flex;align-items:center;gap:8px;
}
.news-ticker .nt-text span::before{
  content:"●";color:var(--admin-primary);font-size:.6rem;
}
@keyframes scroll{
  from{transform:translateX(100%);}
  to{transform:translateX(-100%);}
}

.section-title{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:16px;
}
.section-title h2{
  font-size:1rem;font-weight:900;color:var(--ink);
  text-transform:uppercase;letter-spacing:.8px;
  display:flex;align-items:center;gap:10px;
}
.section-title h2 .icon-svg{color:var(--admin-primary);width:18px;height:18px}
html[data-theme="dark"] .section-title h2 .icon-svg{color:var(--admin-primary-2)}

.quick-actions{
  display:grid;grid-template-columns:repeat(4, 1fr);
  gap:16px;margin-bottom:28px;
}
.qa-card{
  background:var(--card);
  border:1.5px solid var(--line);
  border-radius:16px;
  padding:22px 20px;
  display:flex;flex-direction:column;gap:12px;
  transition:all .25s ease;cursor:pointer;
  position:relative;overflow:hidden;
}
.qa-card:hover{
  border-color:var(--admin-primary);
  transform:translateY(-4px);
  box-shadow:0 16px 40px -12px rgba(124,58,237,.35);
}
.qa-card:hover .qa-icon{
  background:var(--admin-primary);color:#fff;transform:scale(1.08);
}
.qa-card:hover .qa-arrow{
  opacity:1;transform:translateX(4px);color:var(--admin-primary);
}
.qa-icon{
  width:48px;height:48px;border-radius:14px;
  background:var(--admin-primary-light);color:var(--admin-primary);
  display:grid;place-items:center;transition:all .25s ease;
}
html[data-theme="dark"] .qa-icon{
  background:rgba(124,58,237,.2);color:var(--admin-primary-2);
}
.qa-icon .icon-svg{width:22px;height:22px;stroke-width:2.2}
.qa-title{
  font-size:.92rem;font-weight:800;color:var(--ink);
  display:flex;align-items:center;gap:6px;
}
.qa-arrow{
  opacity:0;transition:all .2s ease;color:var(--muted);
}
.qa-arrow .icon-svg{width:14px;height:14px}
.qa-desc{
  font-size:.72rem;color:var(--muted);font-weight:600;line-height:1.4;
}

.services-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));
  gap:14px;margin-bottom:32px;
}
.service-card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:14px;
  padding:16px 18px;
  display:flex;align-items:center;gap:14px;
  transition:all .2s ease;cursor:pointer;text-decoration:none;
}
.service-card:hover{
  border-color:var(--admin-primary);
  background:var(--admin-primary-light);
  transform:translateX(4px);
  box-shadow:0 8px 20px -8px rgba(124,58,237,.2);
}
html[data-theme="dark"] .service-card:hover{
  background:rgba(124,58,237,.1);
}
.service-card:hover .sv-icon{
  background:var(--admin-primary);color:#fff;
}
.sv-icon{
  width:40px;height:40px;border-radius:11px;
  background:var(--admin-primary-light);color:var(--admin-primary);
  display:grid;place-items:center;flex-shrink:0;
  transition:all .2s ease;
}
html[data-theme="dark"] .sv-icon{
  background:rgba(124,58,237,.2);color:var(--admin-primary-2);
}
.sv-icon .icon-svg{width:18px;height:18px;stroke-width:2.2}
.sv-text{flex:1;min-width:0;}
.sv-name{
  font-size:.85rem;font-weight:800;color:var(--ink);line-height:1.3;
}
.sv-sub{
  font-size:.68rem;color:var(--muted);font-weight:600;
  margin-top:3px;text-transform:uppercase;letter-spacing:.3px;
}

.foot{
  margin-top:40px;padding-top:24px;
  border-top:1px solid var(--line);
  display:flex;justify-content:space-between;align-items:center;
  font-size:.75rem;color:var(--muted);font-weight:700;
  flex-wrap:wrap;gap:12px;
}
.foot b{color:var(--admin-primary)}
html[data-theme="dark"] .foot b{color:var(--admin-primary-2)}

@media (max-width:1100px){
  .quick-actions{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:900px){
  .sidebar{transform:translateX(-100%)}
  html.sb-open .sidebar{transform:translateX(0)}
  .topnav{left:0}
  .tn-toggle{display:grid;place-items:center}
  .tn-menu-btn{display:none}
  .new-wrapper{margin-left:0}
  .sb-collapse-btn{display:none}
  .admin-dash{padding:20px 16px 40px}
  .admin-hero{padding:28px 24px}
  .admin-hero-text h1{font-size:1.6rem}
  .quick-actions{grid-template-columns:1fr}
}
</style>

<script>
(function(){
  try{
    var t = localStorage.getItem('eis-theme');
    if(!t){ t = 'dark'; localStorage.setItem('eis-theme', 'dark'); }
    document.documentElement.setAttribute('data-theme', t);
    var sbClosed = localStorage.getItem('eis-sidebar-closed');
    if (sbClosed === 'true') {
      document.documentElement.classList.add('sb-collapsed');
    }
  }catch(e){}
})();
</script>

<%
  HttpSession sess = request.getSession(false);
  String m_strrole = (sess != null) ? (String) sess.getAttribute("role") : null;
  String ctx = request.getContextPath();
%>

<!-- ============ SIDEBAR ============ -->
<aside class="sidebar" id="sidebar">
  <div class="sb-head">
    <div class="sb-logo">
      <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    </div>
    <div class="sb-title">
      EIS Admin
      <small><%=m_strrole != null ? m_strrole : "Admin Panel"%></small>
    </div>
    <button class="sb-collapse-btn" onclick="toggleSidebar()" title="Hide sidebar">
      <svg class="icon-svg" viewBox="0 0 24 24"><polyline points="11 17 6 12 11 7"/><polyline points="18 17 13 12 18 7"/></svg>
    </button>
  </div>

  <a class="sb-home-btn" href="<%=ctx%>/jsp/header.jsp" title="Admin Dashboard">
    <svg class="icon-svg" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    <span>Dashboard</span>
  </a>

  <div class="sb-search">
    <div class="sb-search-box">
      <svg class="icon-svg" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="searchbar" onkeyup="search_animal()" placeholder="Search admin tools..." autocomplete="off">

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Team Roster - EIS Portal</title>

<style>
:root{
  --primary:#7C3AED;
  --primary-2:#8B5CF6;
  --primary-light:#F3E8FF;
  --accent:#EC4899;
  --accent-2:#F472B6;

  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F5F7FA;
  --card:#FFFFFF;

  /* Shift colors */
  --morning:#FF8C00;
  --morning-light:#FFF4E6;
  --general:#696969;
  --general-light:#F5F5F5;
  --afternoon:#FFD700;
  --afternoon-light:#FFFBE6;
  --night:#1E90FF;
  --night-light:#EBF5FF;
  --weekoff:#0000CD;
  --weekoff-light:#E6E6FF;
  --leave:#FF0000;
  --leave-light:#FFEBEE;
  --flexi:#FF3333;
  --flexi-light:#FFF0F0;
  --holiday:#90EE90;
  --holiday-light:#F0FFF0;
  --na:#000000;
  --na-light:#E0E0E0;

  --success:#16A34A;
  --danger:#DC2626;
  --warning:#F59E0B;

  --topnav-h:64px;

  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

html[data-theme="dark"]{
  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#272727;
  --bg:#0A0614;
  --card:#130A24;
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--font-stack);
  font-weight:600;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  transition:background .3s ease,color .3s ease;
}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none}

/* ============ TOP HEADER ============ */
.top-header{
  position:sticky;
  top:0;
  z-index:100;
  background:
    radial-gradient(circle at top right, rgba(236,72,153,.2), transparent 60%),
    radial-gradient(circle at bottom left, rgba(124,58,237,.3), transparent 60%),
    linear-gradient(135deg, #1A0B2E 0%, #2D1854 100%);
  color:#fff;
  padding:24px 40px;
  box-shadow:0 4px 20px rgba(0,0,0,.15);
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:24px;
  flex-wrap:wrap;
}

.top-header::before{
  content:"";
  position:absolute;
  top:-150px;right:-150px;
  width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle, rgba(124,58,237,.3) 0%, transparent 70%);
  pointer-events:none;
}

.header-left{
  position:relative;
  z-index:2;
}
.header-left .badge{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:5px 12px;
  background:rgba(236,72,153,.2);
  border:1px solid rgba(236,72,153,.4);
  border-radius:999px;
  font-size:.68rem;
  font-weight:800;
  color:var(--accent-2);
  letter-spacing:1px;
  text-transform:uppercase;
  margin-bottom:12px;
}
.header-left .badge .dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--accent-2);
  box-shadow:0 0 8px var(--accent-2);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

.header-left h1{
  font-size:1.9rem;
  font-weight:900;
  letter-spacing:-.8px;
  line-height:1.15;
}
.header-left h1 .gradient{
  background:linear-gradient(135deg,var(--primary-2),var(--accent-2));
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}
.header-left .meta{
  font-size:.82rem;
  color:rgba(255,255,255,.7);
  margin-top:6px;
  display:flex;
  gap:16px;
  flex-wrap:wrap;
}
.header-left .meta span{
  display:inline-flex;
  align-items:center;
  gap:6px;
}

.header-right{
  position:relative;
  z-index:2;
  display:flex;
  gap:10px;
  align-items:center;
  flex-wrap:wrap;
}

.month-picker{
  display:flex;
  gap:8px;
  align-items:center;
  background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.15);
  border-radius:12px;
  padding:6px 12px;
  backdrop-filter:blur(10px);
}
.month-picker select,
.month-picker input{
  padding:8px 12px;
  background:transparent;
  border:none;
  color:#fff;
  font-weight:700;
  font-size:.85rem;
  outline:none;
  cursor:pointer;
  font-family:inherit;
}
.month-picker select option{color:var(--ink);background:var(--card)}
.month-picker input[type="number"]{width:70px}
.month-picker input[type="number"]::-webkit-outer-spin-button,
.month-picker input[type="number"]::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}

.btn-header{
  padding:10px 18px;
  border-radius:10px;
  font-weight:800;
  font-size:.78rem;
  text-transform:uppercase;
  letter-spacing:.5px;
  display:inline-flex;
  align-items:center;
  gap:8px;
  transition:all .2s ease;
  cursor:pointer;
  border:1px solid transparent;
}
.btn-header svg{
  width:16px;height:16px;
  stroke:currentColor;fill:none;
  stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;
}
.btn-primary-header{
  background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#fff;
  box-shadow:0 6px 18px -6px var(--primary);
}
.btn-primary-header:hover{
  transform:translateY(-2px);
  box-shadow:0 10px 24px -6px var(--primary);
}
.btn-ghost-header{
  background:rgba(255,255,255,.1);
  color:#fff;
  border-color:rgba(255,255,255,.2);
}
.btn-ghost-header:hover{background:rgba(255,255,255,.2)}

/* ============ STATS BAR ============ */
.stats-bar{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));
  gap:14px;
  padding:20px 40px;
  background:var(--card);
  border-bottom:1px solid var(--line);
}
.stat-box{
  background:var(--bg);
  border:1px solid var(--line);
  border-radius:14px;
  padding:14px 18px;
  transition:all .2s ease;
}
.stat-box:hover{
  border-color:var(--primary);
  transform:translateY(-2px);
  box-shadow:0 8px 20px -8px rgba(124,58,237,.2);
}
.stat-box .st-lbl{
  font-size:.68rem;
  text-transform:uppercase;
  letter-spacing:.8px;
  color:var(--muted);
  font-weight:800;
}
.stat-box .st-val{
  font-size:1.5rem;
  font-weight:900;
  color:var(--ink);
  margin-top:4px;
  letter-spacing:-.5px;
}
.stat-box .st-val.primary{color:var(--primary)}
.stat-box .st-val.morning{color:var(--morning)}
.stat-box .st-val.general{color:var(--general)}
.stat-box .st-val.afternoon{color:#B8860B}
.stat-box .st-val.night{color:var(--night)}

/* ============ LEGEND BAR ============ */
.legend-bar{
  padding:14px 40px;
  background:var(--card);
  border-bottom:1px solid var(--line);
  display:flex;
  gap:16px;
  flex-wrap:wrap;
  align-items:center;
  font-size:.75rem;
  font-weight:700;
}
.legend-label{
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:1px;
  font-size:.68rem;
  font-weight:800;
  margin-right:8px;
}
.legend-item{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:4px 10px;
  border-radius:999px;
  background:var(--bg);
  border:1px solid var(--line);
}
.legend-dot{
  width:12px;
  height:12px;
  border-radius:4px;
  flex-shrink:0;
}
.legend-dot.morning{background:var(--morning)}
.legend-dot.general{background:var(--general)}
.legend-dot.afternoon{background:var(--afternoon)}
.legend-dot.night{background:var(--night)}
.legend-dot.weekoff{background:var(--weekoff)}
.legend-dot.leave{background:var(--leave)}
.legend-dot.flexi{background:var(--flexi)}
.legend-dot.holiday{background:var(--holiday)}
.legend-dot.na{background:var(--na)}

/* ============ SEARCH BAR ============ */
.search-bar{
  padding:14px 40px;
  background:var(--card);
  border-bottom:1px solid var(--line);
  display:flex;
  gap:12px;
  align-items:center;
  flex-wrap:wrap;
}
.search-box{
  position:relative;
  flex:1;
  max-width:420px;
}
.search-box svg{
  position:absolute;
  left:14px;
  top:50%;
  transform:translateY(-50%);
  width:16px;height:16px;
  stroke:var(--muted);fill:none;
  stroke-width:2.4;
  pointer-events:none;
}
.search-box input{
  width:100%;
  padding:10px 14px 10px 42px;
  background:var(--bg);
  border:1.5px solid var(--line);
  border-radius:11px;
  color:var(--ink);
  font-family:inherit;
  font-size:.85rem;
  font-weight:600;
  outline:none;
  transition:all .2s ease;
}
.search-box input:focus{
  border-color:var(--primary);
  background:var(--card);
  box-shadow:0 0 0 4px rgba(124,58,237,.1);
}
.search-info{
  color:var(--muted);
  font-size:.78rem;
  font-weight:700;
}

/* ============ MAIN TABLE WRAP ============ */
.roster-wrap{
  padding:20px 40px 60px;
  overflow-x:auto;
}

.roster-table{
  width:100%;
  min-width:1400px;
  border-collapse:separate;
  border-spacing:0;
  background:var(--card);
  border-radius:16px;
  overflow:hidden;
  box-shadow:0 4px 20px rgba(0,0,0,.05);
}

.roster-table thead th{
  position:sticky;
  top:0;
  background:var(--card);
  z-index:10;
  padding:12px 8px;
  font-size:.72rem;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.5px;
  color:var(--muted);
  border-bottom:2px solid var(--line);
  text-align:center;
  white-space:nowrap;
}
.roster-table thead th.emp-col{
  position:sticky;
  left:0;
  z-index:20;
  text-align:left;
  padding-left:20px;
  min-width:200px;
  background:var(--card);
  box-shadow:2px 0 8px -4px rgba(0,0,0,.1);
}
.roster-table thead th.pos-col{
  position:sticky;
  left:200px;
  z-index:20;
  text-align:left;
  min-width:130px;
  background:var(--card);
  box-shadow:2px 0 8px -4px rgba(0,0,0,.1);
}
.roster-table thead th.weekend-header{
  background:#FEF3C7;
  color:#92400E;
}
html[data-theme="dark"] .roster-table thead th.weekend-header{
  background:rgba(254,243,199,.15);
  color:#FCD34D;
}

.roster-table tbody tr{
  transition:background .15s ease;
}
.roster-table tbody tr:hover{
  background:var(--bg);
}
.roster-table tbody td{
  padding:10px 8px;
  border-bottom:1px solid var(--line);
  text-align:center;
  font-size:.82rem;
  font-weight:700;
  color:var(--ink);
}
.roster-table tbody td.emp-col{
  position:sticky;
  left:0;
  z-index:5;
  text-align:left;
  padding-left:20px;
  background:var(--card);
  box-shadow:2px 0 8px -4px rgba(0,0,0,.1);
  font-weight:800;
}
.roster-table tbody tr:hover td.emp-col{
  background:var(--bg);
}
.roster-table tbody td.pos-col{
  position:sticky;
  left:200px;
  z-index:5;
  text-align:left;
  background:var(--card);
  box-shadow:2px 0 8px -4px rgba(0,0,0,.1);
}
.roster-table tbody tr:hover td.pos-col{
  background:var(--bg);
}

.emp-cell{
  display:flex;
  align-items:center;
  gap:10px;
}
.emp-avatar{
  width:32px;height:32px;
  border-radius:50%;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#fff;
  display:grid;
  place-items:center;
  font-weight:900;
  font-size:.78rem;
  flex-shrink:0;
}
.emp-name{
  font-size:.82rem;
  color:var(--ink);
  line-height:1.2;
}

/* ============ BADGES ============ */
.shift-badge{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:32px;
  height:32px;
  border-radius:8px;
  font-size:.72rem;
  font-weight:900;
  cursor:pointer;
  transition:all .2s ease;
  border:1.5px solid transparent;
  position:relative;
}
.shift-badge:hover{
  transform:scale(1.15);
  border-color:var(--ink);
  z-index:2;
}
.shift-badge.morning{background:var(--morning);color:#fff}
.shift-badge.general{background:var(--general);color:#fff}
.shift-badge.afternoon{background:var(--afternoon);color:#1A1A1A}
.shift-badge.night{background:var(--night);color:#fff}
.shift-badge.weekoff{background:var(--weekoff);color:#fff}
.shift-badge.leave{background:var(--leave);color:#fff}
.shift-badge.flexi{background:var(--flexi);color:#fff}
.shift-badge.holiday{background:var(--holiday);color:#1A1A1A}
.shift-badge.na{background:var(--na);color:#fff;font-size:.65rem}

/* ============ SUMMARY ROWS ============ */
.roster-table tbody tr.summary-row{
  background:#F8F5FF;
  font-weight:900;
}
html[data-theme="dark"] .roster-table tbody tr.summary-row{
  background:rgba(124,58,237,.08);
}
.roster-table tbody tr.summary-row td{
  font-size:.78rem;
  color:var(--primary);
  border-bottom:1px solid var(--line);
}
.roster-table tbody tr.summary-row td.emp-col{
  background:#F8F5FF;
  font-size:.8rem;
  text-transform:uppercase;
  letter-spacing:.5px;
}
html[data-theme="dark"] .roster-table tbody tr.summary-row td.emp-col{
  background:rgba(124,58,237,.08);
}

/* ============ FOOTER ACTIONS ============ */
.footer-actions{
  position:sticky;
  bottom:0;
  background:var(--card);
  border-top:1px solid var(--line);
  padding:16px 40px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  z-index:50;
  box-shadow:0 -4px 20px rgba(0,0,0,.05);
  flex-wrap:wrap;
}
.footer-info{
  font-size:.78rem;
  color:var(--muted);
  font-weight:700;
}
.btn-primary{
  padding:14px 32px;
  border-radius:12px;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#fff;
  font-size:.85rem;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.5px;
  display:inline-flex;
  align-items:center;
  gap:10px;
  transition:all .25s ease;
  box-shadow:0 8px 22px -8px var(--primary);
}
.btn-primary:hover{
  transform:translateY(-2px);
  box-shadow:0 14px 32px -8px var(--primary);
}
.btn-primary svg{
  width:18px;height:18px;
  stroke:currentColor;fill:none;
  stroke-width:2.4;
}

/* ============ EMPTY STATE ============ */
.empty-state{
  text-align:center;
  padding:80px 40px;
  color:var(--muted);
}
.empty-state svg{
  width:64px;height:64px;
  stroke:var(--primary);
  fill:none;
  stroke-width:1.5;
  opacity:.4;
  margin-bottom:16px;
}
.empty-state h3{
  font-size:1.2rem;
  color:var(--ink);
  margin-bottom:8px;
}

/* ============ RESPONSIVE ============ */
@media (max-width:900px){
  .top-header{padding:20px 20px;}
  .header-left h1{font-size:1.4rem;}
  .stats-bar{padding:16px 20px;grid-template-columns:repeat(2,1fr);}
  .legend-bar{padding:12px 20px;}
  .search-bar{padding:12px 20px;}
  .roster-wrap{padding:16px 12px 40px;}
  .footer-actions{padding:14px 20px;}
  .roster-table thead th.emp-col{min-width:150px;padding-left:12px;}
  .roster-table thead th.pos-col{left:150px;min-width:100px;}
  .roster-table tbody td.emp-col{padding-left:12px;}
  .roster-table tbody td.pos-col{left:150px;}
}
</style>
</head>

      font-size: 0.9rem;
      margin: 6px 0 0 56px;
      font-weight: 500;
    }
    .time-badge {
      background: var(--card);
      border: 1px solid var(--line);
      padding: 10px 20px;
      border-radius: 999px;
      font-size: 0.85rem;
      color: var(--ink);
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,.03);
    }
    .time-badge i { color: var(--brand); }

    .controls-card {
      border-radius: 20px;
      border: 1px solid var(--line) !important;
      background: var(--card) !important;
      padding: 24px;
      box-shadow: 0 4px 20px rgba(0,0,0,.03);
      margin-bottom: 28px;
      transition: background .3s ease, border-color .3s ease;
    }
    html[data-theme="dark"] .controls-card {
      box-shadow: 0 4px 20px rgba(0,0,0,.3);
    }
    .controls-card .form-label {
      color: var(--ink);
      font-weight: 600;
      font-size: 0.82rem;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .controls-card .form-label i { color: var(--brand); }
    .controls-card .form-control {
      border-radius: 11px;
      border: 1.5px solid var(--line);
      background: var(--bg);
      color: var(--ink);
      padding: 10px 14px;
      font-size: 0.88rem;
      transition: all .15s ease;
      font-family: inherit;
    }
    .controls-card .form-control:focus {
      border-color: var(--brand);
      background: var(--card);
      box-shadow: 0 0 0 4px rgba(248,111,3,.12);
      color: var(--ink);
    }
    .hour-btn {
      min-width: 52px;
      padding: 6px 11px;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--card);
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--muted);
      transition: all .15s ease;
      cursor: pointer;
      font-family: inherit;
    }
    .hour-btn:hover {
      background: var(--brand-light);
      border-color: var(--brand);
      color: var(--brand);
    }
    html[data-theme="dark"] .hour-btn:hover {
      background: rgba(248,111,3,.15);
    }
    .hour-btn.active {
      background: var(--brand);
      color: #fff;
      border-color: var(--brand);
      box-shadow: 0 3px 10px rgba(248,111,3,.3);
    }
    .btn-fetch {
      border-radius: 11px;
      padding: 10px 24px;
      font-weight: 600;
      font-size: 0.85rem;
      background: var(--brand);
      border: none;
      color: #fff;
      transition: all .2s ease;
      box-shadow: 0 6px 18px -6px var(--brand);
    }
    .btn-fetch:hover {
      background: var(--brand-2);
      transform: translateY(-1px);
      color: #fff;
    }
    .btn-now {
      border-radius: 11px;
      padding: 10px 24px;
      font-weight: 600;
      font-size: 0.85rem;
      border: 1px solid var(--line);
      background: var(--card);
      color: var(--ink);
      transition: all .2s ease;
    }
    .btn-now:hover {
      background: var(--bg);
      border-color: var(--muted);
      color: var(--ink);
    }
    .btn-queries {
      border-radius: 11px;
      padding: 10px 24px;
      font-weight: 600;
      font-size: 0.85rem;
      background: #805AD5;
      border: none;
      color: white;
      transition: all .2s ease;
    }
    .btn-queries:hover {
      background: #6B46C1;
      color: #fff;
      transform: translateY(-1px);
    }
    .hour-label {
      color: var(--ink);
      font-weight: 700;
      font-size: 0.82rem;
      letter-spacing: 0.3px;
      margin-right: 8px;
    }
    .hour-label i { color: var(--brand); }

    .card-dashboard {
      border-radius: 18px;
      border: 1px solid var(--line) !important;
      background: var(--card) !important;
      box-shadow: 0 2px 12px rgba(0,0,0,.03);
      transition: all .25s ease;
      height: 100%;
      overflow: hidden;
    }
    .card-dashboard:hover {
      border-color: var(--brand) !important;
      transform: translateY(-2px);
      box-shadow: 0 12px 32px -10px rgba(248,111,3,.18);
    }
    .card-header-custom {
      background: var(--card);
      border-bottom: 1px solid var(--line);
      padding: 16px 20px;
      font-weight: 700;
      font-size: 0.92rem;
      color: var(--ink);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }
    .badge-db {
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.4px;
      text-transform: uppercase;
    }
    .badge-db.iib  { background: #DBEAFE; color: #1D4ED8; }
    .badge-db.sidb { background: #F3E8FF; color: #7E22CE; }
    html[data-theme="dark"] .badge-db.iib  { background: rgba(29,78,216,.18); color: #60A5FA; }
    html[data-theme="dark"] .badge-db.sidb { background: rgba(126,34,206,.18); color: #C084FC; }
    .badge-count {
      background: var(--bg);
      color: var(--muted);
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.7rem;
    }
    html[data-theme="dark"] .badge-count { background: #222; color: #A1A1AA; }
    .badge-duration {
      background: var(--brand-light);
      color: var(--brand);
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.7rem;
      font-weight: 600;
    }
    html[data-theme="dark"] .badge-duration {
      background: rgba(248,111,3,.15);
    }
    .table-container {
      max-height: 320px;
      overflow-y: auto;
    }
    .table-container::-webkit-scrollbar { width: 6px; height: 6px; }
    .table-container::-webkit-scrollbar-thumb {
      background: var(--line);
      border-radius: 3px;
    }
    .table-container table {
      font-size: 0.78rem;
      margin-bottom: 0;
      color: var(--ink);
    }
    .table-container thead {
      position: sticky;
      top: 0;
      z-index: 1;
    }
    .table-container thead th {
      background: var(--bg);
      color: var(--muted);
      font-weight: 700;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      border-bottom: 1px solid var(--line);
      padding: 10px 12px;
      white-space: nowrap;
    }
    .table-container tbody td {
      padding: 8px 12px;
      vertical-align: middle;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
    }
    html[data-theme="dark"] .table-container tbody td {
      border-bottom-color: #1F1F1F;
    }
    .table-container tbody tr:hover {
      background: var(--bg);
    }
    html[data-theme="dark"] .table-container tbody tr:hover {
      background: #1F1F1F;
    }
    .no-data {
      color: var(--muted);
      font-style: italic;
      padding: 24px 0;
      text-align: center;
      font-size: 0.85rem;
    }
    .queries-card {
      border-radius: 18px;
      border: 1px solid var(--line) !important;
      background: var(--card) !important;
      padding: 20px;
      margin-bottom: 28px;
    }
    html[data-theme="dark"] .queries-card {
      background: #0B0B0B !important;
      border-color: #1F1F1F !important;
    }
    .queries-card .header-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }
    .queries-card .queries-title {
      color: var(--ink);
      font-weight: 700;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .queries-card .queries-title i { color: var(--brand); }
    .queries-card .close-btn {
      background: transparent;
      border: none;
      color: var(--muted);
      font-size: 1.4rem;
      cursor: pointer;
      padding: 0 8px;
      border-radius: 6px;
      transition: all .15s;
    }
    .queries-card .close-btn:hover {
      color: var(--ink);
      background: var(--bg);
    }
    html[data-theme="dark"] .queries-card .close-btn:hover {
      background: #1F1F1F;
    }
    .query-block {
      background: #F7F7F5;
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 14px 16px;
      margin-bottom: 10px;
      position: relative;
    }
    html[data-theme="dark"] .query-block {
      background: #131313;
      border-color: #1F1F1F;
    }
    .query-block pre {
      margin: 0;
      color: var(--ink);
      font-size: 0.76rem;
      white-space: pre-wrap;
      word-break: break-all;
      font-family: 'JetBrains Mono', Consolas, monospace;
      line-height: 1.5;
    }
    .query-block .copy-query-btn {
      position: absolute;
      top: 8px;
      right: 8px;
      background: var(--card);
      border: 1px solid var(--line);
      color: var(--muted);
      border-radius: 999px;
      padding: 4px 12px;
      font-size: 0.68rem;
      font-weight: 600;
      cursor: pointer;
      transition: all .15s;
    }
    .query-block .copy-query-btn:hover {
      background: var(--brand);
      border-color: var(--brand);
      color: #fff;
    }
    .queries-card .copy-all-btn {
      background: var(--brand);
      border: none;
      color: white;
      border-radius: 999px;
      padding: 7px 18px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      transition: all .15s;
    }
    .queries-card .copy-all-btn:hover {
      background: var(--brand-2);
    }
    @media (max-width: 900px) {
      .page-container { padding: 20px 16px 32px; }
      .page-head .ttl { font-size: 1.3rem; }
      .page-head .ttl .ttl-icon { width: 38px; height: 38px; font-size: .9rem; }
      .page-head .sub { margin-left: 50px; font-size: 0.82rem; }
      .time-badge { padding: 8px 14px; font-size: 0.78rem; }
    }
    </style>
</head>
<body>

<%@include file="../userheader.jsp"%>

<div class="new-wrapper">
  <div class="page-container">

    <div class="page-head">
      <div>
        <h1 class="ttl">
          <span class="ttl-icon"><i class="fas fa-chart-line"></i></span>
          Stat Mgmt Dashboard
        </h1>
        <p class="sub">Hourly KPI data from cron jobs</p>
      </div>
      <span class="time-badge">
        <i class="far fa-clock"></i><%= rangeDisplay %>
      </span>
    </div>

    <form method="get" class="controls-card" id="mainForm">
      <div class="row g-3 align-items-end">
        <div class="col-md-3">
          <label for="start" class="form-label"><i class="far fa-calendar-alt"></i>Start</label>
          <input type="datetime-local" class="form-control" id="start" name="start" value="<%= startIso %>">
        </div>
        <div class="col-md-3">
          <label for="end" class="form-label"><i class="far fa-calendar-alt"></i>End</label>
          <input type="datetime-local" class="form-control" id="end" name="end" value="<%= endIso %>">
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-fetch w-100">
            <i class="fas fa-sync-alt me-2"></i>Fetch
          </button>
        </div>
        <div class="col-md-2">
          <button type="button" class="btn btn-now w-100" onclick="setPrevHour()">
            <i class="fas fa-undo me-1"></i>Now
          </button>
        </div>
        <div class="col-md-2">
          <button type="submit" name="showQueries" value="true" class="btn btn-queries w-100">
            <i class="fas fa-code me-1"></i>Show Queries
          </button>
        </div>
      </div>

      <div class="row mt-3">
        <div class="col-12">
          <span class="hour-label"><i class="fas fa-clock me-1"></i>Hour shortcuts:</span>
          <div class="d-flex flex-wrap gap-1 mt-2">
            <% for (int h = 0; h < 24; h++) {
                String label = String.format("%02d-%02d", h, (h+1)%24);
                String activeClass = (h == selectedHour) ? "active" : "";
            %>
            <button type="button" class="hour-btn <%= activeClass %>" onclick="setHour(<%= h %>)"><%= label %></button>
            <% } %>
          </div>
        </div>
      </div>
    </form>

    <% if ("true".equals(showQueries) && !queriesDisplay.isEmpty()) { %>
    <div class="queries-card" id="queriesPanel">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="queries-title">
          <i class="fas fa-database"></i>SQL Queries for this period
        </span>
        <div class="header-actions">
          <button class="copy-all-btn" onclick="copyAllQueries()"><i class="far fa-copy me-1"></i>Copy All</button>
          <button class="close-btn" onclick="closeQueries()">&times;</button>
        </div>
      </div>
      <%
          String[] queryBlocks = queriesDisplay.split("\n\n");
          for (String block : queryBlocks) {
              if (block.trim().isEmpty()) continue;
              String escaped = block.replace("'", "\\'").replace("\"", "\\\"");
      %>
      <div class="query-block">
        <button class="copy-query-btn" onclick="copyQuery('<%= escaped %>')"><i class="far fa-copy"></i> Copy</button>
        <pre><%= block %></pre>
      </div>
      <% } %>
    </div>
    <script>
      function closeQueries() {
        var panel = document.getElementById('queriesPanel');
        panel.style.display = 'none';
        var url = new URL(window.location);
        url.searchParams.delete('showQueries');
        window.history.replaceState({}, '', url);
      }
      function copyQuery(text) {
        navigator.clipboard.writeText(text).then(function() {
          alert('Query copied to clipboard!');
        }).catch(function() {
          var ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
          alert('Copied!');
        });
      }
      function copyAllQueries() {
        var texts = document.querySelectorAll('.query-block pre');
        var full = '';
        texts.forEach(function(pre) {
          full += pre.innerText + '\n\n';
        });
        navigator.clipboard.writeText(full).then(function() {
          alert('All queries copied to clipboard!');
        }).catch(function() {
          var ta = document.createElement('textarea');
          ta.value = full;
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
          alert('Copied!');
        });
      }
    </script>
    <% } %>

    <div class="row">
      <% for (int i = 0; i < tables.length; i++) {
          String tbl = tables[i];
          String display = displayNames[i];
          String dbSource = sourceDB[i];
          List<Map<String, Object>> rows = tableData.get(tbl);
          if (rows == null) rows = new ArrayList<>();
          int rowCount = rows.size();
          double avgDur = 0.0;
          if (rowCount > 0) {
              for (Map<String, Object> row : rows) {
                  Object dur = row.get("QUERY_DURATION_SEC");
                  if (dur instanceof Number) avgDur += ((Number)dur).doubleValue();
              }
              avgDur = avgDur / rowCount;
          }
          String dbBadgeClass = dbSource.equalsIgnoreCase("IIB") ? "iib" : "sidb";
      %>
      <div class="col-xl-4 col-lg-6 col-md-12 mb-4">
        <div class="card-dashboard">
          <div class="card-header-custom">
            <span><%= display %></span>
            <span class="d-flex align-items-center gap-2">
              <span class="badge-db <%= dbBadgeClass %>"><%= dbSource %></span>
              <span class="badge-count"><%= rowCount %></span>
              <span class="badge-duration"><i class="far fa-clock me-1"></i><%= String.format("%.2f", avgDur) %>s</span>
            </span>
          </div>
          <div class="card-body p-3">
            <% if (rowCount == 0) { %>
              <div class="no-data">No data for this period.</div>
            <% } else { %>
              <div class="table-container">
                <table class="table">
                  <thead>
                    <tr>
                      <% for (String col : rows.get(0).keySet()) {
                          if (hiddenCols.contains(col)) continue;
                          String displayCol = col.equals("QUERY_DURATION_SEC") ? "Duration (sec)" : col;
                      %>
                        <th><%= displayCol %></th>
                      <% } %>
                    </tr>
                  </thead>
                  <tbody>
                    <% for (Map<String, Object> row : rows) { %>
                      <tr>
                        <% for (Map.Entry<String, Object> entry : row.entrySet()) {
                            String col = entry.getKey();
                            if (hiddenCols.contains(col)) continue;
                            Object val = entry.getValue();
                            String str = (val == null) ? "-" : val.toString();
                            if (val instanceof Double || val instanceof Float) {
                                str = String.format("%.2f", ((Number)val).doubleValue());
                            }
                        %>
                          <td><%= str %></td>
                        <% } %>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </div>
        </div>
      </div>
      <% } %>
    </div>

  </div>
</div>

<script>
    function setHour(h) {
        let date = document.getElementById('start').value.substring(0,10);
        let start = date + 'T' + String(h).padStart(2,'0') + ':00';
        let endHour = (h+1) % 24;
        let endDate = date;
        if (h === 23) {
            let d = new Date(date + 'T00:00:00');
            d.setDate(d.getDate() + 1);
            endDate = d.toISOString().split('T')[0];
        }
        let end = endDate + 'T' + String(endHour).padStart(2,'0') + ':00';
        document.getElementById('start').value = start;
        document.getElementById('end').value = end;
        document.querySelector('form').submit();
    }

    function setPrevHour() {
        let now = new Date();
        now.setMinutes(0);
        now.setSeconds(0);
        now.setMilliseconds(0);
        let end = new Date(now);
        let start = new Date(now);
        start.setHours(start.getHours() - 1);
        const formatLocal = (d) => {
            let year = d.getFullYear();
            let month = String(d.getMonth()+1).padStart(2,'0');
            let day = String(d.getDate()).padStart(2,'0');
            let hours = String(d.getHours()).padStart(2,'0');
            let mins = String(d.getMinutes()).padStart(2,'0');
            return year + '-' + month + '-' + day + 'T' + hours + ':' + mins;
        };
        document.getElementById('start').value = formatLocal(start);
        document.getElementById('end').value = formatLocal(end);
        document.querySelector('form').submit();
    }
</script>
<script src="<%=request.getContextPath()%>/js/bootstrap.bundle.min.js"></script>
</body>
</html>

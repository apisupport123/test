<style>
/* ============================================================
   PAGE BASE — theme-aware
   ============================================================ */
body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg) !important;
    color: var(--ink) !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 15px;
    transition: background .3s ease, color .3s ease;
}

/* ✅ Content wrapper */
.new-wrapper {
    background: var(--bg);
    min-height: 100vh;
}
.page-container {
    padding: 24px 28px 48px;
    max-width: 1600px;
    margin: 0 auto;
}

/* ============================================================
   PAGE HEADER
   ============================================================ */
.page-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
}
.page-head h1 {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.55rem;
    font-weight: 800;
    letter-spacing: -.5px;
    color: var(--ink);
    margin: 0;
    line-height: 1.2;
}
.page-head h1 .ttl-icon {
    width: 44px; height: 44px;
    display: grid; place-items: center;
    background: var(--brand-light);
    color: var(--brand);
    border-radius: 12px;
    font-size: 1.1rem;
    flex-shrink: 0;
}
html[data-theme="dark"] .page-head h1 .ttl-icon {
    background: rgba(248,111,3,.15);
}
.page-head .sub {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 500;
    margin: 6px 0 0 56px;
}

/* ============================================================
   CARD / CONTAINER
   ============================================================ */
.container {
    max-width: 100%;
    margin: 0;
    background: var(--card);
    border: 1px solid var(--line);
    padding: 24px;
    border-radius: 16px;
    box-shadow: 0 2px 12px rgba(0,0,0,.03);
    color: var(--ink);
}
html[data-theme="dark"] .container {
    box-shadow: 0 2px 12px rgba(0,0,0,.3);
}

/* ============================================================
   FORM STYLING
   ============================================================ */
.form-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    align-items: end;
    margin-bottom: 16px;
}
.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.form-group label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: .5px;
}
.form-control, select, input {
    background: var(--bg) !important;
    color: var(--ink) !important;
    border: 1.5px solid var(--line) !important;
    border-radius: 10px !important;
    padding: 10px 14px !important;
    font-family: inherit !important;
    font-size: 0.88rem !important;
    font-weight: 600 !important;
    outline: none !important;
    transition: all .2s ease !important;
    width: 100%;
}
.form-control:focus, select:focus, input:focus {
    border-color: var(--brand) !important;
    background: var(--card) !important;
    box-shadow: 0 0 0 4px var(--brand-light) !important;
}
html[data-theme="dark"] .form-control:focus,
html[data-theme="dark"] select:focus,
html[data-theme="dark"] input:focus {
    box-shadow: 0 0 0 4px rgba(248,111,3,.15) !important;
}
.form-control::placeholder {
    color: var(--muted) !important;
    opacity: .7 !important;
    font-weight: 600;
}
textarea.form-control {
    min-height: 44px;
    resize: vertical;
}
.form-check {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 0;
}
.form-check-input {
    width: 18px !important;
    height: 18px !important;
    accent-color: var(--brand);
    cursor: pointer;
}
.form-check-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
}

/* ============================================================
   BUTTONS
   ============================================================ */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 22px;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    border-radius: 11px;
    cursor: pointer;
    transition: all .2s ease;
    text-decoration: none;
    border: none;
    white-space: nowrap;
}
.btn-primary {
    background: linear-gradient(135deg, var(--brand), var(--brand-2)) !important;
    color: #fff !important;
    box-shadow: 0 6px 20px -6px rgba(248,111,3,.4) !important;
}
.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px -6px rgba(248,111,3,.5) !important;
}
.btn-success {
    background: linear-gradient(135deg, #10b981, #059669) !important;
    color: #fff !important;
    box-shadow: 0 6px 20px -6px rgba(16,185,129,.4) !important;
}
.btn-success:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px -6px rgba(16,185,129,.5) !important;
}

.pending-button {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
}

/* ============================================================
   TABLE
   ============================================================ */
.table-container {
    margin-top: 24px;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow-x: auto;
}
.titulo-tabla {
    text-align: center;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--ink) !important;
    margin-bottom: 18px;
    letter-spacing: -.3px;
}
.table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
    font-size: 0.83rem;
    color: var(--ink) !important;
}
.table th, .table td {
    padding: 11px 12px;
    text-align: left;
    border: 1px solid var(--line);
    color: var(--ink) !important;
    word-break: break-word;
    vertical-align: middle;
}
.table th {
    background: var(--bg) !important;
    color: var(--muted) !important;
    font-weight: 800 !important;
    font-size: 0.72rem !important;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
}
.table td {
    background: var(--card);
    font-weight: 600;
}
.table tbody tr:hover {
    background: var(--bg) !important;
}
html[data-theme="dark"] .table tbody tr:hover {
    background: rgba(255,255,255,.03) !important;
}
pre {
    white-space: pre-wrap;
    word-wrap: break-word;
    margin: 0;
    color: var(--ink) !important;
}
pre svg {
    margin-left: 8px;
    vertical-align: middle;
}
.table td pre {
    cursor: pointer;
}
.table td pre:hover {
    text-decoration: underline;
    color: var(--brand) !important;
}
.table td:last-child {
    text-align: center;
    cursor: pointer;
}

/* Post Deploy RRN column */
.table td.post-deploy-rrn {
    max-width: 220px;
    word-wrap: break-word;
    white-space: normal;
    font-size: 0.75rem;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Action button in table */
.action-btn {
    padding: 7px 14px !important;
    font-size: 0.75rem !important;
    border-radius: 8px !important;
}

/* Checkbox row */
.checkbox-row {
    display: none;
    width: 100%;
}
.checkbox-row td {
    background: var(--bg) !important;
    padding: 16px !important;
}
.checkbox-row input[type="checkbox"] {
    width: 16px !important;
    height: 16px !important;
    margin: 0 6px 0 12px;
    accent-color: var(--brand);
    cursor: pointer;
}
.checkbox-row .textarea-container {
    display: none;
    margin-top: 10px;
}
.checkbox-row textarea {
    width: 100%;
    height: 80px;
    padding: 10px 14px;
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    outline: none;
    resize: vertical;
}
.checkbox-row textarea:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-light);
}

/* No-hits table */
.no-hits-table {
    border-collapse: collapse;
    width: 100%;
    margin-top: 20px;
    color: var(--ink);
}
.no-hits-table th, .no-hits-table td {
    border: 1px solid var(--line);
    padding: 11px 12px;
    text-align: left;
    color: var(--ink);
}
.no-hits-table th {
    background: var(--bg);
    font-weight: 800;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
}

/* Error message */
.error-message {
    color: var(--muted);
    padding: 12px 16px;
    background: var(--bg);
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.85rem;
    margin-bottom: 14px;
    border-left: 3px solid var(--warning);
}

/* Timer */
.timer {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--brand-light);
    color: var(--brand);
    font-family: 'JetBrains Mono', Consolas, monospace;
    font-size: 0.9rem;
    font-weight: 700;
    border: 1.5px solid rgba(248,111,3,.3);
    margin-left: 8px;
}
html[data-theme="dark"] .timer {
    background: rgba(248,111,3,.15);
}

/* Responsive */
@media (max-width: 900px) {
    .page-container { padding: 16px 14px 32px; }
    .page-head h1 { font-size: 1.2rem; }
    .page-head h1 .ttl-icon { width: 36px; height: 36px; font-size: .9rem; }
    .page-head .sub { margin-left: 48px; font-size: 0.78rem; }
    .form-row { grid-template-columns: 1fr; }
    .pending-button { flex-direction: column; }
    .pending-button .btn { width: 100%; }
    .container { padding: 16px; }
    .table-container { padding: 14px; margin-left: 0; margin-right: 0; }
}
</style>


            <button class="btn-glass btn-ghost-glass" onclick="window.open('<%=request.getContextPath()%>/jsp/DisplayTodayHundredPercentFailure.jsp','_blank')">
                <i class="fas fa-check-circle"></i> <span class="badge-count-glass"><%= hundredClosed %></span>
            </button>
        </div>
    </div>

    <!-- ============ TICKER ============ -->
    <div class="ticker-bar">
        <div class="ticker-wrap">
            <div class="ticker-text">
                <span>● <span class="hl">MONITORING:</span> ServiceWise (TD &gt; 1%) + <span class="hl2">100% Failure</span></span>
                <span>● <span class="hl">LEGEND:</span> <span style="color:#E74C3C;">● TD</span> <span style="color:#F39C12;">● BD</span> <span style="color:#9B59B6;">● Mixed</span> <span style="color:#2ECC71;">● Healthy</span></span>
                <span>● <span class="hl">REFRESH:</span> Every 5 minutes</span>
                <span>● <span class="hl">SORTED BY:</span> Highest failure count first</span>
                <span>● <span class="hl">CLICK:</span> Any tile for detailed alert</span>
            </div>
        </div>
    </div>

    <!-- ============ INFO BAR ============ -->
    <div class="info-bar">
        <div class="legend">
            <span class="item"><span class="swatch sw-td"></span> TD</span>
            <span class="item"><span class="swatch sw-bd"></span> BD</span>
            <span class="item"><span class="swatch sw-mixed"></span> Mixed</span>
            <span class="item"><span class="swatch sw-health"></span> Healthy</span>
        </div>
        <div class="timestamp-display">
            <i class="fas fa-clock"></i> Last Update: <%= lastUpdate %>
        </div>
    </div>

    <!-- ============ GRID MAIN ============ -->
    <div class="grid-main">

        <!-- Card 1: GEN-5 -->
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="title"><i class="fas fa-server"></i> GEN-5</span>
                <span class="badge-count" id="swGen5Count">0</span>
            </div>
            <div class="tile-grid" id="sw-gen5">
                <%
                    List<Double> swGen5Per = new ArrayList<>();
                    List<String> swGen5Name = new ArrayList<>();
                    List<String> swGen5Source = new ArrayList<>();
                    List<String> swGen5Error = new ArrayList<>();
                    List<Integer> swGen5Hits = new ArrayList<>();
                    List<Integer> swGen5Td = new ArrayList<>();
                    List<String> swGen5Time = new ArrayList<>();
                    List<Integer> swGen5Si = new ArrayList<>();

                    try {
                        String q = "SELECT * FROM(SELECT api_name,source_id, error_code,SUM(total_hits) AS total_hits,SUM(success) AS success,issue_time, SUM(td) AS td,round(AVG(td_per), 2) AS td_per, SUM(SI_EEROR) AS SI_EEROR FROM gen5_servicewise_fail temp WHERE TRIM(concat(temp.api_name, temp.source_id)) NOT IN (SELECT TRIM(concat(api_name, source_id) || error_description) FROM vaild_bd_master) AND trim(temp.error_code ) not in (select DISTINCT ERRCODE FROM cbs_err_map WHERE substr(errcode,3,3) NOT in ('002','014') OR errcode in ('SI001','SI007','SI051','SI569','SI570')) AND substr(api_name, 1, 3) NOT IN 'gen' AND insert_time >= sysdate - INTERVAL '10' MINUTE AND api_name NOT IN (SELECT service_name FROM service_temporary_pause_master WHERE service_name IS NOT NULL) GROUP BY api_name, source_id, error_code, issue_time ORDER BY td DESC) temp WHERE issue_time = (SELECT MAX(issue_time) FROM gen5_servicewise_fail temp_in WHERE temp_in.api_name = temp.api_name GROUP BY api_name)";
                        ResultSet rs = con.createStatement().executeQuery(q);
                        while(rs.next()) {
                            if(rs.getDouble("TD") >= 50) {
                                swGen5Per.add(rs.getDouble("TD_PER"));
                                swGen5Name.add(nvl(rs.getString("API_NAME"), "N/A"));
                                swGen5Source.add(nvl(rs.getString("SOURCE_ID"), "N/A"));
                                swGen5Error.add(nvl(rs.getString("ERROR_CODE"), "N/A"));
                                swGen5Hits.add(rs.getInt("TOTAL_HITS"));
                                swGen5Td.add(rs.getInt("TD"));
                                swGen5Time.add(nvl(rs.getString("ISSUE_TIME"), "N/A"));
                                swGen5Si.add(rs.getInt("SI_EEROR"));
                            }
                        }
                        rs.close();
                    } catch(Exception e) { e.printStackTrace(); }

                    Integer[] gen5Idx = new Integer[swGen5Td.size()];
                    for(int i = 0; i < gen5Idx.length; i++) gen5Idx[i] = i;
                    Arrays.sort(gen5Idx, (a, b) -> swGen5Td.get(b) - swGen5Td.get(a));

                    int maxTiles = Math.max(swGen5Per.size(), 35);
                    for(int i = 0; i < maxTiles; i++) {
                        String cls = "tile tile-healthy";
                        String val = "✓";
                        String sub = "HEALTHY";
                        String bar = "15%";
                        String tip = "✅ Healthy";
                        String tipClass = "tip-healthy";
                        String onclick = "";
                        if(i < gen5Idx.length) {
                            int idx = gen5Idx[i];
                            Double pct = swGen5Per.get(idx);
                            cls = "tile tile-critical pulse";
                            val = String.format("%.1f", pct) + "%";
                            sub = "TD";
                            bar = "80%";
                            tip = "⚠ " + swGen5Name.get(idx) + " | TD: " + swGen5Td.get(idx);
                            tipClass = "tip-critical";
                            String alertMsg = "<b>Service:</b> " + swGen5Name.get(idx) + "<br><b>Source:</b> " + swGen5Source.get(idx) + "<br><b>Error:</b> " + swGen5Error.get(idx) + "<br><b>Hits:</b> " + swGen5Hits.get(idx) + "<br><b>TD Count:</b> <span class='highlight-td'>" + swGen5Td.get(idx) + "</span><br><b>Fail %:</b> <span class='highlight-td'>" + String.format("%.2f", pct) + "%</span><br><b>SI Error:</b> " + swGen5Si.get(idx) + "<br><b>Time:</b> " + swGen5Time.get(idx);
                            String name = swGen5Name.get(idx).replace("'", "\\'");
                            onclick = "onclick=\"openModal('" + alertMsg.replace("'", "\\'") + "','" + name + "','GEN-5','ServiceWise','" + swGen5Source.get(idx).replace("'", "\\'") + "','" + swGen5Error.get(idx).replace("'", "\\'") + "','" + swGen5Hits.get(idx) + "','" + swGen5Td.get(idx) + "','" + swGen5Time.get(idx).replace("'", "\\'") + "')\"";
                        }
                        out.print("<div class='" + cls + "' data-tip='" + tip + "' data-tip-class='" + tipClass + "' " + onclick + ">");
                        out.print("<span class='val'>" + val + "</span>");
                        out.print("<span class='sub-text'>" + sub + "</span>");
                        out.print("<div class='bar'><div class='fill' style='width:" + bar + ";'></div></div>");
                        out.print("</div>");
                    }
                %>
            </div>
        </div>

        <!-- Card 3: ThirdParty -->
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="title"><i class="fas fa-plug"></i> ThirdParty</span>
                <span class="badge-count" id="swThirdCount">0</span>
            </div>
            <div class="tile-grid" id="sw-third">
                <%
                    List<Double> swThirdPer = new ArrayList<>();
                    List<String> swThirdName = new ArrayList<>();
                    List<String> swThirdSource = new ArrayList<>();
                    List<String> swThirdError = new ArrayList<>();
                    List<Integer> swThirdHits = new ArrayList<>();
                    List<Integer> swThirdTd = new ArrayList<>();
                    List<String> swThirdTime = new ArrayList<>();
                    List<Integer> swThirdSi = new ArrayList<>();
                    List<String> swThirdApiName = new ArrayList<>();
                    List<String> swThirdTransaction = new ArrayList<>();
                    List<String> swThirdSupUrl = new ArrayList<>();

                    try {
                        String q = "select * from (select api_name,sup_url,transaction_urn,original_urn, sum(total_hits) as total_hits, sum(td) as td, round(avg(td_percent),2) as td_percent, SUM(SI_EEROR) AS SI_EEROR, error_code,source_id, issue_time from gen5_ThirdParty_servicewise_fail TEMP where trim(CONCAT(temp.sup_url,temp.SOURCE_ID)) not in(select trim(CONCAT(API_NAME,SOURCE_ID)||error_description) from vaild_bd_master) and insert_time >= SYSDATE - INTERVAL '10' minute and original_urn not in (select service_name from service_temporary_pause_master where service_name is not null) AND trim(temp.error_code ) not in (select DISTINCT trim(ERRCODE) FROM cbs_err_map WHERE substr(errcode,3,3) NOT in ('002','014') OR errcode in ('SI001','SI007','SI051','SI569','SI570')) GROUP BY api_name,sup_url,transaction_urn,original_urn,error_code,source_id,issue_time order by td desc) TEMP where issue_time = (select max(issue_time) from gen5_ThirdParty_servicewise_fail temp_in where temp_in.sup_url = temp.sup_url group by sup_url)";
                        ResultSet rs = con.createStatement().executeQuery(q);
                        while(rs.next()) {
                            if(rs.getDouble("TD") >= 50) {
                                swThirdPer.add(rs.getDouble("TD_PERCENT"));
                                swThirdName.add(nvl(rs.getString("original_urn"), "N/A"));
                                swThirdSource.add(nvl(rs.getString("source_id"), "N/A"));
                                swThirdError.add(nvl(rs.getString("error_code"), "N/A"));
                                swThirdHits.add(rs.getInt("TOTAL_HITS"));
                                swThirdTd.add(rs.getInt("TD"));
                                swThirdTime.add(nvl(rs.getString("issue_time"), "N/A"));
                                swThirdSi.add(rs.getInt("SI_EEROR"));
                                swThirdApiName.add(nvl(rs.getString("api_name"), "N/A"));
                                swThirdTransaction.add(nvl(rs.getString("transaction_urn"), "N/A"));
                                swThirdSupUrl.add(nvl(rs.getString("sup_url"), "N/A"));
                            }
                        }
                        rs.close();
                    } catch(Exception e) { e.printStackTrace(); }

                    Integer[] thirdIdx = new Integer[swThirdTd.size()];
                    for(int i = 0; i < thirdIdx.length; i++) thirdIdx[i] = i;
                    Arrays.sort(thirdIdx, (a, b) -> swThirdTd.get(b) - swThirdTd.get(a));

                    maxTiles = Math.max(swThirdPer.size(), 35);
                    for(int i = 0; i < maxTiles; i++) {
                        String cls = "tile tile-healthy";
                        String val = "✓";
                        String sub = "HEALTHY";
                        String bar = "15%";
                        String tip = "✅ Healthy";
                        String tipClass = "tip-healthy";
                        String onclick = "";
                        if(i < thirdIdx.length) {
                            int idx = thirdIdx[i];
                            Double pct = swThirdPer.get(idx);
                            cls = "tile tile-critical pulse";
                            val = String.format("%.1f", pct) + "%";
                            sub = "TD";
                            bar = "80%";
                            tip = "⚠ " + swThirdName.get(idx) + " | TD: " + swThirdTd.get(idx);
                            tipClass = "tip-critical";
                            String alertMsg = "<b>API Name:</b> " + swThirdApiName.get(idx) +
                                             "<br><b>Service:</b> " + swThirdName.get(idx) +
                                             "<br><b>Transaction URN:</b> " + swThirdTransaction.get(idx) +
                                             "<br><b>SUP URL:</b> " + swThirdSupUrl.get(idx) +
                                             "<br><b>Source:</b> " + swThirdSource.get(idx) +
                                             "<br><b>Error:</b> " + swThirdError.get(idx) +
                                             "<br><b>Hits:</b> " + swThirdHits.get(idx) +
                                             "<br><b>TD Count:</b> <span class='highlight-td'>" + swThirdTd.get(idx) + "</span>" +
                                             "<br><b>Fail %:</b> <span class='highlight-td'>" + String.format("%.2f", pct) + "%</span>" +
                                             "<br><b>SI Error:</b> " + swThirdSi.get(idx) +
                                             "<br><b>Time:</b> " + swThirdTime.get(idx);
                            String name = swThirdName.get(idx).replace("'", "\\'");
                            String source = swThirdSource.get(idx).replace("'", "\\'");
                            String error = swThirdError.get(idx).replace("'", "\\'");
                            String time = swThirdTime.get(idx).replace("'", "\\'");
                            String apiName = swThirdApiName.get(idx).replace("'", "\\'");
                            String transaction = swThirdTransaction.get(idx).replace("'", "\\'");
                            String supurl = swThirdSupUrl.get(idx).replace("'", "\\'");
                            onclick = "onclick=\"openModal('" + alertMsg.replace("'", "\\'") + "','" + name + "','ThirdParty','ServiceWise','" + source + "','" + error + "','" + swThirdHits.get(idx) + "','" + swThirdTd.get(idx) + "','" + time + "','" + transaction + "','" + supurl + "','" + name + "','" + apiName + "')\"";
                        }
                        out.print("<div class='" + cls + "' data-tip='" + tip + "' data-tip-class='" + tipClass + "' " + onclick + ">");
                        out.print("<span class='val'>" + val + "</span>");
                        out.print("<span class='sub-text'>" + sub + "</span>");
                        out.print("<div class='bar'><div class='fill' style='width:" + bar + ";'></div></div>");
                        out.print("</div>");
                    }
                %>
            </div>
        </div>

        <!-- Card 4: I4C·IVR·CAPS -->
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="title"><i class="fas fa-layer-group"></i> I4C·IVR·CAPS</span>
                <span class="badge-count" id="swCombCount">0</span>
            </div>
            <div class="tile-grid" id="sw-comb">
                <%
                    List<Double> swCombPer = new ArrayList<>();
                    List<String> swCombName = new ArrayList<>();
                    List<String> swCombCat = new ArrayList<>();
                    List<String> swCombSource = new ArrayList<>();
                    List<String> swCombError = new ArrayList<>();
                    List<String> swCombHits = new ArrayList<>();
                    List<String> swCombTd = new ArrayList<>();
                    List<String> swCombTime = new ArrayList<>();
                    List<String> swCombTransaction = new ArrayList<>();
                    List<String> swCombSupUrl = new ArrayList<>();

                    try {
                        String q = "select * from (select sup_url,transaction_urn,original_urn, sum(total_hits) as total_hits, sum(td) as td, round(avg(td_percent),2) as td_percent, SUM(SI_EEROR) AS SI_EEROR, error_code,source_id, issue_time from gen5_ThirdParty_servicewise_fail TEMP where trim(CONCAT(temp.sup_url,temp.SOURCE_ID)) not in(select trim(CONCAT(API_NAME,SOURCE_ID)||error_description) from vaild_bd_master) and insert_time >= SYSDATE - INTERVAL '10' minute AND source_id = 'I4' and original_urn not in (select service_name from service_temporary_pause_master where service_name is not null) AND trim(temp.error_code ) not in (select DISTINCT trim(ERRCODE) FROM cbs_err_map WHERE substr(errcode,3,3) NOT in ('002','014') OR errcode in ('SI001','SI007','SI051','SI569','SI570')) GROUP BY sup_url,transaction_urn,original_urn,error_code,source_id,issue_time order by td desc) TEMP where issue_time = (select max(issue_time) from gen5_ThirdParty_servicewise_fail temp_in where temp_in.sup_url = temp.sup_url group by sup_url)";
                        ResultSet rs = con.createStatement().executeQuery(q);
                        while(rs.next()) {
                            if(rs.getDouble("TD") >= 50) {
                                swCombPer.add(rs.getDouble("TD_PERCENT"));
                                swCombName.add(nvl(rs.getString("original_urn"), "N/A"));
                                swCombCat.add("ThirdParty");
                                swCombSource.add(nvl(rs.getString("Source_id"), "N/A"));
                                swCombError.add(nvl(rs.getString("error_code"), "N/A"));
                                swCombHits.add(String.valueOf(rs.getInt("TOTAL_HITS")));
                                swCombTd.add(String.valueOf(rs.getInt("TD")));
                                swCombTime.add(nvl(rs.getString("issue_time"), "N/A"));
                                swCombTransaction.add(nvl(rs.getString("transaction_urn"), "N/A"));
                                swCombSupUrl.add(nvl(rs.getString("sup_url"), "N/A"));
                            }
                        }
                        q = "SELECT * FROM (SELECT api_name, Source_id,error_code,SUM(total_hits) AS total_hits,sum(SUCCESS) as SUCCESS,issue_time,SUM(td) AS td,round(AVG(td_per), 2) AS td_per FROM gen5_ServiceWise_fail TEMP WHERE trim(CONCAT(temp.API_NAME,temp.SOURCE_ID)) not in(select trim(CONCAT(API_NAME,SOURCE_ID)||error_description) from vaild_bd_master) AND substr(api_name,1,3) not in 'gen' AND insert_time >= SYSDATE - INTERVAL '10' minute and Source_id = 'CC' and api_name NOT IN (SELECT service_name FROM service_temporary_pause_master WHERE service_name IS NOT NULL) AND trim(temp.error_code) not in (select DISTINCT trim(ERRCODE) FROM cbs_err_map WHERE substr(errcode,3,3) NOT in ('002','014') OR errcode in ('SI001','SI007','SI051','SI569','SI570')) GROUP BY api_name,Source_id,error_code, issue_time ORDER BY td DESC) TEMP WHERE issue_time =(select max(issue_time) from gen5_ServiceWise_fail temp_in where temp_in.api_name = temp.api_name group by api_name)";
                        rs = con.createStatement().executeQuery(q);
                        while(rs.next()) {
                            if(rs.getDouble("TD") >= 10) {
                                swCombPer.add(rs.getDouble("TD_PER"));
                                swCombName.add(nvl(rs.getString("API_NAME"), "N/A"));
                                swCombCat.add("IVR-Service");
                                swCombSource.add(nvl(rs.getString("Source_id"), "N/A"));
                                swCombError.add(nvl(rs.getString("ERROR_CODE"), "N/A"));
                                swCombHits.add(String.valueOf(rs.getInt("TOTAL_HITS")));
                                swCombTd.add(String.valueOf(rs.getInt("TD")));
                                swCombTime.add(nvl(rs.getString("issue_time"), "N/A"));
                                swCombTransaction.add("N/A");
                                swCombSupUrl.add("N/A");
                            }
                        }
                        q = "SELECT * FROM(SELECT api_name,source_id, error_code,SUM(total_hits) AS total_hits,SUM(success) AS success,issue_time, SUM(td) AS td,round(AVG(TD_PERCENT), 2) AS td_per FROM gen5_SBICABS_servicewise_fail temp WHERE TRIM(concat(temp.api_name, temp.source_id)) NOT IN (SELECT TRIM(concat(api_name, source_id) || error_description) FROM vaild_bd_master) AND trim(temp.error_code ) not in (select DISTINCT ERRCODE FROM cbs_err_map WHERE substr(errcode,3,3) NOT in ('002','014') OR errcode in ('SI001','SI007','SI051','SI569','SI570')) AND substr(api_name, 1, 3) NOT IN 'gen' AND insert_time >= sysdate - INTERVAL '10' MINUTE AND api_name NOT IN (SELECT service_name FROM service_temporary_pause_master WHERE service_name IS NOT NULL) GROUP BY api_name, source_id, error_code, issue_time ORDER BY td DESC) temp WHERE issue_time = (SELECT MAX(issue_time) FROM gen5_SBICABS_servicewise_fail temp_in WHERE temp_in.api_name = temp.api_name GROUP BY api_name)";
                        rs = con.createStatement().executeQuery(q);
                        while(rs.next()) {
                            if(rs.getDouble("TD") >= 10) {
                                swCombPer.add(rs.getDouble("TD_PER"));
                                swCombName.add(nvl(rs.getString("API_NAME"), "N/A"));
                                swCombCat.add("SBICAPS-Service");
                                swCombSource.add(nvl(rs.getString("source_id"), "N/A"));
                                swCombError.add(nvl(rs.getString("ERROR_CODE"), "N/A"));
                                swCombHits.add(String.valueOf(rs.getInt("TOTAL_HITS")));
                                swCombTd.add(String.valueOf(rs.getInt("TD")));
                                swCombTime.add(nvl(rs.getString("issue_time"), "N/A"));
                                swCombTransaction.add("N/A");
                                swCombSupUrl.add("N/A");
                            }
                        }
                        rs.close();

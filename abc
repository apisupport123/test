<%@ page pageEncoding="UTF-8" %>
<%@page import="java.sql.*"%>
<%@page import="com.jdbc.DBUtilityAuto" %>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Service Port Status</title>
    <script src="<%=request.getContextPath()%>/js/portStatus3.6.0jquery.min.js"></script>
    <link rel="stylesheet" href="<%=request.getContextPath()%>/css/portStatusjquery.dataTables.min.css">
    <link rel="stylesheet" href="<%=request.getContextPath()%>/css/portStatusbuttons.dataTables.min.css">
    <script src="<%=request.getContextPath()%>/js/xlsxport.full.min.js"></script>
    <script src="<%=request.getContextPath()%>/js/jspdfport.umd.min.js"></script>
    <script src="<%=request.getContextPath()%>/js/jspdfport.plugin.autotable.min.js"></script>

    <style>
    /* ============ PAGE BASE ============ */
    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--bg) !important;
        color: var(--ink) !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .page-container {
        padding: 28px 32px 48px;
        max-width: 1600px;
        margin: 0 auto;
    }

    /* ============ PAGE HEADER ============ */
    .page-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }
    .page-head .ttl {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 800;
        font-size: 1.65rem;
        letter-spacing: -0.6px;
        color: var(--ink);
        line-height: 1.2;
        margin: 0;
    }
    .page-head .ttl .ttl-icon {
        width: 44px; height: 44px;
        display: grid; place-items: center;
        background: var(--brand-light);
        color: var(--brand);
        border-radius: 12px;
        font-size: 1.05rem;
        flex-shrink: 0;
    }
    html[data-theme="dark"] .page-head .ttl .ttl-icon {
        background: rgba(248,111,3,.15);
    }
    .page-head .sub {
        color: var(--muted);
        font-size: 0.9rem;
        margin: 6px 0 0 56px;
        font-weight: 500;
    }

    /* ============ CONTROLS ============ */
    .controls-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 18px 20px;
        margin-bottom: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,.03);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
    }
    html[data-theme="dark"] .controls-card {
        box-shadow: 0 4px 20px rgba(0,0,0,.3);
    }

    .search-box {
        position: relative;
        flex: 1;
        min-width: 240px;
        max-width: 420px;
    }
    .search-box i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--muted);
        font-size: 0.85rem;
        pointer-events: none;
    }
    .search-box input {
        width: 100%;
        padding: 11px 14px 11px 40px;
        background: var(--bg);
        border: 1.5px solid var(--line);
        border-radius: 11px;
        color: var(--ink);
        font-family: inherit;
        font-size: 0.88rem;
        font-weight: 500;
        outline: none;
        transition: all .2s ease;
    }
    .search-box input::placeholder {
        color: var(--muted);
        opacity: .7;
    }
    .search-box input:focus {
        border-color: var(--brand);
        background: var(--card);
        box-shadow: 0 0 0 4px rgba(248,111,3,.12);
    }

    .btn-group {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
    .btn-action {
        padding: 10px 20px;
        border-radius: 11px;
        font-weight: 700;
        font-size: 0.82rem;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: inherit;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }
    .btn-excel {
        background: #16A34A;
        color: #fff;
        box-shadow: 0 4px 14px -4px #16A34A;
    }
    .btn-excel:hover {
        background: #15803D;
        transform: translateY(-1px);
        box-shadow: 0 8px 22px -6px #16A34A;
    }
    .btn-pdf {
        background: #DC2626;
        color: #fff;
        box-shadow: 0 4px 14px -4px #DC2626;
    }
    .btn-pdf:hover {
        background: #B91C1C;
        transform: translateY(-1px);
        box-shadow: 0 8px 22px -6px #DC2626;
    }

    /* ============ ENTRIES ROW ============ */
    .entries-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 4px 12px 4px;
        gap: 12px;
        flex-wrap: wrap;
    }
    .entries-row .entries {
        color: var(--muted);
        font-size: 0.82rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .entries-row .entries select {
        padding: 7px 12px;
        background: var(--card);
        color: var(--ink);
        border: 1.5px solid var(--line);
        border-radius: 9px;
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        outline: none;
    }
    .entries-row .entries select:focus {
        border-color: var(--brand);
    }

    /* ============ TABLE CARD ============ */
    .table-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,.03);
    }
    html[data-theme="dark"] .table-card {
        box-shadow: 0 4px 20px rgba(0,0,0,.3);
    }

    .table-container {
        overflow-x: auto;
        max-height: 70vh;
        overflow-y: auto;
    }
    .table-container::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }
    .table-container::-webkit-scrollbar-thumb {
        background: var(--line);
        border-radius: 4px;
    }
    .table-container::-webkit-scrollbar-track {
        background: transparent;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: var(--card);
    }

    table thead {
        position: sticky;
        top: 0;
        z-index: 2;
    }

    table th {
        background: var(--bg);
        color: var(--muted);
        font-weight: 800;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 12px 14px;
        text-align: left;
        border-bottom: 1px solid var(--line);
        white-space: nowrap;
    }
    html[data-theme="dark"] table th {
        background: #1A1A1A;
    }

    table td {
        padding: 11px 14px;
        text-align: left;
        border-bottom: 1px solid var(--line);
        color: var(--ink);
        font-size: 0.85rem;
        font-weight: 500;
    }
    table tbody tr:hover {
        background: var(--bg);
    }
    html[data-theme="dark"] table tbody tr:hover {
        background: #1A1A1A;
    }
    table tbody tr:last-child td {
        border-bottom: none;
    }

    /* Filter row inputs */
    .filters td {
        padding: 8px 10px !important;
        background: var(--card);
        border-bottom: 1px solid var(--line);
    }
    .filters input {
        width: 100%;
        padding: 6px 10px;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: 7px;
        color: var(--ink);
        font-family: inherit;
        font-size: 0.78rem;
        font-weight: 500;
        outline: none;
        transition: all .2s ease;
    }
    .filters input::placeholder {
        color: var(--muted);
        opacity: .6;
    }
    .filters input:focus {
        border-color: var(--brand);
        box-shadow: 0 0 0 3px rgba(248,111,3,.1);
    }

    /* ============ PAGINATION ============ */
    .pagination-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-top: 1px solid var(--line);
        background: var(--bg);
        flex-wrap: wrap;
        gap: 12px;
    }
    html[data-theme="dark"] .pagination-row {
        background: #1A1A1A;
    }
    .pagination-info {
        color: var(--muted);
        font-size: 0.8rem;
        font-weight: 600;
    }
    .pagination-btns {
        display: flex;
        gap: 8px;
    }
    .pagination-btns button {
        padding: 8px 18px;
        border-radius: 9px;
        font-weight: 700;
        font-size: 0.8rem;
        border: 1.5px solid var(--line);
        background: var(--card);
        color: var(--ink);
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: inherit;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .pagination-btns button:hover:not(:disabled) {
        background: var(--brand);
        border-color: var(--brand);
        color: #fff;
        transform: translateY(-1px);
    }
    .pagination-btns button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    /* ============ EMPTY STATE ============ */
    .empty-state {
        padding: 60px 20px;
        text-align: center;
        color: var(--muted);
    }
    .empty-state i {
        font-size: 2.5rem;
        color: var(--brand);
        opacity: .4;
        display: block;
        margin-bottom: 12px;
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 900px) {
        .page-container { padding: 20px 16px 32px; }
        .page-head { flex-direction: column; align-items: flex-start; }
        .page-head .ttl { font-size: 1.3rem; }
        .page-head .ttl .ttl-icon { width: 38px; height: 38px; font-size: .9rem; }
        .page-head .sub { margin-left: 50px; font-size: 0.82rem; }
        .controls-card { flex-direction: column; align-items: stretch; }
        .search-box { max-width: 100%; }
        .btn-group { justify-content: flex-start; }
    }
    </style>
</head>
<body>

<%@include file="../userheader.jsp"%>

<div class="new-wrapper">
<div class="page-container">

    <!-- ============ PAGE HEADER ============ -->
    <div class="page-head">
        <div>
            <h1 class="ttl">
                <span class="ttl-icon"><i class="fas fa-signal"></i></span>
                Service Port Status
            </h1>
            <p class="sub">Monitor stopped &amp; running port services across brokers</p>
        </div>
    </div>

    <!-- ============ CONTROLS ============ -->
    <div class="controls-card">
        <div class="search-box">
            <i class="fas fa-magnifying-glass"></i>
            <input type="text" id="globalSearch" placeholder="Global search across all columns...">
        </div>
        <div class="btn-group">
            <button class="btn-action btn-excel" onclick="downloadExcel()">
                <i class="fas fa-file-excel"></i> Excel
            </button>
            <button class="btn-action btn-pdf" onclick="downloadPDF()">
                <i class="fas fa-file-pdf"></i> PDF
            </button>
        </div>
    </div>

    <!-- ============ ENTRIES ROW ============ -->
    <div class="entries-row">
        <div class="entries">
            Show
            <select id="entriesSelect" onchange="updateEntries()">
                <option value="10">10</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="all">All</option>
            </select>
            entries
        </div>
    </div>

    <!-- ============ TABLE ============ -->
    <div class="table-card">
        <div class="table-container">
            <table id="dataTable">
                <thead>
                    <tr>
                        <th>SERVER_ID</th>
                        <th>PORT</th>
                        <th>BROKER</th>
                        <th>SERVICE</th>
                        <th>STOPPED_EG</th>
                        <th>RUNNING_EG</th>
                        <th>Time</th>
                    </tr>
                    <tr class="filters">
                        <td><input type="text" placeholder="Search SERVER_ID" onkeyup="filterTable()"></td>
                        <td><input type="text" placeholder="Search PORT" onkeyup="filterTable()"></td>
                        <td><input type="text" placeholder="Search BROKER" onkeyup="filterTable()"></td>
                        <td><input type="text" placeholder="Search SERVICE" onkeyup="filterTable()"></td>
                        <td><input type="text" placeholder="Search STOPPED_EG" onkeyup="filterTable()"></td>
                        <td><input type="text" placeholder="Search RUNNING_EG" onkeyup="filterTable()"></td>
                        <td><input type="text" placeholder="Search Time" onkeyup="filterTable()"></td>
                    </tr>
                </thead>
                <tbody>
                <%
                    Connection conn = DBUtilityAuto.getReportDBConnection();
                    PreparedStatement smt1 = null, smt2 = null;
                    ResultSet rs = null, rs1 = null;
                    try {
                        String sql = "select * from portstatus where service_status='stopped.' order by server_id";
                        System.out.println(sql);
                        smt1 = conn.prepareStatement(sql);
                        rs = smt1.executeQuery();
                        boolean hasRows = false;
                        while(rs.next()){
                            hasRows = true;
                            String server = rs.getString("SERVER_ID");
                            String port = rs.getString("PORT");
                            String broker = rs.getString("BROKER");
                            String eg = rs.getString("EG");
                            String service = rs.getString("SERVICE");
                            String Status = rs.getString("SERVICE_STATUS");
                            String time = rs.getString("INSERT_TIME");
                            Connection con = DBUtilityAuto.getReportDBConnection();
                            String query = "select * from portstatus where server_id='"+server+"' and BROKER='"+broker+"' and SERVICE='"+service+"' and service_status='running.'";
                            smt2 = con.prepareStatement(query);
                            rs1 = smt2.executeQuery();
                            String runningStatus = null, RunningEG = null;
                            while(rs1.next()) {
                                RunningEG = rs1.getString("EG");
                                runningStatus = rs1.getString("SERVICE_STATUS");
                            }
                            rs1.close();
                            smt2.close();
                            con.close();
                %>
                    <tr>
                        <td><%= server %></td>
                        <td><%= port %></td>
                        <td><%= broker %></td>
                        <td><%= service %></td>
                        <td><%= eg %></td>
                        <td><%= RunningEG %></td>
                        <td><%= time %></td>
                    </tr>
                <%
                        }
                        if(!hasRows) {
                %>
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <i class="fas fa-circle-check"></i>
                                <div>All services are running — no stopped ports found.</div>
                            </div>
                        </td>
                    </tr>
                <%
                        }
                    } catch(Exception e) {
                        e.printStackTrace();
                    } finally {
                        try {
                            if(rs1 != null) rs1.close();
                            if(smt2 != null) smt2.close();
                            if(rs != null) rs.close();
                            if(smt1 != null) smt1.close();
                            if(conn != null) conn.close();
                        } catch(Exception e) {
                            e.printStackTrace();
                        }
                    }
                %>
                </tbody>
            </table>
        </div>

        <!-- ============ PAGINATION ============ -->
        <div class="pagination-row">
            <div class="pagination-info" id="paginationInfo">Showing 0 of 0 entries</div>
            <div class="pagination-btns">
                <button id="prevPage" onclick="changePage(-1)" disabled>
                    <i class="fas fa-chevron-left"></i> Previous
                </button>
                <button id="nextPage" onclick="changePage(1)">
                    Next <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>

</div>
</div>

<script>
    /* ============ GLOBAL SEARCH ============ */
    const globalSearch = document.getElementById('globalSearch');
    globalSearch.addEventListener('input', () => {
        const value = globalSearch.value.toLowerCase();
        const rows = document.querySelectorAll('#dataTable tbody tr');
        rows.forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(value) ? '' : 'none';
        });
    });

    /* ============ PAGINATION STATE ============ */
    let currentPage = 1;
    let rowsPerPage = 10;

    window.onload = function () {
        const entriesSelect = document.getElementById('entriesSelect');
        entriesSelect.value = '10';
        paginateTable();
    };

    function updateEntries() {
        const select = document.getElementById('entriesSelect').value;
        if (select === 'all') {
            rowsPerPage = Infinity;
        } else {
            rowsPerPage = parseInt(select);
        }
        currentPage = 1;
        paginateTable();
    }

    function filterTable() {
        const inputs = document.querySelectorAll('.filters input');
        const rows = document.querySelectorAll('#dataTable tbody tr');
        rows.forEach(row => {
            let isVisible = true;
            inputs.forEach((input, index) => {
                const value = input.value.toLowerCase();
                const cell = row.cells[index];
                if (cell && !cell.textContent.toLowerCase().includes(value)) {
                    isVisible = false;
                }
            });
            row.style.display = isVisible ? '' : 'none';
        });
    }

    function paginateTable() {
        const rows = document.querySelectorAll('#dataTable tbody tr');
        const totalRows = rows.length;
        const info = document.getElementById('paginationInfo');

        if (rowsPerPage === Infinity) {
            rows.forEach(row => { row.style.display = ''; });
            document.getElementById('prevPage').disabled = true;
            document.getElementById('nextPage').disabled = true;
            info.textContent = 'Showing all ' + totalRows + ' entries';
            return;
        }

        const start = (currentPage - 1) * rowsPerPage;
        const end = Math.min(currentPage * rowsPerPage, totalRows);

        rows.forEach((row, index) => {
            row.style.display = (index >= start && index < end) ? '' : 'none';
        });

        document.getElementById('prevPage').disabled = currentPage === 1;
        document.getElementById('nextPage').disabled = end >= totalRows;

        const showStart = totalRows === 0 ? 0 : start + 1;
        info.textContent = 'Showing ' + showStart + '–' + end + ' of ' + totalRows + ' entries';
    }

    function changePage(direction) {
        currentPage += direction;
        paginateTable();
    }

    /* ============ EXPORT EXCEL ============ */
    function downloadExcel() {
        let table = document.getElementById("dataTable");
        let wb = XLSX.utils.book_new();
        let ws = XLSX.utils.table_to_sheet(table);
        XLSX.utils.book_append_sheet(wb, ws, "Port Status");
        XLSX.writeFile(wb, "port_status.xlsx");
    }

    /* ============ EXPORT PDF ============ */
    function downloadPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        doc.text("Port Status Report", 10, 10);

        let table = document.getElementById("dataTable");
        let headers = [];
        let rows = [];

        table.querySelectorAll("thead tr:first-child th").forEach(th => headers.push(th.innerText));

        table.querySelectorAll("tbody tr").forEach(tr => {
            let row = [];
            tr.querySelectorAll("td").forEach(td => row.push(td.innerText));
            if (row.length > 1) rows.push(row);
        });

        doc.autoTable({
            head: [headers],
            body: rows,
            startY: 20
        });

        doc.save("port_status.pdf");
    }
</script>

</body>
</html>

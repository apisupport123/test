<style>
/* ================================================================
   THEME-AWARE OVERRIDES
   ================================================================ */
body {
    background-color: var(--bg) !important;
    color: var(--ink) !important;
    margin: 0 !important;
    padding: 0 !important;
    transition: background .3s ease, color .3s ease;
}

.topnav {
    background: var(--topnav-bg) !important;
    border-bottom: 1px solid var(--line) !important;
}
.topnav .tn-search {
    background: var(--card) !important;
    border-color: var(--line) !important;
    color: var(--muted) !important;
}
.topnav .tn-search:hover {
    border-color: var(--brand) !important;
    color: var(--ink) !important;
}
.topnav .tn-search .kbd {
    background: var(--sidebar-hover) !important;
    border-color: var(--line) !important;
    color: var(--muted) !important;
}
.topnav .tn-menu-btn {
    background: var(--sidebar-hover) !important;
    border-color: var(--line) !important;
    color: var(--ink) !important;
}
.topnav .tn-menu-btn:hover {
    background: var(--brand) !important;
    border-color: var(--brand) !important;
    color: #fff !important;
}
.topnav .tn-btn {
    background: transparent !important;
    border-color: var(--line) !important;
    color: var(--ink) !important;
}
.topnav .tn-btn:hover {
    background: var(--brand) !important;
    border-color: var(--brand) !important;
    color: #fff !important;
}
.topnav .tn-toggle {
    border-color: var(--line) !important;
    color: var(--ink) !important;
}

/* ================================================================
   WRAPPER — full height flex column
   ================================================================ */
.new-wrapper {
    padding-top: 64px !important;
    margin-left: 260px !important;
    background-color: var(--bg);
    display: flex;
    flex-direction: column;
    height: 100vh;
    box-sizing: border-box;
    transition: margin-left .3s cubic-bezier(.4,0,.2,1), background .3s ease;
}
html.sb-collapsed .new-wrapper {
    margin-left: 0 !important;
}

/* ================================================================
   TOP STRIP
   ================================================================ */
.tx-top-strip {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 10px 20px;
    background: var(--card);
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
}

.tx-timer-block {
    display: flex;
    align-items: center;
    gap: 12px;
}
.tx-timer-label {
    font-size: 13px;
    font-weight: 800;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.25;
}
.tx-timer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 100px;
    padding: 6px 14px;
    border: 3px solid var(--brand);
    border-radius: 8px;
    color: var(--brand) !important;
    font-family: 'Courier New', monospace;
    font-size: 28px;
    font-weight: 900;
    background: var(--brand-light);
    letter-spacing: 1px;
    line-height: 1;
}
html[data-theme="dark"] .tx-timer {
    background: rgba(248,111,3,.15);
}

/* KPI row */
.tx-kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    min-width: 0;
}
.tx-kpi {
    background: var(--card);
    padding: 8px 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
}
.tx-kpi-label {
    font-size: 10px;
    font-weight: 800;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    white-space: nowrap;
}
.tx-kpi-value {
    font-family: 'Courier New', monospace;
    font-size: 30px;
    font-weight: 900;
    line-height: 1;
    margin-top: 3px;
    color: var(--ink);
    letter-spacing: -1px;
}
/* ✅ 3-level palette */
.tx-kpi-value.red    { color: #ff1a1a; }
.tx-kpi-value.orange { color: #f59e0b; }
.tx-kpi-value.green  { color: #10b981; }

.tx-blink-red {
    animation: txBlinkRed 1.4s ease-in-out infinite;
}
@keyframes txBlinkRed {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.4; }
}

/* Right block */
.tx-right-block {
    display: flex;
    align-items: center;
    gap: 10px;
}
.tx-sev-chips { display: flex; gap: 6px; }
.tx-sev-chip {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    color: var(--ink);
    white-space: nowrap;
}
.tx-sev-dot {
    width: 9px;
    height: 9px;
    border-radius: 2px;
}

.tx-live-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    background: rgba(16, 185, 129, 0.14);
    border: 1px solid rgba(16, 185, 129, 0.4);
    border-radius: 6px;
    font-size: 12px;
    font-weight: 800;
    color: #10b981;
    letter-spacing: 1.5px;
}
.tx-live-badge .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    animation: txPulse 1.6s infinite;
}
@keyframes txPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: .4; transform: scale(.8); }
}

.tx-theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: var(--card);
    border: 1px solid var(--line);

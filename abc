package com.action;

import java.sql.Connection;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;

import org.apache.struts2.ActionSupport;
import org.apache.struts2.action.Action;
import org.apache.struts2.dispatcher.mapper.ActionMapping;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;
import com.actionform.KPIActionFoms;
import com.jdbc.DBUtilityAuto;

@SuppressWarnings("serial")
public class UserHomeScreenAction extends ActionSupport {
	public String execute(ActionMapping mapping, Action form, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		KPIActionFoms l_obj = (KPIActionFoms) form;
		HttpSession session = request.getSession(false);
		String m_strrole = (String) session.getAttribute("role");
		System.out.print("Role: " + m_strrole);
		if(m_strrole==null || m_strrole.equals("")) {
			return "session";
		}
		this.showrolewisemenu(l_obj, request, m_strrole);
		return "success";
	}

	private void showrolewisemenu(KPIActionFoms l_obj, HttpServletRequest request, String Role) throws SQLException {
		//Connection con = DBUtility.getReportDBConnection();
		Connection con = DBUtilityAuto.getReportDBConnection();
		Statement l_objstatement = null;
		ResultSet l_bjres = null;
		try {
			String query = "select role_id  from rolemst where rolename='" + Role + "'";
			System.out.print("New:" + query);
			l_objstatement = con.createStatement();
			l_bjres = l_objstatement.executeQuery(query);
			if (l_bjres != null) {
				while (l_bjres.next()) {
					Role = l_bjres.getString("role_id");

				}
			}
			query = "select * from rolewisesettingmst where Role='" + Role + "'";
			System.out.print("New:" + query);
			l_objstatement = con.createStatement();
			l_bjres = l_objstatement.executeQuery(query);
			if (l_bjres != null) {
				while (l_bjres.next()) {

					l_obj.setM_strflagKPI(l_bjres.getString("KPI"));
					l_obj.setM_strflagReports(l_bjres.getString("Reports"));
					l_obj.setM_strflagExpMonitoringPortal(l_bjres.getString("ExpMonitoringPortal"));
					l_obj.setM_strflagSYSMonitoringPortal(l_bjres.getString("SYSMonitoringPortal"));
					l_obj.setM_strflagTop20Service(l_bjres.getString("Top20Service"));
					l_obj.setM_strflagEPayAndVAN(l_bjres.getString("EPayAndVAN"));
					l_obj.setM_strflagAdharVault(l_bjres.getString("AdharVault"));
					l_obj.setM_strflaghundreadpercentagefailure(l_bjres.getString("hundreadpercentagefailure"));
					l_obj.setM_strflagEISAPPIssue(l_bjres.getString("EISAPPIssue"));
					l_obj.setM_strflagSearchGen5Referenceno(l_bjres.getString("SearchGen5Referenceno"));
					l_obj.setM_strAdochChecklist(l_bjres.getString("ADOCH_CHECKLIST"));
					l_obj.setM_strScoreChecklist(l_bjres.getString("SCORE_CHECKLIST"));
					l_obj.setM_strMonitoringChecklist(l_bjres.getString("MONITORING_CHECKLIST"));
					l_obj.setM_strMailsChecklist(l_bjres.getString("MAILS_CHECKLIST"));
					l_obj.setM_strProblemChecklist(l_bjres.getString("PROBLEM_CHECKLIST"));;
					l_obj.setM_strdeploymentsheet(l_bjres.getString("deployment_sheet"));
					String arr[] = l_bjres.getString("SOP_Read_Write").split("/");
					l_obj.setM_strflagSOP_Read(arr[0]);
					l_obj.setM_strflagSOP_Write(arr[1]);
				}
			}
		} catch (Exception e) {
			e.printStackTrace();
		} finally {
			if (l_bjres != null) {
				l_bjres.close();

			}
			if (l_objstatement != null) {
				l_objstatement.close();

			}
			if (con != null) {
				con.close();

			}
		}
	}
}

   <html:form action="/ViewEisRegistrationDetails" method="post">
   <%@ include file="./header.jsp" %>
   <div class="container">
   <h1 class="text-center mb-4">EIS Registration Details</h1>
   <!-- Message Alerts -->
   <logic:equal name="RegForm" property="m_strmsg" value="error">
   <div class="alert alert-danger text-center" role="alert">
   <i class="fas fa-exclamation-circle"></i> Something went wrong. Please try again!
   </div>
   </logic:equal>
   <logic:equal name="RegForm" property="m_strmsg" value="delete">
   <div class="alert alert-success text-center" role="alert">
   <i class="fas fa-check-circle"></i> Employee record deleted successfully.
   </div>
   </logic:equal>
   <!-- Data Table -->
   <div class="table-responsive" id="tbl_exporttable_to_xls">
   <table id="myTable" class="table table-striped table-bordered table-hover">
   <thead class="table-light">
   <tr>
   <th>Emp ID</th>
   <th>AD ID</th>
   <th>Active</th>
   <th>Asset ID</th>
   <th>HID</th>
   <th>Education</th>
   <th>Joining Date</th>
   <th>Contact</th>
   <th>Emergency</th>
   <th>Team</th>
   <th>TCS Mail</th>
   <th>SBI Mail</th>
   <th>State</th>
   <th>City</th>
   <th>Address</th>
   <th>Gender</th>
   <th>DOB</th>
   <th>First</th>
   <th>Middle</th>
   <th>Last</th>
   <th>BGC</th>
   <th>Photo</th>
   <th>Police</th>
   <th>VPN Hostname</th>
   <th>Laptop Hostname</th>
   <th>Remote Type</th>
   <th>MAC</th>
   <th>IP</th>
   <th>CV</th>
   <th>Username</th>
   <th>Password</th>
   <th>Delete</th>
   <th>Edit</th>
   </tr>
   </thead>
   <tbody>
   <logic:iterate id="list" name="RegForm" property="m_lstViewEmployeeRegistrationdetail">
   <bean:define id="empId" name="list" property="m_strEmployee_ID" type="java.lang.String" />
   <tr>
   <td><bean:write name="list" property="m_strEmployee_ID"/></td>
   <td><bean:write name="list" property="m_strAD_ID"/></td>
   <td><bean:write name="list" property="m_strISACTIVE"/></td>
   <td><bean:write name="list" property="m_strAsset_ID"/></td>
   <td><bean:write name="list" property="m_strHID"/></td>
   <td><bean:write name="list" property="m_strEducation_Qualification"/></td>
   <td><bean:write name="list" property="m_strTCS_Joining_Date"/></td>
   <td><bean:write name="list" property="m_strEmployee_contact_Number"/></td>
   <td><bean:write name="list" property="m_strEmergency_contact_Number"/></td>
   <td><bean:write name="list" property="m_strTeam"/></td>
   <td><bean:write name="list" property="m_strTCS_mail_ID"/></td>
   <td><bean:write name="list" property="m_strSBI_mail_ID"/></td>
   <td><bean:write name="list" property="m_strState"/></td>
   <td><bean:write name="list" property="m_strCity"/></td>
   <td><bean:write name="list" property="m_strLocal_Address"/></td>
   <td><bean:write name="list" property="m_strGender"/></td>
   <td><bean:write name="list" property="m_strDate_Of_Birth"/></td>
   <td><bean:write name="list" property="m_strFirst_Name"/></td>
   <td><bean:write name="list" property="m_strMiddle_Name"/></td>
   <td><bean:write name="list" property="m_strLast_Name"/></td>
   <!-- BGC -->
   <td>
   <logic:equal name="list" property="m_strBGC_Documents_Path" value="Uploaded">
   <a href="<%= request.getContextPath() %>/DocumentDownloadServlet?empid=<bean:write name='list' property='m_strEmployee_ID' />&amp;type=BGC" target="_blank">View BGC</a>
   </logic:equal>
   <logic:notEqual name="list" property="m_strBGC_Documents_Path" value="Uploaded">
   No BGC
   </logic:notEqual>
   </td>
   <!-- Photo -->
   <td>
   <logic:equal name="list" property="m_strPhoto_Path" value="Uploaded">
   <a href="<%= request.getContextPath() %>/DocumentDownloadServlet?empid=<bean:write name='list' property='m_strEmployee_ID' />&amp;type=PHOTO" target="_blank">View Photo</a>
   </logic:equal>
   <logic:notEqual name="list" property="m_strPhoto_Path" value="Uploaded">
   No Photo
   </logic:notEqual>
   </td>
   <!-- Police Verification -->
   <td>
   <logic:equal name="list" property="m_strPolice_Verification_Path" value="Uploaded">
   <a href="<%= request.getContextPath() %>/DocumentDownloadServlet?empid=<bean:write name='list' property='m_strEmployee_ID' />&amp;type=POLICE" target="_blank">View Police Verification</a>
   </logic:equal>
   <logic:notEqual name="list" property="m_strPolice_Verification_Path" value="Uploaded">
   No Police
   </logic:notEqual>
   </td>
   <td><bean:write name="list" property="m_strVPN_Hostname"/></td>
   <td><bean:write name="list" property="m_strLaptop_Hostname"/></td>
   <td><bean:write name="list" property="m_strRemote_Type"/></td>
   <td><bean:write name="list" property="m_strVPN_VDI_MAC_Address"/></td>
   <td><bean:write name="list" property="m_strVPN_VDI_IP_Address"/></td>
   <!-- CV -->
   <td>
   <logic:equal name="list" property="m_strCV_Document" value="Uploaded">
   <a href="<%= request.getContextPath() %>/DocumentDownloadServlet?empid=<bean:write name='list' property='m_strEmployee_ID' />&amp;type=CV" target="_blank">View CV</a>
   </logic:equal>
   <logic:notEqual name="list" property="m_strCV_Document" value="Uploaded">
   No CV
   </logic:notEqual>
   </td>
   <td><bean:write name="list" property="m_strUserName"/></td>
   <td><bean:write name="list" property="m_strPassword"/></td>
   <!-- Delete button -->
   <td>
   <button class="btn btn-danger btn-sm" onclick="deleterecord('<%= empId %>')">
   <i class="fas fa-trash-alt"></i> Delete
   </button>
   </td>
   <!-- Edit button -->
   <td>
   <button class="btn btn-primary btn-sm" onclick="editrecord('<%= empId %>')">
   <i class="fas fa-edit"></i> Edit
   </button>
   </td>
   </tr>
   </logic:iterate>
   </tbody>
   </table>
   </div>
   <div class="text-center">
   <button class="btn-export" onclick="ExportToExcel('xlsx', 'Employee_Details.xlsx')">
   <i class="fas fa-file-excel"></i> Export to Excel
   </button>
   </div>
   </div>
   </html:form>
   </body>
   </html>



        borderColor: "#333",
        borderWidth: "1px",
        guide: { visible: false },
        item: { fontColor: "#fff", fontSize: "30px" },
        tick: { alpha: 0.2, lineColor: "#333" },
        label: {
            text: '<p style="color:#ff9933;">TD FAILURE, </p><p style="color:#FFFFFF;"> END POINT, </p><p style="color:#32CD32;">TOTAL HITS</p>',
            color: "red",

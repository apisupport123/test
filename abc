	public static String uploadFile(HttpServletRequest request, File ff, RegistrationActionForm l_obj,
			String filePath) {

		String newPhotoName = "";

		try {

			InputStream stream = ((ServletRequest) ff).getInputStream();
			String oldPhotoName = ff.getName();

			newPhotoName = Math.random() + "_" + oldPhotoName.substring(0, oldPhotoName.indexOf("."))
					+ oldPhotoName.substring(oldPhotoName.indexOf("."), oldPhotoName.length());
			System.out.print("New File Name:" + newPhotoName);
			String newFullNewPath = filePath;

			File f = new File(newFullNewPath);
			if (!f.isDirectory()) {

				f.mkdirs();

			}

			OutputStream bos = new FileOutputStream(newFullNewPath + newPhotoName);
			int len = 0;
			byte[] buffer = new byte[8192];
			while ((len = stream.read(buffer, 0, 8192)) != -1) {
				bos.write(buffer, 0, len);
			}
			bos.close();
			stream.close();

		} catch (Exception e) {
			l_obj.setM_strmsg("Error");
			e.printStackTrace();
		}
		return newPhotoName;
	}

	private void getEISRole(RegistrationActionForm l_obj) throws SQLException {
		Connection con = DBUtilityAuto.getReportDBConnection();
		Statement l_objstatement = null;
		ResultSet l_bjres = null;
		try {
			ArrayList<String> list = new ArrayList<String>();
			list.add(0, "Select Role");
			String query = "select rolename from rolemst";
			// System.out.print("New:" + query);
			l_objstatement = con.createStatement();
			l_bjres = l_objstatement.executeQuery(query);
			if (l_bjres != null) {
				while (l_bjres.next()) {
					list.add(l_bjres.getString("rolename"));
				}
			}

			l_obj.setRolelist(list);
		} catch (Exception e) {
			e.printStackTrace();
		} finally {
			if (l_bjres != null) {
				l_bjres.close();
			}
			if (l_objstatement != null) {
				l_objstatement.close();
			}
			if (con != null) {
				con.close();

			}
		}

	}

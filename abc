.hero-stat .hs-icon{
  width:32px;height:32px;border-radius:9px;
  background:rgba(244,180,0,.2);color:var(--sbi-gold);
  display:grid;place-items:center;margin-bottom:10px;
}
.hero-stat .hs-icon .icon-svg{width:16px;height:16px}
.hero-stat .hs-num{
  font-size:1.4rem;font-weight:900;
  color:#fff;letter-spacing:-.5px;line-height:1;
}
.hero-stat .hs-lbl{
  font-size:.65rem;font-weight:700;
  color:rgba(255,255,255,.6);
  text-transform:uppercase;letter-spacing:.5px;
  margin-top:4px;
}

.news-ticker{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:14px;
  padding:12px 20px;
  margin-bottom:24px;
  display:flex;align-items:center;gap:16px;
  overflow:hidden;position:relative;
}
.news-ticker .nt-label{
  display:flex;align-items:center;gap:8px;
  color:var(--sbi-blue);
  font-size:.72rem;font-weight:900;
  text-transform:uppercase;letter-spacing:1px;
  flex-shrink:0;padding-right:16px;
  border-right:1px solid var(--line);
}
html[data-theme="dark"] .news-ticker .nt-label{color:var(--sbi-gold)}
.news-ticker .nt-label .dot{
  width:8px;height:8px;border-radius:50%;
  background:#E53935;
  animation:pulse 1.5s ease-in-out infinite;
  box-shadow:0 0 8px #E53935;
}
.news-ticker .nt-scroll{
  flex:1;overflow:hidden;white-space:nowrap;
}
.news-ticker .nt-text{
  display:inline-block;
  animation:scroll 40s linear infinite;
  font-size:.78rem;font-weight:700;
  color:var(--ink);
}
.news-ticker .nt-text span{
  margin-right:48px;
  display:inline-flex;align-items:center;gap:8px;
}
.news-ticker .nt-text span::before{
  content:"●";color:var(--sbi-gold);font-size:.6rem;
}
@keyframes scroll{
  from{transform:translateX(100%);}
  to{transform:translateX(-100%);}
}

.section-title{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:16px;
}
.section-title h2{
  font-size:1rem;font-weight:900;color:var(--ink);
  text-transform:uppercase;letter-spacing:.8px;
  display:flex;align-items:center;gap:10px;
}
.section-title h2 .icon-svg{color:var(--sbi-blue);width:18px;height:18px}
html[data-theme="dark"] .section-title h2 .icon-svg{color:var(--sbi-gold)}

.quick-actions{
  display:grid;grid-template-columns:repeat(4, 1fr);
  gap:16px;margin-bottom:28px;
}
.qa-card{
  background:var(--card);
  border:1.5px solid var(--line);
  border-radius:16px;
  padding:22px 20px;
  display:flex;flex-direction:column;gap:12px;
  transition:all .25s ease;cursor:pointer;
  position:relative;overflow:hidden;
}
.qa-card:hover{
  border-color:var(--sbi-blue);
  transform:translateY(-4px);
  box-shadow:0 16px 40px -12px rgba(0,58,112,.25);
}
.qa-card:hover .qa-icon{
  background:var(--sbi-blue);color:#fff;transform:scale(1.08);
}
.qa-card:hover .qa-arrow{
  opacity:1;transform:translateX(4px);color:var(--sbi-blue);
}
.qa-icon{
  width:48px;height:48px;border-radius:14px;
  background:var(--sbi-gold-light);color:var(--sbi-blue);
  display:grid;place-items:center;transition:all .25s ease;
}
html[data-theme="dark"] .qa-icon{
  background:rgba(244,180,0,.15);color:var(--sbi-gold);
}
.qa-icon .icon-svg{width:22px;height:22px;stroke-width:2.2}
.qa-title{
  font-size:.92rem;font-weight:800;color:var(--ink);
  display:flex;align-items:center;gap:6px;
}
.qa-arrow{
  opacity:0;transition:all .2s ease;color:var(--muted);
}
.qa-arrow .icon-svg{width:14px;height:14px}
.qa-desc{
  font-size:.72rem;color:var(--muted);font-weight:600;line-height:1.4;
}

.services-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));
  gap:14px;margin-bottom:32px;
}
.service-card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:14px;
  padding:16px 18px;
  display:flex;align-items:center;gap:14px;
  transition:all .2s ease;cursor:pointer;text-decoration:none;
}
.service-card:hover{
  border-color:var(--sbi-blue);
  background:var(--sbi-gold-light);
  transform:translateX(4px);
  box-shadow:0 8px 20px -8px rgba(0,58,112,.15);
}
html[data-theme="dark"] .service-card:hover{
  background:rgba(244,180,0,.08);
}
.service-card:hover .sv-icon{
  background:var(--sbi-blue);color:#fff;
}
.sv-icon{
  width:40px;height:40px;border-radius:11px;
  background:var(--sbi-gold-light);color:var(--sbi-blue);
  display:grid;place-items:center;flex-shrink:0;
  transition:all .2s ease;
}
html[data-theme="dark"] .sv-icon{
  background:rgba(244,180,0,.15);color:var(--sbi-gold);
}
.sv-icon .icon-svg{width:18px;height:18px;stroke-width:2.2}
.sv-text{flex:1;min-width:0;}
.sv-name{
  font-size:.85rem;font-weight:800;color:var(--ink);line-height:1.3;
}
.sv-sub{
  font-size:.68rem;color:var(--muted);font-weight:600;
  margin-top:3px;text-transform:uppercase;letter-spacing:.3px;
}

.foot{
  margin-top:40px;padding-top:24px;
  border-top:1px solid var(--line);
  display:flex;justify-content:space-between;align-items:center;
  font-size:.75rem;color:var(--muted);font-weight:700;
  flex-wrap:wrap;gap:12px;
}
.foot b{color:var(--sbi-blue)}
html[data-theme="dark"] .foot b{color:var(--sbi-gold)}

@media (max-width:1100px){
  .quick-actions{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:900px){
  .sidebar{transform:translateX(-100%)}
  html.sb-open .sidebar{transform:translateX(0)}
  .topnav{left:0}
  .tn-toggle{display:grid;place-items:center}
  .tn-menu-btn{display:none}
  .new-wrapper{margin-left:0}
  .sb-collapse-btn{display:none}
  .banker-dash{padding:20px 16px 40px}
  .bank-hero{padding:28px 24px}
  .bank-hero-text h1{font-size:1.6rem}
  .quick-actions{grid-template-columns:1fr}
}

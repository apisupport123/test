        fontFamily: "Times New Roman",
    },
    plotarea: {
        alpha: 0.3,
        backgroundColor: "#000000",
        margin: "50px 35px 250px 200px",
    },
    scaleX: {
        values: [<%
            if(labels.size()<=5){
                for(String label: labels){
                    out.print("\""+label+"\",");
                }
                for(int i=labels.size();i<5;i++)
                {
                    out.print("\""+" "+"\",");
                }
            }

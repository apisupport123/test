            <!-- JS dependencies -->
           <!--  <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
            <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script> -->
            <script src="./js/jquery-3.7.0.min.js"></script>
            <script src="./js/bootstrap.bundle.minV5.3.3.js"></script>
            <script src="./js/cdn.datatables.net_1.13.6_jquery.dataTables.min.js"></script>
            <script src="./js/cdn.datatables.net_1.13.6_dataTables.bootstrap5.min.js"></script>
            <script src="./js/dist_xlsx.full.min.js"></script>
            <script type="text/javascript">
            $(document).ready(function () {
            	  // Check if the table is already initialized
            	  if (!$.fn.DataTable.isDataTable('#myTable')) {
            	    $('#myTable').DataTable({
            	      responsive: true,
            	      lengthMenu: [
            	        [10, 25, 50, -1],
            	        [10, 25, 50, 'All']
            	      ],
            	      pageLength: 10, // Set to -1 to show all records by default
            	      language: {
            	        search: "_INPUT_",
            	        searchPlaceholder: "Search records"
            	      }
            	    });
            	  }
            	});

               
                   function ExportToExcel(type, filename) {
                       var elt = document.getElementById('tbl_exporttable_to_xls');
                       var wb = XLSX.utils.table_to_book(elt, { sheet: "Sheet1" });
                       XLSX.writeFile(wb, filename || ('Employee_Details.' + (type || 'xlsx')));
                   }
               
                   function deleterecord(employeeID) {
                       document.forms[0].action = '<%= request.getContextPath() %>/ViewEisRegistrationDetails.do?action=delete&empid=' + employeeID;
                       document.forms[0].submit();
                   }
               
                   function editrecord(employeeID) {
                       document.forms[0].action = '<%= request.getContextPath() %>/jsp/EditProfile.jsp?action=edit&empid=' + employeeID;
                       document.forms[0].submit();
                   }
            </script>
   </head>
   <body>
   <html:form action="/ViewEisRegistrationDetails" method="post">
   <%@ include file="./header.jsp" %>
   <div class="container">
   <h1 class="text-center mb-4">EIS Registration Details</h1>
   <!-- Message Alerts -->
   <logic:equal name="RegForm" property="m_strmsg" value="error">
   <div class="alert alert-danger text-center" role="alert">
   <i class="fas fa-exclamation-circle"></i> Something went wrong. Please try again!
   </div>
   </logic:equal>
   <logic:equal name="RegForm" property="m_strmsg" value="delete">
   <div class="alert alert-success text-center" role="alert">
   <i class="fas fa-check-circle"></i> Employee record deleted successfully.
   </div>
   </logic:equal>
   <!-- Data Table -->
   <div class="table-responsive" id="tbl_exporttable_to_xls">
   <table id="myTable" class="table table-striped table-bordered table-hover">
   <thead class="table-light">
   <tr>
   <th>Emp ID</th>
   <th>AD ID</th>
   <th>Active</th>
   <th>Asset ID</th>
   <th>HID</th>
   <th>Education</th>
   <th>Joining Date</th>
   <th>Contact</th>
   <th>Emergency</th>
   <th>Team</th>
   <th>TCS Mail</th>
   <th>SBI Mail</th>
   <th>State</th>
   <th>City</th>
   <th>Address</th>
   <th>Gender</th>
   <th>DOB</th>
   <th>First</th>
   <th>Middle</th>
   <th>Last</th>
   <th>BGC</th>
   <th>Photo</th>
   <th>Police</th>
   <th>VPN Hostname</th>
   <th>Laptop Hostname</th>
   <th>Remote Type</th>
   <th>MAC</th>
   <th>IP</th>
   <th>CV</th>
   <th>Username</th>
   <th>Password</th>
   <th>Delete</th>
   <th>Edit</th>
   </tr>
   </thead>
   <tbody>
   <logic:iterate id="list" name="RegForm" property="m_lstViewEmployeeRegistrationdetail">
   <bean:define id="empId" name="list" property="m_strEmployee_ID" type="java.lang.String" />
   <tr>
   <td><bean:write name="list" property="m_strEmployee_ID"/></td>
   <td><bean:write name="list" property="m_strAD_ID"/></td>
   <td><bean:write name="list" property="m_strISACTIVE"/></td>
   <td><bean:write name="list" property="m_strAsset_ID"/></td>
   <td><bean:write name="list" property="m_strHID"/></td>
   <td><bean:write name="list" property="m_strEducation_Qualification"/></td>
   <td><bean:write name="list" property="m_strTCS_Joining_Date"/></td>
   <td><bean:write name="list" property="m_strEmployee_contact_Number"/></td>
   <td><bean:write name="list" property="m_strEmergency_contact_Number"/></td>
   <td><bean:write name="list" property="m_strTeam"/></td>
   <td><bean:write name="list" property="m_strTCS_mail_ID"/></td>
   <td><bean:write name="list" property="m_strSBI_mail_ID"/></td>
   <td><bean:write name="list" property="m_strState"/></td>
   <td><bean:write name="list" property="m_strCity"/></td>
   <td><bean:write name="list" property="m_strLocal_Address"/></td>
   <td><bean:write name="list" property="m_strGender"/></td>
   <td><bean:write name="list" property="m_strDate_Of_Birth"/></td>
   <td><bean:write name="list" property="m_strFirst_Name"/></td>
   <td><bean:write name="list" property="m_strMiddle_Name"/></td>
   <td><bean:write name="list" property="m_strLast_Name"/></td>
   <!-- BGC -->
   <td>
   <logic:equal name="list" property="m_strBGC_Documents_Path" value="Uploaded">
   <a href="<%= request.getContextPath() %>/DocumentDownloadServlet?empid=<bean:write name='list' property='m_strEmployee_ID' />&amp;type=BGC" target="_blank">View BGC</a>
   </logic:equal>
   <logic:notEqual name="list" property="m_strBGC_Documents_Path" value="Uploaded">
   No BGC
   </logic:notEqual>
   </td>
   <!-- Photo -->
   <td>
   <logic:equal name="list" property="m_strPhoto_Path" value="Uploaded">
   <a href="<%= request.getContextPath() %>/DocumentDownloadServlet?empid=<bean:write name='list' property='m_strEmployee_ID' />&amp;type=PHOTO" target="_blank">View Photo</a>
   </logic:equal>
   <logic:notEqual name="list" property="m_strPhoto_Path" value="Uploaded">
   No Photo
   </logic:notEqual>
   </td>
   <!-- Police Verification -->
   <td>
   <logic:equal name="list" property="m_strPolice_Verification_Path" value="Uploaded">
   <a href="<%= request.getContextPath() %>/DocumentDownloadServlet?empid=<bean:write name='list' property='m_strEmployee_ID' />&amp;type=POLICE" target="_blank">View Police Verification</a>
   </logic:equal>
   <logic:notEqual name="list" property="m_strPolice_Verification_Path" value="Uploaded">
   No Police
   </logic:notEqual>
   </td>
   <td><bean:write name="list" property="m_strVPN_Hostname"/></td>
   <td><bean:write name="list" property="m_strLaptop_Hostname"/></td>
   <td><bean:write name="list" property="m_strRemote_Type"/></td>
   <td><bean:write name="list" property="m_strVPN_VDI_MAC_Address"/></td>
   <td><bean:write name="list" property="m_strVPN_VDI_IP_Address"/></td>
   <!-- CV -->
   <td>
   <logic:equal name="list" property="m_strCV_Document" value="Uploaded">
   <a href="<%= request.getContextPath() %>/DocumentDownloadServlet?empid=<bean:write name='list' property='m_strEmployee_ID' />&amp;type=CV" target="_blank">View CV</a>
   </logic:equal>
   <logic:notEqual name="list" property="m_strCV_Document" value="Uploaded">
   No CV
   </logic:notEqual>
   </td>
   <td><bean:write name="list" property="m_strUserName"/></td>
   <td><bean:write name="list" property="m_strPassword"/></td>
   <!-- Delete button -->
   <td>
   <button class="btn btn-danger btn-sm" onclick="deleterecord('<%= empId %>')">
   <i class="fas fa-trash-alt"></i> Delete
   </button>
   </td>
   <!-- Edit button -->
   <td>
   <button class="btn btn-primary btn-sm" onclick="editrecord('<%= empId %>')">
   <i class="fas fa-edit"></i> Edit
   </button>
   </td>
   </tr>
   </logic:iterate>
   </tbody>
   </table>
   </div>
   <div class="text-center">
   <button class="btn-export" onclick="ExportToExcel('xlsx', 'Employee_Details.xlsx')">
   <i class="fas fa-file-excel"></i> Export to Excel
   </button>
   </div>
   </div>
   </html:form>
   </body>
   </html>


package com.action;

import java.sql.Blob;
import java.sql.Connection;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.ArrayList;
import java.util.List;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import org.apache.struts.action.Action;
import org.apache.struts.action.ActionForm;
import org.apache.struts.action.ActionForward;
import org.apache.struts.action.ActionMapping;

import com.actionform.RegistrationActionForm;
import com.beans.EmployeeDetailsBean;
import com.jdbc.DBUtilityAuto;

public class ViewEISRegistrationDetailsAction extends Action {
	public ActionForward execute(ActionMapping mapping, ActionForm form, HttpServletRequest request,
			HttpServletResponse response) throws Exception {
		RegistrationActionForm l_obj = (RegistrationActionForm) form;
		l_obj.setM_strmsg("clear");
		if (request.getParameter("action") != null) {
			if (request.getParameter("action").equals("delete")) {
				this.deleteEmployeeDetails(request,l_obj);
			}
		}

		this.viewemployeedetailsdata(l_obj);
		return mapping.findForward("success");

	}

	 private void deleteEmployeeDetails(HttpServletRequest request, RegistrationActionForm l_obj) throws SQLException {
	        Connection conn = DBUtilityAuto.getReportDBConnection();
	        Statement stmt = null;

	        try {
	            String employeeId = request.getParameter("empid");
	            String deleteQuery = "DELETE FROM eisupport_employee_master WHERE EMPLOYEE_ID = '" + employeeId + "'";
	            System.out.println("Executing delete: " + deleteQuery);

	            stmt = conn.createStatement();
	            stmt.executeUpdate(deleteQuery);

	            l_obj.setM_strmsg("delete");
	        } catch (Exception e) {
	            l_obj.setM_strmsg("error");
	            e.printStackTrace();
	        } finally {
	            if (stmt != null) stmt.close();
	            if (conn != null) conn.close();
	        }
	    }


	 private void viewemployeedetailsdata(RegistrationActionForm l_obj) throws SQLException {
	        Connection conn = DBUtilityAuto.getReportDBConnection();
	        Statement stmt = null;
	        ResultSet rs = null;

	        try {
	            List<EmployeeDetailsBean> employeeList = new ArrayList<>();
	            String selectQuery = "SELECT * FROM eisupport_employee_master";
	            stmt = conn.createStatement();
	            rs = stmt.executeQuery(selectQuery);

	            while (rs.next()) {
	                EmployeeDetailsBean bean = new EmployeeDetailsBean();

	                bean.setM_strEmployee_ID(rs.getString("EMPLOYEE_ID"));
	                bean.setM_strAD_ID(rs.getString("AD_ID"));
	                bean.setM_strHID(rs.getString("HID"));
	                bean.setM_strAsset_ID(rs.getString("ASSET_ID"));
	                bean.setM_strEducation_Qualification(rs.getString("EDU_QUALIFICATION"));
	                bean.setM_strTCS_Joining_Date(rs.getString("TCS_JOINING_DATE"));
	                bean.setM_strEmployee_contact_Number(rs.getString("CONTACTNUMBER"));
	                bean.setM_strEmergency_contact_Number(rs.getString("EMERGENCY_CONTACTNUMBER"));
	                bean.setM_strTeam(rs.getString("TEAM"));
	                bean.setM_strTCS_mail_ID(rs.getString("TCS_MAILID"));
	                bean.setM_strSBI_mail_ID(rs.getString("SBI_MAILID"));
	                bean.setM_strState(rs.getString("STATE"));
	                bean.setM_strCity(rs.getString("CITY"));
	                bean.setM_strLocal_Address(rs.getString("LOCAL_ADDRESS"));
	                bean.setM_strGender(rs.getString("GENDER"));
	                bean.setM_strDate_Of_Birth(rs.getString("DOB"));
	                bean.setM_strFirst_Name(rs.getString("FIRSTNAME"));
	                bean.setM_strMiddle_Name(rs.getString("MIDDLENAME"));
	                bean.setM_strLast_Name(rs.getString("LASTNAME"));
	                bean.setM_strVPN_Hostname(rs.getString("VPN_HOSTNAME"));
	                bean.setM_strLaptop_Hostname(rs.getString("LAPTOP_HOSTNAME"));
	                bean.setM_strRemote_Type(rs.getString("REMOTETYPE"));
	                bean.setM_strVPN_VDI_MAC_Address(rs.getString("VPN_VDI_MACADDRESS"));
	                bean.setM_strVPN_VDI_IP_Address(rs.getString("VPN_VDI_IPADDRESS"));

	                // For BLOB columns: You can fetch them later when needed, or skip now
	                // For display purposes, just show "Available"/"Not Uploaded"
	                Blob cvBlob = rs.getBlob("CV_DOCUMENT_PATH");
	                Blob bgcBlob = rs.getBlob("BGC_DOCUMENT_PATH");
	                Blob photoBlob = rs.getBlob("PHOTO_PATH");
	                Blob policeBlob = rs.getBlob("POLICE_VERIFICATION_PATH");

	                bean.setM_strCV_Document(cvBlob != null ? "Uploaded" : "Not Uploaded");
	                bean.setM_strBGC_Documents_Path(bgcBlob != null ? "Uploaded" : "Not Uploaded");
	                bean.setM_strPhoto_Path(photoBlob != null ? "Uploaded" : "Not Uploaded");
	                bean.setM_strPolice_Verification_Path(policeBlob != null ? "Uploaded" : "Not Uploaded");

	                bean.setM_strUserName(rs.getString("USERNAME"));
	                bean.setM_strPassword(rs.getString("password"));
	                bean.setM_strISACTIVE(rs.getString("ISACTIVE"));

	                employeeList.add(bean);
	            }

	            l_obj.setM_lstViewEmployeeRegistrationdetail(employeeList);
	        } catch (Exception e) {
	            e.printStackTrace();
	        } finally {
	            if (rs != null) rs.close();
	            if (stmt != null) stmt.close();
	            if (conn != null) conn.close();
	        }

	}
}

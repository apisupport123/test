    private byte[] readFileBytes(File file) {
        if (file == null || !file.exists()) {
            System.out.println("[READ] File does not exist: " + file);
            return null;
        }
        try (FileInputStream fis = new FileInputStream(file)) {
            long size = file.length();
            System.out.println("[READ] File size = " + size + " bytes");
            if (size <= 0 || size > Integer.MAX_VALUE) {
                System.out.println("[READ] Invalid size");
                return null;
            }
            byte[] data = new byte[(int) size];
            int read = 0;
            while (read < data.length) {
                int n = fis.read(data, read, data.length - read);
                if (n < 0) break;
                read += n;
            }
            return data;
        } catch (IOException e) {
            System.out.println("[READ] ERROR: " + e.getMessage());
            e.printStackTrace();
            return null;
        }
    }

    private void bindInsertParams(PreparedStatement ps,
                                  HttpServletRequest request,
                                  byte[] cvBytes,
                                  byte[] bgcBytes,
                                  byte[] photoBytes,
                                  byte[] policeBytes) throws SQLException {

        ps.setObject(1,  request.getParameter("m_stremployee_id"));
        ps.setObject(2,  request.getParameter("m_strad_id"));
        ps.setObject(3,  request.getParameter("m_strasset_id"));
        ps.setObject(4,  request.getParameter("m_streduqualification"));
        ps.setObject(5,  request.getParameter("m_strtcsjoiningdate"));
        ps.setObject(6,  request.getParameter("m_strcontactno"));
        ps.setObject(7,  request.getParameter("m_stremergencycontactno"));
        ps.setObject(8,  request.getParameter("m_strRole"));
        ps.setObject(9,  request.getParameter("m_strtcsmailid"));
        ps.setObject(10, request.getParameter("m_strstate"));
        ps.setObject(11, request.getParameter("m_strcity"));
        ps.setObject(12, request.getParameter("m_strlocaladdress"));
        ps.setObject(13, request.getParameter("m_strgender"));
        ps.setObject(14, request.getParameter("m_strdob"));
        ps.setObject(15, request.getParameter("m_strfirstName"));
        ps.setObject(16, request.getParameter("m_strmiddleName"));
        ps.setObject(17, request.getParameter("m_strlastName"));
        ps.setObject(18, request.getParameter("m_strvpnhostname"));
        ps.setObject(19, request.getParameter("m_strlaptophostname"));
        ps.setObject(20, request.getParameter("m_strremotetype"));
        ps.setObject(21, request.getParameter("m_strvpnmacaddress"));
        ps.setObject(22, request.getParameter("m_strvpnipaddress"));

        // BLOB columns
        if (cvBytes != null && cvBytes.length > 0) {
            ps.setBytes(23, cvBytes);
        } else {
            ps.setNull(23, java.sql.Types.BLOB);
        }

        if (bgcBytes != null && bgcBytes.length > 0) {
            ps.setBytes(24, bgcBytes);
        } else {
            ps.setNull(24, java.sql.Types.BLOB);
        }

        if (photoBytes != null && photoBytes.length > 0) {
            ps.setBytes(25, photoBytes);
        } else {
            ps.setNull(25, java.sql.Types.BLOB);
        }

        if (policeBytes != null && policeBytes.length > 0) {
            ps.setBytes(26, policeBytes);
        } else {
            ps.setNull(26, java.sql.Types.BLOB);
        }

        ps.setObject(27, request.getParameter("m_strUserName"));
        ps.setObject(28, request.getParameter("m_strPassword"));
        ps.setObject(29, request.getParameter("m_strhid"));
        ps.setObject(30, request.getParameter("m_strsbimailid"));
    }


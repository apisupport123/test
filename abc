<script>
/* ============================================================
   ✅ LOGOUT HANDLER (capture phase)
   ============================================================ */
document.addEventListener('click', function(e){
  var target = e.target.closest('.sb-logout, a[href*="login.action"], .sb-home-btn, a[href*="userhomescreen.action"]');
  if(target){
    e.preventDefault();
    e.stopPropagation();
    window.__logoutInProgress = true;
    try{
      sessionStorage.clear();
      localStorage.removeItem('eis-sidebar-closed');
    }catch(err){}
    var isLogout = target.classList.contains('sb-logout') 
                || (target.href && target.href.indexOf('login.action') !== -1);
    if(isLogout){
      window.location.replace('<%=request.getContextPath()%>/login.action?logout=true');
    } else {
      window.location.href = '<%=request.getContextPath()%>/userhomescreen.action';
    }
  }
}, true);

/* ============================================================
   ✅ BACK BUTTON BLOCK
   ============================================================ */
(function(){
  window.history.pushState({ page: 'home' }, '', window.location.href);
  window.addEventListener('popstate', function(e){
    if(window.__logoutInProgress === true) return;
    window.history.pushState({ page: 'home' }, '', window.location.href);
  });
})();

/* ============================================================
   ✅ LIVE CLOCK
   ============================================================ */
function updateClock(){
  var now = new Date();
  var hh = String(now.getHours()).padStart(2,'0');
  var mm = String(now.getMinutes()).padStart(2,'0');
  var ss = String(now.getSeconds()).padStart(2,'0');
  var days = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  var clockEl = document.getElementById('liveClock');
  var dateEl = document.getElementById('liveDate');
  if(clockEl) clockEl.textContent = hh + ':' + mm + ':' + ss;
  if(dateEl) dateEl.textContent = days[now.getDay()] + ', ' + now.getDate() + ' ' + months[now.getMonth()] + ' ' + now.getFullYear();
  var footEl = document.getElementById('footTime');
  if(footEl) footEl.textContent = 'Session active · ' + hh + ':' + mm;
}
setInterval(updateClock, 1000);
updateClock();

/* ============================================================
   ✅ TIME-BASED GREETING
   ============================================================ */
(function(){
  var h = new Date().getHours();
  var greet = 'Welcome back';
  if(h < 12) greet = 'Good morning';
  else if(h < 17) greet = 'Good afternoon';
  else if(h < 21) greet = 'Good evening';
  else greet = 'Good night';
  var el = document.getElementById('greeting');
  if(el) el.textContent = greet;
})();

/* ============================================================
   ✅ ANIMATED COUNTERS
   ============================================================ */
(function(){
  document.querySelectorAll('[data-count]').forEach(function(el){
    var target = parseInt(el.getAttribute('data-count'));
    var current = 0;
    var step = Math.max(1, Math.floor(target / 40));
    var interval = setInterval(function(){
      current += step;
      if(current >= target){
        current = target;
        clearInterval(interval);
      }
      el.textContent = current;
    }, 25);
  });
})();

/* ============================================================
   ✅ FAVORITES (localStorage)
   ============================================================ */
function getFavs(){
  try{
    var f = JSON.parse(localStorage.getItem('eis-favs') || '[]');
    return Array.isArray(f) ? f : [];
  }catch(e){ return []; }
}
function setFavs(arr){
  try{ localStorage.setItem('eis-favs', JSON.stringify(arr)); }catch(e){}
}
function toggleFav(btn){
  var name = btn.getAttribute('data-fav');
  var favs = getFavs();
  var idx = favs.indexOf(name);
  if(idx === -1){
    favs.push(name);
    btn.classList.add('active');
  } else {
    favs.splice(idx, 1);
    btn.classList.remove('active');
  }
  setFavs(favs);
  applyFilters();
}
function markFavs(){
  var favs = getFavs();
  document.querySelectorAll('.fav-btn').forEach(function(btn){
    var n = btn.getAttribute('data-fav');
    if(favs.indexOf(n) !== -1) btn.classList.add('active');
    else btn.classList.remove('active');
  });
}
markFavs();

/* ============================================================
   ✅ FILTER + SEARCH
   ============================================================ */
var currentCat = 'all';
var currentSearch = '';

function applyFilters(){
  var favs = getFavs();
  document.querySelectorAll('#bentoGrid .bcard').forEach(function(card){
    var cat = card.getAttribute('data-cat') || '';
    var name = (card.getAttribute('data-name') || '').toLowerCase();
    var cardText = card.innerText.toLowerCase();

    var catMatch = (currentCat === 'all') 
                || (currentCat === 'fav' && favs.indexOf(card.getAttribute('data-name')) !== -1)
                || (currentCat === cat);
    var searchMatch = !currentSearch || cardText.indexOf(currentSearch) !== -1;

    if(catMatch && searchMatch){
      card.classList.remove('hidden');
    } else {
      card.classList.add('hidden');
    }
  });
}

document.querySelectorAll('.filter-tab').forEach(function(tab){
  tab.addEventListener('click', function(){
    document.querySelectorAll('.filter-tab').forEach(function(t){ t.classList.remove('active'); });
    tab.classList.add('active');
    currentCat = tab.getAttribute('data-cat');
    applyFilters();
  });
});

var searchInput = document.getElementById('dashSearch');
if(searchInput){
  searchInput.addEventListener('input', function(){
    currentSearch = this.value.toLowerCase().trim();
    applyFilters();
  });
}

/* Ctrl+K */
document.addEventListener('keydown', function(e){
  if((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k'){
    e.preventDefault();
    if(searchInput){ searchInput.focus(); }
  }
});

/* ============================================================
   ✅ RECENT VISITS (localStorage)
   ============================================================ */
function recordVisit(name, url){
  try{
    var recents = JSON.parse(localStorage.getItem('eis-recents') || '[]');
    recents = recents.filter(function(r){ return r.name !== name; });
    recents.unshift({ name: name, url: url, time: Date.now() });
    recents = recents.slice(0, 4);
    localStorage.setItem('eis-recents', JSON.stringify(recents));
  }catch(e){}
}

function renderRecents(){
  var recents = [];
  try{ recents = JSON.parse(localStorage.getItem('eis-recents') || '[]'); }catch(e){}
  var section = document.getElementById('recentSection');
  var grid = document.getElementById('recentGrid');
  var count = document.getElementById('recentCount');
  if(!section || !grid) return;

  if(recents.length === 0){
    section.style.display = 'none';
    return;
  }
  section.style.display = 'block';
  if(count) count.textContent = recents.length;

  grid.innerHTML = '';
  var icons = {
    'EIS Command Center': 'M4.93 4.93a10 10 0 0 0 0 14.14M19.07 4.93a10 10 0 0 1 0 14.14',
    'Error Dashboard': 'M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z',
    'ATM IP Port Portal': 'M2 5h20v14H2z M2 10h20',
    'Transaction End Point': 'M12 1v22 M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6',
    'Service Status': 'M18 20V10M12 20V4M6 20v-6',
    'DR Checklist': 'M9 11l3 3L22 4 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',
    'Ticketing Portal': 'M2 9a3 3 0 0 1 3-3h14a3 3 0 0 1 3 3v.5a2.5 2.5 0 0 0 0 5V15a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3v-.5a2.5 2.5 0 0 0 0-5z',
    'Add Deployment': 'M12 5v14M5 12h14',
    'Daily Statistics': 'M21.21 15.89A10 10 0 1 1 8 2.83',
    'Flash Report': 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
    'EIS Query Console': 'M4 17l6-6-6-6 M12 19h8'
  };

  recents.forEach(function(r){
    var timeAgo = '';
    var diff = Date.now() - r.time;
    if(diff < 60000) timeAgo = 'just now';
    else if(diff < 3600000) timeAgo = Math.floor(diff/60000) + 'm ago';
    else if(diff < 86400000) timeAgo = Math.floor(diff/3600000) + 'h ago';
    else timeAgo = Math.floor(diff/86400000) + 'd ago';

    var iconPath = icons[r.name] || 'M13 2L3 14h9l-1 8 10-12h-9l1-8z';
    var card = document.createElement('a');
    card.className = 'recent-card';
    card.href = r.url;
    card.target = '_blank';
    card.rel = 'noopener noreferrer';
    card.innerHTML = 
      '<span class="rc-icon"><svg class="icon-svg" viewBox="0 0 24 24"><path d="' + iconPath + '"/></svg></span>' +
      '<span class="rc-text">' +
        '<span class="rc-name">' + r.name + '</span>' +
        '<span class="rc-time">' + timeAgo + '</span>' +
      '</span>';
    grid.appendChild(card);
  });
}
renderRecents();

/* Click pe recent record karo */
document.querySelectorAll('#bentoGrid .bcard').forEach(function(card){
  card.addEventListener('click', function(){
    var name = card.getAttribute('data-name') || '';
    var url = card.href || '';
    if(name && url){
      recordVisit(name, url);
    }
  });
});


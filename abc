    }

    /**
     * Handles insert submission. Files are read as bytes and stored as BLOB.
     */
    public String saveRegistration() throws Exception {

        System.out.println("========== saveRegistration START ==========");

        RegistrationActionForm form = getOrCreateForm();
        loadEISRole(form);

        HttpServletRequest request = ServletActionContext.getRequest();
        String actionParam = request.getParameter("action");

        System.out.println("[DEBUG] actionParam = " + actionParam);

        if (actionParam == null) {
            clearForm(form);
            return "success";
        }
        if (!"insert".equals(actionParam)) {
            clearForm(form);
            return "success";
        }

        Connection con = null;
        PreparedStatement psEmp = null;
        PreparedStatement psRoster = null;
        Statement checkSt = null;
        ResultSet checkRs = null;

        try {
            con = DBUtilityAuto.getReportDBConnection();
            System.out.println("[DEBUG] DB Connected OK");

            // ---- Duplicate check ----
            String empId = request.getParameter("m_stremployee_id");
            String countQuery = "select count(*) from eisupport_employee_master where EMPLOYEE_ID='"
                    + empId + "'";
            checkSt = con.createStatement();
            checkRs = checkSt.executeQuery(countQuery);

            int count = 0;
            if (checkRs != null && checkRs.next()) {
                count = checkRs.getInt(1);
            }
            System.out.println("[DEBUG] Duplicate count = " + count);

            if (count > 0) {
                form.setM_strmsg("duplicate");
                this.setM_strmsg("duplicate");
                return "success";
            }

            // ============================================================
            // ⭐ READ FILES AS BYTES → TO BE STORED AS BLOB
            // ============================================================
            byte[] photoBytes  = null;
            byte[] bgcBytes    = null;
            byte[] policeBytes = null;
            byte[] cvBytes     = null;

            // --- PHOTO ---
            File photoFile = form.getM_strthePhotofile();
            String photoName = form.getM_strthePhotofileFileName();
            System.out.println("[UPLOAD] PHOTO file=" + photoFile + " name=" + photoName);
            if (photoFile != null && photoName != null && !photoName.trim().isEmpty()) {
                photoBytes = readFileBytes(photoFile);
                if (photoBytes != null)

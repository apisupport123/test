<%@page contentType="text/html" pageEncoding="UTF-8"%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<title>EIS Navigation</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script>
$(document).ready(function () {
  $('.nav-toggle').click(function(e) {
    e.preventDefault();
    $("html").toggleClass("openNav");
    $(".nav-toggle").toggleClass("active");
  });
});
</script>
<style>
:root{
  --brand:#F86F03;
  --brand-dark:#E85D00;
  --brand-light:#FFF4EC;
  --text:#0A0A0A;
  --muted:#6B7280;
  --line:#E5E7EB;
  --bg:#FAFAFA;
  --sidebar-bg:#0F1115;
  --sidebar-hover:rgba(248,111,3,.12);
  --sidebar-text:#B4BAC6;
  --sidebar-text-active:#FFFFFF;
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  font-family:'Plus Jakarta Sans',system-ui,sans-serif;
  background:var(--bg);
  color:var(--text);
  -webkit-font-smoothing:antialiased;
}

/* ============ HAMBURGER ============ */
.hamburger{
  position:fixed;
  top:16px;left:16px;
  z-index:1100;
  width:44px;height:44px;
  background:#fff;
  border:1px solid var(--line);
  border-radius:12px;
  display:grid;place-items:center;
  cursor:pointer;
  color:var(--text);
  font-size:1rem;
  transition:all .25s ease;
  box-shadow:0 4px 14px rgba(0,0,0,.06);
}
.hamburger:hover{
  background:var(--brand-light);
  border-color:var(--brand);
  color:var(--brand);
}
.hamburger:before{
  content:"\f0c9"; /* bars */
  font-family:"Font Awesome 6 Free";
  font-weight:900;
}
html.openNav .hamburger:before{
  content:"\f00d"; /* close */
}
html.openNav .hamburger{
  background:var(--brand);
  border-color:var(--brand);
  color:#fff;
}

/* ============ SIDEBAR ============ */
.sidebar{
  position:fixed;
  top:0;left:0;
  width:340px;
  height:100vh;
  background:var(--sidebar-bg);
  z-index:1000;
  transform:translateX(-100%);
  transition:transform .35s cubic-bezier(.4,0,.2,1);
  display:flex;
  flex-direction:column;
  border-right:1px solid rgba(255,255,255,.05);
}
html.openNav .sidebar{
  transform:translateX(0);
}

/* Logo */
.sidebar-head{
  padding:20px 24px 20px 76px;
  border-bottom:1px solid rgba(255,255,255,.06);
  display:flex;
  align-items:center;
  gap:12px;
  min-height:76px;
}
.sidebar-logo{
  width:34px;height:34px;
  background:var(--brand);
  border-radius:9px;
  display:grid;place-items:center;
  color:#fff;
  font-size:.95rem;
  box-shadow:0 6px 16px -6px var(--brand);
}
.sidebar-title{
  font-size:1rem;
  font-weight:800;
  color:#fff;
  letter-spacing:-.3px;
}
.sidebar-title span{
  display:block;
  font-size:.65rem;
  font-weight:500;
  color:var(--sidebar-text);
  letter-spacing:1.5px;
  text-transform:uppercase;
  margin-top:2px;
}

/* Search */
.sidebar-search{
  padding:16px 20px;
  border-bottom:1px solid rgba(255,255,255,.06);
}
.search-box{
  position:relative;
  display:flex;
  align-items:center;
}
.search-box i{
  position:absolute;
  left:14px;
  color:var(--sidebar-text);
  font-size:.85rem;
  pointer-events:none;
}
.search-box input{
  width:100%;
  padding:11px 14px 11px 38px;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.08);
  border-radius:10px;
  color:#fff;
  font-family:inherit;
  font-size:.85rem;
  font-weight:500;
  outline:none;
  transition:all .2s ease;
}
.search-box input::placeholder{color:var(--sidebar-text);opacity:.7}
.search-box input:focus{
  background:rgba(255,255,255,.08);
  border-color:var(--brand);
  box-shadow:0 0 0 3px rgba(248,111,3,.15);
}

/* Menu */
.sidebar-body{
  flex:1;
  overflow-y:auto;
  padding:14px 12px 20px;
}
.sidebar-body::-webkit-scrollbar{width:6px}
.sidebar-body::-webkit-scrollbar-track{background:transparent}
.sidebar-body::-webkit-scrollbar-thumb{
  background:rgba(255,255,255,.1);
  border-radius:3px;
}

.menu-list{
  list-style:none;
  display:flex;
  flex-direction:column;
  gap:2px;
}
.menu-list li a{
  display:flex;
  align-items:center;
  gap:12px;
  padding:11px 14px;
  font-size:.82rem;
  font-weight:500;
  color:var(--sidebar-text);
  border-radius:9px;
  transition:all .18s ease;
  line-height:1.35;
  position:relative;
}
.menu-list li a:hover{
  background:var(--sidebar-hover);
  color:var(--sidebar-text-active);
}
.menu-list li a:hover .icon{
  color:var(--brand);
  background:rgba(248,111,3,.15);
}
.menu-list li a .icon{
  flex-shrink:0;
  width:30px;height:30px;
  display:grid;place-items:center;
  background:rgba(255,255,255,.04);
  border-radius:8px;
  color:var(--sidebar-text);
  font-size:.82rem;
  transition:all .18s ease;
}
.menu-list li a.logout{
  color:#FF8A8A;
  margin-top:10px;
  border-top:1px solid rgba(255,255,255,.06);
  padding-top:14px;
  border-radius:0;
}
.menu-list li a.logout:hover{
  color:#FF4D4D;
  background:rgba(255,77,77,.08);
}

/* Overlay */
.overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.5);
  backdrop-filter:blur(4px);
  z-index:990;
  opacity:0;
  pointer-events:none;
  transition:opacity .3s ease;
}
html.openNav .overlay{
  opacity:1;
  pointer-events:auto;
}

/* ============ CONTENT SHIFT (optional) ============ */
.new-wrapper{
  transition:transform .35s cubic-bezier(.4,0,.2,1);
}
html.openNav .new-wrapper{
  transform:translateX(340px);
}

/* ============ RESPONSIVE ============ */
@media (max-width: 600px){
  .sidebar{width:290px}
  html.openNav .new-wrapper{transform:translateX(290px)}
}
</style>
</head>

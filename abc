public class EISRegistrationEditServletNew extends HttpServlet {

    private static final long serialVersionUID = 1L;

    public EISRegistrationEditServletNew() {
        super();
    }

    // ============================================================
    // GET — Show edit form or redirect
    // ============================================================
    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        String action = request.getParameter("action");
        String empid = request.getParameter("empid");

        System.out.println("[EDIT-SERVLET] GET action=" + action + " empid=" + empid);

        if ("edit".equals(action) && empid != null && !empid.trim().isEmpty()) {
            // Forward to the edit JSP with empid
            response.sendRedirect(request.getContextPath()
                    + "/jsp/EditProfileNew.jsp?action=edit&empid=" + empid);
        } else {
            response.sendRedirect(request.getContextPath() + "/ViewEISRegistrationDetailsActionNew");
        }
    }

    // ============================================================
    // POST — Handle edit submission
    // ============================================================
    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        System.out.println("========== EDIT-SERVLET POST START ==========");

        String action = request.getParameter("action");
        String empid = request.getParameter("empid");

        System.out.println("[EDIT-SERVLET] action=" + action + " empid=" + empid);

        RegistrationActionForm l_obj = new RegistrationActionForm();

        try {
            getEISRole(l_obj);
            request.setAttribute("roleList", l_obj.getRolelist());

            if ("edit".equals(action)) {
                processEditRequest(request, response, l_obj);
            } else {
                System.out.println("[EDIT-SERVLET] Non-edit action, redirecting");
                response.sendRedirect(request.getContextPath()
                        + "/ViewEISRegistrationDetailsActionNew");
            }

        } catch (Exception e) {
            System.out.println("[EDIT-SERVLET] EXCEPTION: " + e.getClass().getName()
                    + " - " + e.getMessage());
            e.printStackTrace();
            l_obj.setM_strmsg("error");
            request.setAttribute("errorMessage", "An error occurred: " + e.getMessage());
            request.getRequestDispatcher("/jsp/EditProfileNew.jsp?empid=" + empid)
                   .forward(request, response);
        }
    }

    // ============================================================
    // Main edit processing
    // ============================================================
    private void processEditRequest(HttpServletRequest request,
                                    HttpServletResponse response,
                                    RegistrationActionForm l_obj) throws Exception {

        Connection con = null;
        PreparedStatement ps = null;
        ResultSet rs = null;

        try {
            con = DBUtilityAuto.getReportDBConnection();

            String originalEmpId = request.getParameter("empid");
            if (originalEmpId == null || originalEmpId.trim().isEmpty()) {
                throw new Exception("Original Employee ID is missing");
            }

            System.out.println("[EDIT-SERVLET] Fetching existing record: " + originalEmpId);

            // ---- Fetch existing BLOB data ----
            byte[] photoBytes  = null;
            byte[] bgcBytes    = null;
            byte[] policeBytes = null;
            byte[] cvBytes     = null;

            ps = con.prepareStatement(
                    "SELECT PHOTO_PATH, BGC_DOCUMENT_PATH, " +
                    "POLICE_VERIFICATION_PATH, CV_DOCUMENT_PATH " +
                    "FROM eisupport_employee_master WHERE EMPLOYEE_ID = ?");
            ps.setString(1, originalEmpId);
            rs = ps.executeQuery();

            if (!rs.next()) {
                throw new Exception("Employee not found: " + originalEmpId);
            }

            photoBytes  = rs.getBytes("PHOTO_PATH");
            bgcBytes    = rs.getBytes("BGC_DOCUMENT_PATH");
            policeBytes = rs.getBytes("POLICE_VERIFICATION_PATH");
            cvBytes     = rs.getBytes("CV_DOCUMENT_PATH");

            System.out.println("[EDIT-SERVLET] Existing BLOB sizes: photo="
                    + (photoBytes != null ? photoBytes.length : 0)
                    + " bgc=" + (bgcBytes != null ? bgcBytes.length : 0)
                    + " police=" + (policeBytes != null ? policeBytes.length : 0)
                    + " cv=" + (cvBytes != null ? cvBytes.length : 0));

            rs.close(); rs = null;
            ps.close(); ps = null;

            // ---- Handle file uploads ----
            System.out.println("[EDIT-SERVLET] Processing uploads...");

            byte[] newPhoto  = readPartBytes(request, "m_strthePhotofile");
            byte[] newBgc    = readPartBytes(request, "m_strtheBgcfile");
            byte[] newPolice = readPartBytes(request, "m_strthePoliceverificationfile");
            byte[] newCv     = readPartBytes(request, "m_strtheCvfile");

            // ---- Delete flags ----
            String dBgc    = request.getParameter("deleteBGC");
            String dPolice = request.getParameter("deletePOLICE");
            String dCv     = request.getParameter("deleteCV");

            // Apply upload or delete logic
            if (newPhoto != null && newPhoto.length > 0) {
                photoBytes = newPhoto;
                System.out.println("[EDIT-SERVLET] PHOTO replaced: " + newPhoto.length + " bytes");
            }

            if (newBgc != null && newBgc.length > 0) {
                bgcBytes = newBgc;
                System.out.println("[EDIT-SERVLET] BGC replaced: " + newBgc.length + " bytes");
            } else if ("DELETEBGC".equals(dBgc)) {
                bgcBytes = null;
                System.out.println("[EDIT-SERVLET] BGC deleted");
            }

            if (newPolice != null && newPolice.length > 0) {
                policeBytes = newPolice;
                System.out.println("[EDIT-SERVLET] POLICE replaced: " + newPolice.length + " bytes");
            } else if ("DELETEPOLICE".equals(dPolice)) {
                policeBytes = null;
                System.out.println("[EDIT-SERVLET] POLICE deleted");
            }

            if (newCv != null && newCv.length > 0) {
                cvBytes = newCv;
                System.out.println("[EDIT-SERVLET] CV replaced: " + newCv.length + " bytes");
            } else if ("DELETECV".equals(dCv)) {
                cvBytes = null;
                System.out.println("[EDIT-SERVLET] CV deleted");
            }

            // ---- Update record ----
            String SQL_UPDATE =
                    "UPDATE eisupport_employee_master SET " +
                    "EMPLOYEE_ID=?, AD_ID=?, ASSET_ID=?, EDU_QUALIFICATION=?, " +
                    "TCS_JOINING_DATE=?, CONTACTNUMBER=?, EMERGENCY_CONTACTNUMBER=?, " +
                    "TEAM=?, TCS_MAILID=?, STATE=?, CITY=?, LOCAL_ADDRESS=?, " +
                    "GENDER=?, DOB=?, FIRSTNAME=?, MIDDLENAME=?, LASTNAME=?, " +
                    "ISACTIVE=?, VPN_HOSTNAME=?, LAPTOP_HOSTNAME=?, REMOTETYPE=?, " +
                    "VPN_VDI_MACADDRESS=?, VPN_VDI_IPADDRESS=?, " +
                    "CV_DOCUMENT_PATH=?, BGC_DOCUMENT_PATH=?, PHOTO_PATH=?, " +
                    "POLICE_VERIFICATION_PATH=?, USERNAME=?, PASSWORD=?, HID=?, " +
                    "SBI_MAILID=? " +
                    "WHERE EMPLOYEE_ID=?";

            ps = con.prepareStatement(SQL_UPDATE);

            // Text fields (1-23)
            ps.setString(1,  getParam(request, "m_stremployee_id"));
            ps.setString(2,  getParam(request, "m_strad_id"));
            ps.setString(3,  getParam(request, "m_strasset_id"));
            ps.setString(4,  getParam(request, "m_streduqualification"));
            ps.setString(5,  getParam(request, "m_strtcsjoiningdate"));
            ps.setString(6,  getParam(request, "m_strcontactno"));
            ps.setString(7,  getParam(request, "m_stremergencycontactno"));
            ps.setString(8,  getParam(request, "m_strRole"));
            ps.setString(9,  getParam(request, "m_strtcsmailid"));
            ps.setString(10, getParam(request, "m_strstate"));
            ps.setString(11, getParam(request, "m_strcity"));
            ps.setString(12, getParam(request, "m_strlocaladdress"));
            ps.setString(13, getParam(request, "m_strgender"));
            ps.setString(14, getParam(request, "m_strdob"));
            ps.setString(15, getParam(request, "m_strfirstName"));
            ps.setString(16, getParam(request, "m_strmiddleName"));
            ps.setString(17, getParam(request, "m_strlastName"));
            ps.setString(18, getParam(request, "m_strISACTIVE"));
            ps.setString(19, getParam(request, "m_strvpnhostname"));
            ps.setString(20, getParam(request, "m_strlaptophostname"));
            ps.setString(21, getParam(request, "m_strremotetype"));
            ps.setString(22, getParam(request, "m_strvpnmacaddress"));
            ps.setString(23, getParam(request, "m_strvpnipaddress"));

            // BLOB fields (24-27)
            setBlob(ps, 24, cvBytes);
            setBlob(ps, 25, bgcBytes);
            setBlob(ps, 26, photoBytes);
            setBlob(ps, 27, policeBytes);

            // Text (28-31)
            ps.setString(28, getParam(request, "m_strUserName"));
            ps.setString(29, getParam(request, "m_strPassword"));
            ps.setString(30, getParam(request, "m_strhid"));
            ps.setString(31, getParam(request, "m_strsbimailid"));

            // Where clause
            ps.setString(32, originalEmpId);

            System.out.println("[EDIT-SERVLET] Executing update...");

            int rowsUpdated = ps.executeUpdate();

            System.out.println("[EDIT-SERVLET] Rows updated: " + rowsUpdated);

            if (rowsUpdated > 0) {
                System.out.println("[EDIT-SERVLET] UPDATE SUCCESSFUL");
                clearForm(l_obj);
                response.sendRedirect(request.getContextPath()
                        + "/ViewEISRegistrationDetailsActionNew");
            } else {
                System.out.println("[EDIT-SERVLET] NO ROWS UPDATED");
                l_obj.setM_strmsg("error");
                response.sendRedirect(request.getContextPath()
                        + "/ViewEISRegistrationDetailsActionNew");
            }

        } catch (SQLException e) {
            System.out.println("[EDIT-SERVLET] SQL ERROR: " + e.getMessage());
            e.printStackTrace();
            l_obj.setM_strmsg("error");
            response.sendRedirect(request.getContextPath()
                    + "/ViewEISRegistrationDetailsActionNew");
        } finally {
            closeQuietly(rs, null, ps, con);
        }
    }

    // ============================================================
    // HELPERS
    // ============================================================

    /**
     * Safely read a file Part and return its bytes. Returns null if empty.
     */
    private byte[] readPartBytes(HttpServletRequest request, String partName) {
        try {
            Part part = request.getPart(partName);
            if (part == null) return null;

            long size = part.getSize();
            String fileName = getSubmittedFileName(part);

            System.out.println("[EDIT-SERVLET] Part " + partName
                    + " size=" + size + " filename=" + fileName);

            if (size == 0 || fileName == null || fileName.trim().isEmpty()) {
                return null;
            }

            try (InputStream in = part.getInputStream()) {
                byte[] bytes = in.readAllBytes();
                System.out.println("[EDIT-SERVLET] Read " + bytes.length
                        + " bytes from " + partName);
                return bytes;
            }
        } catch (Exception e) {
            System.out.println("[EDIT-SERVLET] Error reading part "
                    + partName + ": " + e.getMessage());
            e.printStackTrace();
            return null;
        }
    }

    /**
     * Extract submitted filename from Part (Servlet 3.1+ workaround).
     */
    private String getSubmittedFileName(Part part) {
        if (part == null) return null;
        String cd = part.getHeader("content-disposition");
        if (cd == null) return null;
        for (String token : cd.split(";")) {
            token = token.trim();
            if (token.startsWith("filename=")) {
                String name = token.substring("filename=".length()).trim();
                name = name.replace("\"", "");
                if (name.startsWith("=")) {
                    name = name.substring(1);
                }
                return name;
            }
        }
        return null;
    }

    /**
     * Set BLOB parameter (null-safe).
     */
    private void setBlob(PreparedStatement ps, int index, byte[] data) throws SQLException {
        if (data != null && data.length > 0) {
            ps.setBinaryStream(index, new ByteArrayInputStream(data), data.length);
        } else {
            ps.setNull(index, java.sql.Types.BLOB);
        }
    }

    /**
     * Safely get request parameter.
     */
    private String getParam(HttpServletRequest request, String name) {
        String v = request.getParameter(name);
        return v != null ? v.trim() : "";
    }


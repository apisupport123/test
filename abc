 // ✅ Strict cache headers
 response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0, private");
 response.setHeader("Pragma", "no-cache");
 response.setHeader("Expires", "0");
 response.setHeader("Vary", "*");

 // ✅ Agar user already logged in hai toh home pe redirect
 jakarta.servlet.http.HttpSession sess = request.getSession(false);
 if(sess != null && sess.getAttribute("role") != null
    && !((String)sess.getAttribute("role")).isEmpty()) {
     response.sendRedirect(request.getContextPath() + "/userhomescreen.action");
     return;
 }

 // ✅ Role list — request → session → DB fallback
 java.util.List<String> rolelist = (java.util.List<String>) request.getAttribute("rolelist");
 if(rolelist == null) {
     rolelist = (java.util.List<String>) session.getAttribute("rolelist");
 }
 if(rolelist == null || rolelist.isEmpty()) {
     java.sql.Connection conn = null;
     java.sql.Statement stmt = null;
     java.sql.ResultSet rs = null;
     try {
         conn = com.jdbc.DBUtilityAuto.getReportDBConnection();
         stmt = conn.createStatement();
         rs = stmt.executeQuery("SELECT rolename FROM rolemst");
         rolelist = new java.util.ArrayList<String>();
         while(rs.next()) {
             rolelist.add(rs.getString("rolename"));
         }
     } catch(Exception e) {
         e.printStackTrace();
     } finally {
         if(rs != null) try { rs.close(); } catch(Exception ex) {}
         if(stmt != null) try { stmt.close(); } catch(Exception ex) {}
         if(conn != null) try { conn.close(); } catch(Exception ex) {}
     }
 }

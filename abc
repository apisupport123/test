// ═══════════════════════════════════════════════════════════
// MANUAL REFRESH IP LIST
// ═══════════════════════════════════════════════════════════
String action = request.getParameter("action");
if ("refreshMaster".equals(action)) {
    Connection cR = null, cI = null;
    try {
        cR = DBUtilityAuto.getReportDBConnection();
        cI = DBUtilityAuto.getIIBDBConnection();
        ensureTableExists(cR);
        cR.setAutoCommit(false);
        refreshMasterTable(cR, cI);
        cR.commit();
        cR.setAutoCommit(true);
    } catch (Exception e) {
        e.printStackTrace();
        try { if (cR != null) cR.rollback(); } catch (Exception ex) {}
    } finally {
        try { if (cR != null) cR.close(); } catch (Exception e) {}
        try { if (cI != null) cI.close(); } catch (Exception e) {}
    }
    String rUrl = request.getRequestURI() + "?mute=" + isMuted;
    if (request.getParameter("fromTime") != null) rUrl += "&fromTime=" + request.getParameter("fromTime");
    if (request.getParameter("toTime") != null) rUrl += "&toTime=" + request.getParameter("toTime");
    response.sendRedirect(rUrl);
    return;
}

// ── Auto master refresh (new day) ──
Connection cRA = null, cIA = null;
try {
    cRA = DBUtilityAuto.getReportDBConnection();
    cIA = DBUtilityAuto.getIIBDBConnection();
    ensureTableExists(cRA);
    boolean needsRefresh = false;
    Statement sc = cRA.createStatement();
    ResultSet rc = sc.executeQuery("SELECT MAX(LAST_UPDATED) FROM DPG_IP_MASTER");
    Date lastUpd = null;
    if (rc.next()) lastUpd = rc.getDate(1);
    rc.close(); sc.close();
    if (lastUpd == null || lastUpd.before(new java.util.Date(System.currentTimeMillis() - 24*60*60*1000))) {
        needsRefresh = true;
    }
    if (needsRefresh) {
        cRA.setAutoCommit(false);
        refreshMasterTable(cRA, cIA);
        cRA.commit(); cRA.setAutoCommit(true);
    }
} catch (Exception e) { e.printStackTrace();
    try { if (cRA != null) cRA.rollback(); } catch (Exception ex) {}
} finally {
    try { if (cRA != null) cRA.close(); } catch (Exception e) {}
    try { if (cIA != null) cIA.close(); } catch (Exception e) {}
}

// ═══════════════════════════════════════════════════════════
// TIME + PARTITION SETUP
// ═══════════════════════════════════════════════════════════
String manualFromTime = request.getParameter("fromTime");
String manualToTime = request.getParameter("toTime");
String timeRangeDisplay;
if (manualFromTime != null && manualToTime != null && !manualFromTime.isEmpty() && !manualToTime.isEmpty()) {
    timeRangeDisplay = manualFromTime.replace("T", " ").replace("-", "/") + "  →  " +
                       manualToTime.replace("T", " ").replace("-", "/");
} else {
    SimpleDateFormat sd = new SimpleDateFormat("yyyy/MM/dd HH:mm");
    java.util.Date now = new java.util.Date();
    timeRangeDisplay = sd.format(new java.util.Date(now.getTime() - 10*60*1000)) + "  →  " + sd.format(now) + "  (Last 10 min)";
}

SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy HH:mm:ss");
String currentTime = sdf.format(new java.util.Date());
String activePartition = resolvePartition(manualFromTime);

// ═══════════════════════════════════════════════════════════
// 🚀 PARALLEL EXECUTION — dono queries SATH main chalti hain
// ═══════════════════════════════════════════════════════════
final String fFrom = manualFromTime;
final String fTo = manualToTime;
final String fPart = activePartition;

ExecutorService pool = Executors.newFixedThreadPool(2);
long globalStart = System.currentTimeMillis();

Future<InboundResult> inboundFuture = pool.submit(new Callable<InboundResult>() {
    public InboundResult call() { return fetchInbound(fFrom, fTo, fPart); }
});
Future<OutboundResult> outboundFuture = pool.submit(new Callable<OutboundResult>() {
    public OutboundResult call() { return fetchOutbound(fFrom, fTo, fPart); }
});

InboundResult inRes = new InboundResult();
OutboundResult outRes = new OutboundResult();
try { inRes = inboundFuture.get(120, TimeUnit.SECONDS); }
catch (Exception e) { inRes.error = "Inbound timeout/error: " + e.getMessage(); }
try { outRes = outboundFuture.get(120, TimeUnit.SECONDS); }
catch (Exception e) { outRes.error = "Outbound timeout/error: " + e.getMessage(); }
pool.shutdown();
long totalElapsed = System.currentTimeMillis() - globalStart;

// ── Build display query strings ──
String sampleTime = buildTimeCondition(manualFromTime, manualToTime);
String displayInboundQ =
    "SELECT /*+ PARALLEL(4) */ TRIM(DPG_IP) AS DPG_IP, COUNT(1) AS TOTAL_HITS\n" +
    "FROM EISAPP.API_LOG PARTITION (" + activePartition + ")\n" +
    "WHERE TRIM(DPG_IP) IN ('10.191.171.200', ...)\n" +
    "  " + sampleTime + "\nGROUP BY TRIM(DPG_IP) ORDER BY DPG_IP";
String displayOutboundQ =
    "SELECT /*+ PARALLEL(4) */ COUNT(*) AS TOTAL_HITS\n" +
    "FROM EISAPP.BACKEND_LOG PARTITION (" + activePartition + ")\n" +
    "WHERE END_POINT_PORT = '7443'\n  " + sampleTime;

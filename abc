<%@ page pageEncoding="UTF-8" language="java" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%
    // ✅ Session check
    if(session == null || session.getAttribute("role") == null) {
        response.sendRedirect(request.getContextPath() + "/login.action");
        return;
    }

    // ✅ Cache headers
    response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate, max-age=0, private");
    response.setHeader("Pragma", "no-cache");
    response.setDateHeader("Expires", 0);
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Deployment Sheet Master</title>

<!-- DataTables CSS -->
<link rel="stylesheet" href="<%=request.getContextPath()%>/css/Deployment.jquery.dataTables.min.css" />
<link rel="stylesheet" href="<%=request.getContextPath()%>/css/Deployment.buttons.dataTables.min.css" />

<!-- Scripts -->
<script src="<%=request.getContextPath()%>/js/Deployment.jquery-3.7.0.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.1.13.6.jquery.dataTables.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.2.4.1.dataTables.buttons.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.2.4.1.buttons.html5.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.2.4.1.buttons.print.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.3.10.1.jszip.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.0.2.7.pdfmake.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.0.2.7.vfs_fonts.js"></script>

<style>
/* ============================================================
   PAGE BASE
   ============================================================ */
body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg) !important;
    color: var(--ink) !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 15px;
    transition: background .3s ease, color .3s ease;
}

/* ✅ Content wrapper */
.new-wrapper {
    /* userheader se margin-left + padding-top auto */
    background: var(--bg);
    min-height: 100vh;
}
.page-container {
    padding: 24px 28px 48px;
    max-width: 1700px;
    margin: 0 auto;
}

/* ============================================================
   PAGE HEADER
   ============================================================ */
.page-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
}
.page-head .ttl {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -.5px;
    color: var(--ink);
    margin: 0;
    line-height: 1.2;
}
.page-head .ttl .ttl-icon {
    width: 42px; height: 42px;
    display: grid; place-items: center;
    background: var(--brand-light);
    color: var(--brand);
    border-radius: 12px;
    font-size: 1.05rem;
    flex-shrink: 0;
}
html[data-theme="dark"] .page-head .ttl .ttl-icon {
    background: rgba(248,111,3,.15);
}
.page-head .sub {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 500;
    margin: 6px 0 0 54px;
}

/* ============================================================
   ACTION BAR — Upload + Submit + Sample Format
   ============================================================ */
.action-bar {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px 20px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    box-shadow: 0 2px 12px rgba(0,0,0,.03);
}
html[data-theme="dark"] .action-bar {
    box-shadow: 0 2px 12px rgba(0,0,0,.3);
}

.file-picker {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 250px;
}
.file-picker .file-input-native {
    display: none;
}
.file-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    background: var(--bg);
    border: 1.5px dashed var(--line);
    border-radius: 11px;
    color: var(--muted);
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all .2s ease;
    flex: 1;
    justify-content: center;
}
.file-btn:hover {
    border-color: var(--brand);
    color: var(--brand);
    background: var(--brand-light);
}
html[data-theme="dark"] .file-btn:hover {
    background: rgba(248,111,3,.15);
}
.file-btn.has-file {
    border-style: solid;
    border-color: var(--brand);
    color: var(--brand);
    background: var(--brand-light);
}
html[data-theme="dark"] .file-btn.has-file {
    background: rgba(248,111,3,.15);
}
.file-btn .icon-svg,
.custom-btn .icon-svg {
    width: 14px; height: 14px;
    stroke-width: 2.4;
}
.file-name {
    font-size: 0.78rem;
    color: var(--muted);
    font-weight: 600;
    padding: 0 8px;
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.custom-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: 11px;
    color: var(--ink);
    font-family: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all .2s ease;
    text-decoration: none;
    white-space: nowrap;
}
.custom-btn:hover {
    border-color: var(--brand);
    color: var(--brand);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px -4px rgba(248,111,3,.3);
}
.custom-btn.primary {
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    color: #fff;
    border-color: transparent;
    box-shadow: 0 6px 20px -6px rgba(248,111,3,.4);
}
.custom-btn.primary:hover {
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px -6px rgba(248,111,3,.5);
}
.custom-btn.success {
    background: linear-gradient(135deg, #10b981, #059669);
    color: #fff;
    border-color: transparent;
    box-shadow: 0 6px 20px -6px rgba(16,185,129,.4);
}
.custom-btn.success:hover {
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px -6px rgba(16,185,129,.5);
}

/* ============================================================
   TABLE CARD
   ============================================================ */
.table-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,.03);
    overflow: hidden;
}
html[data-theme="dark"] .table-card {
    box-shadow: 0 2px 12px rgba(0,0,0,.3);
}

/* ============================================================
   DATATABLES THEME OVERRIDE
   ============================================================ */
.dataTables_wrapper {
    width: 100%;
    overflow-x: auto;
    color: var(--ink);
    font-size: 0.85rem;
}
.dataTables_wrapper .dataTables_filter,
.dataTables_wrapper .dataTables_length {
    margin-bottom: 14px;
    color: var(--muted);
    font-weight: 600;
}
.dataTables_wrapper .dataTables_filter input,
.dataTables_wrapper .dataTables_length select {
    background: var(--bg);
    border: 1.5px solid var(--line);
    border-radius: 9px;
    color: var(--ink);
    padding: 7px 12px;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.83rem;
    outline: none;
    transition: all .2s ease;
}
.dataTables_wrapper .dataTables_filter input:focus,
.dataTables_wrapper .dataTables_length select:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(248,111,3,.12);
}

/* Table */
table.dataTable {
    width: 100% !important;
    border-collapse: collapse !important;
    background: transparent !important;
    margin: 0 !important;
    color: var(--ink) !important;
    font-size: 0.82rem;
    font-family: inherit;
}
table.dataTable thead th {
    background: var(--bg) !important;
    color: var(--muted) !important;
    font-weight: 800 !important;
    font-size: 0.72rem !important;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 12px 14px !important;
    border-bottom: 1.5px solid var(--line) !important;
    border-top: none !important;
    white-space: nowrap;
    text-align: left;
}
table.dataTable tbody td {
    padding: 11px 14px !important;
    border-bottom: 1px solid var(--line) !important;
    color: var(--ink) !important;
    vertical-align: middle;
    white-space: nowrap;
    text-align: left;
    font-weight: 600;
}
table.dataTable tbody tr {
    background: var(--card) !important;
    transition: background .15s ease;
}
table.dataTable tbody tr:hover {
    background: var(--bg) !important;
}
html[data-theme="dark"] table.dataTable tbody tr:hover {
    background: rgba(255,255,255,.03) !important;
}
table.dataTable tbody tr:last-child td {
    border-bottom: none !important;
}

/* Striped (if enabled) */
table.dataTable.stripe tbody tr.odd {
    background: var(--card) !important;
}
table.dataTable.stripe tbody tr.even {
    background: var(--bg) !important;
}
html[data-theme="dark"] table.dataTable.stripe tbody tr.even {
    background: rgba(255,255,255,.02) !important;
}

/* ============================================================
   DATATABLES BUTTONS
   ============================================================ */
.dt-buttons {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
    flex-wrap: wrap;
}
.dt-buttons .dt-button {
    display: inline-flex !important;
    align-items: center;
    gap: 6px;
    padding: 9px 16px !important;
    background: var(--card) !important;
    border: 1.5px solid var(--line) !important;
    border-radius: 10px !important;
    color: var(--ink) !important;
    font-family: inherit !important;
    font-weight: 700 !important;
    font-size: 0.8rem !important;
    cursor: pointer;
    transition: all .2s ease !important;
    text-decoration: none !important;
    box-shadow: none !important;
}
.dt-buttons .dt-button:hover {
    border-color: var(--brand) !important;
    color: var(--brand) !important;
    background: var(--brand-light) !important;
    transform: translateY(-1px);
}
html[data-theme="dark"] .dt-buttons .dt-button:hover {
    background: rgba(248,111,3,.15) !important;
}

/* Pagination */
.dataTables_wrapper .dataTables_paginate {
    margin-top: 16px;
    display: flex;
    justify-content: flex-end;
    gap: 4px;
    flex-wrap: wrap;
}
.dataTables_wrapper .dataTables_paginate .paginate_button {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    padding: 0 10px !important;
    background: var(--card) !important;
    border: 1.5px solid var(--line) !important;
    border-radius: 9px !important;
    color: var(--muted) !important;
    font-weight: 700;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all .15s ease;
    margin: 0 !important;
}
.dataTables_wrapper .dataTables_paginate .paginate_button:hover {
    background: var(--bg) !important;
    border-color: var(--brand) !important;
    color: var(--brand) !important;
}
.dataTables_wrapper .dataTables_paginate .paginate_button.current {
    background: linear-gradient(135deg, var(--brand), var(--brand-2)) !important;
    color: #fff !important;
    border-color: transparent !important;
    box-shadow: 0 4px 12px -3px rgba(248,111,3,.4);
}
.dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
    opacity: .4;
    cursor: not-allowed;
}

/* Info text */
.dataTables_wrapper .dataTables_info {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
    margin-top: 16px;
}

/* Empty message */
.dataTables_empty {
    color: var(--muted) !important;
    font-style: italic;
    padding: 40px 20px !important;
    text-align: center;
    font-size: 0.9rem;
}

/* ============================================================
   PUSH BUTTON SECTION
   ============================================================ */
.push-section {
    margin-top: 24px;
    text-align: center;
    padding: 24px 20px;
    background: var(--card);
    border: 1.5px dashed var(--line);
    border-radius: 16px;
}
.push-section .push-hint {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 14px;
}

/* ============================================================
   LOADING / ALERT
   ============================================================ */
.custom-alert {
    display: none;
    padding: 14px 18px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.87rem;
    margin-bottom: 16px;
    align-items: center;
    gap: 10px;
}
.custom-alert.success {
    display: flex;
    background: rgba(16,185,129,.12);
    color: #059669;
    border: 1px solid rgba(16,185,129,.3);
}
.custom-alert.error {
    display: flex;
    background: rgba(239,68,68,.12);
    color: #b91c1c;
    border: 1px solid rgba(239,68,68,.3);
}
html[data-theme="dark"] .custom-alert.success { color: #34d399; }
html[data-theme="dark"] .custom-alert.error { color: #f87171; }
.custom-alert .icon-svg { width: 16px; height: 16px; }

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 900px) {
    .page-container { padding: 16px 14px 32px; }
    .page-head .ttl { font-size: 1.2rem; }
    .page-head .ttl .ttl-icon { width: 36px; height: 36px; font-size: .9rem; }
    .page-head .sub { margin-left: 48px; font-size: 0.78rem; }
    .action-bar { flex-direction: column; align-items: stretch; }
    .file-picker { width: 100%; }
    .custom-btn { justify-content: center; }
    .dt-buttons { flex-direction: column; }
    .dt-buttons .dt-button { width: 100%; justify-content: center; }
}
</style>
</head>
<body>

<%@include file="../userheader.jsp"%>

<div class="new-wrapper">
<div class="page-container">

    <!-- ============ PAGE HEADER ============ -->
    <div class="page-head">
        <div>
            <h1 class="ttl">
                <span class="ttl-icon">
                    <svg class="icon-svg" viewBox="0 0 24 24" style="width:20px;height:20px;stroke-width:2.4;">
                        <path d="M12 2v20M2 12h20"/>
                        <circle cx="12" cy="12" r="10"/>
                    </svg>
                </span>
                Deployment Sheet Master
            </h1>
            <p class="sub">Upload, review, and push deployment data to main table</p>
        </div>
    </div>

    <!-- ============ ALERT ============ -->
    <div class="custom-alert" id="customAlert">
        <svg class="icon-svg" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span id="customAlertMsg">Message</span>
    </div>

    <!-- ============ ACTION BAR ============ -->
    <div class="action-bar">
        <form id="uploadForm" enctype="multipart/form-data" method="post" style="display:flex;gap:12px;align-items:center;flex:1;flex-wrap:wrap;">
            <div class="file-picker">
                <input type="file" id="fileInput" name="file" class="file-input-native" />
                <label for="fileInput" class="file-btn" id="chooseFileBtn">
                    <svg class="icon-svg" viewBox="0 0 24 24">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                    <span id="fileLabel">Choose File</span>
                </label>
                <span class="file-name" id="fileName"></span>
            </div>

            <button type="button" class="custom-btn primary" id="submitFileBtn">
                <svg class="icon-svg" viewBox="0 0 24 24">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                </svg>
                Submit
            </button>

            <a href="<%=request.getContextPath()%>/XMLFile/Deployment_Sample_Format.xlsx" class="custom-btn" download>
                <svg class="icon-svg" viewBox="0 0 24 24">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                Sample Format
            </a>
        </form>
    </div>

    <!-- ============ TABLE ============ -->
    <div class="table-card">
        <table id="deploymentTable" class="display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>EXP URL</th>
                    <th>EXP URL W.R.T SYS URL</th>
                    <th>API_NAME</th>
                    <th>SOURCE_ID</th>
                    <th>Broker</th>
                    <th>Broker EG</th>
                    <th>New/Existing/NBC</th>
                    <th>Hits in Production</th>
                    <th>Failure (More than 50%)</th>
                    <th>Success</th>
                    <th>Changes Description</th>
                    <th>Remarks</th>
                    <th>Deployment Date Time</th>
                </tr>
            </thead>
            <tbody>
                <c:forEach var="row" items="${deploymentData}">
                    <tr>
                        <td>${row.EXP_URL}</td>
                        <td>${row.SYS_URL}</td>
                        <td>${row.API_NAME}</td>
                        <td>${row.SOURCE_ID}</td>
                        <td>${row.BROKER}</td>
                        <td>${row.BROKER_EG}</td>
                        <td>${row.STATUS}</td>
                        <td>${row.HITS}</td>
                        <td>${row.FAILURE}</td>
                        <td>${row.SUCCESS}</td>
                        <td>${row.CHANGES_DESC}</td>
                        <td>${row.REMARKS}</td>
                        <td>${row.DEPLOYMENT_DATE}</td>
                    </tr>
                </c:forEach>
            </tbody>
        </table>
    </div>

    <!-- ============ PUSH BUTTON ============ -->
    <div class="push-section">
        <div class="push-hint">Ready to move the reviewed data to the main deployment table?</div>
        <button type="button" class="custom-btn success" id="pushDataBtn">
            <svg class="icon-svg" viewBox="0 0 24 24">
                <path d="M12 19V5M5 12l7-7 7 7"/>
            </svg>
            Push Data to Main Table
        </button>
    </div>

</div>
</div>

<script>
$(document).ready(function () {

    /* ============================================================
       DATATABLE INIT
       ============================================================ */
    const table = $('#deploymentTable').DataTable({
        dom: 'Bfrtip',
        paging: true,
        scrollX: true,
        responsive: false,
        pageLength: 15,
        searching: true,
        ordering: true,
        order: [],
        lengthChange: false,
        language: {
            search: "",
            searchPlaceholder: "Search deployments...",
            emptyTable: "No deployments found. Upload a file to get started.",
            info: "Showing _START_ to _END_ of _TOTAL_ deployments",
            infoEmpty: "No deployments to show",
            infoFiltered: "(filtered from _MAX_ total)"
        },
        buttons: [
            {
                extend: 'excelHtml5',
                text: 'Export Excel',
                exportOptions: { columns: ':visible' }
            },
            {
                extend: 'pdfHtml5',
                text: 'Export PDF',
                exportOptions: { columns: ':visible' },
                orientation: 'landscape',
                pageSize: 'A4'
            }
        ]
    });

    /* ============================================================
       ALERT HELPER
       ============================================================ */
    function showAlert(msg, type) {
        const el = document.getElementById('customAlert');
        const msgEl = document.getElementById('customAlertMsg');
        if (!el || !msgEl) return;
        el.className = 'custom-alert ' + (type || 'success');
        msgEl.textContent = msg;
        setTimeout(function () {
            el.className = 'custom-alert';
        }, 4000);
    }

    /* ============================================================
       FILE INPUT — show filename
       ============================================================ */
    $('#fileInput').on('change', function () {
        const file = this.files[0];
        const label = document.getElementById('fileLabel');
        const nameEl = document.getElementById('fileName');
        const btn = document.getElementById('chooseFileBtn');
        if (file) {
            label.textContent = 'File Selected';
            nameEl.textContent = file.name;
            btn.classList.add('has-file');
        } else {
            label.textContent = 'Choose File';
            nameEl.textContent = '';
            btn.classList.remove('has-file');
        }
    });

    /* ============================================================
       SUBMIT FILE — AJAX
       ============================================================ */
    $('#submitFileBtn').on('click', function () {
        const file = $('#fileInput')[0].files[0];
        if (!file) {
            showAlert('Please choose a file first!', 'error');
            return;
        }

        const formData = new FormData();
        formData.append("file", file);
        formData.append("action", "upload");

        const btn = $(this);
        btn.prop('disabled', true).css('opacity', '.7');

        $.ajax({
            url: '<%=request.getContextPath()%>/DeploymentSheetServlet',
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                showAlert(res || 'File uploaded successfully!', 'success');
                setTimeout(function () {
                    window.location.href = '<%=request.getContextPath()%>/DeploymentSheetServlet';
                }, 800);
            },
            error: function () {
                showAlert('Error uploading file. Please try again.', 'error');
                btn.prop('disabled', false).css('opacity', '1');
            }
        });
    });

    /* ============================================================
       PUSH DATA — AJAX
       ============================================================ */
    $('#pushDataBtn').on('click', function () {
        if (!confirm('Push data to main table? This will move the current data.')) return;

        const btn = $(this);
        btn.prop('disabled', true).css('opacity', '.7');

        $.ajax({
            url: '<%=request.getContextPath()%>/DeploymentSheetServlet',
            type: "POST",
            data: { action: "push" },
            success: function (res) {
                showAlert(res || 'Data pushed successfully!', 'success');
                setTimeout(function () {
                    window.location.href = '<%=request.getContextPath()%>/DeploymentSheetServlet';
                }, 800);
            },
            error: function () {
                showAlert('Error occurred while pushing data!', 'error');
                btn.prop('disabled', false).css('opacity', '1');
            }
        });
    });

});
</script>

</body>
</html>

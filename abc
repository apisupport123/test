<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="java.sql.*, java.util.*, java.text.*" %>
<%@page import="com.jdbc.DBUtilityAuto"%>
<%!
String getPartition() {
    Calendar cal = Calendar.getInstance();
    String month = new SimpleDateFormat("MMM", Locale.US).format(cal.getTime()).toUpperCase();
    String year = new SimpleDateFormat("yy", Locale.US).format(cal.getTime());
    return month + "_" + year;
}
%>
<%
String action = request.getParameter("action");

if ("fetchSourceStatus".equals(action)) {
    response.setContentType("application/json");
    Connection conn = null;
    Statement stmt = null;
    ResultSet rs = null;
    StringBuilder json = new StringBuilder();
    
    try {
        conn = DBUtilityAuto.getIIBDBConnection();
        String partition = getPartition();
        
        String query = 
            "WITH FOUND_SOURCES AS ( " +
            "   SELECT /*+ parallel(04) */ a.source_id " +
            "   FROM eisapp.api_log PARTITION(" + partition + ") a " +
            "   WHERE a.source_id IN ('AK','CA','CC','CK','CR','FA','FS','I4','IN','KA','MB','NB','ON','RL','SA','SK','SQ','UP','WB','Y2') " +
            "   AND a.request_date_time >= SYSDATE - INTERVAL '10' MINUTE " +
            "   GROUP BY a.source_id " +
            ") " +
            "SELECT s.source_id, " +
            "CASE WHEN f.source_id IS NOT NULL THEN 'Y' ELSE 'N' END AS flag " +
            "FROM ( " +
            "   SELECT 'SA' AS source_id FROM DUAL UNION ALL " +
            "   SELECT 'FS' FROM DUAL UNION ALL " +
            "   SELECT 'I4' FROM DUAL UNION ALL " +
            "   SELECT 'Y2' FROM DUAL UNION ALL " +
            "   SELECT 'KA' FROM DUAL UNION ALL " +
            "   SELECT 'FA' FROM DUAL UNION ALL " +
            "   SELECT 'WB' FROM DUAL UNION ALL " +
            "   SELECT 'ON' FROM DUAL UNION ALL " +
            "   SELECT 'CC' FROM DUAL UNION ALL " +
            "   SELECT 'CK' FROM DUAL UNION ALL " +
            "   SELECT 'CR' FROM DUAL UNION ALL " +
            "   SELECT 'SQ' FROM DUAL UNION ALL " +
            "   SELECT 'RL' FROM DUAL UNION ALL " +
            "   SELECT 'UP' FROM DUAL UNION ALL " +
            "   SELECT 'CA' FROM DUAL UNION ALL " +
            "   SELECT 'AK' FROM DUAL UNION ALL " +
            "   SELECT 'NB' FROM DUAL UNION ALL " +
            "   SELECT 'IN' FROM DUAL UNION ALL " +
            "   SELECT 'MB' FROM DUAL UNION ALL " +
            "   SELECT 'SK' FROM DUAL " +
            ") s " +
            "LEFT JOIN FOUND_SOURCES f ON f.source_id = s.source_id " +
            "ORDER BY s.source_id";
        
        stmt = conn.createStatement();
        stmt.setQueryTimeout(1200);
        rs = stmt.executeQuery(query);
        
        json.append("[");
        boolean first = true;
        while (rs.next()) {
            if (!first) json.append(",");
            json.append("{");
            json.append("\"source_id\":\"").append(rs.getString("source_id")).append("\",");
            json.append("\"flag\":\"").append(rs.getString("flag")).append("\"");
            json.append("}");
            first = false;
        }
        json.append("]");
        out.print(json.toString());
        
    } catch(Exception e) {
        String errorMsg = e.getMessage();
        if (errorMsg == null) errorMsg = "Unknown error";
        errorMsg = errorMsg.replace("\"", "'").replace("\n", " ");
        out.print("{\"error\":\"" + errorMsg + "\"}");
        e.printStackTrace();
    } finally {
        try { if (rs != null) rs.close(); } catch(Exception e) {}
        try { if (stmt != null) stmt.close(); } catch(Exception e) {}
        try { if (conn != null) conn.close(); } catch(Exception e) {}
    }
    return;
}

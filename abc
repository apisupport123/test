<%
    String ctx = request.getContextPath();
    String empid = request.getParameter("empid");
    EmployeeDetailsBean emp = null;

    if (empid != null && !empid.trim().isEmpty()) {
        Connection con = null;
        PreparedStatement ps = null;
        ResultSet rs = null;
        try {
            con = DBUtilityAuto.getReportDBConnection();
            ps = con.prepareStatement("SELECT * FROM eisupport_employee_master WHERE EMPLOYEE_ID = ?");
            ps.setString(1, empid);
            rs = ps.executeQuery();
            if (rs.next()) {
                emp = new EmployeeDetailsBean();
                emp.setM_strEmployee_ID(rs.getString("EMPLOYEE_ID"));
                emp.setM_strAD_ID(rs.getString("AD_ID"));
                emp.setM_strHID(rs.getString("HID"));
                emp.setM_strAsset_ID(rs.getString("ASSET_ID"));
                emp.setM_strEducation_Qualification(rs.getString("EDU_QUALIFICATION"));
                emp.setM_strTCS_Joining_Date(rs.getString("TCS_JOINING_DATE"));
                emp.setM_strEmployee_contact_Number(rs.getString("CONTACTNUMBER"));
                emp.setM_strEmergency_contact_Number(rs.getString("EMERGENCY_CONTACTNUMBER"));
                emp.setM_strTeam(rs.getString("TEAM"));
                emp.setM_strTCS_mail_ID(rs.getString("TCS_MAILID"));
                emp.setM_strSBI_mail_ID(rs.getString("SBI_MAILID"));
                emp.setM_strState(rs.getString("STATE"));
                emp.setM_strCity(rs.getString("CITY"));
                emp.setM_strLocal_Address(rs.getString("LOCAL_ADDRESS"));
                emp.setM_strGender(rs.getString("GENDER"));
                emp.setM_strDate_Of_Birth(rs.getString("DOB"));
                emp.setM_strFirst_Name(rs.getString("FIRSTNAME"));
                emp.setM_strMiddle_Name(rs.getString("MIDDLENAME"));
                emp.setM_strLast_Name(rs.getString("LASTNAME"));
                emp.setM_strISACTIVE(rs.getString("ISACTIVE"));
                emp.setM_strVPN_Hostname(rs.getString("VPN_HOSTNAME"));
                emp.setM_strLaptop_Hostname(rs.getString("LAPTOP_HOSTNAME"));
                emp.setM_strRemote_Type(rs.getString("REMOTETYPE"));
                emp.setM_strVPN_VDI_MAC_Address(rs.getString("VPN_VDI_MACADDRESS"));
                emp.setM_strVPN_VDI_IP_Address(rs.getString("VPN_VDI_IPADDRESS"));
                emp.setM_strUserName(rs.getString("USERNAME"));
                emp.setM_strPassword(rs.getString("PASSWORD"));

                Blob p = rs.getBlob("PHOTO_PATH");
                Blob b = rs.getBlob("BGC_DOCUMENT_PATH");
                Blob po = rs.getBlob("POLICE_VERIFICATION_PATH");
                Blob c = rs.getBlob("CV_DOCUMENT_PATH");
                emp.setM_strPhoto_Path(p != null && p.length() > 0 ? "Uploaded" : "");
                emp.setM_strBGC_Documents_Path(b != null && b.length() > 0 ? "Uploaded" : "");
                emp.setM_strPolice_Verification_Path(po != null && po.length() > 0 ? "Uploaded" : "");
                emp.setM_strCV_Document(c != null && c.length() > 0 ? "Uploaded" : "");
                if (p != null) p.free();
                if (b != null) b.free();
                if (po != null) po.free();
                if (c != null) c.free();
            }
        } catch (Exception e) { e.printStackTrace(); }
        finally {
            try { if (rs != null) rs.close(); } catch (Exception ignore) {}
            try { if (ps != null) ps.close(); } catch (Exception ignore) {}
            try { if (con != null) con.close(); } catch (Exception ignore) {}
        }
    }

    String fname = emp != null && emp.getM_strFirst_Name() != null ? emp.getM_strFirst_Name() : "";
    String lname = emp != null && emp.getM_strLast_Name() != null ? emp.getM_strLast_Name() : "";
    String fullName = (fname + " " + lname).trim();
    if (fullName.isEmpty()) fullName = "Employee";
    String initial = fname.isEmpty() ? "?" : fname.substring(0,1).toUpperCase();
    String isActive = emp != null && emp.getM_strISACTIVE() != null ? emp.getM_strISACTIVE() : "";
    boolean active = "Active".equalsIgnoreCase(isActive.trim());
%>

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit Profile · EIS Live</title>

<style>
/* ============================================================
   THEME TOKENS
   ============================================================ */
:root,
html[data-theme="dark"] {
    --bg: #05060d;
    --surface: rgba(255, 255, 255, .03);
    --surface-2: rgba(255, 255, 255, .06);
    --surface-3: rgba(255, 255, 255, .1);
    --border: rgba(255, 255, 255, .08);
    --border-hi: rgba(255, 255, 255, .16);
    --text: #f8fafc;
    --text-2: #cbd5e1;
    --text-3: #94a3b8;
    --text-4: #475569;

    --card-bg: rgba(15, 10, 35, .55);
    --nav-bg: rgba(15, 10, 35, .6);
    --bar-bg: rgba(15, 10, 35, .85);
    --input-bg: rgba(0, 0, 0, .3);
    --input-bg-hover: rgba(0, 0, 0, .4);
    --input-bg-focus: rgba(0, 0, 0, .5);
    --option-bg: #0a0b14;

    --aurora-opacity: .55;
    --wave-opacity: .35;
    --particle-color: #fff;
    --particle-shadow: rgba(255, 255, 255, .5);
}

html[data-theme="light"] {
    --bg: #f5f3ff;
    --surface: rgba(255, 255, 255, .6);
    --surface-2: rgba(255, 255, 255, .8);
    --surface-3: rgba(255, 255, 255, .95);
    --border: rgba(15, 23, 42, .08);
    --border-hi: rgba(15, 23, 42, .15);
    --text: #0f172a;
    --text-2: #334155;
    --text-3: #64748b;
    --text-4: #94a3b8;

    --card-bg: rgba(255, 255, 255, .75);
    --nav-bg: rgba(255, 255, 255, .85);
    --bar-bg: rgba(255, 255, 255, .9);
    --input-bg: rgba(255, 255, 255, .8);
    --input-bg-hover: rgba(255, 255, 255, .95);
    --input-bg-focus: #fff;
    --option-bg: #ffffff;

    --aurora-opacity: .45;
    --wave-opacity: .4;
    --particle-color: #a855f7;
    --particle-shadow: rgba(168, 85, 247, .6);
}

:root {
    --p1: #ff0080;
    --p2: #7928ca;
    --p3: #00d4ff;
    --p4: #00ff88;
    --p5: #ffcc00;
    --p6: #ff5500;

    --radius-sm: 12px;
    --radius:    18px;
    --radius-lg: 26px;
    --font: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    line-height: 1.5;
    letter-spacing: -.01em;
    transition: background .4s ease, color .4s ease;
}

/* ============================================================
   LIVE BACKGROUND
   ============================================================ */
.live-bg {
    position: fixed;
    inset: 0;
    z-index: -3;
    overflow: hidden;
    transition: background .4s ease;
}
html[data-theme="dark"] .live-bg {
    background: radial-gradient(ellipse at top, #0f0420 0%, #05060d 60%);
}
html[data-theme="light"] .live-bg {
    background: radial-gradient(ellipse at top, #fce7f3 0%, #ede9fe 40%, #dbeafe 70%, #f5f3ff 100%);
}

.aurora {
    position: absolute;
    inset: -50%;
    filter: blur(80px);
    opacity: var(--aurora-opacity);
    animation: auroraMove 20s ease-in-out infinite;
    transition: opacity .4s ease;
}
.aurora-1 { background: radial-gradient(circle at 30% 30%, var(--p1), transparent 45%); animation-delay: 0s; }
.aurora-2 { background: radial-gradient(circle at 70% 40%, var(--p2), transparent 45%); animation-delay: -5s; }
.aurora-3 { background: radial-gradient(circle at 50% 80%, var(--p3), transparent 45%); animation-delay: -10s; }
.aurora-4 { background: radial-gradient(circle at 20% 70%, var(--p4), transparent 45%); animation-delay: -15s; }
@keyframes auroraMove {
    0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); }
    33%      { transform: translate(15%, -10%) rotate(30deg) scale(1.15); }
    66%      { transform: translate(-10%, 15%) rotate(-20deg) scale(.9); }
}

.wave-layer {
    position: absolute;
    bottom: 0; left: 0;
    width: 200%; height: 300px;
    opacity: var(--wave-opacity);
    animation: waveMove 25s linear infinite;
    transition: opacity .4s ease;
}
.wave-layer.w2 { animation-duration: 35s; animation-direction: reverse; opacity: calc(var(--wave-opacity) * .6); bottom: -50px; }
@keyframes waveMove {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

.particles { position: absolute; inset: 0; pointer-events: none; }
.particle {
    position: absolute;
    width: 3px; height: 3px;
    border-radius: 50%;
    opacity: 0;
    animation: particleFloat linear infinite;
    background: var(--particle-color);
    box-shadow: 0 0 8px var(--particle-shadow);
}
@keyframes particleFloat {
    0%   { opacity: 0; transform: translateY(100vh) translateX(0) scale(0); }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { opacity: 0; transform: translateY(-10vh) translateX(80px) scale(1); }
}

/* ============================================================
   TOP NAV
   ============================================================ */
.navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 16px 24px 12px;
}
.nav-inner {
    max-width: 1480px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 14px 24px;
    background: var(--nav-bg);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid var(--border);
    border-radius: 100px;
    position: relative;
    overflow: hidden;
    transition: background .4s ease, border-color .4s ease;
}
.nav-inner::before {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: 100px;
    padding: 1px;
    background: conic-gradient(from 0deg,
        var(--p1), var(--p5), var(--p4), var(--p3), var(--p2), var(--p1));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: rotateBorder 6s linear infinite;
    z-index: -1;
    opacity: .7;
}
@keyframes rotateBorder {
    to { transform: rotate(360deg); }
}

.nav-brand { display: flex; align-items: center; gap: 12px; }
.brand-logo {
    width: 40px; height: 40px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--p1), var(--p2));
    display: grid; place-items: center;
    font-weight: 900;
    font-size: 14px;
    color: #fff;
    letter-spacing: -.5px;
    position: relative;
    overflow: hidden;
}
.brand-logo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,.5), transparent);
    transform: translateX(-100%);
    animation: shine 2.5s ease-in-out infinite;
}
@keyframes shine {
    to { transform: translateX(100%); }
}

.brand-title { font-size: 15px; font-weight: 700; letter-spacing: -.02em; }
.brand-sub { font-size: 11px; color: var(--text-3); }

.nav-status {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    color: var(--text-2);
}
.live-dot {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 100px;
    background: rgba(0, 255, 136, .1);
    border: 1px solid rgba(0, 255, 136, .3);
    color: #00ff88;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
}
.live-dot::before {
    content: "";
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #00ff88;
    box-shadow: 0 0 12px #00ff88;
    animation: livePulse 1.5s ease-in-out infinite;
}
@keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: .4; transform: scale(.7); }
}

/* Theme toggle */
.theme-toggle {
    position: relative;
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--surface-2);
    border: 1px solid var(--border-hi);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: all .35s cubic-bezier(.34, 1.56, .64, 1);
    overflow: hidden;
    padding: 0;
}
.theme-toggle:hover {
    transform: rotate(20deg) scale(1.08);
    box-shadow: 0 10px 30px rgba(255, 0, 128, .3);
}
.theme-toggle .icon {
    position: absolute;
    font-size: 20px;
    transition: all .6s cubic-bezier(.34, 1.56, .64, 1);
    display: block;
}
.theme-toggle .sun  { opacity: 0; transform: rotate(-180deg) scale(.4); }
.theme-toggle .moon { opacity: 1; transform: rotate(0) scale(1); }
html[data-theme="light"] .theme-toggle .sun  { opacity: 1; transform: rotate(0) scale(1); }
html[data-theme="light"] .theme-toggle .moon { opacity: 0; transform: rotate(180deg) scale(.4); }

.nav-btn {
    padding: 9px 18px;
    border-radius: 100px;
    background: var(--surface-2);
    border: 1px solid var(--border-hi);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all .3s cubic-bezier(.34, 1.56, .64, 1);
    white-space: nowrap;
}
.nav-btn:hover {
    background: var(--surface-3);
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 10px 30px rgba(255, 0, 128, .3);
}

/* ============================================================
   PAGE
   ============================================================ */
.page {
    max-width: 1480px;
    margin: 0 auto;
    padding: 20px 24px 100px;
    position: relative;
    z-index: 1;
}

.hero {
    margin-bottom: 32px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
}
.hero-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 900;
    letter-spacing: -.04em;
    line-height: 1.05;
    margin-bottom: 10px;
    background: linear-gradient(120deg, var(--text), var(--p1), var(--p3), var(--text));
    background-size: 300% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradientShift 5s linear infinite;
}
@keyframes gradientShift {
    to { background-position: 300% center; }
}
.hero-sub { font-size: 15px; color: var(--text-3); max-width: 600px; }
.hero-badges { display: flex; gap: 10px; flex-wrap: wrap; }

.badge-live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 100px;
    background: var(--surface-2);
    border: 1px solid var(--border-hi);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-2);
    backdrop-filter: blur(12px);
    position: relative;
    overflow: hidden;
}
.badge-live::before {
    content: "";
    position: absolute;
    inset: -50%;
    background: conic-gradient(from 0deg, transparent, var(--p1), transparent 30%);
    animation: rotateBorder 4s linear infinite;
    z-index: -1;
    opacity: .5;
}
.badge-live .kv { color: var(--text); font-weight: 800; }
.badge-live.active { color: #00ff88; border-color: rgba(0, 255, 136, .3); }

/* ============================================================
   LAYOUT
   ============================================================ */
.layout {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 24px;
    align-items: start;
}
.sidebar { display: flex; flex-direction: column; gap: 20px; position: sticky; top: 100px; }
.main-col { display: grid; gap: 24px; }

/* ============================================================
   CARD
   ============================================================ */
.card {
    position: relative;
    background: var(--card-bg);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    transition: all .4s cubic-bezier(.22, 1, .36, 1);
    overflow: hidden;
    opacity: 0;
    transform: translateY(20px);
    animation: cardIn .6s cubic-bezier(.22, 1, .36, 1) forwards;
}
.card:nth-child(1) { animation-delay: .1s; }
.card:nth-child(2) { animation-delay: .15s; }
.card:nth-child(3) { animation-delay: .2s; }
.card:nth-child(4) { animation-delay: .25s; }
.card:nth-child(5) { animation-delay: .3s; }
.card:nth-child(6) { animation-delay: .35s; }
@keyframes cardIn {
    to { opacity: 1; transform: translateY(0); }
}

.card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    padding: 1px;
    background: conic-gradient(from 0deg,
        transparent, var(--glow, var(--p1)), transparent 30%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity .3s ease;
    animation: rotateBorder 4s linear infinite;
    pointer-events: none;
}
.card:hover::before { opacity: 1; }

.card:hover {
    transform: translateY(-6px);
    box-shadow: 0 25px 50px rgba(0, 0, 0, .3), 0 0 40px rgba(255, 0, 128, .1);
    border-color: transparent;
}

.card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
}
.card-icon {
    width: 48px; height: 48px;
    border-radius: 14px;
    display: grid; place-items: center;
    font-size: 22px;
    flex-shrink: 0;
    position: relative;
    transition: transform .3s cubic-bezier(.34, 1.56, .64, 1);
    color: #fff;
}
.card:hover .card-icon { transform: rotate(-10deg) scale(1.1); }

.icon-float { animation: iconFloat 3s ease-in-out infinite; }
@keyframes iconFloat {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-4px); }
}
.icon-pulse { animation: iconPulse 2s ease-in-out infinite; }
@keyframes iconPulse {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.08); }
}
.icon-spin-slow { animation: iconSpin 8s linear infinite; }
@keyframes iconSpin { to { transform: rotate(360deg); } }

.card-title { font-size: 18px; font-weight: 800; letter-spacing: -.03em; margin-bottom: 3px; color: var(--text); }
.card-sub { font-size: 12.5px; color: var(--text-3); }
.card-num {
    margin-left: auto;
    font-family: ui-monospace, monospace;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 100px;
    background: var(--surface-2);
    color: var(--text-3);
    border: 1px solid var(--border);
}

/* ============================================================
   PROFILE CARD
   ============================================================ */
.profile-card { text-align: center; --glow: var(--p1); }
.avatar-wrap {
    position: relative;
    width: 150px; height: 150px;
    margin: 0 auto 20px;
    display: grid;
    place-items: center;
}
.avatar-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg,
        var(--p1), var(--p5), var(--p4), var(--p3), var(--p2), var(--p1));
    animation: rotateBorder 4s linear infinite;
}
.avatar-ring-2 {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: conic-gradient(from 180deg, var(--p3), var(--p2), var(--p1), var(--p3));
    animation: rotateBorder 7s linear infinite reverse;
    opacity: .5;
    filter: blur(8px);
}
.avatar-ring-3 {
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--p1), transparent 70%);
    animation: avatarPulse 3s ease-in-out infinite;
    opacity: .4;
    filter: blur(20px);
}
@keyframes avatarPulse {
    0%, 100% { transform: scale(1); opacity: .4; }
    50%      { transform: scale(1.2); opacity: .15; }
}
.avatar-img {
    position: relative;
    width: 138px; height: 138px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--bg);
    z-index: 1;
    display: block;
    transition: border-color .4s ease;
}
.avatar-overlay {
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    background: rgba(0, 0, 0, .75);
    backdrop-filter: blur(8px);
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    opacity: 0;
    cursor: pointer;
    transition: opacity .3s;
    z-index: 2;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
}
.avatar-overlay .icon { font-size: 28px; }
.avatar-wrap:hover .avatar-overlay { opacity: 1; }

.profile-name {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -.03em;
    margin-bottom: 6px;
    background: linear-gradient(135deg, var(--text), var(--p3));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}
.profile-role { font-size: 13px; color: var(--text-3); margin-bottom: 16px; }
.profile-role .team-chip {
    display: inline-block;
    padding: 3px 10px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 11.5px;
    color: var(--text-2);
    margin: 0 3px;
}

.counters {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    margin-top: 20px;
}
.counter {
    padding: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-align: left;
    transition: all .3s ease;
}
.counter:hover { background: var(--surface-2); transform: translateY(-2px); }
.counter-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
    color: var(--text-4);
    margin-bottom: 4px;
}
.counter-value {
    font-size: 14px;
    font-weight: 800;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ============================================================
   DOCUMENTS
   ============================================================ */
.doc-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    margin-bottom: 10px;
    transition: all .35s cubic-bezier(.34, 1.56, .64, 1);
    cursor: pointer;
    position: relative;
    overflow: hidden;
}
.doc-item:hover {
    transform: translateX(6px);
    background: var(--surface-2);
    border-color: var(--border-hi);
}
.doc-item.uploaded {
    background: linear-gradient(135deg, rgba(0, 255, 136, .05), rgba(0, 212, 255, .03));
    border-color: rgba(0, 255, 136, .25);
}
.doc-icon {
    width: 42px; height: 42px;
    border-radius: 12px;
    display: grid; place-items: center;
    font-size: 20px;
    background: var(--surface-2);
    flex-shrink: 0;
    transition: all .3s ease;
}
.doc-item.uploaded .doc-icon {
    background: linear-gradient(135deg, #00ff88, #00d4ff);
    box-shadow: 0 6px 20px rgba(0, 255, 136, .4);
}
.doc-item:hover .doc-icon { transform: rotate(-10deg) scale(1.1); }
.doc-info { flex: 1; min-width: 0; }
.doc-name { font-size: 13.5px; font-weight: 700; color: var(--text); margin-bottom: 2px; }
.doc-status { font-size: 11px; font-weight: 600; color: var(--text-3); }
.doc-item.uploaded .doc-status { color: #00ff88; }
.doc-view {
    width: 36px; height: 36px;
    border-radius: 10px;
    border: none;
    background: var(--surface-2);
    color: var(--text-2);
    cursor: pointer;
    display: grid; place-items: center;
    font-size: 15px;
    transition: all .3s cubic-bezier(.34, 1.56, .64, 1);
}
.doc-view:hover {
    background: linear-gradient(135deg, var(--p1), var(--p2));
    color: #fff;
    transform: scale(1.15) rotate(-8deg);
    box-shadow: 0 8px 24px rgba(255, 0, 128, .4);
}

/* ============================================================
   FIELDS
   ============================================================ */
.fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
}
.fields .span-2 { grid-column: span 2; }
@media (max-width: 700px) { .fields .span-2 { grid-column: span 1; } }

.field { display: flex; flex-direction: column; gap: 8px; position: relative; }
.field-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-2);
    letter-spacing: .02em;
    display: flex;
    align-items: center;
    gap: 6px;
    padding-left: 2px;
}
.field-label .dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--p3);
    box-shadow: 0 0 8px var(--p3);
    animation: livePulse 2s ease-in-out infinite;
}
.field-label .req { color: var(--p1); font-size: 14px; }

.field-input,
.field-select,
.field-textarea {
    width: 100%;
    padding: 13px 16px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    background: var(--input-bg);
    border: 1.5px solid var(--border);
    border-radius: 12px;
    outline: none;
    transition: all .3s cubic-bezier(.22, 1, .36, 1);
    position: relative;
}
.field-input:hover:not(:focus):not(:read-only),
.field-select:hover:not(:focus) {
    background: var(--input-bg-hover);
    border-color: var(--border-hi);
}
.field-input:focus,
.field-select:focus,
.field-textarea:focus {
    background: var(--input-bg-focus);
    border-color: var(--p1);
    box-shadow: 0 0 0 4px rgba(255, 0, 128, .15),
                0 0 30px rgba(255, 0, 128, .25);
    transform: translateY(-2px);
}
.field-input:read-only {
    color: var(--text-3);
    background: var(--surface);
    border-style: dashed;
    cursor: not-allowed;
}
.field-select {
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23ec4899' stroke-width='2.5'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat: no-repeat;
    background-position: right 14px center;
    background-size: 16px;
    padding-right: 44px;
    cursor: pointer;
}
.field-select option {
    background: var(--option-bg);
    color: var(--text);
}
.field-textarea { resize: vertical; min-height: 90px; }

/* File drop */
.file-drop {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    background: var(--surface);
    border: 1.5px dashed var(--border-hi);
    border-radius: 14px;
    cursor: pointer;
    transition: all .35s cubic-bezier(.22, 1, .36, 1);
    position: relative;
    overflow: hidden;
}
.file-drop::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent, rgba(255, 0, 128, .15), transparent);
    transform: translateX(-100%);
    transition: transform .6s ease;
}
.file-drop:hover::after { transform: translateX(100%); }
.file-drop:hover {
    border-color: var(--p1);
    background: rgba(255, 0, 128, .05);
    transform: translateY(-2px);
}
.file-drop.has-file {
    border-style: solid;
    border-color: #00ff88;
    background: rgba(0, 255, 136, .05);
}
.file-drop input[type="file"] { display: none; }
.file-drop-icon {
    width: 44px; height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--p1), var(--p2));
    color: #fff;
    display: grid; place-items: center;
    font-size: 20px;
    flex-shrink: 0;
    transition: all .3s cubic-bezier(.34, 1.56, .64, 1);
    box-shadow: 0 6px 20px rgba(255, 0, 128, .4);
}
.file-drop:hover .file-drop-icon { transform: scale(1.1) rotate(-10deg); }
.file-drop.has-file .file-drop-icon {
    background: linear-gradient(135deg, #00ff88, #00d4ff);
    box-shadow: 0 6px 20px rgba(0, 255, 136, .4);
}
.file-text { flex: 1; min-width: 0; }
.file-name {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.file-hint { font-size: 11.5px; color: var(--text-3); }
.file-drop.has-file .file-name { color: #00ff88; }

/* ============================================================
   ACTION BAR
   ============================================================ */
.action-bar {
    position: sticky;
    bottom: 20px;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 24px;
    background: var(--bar-bg);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid var(--border-hi);
    border-radius: 100px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, .3);
    opacity: 0;
    animation: cardIn .6s cubic-bezier(.22, 1, .36, 1) .4s forwards;
    overflow: hidden;
    transition: background .4s ease;
}
.action-bar::before {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: 100px;
    padding: 1px;
    background: conic-gradient(from 0deg,
        var(--p1), var(--p5), var(--p4), var(--p3), var(--p2), var(--p1));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: rotateBorder 5s linear infinite;
    opacity: .6;
    z-index: -1;
}
.action-hint {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-3);
    font-weight: 500;
}
.action-hint .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--p5);
    box-shadow: 0 0 12px var(--p5);
    animation: livePulse 1.5s ease-in-out infinite;
}

.btn {
    padding: 12px 24px;
    border-radius: 100px;
    border: 1px solid var(--border-hi);
    background: var(--surface-2);
    color: var(--text);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    transition: all .3s cubic-bezier(.34, 1.56, .64, 1);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    position: relative;
    overflow: hidden;
}
.btn:hover {
    background: var(--surface-3);
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 12px 30px rgba(0, 0, 0, .3);
}
.btn-primary {
    background: linear-gradient(135deg, var(--p1), var(--p2), var(--p3));
    background-size: 200% auto;
    color: #fff;
    border-color: transparent;
    box-shadow: 0 8px 30px rgba(255, 0, 128, .5);
    animation: gradientShift 3s linear infinite;
}
.btn-primary:hover {
    box-shadow: 0 12px 40px rgba(255, 0, 128, .7),
                0 0 60px rgba(121, 40, 202, .5);
}
.btn-primary::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, .3), transparent);
    transform: translateX(-100%);
    animation: shine 2s ease-in-out infinite;
}

/* ============================================================
   TOAST
   ============================================================ */
.toast-host {
    position: fixed;
    top: 100px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 380px;
}
.toast {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: var(--bar-bg);
    backdrop-filter: blur(24px);
    border: 1px solid var(--border-hi);
    border-radius: 16px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, .4);
    animation: toastIn .4s cubic-bezier(.34, 1.56, .64, 1);
    color: var(--text);
    font-size: 13.5px;
    font-weight: 600;
    position: relative;
    overflow: hidden;
}
.toast::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
}
.toast.success::before { background: linear-gradient(180deg, #00ff88, #00d4ff); }
.toast.error::before   { background: linear-gradient(180deg, #ff0080, #ff5500); }
.toast.info::before    { background: linear-gradient(180deg, #00d4ff, #7928ca); }
.toast-icon {
    width: 34px; height: 34px;
    border-radius: 10px;
    display: grid; place-items: center;
    font-size: 16px;
    font-weight: 700;
    flex-shrink: 0;
    color: #fff;
}
.toast.success .toast-icon { background: linear-gradient(135deg, #00ff88, #00d4ff); }
.toast.error   .toast-icon { background: linear-gradient(135deg, #ff0080, #ff5500); }
.toast.info    .toast-icon { background: linear-gradient(135deg, #00d4ff, #7928ca); }
@keyframes toastIn {
    from { opacity: 0; transform: translateX(30px) scale(.9); }
    to   { opacity: 1; transform: translateX(0) scale(1); }
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 1100px) {
    .layout { grid-template-columns: 1fr; }
    .sidebar { position: static; }
}
@media (max-width: 640px) {
    .page { padding: 16px 16px 80px; }
    .navbar { padding: 12px 12px 8px; }
    .nav-inner { padding: 10px 16px; }
    .hero-title { font-size: 26px; }
    .action-bar { flex-direction: column; align-items: stretch; padding: 14px 16px; border-radius: 20px; }
    .action-hint { justify-content: center; }
    .btn { justify-content: center; }
    .toast-host { top: 90px; right: 12px; left: 12px; max-width: none; }
    .brand-sub { display: none; }
}
</style>
</head>

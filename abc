}
.sw-td { background: #E74C3C; }
.sw-bd { background: #F39C12; }
.sw-mixed { background: #9B59B6; }
.sw-health { background: #2ECC71; }
.timestamp-display {
    color: var(--brand);
    font-weight: 800;
    font-size: 0.72rem;
    background: var(--brand-light);
    padding: 5px 14px;
    border-radius: 40px;

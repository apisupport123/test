<!-- ============ LEGEND BAR — HORIZONTAL ============ -->
<section class="legend-bar">
  <span class="legend-label">Legend</span>
  <span class="legend-chip morning"><span class="swatch" style="background:var(--m-dot);"></span>M &middot; Morning</span>
  <span class="legend-chip morning"><span class="swatch" style="background:var(--m-dot);"></span>WFH-M</span>
  <span class="legend-chip morning"><span class="swatch" style="background:var(--m-dot);"></span>CC-M</span>
  <span class="legend-chip general"><span class="swatch" style="background:var(--d-dot);"></span>D &middot; General</span>
  <span class="legend-chip general"><span class="swatch" style="background:var(--d-dot);"></span>WFH-D</span>
  <span class="legend-chip general"><span class="swatch" style="background:var(--d-dot);"></span>CC-D</span>
  <span class="legend-chip afternoon"><span class="swatch" style="background:var(--a-dot);"></span>A &middot; Afternoon</span>
  <span class="legend-chip afternoon"><span class="swatch" style="background:var(--a-dot);"></span>WFH-A</span>
  <span class="legend-chip afternoon"><span class="swatch" style="background:var(--a-dot);"></span>CC-A</span>
  <span class="legend-chip night"><span class="swatch" style="background:var(--n-dot);"></span>N &middot; Night</span>
  <span class="legend-chip night"><span class="swatch" style="background:var(--n-dot);"></span>WFH-N</span>
  <span class="legend-chip night"><span class="swatch" style="background:var(--n-dot);"></span>CC-N</span>
  <span class="legend-chip weekoff"><span class="swatch" style="background:var(--w-dot);"></span>W &middot; Weekoff</span>
  <span class="legend-chip weekoff"><span class="swatch" style="background:var(--w-dot);"></span>WA</span>

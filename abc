<%@page import="java.util.Calendar"%>
<%@page import="java.text.SimpleDateFormat"%>
<%@page import="java.sql.Date"%>
<%@page pageEncoding="UTF-8"%>
<%@page import="java.sql.*"%>
<%@page import="java.util.*"%>
<%@page import="com.jdbc.DBUtilityAuto"%>
<%@page import="java.sql.Timestamp"%>
<%
    Connection con = DBUtilityAuto.getReportDBConnection();

    // Clean expired pauses
    try {
        PreparedStatement ps = con.prepareStatement("DELETE FROM service_temporary_pause_master WHERE resume_time <= SYSTIMESTAMP");
        ps.executeUpdate();
        ps.close();
    } catch(Exception e) { }

    try {
        PreparedStatement ps = con.prepareStatement("DELETE FROM temporary_pause_master WHERE resume_time <= SYSTIMESTAMP");
        ps.executeUpdate();
        ps.close();
    } catch(Exception e) { }

    // Closed counts
    String swClosed = "0", hundredClosed = "0";
    try {
        Statement stmt = con.createStatement();
        ResultSet rs = stmt.executeQuery("SELECT COUNT(1) as cnt FROM service_pause_log_master WHERE TRUNC(sysdate)=TRUNC(pause_time)");
        if(rs.next()) swClosed = rs.getString("cnt");
        rs.close(); stmt.close();
    } catch(Exception e) { }

    try {
        Statement stmt = con.createStatement();
        ResultSet rs = stmt.executeQuery("SELECT COUNT(1) as cnt FROM pause_log_master WHERE TRUNC(sysdate)=TRUNC(pause_time)");
        if(rs.next()) hundredClosed = rs.getString("cnt");
        rs.close(); stmt.close();
    } catch(Exception e) { }

    // Last update timestamp
    String lastUpdate = "—";
    try {
        Statement st = con.createStatement();
        ResultSet rs = st.executeQuery("SELECT INSERT_TIME FROM gen5_servicewise_fail ORDER BY insert_time DESC");
        if(rs.next()) {
            Timestamp ts = rs.getTimestamp("INSERT_TIME");
            Date d = new Date(ts.getTime());
            SimpleDateFormat sdf = new SimpleDateFormat("dd-MMM-yyyy HH:mm:ss");
            lastUpdate = sdf.format(d);
        }
        rs.close(); st.close();
    } catch(Exception e) { }
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta http-equiv="refresh" content="300">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="<%=request.getContextPath()%>/css/all.min.css" rel="stylesheet">
<title>EIS Command Center</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
    width: 100%;
    min-height: 100vh;
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--bg);
    color: var(--ink);
    transition: background .3s ease, color .3s ease;
}

/* Full viewport layout — userheader ke new-wrapper ke andar */
.full-view {
    width: 100%;
    height: calc(100vh - var(--topnav-h));
    display: flex;
    flex-direction: column;

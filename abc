<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Employee Registry · EIS Portal</title>

<style>
/* ================================================================
   RESET & TOKENS
   ================================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --brand-50:  #eef2ff;
    --brand-100: #e0e7ff;
    --brand-500: #6366f1;
    --brand-600: #4f46e5;
    --brand-700: #4338ca;

    --bg:        #f8fafc;
    --surface:   #ffffff;
    --surface-2: #f1f5f9;
    --surface-3: #e2e8f0;
    --border:    #e2e8f0;
    --border-2:  #cbd5e1;

    --text:      #0f172a;
    --text-2:    #334155;
    --text-3:    #64748b;
    --text-4:    #94a3b8;

    --green:     #10b981;
    --green-bg:  #d1fae5;
    --green-text:#065f46;
    --red:       #ef4444;
    --red-bg:    #fee2e2;
    --red-text:  #991b1b;
    --blue:      #3b82f6;
    --blue-bg:   #dbeafe;
    --blue-text: #1e40af;

    --r-sm: 6px;
    --r:    10px;
    --r-lg: 14px;

    --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);
    --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
    --shadow:    0 4px 12px rgba(15, 23, 42, 0.06), 0 2px 4px rgba(15, 23, 42, 0.04);
    --shadow-md: 0 12px 24px rgba(15, 23, 42, 0.08), 0 4px 8px rgba(15, 23, 42, 0.04);

    --font: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
            "Helvetica Neue", Arial, sans-serif;
    --mono: ui-monospace, "SF Mono", Consolas, "Liberation Mono", monospace;
}

html, body {
    font-family: var(--font);
    color: var(--text);
    background: var(--bg);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
}

/* ================================================================
   TOP NAV
   ================================================================ */
.topnav {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-xs);
}
.nav-brand {
    display: flex;
    align-items: center;
    gap: 12px;
}
.nav-logo {
    width: 36px; height: 36px;
    border-radius: 9px;
    background: linear-gradient(135deg, var(--brand-500), var(--brand-700));
    display: grid; place-items: center;
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.5px;
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.35);
}
.nav-title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.2px;
    color: var(--text);
}
.nav-subtitle {
    font-size: 12px;
    color: var(--text-3);
    margin-top: 1px;
}
.nav-actions { display: flex; gap: 8px; align-items: center; }

/* ================================================================
   BUTTONS
   ================================================================ */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 16px;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: -0.1px;
    border-radius: var(--r-sm);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    white-space: nowrap;
    line-height: 1;
    height: 38px;
}
.btn:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 2px;
}
.btn-primary {
    background: var(--brand-600);
    color: #fff;
    box-shadow: 0 1px 2px rgba(79, 70, 229, 0.3);
}
.btn-primary:hover {
    background: var(--brand-700);
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35);
}
.btn-secondary {
    background: var(--surface);
    color: var(--text-2);
    border-color: var(--border);
    box-shadow: var(--shadow-xs);
}
.btn-secondary:hover {
    background: var(--surface-2);
    color: var(--text);
    border-color: var(--border-2);
}
.btn-danger {
    background: var(--surface);
    color: var(--red);
    border-color: var(--border);
    box-shadow: var(--shadow-xs);
}
.btn-danger:hover {
    background: var(--red-bg);
    border-color: var(--red);
    color: var(--red-text);
}

/* ================================================================
   PAGE LAYOUT
   ================================================================ */
.page {
    max-width: 1440px;
    margin: 0 auto;
    padding: 32px 24px 60px;
}

.page-header {
    margin-bottom: 24px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
}
.page-header h1 {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.6px;
    color: var(--text);
    line-height: 1.2;
}
.page-header p {
    font-size: 14px;
    color: var(--text-3);
    margin-top: 6px;
}
.page-header-actions {
    display: flex;
    gap: 8px;
}

/* ================================================================
   STATS
   ================================================================ */
.stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}
.stat {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 18px 20px;
    box-shadow: var(--shadow-xs);
    display: flex;
    align-items: center;
    gap: 14px;
    transition: all 0.15s ease;
}
.stat:hover {
    box-shadow: var(--shadow);
    border-color: var(--border-2);
}
.stat-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    font-size: 18px;
    flex-shrink: 0;
}
.stat-icon.indigo { background: var(--brand-50); color: var(--brand-600); }
.stat-icon.green  { background: var(--green-bg); color: var(--green-text); }
.stat-icon.red    { background: var(--red-bg);   color: var(--red-text); }
.stat-icon.blue   { background: var(--blue-bg);  color: var(--blue-text); }

.stat-body { flex: 1; min-width: 0; }
.stat-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-3);
    margin-bottom: 2px;
}
.stat-value {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.6px;
    color: var(--text);
    line-height: 1.1;
}

/* ================================================================
   ALERTS
   ================================================================ */
.alert {
    border-radius: var(--r);
    padding: 14px 18px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid;
    box-shadow: var(--shadow-xs);
}
.alert-error {
    background: var(--red-bg);
    border-color: #fecaca;
    color: var(--red-text);
}
.alert-success {
    background: var(--green-bg);
    border-color: #a7f3d0;
    color: var(--green-text);
}

/* ================================================================
   SPLIT LAYOUT
   ================================================================ */
.layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 460px;
    gap: 20px;
    align-items: start;
}

.card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
}

.card-toolbar {
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--surface);
}

.search-input {
    position: relative;
    flex: 1;
}
.search-input svg {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-4);
    pointer-events: none;
}
.search-input input {
    width: 100%;
    height: 38px;
    padding: 0 14px 0 38px;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid transparent;
    border-radius: var(--r-sm);
    outline: none;
    transition: all 0.15s ease;
}
.search-input input::placeholder {
    color: var(--text-4);
    font-weight: 400;
}
.search-input input:focus {
    background: var(--surface);
    border-color: var(--brand-500);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
}

/* ================================================================
   EMPLOYEE LIST
   ================================================================ */
.list-head {
    display: grid;
    grid-template-columns: 44px 1fr 130px 100px 80px;
    align-items: center;
    gap: 12px;
    padding: 10px 18px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    font-size: 11px;
    font-weight: 600;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.6px;
}
.list-scroll { max-height: 640px; overflow-y: auto; }

.emp-row {
    display: grid;
    grid-template-columns: 44px 1fr 130px 100px 80px;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: background 0.1s ease;
    background: var(--surface);
}
.emp-row:last-child { border-bottom: none; }
.emp-row:hover { background: var(--surface-2); }
.emp-row.active {
    background: var(--brand-50);
    box-shadow: inset 3px 0 0 var(--brand-600);
}

.avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--brand-100);
    color: var(--brand-700);
    display: grid;
    place-items: center;
    font-weight: 600;
    font-size: 13px;
    flex-shrink: 0;
    overflow: hidden;
}
.avatar img { width: 100%; height: 100%; object-fit: cover; }

.emp-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.15px;
    margin-bottom: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.emp-id {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text-3);
}

.emp-team {
    font-size: 12.5px;
    color: var(--text-2);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border-radius: 100px;
    font-size: 11.5px;
    font-weight: 600;
    white-space: nowrap;
}
.badge::before {
    content: "";
    width: 6px; height: 6px;
    border-radius: 50%;
    background: currentColor;
}
.badge.active { background: var(--green-bg); color: var(--green-text); }
.badge.inactive { background: var(--red-bg); color: var(--red-text); }

.row-actions { display: flex; gap: 4px; justify-content: flex-end; }
.row-btn {
    width: 30px;
    height: 30px;
    border-radius: var(--r-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-3);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: all 0.15s ease;
}
.row-btn:hover { background: var(--surface-3); color: var(--text); }
.row-btn.edit:hover { background: var(--brand-50); color: var(--brand-600); }
.row-btn.delete:hover { background: var(--red-bg); color: var(--red-text); }

/* ================================================================
   DETAIL PANEL
   ================================================================ */
.detail-panel {
    position: sticky;
    top: 84px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
}

.empty-detail {
    padding: 80px 40px;
    text-align: center;
}
.empty-detail h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-2);
    margin-bottom: 6px;
}
.empty-detail p {
    font-size: 13px;
    color: var(--text-3);
    line-height: 1.5;
}
.empty-detail svg { color: var(--text-4); margin-bottom: 16px; }

.detail-head {
    padding: 20px 22px;
    border-bottom: 1px solid var(--border);
    display: flex;
    gap: 16px;
    align-items: center;
}
.detail-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--brand-100);
    color: var(--brand-700);
    display: grid;
    place-items: center;
    font-size: 20px;
    font-weight: 700;
    overflow: hidden;
    flex-shrink: 0;
}
.detail-avatar img { width: 100%; height: 100%; object-fit: cover; }
.detail-name {
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.3px;
    margin-bottom: 4px;
}
.detail-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 12.5px;
}
.detail-meta .id {
    font-family: var(--mono);
    color: var(--text-3);
}

.detail-body { padding: 6px 22px 22px; }

.detail-section {
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
}
.detail-section:last-child { border-bottom: none; }

.detail-section-title {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
}
.detail-section-title .dot {
    width: 6px; height: 6px;
    background: var(--brand-500);
    border-radius: 50%;
}

.detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 20px;
}
.detail-field { min-width: 0; }
.detail-field.full { grid-column: 1 / -1; }
.detail-field .k {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-3);
    margin-bottom: 3px;
}
.detail-field .v {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text);
    word-break: break-word;
    overflow-wrap: anywhere;
    line-height: 1.4;
}
.detail-field .v.mono {
    font-family: var(--mono);
    font-size: 12.5px;
}
.detail-field .v.empty {
    color: var(--text-4);
    font-style: italic;
    font-weight: 400;
}

/* Documents */
.doc-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}
.doc-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: var(--surface);
    text-decoration: none;
    color: var(--text);
    transition: all 0.15s ease;
    cursor: pointer;
}
.doc-item.has:hover {
    border-color: var(--brand-500);
    background: var(--brand-50);
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.12);
}
.doc-item.none {
    opacity: 0.5;
    cursor: not-allowed;
    background: var(--surface-2);
}
.doc-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    color: var(--text-3);
    flex-shrink: 0;
}
.doc-item.has .doc-icon {
    background: var(--brand-50);
    color: var(--brand-600);
}
.doc-meta { min-width: 0; }
.doc-name {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.2;
}
.doc-status {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 1px;
}

.detail-actions {
    padding: 16px 22px;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 8px;
    background: var(--surface-2);
}
.detail-actions .btn { flex: 1; }

/* ================================================================
   EMPTY LIST
   ================================================================ */
.empty-list {
    padding: 60px 24px;
    text-align: center;
}
.empty-list svg { color: var(--text-4); margin-bottom: 14px; }
.empty-list h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-2);
    margin-bottom: 4px;
}
.empty-list p { font-size: 13px; color: var(--text-3); }

/* ================================================================
   TOAST
   ================================================================ */
.toast-host {
    position: fixed;
    top: 78px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 360px;
}
.toast {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 12px 16px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text);
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    gap: 10px;
    animation: toastIn 0.25s ease;
    position: relative;
    overflow: hidden;
}
.toast::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
}
.toast.success::before { background: var(--green); }
.toast.error::before   { background: var(--red); }
.toast.info::before    { background: var(--blue); }
.toast .ticon { font-size: 15px; }
.toast.success .ticon { color: var(--green); }
.toast.error .ticon   { color: var(--red); }
.toast.info .ticon    { color: var(--blue); }
@keyframes toastIn {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
}

/* ================================================================
   FOOTER
   ================================================================ */
.footer {
    text-align: center;
    padding: 32px 20px;
    color: var(--text-4);
    font-size: 12.5px;
}

/* ================================================================
   RESPONSIVE
   ================================================================ */
@media (max-width: 1100px) {
    .layout { grid-template-columns: 1fr; }
    .detail-panel {
        position: fixed;
        inset: 0;
        top: 64px;
        z-index: 200;
        max-height: none;
        border-radius: 0;
        display: none;
        background: var(--surface);
    }
    .detail-panel.open { display: block; }
    .close-btn { display: grid !important; }
}
@media (max-width: 720px) {
    .page { padding: 20px 16px 40px; }
    .list-head { display: none; }
    .emp-row {
        grid-template-columns: 44px 1fr auto;
        padding: 14px 16px;
    }
    .emp-team { display: none; }
    .topnav { padding: 0 16px; }
    .nav-subtitle { display: none; }
    .stats { grid-template-columns: 1fr 1fr; }
    .detail-grid { grid-template-columns: 1fr; }
    .doc-list { grid-template-columns: 1fr; }
    .toast-host { top: 76px; right: 12px; left: 12px; max-width: none; }
}

.close-btn {
    display: none;
    position: absolute;
    top: 12px;
    right: 12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--surface-2);
    border: none;
    cursor: pointer;
    color: var(--text-2);
    place-items: center;
    z-index: 1;
}

/* Scrollbar */
.list-scroll::-webkit-scrollbar,
.detail-panel::-webkit-scrollbar { width: 10px; }
.list-scroll::-webkit-scrollbar-track,
.detail-panel::-webkit-scrollbar-track { background: transparent; }
.list-scroll::-webkit-scrollbar-thumb,
.detail-panel::-webkit-scrollbar-thumb {
    background: var(--border-2);
    border-radius: 6px;
    border: 2px solid var(--surface);
}
.list-scroll::-webkit-scrollbar-thumb:hover,
.detail-panel::-webkit-scrollbar-thumb:hover { background: var(--text-4); }
</style>
</head>

    }
    if (m_strroles == null) m_strroles = "";
    if (username == null) username = "";

    int year = 0, month = 0, noOfDays = 0;
    String selectedYear = null, selectedMonth = null, nameOfMonth = null, sortMonth = null;
    String sort_MonthYear = null;
    boolean showTable = false;

    if (monthYr != null && !monthYr.trim().isEmpty()) {
        String[] s = monthYr.split("-");
        if (s.length >= 2) {
            selectedYear = s[0];
            selectedMonth = s[1];
            try {
                year = Integer.parseInt(selectedYear);
                month = Integer.parseInt(selectedMonth);
                showTable = true;
                if (month == 1 || month == 3 || month == 5 || month == 7 || month == 8 || month == 10 || month == 12) {
                    noOfDays = 31;
                } else if (month == 4 || month == 6 || month == 9 || month == 11) {
                    noOfDays = 30;
                } else if (month == 2) {
                    noOfDays = ((year % 400 == 0) || (year % 100 != 0) && (year % 4 == 0)) ? 29 : 28;
                }
                String[] monthNames = {"", "January","February","March","April","May","June","July","August","September","October","November","December"};
                String[] shortNames = {"", "Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"};
                nameOfMonth = monthNames[month];
                sortMonth = shortNames[month];
                sort_MonthYear = sortMonth + "_" + selectedYear;
            } catch (Exception e) {
                showTable = false;
            }
        }
    }

    // Default to current month
    if (!showTable) {
        YearMonth ym = YearMonth.now(ZoneId.of("Asia/Kolkata"));

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EIS Team Roster</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-0: #0a0e1a;
    --bg-1: #111827;
    --bg-2: #1a2234;
    --bg-3: #232d42;
    --border: #2a3548;
    --text-0: #f1f5f9;
    --text-1: #cbd5e1;
    --text-2: #94a3b8;
    --accent: #6366f1;
    --accent-hover: #818cf8;

    /* Shift colors */
    --morning: #f97316;
    --morning-bg: rgba(249, 115, 22, 0.15);
    --general: #64748b;
    --general-bg: rgba(100, 116, 139, 0.15);
    --afternoon: #eab308;
    --afternoon-bg: rgba(234, 179, 8, 0.15);
    --night: #3b82f6;
    --night-bg: rgba(59, 130, 246, 0.15);
    --weekoff: #8b5cf6;
    --weekoff-bg: rgba(139, 92, 246, 0.15);
    --leave: #ef4444;
    --leave-bg: rgba(239, 68, 68, 0.15);
    --flexi: #ec4899;
    --flexi-bg: rgba(236, 72, 153, 0.15);
    --holiday: #10b981;
    --holiday-bg: rgba(16, 185, 129, 0.15);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', -apple-system, sans-serif;
    background: var(--bg-0);
    color: var(--text-0);
    min-height: 100vh;
    padding: 20px;
    background-image:
      radial-gradient(circle at 20% 0%, rgba(99, 102, 241, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 100%, rgba(59, 130, 246, 0.06) 0%, transparent 50%);
  }

  /* ============ HEADER ============ */
  .app-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    background: linear-gradient(135deg, var(--bg-1), var(--bg-2));
    border: 1px solid var(--border);
    border-radius: 16px;
    margin-bottom: 20px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }

  .header-left h1 {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #fff, #94a3b8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .header-left p {
    font-size: 13px;
    color: var(--text-2);
    margin-top: 4px;
  }

  .header-right {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  /* ============ CONTROLS ============ */
  .control-bar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    padding: 16px 20px;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 14px;
    margin-bottom: 20px;
    align-items: center;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .field label {
    font-size: 11px;
    font-weight: 600;
    color: var(--text-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .field select,
  .field input {
    background: var(--bg-2);
    border: 1px solid var(--border);
    color: var(--text-0);
    padding: 9px 12px;
    border-radius: 9px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: all 0.2s;
    min-width: 130px;
  }

  .field select:focus,
  .field input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
  }

  .btn {
    padding: 10px 20px;
    border-radius: 9px;
    border: none;
    font-family: inherit;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--accent), #4f46e5);
    color: white;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.45);
  }

  .btn-success {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  }

  .btn-success:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(16, 185, 129, 0.45);
  }

  /* ============ LEGEND ============ */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 12px 16px;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 20px;
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 600;
    background: var(--bg-2);
    border: 1px solid var(--border);
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  /* ============ TABLE WRAPPER ============ */
  .table-wrapper {
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  }

  .table-scroll {
    overflow-x: auto;
    overflow-y: auto;
    max-height: 70vh;
  }

  table {
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;
    font-size: 13px;
    white-space: nowrap;
  }

  thead th {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg-3);
    color: var(--text-1);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 12px 10px;
    border-bottom: 2px solid var(--border);
    text-align: center;
  }

  thead th:first-child,
  thead th:nth-child(2) {
    position: sticky;
    left: 0;
    z-index: 11;
    text-align: left;
  }

  thead th:nth-child(2) {
    left: 200px;
  }

  tbody td {
    padding: 6px 8px;
    border-bottom: 1px solid var(--border);
    text-align: center;
    color: var(--text-1);
    background: var(--bg-1);
  }

  tbody td:first-child,
  tbody td:nth-child(2) {
    position: sticky;
    background: var(--bg-2);
    z-index: 5;
  }

  tbody td:first-child {
    left: 0;
    text-align: left;
    font-weight: 600;
    color: var(--text-0);
    min-width: 200px;
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  tbody td:nth-child(2) {
    left: 200px;
    min-width: 130px;
  }

  tbody tr:hover td {
    background: var(--bg-2);
  }

  tbody tr:hover td:first-child,
  tbody tr:hover td:nth-child(2) {
    background: var(--bg-3);
  }

  /* ============ SHIFT CELLS ============ */
  .shift-select {
    width: 100%;
    border: none;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-weight: 700;
    font-size: 13px;
    text-align: center;
    cursor: pointer;
    padding: 6px 4px;
    border-radius: 6px;
    outline: none;
    transition: all 0.15s;
    appearance: none;
    -webkit-appearance: none;
    text-align: center;
    text-align-last: center;
  }

  .shift-select:hover {
    background: rgba(255,255,255,0.05);
  }

  .shift-select:focus {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .shift-Morning   { color: var(--morning);   background: var(--morning-bg);   }
  .shift-General   { color: var(--general);   background: var(--general-bg);   }
  .shift-Afternoon { color: var(--afternoon); background: var(--afternoon-bg); }
  .shift-Night     { color: var(--night);     background: var(--night-bg);     }
  .shift-Weekoff   { color: var(--weekoff);   background: var(--weekoff-bg);   }
  .shift-Leave     { color: var(--leave);     background: var(--leave-bg);     }
  .shift-Flexi     { color: var(--flexi);     background: var(--flexi-bg);     }
  .shift-Holiday   { color: var(--holiday);   background: var(--holiday-bg);   }

  /* ============ SUMMARY ROWS ============ */
  .summary-row td {
    font-weight: 700;
    font-size: 12px;
    background: var(--bg-3) !important;
    color: var(--text-0);
    border-top: 2px solid var(--border);
  }

  .summary-row td:first-child {
    background: var(--bg-3) !important;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 11px;
  }

  .badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    min-width: 24px;
  }

  .badge-morning   { background: var(--morning-bg);   color: var(--morning);   }
  .badge-general   { background: var(--general-bg);   color: var(--general);   }
  .badge-afternoon { background: var(--afternoon-bg); color: var(--afternoon); }
  .badge-night     { background: var(--night-bg);     color: var(--night);     }

  /* ============ SCROLLBAR ============ */
  .table-scroll::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  .table-scroll::-webkit-scrollbar-track {
    background: var(--bg-0);
  }
  .table-scroll::-webkit-scrollbar-thumb {
    background: var(--bg-3);
    border-radius: 5px;
  }
  .table-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
  }

  /* ============ FOOTER ACTIONS ============ */
  .footer-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    padding: 16px 20px;
    background: var(--bg-2);
    border-top: 1px solid var(--border);
  }

  /* ============ EMPTY STATE ============ */
  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-2);
  }
  .empty-state h3 {
    font-size: 18px;
    margin-bottom: 8px;
    color: var(--text-1);
  }

  @media (max-width: 768px) {
    body { padding: 10px; }
    .app-header { flex-direction: column; gap: 12px; align-items: flex-start; }
    .control-bar { flex-direction: column; align-items: stretch; }
    .field select, .field input { width: 100%; }
  }
</style>
</head>
<body>

  <!-- ============ HEADER ============ -->
  <div class="app-header">
    <div class="header-left">
      <h1>EIS Team Roster</h1>
      <p id="subtitle">Select month and year to view roster</p>
    </div>
    <div class="header-right">
      <button class="btn btn-success" onclick="prepareData()">💾 Submit Roster</button>
    </div>
  </div>

  <!-- ============ CONTROLS ============ -->
  <form id="monthYearForm" method="get" class="control-bar">
    <div class="field">
      <label for="month">Month</label>
      <select name="month" id="month">
        <option value="1">January</option>
        <option value="2">February</option>
        <option value="3">March</option>
        <option value="4">April</option>
        <option value="5">May</option>
        <option value="6">June</option>
        <option value="7">July</option>
        <option value="8">August</option>
        <option value="9">September</option>
        <option value="10">October</option>
        <option value="11">November</option>
        <option value="12">December</option>
      </select>
    </div>
    <div class="field">
      <label for="year">Year</label>
      <input type="number" id="year" name="year" min="2024" max="2100" value="2025" required>
    </div>
    <div class="field" style="align-self: flex-end;">
      <button type="button" class="btn btn-primary" onclick="submitForm()">📅 Load Roster</button>
    </div>
  </form>

  <!-- ============ LEGEND ============ -->
  <div class="legend">
    <span class="legend-item"><span class="legend-dot" style="background:var(--morning)"></span>Morning</span>
    <span class="legend-item"><span class="legend-dot" style="background:var(--general)"></span>General</span>
    <span class="legend-item"><span class="legend-dot" style="background:var(--afternoon)"></span>Afternoon</span>
    <span class="legend-item"><span class="legend-dot" style="background:var(--night)"></span>Night</span>
    <span class="legend-item"><span class="legend-dot" style="background:var(--weekoff)"></span>Weekoff</span>
    <span class="legend-item"><span class="legend-dot" style="background:var(--leave)"></span>Leave</span>
    <span class="legend-item"><span class="legend-dot" style="background:var(--flexi)"></span>Flexi</span>
    <span class="legend-item"><span class="legend-dot" style="background:var(--holiday)"></span>Holiday</span>
  </div>

  <!-- ============ ROSTER FORM + TABLE ============ -->
  <form id="rosterForm" action="RosterServlet" method="post">
    <input type="hidden" id="tableData" name="tableData">

    <div class="table-wrapper">
      <div class="table-scroll">
        <table id="rosterTable">
          <thead>
            <!-- =============================================
                 YAHAN APNA JSP HEADER CODE PLUG KAR
                 Example:
                 <tr>
                   <th>Employee Name</th>
                   <th>Position</th>
                   <% for(int i=1; i<=noOfDays; i++) { %>
                     <th><%=i%></th>
                   <% } %>
                   <th>Weekoffs</th>
                   <th>Leaves</th>
                 </tr>
                 ============================================= -->
            <tr>
              <th>Employee Name</th>
              <th>Position</th>
              <!-- JSP: day columns yahan aayenge -->
              <th>1</th><th>2</th><th>3</th><th>4</th><th>5</th>
              <th>Weekoffs</th>
              <th>Leaves</th>
            </tr>
          </thead>
          <tbody id="rosterBody">
            <!-- =============================================
                 YAHAN APNA JSP ROW CODE PLUG KAR
                 Har employee ke liye ek <tr> generate kar.

                 Example JSP row:
                 <tr>
                   <td><%=rs2.getString("NAME")%></td>
                   <td>
                     <select name="position_<%=i%>" class="shift-select">
                       <option>Senior</option>
                       <option>Junior</option>
                     </select>
                   </td>
                   <% for(int day=1; day<=noOfDays; day++) { %>
                     <td>
                       <select name="mnt_<%=i%>_<%=day%>"
                               class="shift-select shift-Morning"
                               onchange="updateShiftColor(this)">
                         <option value="Morning">M(o)</option>
                         <option value="General">D(o)</option>
                         <option value="Afternoon">A(o)</option>
                         <option value="Night">N(o)</option>
                         <option value="Weekoff">W</option>
                         <option value="SickLeave">SL</option>
                         <option value="CasualLeave">CL</option>
                         <option value="EarnedLeave">EL</option>
                         <option value="FlexiLeave">FL</option>
                         <option value="HolidayLeave">HL</option>
                       </select>
                     </td>
                   <% } %>
                   <td><%=weekOff%></td>
                   <td><%=leave%></td>
                 </tr>
                 ============================================= -->

            <!-- DEMO ROWS (JSP plug karne ke baad hata dena) -->
            <tr>
              <td>Rahul Sharma</td>
              <td>
                <select class="shift-select" style="background:var(--bg-2);">
                  <option>Senior</option>
                  <option>Junior</option>
                </select>
              </td>
              <td><select class="shift-select shift-Morning" onchange="updateShiftColor(this)"><option>M(o)</option><option>D(o)</option><option>A(o)</option><option>N(o)</option><option>W</option></select></td>
              <td><select class="shift-select shift-General" onchange="updateShiftColor(this)"><option>M(o)</option><option selected>D(o)</option><option>A(o)</option><option>N(o)</option><option>W</option></select></td>
              <td><select class="shift-select shift-Night" onchange="updateShiftColor(this)"><option>M(o)</option><option>D(o)</option><option>A(o)</option><option selected>N(o)</option><option>W</option></select></td>
              <td><select class="shift-select shift-Weekoff" onchange="updateShiftColor(this)"><option>M(o)</option><option>D(o)</option><option>A(o)</option><option>N(o)</option><option selected>W</option></select></td>
              <td><select class="shift-select shift-Afternoon" onchange="updateShiftColor(this)"><option>M(o)</option><option>D(o)</option><option>A(o)</option><option selected>A(o)</option><option>W</option></select></td>
              <td>2</td>
              <td>0</td>
            </tr>
            <tr>
              <td>Priya Verma</td>
              <td>
                <select class="shift-select" style="background:var(--bg-2);">
                  <option>Senior</option>
                  <option>Junior</option>
                </select>
              </td>
              <td><select class="shift-select shift-Leave" onchange="updateShiftColor(this)"><option>M(o)</option><option>D(o)</option><option>A(o)</option><option>N(o)</option><option>W</option><option selected>L</option></select></td>
              <td><select class="shift-select shift-Morning" onchange="updateShiftColor(this)"><option>M(o)</option><option>D(o)</option><option>A(o)</option><option>N(o)</option><option>W</option></select></td>
              <td><select class="shift-select shift-General" onchange="updateShiftColor(this)"><option>M(o)</option><option>D(o)</option><option>A(o)</option><option>N(o)</option><option>W</option></select></td>
              <td><select class="shift-select shift-Night" onchange="updateShiftColor(this)"><option>M(o)</option><option>D(o)</option><option>A(o)</option><option>N(o)</option><option>W</option></select></td>
              <td><select class="shift-select shift-Holiday" onchange="updateShiftColor(this)"><option>M(o)</option><option>D(o)</option><option>A(o)</option><option>N(o)</option><option>W</option><option selected>HL</option></select></td>
              <td>1</td>
              <td>1</td>
            </tr>
          </tbody>

          <!-- ============ SUMMARY ROWS ============ -->
          <tfoot id="summaryFoot">
            <tr class="summary-row">
              <td colspan="2">No. of Emp in Morning</td>
              <td><span class="badge badge-morning">1</span></td>
              <td><span class="badge badge-morning">0</span></td>
              <td><span class="badge badge-morning">0</span></td>
              <td><span class="badge badge-morning">0</span></td>
              <td><span class="badge badge-morning">0</span></td>
              <td></td><td></td>
            </tr>
            <tr class="summary-row">
              <td colspan="2">No. of Emp in General</td>
              <td><span class="badge badge-general">0</span></td>
              <td><span class="badge badge-general">1</span></td>
              <td><span class="badge badge-general">1</span></td>
              <td><span class="badge badge-general">0</span></td>
              <td><span class="badge badge-general">0</span></td>
              <td></td><td></td>
            </tr>
            <tr class="summary-row">
              <td colspan="2">No. of Emp in Afternoon</td>
              <td><span class="badge badge-afternoon">0</span></td>
              <td><span class="badge badge-afternoon">0</span></td>
              <td><span class="badge badge-afternoon">0</span></td>
              <td><span class="badge badge-afternoon">0</span></td>
              <td><span class="badge badge-afternoon">1</span></td>
              <td></td><td></td>
            </tr>
            <tr class="summary-row">
              <td colspan="2">No. of Emp in Night</td>
              <td><span class="badge badge-night">0</span></td>
              <td><span class="badge badge-night">0</span></td>
              <td><span class="badge badge-night">1</span></td>
              <td><span class="badge badge-night">0</span></td>
              <td><span class="badge badge-night">0</span></td>
              <td></td><td></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- ============ FOOTER ACTIONS ============ -->
      <div class="footer-actions">
        <input type="hidden" name="selectedMonth" value="">
        <input type="hidden" name="selectedYear" value="">
        <input type="hidden" name="m_strroles" value="">
        <button type="button" class="btn btn-success" onclick="prepareData()">✓ Submit Roster</button>
      </div>
    </div>
  </form>

<script>
  // ============ SHIFT COLOR UPDATER ============
  // Jab bhi select change ho, uska color class update karo
  function updateShiftColor(selectEl) {
    const val = selectEl.value.toLowerCase();
    const all = ['shift-Morning','shift-General','shift-Afternoon','shift-Night',
                 'shift-Weekoff','shift-Leave','shift-Flexi','shift-Holiday'];
    selectEl.classList.remove(...all);

    let cls = 'shift-General';
    if (val.includes('morning')) cls = 'shift-Morning';
    else if (val.includes('general') || val.includes('genral')) cls = 'shift-General';
    else if (val.includes('afternoon')) cls = 'shift-Afternoon';
    else if (val.includes('night')) cls = 'shift-Night';
    else if (val.includes('weekoff')) cls = 'shift-Weekoff';
    else if (val.includes('sick') || val.includes('casual') ||
             val.includes('earned') || val === 'leave') cls = 'shift-Leave';
    else if (val.includes('flexi')) cls = 'shift-Flexi';
    else if (val.includes('holiday')) cls = 'shift-Holiday';

    selectEl.classList.add(cls);
  }

  // ============ FORM SUBMIT ============
  function submitForm() {
    document.getElementById("monthYearForm").submit();
  }

  // ============ ROSTER SUBMIT ============
  function prepareData() {
    // Yahan tu apna tableData serialize kar sakta hai agar chahiye
    document.forms["rosterForm"].action =
      '<%=request.getContextPath() + "/RosterServlet"%>';
    document.forms["rosterForm"].submit();
  }

  // ============ URL CLEANUP ============
  window.addEventListener('load', function () {
    window.history.replaceState({}, 'View Roster',
      '<%=request.getContextPath() + "/jsp/testRoster.jsp"%>');
  });
</script>
</body>
</html>

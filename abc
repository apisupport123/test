<style>
/* ================================================================
   THEME-AWARE OVERRIDES (tumhare original se)
   ================================================================ */
body {
    background-color: var(--bg) !important;
    color: var(--ink) !important;
    margin: 0 !important;
    padding: 0 !important;
    transition: background .3s ease, color .3s ease;
}

.topnav {
    background: var(--topnav-bg) !important;
    border-bottom: 1px solid var(--line) !important;
}
.topnav .tn-search {
    background: var(--card) !important;
    border-color: var(--line) !important;
    color: var(--muted) !important;
}
.topnav .tn-search:hover {
    border-color: var(--brand) !important;
    color: var(--ink) !important;
}
.topnav .tn-search .kbd {
    background: var(--sidebar-hover) !important;
    border-color: var(--line) !important;
    color: var(--muted) !important;
}
.topnav .tn-menu-btn {
    background: var(--sidebar-hover) !important;
    border-color: var(--line) !important;
    color: var(--ink) !important;
}
.topnav .tn-menu-btn:hover {
    background: var(--brand) !important;
    border-color: var(--brand) !important;
    color: #fff !important;
}
.topnav .tn-btn {
    background: transparent !important;
    border-color: var(--line) !important;
    color: var(--ink) !important;
}
.topnav .tn-btn:hover {
    background: var(--brand) !important;
    border-color: var(--brand) !important;
    color: #fff !important;
}
.topnav .tn-toggle {
    border-color: var(--line) !important;
    color: var(--ink) !important;
}

/* ================================================================
   WRAPPER
   ================================================================ */
.new-wrapper {
    padding-top: 64px !important;
    margin-left: 260px !important;
    background-color: var(--bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    height: 100vh;
    box-sizing: border-box;
    transition: margin-left .3s cubic-bezier(.4,0,.2,1), background .3s ease;
}
html.sb-collapsed .new-wrapper {
    margin-left: 0 !important;
}

/* ================================================================
   TOP STRIP — timer | KPI | severity | live | view-logs
   ================================================================ */
.tx-top-strip {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 10px 20px;
    background: var(--card);
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
}

.tx-timer-block {
    display: flex;
    align-items: center;
    gap: 12px;
}
.tx-timer-label {
    font-size: 13px;
    font-weight: 800;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.25;
}
.tx-timer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 100px;
    padding: 6px 14px;
    border: 3px solid var(--brand);
    border-radius: 8px;
    color: var(--brand) !important;
    font-family: 'Courier New', monospace;
    font-size: 28px;
    font-weight: 900;
    background: var(--brand-light);
    letter-spacing: 1px;
    line-height: 1;
    box-shadow: 0 0 12px rgba(248,111,3,.3);
}
html[data-theme="dark"] .tx-timer {
    background: rgba(248,111,3,.15);
}

/* KPI row */
.tx-kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    min-width: 0;
}
.tx-kpi {
    background: var(--card);
    padding: 8px 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
}
.tx-kpi-label {
    font-size: 10px;
    font-weight: 800;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    white-space: nowrap;
}
.tx-kpi-value {
    font-family: 'Courier New', monospace;
    font-size: 30px;
    font-weight: 900;
    line-height: 1;
    margin-top: 3px;
    color: var(--ink);
    letter-spacing: -1px;
}
.tx-kpi-value.red    { color: #ef4444; text-shadow: 0 0 12px rgba(239,68,68,.4); }
.tx-kpi-value.orange { color: #f59e0b; text-shadow: 0 0 12px rgba(245,158,11,.4); }
.tx-kpi-value.green  { color: #10b981; text-shadow: 0 0 12px rgba(16,185,129,.4); }

.tx-blink-red {
    animation: txBlinkRed 1.4s ease-in-out infinite;
}
@keyframes txBlinkRed {
    0%, 100% { opacity: 1; text-shadow: 0 0 14px rgba(239,68,68,.7); }
    50%      { opacity: 0.4; text-shadow: 0 0 28px rgba(239,68,68,1); }
}

/* Right block */
.tx-right-block {
    display: flex;
    align-items: center;
    gap: 10px;
}
.tx-sev-chips { display: flex; gap: 6px; }
.tx-sev-chip {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    color: var(--ink);
    white-space: nowrap;
}
.tx-sev-dot {
    width: 9px;
    height: 9px;
    border-radius: 2px;
}

.tx-live-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    background: rgba(16, 185, 129, 0.14);
    border: 1px solid rgba(16, 185, 129, 0.4);
    border-radius: 6px;
    font-size: 12px;
    font-weight: 800;
    color: #10b981;
    letter-spacing: 1.5px;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.25);
}
.tx-live-badge .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 10px #10b981;
    animation: txPulse 1.6s infinite;
}
@keyframes txPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: .4; transform: scale(.8); }
}

.tx-logs-btn {
    padding: 8px 16px;
    background: #008CBA;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all .2s;
    white-space: nowrap;
    text-transform: uppercase;
}
.tx-logs-btn:hover {
    background: #00a4dc;
    box-shadow: 0 0 16px rgba(0,140,186,.5);
    transform: translateY(-1px);
}

/* ================================================================
   TOP CRITICAL BAR (horizontal chips)
   ================================================================ */
.tx-crit-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 20px;
    background: var(--card);
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
    overflow-x: auto;
}
.tx-crit-bar::-webkit-scrollbar { height: 4px; }
.tx-crit-bar::-webkit-scrollbar-thumb { background: var(--line); border-radius: 2px; }

.tx-crit-bar .tx-crit-title {
    font-size: 11px;
    font-weight: 900;
    color: #ef4444;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    white-space: nowrap;
    padding-right: 12px;
    border-right: 1px solid var(--line);
    flex-shrink: 0;
    text-shadow: 0 0 10px rgba(239,68,68,.5);
}

.tx-crit-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 8px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.2s;
}
.tx-crit-chip:hover {
    background: rgba(239, 68, 68, 0.2);
    box-shadow: 0 0 16px rgba(239,68,68,.4);
}
.tx-crit-chip.critical {
    animation: txChipBlink 2s ease-in-out infinite;
}
@keyframes txChipBlink {
    0%, 100% { box-shadow: 0 0 0 rgba(239,68,68,0); }
    50%      { box-shadow: 0 0 18px rgba(239,68,68,.6); }
}
.tx-crit-chip .name {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    max-width: 170px;
    overflow: hidden;
    text-overflow: ellipsis;
}
.tx-crit-chip .pct {
    font-family: 'Courier New', monospace;
    font-size: 18px;
    font-weight: 900;
    color: #ef4444;
    text-shadow: 0 0 10px rgba(239,68,68,.5);
}

/* ================================================================
   CHART AREA — fills remaining space
   ================================================================ */
.tx-chart-area {
    flex: 1;
    min-height: 0;
    padding: 8px 12px 12px;
    background: var(--bg);
}
#myChart {
    width: 100%;
    height: 100%;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 0 24px rgba(99,102,241,.12);
    position: relative;
}

/* ================================================================
   RESPONSIVE
   ================================================================ */
@media (max-width: 1280px) {
    .tx-timer-label { font-size: 11px; }
    .tx-timer { font-size: 22px; min-width: 85px; padding: 5px 10px; }
    .tx-kpi-value { font-size: 24px; }
    .tx-kpi { padding: 6px 10px; }
    .tx-sev-chip { padding: 4px 7px; font-size: 10px; }

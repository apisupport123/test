    /**
     * Handles insert submission. Files are read as bytes and stored as BLOB.
     * File fields are read from THIS action (not form bean).
     */
    public String saveRegistration() throws Exception {

        System.out.println("========== saveRegistration START ==========");

        RegistrationActionForm form = getOrCreateForm();
        loadEISRole(form);

        HttpServletRequest request = ServletActionContext.getRequest();

        // ---- Debug: verify multipart form data ----
        String contentType = request.getContentType();
        String method = request.getMethod();
        boolean isMultipart = contentType != null
                && contentType.toLowerCase().startsWith("multipart/");

        System.out.println("[FORM] Method: " + method);
        System.out.println("[FORM] Content-Type: " + contentType);
        System.out.println("[FORM] isMultipart: " + isMultipart);

        String actionParam = request.getParameter("action");
        System.out.println("[FORM] actionParam = " + actionParam);

        if (actionParam == null) {
            clearForm(form);
            return "success";
        }
        if (!"insert".equals(actionParam)) {
            clearForm(form);
            return "success";
        }

        Connection con = null;
        PreparedStatement psEmp = null;
        PreparedStatement psRoster = null;
        Statement checkSt = null;
        ResultSet checkRs = null;

        try {
            con = DBUtilityAuto.getReportDBConnection();
            System.out.println("[DEBUG] DB Connected OK");

            // ---- Duplicate check ----
            String empId = request.getParameter("m_stremployee_id");
            String countQuery = "select count(*) from eisupport_employee_master where EMPLOYEE_ID='"
                    + empId + "'";
            checkSt = con.createStatement();
            checkRs = checkSt.executeQuery(countQuery);

            int count = 0;
            if (checkRs != null && checkRs.next()) {
                count = checkRs.getInt(1);
            }
            System.out.println("[DEBUG] Duplicate count = " + count);

            if (count > 0) {
                form.setM_strmsg("duplicate");
                this.setM_strmsg("duplicate");
                return "success";
            }

            // ============================================================
            // ⭐ DEBUG: Check both ACTION and FORM file fields
            // ============================================================
            System.out.println("[DUAL CHECK] === ACTION fields ===");
            System.out.println("[DUAL CHECK] this.photoFile = " + this.getM_strthePhotofile());
            System.out.println("[DUAL CHECK] this.photoName = " + this.getM_strthePhotofileFileName());
            System.out.println("[DUAL CHECK] this.bgcFile   = " + this.getM_strtheBgcfile());
            System.out.println("[DUAL CHECK] this.bgcName   = " + this.getM_strtheBgcfileFileName());
            System.out.println("[DUAL CHECK] === FORM fields ===");
            System.out.println("[DUAL CHECK] form.photoFile = " + form.getM_strthePhotofile());
            System.out.println("[DUAL CHECK] form.photoName = " + form.getM_strthePhotofileFileName());
            System.out.println("[DUAL CHECK] form.bgcFile   = " + form.getM_strtheBgcfile());
            System.out.println("[DUAL CHECK] form.bgcName   = " + form.getM_strtheBgcfileFileName());

            // ============================================================
            // ⭐ READ FILES — try ACTION first, then FORM as fallback
            // ============================================================
            byte[] photoBytes  = null;
            byte[] bgcBytes    = null;
            byte[] policeBytes = null;
            byte[] cvBytes     = null;

            // --- PHOTO ---
            File photoFile = this.getM_strthePhotofile();
            String photoName = this.getM_strthePhotofileFileName();
            if (photoFile == null && form.getM_strthePhotofile() != null) {
                photoFile = form.getM_strthePhotofile();
                photoName = form.getM_strthePhotofileFileName();
                System.out.println("[FALLBACK] Using FORM bean for PHOTO");
            }
            System.out.println("[UPLOAD] PHOTO file=" + photoFile + " name=" + photoName);
            if (photoFile != null && photoName != null && !photoName.trim().isEmpty()) {
                photoBytes = readFileBytes(photoFile);
                if (photoBytes != null)
                    System.out.println("[UPLOAD] PHOTO read " + photoBytes.length + " bytes");
            }

            // --- BGC ---
            File bgcFile = this.getM_strtheBgcfile();
            String bgcName = this.getM_strtheBgcfileFileName();
            if (bgcFile == null && form.getM_strtheBgcfile() != null) {
                bgcFile = form.getM_strtheBgcfile();
                bgcName = form.getM_strtheBgcfileFileName();
                System.out.println("[FALLBACK] Using FORM bean for BGC");
            }
            System.out.println("[UPLOAD] BGC file=" + bgcFile + " name=" + bgcName);
            if (bgcFile != null && bgcName != null && !bgcName.trim().isEmpty()) {
                bgcBytes = readFileBytes(bgcFile);
                if (bgcBytes != null)
                    System.out.println("[UPLOAD] BGC read " + bgcBytes.length + " bytes");
            }

            // --- POLICE ---
            File policeFile = this.getM_strthePoliceverificationfile();
            String policeName = this.getM_strthePoliceverificationfileFileName();
            if (policeFile == null && form.getM_strthePoliceverificationfile() != null) {
                policeFile = form.getM_strthePoliceverificationfile();
                policeName = form.getM_strthePoliceverificationfileFileName();
                System.out.println("[FALLBACK] Using FORM bean for POLICE");
            }
            System.out.println("[UPLOAD] POLICE file=" + policeFile + " name=" + policeName);
            if (policeFile != null && policeName != null && !policeName.trim().isEmpty()) {
                policeBytes = readFileBytes(policeFile);
                if (policeBytes != null)
                    System.out.println("[UPLOAD] POLICE read " + policeBytes.length + " bytes");
            }

            // --- CV ---
            File cvFile = this.getM_strtheCvfile();
            String cvName = this.getM_strtheCvfileFileName();
            if (cvFile == null && form.getM_strtheCvfile() != null) {
                cvFile = form.getM_strtheCvfile();
                cvName = form.getM_strtheCvfileFileName();
                System.out.println("[FALLBACK] Using FORM bean for CV");
            }
            System.out.println("[UPLOAD] CV file=" + cvFile + " name=" + cvName);
            if (cvFile != null && cvName != null && !cvName.trim().isEmpty()) {
                cvBytes = readFileBytes(cvFile);
                if (cvBytes != null)
                    System.out.println("[UPLOAD] CV read " + cvBytes.length + " bytes");
            }

            System.out.println("[UPLOAD] FINAL SIZES: photo="
                    + (photoBytes != null ? photoBytes.length : 0)
                    + " bgc=" + (bgcBytes != null ? bgcBytes.length : 0)
                    + " police=" + (policeBytes != null ? policeBytes.length : 0)
                    + " cv=" + (cvBytes != null ? cvBytes.length : 0));

            // ============================================================
            // INSERT — eisupport_employee_master
            // ============================================================
            String sqlEmp =

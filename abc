  <a onclick="openUrl('https://10.191.171.12:5443/EIS/port_monitoring/')">EIS_PORT_MON</a>
  <a onclick="openUrl('https://10.191.171.12:5443/EIS/CBS_Connection/')">CBS_PORT_MON</a>
  <a onclick="openUrl('https://10.191.171.12:5443/PyPortal/APISearch/')">API_WORKLOAD</a>
  <a onclick="openUrl('https://10.191.171.12:5443/EISInfra/curlSearch/login.php/')">CURL_PORTAL</a>

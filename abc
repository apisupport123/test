<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Registration Complete · EIS Portal</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

<style>
/* ================================================================
   RESET & TOKENS
   ================================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --brand-1: #ff6a00;
    --brand-2: #ff2d95;
    --brand-3: #7c3aed;
    --brand-4: #06b6d4;
    --success: #10b981;
    --success-dark: #059669;

    --text:       #0a0a0f;
    --text-muted: #6b7280;
    --bg-1:       #f5f3ff;
    --white:      #ffffff;

    --glass-bg:     rgba(255,255,255,.55);
    --glass-border: rgba(255,255,255,.75);
    --glass-shadow: 0 8px 32px rgba(15,23,42,.08);

    --ease-out:    cubic-bezier(.22,1,.36,1);
    --ease-spring: cubic-bezier(.34,1.56,.64,1);
}

[data-theme="dark"] {
    --text:       #f1f5f9;
    --text-muted: #94a3b8;
    --bg-1:       #0a0a14;
    --white:      #16161f;
    --glass-bg:     rgba(22,22,31,.55);
    --glass-border: rgba(255,255,255,.08);
    --glass-shadow: 0 8px 32px rgba(0,0,0,.5);
}

html, body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: var(--text);
    background: var(--bg-1);
    min-height: 100vh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    transition: background .4s var(--ease-out), color .4s var(--ease-out);
}

/* ================================================================
   ANIMATED MESH BACKGROUND
   ================================================================ */
.mesh-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: var(--bg-1);
}
.mesh-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: .55;
    mix-blend-mode: multiply;
    will-change: transform;
}
[data-theme="dark"] .mesh-blob {
    mix-blend-mode: screen;
    opacity: .45;
}
.mesh-blob.m1 {
    width: 560px; height: 560px;
    background: radial-gradient(circle, var(--success), transparent 65%);
    top: -12%; left: -10%;
    animation: meshMove 22s ease-in-out infinite;
}
.mesh-blob.m2 {
    width: 620px; height: 620px;
    background: radial-gradient(circle, var(--brand-1), transparent 65%);
    top: 30%; right: -15%;
    animation: meshMove 26s ease-in-out infinite reverse;
}
.mesh-blob.m3 {
    width: 520px; height: 520px;
    background: radial-gradient(circle, var(--brand-3), transparent 65%);
    bottom: -12%; left: 25%;
    animation: meshMove 30s ease-in-out infinite;
    animation-delay: -8s;
}
.mesh-blob.m4 {
    width: 480px; height: 480px;
    background: radial-gradient(circle, var(--brand-4), transparent 65%);
    top: 15%; left: 40%;
    animation: meshMove 24s ease-in-out infinite reverse;
    animation-delay: -12s;
}
@keyframes meshMove {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(80px, -60px) scale(1.15); }
    66%      { transform: translate(-60px, 70px) scale(.9); }
}

/* ================================================================
   LAYOUT
   ================================================================ */
.page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 32px 20px;
    position: relative;
}

.card {
    background: var(--glass-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    border-radius: 32px;
    box-shadow: var(--glass-shadow);
    padding: 56px 48px 48px;
    max-width: 560px;
    width: 100%;
    text-align: center;
    position: relative;
    overflow: hidden;
    animation: cardIn .8s var(--ease-spring) both;
}
@keyframes cardIn {
    from { opacity: 0; transform: translateY(40px) scale(.9); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
}

.card::before {
    content: "";
    position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background: conic-gradient(from 0deg, transparent, rgba(16,185,129,.15), transparent 30%);
    animation: cardRotate 8s linear infinite;
    pointer-events: none;
}
@keyframes cardRotate {
    to { transform: rotate(360deg); }
}

.card-inner {
    position: relative;
    z-index: 1;
}

/* ================================================================
   SUCCESS BADGE (top pill)
   ================================================================ */
.badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: linear-gradient(135deg, rgba(16,185,129,.15), rgba(16,185,129,.05));
    border: 1px solid rgba(16,185,129,.3);
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    color: var(--success-dark);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 24px;
    animation: badgeIn .6s var(--ease-spring) .3s both;
}
@keyframes badgeIn {
    from { opacity: 0; transform: translateY(-10px) scale(.85); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
}
.badge .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 12px var(--success);
    animation: dotPulse 1.8s ease-in-out infinite;
}
@keyframes dotPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.5); opacity: .6; }
}

/* ================================================================
   ANIMATED SVG ILLUSTRATION
   ================================================================ */
.illustration {
    width: 200px;
    height: 200px;
    margin: 0 auto 12px;
    position: relative;
    animation: floatY 4s ease-in-out infinite;
}
@keyframes floatY {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-10px); }
}

/* SVG inner animations */
.ring-spin {
    transform-origin: 100px 100px;
    animation: ringSpin 12s linear infinite;
}
@keyframes ringSpin {
    to { transform: rotate(360deg); }
}

.check-draw {
    stroke-dasharray: 120;
    stroke-dashoffset: 120;
    animation: checkDraw 1s var(--ease-out) .6s forwards;
}
@keyframes checkDraw {
    to { stroke-dashoffset: 0; }
}

.circle-scale {
    transform-origin: 100px 100px;
    animation: circleScale .8s var(--ease-spring) .2s both;
}
@keyframes circleScale {
    from { transform: scale(0); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
}

.pulse-ring {
    transform-origin: 100px 100px;
    animation: pulseRing 2.4s ease-out infinite;
}
.pulse-ring.delay { animation-delay: 1.2s; }
@keyframes pulseRing {
    0%   { transform: scale(.8); opacity: .8; }
    100% { transform: scale(1.6); opacity: 0; }
}

.sparkle {
    transform-origin: center;
    animation: sparkle 2s ease-in-out infinite;
}
.sparkle.s2 { animation-delay: .4s; }
.sparkle.s3 { animation-delay: .8s; }
.sparkle.s4 { animation-delay: 1.2s; }
@keyframes sparkle {
    0%, 100% { opacity: 0; transform: scale(.4); }
    50%      { opacity: 1; transform: scale(1); }
}

/* ================================================================
   TEXT
   ================================================================ */
.title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -.03em;
    margin-bottom: 12px;
    background: linear-gradient(120deg, var(--success), var(--brand-1), var(--brand-3), var(--success));
    background-size: 300% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradientShift 6s linear infinite, titleIn .8s var(--ease-spring) .5s both;
}
@keyframes gradientShift {
    to { background-position: 300% center; }
}
@keyframes titleIn {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
}

.subtitle {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 28px;
    animation: titleIn .8s var(--ease-spring) .65s both;
}

/* ================================================================
   INFO GRID (what happens next)
   ================================================================ */
.info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-bottom: 32px;
    animation: titleIn .8s var(--ease-spring) .8s both;
}
.info-item {
    padding: 16px 12px;
    background: rgba(255,255,255,.4);
    border: 1px solid rgba(15,23,42,.06);
    border-radius: 14px;
    transition: all .3s var(--ease-spring);
}
[data-theme="dark"] .info-item {
    background: rgba(255,255,255,.03);
    border-color: rgba(255,255,255,.06);
}
.info-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(15,23,42,.08);
}
.info-item i {
    font-size: 18px;
    color: var(--success);
    margin-bottom: 8px;
    display: block;
}
.info-item strong {
    display: block;
    font-size: 12.5px;
    font-weight: 700;
    margin-bottom: 3px;
    color: var(--text);
}
.info-item span {
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.4;
}
@media (max-width: 480px) {
    .info-grid { grid-template-columns: 1fr; }
}

/* ================================================================
   BUTTON
   ================================================================ */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 34px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    border-radius: 14px;
    border: none;
    cursor: pointer;
    transition: all .35s var(--ease-spring);
    text-decoration: none;
    letter-spacing: .01em;
    position: relative;
    overflow: hidden;
    width: 100%;
    background: linear-gradient(135deg, var(--success), var(--success-dark), var(--brand-1));
    background-size: 200% auto;
    color: #fff;
    box-shadow: 0 15px 35px rgba(16,185,129,.4);
    animation: titleIn .8s var(--ease-spring) .95s both;
}
.btn::before {
    content: "";
    position: absolute;
    top: 50%; left: 50%;
    width: 0; height: 0;
    background: rgba(255,255,255,.3);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width .6s, height .6s;
}
.btn:hover::before {
    width: 500px; height: 500px;
}
.btn:hover {
    background-position: right center;
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 22px 50px rgba(16,185,129,.55);
}
.btn:active {
    transform: translateY(-1px) scale(1);
}
.btn i {
    transition: transform .3s var(--ease-spring);
}
.btn:hover i {
    transform: translateX(-4px);
}

/* ================================================================
   COUNTDOWN
   ================================================================ */
.countdown {
    margin-top: 18px;
    font-size: 12px;
    color: var(--text-muted);
    animation: titleIn .8s var(--ease-spring) 1.1s both;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: .5px;
}
.countdown span {
    color: var(--success-dark);
    font-weight: 700;
    font-size: 13px;
}

/* ================================================================
   CONFETTI
   ================================================================ */
.confetti {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1500;
    overflow: hidden;
}
.confetti-piece {
    position: absolute;
    width: 10px;
    height: 10px;
    animation: confettiFall 3s linear forwards;
}
@keyframes confettiFall {
    to {
        transform: translateY(110vh) rotate(720deg);
        opacity: 0;
    }
}

/* ================================================================
   THEME TOGGLE
   ================================================================ */
.theme-toggle {
    position: fixed;
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    color: var(--text);
    cursor: pointer;
    display: grid;
    place-items: center;
    font-size: 16px;
    transition: all .3s var(--ease-spring);
    z-index: 100;
}
.theme-toggle:hover {
    transform: scale(1.1) rotate(8deg);
    color: var(--brand-1);
}

/* ================================================================
   FOOTER
   ================================================================ */
.footer {
    position: absolute;
    bottom: 20px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 12px;
    color: var(--text-muted);
}
.footer strong {
    background: linear-gradient(120deg, var(--brand-1), var(--brand-3));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
}

/* ================================================================
   REDUCED MOTION
   ================================================================ */
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
    }
}
</style>
</head>
<body data-theme="light">

<!-- ============================================================
     BACKGROUND LAYERS
     ============================================================ -->
<div class="mesh-bg">
    <div class="mesh-blob m1"></div>
    <div class="mesh-blob m2"></div>
    <div class="mesh-blob m3"></div>
    <div class="mesh-blob m4"></div>
</div>

<!-- ============================================================
     THEME TOGGLE
     ============================================================ -->
<button type="button" class="theme-toggle" id="themeToggle" title="Toggle theme">
    <i class="fa-solid fa-sun" id="themeIcon">☀</i>
</button>

<!-- ============================================================
     MAIN CARD
     ============================================================ -->
<div class="page">
    <div class="card">
        <div class="card-inner">

            <!-- Success badge -->
            <div class="badge">
                <span class="dot"></span>
                Registration Successful
            </div>

            <!-- Animated SVG illustration -->
            <div class="illustration">
                <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="gradCircle" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#10b981"/>
                            <stop offset="100%" stop-color="#059669"/>
                        </linearGradient>
                        <linearGradient id="gradCheck" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0%" stop-color="#ffffff"/>
                            <stop offset="100%" stop-color="#f0fdf4"/>
                        </linearGradient>
                    </defs>

                    <!-- Pulsing outer rings -->
                    <circle class="pulse-ring" cx="100" cy="100" r="70"
                            fill="none" stroke="#10b981" stroke-width="2" opacity=".6"/>
                    <circle class="pulse-ring delay" cx="100" cy="100" r="70"
                            fill="none" stroke="#10b981" stroke-width="2" opacity=".6"/>

                    <!-- Dashed spinning ring -->
                    <circle class="ring-spin" cx="100" cy="100" r="82"
                            fill="none" stroke="#ff6a00" stroke-width="1.5"
                            stroke-dasharray="6 10" opacity=".5"/>

                    <!-- Main circle -->
                    <circle class="circle-scale" cx="100" cy="100" r="58"
                            fill="url(#gradCircle)"
                            filter="drop-shadow(0 15px 30px rgba(16,185,129,.4))"/>

                    <!-- White checkmark -->
                    <path class="check-draw"
                          d="M 75 100 L 92 117 L 128 82"
                          fill="none"
                          stroke="url(#gradCheck)"
                          stroke-width="9"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>

                    <!-- Sparkles -->
                    <g fill="#ff6a00">
                        <circle class="sparkle" cx="40" cy="50" r="3"/>
                        <circle class="sparkle s2" cx="165" cy="60" r="2.5" fill="#7c3aed"/>
                        <circle class="sparkle s3" cx="45" cy="160" r="2.5" fill="#06b6d4"/>
                        <circle class="sparkle s4" cx="170" cy="150" r="3" fill="#ff2d95"/>
                    </g>
                </svg>
            </div>

            <!-- Text -->
            <h1 class="title">Registration Complete!</h1>
            <p class="subtitle">
                Your employee registration has been submitted successfully.
                The details are now being processed by the EIS team.
            </p>

            <!-- Info grid -->
            <div class="info-grid">
                <div class="info-item">
                    <i>📧</i>
                    <strong>Confirmation</strong>
                    <span>Mail will be sent shortly</span>
                </div>
                <div class="info-item">
                    <i>⏱</i>
                    <strong>Processing</strong>
                    <span>Within 24 hours</span>
                </div>
                <div class="info-item">
                    <i>🔐</i>
                    <strong>Secure</strong>
                    <span>Data encrypted</span>
                </div>
            </div>

            <!-- Login form + button -->
            <form action="Login.do" method="post" style="margin:0;">
                <button type="submit" class="btn">
                    <i class="fa-solid fa-arrow-left"></i>
                    Go Back to Login Page
                </button>
            </form>

            <!-- Countdown (optional auto-redirect) -->
            <div class="countdown">
                Auto redirect in <span id="countdownNum">15</span>s
            </div>

        </div>
    </div>
</div>

<!-- ============================================================
     CONFETTI HOST
     ============================================================ -->
<div class="confetti" id="confettiHost"></div>

<!-- ============================================================
     FONT AWESOME (already included in JSP, but standalone thanks.html needs it)
     ============================================================ -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<!-- ============================================================
     SCRIPTS
     ============================================================ -->
<script>
(function () {
    'use strict';

    /* ---------- Confetti burst on load ---------- */
    const confettiHost = document.getElementById('confettiHost');
    function fireConfetti(count) {
        const colors = ['#10b981','#059669','#ff6a00','#7c3aed','#06b6d4','#ff2d95','#f59e0b'];
        for (let i = 0; i < count; i++) {
            const p = document.createElement('div');
            p.className = 'confetti-piece';
            p.style.left = Math.random() * 100 + 'vw';
            p.style.top  = '-20px';
            p.style.background = colors[Math.floor(Math.random() * colors.length)];
            p.style.transform = 'rotate(' + (Math.random() * 360) + 'deg)';
            p.style.animationDelay = (Math.random() * 0.6) + 's';
            p.style.animationDuration = (2.4 + Math.random() * 1.4) + 's';
            if (Math.random() > 0.7) p.style.borderRadius = '50%';
            confettiHost.appendChild(p);
            setTimeout(() => p.remove(), 4000);
        }
    }

    // Fire initial burst
    setTimeout(() => fireConfetti(90), 200);
    // Second smaller burst for drama
    setTimeout(() => fireConfetti(50), 1000);

    /* ---------- Theme toggle ---------- */
    const themeToggle = document.getElementById('themeToggle');
    const themeIcon   = document.getElementById('themeIcon');
    const saved = localStorage.getItem('eis-theme') || 'light';
    document.body.dataset.theme = saved;
    updateIcon(saved);

    function updateIcon(theme) {
        themeIcon.textContent = theme === 'dark' ? '🌙' : '☀';
    }

    themeToggle.addEventListener('click', () => {
        const next = document.body.dataset.theme === 'dark' ? 'light' : 'dark';
        document.body.dataset.theme = next;
        localStorage.setItem('eis-theme', next);
        updateIcon(next);
    });

    /* ---------- Auto redirect countdown ---------- */
    let seconds = 15;
    const countdownEl = document.getElementById('countdownNum');
    const tick = setInterval(() => {
        seconds--;
        if (countdownEl) countdownEl.textContent = seconds;
        if (seconds <= 0) {
            clearInterval(tick);
            window.location.href = 'Login.do';
        }
    }, 1000);

    /* ---------- Cancel countdown on manual click ---------- */
    document.querySelector('form[action="Login.do"]').addEventListener('submit', () => {
        clearInterval(tick);
    });

})();
</script>

</body>
</html>

<script>
/* ============================================================ THEME */
(function(){
  try {
    var t = localStorage.getItem('eis-roster-theme') || 'light';
    document.documentElement.setAttribute('data-theme', t);
  } catch(e){}
})();
function toggleTheme() {
  var cur = document.documentElement.getAttribute('data-theme') || 'light';
  var next = cur === 'light' ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', next);
  try { localStorage.setItem('eis-roster-theme', next); } catch(e){}
}

/* ============================================================ LIVE CLOCK */
function updateClock(){
  var now = new Date();
  var hh = String(now.getHours()).padStart(2,'0');
  var mm = String(now.getMinutes()).padStart(2,'0');
  var ss = String(now.getSeconds()).padStart(2,'0');
  var days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  var clockEl = document.getElementById('liveClock');
  var dateEl = document.getElementById('liveDate');
  if (clockEl) clockEl.textContent = hh + ':' + mm + ':' + ss;
  if (dateEl) dateEl.textContent = days[now.getDay()] + ', ' + now.getDate() + ' ' + months[now.getMonth()] + ' ' + now.getFullYear();
  var footEl = document.getElementById('footTime');
  if (footEl) footEl.textContent = 'Session active · ' + hh + ':' + mm;
}
setInterval(updateClock, 1000);
updateClock();

/* ============================================================ GREETING */
(function(){
  var h = new Date().getHours();
  var greet = 'Welcome back';
  if (h < 12) greet = 'Good morning';
  else if (h < 17) greet = 'Good afternoon';
  else if (h < 21) greet = 'Good evening';
  else greet = 'Good night';
  var el = document.getElementById('greeting');
  if (el) el.textContent = greet;
})();

/* ============================================================ FAVORITES */
function getFavs(){
  try{
    var f = JSON.parse(localStorage.getItem('eis-favs') || '[]');
    return Array.isArray(f) ? f : [];
  }catch(e){ return []; }
}
function setFavs(arr){
  try{ localStorage.setItem('eis-favs', JSON.stringify(arr)); }catch(e){}
}
function toggleFav(btn){
  var name = btn.getAttribute('data-fav');
  var favs = getFavs();
  var idx = favs.indexOf(name);
  if (idx === -1) {
    favs.push(name);
    btn.classList.add('active');
  } else {
    favs.splice(idx, 1);
    btn.classList.remove('active');
  }
  setFavs(favs);
  applyFilters();
}
function markFavs(){
  var favs = getFavs();
  document.querySelectorAll('.fav-btn').forEach(function(btn){
    var n = btn.getAttribute('data-fav');
    if (favs.indexOf(n) !== -1) btn.classList.add('active');
    else btn.classList.remove('active');
  });
}
markFavs();

/* ============================================================ FILTER + SEARCH */
var currentCat = 'all';
var currentSearch = '';

function applyFilters(){
  var favs = getFavs();
  var visibleCount = 0;
  document.querySelectorAll('#bentoGrid .bcard').forEach(function(card){
    var cat = card.getAttribute('data-cat') || '';
    var name = card.getAttribute('data-name') || '';
    var cardText = card.innerText.toLowerCase();

    var catMatch = (currentCat === 'all')
                || (currentCat === 'fav' && favs.indexOf(name) !== -1)
                || (currentCat === cat);
    var searchMatch = !currentSearch || cardText.indexOf(currentSearch) !== -1;

    if (catMatch && searchMatch) {
      card.classList.remove('hidden');
      visibleCount++;
    } else {
      card.classList.add('hidden');
    }
  });

  // Show empty state if needed
  var grid = document.getElementById('bentoGrid');
  var emptyState = document.getElementById('emptyState');
  if (visibleCount === 0) {
    if (!emptyState) {
      emptyState = document.createElement('div');
      emptyState.id = 'emptyState';
      emptyState.className = 'empty-state';
      emptyState.innerHTML =
        '<svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>' +
        '<h3>No dashboards found</h3>' +
        '<p>Try a different search or filter.</p>';
      grid.appendChild(emptyState);
    }
  } else if (emptyState) {
    emptyState.remove();
  }
}

document.querySelectorAll('.filter-tab').forEach(function(tab){
  tab.addEventListener('click', function(){
    document.querySelectorAll('.filter-tab').forEach(function(t){ t.classList.remove('active'); });
    tab.classList.add('active');
    currentCat = tab.getAttribute('data-cat');
    applyFilters();
  });
});

var searchInput = document.getElementById('dashSearch');
if (searchInput) {
  searchInput.addEventListener('input', function(){
    currentSearch = this.value.toLowerCase().trim();
    applyFilters();
  });
  searchInput.addEventListener('keydown', function(e){
    if (e.key === 'Escape') {
      this.value = '';
      currentSearch = '';
      applyFilters();
      this.blur();
    }
  });
}

/* Ctrl+K */
document.addEventListener('keydown', function(e){
  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
    e.preventDefault();
    if (searchInput) searchInput.focus();
  }
});

/* ============================================================ RECENTS */
function recordVisit(name, url){
  try {
    var recents = JSON.parse(localStorage.getItem('eis-recents') || '[]');
    recents = recents.filter(function(r){ return r.name !== name; });
    recents.unshift({ name: name, url: url, time: Date.now() });
    recents = recents.slice(0, 4);
    localStorage.setItem('eis-recents', JSON.stringify(recents));
  } catch(e){}
}

function renderRecents(){
  var recents = [];
  try { recents = JSON.parse(localStorage.getItem('eis-recents') || '[]'); } catch(e){}
  var section = document.getElementById('recentSection');
  var grid = document.getElementById('recentGrid');
  var count = document.getElementById('recentCount');
  if (!section || !grid) return;

  if (recents.length === 0) {
    section.style.display = 'none';
    return;
  }
  section.style.display = 'block';
  if (count) count.textContent = recents.length;

  grid.innerHTML = '';
  recents.forEach(function(r){
    var timeAgo = '';
    var diff = Date.now() - r.time;
    if (diff < 60000) timeAgo = 'just now';
    else if (diff < 3600000) timeAgo = Math.floor(diff/60000) + 'm ago';
    else if (diff < 86400000) timeAgo = Math.floor(diff/3600000) + 'h ago';
    else timeAgo = Math.floor(diff/86400000) + 'd ago';

    var card = document.createElement('a');
    card.className = 'recent-card';
    card.href = r.url;
    card.target = '_blank';
    card.rel = 'noopener noreferrer';
    card.innerHTML =
      '<span class="rc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="12 8 12 12 15 15"/><circle cx="12" cy="12" r="10"/></svg></span>' +
      '<span class="rc-text">' +
        '<span class="rc-name">' + r.name + '</span>' +
        '<span class="rc-time">' + timeAgo + '</span>' +
      '</span>';
    grid.appendChild(card);
  });
}
renderRecents();

/* Click to record recent */
document.querySelectorAll('#bentoGrid .bcard').forEach(function(card){
  card.addEventListener('click', function(){
    var name = card.getAttribute('data-name') || '';
    var url = card.href || '';
    if (name && url) recordVisit(name, url);
  });
});
</script>


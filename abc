    <div class="context-title">
      Team Roster &middot; <span class="accent"><%= nameOfMonth %> <%= selectedYear %></span>
    </div>
    <div class="context-meta">
      <span><b><%= totalEmp %></b> employees</span>
      <span class="sep"></span>
      <span><b><%= noOfDays %></b> days</span>
      <span class="sep"></span>
      <span><%= m_strroles %></span>
    </div>
  </div>

  <form method="get" class="context-right">
    <select name="month" class="c-input">
      <% String[] mns = {"","Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"};
         for (int m = 1; m <= 12; m++) {
             String val = String.format("%02d", m);
             String sel = (m == month) ? "selected" : "";
      %>
      <option value="<%= val %>" <%= sel %>><%= mns[m] %></option>
      <% } %>

<center>
<div id="notification-container" style="position:fixed; width:100%; top: 20px; z-index: 9999;">
<%
String errorMessage = (String) request.getAttribute("errorMessage");
String successMessage = (String) request.getAttribute("successMessage");
if (errorMessage != null) {
%>
<div class="alert-box" style="background-color: #ffcccc; color: #cc0000; padding: 15px; border-radius: 5px; margin: 0 auto 10px auto; max-width: 500px; max-height: 150px; overflow-y: auto; box-shadow: 0 2px 5px rgba(0,0,0,0.2); text-align: left;">
<strong style="font-size: 16px;">Upload Error:</strong><br>
<%= errorMessage.replace("\n", "<br>") %>
</div>
<% } %>

<% if (successMessage != null) { %>
<div class="alert-box" style="background-color: #ccffcc; color: #006600; padding: 15px; border-radius: 5px; margin: 0 auto 10px auto; max-width: 400px; max-height: 150px; overflow-y: auto; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
<strong>Success:</strong> <%= successMessage %>
</div>
<% } %>

</div>
</center> 	




<%@ page pageEncoding="UTF-8" language="java" %>
<%@ page import="java.util.List" %>
<%@ page import="com.beans.DeploymentSheetBean" %>
<%
    // ✅ Session check
    if(session == null || session.getAttribute("role") == null) {
        response.sendRedirect(request.getContextPath() + "/login.action");
        return;
    }

    // ✅ Cache headers
    response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate, max-age=0, private");
    response.setHeader("Pragma", "no-cache");
    response.setDateHeader("Expires", 0);
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Deployment Sheet Master</title>

<!-- ✅ DataTables CSS -->
<link rel="stylesheet" href="<%=request.getContextPath()%>/css/Deployment.jquery.dataTables.min.css" />
<link rel="stylesheet" href="<%=request.getContextPath()%>/css/Deployment.buttons.dataTables.min.css" />

<style>
/* ============================================================
   PAGE BASE
   ============================================================ */
body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg) !important;
    color: var(--ink) !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 15px;
    transition: background .3s ease, color .3s ease;
}
.new-wrapper {
    background: var(--bg);
    min-height: 100vh;
}
.page-container {
    padding: 24px 28px 48px;
    max-width: 1700px;
    margin: 0 auto;
}

/* ============================================================
   PAGE HEADER
   ============================================================ */
.page-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    flex-wrap: wrap;
}
.page-head .ttl {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -.5px;
    color: var(--ink);
    margin: 0;
    line-height: 1.2;
}
.page-head .ttl .ttl-icon {
    width: 42px; height: 42px;
    display: grid; place-items: center;
    background: var(--brand-light);
    color: var(--brand);
    border-radius: 12px;
    font-size: 1.05rem;
    flex-shrink: 0;
}
html[data-theme="dark"] .page-head .ttl .ttl-icon {
    background: rgba(248,111,3,.15);
}
.page-head .sub {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 500;
    margin: 6px 0 0 54px;
}
.icon-svg {
    width: 16px; height: 16px;
    display: inline-block; flex-shrink: 0;
    stroke: currentColor; fill: none;
    stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round;
}

/* ============================================================
   ACTION BAR
   ============================================================ */
.action-bar {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 16px 20px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    box-shadow: 0 2px 12px rgba(0,0,0,.03);
}
html[data-theme="dark"] .action-bar {
    box-shadow: 0 2px 12px rgba(0,0,0,.3);
}

.custom-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: 11px;
    color: var(--ink);
    font-family: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all .2s ease;
    text-decoration: none;
    white-space: nowrap;
}
.custom-btn:hover {
    border-color: var(--brand);
    color: var(--brand);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px -4px rgba(248,111,3,.3);
}
.custom-btn.danger {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: #fff;
    border-color: transparent;
    box-shadow: 0 6px 20px -6px rgba(239,68,68,.4);
}
.custom-btn.danger:hover {
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px -6px rgba(239,68,68,.5);
}
.custom-btn .icon-svg { width: 14px; height: 14px; stroke-width: 2.4; }

/* ============================================================
   TABLE CARD
   ============================================================ */
.table-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,.03);
    overflow: hidden;
}
html[data-theme="dark"] .table-card {
    box-shadow: 0 2px 12px rgba(0,0,0,.3);
}

/* ============================================================
   DATATABLES THEME OVERRIDE
   ============================================================ */
.dataTables_wrapper {
    width: 100%;
    overflow-x: auto;
    color: var(--ink);
    font-size: 0.85rem;
}
.dataTables_wrapper .dataTables_filter,
.dataTables_wrapper .dataTables_length {
    margin-bottom: 14px;
    color: var(--muted);
    font-weight: 600;
}
.dataTables_wrapper .dataTables_filter input,
.dataTables_wrapper .dataTables_length select {
    background: var(--bg);
    border: 1.5px solid var(--line);
    border-radius: 9px;
    color: var(--ink);
    padding: 7px 12px;
    font-family: inherit;
    font-weight: 600;
    font-size: 0.83rem;
    outline: none;
    transition: all .2s ease;
}
.dataTables_wrapper .dataTables_filter input:focus,
.dataTables_wrapper .dataTables_length select:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(248,111,3,.12);
}

table.dataTable {
    width: 100% !important;
    border-collapse: collapse !important;
    background: transparent !important;
    margin: 0 !important;
    color: var(--ink) !important;
    font-size: 0.82rem;
    font-family: inherit;
}
table.dataTable thead th {
    background: var(--bg) !important;
    color: var(--muted) !important;
    font-weight: 800 !important;
    font-size: 0.72rem !important;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 12px 14px !important;
    border-bottom: 1.5px solid var(--line) !important;
    border-top: none !important;
    white-space: nowrap;
    text-align: left;
}
table.dataTable tbody td {
    padding: 11px 14px !important;
    border-bottom: 1px solid var(--line) !important;
    color: var(--ink) !important;
    vertical-align: middle;
    white-space: nowrap;
    text-align: left;
    font-weight: 600;
}
table.dataTable tbody tr {
    background: var(--card) !important;
    transition: background .15s ease;
}
table.dataTable tbody tr:hover {
    background: var(--bg) !important;
}
html[data-theme="dark"] table.dataTable tbody tr:hover {
    background: rgba(255,255,255,.03) !important;
}
table.dataTable tbody tr:last-child td {
    border-bottom: none !important;
}

table.dataTable.stripe tbody tr.odd {
    background: var(--card) !important;
}
table.dataTable.stripe tbody tr.even {
    background: var(--bg) !important;
}
html[data-theme="dark"] table.dataTable.stripe tbody tr.even {
    background: rgba(255,255,255,.02) !important;
}

/* Buttons inside DataTables */
.dt-buttons {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
    flex-wrap: wrap;
}
.dt-buttons .dt-button {
    display: inline-flex !important;
    align-items: center;
    gap: 6px;
    padding: 9px 16px !important;
    background: var(--card) !important;
    border: 1.5px solid var(--line) !important;
    border-radius: 10px !important;
    color: var(--ink) !important;
    font-family: inherit !important;
    font-weight: 700 !important;
    font-size: 0.8rem !important;
    cursor: pointer;
    transition: all .2s ease !important;
    text-decoration: none !important;
    box-shadow: none !important;
}
.dt-buttons .dt-button:hover {
    border-color: var(--brand) !important;
    color: var(--brand) !important;
    background: var(--brand-light) !important;
    transform: translateY(-1px);
}
html[data-theme="dark"] .dt-buttons .dt-button:hover {
    background: rgba(248,111,3,.15) !important;
}

/* Pagination */
.dataTables_wrapper .dataTables_paginate {
    margin-top: 16px;
    display: flex;
    justify-content: flex-end;
    gap: 4px;
    flex-wrap: wrap;
}
.dataTables_wrapper .dataTables_paginate .paginate_button {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    padding: 0 10px !important;
    background: var(--card) !important;
    border: 1.5px solid var(--line) !important;
    border-radius: 9px !important;
    color: var(--muted) !important;
    font-weight: 700;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all .15s ease;
    margin: 0 !important;
}
.dataTables_wrapper .dataTables_paginate .paginate_button:hover {
    background: var(--bg) !important;
    border-color: var(--brand) !important;
    color: var(--brand) !important;
}
.dataTables_wrapper .dataTables_paginate .paginate_button.current {
    background: linear-gradient(135deg, var(--brand), var(--brand-2)) !important;
    color: #fff !important;
    border-color: transparent !important;
    box-shadow: 0 4px 12px -3px rgba(248,111,3,.4);
}
.dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
    opacity: .4;
    cursor: not-allowed;
}
.dataTables_wrapper .dataTables_info {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
    margin-top: 16px;
}
.dataTables_empty {
    color: var(--muted) !important;
    font-style: italic;
    padding: 40px 20px !important;
    text-align: center;
    font-size: 0.9rem;
}

/* ============================================================
   CHECKBOXES
   ============================================================ */
input[type="checkbox"] {
    width: 17px;
    height: 17px;
    cursor: pointer;
    accent-color: var(--brand);
}

/* ============================================================
   UPDATE BUTTON
   ============================================================ */
.update-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    border: none;
    color: white;
    padding: 6px 12px;
    border-radius: 7px;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.78rem;
    transition: all .2s ease;
    font-family: inherit;
    white-space: nowrap;
}
.update-btn:hover {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px -3px rgba(59,130,246,.5);
}

/* ============================================================
   MODAL
   ============================================================ */
#updateModal {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0; top: 0;
    width: 100%; height: 100%;
    overflow: auto;
    background-color: rgba(0,0,0,0.7);
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
}
#updateModal .modal-content {
    background: var(--card);
    padding: 26px 28px;
    border-radius: 16px;
    max-width: 560px;
    width: 92%;
    margin: auto;
    color: var(--ink);
    font-size: 14px;
    border: 1px solid var(--line);
    box-shadow: 0 30px 80px rgba(0,0,0,.4);
    max-height: 90vh;
    overflow-y: auto;
}
#updateModal h2 {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -.4px;
    margin-bottom: 18px;
    color: var(--ink);
}
#updateModal label {
    display: block;
    margin-top: 12px;
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 5px;
}
#updateModal input[type="text"],
#updateModal input[type="datetime-local"],
#updateModal select,
#updateModal textarea {
    width: 100%;
    padding: 10px 12px;
    margin-top: 2px;
    border-radius: 10px;
    border: 1.5px solid var(--line);
    background-color: var(--bg);
    color: var(--ink);
    font-size: 0.88rem;
    font-family: inherit;
    font-weight: 600;
    outline: none;
    transition: all .2s ease;
}
#updateModal input:focus,
#updateModal textarea:focus,
#updateModal select:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(248,111,3,.12);
    background-color: var(--card);
}
#updateModal textarea {
    height: 70px;
    resize: vertical;
    min-height: 60px;
}
.modal-buttons {
    margin-top: 20px;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}
.modal-buttons button {
    padding: 10px 20px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.85rem;
    font-family: inherit;
    transition: all .2s ease;
}
.modal-buttons button.save-btn {
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    color: #fff;
    box-shadow: 0 6px 20px -6px rgba(248,111,3,.4);
}
.modal-buttons button.save-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px -6px rgba(248,111,3,.5);
}
.modal-buttons button.cancel-btn {
    background: var(--bg);
    color: var(--muted);
    border: 1.5px solid var(--line);
}
.modal-buttons button.cancel-btn:hover {
    background: var(--card);
    color: var(--ink);
    border-color: var(--muted);
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 900px) {
    .page-container { padding: 16px 14px 32px; }
    .page-head .ttl { font-size: 1.2rem; }
    .page-head .ttl .ttl-icon { width: 36px; height: 36px; font-size: .9rem; }
    .page-head .sub { margin-left: 48px; font-size: 0.78rem; }
    .action-bar { flex-direction: column; align-items: stretch; }
    .custom-btn { justify-content: center; }
    .dt-buttons { flex-direction: column; }
    .dt-buttons .dt-button { width: 100%; justify-content: center; }
    #updateModal .modal-content { padding: 20px; }
}
</style>
</head>
<body>

<%@include file="../userheader.jsp"%>

<div class="new-wrapper">
<div class="page-container">

    <!-- ============ PAGE HEADER ============ -->
    <div class="page-head">
        <div>
            <h1 class="ttl">
                <span class="ttl-icon">
                    <svg class="icon-svg" viewBox="0 0 24 24" style="width:20px;height:20px;stroke-width:2.4;">
                        <path d="M9 11l3 3L22 4"/>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                    </svg>
                </span>
                Deployment Sheet Master
            </h1>
            <p class="sub">Review, update, or delete deployment records</p>
        </div>
    </div>

    <!-- ============ ACTION BAR ============ -->
    <div class="action-bar">
        <button id="deleteSelected" class="custom-btn danger">
            <svg class="icon-svg" viewBox="0 0 24 24">
                <polyline points="3 6 5 6 21 6"/>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                <line x1="10" y1="11" x2="10" y2="17"/>
                <line x1="14" y1="11" x2="14" y2="17"/>
            </svg>
            Delete Selected
        </button>
    </div>

    <!-- ============ TABLE ============ -->
    <div class="table-card">
        <table id="deploymentTable" class="display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th><input type="checkbox" id="deleteAll" title="Delete All"/></th>
                    <th>EXP URL</th>
                    <th>EXP URL W.R.T SYS URL</th>
                    <th>API_NAME</th>
                    <th>SOURCE_ID</th>
                    <th>Broker</th>
                    <th>Broker EG</th>
                    <th>New/Existing/NBC</th>
                    <th>Hits in Production</th>
                    <th>Failure (More than 50%)</th>
                    <th>Success</th>
                    <th>Changes Description</th>
                    <th>Remarks</th>
                    <th>Deployment Date Time</th>
                    <th>Update</th>
                </tr>
            </thead>
            <tbody>
                <%
                    List<DeploymentSheetBean> deploymentData = (List<DeploymentSheetBean>) request.getAttribute("deploymentData");
                    if (deploymentData != null) {
                        for (DeploymentSheetBean bean : deploymentData) {
                %>
                <tr data-srno="<%= bean.getM_strSr_No() %>">
                    <td><input type="checkbox" class="rowCheckbox" name="Result" value="<%= bean.getM_strSr_No() %>"/></td>
                    <td><%= bean.getM_strExp_Sys_Url() %></td>
                    <td><%= bean.getM_strExpUrl_WRT_SysUrl() %></td>
                    <td><%= bean.getM_strApi_Name() %></td>
                    <td><%= bean.getM_strSourceID() %></td>
                    <td><%= bean.getM_strBroker() %></td>
                    <td><%= bean.getM_strBroker_Eg() %></td>
                    <td><%= bean.getM_strNew_Existing_NBC() %></td>
                    <td><%= bean.getM_strHitsinproduction() %></td>
                    <td><%= bean.getM_strFailure() %></td>
                    <td><%= bean.getM_strSuccess() %></td>
                    <td><%= bean.getM_changes_Description() %></td>
                    <td><%= bean.getM_strRemarks() %></td>
                    <td><%= bean.getM_strDeployment_Date_Time() %></td>
                    <td><button type="button" class="update-btn">Update</button></td>
                </tr>
                <%
                        }
                    }
                %>
            </tbody>
        </table>
    </div>

</div>
</div>

<!-- ============ UPDATE MODAL ============ -->
<div id="updateModal">
    <div class="modal-content">
        <h2>Update Deployment Entry</h2>
        <form id="updateForm" method="post" action="<%=request.getContextPath()%>/ViewDeploymentSheetActionServ">
            <input type="hidden" name="action" value="update"/>
            <input type="hidden" name="m_strSr_No" id="srNo"/>

            <label>Hits in Production</label>
            <input type="text" name="m_strHitsinproduction" id="hitsProd" required/>

            <label>Failure (More than 50%)</label>
            <input type="text" name="m_strFailure" id="failure" required/>

            <label>Success</label>
            <input type="text" name="m_strSuccess" id="success" required/>

            <label>Changes Description</label>
            <textarea name="changes" id="changesDesc" required></textarea>

            <label>Remarks</label>
            <textarea name="remarks" id="remarks"></textarea>

            <div class="modal-buttons">
                <button type="button" class="cancel-btn">Cancel</button>
                <button type="submit" class="save-btn">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- ============================================================
     ✅ DataTables SCRIPTS — jQuery already loaded by userheader
     ============================================================ -->
<script src="<%=request.getContextPath()%>/js/Deployment.1.13.6.jquery.dataTables.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.2.4.1.dataTables.buttons.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.2.4.1.buttons.html5.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.2.4.1.buttons.print.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.3.10.1.jszip.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.0.2.7.pdfmake.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.0.2.7.vfs_fonts.js"></script>

<script>
$(document).ready(function () {

    if (typeof jQuery === 'undefined' || typeof jQuery.fn.DataTable === 'undefined') {
        console.error('❌ jQuery/DataTables not loaded!');
        return;
    }

    /* ============================================================
       DATATABLE INIT
       ============================================================ */
    const table = $('#deploymentTable').DataTable({
        dom: 'Bfrtip',
        paging: true,
        scrollX: true,
        responsive: false,
        pageLength: 15,
        searching: true,
        ordering: true,
        order: [],
        lengthChange: false,
        language: {
            search: "",
            searchPlaceholder: "Search deployments...",
            emptyTable: "No deployments found.",
            info: "Showing _START_ to _END_ of _TOTAL_ deployments",
            infoEmpty: "No deployments to show",
            infoFiltered: "(filtered from _MAX_ total)"
        },
        buttons: [
            {
                extend: 'excelHtml5',
                text: 'Export Excel',
                exportOptions: { columns: ':not(:first-child):not(:last-child)' }
            },
            {
                extend: 'pdfHtml5',
                text: 'Export PDF',
                exportOptions: { columns: ':not(:first-child):not(:last-child)' },
                orientation: 'landscape',
                pageSize: 'A4'
            }
        ],
        columnDefs: [
            { orderable: false, targets: [0, 14] }
        ]
    });

    /* ============================================================
       DELETE ALL CHECKBOX
       ============================================================ */
    $('#deleteAll').on('click', function () {
        $('.rowCheckbox').prop('checked', this.checked);
    });

    /* ============================================================
       DELETE SELECTED — AJAX
       ============================================================ */
    $('#deleteSelected').on('click', function () {
        const selectedRows = $('#deploymentTable tbody input.rowCheckbox:checked');
        if (!selectedRows.length) {
            alert("Please select at least one row to delete.");
            return;
        }
        if (!confirm(`Delete ${selectedRows.length} record(s)?`)) return;

        const ids = selectedRows.map(function () {
            return $(this).val();
        }).get();

        $.ajax({
            url: '<%=request.getContextPath()%>/ViewDeploymentSheetActionServ',
            type: 'POST',
            data: {
                action: 'delete',
                Result: ids.join(',')
            },
            success: function (resp) {
                selectedRows.each(function () {
                    table.row($(this).closest('tr')).remove();
                });
                table.draw(false);
                $('#deleteAll').prop('checked', false);
                alert("Selected record(s) deleted successfully!");
            },
            error: function (xhr, status, err) {
                alert("Error deleting records: " + xhr.responseText);
            }
        });
    });

    /* ============================================================
       UPDATE MODAL
       ============================================================ */
    const modal = $('#updateModal');
    let currentRow = null;

    $('#deploymentTable tbody').on('click', '.update-btn', function () {
        currentRow = $(this).closest('tr');
        $('#srNo').val(currentRow.data('srno'));
        $('#hitsProd').val(currentRow.find('td').eq(8).text());
        $('#failure').val(currentRow.find('td').eq(9).text());
        $('#success').val(currentRow.find('td').eq(10).text());
        $('#changesDesc').val(currentRow.find('td').eq(11).text());
        $('#remarks').val(currentRow.find('td').eq(12).text());
        modal.css('display', 'flex');
    });

    $('.cancel-btn').on('click', function () {
        modal.hide();
        $('#updateForm')[0].reset();
    });

    modal.on('click', function (e) {
        if (e.target === this) {
            modal.hide();
            $('#updateForm')[0].reset();
        }
    });

    /* ============================================================
       ROW CHECKBOX SYNC
       ============================================================ */
    $('#deploymentTable tbody').on('change', '.rowCheckbox', function () {
        if (!this.checked) {
            $('#deleteAll').prop('checked', false);
        } else if ($('.rowCheckbox:checked').length === $('.rowCheckbox').length) {
            $('#deleteAll').prop('checked', true);
        }
    });

});
</script>


<script>
/* ============================================================
   THEME BOOT — before paint (no flash)
   ============================================================ */
(function() {
    try {
        var saved = localStorage.getItem('tx-theme');
        if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
        }
    } catch (e) {}
})();

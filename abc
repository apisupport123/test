<script src="<%=ctx%>/js/jquery-3.7.0.min.js"></script>
<script src="<%=ctx%>/js/dist_xlsx.full.min.js"></script>

<script>
(function () {
    'use strict';

    var CTX = '<%=ctx%>';
    var currentEmpId = null;

    /* ============================================================
       TOAST
       ============================================================ */
    var toastHost = document.getElementById('toastHost');
    function toast(msg, type) {
        var el = document.createElement('div');
        el.className = 'toast ' + (type || 'info');
        var icons = { success: '✅', error: '❌', info: 'ℹ️' };
        el.innerHTML = '<span class="ticon">' + (icons[type] || icons.info) + '</span><span>' + msg + '</span>';
        toastHost.appendChild(el);
        setTimeout(function () {
            el.style.transition = 'all .3s';
            el.style.opacity = '0';
            el.style.transform = 'translateX(40px) rotate(-1deg)';
            setTimeout(function () { el.remove(); }, 300);
        }, 3000);
    }

    /* ============================================================
       EMPLOYEE SELECT
       ============================================================ */
    window.selectEmployee = function (rowEl, index) {
        // Update active state
        document.querySelectorAll('.emp-row').forEach(function (r) { r.classList.remove('active'); });
        rowEl.classList.add('active');

        var data = window.EIS_DATA[index];
        if (!data) return;
        currentEmpId = data.empId;

        renderDetail(data);
        document.getElementById('detailPanel').classList.add('show');
    };

    function esc(s) {
        if (s === null || s === undefined) return '';
        return String(s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function field(k, v, full, mono) {
        if (v === null || v === undefined || v === '') v = '—';
        return '<div class="detail-field' + (full ? ' full' : '') + '">'
             +   '<div class="k">' + esc(k) + '</div>'
             +   '<div class="v' + (mono ? ' mono' : '') + '">' + esc(v) + '</div>'
             + '</div>';
    }

    function docCard(icon, name, hasFile, type, empId) {
        if (hasFile) {
            return '<a class="doc-card has ' + type.toLowerCase() + '" '
                 +    'href="' + CTX + '/DocumentDownloadServlet?empid=' + encodeURIComponent(empId)
                 +    '&type=' + type + '" target="_blank" '
                 +    'onclick="event.stopPropagation();">'
                 +   '<div class="doc-icon">' + icon + '</div>'
                 +   '<div class="doc-info">'
                 +     '<div class="name">' + esc(name) + '</div>'
                 +     '<div class="status">CLICK TO VIEW</div>'
                 +   '</div>'
                 + '</a>';
        } else {
            return '<div class="doc-card none">'
                 +   '<div class="doc-icon">' + icon + '</div>'
                 +   '<div class="doc-info">'
                 +     '<div class="name">' + esc(name) + '</div>'
                 +     '<div class="status">NOT UPLOADED</div>'
                 +   '</div>'
                 + '</div>';
        }
    }

    function renderDetail(d) {
        var html = '';

        // Header
        html += '<div class="detail-header">';
        html +=   '<h2>' + esc(d.fullName) + '</h2>';
        html +=   '<div class="empid">#' + esc(d.empId) + '</div>';
        html += '</div>';

        // Body
        html += '<div class="detail-body">';

        // Avatar + active badge
        html += '<div style="display:flex;gap:16px;align-items:flex-start;margin-bottom:20px;flex-wrap:wrap;">';
        html +=   '<div class="detail-avatar">';
        if (d.hasPhoto) {
            html += '<img src="' + CTX + '/DocumentDownloadServlet?empid=' + encodeURIComponent(d.empId)
                  + '&type=PHOTO" alt="' + esc(d.fullName) + '" '
                  + 'onerror="this.style.display=\'none\';this.parentNode.textContent=\'' + esc(d.initials) + '\';"/>';
        } else {
            html += esc(d.initials);
        }
        html +=   '</div>';
        html +=   '<div style="flex:1;min-width:160px;">';
        html +=     '<div style="font-size:11px;font-weight:900;letter-spacing:2px;opacity:.6;margin-bottom:6px;">STATUS</div>';
        html +=     '<span class="meta-tag ' + (d.active ? 'green' : 'red') + '" style="font-size:13px;padding:6px 12px;">'
                  +   (d.active ? '● ACTIVE' : '○ INACTIVE')
                  + '</span>';
        if (d.team) {
            html +=   '<div style="margin-top:8px;">'
                  +     '<span class="meta-tag cyan" style="font-size:13px;padding:6px 12px;">' + esc(d.team) + '</span>'
                  +   '</div>';
        }
        html +=   '</div>';
        html += '</div>';

        // Section: Identity
        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title">🪪 IDENTITY</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('Employee ID', d.empId, false, true);
        html +=     field('AD ID', d.adId, false, true);
        html +=     field('HID', d.hid, false, true);
        html +=     field('Asset ID', d.assetId, false, true);
        html +=   '</div>';
        html += '</div>';

        // Section: Personal
        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title">👤 PERSONAL</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('First Name', d.firstName);
        html +=     field('Middle Name', d.middleName);
        html +=     field('Last Name', d.lastName);
        html +=     field('Gender', d.gender);
        html +=     field('Date of Birth', d.dob, false, true);
        html +=     field('Education', d.education);
        html +=   '</div>';
        html += '</div>';

        // Section: Contact
        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title">📞 CONTACT</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('Contact', d.contact, false, true);
        html +=     field('Emergency', d.emergency, false, true);
        html +=     field('TCS Mail', d.tcsMail, true, false);
        html +=     field('SBI Mail', d.sbiMail, true, false);
        html +=   '</div>';
        html += '</div>';

        // Section: Address
        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title">📍 ADDRESS</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('State', d.state);
        html +=     field('City', d.city);
        html +=     field('Address', d.address, true);
        html +=   '</div>';
        html += '</div>';

        // Section: Work
        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title">💼 WORK</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('Team', d.team);
        html +=     field('Joining Date', d.joiningDate, false, true);
        html +=   '</div>';
        html += '</div>';

        // Section: VPN / Laptop
        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title">💻 VPN / LAPTOP</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('VPN Host', d.vpnHost, false, true);
        html +=     field('Laptop Host', d.laptopHost, false, true);
        html +=     field('Remote Type', d.remoteType);
        html +=     field('MAC Address', d.mac, false, true);
        html +=     field('IP Address', d.ip, false, true);
        html +=   '</div>';
        html += '</div>';

        // Section: Credentials
        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title">🔑 CREDENTIALS</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('Username', d.username, false, true);
        html +=     field('Password', d.password, false, true);
        html +=   '</div>';
        html += '</div>';

        // Section: Documents
        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title">📎 DOCUMENTS</div>';
        html +=   '<div class="docs-grid">';
        html +=     docCard('🖼️', 'PHOTO', d.hasPhoto, 'PHOTO', d.empId);
        html +=     docCard('📄', 'BGC', d.hasBgc, 'BGC', d.empId);
        html +=     docCard('🛡️', 'POLICE', d.hasPolice, 'POLICE', d.empId);
        html +=     docCard('📎', 'CV', d.hasCv, 'CV', d.empId);
        html +=   '</div>';
        html += '</div>';

        // Actions
        html += '<div class="detail-actions">';
        html +=   '<button type="button" class="btn cyan" onclick="editRecord(\'' + esc(d.empId) + '\');">✏️ EDIT</button>';
        html +=   '<button type="button" class="btn red"  onclick="deleteRecord(\'' + esc(d.empId) + '\');">🗑️ DELETE</button>';
        html += '</div>';

        html += '</div>'; // detail-body

        document.getElementById('detailContent').innerHTML = html;
    }

    /* ============================================================
       ACTIONS
       ============================================================ */
    window.editRecord = function (empId) {
        if (!empId) return;
        toast('Opening editor for ' + empId + '...', 'info');
        setTimeout(function () {
            window.location.href = CTX + '/jsp/EditProfileNew.jsp?action=edit&empid=' + encodeURIComponent(empId);
        }, 200);
    };

    window.deleteRecord = function (empId) {
        if (!empId) return;
        if (!confirm('Delete employee ' + empId + '? This cannot be undone.')) return;
        toast('Deleting ' + empId + '...', 'info');
        setTimeout(function () {
            window.location.href = CTX + '/ViewEisRegistrationDetails.action?action=delete&empid=' + encodeURIComponent(empId);
        }, 200);
    };

    window.goToRegistration = function () {
        window.location.href = CTX + '/showregpage.action';
    };

    window.exportToExcel = function () {
        try {
            var elt = document.getElementById('exportTable');
            var wb = XLSX.utils.table_to_book(elt, { sheet: 'Employees' });
            XLSX.writeFile(wb, 'Employee_Registry_' + new Date().toISOString().slice(0,10) + '.xlsx');
            toast('Exported successfully', 'success');
        } catch (e) {
            toast('Export failed: ' + e.message, 'error');
        }
    };

    /* ============================================================
       SEARCH FILTER
       ============================================================ */
    var searchInput = document.getElementById('searchInput');
    searchInput.addEventListener('input', function () {
        var q = this.value.trim().toLowerCase();
        var rows = document.querySelectorAll('.emp-row');
        var visible = 0;
        rows.forEach(function (r) {
            var hay = r.getAttribute('data-search') || '';
            if (q === '' || hay.indexOf(q) !== -1) {
                r.style.display = '';
                visible++;
            } else {
                r.style.display = 'none';
            }
        });
        document.getElementById('listCount').textContent = visible;
    });

    /* ============================================================
       AUTO-SELECT FIRST ROW ON LOAD
       ============================================================ */
    document.addEventListener('DOMContentLoaded', function () {
        var firstRow = document.querySelector('.emp-row');
        if (firstRow) {
            // Don't auto-select on mobile — user should choose
            if (window.innerWidth > 1100) {
                firstRow.click();
            }
        }
    });

})();
</script>

<%!
    private static String safe(String s) { return s != null ? s : ""; }

    /** Escape for JS string literal */
    private static String jsSafe(String s) {
        if (s == null) return "";
        return s.replace("\\", "\\\\")
                .replace("\"", "\\\"")
                .replace("\n", "\\n")
                .replace("\r", "\\r")
                .replace("<", "\\u003c")
                .replace(">", "\\u003e")
                .replace("&", "\\u0026");
    }
%>

</body>

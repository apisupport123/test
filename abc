<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@page import="com.jdbc.DBUtilityAuto"%>
<%@page import="com.beans.EmployeeDetailsBean"%>
<%@page import="java.sql.Connection"%>
<%@page import="java.sql.PreparedStatement"%>
<%@page import="java.sql.ResultSet"%>
<%@page import="java.sql.Blob"%>
<%@page import="java.util.ArrayList"%>
<%@page import="java.util.List"%>
<%@ taglib prefix="s" uri="/struts-tags" %>

<%
    // ============================================================
    // Load employee data using PreparedStatement (SQL-injection safe)
    // ============================================================
    String empid = request.getParameter("empid");
    EmployeeDetailsBean emp = null;

    String ctx = request.getContextPath();

    if (empid != null && !empid.trim().isEmpty()) {
        Connection con = null;
        PreparedStatement ps = null;
        ResultSet rs = null;
        try {
            con = DBUtilityAuto.getReportDBConnection();
            String sql = "SELECT * FROM eisupport_employee_master WHERE EMPLOYEE_ID = ?";
            ps = con.prepareStatement(sql);
            ps.setString(1, empid);
            rs = ps.executeQuery();

            if (rs.next()) {
                emp = new EmployeeDetailsBean();
                emp.setM_strEmployee_ID(rs.getString("EMPLOYEE_ID"));
                emp.setM_strAD_ID(rs.getString("AD_ID"));
                emp.setM_strHID(rs.getString("HID"));
                emp.setM_strAsset_ID(rs.getString("ASSET_ID"));
                emp.setM_strEducation_Qualification(rs.getString("EDU_QUALIFICATION"));
                emp.setM_strTCS_Joining_Date(rs.getString("TCS_JOINING_DATE"));
                emp.setM_strEmployee_contact_Number(rs.getString("CONTACTNUMBER"));
                emp.setM_strEmergency_contact_Number(rs.getString("EMERGENCY_CONTACTNUMBER"));
                emp.setM_strTeam(rs.getString("TEAM"));
                emp.setM_strTCS_mail_ID(rs.getString("TCS_MAILID"));
                emp.setM_strSBI_mail_ID(rs.getString("SBI_MAILID"));
                emp.setM_strState(rs.getString("STATE"));
                emp.setM_strCity(rs.getString("CITY"));
                emp.setM_strLocal_Address(rs.getString("LOCAL_ADDRESS"));
                emp.setM_strGender(rs.getString("GENDER"));
                emp.setM_strDate_Of_Birth(rs.getString("DOB"));
                emp.setM_strFirst_Name(rs.getString("FIRSTNAME"));
                emp.setM_strMiddle_Name(rs.getString("MIDDLENAME"));
                emp.setM_strLast_Name(rs.getString("LASTNAME"));
                emp.setM_strISACTIVE(rs.getString("ISACTIVE"));
                emp.setM_strVPN_Hostname(rs.getString("VPN_HOSTNAME"));
                emp.setM_strLaptop_Hostname(rs.getString("LAPTOP_HOSTNAME"));
                emp.setM_strRemote_Type(rs.getString("REMOTETYPE"));
                emp.setM_strVPN_VDI_MAC_Address(rs.getString("VPN_VDI_MACADDRESS"));
                emp.setM_strVPN_VDI_IP_Address(rs.getString("VPN_VDI_IPADDRESS"));
                emp.setM_strUserName(rs.getString("USERNAME"));
                emp.setM_strPassword(rs.getString("PASSWORD"));

                // ---- Document flags (BLOB status) ----
                Blob photoBlob  = rs.getBlob("PHOTO_PATH");
                Blob bgcBlob    = rs.getBlob("BGC_DOCUMENT_PATH");
                Blob policeBlob = rs.getBlob("POLICE_VERIFICATION_PATH");
                Blob cvBlob     = rs.getBlob("CV_DOCUMENT_PATH");

                emp.setM_strPhoto_Path(photoBlob != null && photoBlob.length() > 0 ? "Uploaded" : "");
                emp.setM_strBGC_Documents_Path(bgcBlob != null && bgcBlob.length() > 0 ? "Uploaded" : "");
                emp.setM_strPolice_Verification_Path(policeBlob != null && policeBlob.length() > 0 ? "Uploaded" : "");
                emp.setM_strCV_Document(cvBlob != null && cvBlob.length() > 0 ? "Uploaded" : "");

                // Free blobs
                if (photoBlob  != null) photoBlob.free();
                if (bgcBlob    != null) bgcBlob.free();
                if (policeBlob != null) policeBlob.free();
                if (cvBlob     != null) cvBlob.free();
            }
        } catch (Exception e) {
            e.printStackTrace();
        } finally {
            try { if (rs != null) rs.close(); } catch (Exception ignore) {}
            try { if (ps != null) ps.close(); } catch (Exception ignore) {}
            try { if (con != null) con.close(); } catch (Exception ignore) {}
        }
    }

    String fname = emp != null && emp.getM_strFirst_Name() != null ? emp.getM_strFirst_Name() : "";
    String lname = emp != null && emp.getM_strLast_Name() != null ? emp.getM_strLast_Name() : "";
    String fullName = (fname + " " + lname).trim();
    if (fullName.isEmpty()) fullName = "Employee";
%>

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit Profile · EIS Portal</title>

<style>
/* ================================================================
   TOKENS & THEME
   ================================================================ */
:root,
html[data-theme="light"] {
    --brand-1: #6366f1;
    --brand-2: #8b5cf6;
    --brand-3: #ec4899;
    --brand-4: #06b6d4;
    --brand-5: #10b981;

    --bg:        #f5f6fb;
    --surface:   #ffffff;
    --surface-2: #f9fafb;
    --surface-3: #f3f4f6;
    --border:    #e5e7eb;
    --border-2:  #d1d5db;

    --text:      #0f172a;
    --text-2:    #334155;
    --text-3:    #64748b;
    --text-4:    #94a3b8;

    --green:     #10b981;
    --green-bg:  #d1fae5;
    --green-text:#065f46;
    --red:       #ef4444;
    --red-bg:    #fee2e2;
    --red-text:  #991b1b;
    --amber:     #f59e0b;
    --amber-bg:  #fef3c7;
    --amber-text:#92400e;

    --shadow-xs: 0 1px 2px rgba(15,23,42,.04);
    --shadow-sm: 0 1px 3px rgba(15,23,42,.06), 0 1px 2px rgba(15,23,42,.04);
    --shadow:    0 4px 16px rgba(15,23,42,.06), 0 2px 6px rgba(15,23,42,.04);
    --shadow-md: 0 12px 32px rgba(15,23,42,.08), 0 4px 12px rgba(15,23,42,.04);
    --shadow-lg: 0 24px 60px rgba(15,23,42,.12);

    --nav-bg: rgba(255,255,255,.75);
    --nav-border: rgba(255,255,255,.6);
    --mesh-opacity: .35;
    --mesh-blend: multiply;
}

html[data-theme="dark"] {
    --brand-1: #818cf8;
    --brand-2: #a78bfa;
    --brand-3: #f472b6;
    --brand-4: #22d3ee;
    --brand-5: #34d399;

    --bg:        #0a0b14;
    --surface:   #16172a;
    --surface-2: #1c1d34;
    --surface-3: #232544;
    --border:    #2a2c48;
    --border-2:  #363858;

    --text:      #f1f5f9;
    --text-2:    #cbd5e1;
    --text-3:    #94a3b8;
    --text-4:    #64748b;

    --green-bg: rgba(16,185,129,.15);
    --green-text:#6ee7b7;
    --red-bg:   rgba(239,68,68,.15);
    --red-text: #fca5a5;
    --amber-bg: rgba(245,158,11,.15);
    --amber-text:#fcd34d;

    --shadow-xs: 0 1px 2px rgba(0,0,0,.3);
    --shadow-sm: 0 1px 3px rgba(0,0,0,.4);
    --shadow:    0 4px 16px rgba(0,0,0,.4);
    --shadow-md: 0 12px 32px rgba(0,0,0,.5);
    --shadow-lg: 0 24px 60px rgba(0,0,0,.6);

    --nav-bg: rgba(22,23,42,.75);
    --nav-border: rgba(42,44,72,.8);
    --mesh-opacity: .25;
    --mesh-blend: screen;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; transition: background-color .3s ease; }

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                 "Helvetica Neue", Arial, sans-serif;
    color: var(--text);
    background: var(--bg);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    transition: background-color .3s ease, color .3s ease;
}

/* ================================================================
   MESH BACKGROUND
   ================================================================ */
.mesh-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: var(--bg);
}
.mesh-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: var(--mesh-opacity);
    mix-blend-mode: var(--mesh-blend);
    will-change: transform;
}
.mesh-blob.m1 {
    width: 600px; height: 600px;
    background: radial-gradient(circle, var(--brand-1), transparent 65%);
    top: -15%; left: -10%;
    animation: meshMove 24s ease-in-out infinite;
}
.mesh-blob.m2 {
    width: 700px; height: 700px;
    background: radial-gradient(circle, var(--brand-3), transparent 65%);
    top: 20%; right: -20%;
    animation: meshMove 28s ease-in-out infinite reverse;
}
.mesh-blob.m3 {
    width: 500px; height: 500px;
    background: radial-gradient(circle, var(--brand-4), transparent 65%);
    bottom: -15%; left: 30%;
    animation: meshMove 32s ease-in-out infinite;
    animation-delay: -10s;
}
@keyframes meshMove {
    0%, 100% { transform: translate(0,0) scale(1); }
    33%      { transform: translate(80px,-60px) scale(1.15); }
    66%      { transform: translate(-60px,70px) scale(.9); }
}

/* ================================================================
   TOP NAV
   ================================================================ */
.topnav {
    background: var(--nav-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--nav-border);
    padding: 0 28px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-xs);
}
.nav-brand { display: flex; align-items: center; gap: 14px; }
.nav-logo {
    width: 40px; height: 40px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-3));
    display: grid; place-items: center;
    color: #fff;
    font-weight: 800;
    font-size: 15px;
    box-shadow: 0 6px 20px rgba(99,102,241,.4);
}
.nav-title {
    font-size: 16px;
    font-weight: 700;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-3));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}
.nav-subtitle { font-size: 11.5px; color: var(--text-3); margin-top: 1px; }
.nav-actions { display: flex; gap: 10px; align-items: center; }

/* ================================================================
   BUTTONS
   ================================================================ */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 18px;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 600;
    border-radius: 10px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all .2s cubic-bezier(.22,1,.36,1);
    text-decoration: none;
    white-space: nowrap;
    height: 40px;
    line-height: 1;
}
.btn-primary {
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    color: #fff;
    box-shadow: 0 4px 14px rgba(99,102,241,.35);
}
.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(99,102,241,.5);
}
.btn-secondary {
    background: var(--surface);
    color: var(--text-2);
    border-color: var(--border);
    box-shadow: var(--shadow-xs);
}
.btn-secondary:hover {
    background: var(--surface-2);
    color: var(--text);
    transform: translateY(-1px);
}
.btn-danger {
    background: var(--surface);
    color: var(--red);
    border-color: var(--border);
}
.btn-danger:hover {
    background: var(--red-bg);
    border-color: var(--red);
    color: var(--red-text);
}
.btn-success {
    background: linear-gradient(135deg, #10b981, #059669);
    color: #fff;
    box-shadow: 0 4px 14px rgba(16,185,129,.35);
}
.btn-success:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(16,185,129,.5);
}
.btn-sm { height: 32px; padding: 6px 12px; font-size: 12px; }

/* Theme toggle */
.theme-toggle {
    position: relative;
    width: 40px; height: 40px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    cursor: pointer;
    display: grid; place-items: center;
    box-shadow: var(--shadow-xs);
    transition: all .25s ease;
    overflow: hidden;
}
.theme-toggle:hover { transform: translateY(-1px); border-color: var(--border-2); }
.theme-toggle .icon {
    position: absolute;
    font-size: 18px;
    transition: all .5s cubic-bezier(.34,1.56,.64,1);
}
.theme-toggle .sun  { opacity: 0; transform: rotate(-90deg) scale(.5); }
.theme-toggle .moon { opacity: 1; transform: rotate(0) scale(1); }
html[data-theme="dark"] .theme-toggle .sun  { opacity: 1; transform: rotate(0) scale(1); }
html[data-theme="dark"] .theme-toggle .moon { opacity: 0; transform: rotate(90deg) scale(.5); }

/* ================================================================
   PAGE LAYOUT
   ================================================================ */
.page {
    max-width: 1440px;
    margin: 0 auto;
    padding: 32px 24px 60px;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 24px;
    flex-wrap: wrap;
}
.page-header h1 {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -.8px;
    line-height: 1.1;
    background: linear-gradient(135deg, var(--text) 40%, var(--brand-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}
.page-header p {
    font-size: 14px;
    color: var(--text-3);
    margin-top: 8px;
}

/* ================================================================
   MAIN GRID
   ================================================================ */
.grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 20px;
    align-items: start;
}

.card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: all .3s ease;
}
.card:hover { box-shadow: var(--shadow); }

/* ================================================================
   LEFT PANEL — Profile
   ================================================================ */
.profile-card {
    position: sticky;
    top: 88px;
    overflow: visible;
}

.profile-head {
    padding: 32px 24px 24px;
    text-align: center;
    background: linear-gradient(135deg,
        rgba(99,102,241,.08),
        rgba(236,72,153,.05));
    border-bottom: 1px solid var(--border);
    position: relative;
}

.profile-photo-wrap {
    position: relative;
    width: 128px; height: 128px;
    margin: 0 auto 16px;
    border-radius: 50%;
    padding: 4px;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-3));
    box-shadow: 0 12px 32px rgba(99,102,241,.35);
    transition: transform .3s cubic-bezier(.34,1.56,.64,1);
}
.profile-photo-wrap:hover { transform: scale(1.05) rotate(-2deg); }

.profile-photo {
    width: 100%; height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface);
    border: 4px solid var(--surface);
    display: block;
}

.profile-photo-overlay {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: rgba(0,0,0,.55);
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    opacity: 0;
    cursor: pointer;
    transition: opacity .25s ease;
    font-size: 11px;
    font-weight: 600;
    text-align: center;
    line-height: 1.3;
}
.profile-photo-overlay .icon { font-size: 24px; margin-bottom: 2px; }
.profile-photo-wrap:hover .profile-photo-overlay { opacity: 1; }

.profile-name {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -.4px;
    color: var(--text);
    margin-bottom: 4px;
}
.profile-role {
    font-size: 13px;
    color: var(--text-3);
    margin-bottom: 12px;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .2px;
}
.status-badge::before {
    content: "";
    width: 7px; height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
}
.status-badge.active { background: var(--green-bg); color: var(--green-text); }
.status-badge.inactive { background: var(--red-bg); color: var(--red-text); }

/* Profile meta list */
.profile-meta {
    padding: 20px 24px;
}
.meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13.5px;
}
.meta-row:last-child { border-bottom: none; }
.meta-row .label {
    color: var(--text-3);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
}
.meta-row .label .icon {
    width: 28px; height: 28px;
    border-radius: 8px;
    display: grid; place-items: center;
    background: linear-gradient(135deg, rgba(99,102,241,.12), rgba(236,72,153,.06));
    font-size: 14px;
}
.meta-row .value {
    color: var(--text);
    font-weight: 600;
    text-align: right;
    word-break: break-word;
    overflow-wrap: anywhere;
    max-width: 60%;
}

/* ================================================================
   DOCUMENTS SECTION
   ================================================================ */
.docs-section {
    padding: 20px 24px;
    border-top: 1px solid var(--border);
}
.docs-title {
    font-size: 11px;
    font-weight: 800;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.docs-title::before {
    content: "";
    width: 6px; height: 6px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-3));
    box-shadow: 0 0 10px rgba(99,102,241,.6);
}

.doc-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    margin-bottom: 10px;
    transition: all .25s cubic-bezier(.22,1,.36,1);
    position: relative;
}
.doc-card:hover {
    border-color: var(--brand-1);
    background: rgba(99,102,241,.04);
    transform: translateX(4px);
}
.doc-card.uploaded {
    border-color: rgba(16,185,129,.3);
    background: rgba(16,185,129,.04);
}
.doc-card .doc-icon {
    width: 38px; height: 38px;
    border-radius: 10px;
    display: grid; place-items: center;
    font-size: 18px;
    background: var(--surface-3);
    flex-shrink: 0;
}
.doc-card.uploaded .doc-icon {
    background: var(--green-bg);
    color: var(--green-text);
}
.doc-card .doc-info { flex: 1; min-width: 0; }
.doc-card .doc-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 2px;
}
.doc-card .doc-status {
    font-size: 11px;
    color: var(--text-3);
    font-weight: 500;
}
.doc-card.uploaded .doc-status { color: var(--green-text); }

.doc-actions {
    display: flex;
    gap: 4px;
}
.doc-btn {
    width: 30px; height: 30px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-3);
    cursor: pointer;
    display: grid; place-items: center;
    transition: all .2s ease;
    font-size: 13px;
}
.doc-btn:hover {
    background: var(--brand-1);
    color: #fff;
    transform: scale(1.1);
}
.doc-btn.delete:hover {
    background: var(--red);
    color: #fff;
}
.doc-btn input[type="file"] {
    display: none;
}

/* Hidden delete flags */
.hidden-flag { display: none; }

/* ================================================================
   RIGHT PANEL — Form
   ================================================================ */
.form-card { padding: 32px; }

.form-section {
    margin-bottom: 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
}
.form-section:last-of-type { border-bottom: none; padding-bottom: 0; }

.section-title {
    font-size: 12px;
    font-weight: 800;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
}
.section-title::before {
    content: "";
    width: 8px; height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-3));
    box-shadow: 0 0 10px rgba(99,102,241,.6);
}
.section-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
}
.form-grid .span-2 { grid-column: span 2; }
@media (max-width: 640px) {
    .form-grid .span-2 { grid-column: span 1; }
}

.field { display: flex; flex-direction: column; gap: 6px; }
.field label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-3);
    letter-spacing: .02em;
}
.field input[type="text"],
.field input[type="date"],
.field input[type="password"],
.field select {
    width: 100%;
    padding: 12px 14px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    background: var(--surface-2);
    border: 1.5px solid transparent;
    border-radius: 10px;
    outline: none;
    transition: all .2s ease;
}
.field input:focus,
.field select:focus {
    background: var(--surface);
    border-color: var(--brand-1);
    box-shadow: 0 0 0 4px rgba(99,102,241,.15);
    transform: translateY(-1px);
}
.field select {
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236b7280' stroke-width='2'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 16px;
    padding-right: 38px;
}

/* Action bar */
.action-bar {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 20px 0 0;
    margin-top: 24px;
    border-top: 1px solid var(--border);
}

/* ================================================================
   TOAST
   ================================================================ */
.toast-host {
    position: fixed;
    top: 84px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 360px;
}
.toast {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 18px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text);
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    gap: 12px;
    animation: toastIn .3s cubic-bezier(.34,1.56,.64,1);
    position: relative;
    overflow: hidden;
}
.toast::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
}
.toast.success::before { background: linear-gradient(180deg, #10b981, #34d399); }
.toast.error::before   { background: linear-gradient(180deg, #ef4444, #f87171); }
.toast.info::before    { background: linear-gradient(180deg, #6366f1, #8b5cf6); }
.toast .ticon {
    width: 26px; height: 26px;
    border-radius: 8px;
    display: grid; place-items: center;
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
}
.toast.success .ticon { background: var(--green-bg); color: var(--green-text); }
.toast.error   .ticon { background: var(--red-bg); color: var(--red-text); }
.toast.info    .ticon { background: rgba(99,102,241,.15); color: var(--brand-1); }
@keyframes toastIn {
    from { opacity: 0; transform: translateX(30px) scale(.95); }
    to   { opacity: 1; transform: translateX(0) scale(1); }
}

/* ================================================================
   RESPONSIVE
   ================================================================ */
@media (max-width: 1100px) {
    .grid { grid-template-columns: 1fr; }
    .profile-card { position: static; }
}
@media (max-width: 640px) {
    .page { padding: 20px 16px 40px; }
    .form-card { padding: 20px 18px; }
    .topnav { padding: 0 16px; }
    .nav-subtitle { display: none; }
    .page-header h1 { font-size: 22px; }
    .toast-host { top: 76px; right: 12px; left: 12px; max-width: none; }
    .form-grid { grid-template-columns: 1fr; }
}
</style>

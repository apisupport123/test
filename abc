// Helper method to safely get parameter value
private String getParameter(HttpServletRequest request, String paramName) {
String value = request.getParameter(paramName);
return value != null ? value.trim() : "";
}

// Helper method to validate required fields
private boolean validateRequiredFields(HttpServletRequest request) {
String[] requiredFields = {
"m_stremployee_id", "m_strad_id", "m_streduqualification",
"m_strtcsjoiningdate", "m_strcontactno", "m_strRole",
"m_strtcsmailid", "m_strstate", "m_strcity",
"m_strlocaladdress", "m_strdob", "m_strfirstName",
"m_strlastName", "m_strISACTIVE", "m_strUserName",
"m_strPassword", "m_strhid"
};

for (String field : requiredFields) {
String value = getParameter(request, field);
if (value.isEmpty() || "Select".equals(value) || "Select Role".equals(value) 
|| "Select Education Qualification".equals(value) || "Select State".equals(value)) {
return false;
}
}

// Validate contact number format
String contactNo = getParameter(request, "m_strcontactno");
if (!contactNo.matches("\\d{10}")) {
return false;
}

return true;
}

}

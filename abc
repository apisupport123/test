<div class="bottom-bar">
  <div>SESSION: <b style="color:var(--brand)">ENCRYPTED · AES-256</b></div>
  <div class="keys">
    <kbd>Tab</kbd> navigate <kbd>Enter</kbd> submit <kbd>Esc</kbd> clear
  </div>
  <div>Made with <span class="heart">♥</span> for EIS</div>
</div>

<script>
const CTX = '<%=request.getContextPath()%>';

/* ============ LIVE CLOCK ============ */
function updateClock(){
  const d = new Date();
  const pad = n => String(n).padStart(2,'0');
  document.getElementById('clock').textContent =
    pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
}
setInterval(updateClock, 1000);
updateClock();

/* ============ TYPEWRITER EFFECT ============ */
const phrases = [
  'AUTHENTICATION_READY',
  'WELCOME_OPERATOR',
  'ACCESS_GRANTED',
  'SYSTEM_STANDBY'
];
let pIdx = 0, cIdx = 0, deleting = false;
const tw = document.getElementById('typewriter');
function typeLoop(){
  const phrase = phrases[pIdx];
  if(!deleting){
    cIdx++;
    tw.innerHTML = '<span class="accent">></span> ' +
      phrase.substring(0, cIdx) + '<span class="cursor"></span>';
    if(cIdx === phrase.length){
      deleting = true;
      setTimeout(typeLoop, 2000);
      return;
    }
    setTimeout(typeLoop, 80);
  } else {
    cIdx--;
    tw.innerHTML = '<span class="accent">></span> ' +
      phrase.substring(0, cIdx) + '<span class="cursor"></span>';
    if(cIdx === 0){
      deleting = false;
      pIdx = (pIdx + 1) % phrases.length;
      setTimeout(typeLoop, 400);
      return;
    }
    setTimeout(typeLoop, 40);
  }
}
typeLoop();

/* ============ TAB SWITCHING ============ */
document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.form-view').forEach(v => v.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('view-' + tab.dataset.tab).classList.add('active');

    // Update header
    const title = document.getElementById('formTitle');
    const sub = document.getElementById('formSubtitle');
    if(tab.dataset.tab === 'user'){
      title.textContent = 'Sign In';
      sub.textContent = 'Enter your credentials to access the system';
    } else {
      title.textContent = 'Admin Access';
      sub.textContent = 'Restricted — authorized personnel only';
    }
  });
});

/* ============ HELPERS ============ */
function showAlert(id, msg, type) {
  const el = document.getElementById(id);
  el.className = 'alert show ' + (type || 'error');
  el.querySelector('span').textContent = msg;
}
function hideAlert(id) {
  document.getElementById(id).className = 'alert error';
}
function setLoading(btnId, isLoading) {
  const btn = document.getElementById(btnId);
  btn.disabled = isLoading;
  btn.classList.toggle('loading', isLoading);
}
function openUrl(url) { window.open(url, '_blank'); }
function toggleQuick(){
  document.getElementById('quickLinks').classList.toggle('open');
}
function togglePw(id, btn){
  const inp = document.getElementById(id);
  if(inp.type === 'password'){
    inp.type = 'text';
    btn.innerHTML = '<i class="fa-solid fa-eye-slash"></i>';
  } else {
    inp.type = 'password';
    btn.innerHTML = '<i class="fa-solid fa-eye"></i>';
  }
}

/* ============ AJAX LOGIN ============ */
async function submitLogin(url, formEl, btnId, alertId) {
  hideAlert(alertId);
  setLoading(btnId, true);
  try {
    const fd = new FormData(formEl);
    const res = await fetch(url, {
      method: 'POST',
      body: fd,
      credentials: 'same-origin',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });
    const ct = res.headers.get('content-type') || '';
    if (ct.includes('application/json')) {
      const data = await res.json();
      if (data.status === 'success') {
        showAlert(alertId, 'ACCESS GRANTED — redirecting...', 'success');
        setTimeout(() => {
          window.location.href = data.redirectUrl || (CTX + '/userhomescreen.action');
        }, 500);
      } else {
        showAlert(alertId, data.message || 'ACCESS DENIED', 'error');
      }
    } else {
      formEl.action = url;
      formEl.submit();
    }
  } catch (err) {
    console.error(err);
    showAlert(alertId, 'CONNECTION ERROR — retry', 'error');
  } finally {
    setLoading(btnId, false);
  }
}

/* ============ USER LOGIN ============ */
function usersign() {
  const form = document.getElementById('loginForm');
  const u = document.getElementById('m_strUserName').value.trim();
  const p = document.getElementById('m_struserPassword').value;
  const r = document.getElementById('m_strRole').value;
  if (!u) { showAlert('userAlert', 'USERNAME required'); return; }
  if (!p) { showAlert('userAlert', 'PASSWORD required'); return; }
  if (!r || r === 'choose_role') { showAlert('userAlert', 'SELECT a role'); return; }
  localStorage.clear();
  sessionStorage.clear();
  submitLogin(CTX + '/login!usersign.action', form, 'btnUserLogin', 'userAlert');
}

/* ============ ADMIN LOGIN ============ */
function adminsign() {
  const form = document.getElementById('loginForm');
  const u = document.getElementById('m_stradminUserName').value.trim();
  const p = document.getElementById('m_stradminPassword').value;
  if (!u) { showAlert('adminAlert', 'ADMIN_ID required'); return; }
  if (!p) { showAlert('adminAlert', 'ADMIN_KEY required'); return; }
  submitLogin(CTX + '/login!adminsign.action', form, 'btnAdminLogin', 'adminAlert');
}

/* ============ KEYBOARD SHORTCUTS ============ */
document.addEventListener('keydown', e => {
  if (e.key === 'Enter'){
    e.preventDefault();
    const active = document.querySelector('.tab.active').dataset.tab;
    active === 'user' ? usersign() : adminsign();
  }
  if (e.key === 'Escape'){
    document.querySelectorAll('input').forEach(i => i.value = '');
  }
});
</script>

</body>
</html>

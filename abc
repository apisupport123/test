<struts>

    <!-- ================= GLOBAL SETTINGS ================= -->
    <constant name="struts.devMode" value="false" />
    <constant name="struts.enable.DynamicMethodInvocation" value="true" />
    <constant name="struts.action.extension" value="action,," />
    <constant name="struts.i18n.encoding" value="UTF-8" />

    <!-- JSON plugin config -->
    <constant name="struts.json.contentType" value="application/json" />

    <!-- File upload (agar chahiye) -->
    <constant name="struts.multipart.maxSize" value="10485760" />

    <!-- ================= PACKAGES ================= -->
    <package name="default" namespace="/" extends="struts-default,json-default">

        <!-- ============ LOGIN ACTION ============ -->
        <action name="login" class="com.action.LoginAction">

            <!-- Default: load login.jsp with roles -->
            <result name="success">/jsp/login.jsp</result>

            <!-- ✅ AJAX JSON: user login success -->
            <result name="jsonsuccess" type="json">
                <param name="root">jsonData</param>
                <param name="contentType">application/json</param>
                <param name="ignoreHierarchy">false</param>
                <param name="excludeNullProperties">true</param>
            </result>

            <!-- ✅ AJAX JSON: user login error -->
            <result name="jsonerror" type="json">
                <param name="root">jsonData</param>
                <param name="contentType">application/json</param>
                <param name="ignoreHierarchy">false</param>
                <param name="excludeNullProperties">true</param>
            </result>

            <!-- Purane JSP forwards (agar kahin use ho rahe ho) -->
            <result name="successbanker" type="redirectAction">
                <param name="actionName">bankerHome</param>
                <param name="namespace">/</param>
            </result>
            <result name="successuser" type="redirectAction">
                <param name="actionName">userhomescreen</param>
                <param name="namespace">/</param>
            </result>
            <result name="successadmin" type="redirectAction">
                <param name="actionName">adminHome</param>
                <param name="namespace">/</param>
            </result>
            <result name="successmodule" type="redirectAction">
                <param name="actionName">moduleHome</param>
                <param name="namespace">/</param>
            </result>

            <!-- Validation error case -->
            <result name="input">/jsp/login.jsp</result>
        </action>


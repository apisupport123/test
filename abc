<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%
 // ✅ Session check
 if(session == null || session.getAttribute("role") == null) {
     response.sendRedirect(request.getContextPath() + "/login.action");
     return;
 }
 // ✅ Cache headers
 response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate, max-age=0, private");
 response.setHeader("Pragma", "no-cache");
 response.setDateHeader("Expires", 0);
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Deployment Sheet Master</title>

<!-- DataTables CSS -->
<link rel="stylesheet" href="<%=request.getContextPath()%>/css/Deployment.jquery.dataTables.min.css" />
<link rel="stylesheet" href="<%=request.getContextPath()%>/css/Deployment.buttons.dataTables.min.css" />

<!-- Scripts -->
<script src="<%=request.getContextPath()%>/js/Deployment.jquery-3.7.0.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.1.13.6.jquery.dataTables.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.2.4.1.dataTables.buttons.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.2.4.1.buttons.html5.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.2.4.1.buttons.print.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.3.10.1.jszip.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.0.2.7.pdfmake.min.js"></script>
<script src="<%=request.getContextPath()%>/js/Deployment.0.2.7.vfs_fonts.js"></script>

<style>
/* ============================================================
   BASE — theme-aware
   ============================================================ */
body {
    font-family: var(--font-stack, 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    background: var(--bg) !important;
    color: var(--ink) !important;
    margin: 0 !important;
    padding: 0 !important;
    font-weight: 700;
}

.page-container {
    padding: 24px 28px 60px;
    max-width: 100%;
    width: 100%;
}

/* ============================================================
   PAGE HEADER
   ============================================================ */
.page-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 22px;
    flex-wrap: wrap;
}
.page-head .ttl {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -0.5px;
    color: var(--ink);
    line-height: 1.2;
    margin: 0;
}
.page-head .ttl .ttl-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    background: var(--brand-light);
    color: var(--brand);
    border-radius: 12px;
    font-size: 1rem;
    flex-shrink: 0;
}
html[data-theme="dark"] .page-head .ttl .ttl-icon {
    background: rgba(248,111,3,.15);
}
.page-head .sub {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 4px 0 0 54px;
    font-weight: 600;
}

/* ============================================================
   ACTION BAR
   ============================================================ */
.table-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding: 16px 20px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    flex-wrap: wrap;
    box-shadow: 0 2px 8px rgba(0,0,0,.03);
}

.table-actions form {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

#fileInput {
    padding: 8px 14px;
    background: var(--bg);
    border: 1.5px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all .2s ease;
    max-width: 260px;
}
#fileInput:hover { border-color: var(--brand); }
#fileInput::file-selector-button {
    padding: 6px 14px;
    border-radius: 8px;
    background: var(--brand-light);
    color: var(--brand);
    border: none;
    font-family: inherit;
    font-weight: 800;
    font-size: 0.78rem;
    cursor: pointer;
    margin-right: 10px;
    transition: all .2s ease;
}
#fileInput::file-selector-button:hover {
    background: var(--brand);
    color: #fff;
}
html[data-theme="dark"] #fileInput::file-selector-button {
    background: rgba(248,111,3,.15);
}

/* ============================================================
   BUTTONS
   ============================================================ */
.custom-btn,
.dt-buttons button {
    padding: 10px 18px;
    border-radius: 10px;
    border: 1.5px solid var(--line);
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
    font-family: inherit;
    font-weight: 800;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    transition: all .2s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}
.custom-btn:hover,
.dt-buttons button:hover {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px -6px var(--brand);
}
.custom-btn.primary {
    background: linear-gradient(135deg, var(--brand), var(--brand-2, #FF9A3D));
    color: #fff;
    border: none;
    box-shadow: 0 6px 18px -6px var(--brand);
}
.custom-btn.primary:hover {
    box-shadow: 0 10px 24px -6px var(--brand);
}
.custom-btn.push-btn {
    background: linear-gradient(135deg, #10B981, #059669);
    color: #fff;
    border: none;
    box-shadow: 0 6px 18px -6px #10B981;
}
.custom-btn.push-btn:hover {
    box-shadow: 0 10px 24px -6px #10B981;
}

/* ============================================================
   TABLE CARD
   ============================================================ */
.table-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 20px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,.03);
}
html[data-theme="dark"] .table-card {
    box-shadow: 0 4px 20px rgba(0,0,0,.3);
}

.dataTables_wrapper {
    width: 100%;
    overflow-x: auto;
    color: var(--ink);
}

/* Top controls — length, filter */
.dataTables_wrapper .dataTables_length,
.dataTables_wrapper .dataTables_filter {
    margin-bottom: 14px;
    color: var(--muted);
    font-weight: 700;
    font-size: 0.82rem;
}
.dataTables_wrapper .dataTables_filter input {
    padding: 8px 14px;
    background: var(--bg);
    border: 1.5px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    outline: none;
    transition: all .2s ease;
    margin-left: 8px;
}
.dataTables_wrapper .dataTables_filter input:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 4px var(--brand-light);
}
html[data-theme="dark"] .dataTables_wrapper .dataTables_filter input:focus {
    box-shadow: 0 0 0 4px rgba(248,111,3,.15);
}
.dataTables_wrapper .dataTables_length select {
    padding: 6px 10px;
    background: var(--bg);
    border: 1.5px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    font-family: inherit;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    outline: none;
    margin: 0 6px;
}

/* Buttons row */
.dt-buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
}
.dt-buttons button {
    padding: 9px 16px;
    font-size: 0.78rem;
}

/* Table */
table.dataTable {
    width: 100% !important;
    border-collapse: collapse !important;
    color: var(--ink) !important;
    font-size: 0.85rem;
}
table.dataTable thead th {
    background: var(--bg) !important;
    color: var(--muted) !important;
    font-weight: 800 !important;
    font-size: 0.72rem !important;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1.5px solid var(--line) !important;
    padding: 12px 14px !important;
    white-space: nowrap;
}
table.dataTable tbody tr {
    background: var(--card) !important;
    border-bottom: 1px solid var(--line) !important;
    transition: background .15s ease;
}
table.dataTable tbody tr:hover {
    background: var(--bg) !important;
}
html[data-theme="dark"] table.dataTable tbody tr:hover {
    background: rgba(255,255,255,.03) !important;
}
table.dataTable tbody td {
    padding: 11px 14px !important;
    vertical-align: middle;
    color: var(--ink) !important;
    border-bottom: 1px solid var(--line);
    font-weight: 700;
    white-space: nowrap;
}
table.dataTable tbody tr:last-child td {
    border-bottom: none;
}
table.dataTable.no-footer {
    border-bottom: none !important;
}

/* Sorting icons */
table.dataTable thead .sorting:before,
table.dataTable thead .sorting:after,
table.dataTable thead .sorting_asc:before,
table.dataTable thead .sorting_asc:after,
table.dataTable thead .sorting_desc:before,
table.dataTable thead .sorting_desc:after {
    opacity: 0.35;
}

/* Pagination */
.dataTables_wrapper .dataTables_paginate {
    margin-top: 16px;
    padding: 4px 0;
}
.dataTables_wrapper .dataTables_paginate .paginate_button {
    padding: 8px 14px !important;
    margin: 0 3px !important;
    border-radius: 8px !important;
    background: var(--card) !important;
    border: 1.5px solid var(--line) !important;
    color: var(--ink) !important;
    font-weight: 800 !important;
    font-size: 0.78rem !important;
    cursor: pointer;
    transition: all .15s ease;
    text-decoration: none !important;
}
.dataTables_wrapper .dataTables_paginate .paginate_button:hover {
    background: var(--brand) !important;
    border-color: var(--brand) !important;
    color: #fff !important;
}
.dataTables_wrapper .dataTables_paginate .paginate_button.current,
.dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
    background: linear-gradient(135deg, var(--brand), var(--brand-2, #FF9A3D)) !important;
    border-color: var(--brand) !important;
    color: #fff !important;
    box-shadow: 0 4px 12px -3px var(--brand);
}
.dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
.dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
    opacity: 0.4 !important;
    cursor: not-allowed !important;
    background: var(--card) !important;
    color: var(--muted) !important;
}

/* Info text */
.dataTables_wrapper .dataTables_info {
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 700;
}

/* ============================================================
   PUSH BUTTON ROW
   ============================================================ */
.push-row {
    margin-top: 24px;
    text-align: center;
}
.push-row .custom-btn {
    padding: 14px 28px;
    font-size: 0.85rem;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 900px) {
    .page-container { padding: 16px 14px 40px; }
    .page-head .ttl { font-size: 1.2rem; }
    .page-head .ttl .ttl-icon { width: 36px; height: 36px; font-size: 0.9rem; }
    .page-head .sub { margin-left: 48px; font-size: 0.78rem; }
    .table-actions { flex-direction: column; align-items: stretch; }
    .table-actions form { width: 100%; }
    #fileInput { max-width: 100%; flex: 1; }
    .dt-buttons { flex-direction: column; }
    .dt-buttons button { width: 100%; justify-content: center; }
}
</style>
</head>
<body>

<%@include file="../userheader.jsp"%>

<div class="new-wrapper">
<div class="page-container">

    <!-- ============ PAGE HEADER ============ -->
    <div class="page-head">
        <div>
            <h1 class="ttl">
                <span class="ttl-icon"><i class="fas fa-rocket"></i></span>
                Deployment Sheet Master
            </h1>
            <p class="sub">Upload, review, and push deployment records to the main table</p>
        </div>
    </div>

    <!-- ============ ACTION BAR ============ -->
    <div class="table-actions">
        <form id="uploadForm" enctype="multipart/form-data" method="post">
            <input type="file" id="fileInput" name="file" accept=".xlsx,.xls,.csv" />
            <button type="button" class="custom-btn primary" id="submitFileBtn">
                <i class="fas fa-upload"></i> Submit
            </button>
            <a href="<%=request.getContextPath()%>/XMLFile/Deployment_Sample_Format.xlsx" class="custom-btn" download>
                <i class="fas fa-download"></i> Sample Format
            </a>
        </form>
    </div>

    <!-- ============ TABLE ============ -->
    <div class="table-card">
        <table id="deploymentTable" class="display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>EXP URL</th>
                    <th>EXP URL W.R.T SYS URL</th>
                    <th>API_NAME</th>
                    <th>SOURCE_ID</th>
                    <th>Broker</th>
                    <th>Broker EG</th>
                    <th>New/Existing/NBC</th>
                    <th>Hits in Production</th>
                    <th>Failure (More than 50%)</th>
                    <th>Success</th>
                    <th>Changes Description</th>
                    <th>Remarks</th>
                    <th>Deployment Date Time</th>
                </tr>
            </thead>
            <tbody>
                <c:forEach var="row" items="${deploymentData}">
                    <tr>
                        <td>${row.EXP_URL}</td>
                        <td>${row.SYS_URL}</td>
                        <td>${row.API_NAME}</td>
                        <td>${row.SOURCE_ID}</td>
                        <td>${row.BROKER}</td>
                        <td>${row.BROKER_EG}</td>
                        <td>${row.STATUS}</td>
                        <td>${row.HITS}</td>
                        <td>${row.FAILURE}</td>
                        <td>${row.SUCCESS}</td>
                        <td>${row.CHANGES_DESC}</td>
                        <td>${row.REMARKS}</td>
                        <td>${row.DEPLOYMENT_DATE}</td>
                    </tr>
                </c:forEach>
            </tbody>
        </table>
    </div>

    <!-- ============ PUSH BUTTON ============ -->
    <div class="push-row">
        <button type="button" class="custom-btn push-btn" id="pushDataBtn">
            <i class="fas fa-cloud-upload-alt"></i> Push Data to Main Table
        </button>
    </div>

</div>
</div>

<script>
$(document).ready(function () {

    // ✅ DataTables init
    const table = $('#deploymentTable').DataTable({
        dom: 'Bfrtip',
        paging: true,
        scrollX: true,
        responsive: false,
        pageLength: 15,
        searching: true,
        ordering: true,
        order: [],
        lengthChange: true,
        buttons: [
            {
                extend: 'excelHtml5',
                text: '<i class="fas fa-file-excel"></i> Export Excel',
                exportOptions: { columns: ':visible' }
            },
            {
                extend: 'pdfHtml5',
                text: '<i class="fas fa-file-pdf"></i> Export PDF',
                exportOptions: { columns: ':visible' },
                orientation: 'landscape',
                pageSize: 'A4'
            },
            {
                extend: 'print',
                text: '<i class="fas fa-print"></i> Print',
                exportOptions: { columns: ':visible' }
            }
        ]
    });

    // ✅ Choose file
    $('#chooseFileBtn').on('click', function () {
        $('#fileInput').click();
    });

    // ✅ Submit file (upload)
    $('#submitFileBtn').on('click', function () {
        const file = $('#fileInput')[0].files[0];
        if (!file) {
            alert("Please choose a file first!");
            return;
        }
        const formData = new FormData();
        formData.append("file", file);
        formData.append("action", "upload");

        $.ajax({
            url: '<%=request.getContextPath()%>/DeploymentSheetServlet',
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                alert(res);
                window.location.href = '<%=request.getContextPath()%>/DeploymentSheetServlet';
            },
            error: function () {
                alert("Error occurred while uploading file!");
            }
        });
    });

    // ✅ Push data to main table
    $('#pushDataBtn').on('click', function () {
        if (!confirm("Are you sure you want to push data to main table?")) {
            return;
        }
        $.ajax({
            url: '<%=request.getContextPath()%>/DeploymentSheetServlet',
            type: "POST",
            data: { action: "push" },
            success: function (res) {
                alert(res);
                window.location.href = '<%=request.getContextPath()%>/DeploymentSheetServlet';
            },
            error: function () {
                alert("Error occurred while pushing data!");
            }
        });
    });

    // ✅ Sample format download (fallback)
    $('#sampleFormatBtn').on('click', function () {
        window.location.href = '<%=request.getContextPath()%>/XMLFile/Deployment_Sample_Format.xlsx';
    });
});
</script>

</body>
</html>

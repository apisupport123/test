<%!
// ── Partition helper: NOV_26 format ──
String getPartition(java.util.Date fromDate) {
    Calendar cal = Calendar.getInstance();
    cal.setTime(fromDate);
    String[] months = {"JAN","FEB","MAR","APR","MAY","JUN",
                       "JUL","AUG","SEP","OCT","NOV","DEC"};
    String month = months[cal.get(Calendar.MONTH)];
    String year = String.valueOf(cal.get(Calendar.YEAR)).substring(2);
    return month + "_" + year;
}

// ── Resolve partition from fromTime param (or now - 10min) ──
String resolvePartition(String fromTime) {
    java.util.Date base;
    try {
        if (fromTime != null && !fromTime.isEmpty()) {
            String normalized = fromTime.replace("T", " ");
            SimpleDateFormat in = new SimpleDateFormat("yyyy-MM-dd HH:mm");
            base = in.parse(normalized);
        } else {
            base = new java.util.Date(System.currentTimeMillis() - 10*60*1000);
        }
    } catch (Exception e) {
        base = new java.util.Date(System.currentTimeMillis() - 10*60*1000);
    }
    return getPartition(base);
}

// ── Ensure master table ──
void ensureTableExists(Connection conn) throws SQLException {
    Statement stmt = null;
    try {
        stmt = conn.createStatement();
        stmt.executeUpdate(
            "CREATE TABLE DPG_IP_MASTER (" +
            "    DPG_IP        VARCHAR2(50) PRIMARY KEY," +
            "    DPG_MODE      VARCHAR2(10)," +
            "    LAST_UPDATED  DATE" +
            ")"
        );
    } catch (SQLException e) {
        if (e.getErrorCode() != 955) throw e;
    } finally {
        if (stmt != null) try { stmt.close(); } catch (SQLException e) {}
    }
    try {
        stmt = conn.createStatement();
        stmt.executeUpdate("CREATE INDEX IDX_DPG_MASTER_MODE ON DPG_IP_MASTER(DPG_MODE)");
    } catch (SQLException e) {
        if (e.getErrorCode() != 955) throw e;
    } finally {
        if (stmt != null) try { stmt.close(); } catch (SQLException e) {}
    }
}

// ── Refresh master table (uses previous-day partition for API_LOG) ──
void refreshMasterTable(Connection connReport, Connection connIIB) throws SQLException {
    List<String> ipList = new ArrayList<>();
    Statement stmtIIB = null;
    ResultSet rsIIB = null;

    // Partition for yesterday (since master refresh looks at previous day's traffic)
    java.util.Date yesterday = new java.util.Date(System.currentTimeMillis() - 24*60*60*1000);
    String apiPartition = getPartition(yesterday);

    try {
        stmtIIB = connIIB.createStatement();
        String queryIIB =
            "SELECT /*+ PARALLEL(4) */ DISTINCT TRIM(DPG_IP) AS IP " +
            "FROM EISAPP.API_LOG PARTITION (" + apiPartition + ") " +
            "WHERE (TRIM(DPG_IP) LIKE '10.191.171.2%' OR TRIM(DPG_IP) LIKE '10.176.0.1%') " +
            "AND request_date_time >= TRUNC(SYSDATE) - 1 " +
            "AND request_date_time < TRUNC(SYSDATE)";
        System.out.println("===== Master refresh API_LOG query =====");
        System.out.println(queryIIB);
        System.out.println("=======================================");
        rsIIB = stmtIIB.executeQuery(queryIIB);
        while (rsIIB.next()) ipList.add(rsIIB.getString("IP"));
    } finally {
        if (rsIIB != null) try { rsIIB.close(); } catch (SQLException e) {}
        if (stmtIIB != null) try { stmtIIB.close(); } catch (SQLException e) {}
    }

    Statement stmtDel = connReport.createStatement();
    stmtDel.executeUpdate("DELETE FROM DPG_IP_MASTER");
    stmtDel.close();

    if (!ipList.isEmpty()) {
        PreparedStatement pstmtIns = connReport.prepareStatement(
            "INSERT INTO DPG_IP_MASTER (DPG_IP, DPG_MODE, LAST_UPDATED) VALUES (?, ?, SYSDATE)");
        for (String ip : ipList) {
            pstmtIns.setString(1, ip);
            pstmtIns.setString(2, ip.contains("171.") ? "PR" : "DR");
            pstmtIns.addBatch();
        }
        pstmtIns.executeBatch();
        pstmtIns.close();
    }
}

// ── Build time condition (SAME for API_LOG & BACKEND_LOG) ──
String buildTimeCondition(String fromTime, String toTime) {
    if (fromTime != null && toTime != null && !fromTime.isEmpty() && !toTime.isEmpty()) {
        String fromDate = fromTime.replace("T", " ").replace("-", "/");
        String toDate = toTime.replace("T", " ").replace("-", "/");
        return "AND REQUEST_DATE_TIME BETWEEN TO_DATE('" + fromDate + "', 'YYYY/MM/DD HH24:MI') " +
               "AND TO_DATE('" + toDate + "', 'YYYY/MM/DD HH24:MI') ";
    }
    return "AND REQUEST_DATE_TIME >= SYSDATE - INTERVAL '10' MINUTE ";
}

// ── DPG Outbound hits (BACKEND_LOG, port 7443) — with dynamic partition ──
int getDpgOutboundHits(String fromTime, String toTime) throws SQLException {
    Connection conn = null;
    PreparedStatement pstmt = null;
    ResultSet rs = null;
    int hits = 0;
    try {
        conn = DBUtilityAuto.getIIBDBConnection();
        String partition = resolvePartition(fromTime);
        String query =
            "SELECT /*+ PARALLEL(4) */ COUNT(*) AS TOTAL_HITS " +
            "FROM EISAPP.BACKEND_LOG PARTITION (" + partition + ") " +
            "WHERE END_POINT_PORT = '7443' " +
            buildTimeCondition(fromTime, toTime);

        System.out.println("===== DPG Outbound hit count query =====");
        System.out.println(query);
        System.out.println("========================================");

        pstmt = conn.prepareStatement(query);
        rs = pstmt.executeQuery();
        if (rs.next()) hits = rs.getInt("TOTAL_HITS");
    } finally {
        try { if (rs != null) rs.close(); } catch (Exception e) {}
        try { if (pstmt != null) pstmt.close(); } catch (Exception e) {}
        try { if (conn != null) conn.close(); } catch (Exception e) {}
    }
    return hits;
}

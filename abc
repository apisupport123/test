    </a>
    <a class="tn-btn" href="<%=ctx%>/login.action" title="Logout" onclick="event.preventDefault(); bankLogout();">
      <svg class="icon-svg" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
    </a>
    <div class="tn-avatar" title="<%=m_strrole%>">
      <%= (m_strrole != null && m_strrole.length() > 0) ? m_strrole.substring(0,1).toUpperCase() : "B" %>
    </div>
  </div>
</header>

<script>
/* ============================================================
   ✅ BANK LOGOUT — session invalidate + login pe redirect
   ============================================================ */
function bankLogout(){
  window.__logoutInProgress = true;

  try{
    sessionStorage.clear();
    localStorage.removeItem('eis-sidebar-closed');
  }catch(e){}

  // ✅ logout=true parameter — server side session invalidate hoga
  window.location.replace('<%=ctx%>/login.action?logout=true');
}

/* ============================================================
   ✅ BACK BUTTON BLOCK — with logout exception
   ============================================================ */
(function(){
  window.history.pushState({ page: 'bank-home' }, '', window.location.href);
  window.addEventListener('popstate', function(e){
    if(window.__logoutInProgress === true) return;
    window.history.pushState({ page: 'bank-home' }, '', window.location.href);
  });
})();

/* ============================================================
   ✅ THEME TOGGLE
   ============================================================ */
function toggleTheme(){
  var cur = document.documentElement.getAttribute('data-theme') || 'dark';
  var next = cur === 'light' ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', next);
  try{ localStorage.setItem('eis-theme', next); }catch(e){}
  updateThemeIcon();
}
function updateThemeIcon(){
  var t = document.documentElement.getAttribute('data-theme') || 'dark';
  var sun = document.getElementById('themeIconSun');
  var moon = document.getElementById('themeIconMoon');
  if(!sun || !moon) return;
  if(t === 'dark'){
    sun.style.display = 'block';
    moon.style.display = 'none';
  } else {
    sun.style.display = 'none';
    moon.style.display = 'block';
  }
}
document.addEventListener('DOMContentLoaded', updateThemeIcon);
updateThemeIcon();

/* ============================================================
   ✅ SIDEBAR TOGGLE
   ============================================================ */
function toggleSidebar(){
  var root = document.documentElement;
  if(window.innerWidth <= 900){
    root.classList.toggle('sb-open');
  } else {
    root.classList.toggle('sb-collapsed');
    try{
      localStorage.setItem('eis-sidebar-closed', root.classList.contains('sb-collapsed'));
    }catch(e){}
  }
}

/* ============================================================
   ✅ SIDEBAR SEARCH
   ============================================================ */
function search_animal() {
  var input = document.getElementById('searchbar').value.toLowerCase();
  var x = document.getElementsByClassName('animals');
  var groups = document.querySelectorAll('.sb-group');
  for (var i = 0; i < x.length; i++) {
    if (!x[i].innerText.toLowerCase().includes(input)) {
      x[i].style.display = "none";
    } else {
      x[i].style.display = "flex";
    }
  }
  groups.forEach(function(g){
    var next = g.nextElementSibling;
    var hasVisible = false;
    while(next && !next.classList.contains('sb-group')){
      if(next.classList.contains('animals') && next.style.display !== 'none'){ hasVisible = true; break; }
      next = next.nextElementSibling;
    }
    g.style.display = (hasVisible || input === '') ? 'block' : 'none';
  });
}
function focusSidebarSearch(){
  if(window.innerWidth <= 900){
    document.documentElement.classList.add('sb-open');
  } else if(document.documentElement.classList.contains('sb-collapsed')){
    document.documentElement.classList.remove('sb-collapsed');
    try{ localStorage.setItem('eis-sidebar-closed', 'false'); }catch(e){}
  }
  setTimeout(function(){ document.getElementById('searchbar').focus(); }, 150);
}
document.addEventListener('keydown', function(e){
  if((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k'){
    e.preventDefault();
    focusSidebarSearch();
  }
});
</script>

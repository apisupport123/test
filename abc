<style>
/* ============================================================
   THEME VARIABLES
   ============================================================ */
:root, [data-theme="light"] {
    --brand: #F86F03;
    --brand-2: #FFA41B;
    --brand-light: #FFF4EC;

    --ink: #0f172a;
    --muted: #64748b;
    --line: #e2e8f0;

    --bg: transparent;
    --card: #ffffff;
    --elevated: #f8fafc;
    --hover: #f1f5f9;

    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
}
[data-theme="dark"] {
    --brand: #FF9A3D;
    --brand-2: #FFA41B;
    --brand-light: rgba(248, 111, 3, 0.15);

    --ink: #f1f5f9;
    --muted: #94a3b8;
    --line: #334155;

    --bg: transparent;
    --card: #1e293b;
    --elevated: #293548;
    --hover: #334155;

    --success: #34d399;
    --warning: #fbbf24;
    --danger: #f87171;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.5;
    font-size: 15px;
    overflow-x: hidden;
    width: 100%;
}

/* ============================================================
   PAGE WRAPPER
   ============================================================ */
.deploy-content {
    padding: 24px 28px 48px;
    max-width: 1600px;
    margin: 0 auto;
    width: 100%;
}

/* ============================================================
   PAGE HEADER
   ============================================================ */
.page-header {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 22px 26px;
    margin-bottom: 20px;
    box-shadow: 0 2px 12px rgba(0,0,0,.04);
    position: relative;
    overflow: hidden;
}
.page-header::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--brand) 0%, var(--brand-2) 100%);
}
.page-header h1 {
    font-size: 1.65rem;
    font-weight: 800;
    letter-spacing: -.6px;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 12px;
}
.page-header h1 i {
    width: 40px; height: 40px;
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    color: #fff;
    display: grid; place-items: center;
    border-radius: 11px;
    font-size: 1rem;
    box-shadow: 0 6px 16px -6px var(--brand);
}
.page-header p {
    color: var(--muted);
    font-size: .88rem;
    font-weight: 600;
    margin-top: 6px;
    margin-left: 52px;
}

/* ============================================================
   QUICK ACTIONS
   ============================================================ */
.quick-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
}
.quick-actions button {
    padding: 11px 20px;
    border: 1.5px solid var(--line);
    background: var(--card);
    color: var(--ink);
    font-weight: 700;
    font-size: .85rem;
    border-radius: 11px;
    cursor: pointer;
    transition: all .2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: inherit;
}
.quick-actions button:hover {
    border-color: var(--brand);
    color: var(--brand);
    background: var(--brand-light);
    transform: translateY(-1px);
}
.quick-actions button.primary {
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    color: #fff;
    border-color: transparent;
    box-shadow: 0 4px 14px -4px var(--brand);
}
.quick-actions button.primary:hover {
    background: var(--brand);
    color: #fff;
    transform: translateY(-2px);
}

/* ============================================================
   FORM CARD
   ============================================================ */
.form-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 24px;
    margin-bottom: 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,.04);
}
.form-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    align-items: end;
}
.form-grid .field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
}
.form-grid .field.full {
    grid-column: span 2;
}
.form-grid label {
    font-size: .78rem;
    font-weight: 800;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: .6px;
}

/* ============================================================
   INPUT / TEXTAREA / SELECT — BASE
   ============================================================ */
.form-grid .form-control,
.form-grid select,
.form-grid input[type="text"],
.form-grid input[type="date"],
.form-grid input[type="time"],
.form-grid textarea {
    width: 100%;
    padding: 12px 14px;
    background: var(--elevated);
    border: 1.5px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    font-family: inherit;
    font-size: .9rem;
    font-weight: 600;
    outline: none;
    transition: all .2s ease;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
}

.form-grid .form-control:focus,
.form-grid select:focus,
.form-grid input:focus,
.form-grid textarea:focus {
    border-color: var(--brand);
    background: var(--card);
    box-shadow: 0 0 0 4px var(--brand-light);
}

.form-grid textarea {
    resize: vertical;
    min-height: 44px;
    padding: 12px 14px;
}

/* ============================================================
   ✅ SELECT (DROPDOWN) — FULLY FIXED
   ============================================================ */
.form-grid select {
    cursor: pointer;
    padding-right: 40px;
    background-color: var(--elevated);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%23F86F03' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat: no-repeat;
    background-position: right 14px center;
    background-size: 14px 14px;
    color: var(--ink);
    font-weight: 700;
    line-height: 1.4;
}

/* ✅ Dropdown options — LIGHT theme */
.form-grid select option {
    background-color: #ffffff;
    color: #0f172a;
    padding: 12px 14px;
    font-weight: 600;
    font-size: .9rem;
    line-height: 1.5;
}

/* ✅ Dropdown options — DARK theme */
html[data-theme="dark"] .form-grid select option {
    background-color: #1e293b;
    color: #f1f5f9;
}

/* ✅ Selected option highlight */
.form-grid select option:checked {
    background: linear-gradient(135deg, #F86F03, #FFA41B) !important;
    color: #ffffff !important;
    font-weight: 800;
}

/* ✅ Disabled option */
.form-grid select option[disabled] {
    color: #94a3b8 !important;
    font-style: italic;
}

/* ✅ Firefox specific fix */
@-moz-document url-prefix() {
    .form-grid select {
        color: var(--ink);
        background-color: var(--elevated);
    }
    .form-grid select option {
        background-color: var(--card);
        color: var(--ink);
    }
}

/* ✅ Safari / Chrome option hover (best-effort) */
.form-grid select option:hover {
    background-color: #F86F03 !important;
    color: #ffffff !important;
}

/* ============================================================
   CHECKBOX FIELD
   ============================================================ */
.form-grid .checkbox-field {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 12px 0;
}
.form-grid .checkbox-field input[type="checkbox"] {
    width: 18px; height: 18px;
    accent-color: var(--brand);
    cursor: pointer;
    -webkit-appearance: checkbox;
    appearance: checkbox;
}
.form-grid .checkbox-field label {
    text-transform: none;
    font-weight: 700;
    cursor: pointer;
    margin: 0;
}

/* ============================================================
   SUBMIT BUTTON
   ============================================================ */
.form-grid .submit-field {
    display: flex;
    justify-content: flex-end;
}
.form-grid .submit-field button {
    padding: 12px 32px;
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    color: #fff;
    border: none;
    border-radius: 11px;
    font-weight: 800;
    font-size: .88rem;
    cursor: pointer;
    transition: all .2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: inherit;
    box-shadow: 0 6px 18px -6px var(--brand);
    text-transform: uppercase;
    letter-spacing: .5px;
}
.form-grid .submit-field button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px -6px var(--brand);
}

/* ============================================================
   TABLE WRAPPER
   ============================================================ */
.table-wrapper {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 22px;
    box-shadow: 0 2px 12px rgba(0,0,0,.04);
    overflow-x: auto;
}
.table-wrapper h3 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 18px;
    letter-spacing: -.4px;
    display: flex;
    align-items: center;
    gap: 10px;
}
.table-wrapper h3 i {
    color: var(--brand);
}
.table-wrapper table.table {
    width: 100%;
    border-collapse: collapse;
    font-size: .85rem;
    margin: 0;
    color: var(--ink);
    min-width: 1200px;
}
.table-wrapper table.table th,
.table-wrapper table.table td {
    padding: 12px 14px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
    color: var(--ink);
    background: transparent;
    word-break: break-word;
}
.table-wrapper table.table thead th {
    background: var(--elevated);
    font-weight: 800;
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .6px;
    color: var(--muted);
    white-space: nowrap;
    border-bottom: 2px solid var(--line);
}
.table-wrapper table.table tbody tr {
    transition: background .15s ease;
}
.table-wrapper table.table tbody tr:hover {
    background: var(--hover);
}
.table-wrapper table.table tbody tr:nth-child(even) {
    background: transparent;
}
.table-wrapper table.table tbody td.pre-cell {
    font-family: 'Courier New', monospace;
    font-size: .8rem;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
}
.table-wrapper table.table tbody td.pre-cell:hover {
    color: var(--brand);
    text-decoration: underline;
}
.table-wrapper table.table tbody td pre {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-all;
    font-family: inherit;
    color: inherit;
    font-size: inherit;
    background: transparent;
    padding: 0;
    border: none;
}
.table-wrapper table.table tbody td pre svg {
    display: inline-block;
    vertical-align: middle;
    margin-left: 6px;
    width: 16px;
    height: 16px;
}

/* Action button in table */
.table-wrapper table.table tbody .action-btn {
    padding: 7px 16px;
    background: var(--brand);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: .78rem;
    cursor: pointer;
    transition: all .2s ease;
    text-transform: uppercase;
    letter-spacing: .4px;
    font-family: inherit;
    white-space: nowrap;
}
.table-wrapper table.table tbody .action-btn:hover {
    background: var(--brand-2);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px -4px var(--brand);
}

/* Checkbox row (hidden by default) */
.table-wrapper table.table tbody tr.checkbox-row {
    display: none;
    background: var(--brand-light);
}
.table-wrapper table.table tbody tr.checkbox-row td {
    padding: 20px;
    background: var(--brand-light);
}
.table-wrapper table.table tbody tr.checkbox-row form {
    display: flex;
    flex-direction: column;
    gap: 14px;
}
.table-wrapper table.table tbody tr.checkbox-row label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: .88rem;
    color: var(--ink);
    margin-right: 20px;
    cursor: pointer;
}
.table-wrapper table.table tbody tr.checkbox-row input[type="checkbox"] {
    width: 18px; height: 18px;
    accent-color: var(--brand);
    cursor: pointer;
}
.table-wrapper table.table tbody tr.checkbox-row input[type="submit"] {
    padding: 10px 22px;
    background: var(--brand);
    color: #fff;
    border: none;
    border-radius: 9px;
    font-weight: 700;
    font-size: .85rem;
    cursor: pointer;
    transition: all .2s ease;
    text-transform: uppercase;
    letter-spacing: .5px;
    font-family: inherit;
    align-self: flex-start;
    box-shadow: 0 4px 14px -4px var(--brand);
}
.table-wrapper table.table tbody tr.checkbox-row input[type="submit"]:hover {
    background: var(--brand-2);
    transform: translateY(-1px);
}

/* ============================================================
   TEXTAREA CONTAINER
   ============================================================ */
.textarea-container {
    display: none;
    margin-top: 6px;
    width: 100%;
}
.textarea-container textarea {
    width: 100%;
    padding: 12px 14px;
    background: var(--card);
    border: 1.5px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    font-family: inherit;
    font-size: .88rem;
    font-weight: 600;
    outline: none;
    min-height: 70px;
    resize: vertical;
    transition: all .2s ease;
}
.textarea-container textarea:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 4px var(--brand-light);
}
.textarea-container textarea::placeholder {
    color: var(--muted);
    opacity: .7;
}

/* ============================================================
   ERROR MESSAGE
   ============================================================ */
.error-message {
    padding: 12px 16px;
    background: rgba(239, 68, 68, 0.1);
    color: var(--danger);
    border-radius: 10px;
    font-size: .88rem;
    font-weight: 700;
    border: 1px solid rgba(239, 68, 68, 0.3);
    margin-bottom: 16px;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 1000px) {
    .form-grid { grid-template-columns: repeat(2, 1fr); }
    .form-grid .field.full { grid-column: span 2; }
    .table-wrapper { padding: 16px; }
}
@media (max-width: 700px) {
    .deploy-content { padding: 16px 14px 32px; }
    .page-header { padding: 18px 20px; }
    .page-header h1 { font-size: 1.3rem; }
    .page-header h1 i { width: 34px; height: 34px; font-size: .88rem; }
    .page-header p { margin-left: 46px; font-size: .8rem; }
    .form-card { padding: 18px; }
    .form-grid { grid-template-columns: 1fr; }
    .form-grid .field.full { grid-column: span 1; }
    .table-wrapper { padding: 12px; }
    .table-wrapper table.table { font-size: .78rem; }
}
</style>

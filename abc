<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Team Roster &mdash; EIS Portal</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

<style>
/* ============================================================
   DESIGN TOKENS
   ============================================================ */
:root{
  /* Neutral scale */
  --gray-0:#FFFFFF;
  --gray-25:#FCFCFD;
  --gray-50:#F9FAFB;
  --gray-100:#F2F4F7;
  --gray-200:#EAECF0;
  --gray-300:#D0D5DD;
  --gray-400:#98A2B3;
  --gray-500:#667085;
  --gray-600:#475467;
  --gray-700:#344054;
  --gray-800:#1D2939;
  --gray-900:#101828;

  /* Accent */
  --accent:#635BFF;              /* Stripe-like indigo */
  --accent-hover:#5249E0;
  --accent-soft:#EEF0FF;
  --accent-line:#C7CBFF;

  /* Semantic */
  --success:#12B76A;
  --success-soft:#ECFDF3;
  --warning:#F79009;
  --warning-soft:#FFFAEB;
  --danger:#F04438;
  --danger-soft:#FEF3F2;
  --info:#2E90FA;
  --info-soft:#EFF8FF;

  /* Shift palette — muted, professional */
  --shift-morning-bg:#FFF6ED;   --shift-morning-fg:#C4320A;   --shift-morning-bd:#F9DBAF;
  --shift-general-bg:#F2F4F7;   --shift-general-fg:#344054;   --shift-general-bd:#D0D5DD;
  --shift-afternoon-bg:#FFFAEB; --shift-afternoon-fg:#B54708; --shift-afternoon-bd:#FEDF89;
  --shift-night-bg:#EFF8FF;     --shift-night-fg:#175CD3;     --shift-night-bd:#B2DDFF;
  --shift-weekoff-bg:#EEF4FF;   --shift-weekoff-fg:#3538CD;   --shift-weekoff-bd:#C7D7FE;
  --shift-leave-bg:#FEF3F2;     --shift-leave-fg:#B42318;     --shift-leave-bd:#FECDCA;
  --shift-flexi-bg:#FDF2FA;     --shift-flexi-fg:#C11574;     --shift-flexi-bd:#FCCEEE;
  --shift-holiday-bg:#ECFDF3;   --shift-holiday-fg:#027A48;   --shift-holiday-bd:#A6F4C5;
  --shift-na-bg:#F9FAFB;        --shift-na-fg:#98A2B3;        --shift-na-bd:#EAECF0;

  --bg-page:var(--gray-50);
  --bg-surface:var(--gray-0);
  --bg-subtle:var(--gray-25);
  --border:var(--gray-200);
  --border-strong:var(--gray-300);
  --text-primary:var(--gray-900);
  --text-secondary:var(--gray-600);
  --text-tertiary:var(--gray-500);

  --radius-sm:6px;
  --radius-md:8px;
  --radius-lg:12px;
  --radius-xl:16px;

  --shadow-xs:0 1px 2px 0 rgba(16,24,40,.05);
  --shadow-sm:0 1px 3px 0 rgba(16,24,40,.10), 0 1px 2px -1px rgba(16,24,40,.06);
  --shadow-md:0 4px 8px -2px rgba(16,24,40,.10), 0 2px 4px -2px rgba(16,24,40,.06);
  --shadow-lg:0 12px 16px -4px rgba(16,24,40,.08), 0 4px 6px -2px rgba(16,24,40,.03);
  --shadow-xl:0 20px 24px -4px rgba(16,24,40,.08), 0 8px 8px -4px rgba(16,24,40,.03);

  --font:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
}

html[data-theme="dark"]{
  --gray-0:#0B0E14;
  --gray-25:#10131A;
  --gray-50:#12161D;
  --gray-100:#171B23;
  --gray-200:#22262F;
  --gray-300:#2E333C;
  --gray-400:#5A6270;
  --gray-500:#8A94A6;
  --gray-600:#A6B0C2;
  --gray-700:#C4CCDA;
  --gray-800:#E1E6EF;
  --gray-900:#F5F7FA;

  --accent:#8B83FF;
  --accent-hover:#A29AFF;
  --accent-soft:#1E1B4B;
  --accent-line:#3730A3;

  --success:#32D583;
  --success-soft:#052E1F;
  --warning:#FDB022;
  --warning-soft:#3D2A05;
  --danger:#F97066;
  --danger-soft:#3A1211;
  --info:#53B1FD;
  --info-soft:#0A2540;

  --shift-morning-bg:#3A1D0A;   --shift-morning-fg:#FDB022;   --shift-morning-bd:#5C2C0F;
  --shift-general-bg:#1A1E26;   --shift-general-fg:#A6B0C2;   --shift-general-bd:#2E333C;
  --shift-afternoon-bg:#3D2A05; --shift-afternoon-fg:#FDB022; --shift-afternoon-bd:#5C3F0F;
  --shift-night-bg:#0A2540;     --shift-night-fg:#53B1FD;     --shift-night-bd:#0F3A66;
  --shift-weekoff-bg:#1E1B4B;   --shift-weekoff-fg:#8B83FF;   --shift-weekoff-bd:#3730A3;
  --shift-leave-bg:#3A1211;     --shift-leave-fg:#F97066;     --shift-leave-bd:#5A1A18;
  --shift-flexi-bg:#3D1030;     --shift-flexi-fg:#F670C7;     --shift-flexi-bd:#5E1A4A;
  --shift-holiday-bg:#052E1F;   --shift-holiday-fg:#32D583;   --shift-holiday-bd:#0A5133;
  --shift-na-bg:#12161D;        --shift-na-fg:#5A6270;        --shift-na-bd:#22262F;

  --bg-page:var(--gray-50);
  --bg-surface:var(--gray-25);
  --bg-subtle:var(--gray-0);
  --border:var(--gray-200);
  --border-strong:var(--gray-300);
  --text-primary:var(--gray-900);
  --text-secondary:var(--gray-600);
  --text-tertiary:var(--gray-500);

  --shadow-xs:0 1px 2px 0 rgba(0,0,0,.4);
  --shadow-sm:0 1px 3px 0 rgba(0,0,0,.5);
  --shadow-md:0 4px 8px -2px rgba(0,0,0,.4);
  --shadow-lg:0 12px 16px -4px rgba(0,0,0,.5);
  --shadow-xl:0 20px 24px -4px rgba(0,0,0,.6);
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--font);
  font-size:14px;
  line-height:1.5;
  font-weight:400;
  background:var(--bg-page);
  color:var(--text-primary);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  font-feature-settings:"cv02","cv03","cv04","cv11";
  transition:background-color .2s ease, color .2s ease;
  overflow-x:hidden;
}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}

/* ============================================================
   TOP NAVIGATION BAR
   ============================================================ */
.appbar{
  position:sticky;
  top:0;
  z-index:100;
  background:var(--bg-surface);
  border-bottom:1px solid var(--border);
  height:64px;
  display:flex;
  align-items:center;
  padding:0 24px;
  gap:20px;
  transition:background-color .2s ease, border-color .2s ease;
}

.appbar-brand{
  display:flex;
  align-items:center;
  gap:12px;
  flex-shrink:0;
}
.appbar-logo{
  width:32px;height:32px;
  border-radius:8px;
  background:linear-gradient(135deg,var(--accent) 0%, #7A5CFF 100%);
  display:grid;place-items:center;
  color:#fff;
  box-shadow:0 1px 3px rgba(99,91,255,.3);
}
.appbar-logo svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2.4;}
.appbar-title{
  font-size:15px;
  font-weight:700;
  letter-spacing:-.2px;
  color:var(--text-primary);
}
.appbar-title .crumb{
  color:var(--text-tertiary);
  font-weight:500;
  margin-left:6px;
}

.appbar-divider{
  width:1px;
  height:24px;
  background:var(--border);
  flex-shrink:0;
}

.appbar-context{
  display:flex;
  align-items:center;
  gap:8px;
  padding:6px 12px;
  border-radius:var(--radius-md);
  background:var(--bg-subtle);
  border:1px solid var(--border);
  flex-shrink:0;
}
.appbar-context .dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--accent);
}
.appbar-context .label{
  font-size:12px;
  font-weight:600;
  color:var(--text-secondary);
}
.appbar-context .value{
  font-size:13px;
  font-weight:700;
  color:var(--text-primary);
}

.appbar-spacer{flex:1;}

.appbar-actions{
  display:flex;
  align-items:center;
  gap:8px;
}

.icon-btn{
  width:36px;height:36px;
  display:grid;place-items:center;
  border-radius:var(--radius-md);
  border:1px solid transparent;
  color:var(--text-secondary);
  transition:all .15s ease;
}
.icon-btn:hover{
  background:var(--bg-subtle);
  color:var(--text-primary);
  border-color:var(--border);
}
.icon-btn svg{
  width:18px;height:18px;
  stroke:currentColor;fill:none;
  stroke-width:1.8;
  stroke-linecap:round;stroke-linejoin:round;
}
.icon-btn .icon-sun{display:block;}
.icon-btn .icon-moon{display:none;}
html[data-theme="dark"] .icon-btn .icon-sun{display:none;}
html[data-theme="dark"] .icon-btn .icon-moon{display:block;}

.user-chip{
  display:flex;
  align-items:center;
  gap:8px;
  padding:6px 10px 6px 6px;
  border-radius:999px;
  border:1px solid var(--border);
  background:var(--bg-surface);
  transition:all .15s ease;
}
.user-chip:hover{
  border-color:var(--border-strong);
  background:var(--bg-subtle);
}
.user-chip .avatar{
  width:26px;height:26px;
  border-radius:50%;
  background:linear-gradient(135deg,var(--accent),#7A5CFF);
  color:#fff;
  display:grid;place-items:center;
  font-size:11px;
  font-weight:700;
  letter-spacing:.3px;
}
.user-chip .name{
  font-size:13px;
  font-weight:600;
  color:var(--text-primary);
}

/* ============================================================
   PAGE HEADER
   ============================================================ */
.page-head{
  background:var(--bg-surface);
  border-bottom:1px solid var(--border);
  padding:24px 32px 20px;
}
.page-head-inner{
  max-width:100%;
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:24px;
  flex-wrap:wrap;
}
.page-head h1{
  font-size:22px;
  font-weight:700;
  letter-spacing:-.4px;
  color:var(--text-primary);
  line-height:1.3;
}
.page-head h1 .accent{
  color:var(--accent);
}
.page-head .page-desc{
  font-size:13px;
  color:var(--text-tertiary);
  margin-top:4px;
  display:flex;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}
.page-head .page-desc .sep{
  width:3px;height:3px;border-radius:50%;
  background:var(--gray-300);
}
.page-head .page-desc b{color:var(--text-secondary);font-weight:600;}

/* Filter group */
.filter-group{
  display:flex;
  gap:8px;
  align-items:center;
  flex-wrap:wrap;
}
.filter-label{
  font-size:12px;
  font-weight:600;
  color:var(--text-secondary);
  margin-right:4px;
}

.input-wrap{
  position:relative;
  display:flex;
  align-items:center;
}
.input-wrap svg{
  position:absolute;
  left:10px;
  width:14px;height:14px;
  stroke:var(--text-tertiary);fill:none;
  stroke-width:2;
  pointer-events:none;
}
.input-wrap input,
.input-wrap select{
  font-family:var(--font);
  font-size:13px;
  font-weight:500;
  color:var(--text-primary);
  background:var(--bg-surface);
  border:1px solid var(--border-strong);
  border-radius:var(--radius-md);
  padding:8px 12px 8px 32px;
  outline:none;
  transition:all .15s ease;
  min-width:120px;
}
.input-wrap.no-icon input,
.input-wrap.no-icon select{
  padding-left:12px;
}
.input-wrap input:focus,
.input-wrap select:focus{
  border-color:var(--accent);
  box-shadow:0 0 0 3px var(--accent-soft);
}

.btn{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:8px 14px;
  font-family:var(--font);
  font-size:13px;
  font-weight:600;
  border-radius:var(--radius-md);
  border:1px solid transparent;
  transition:all .15s ease;
  white-space:nowrap;
}
.btn svg{
  width:14px;height:14px;
  stroke:currentColor;fill:none;stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round;
}
.btn-primary{
  background:var(--accent);
  color:#fff;
  box-shadow:var(--shadow-xs);
}
.btn-primary:hover{
  background:var(--accent-hover);
}
.btn-secondary{
  background:var(--bg-surface);
  color:var(--text-secondary);
  border-color:var(--border-strong);
}
.btn-secondary:hover{
  background:var(--bg-subtle);
  color:var(--text-primary);
}

/* ============================================================
   KPI STRIP
   ============================================================ */
.kpi-strip{
  background:var(--bg-surface);
  border-bottom:1px solid var(--border);
  padding:16px 32px;
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(180px,1fr));
  gap:1px;
  background-image:linear-gradient(var(--border),var(--border));
}
.kpi{
  padding:8px 20px;
  border-left:1px solid var(--border);
  display:flex;
  flex-direction:column;
  gap:4px;
}
.kpi:first-child{border-left:none;padding-left:0;}
.kpi-label{
  font-size:11px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.5px;
  color:var(--text-tertiary);
}
.kpi-value{
  font-size:22px;
  font-weight:700;
  letter-spacing:-.5px;
  color:var(--text-primary);
  font-variant-numeric:tabular-nums;
  line-height:1.1;
}
.kpi-value .unit{
  font-size:12px;
  font-weight:500;
  color:var(--text-tertiary);
  margin-left:4px;
}
.kpi-meta{
  font-size:11px;
  color:var(--text-tertiary);
  font-weight:500;
}

/* ============================================================
   TOOLBAR
   ============================================================ */
.toolbar{
  background:var(--bg-page);
  padding:12px 32px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}
.toolbar-left{
  display:flex;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}
.search-input{
  position:relative;
  display:flex;
  align-items:center;
  width:280px;
  max-width:100%;
}
.search-input svg{
  position:absolute;
  left:12px;
  width:14px;height:14px;
  stroke:var(--text-tertiary);fill:none;stroke-width:2;
  pointer-events:none;
}
.search-input input{
  width:100%;
  font-family:var(--font);
  font-size:13px;
  font-weight:500;
  color:var(--text-primary);
  background:var(--bg-surface);
  border:1px solid var(--border-strong);
  border-radius:var(--radius-md);
  padding:8px 12px 8px 34px;
  outline:none;
  transition:all .15s ease;
}
.search-input input::placeholder{color:var(--text-tertiary);}
.search-input input:focus{
  border-color:var(--accent);
  box-shadow:0 0 0 3px var(--accent-soft);
}

.legend-inline{
  display:flex;
  align-items:center;
  gap:4px;
  flex-wrap:wrap;
}
.legend-chip{
  display:inline-flex;
  align-items:center;
  gap:5px;
  padding:4px 9px;
  border-radius:6px;
  font-size:11px;
  font-weight:600;
  border:1px solid;
  white-space:nowrap;
}
.legend-chip .swatch{
  width:8px;height:8px;border-radius:2px;
}

/* ============================================================
   ROSTER GRID
   ============================================================ */
.grid-wrap{
  padding:0 32px 100px;
  overflow-x:auto;
}

.roster-grid{
  width:100%;
  min-width:1200px;
  border-collapse:separate;
  border-spacing:0;
  background:var(--bg-surface);
  border:1px solid var(--border);
  border-radius:var(--radius-lg);
  overflow:hidden;
  font-size:13px;
}

.roster-grid thead th{
  position:sticky;
  top:0;
  z-index:10;
  background:var(--bg-subtle);
  padding:10px 8px;
  font-size:11px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.4px;
  color:var(--text-tertiary);
  border-bottom:1px solid var(--border);
  text-align:center;
  white-space:nowrap;
}
.roster-grid thead th .day-num{
  font-size:12px;
  font-weight:700;
  color:var(--text-primary);
  font-variant-numeric:tabular-nums;
}
.roster-grid thead th .day-name{
  display:block;
  font-size:9px;
  font-weight:600;
  color:var(--text-tertiary);
  margin-top:1px;
}
.roster-grid thead th.is-weekend{
  background:#FEF6EE;
  color:#C4320A;
}
html[data-theme="dark"] .roster-grid thead th.is-weekend{
  background:#3A1D0A;
  color:#FDB022;
}

.roster-grid thead th.col-emp{
  position:sticky;
  left:0;
  z-index:20;
  text-align:left;
  padding-left:20px;
  min-width:220px;
  background:var(--bg-subtle);
  box-shadow:1px 0 0 var(--border);
}
.roster-grid thead th.col-pos{
  position:sticky;
  left:220px;
  z-index:20;
  text-align:left;
  min-width:120px;
  background:var(--bg-subtle);
  box-shadow:1px 0 0 var(--border);
}
.roster-grid thead th.col-sum{
  min-width:52px;
  font-variant-numeric:tabular-nums;
}

.roster-grid tbody td{
  padding:0;
  border-bottom:1px solid var(--border);
  vertical-align:middle;
  background:var(--bg-surface);
}
.roster-grid tbody tr:last-child td{border-bottom:none;}
.roster-grid tbody tr:hover td{background:var(--bg-subtle);}

.roster-grid tbody td.col-emp{
  position:sticky;
  left:0;
  z-index:5;
  padding:8px 16px 8px 20px;
  background:var(--bg-surface);
  box-shadow:1px 0 0 var(--border);
}
.roster-grid tbody tr:hover td.col-emp{background:var(--bg-subtle);}

.emp-row{
  display:flex;
  align-items:center;
  gap:10px;
}
.emp-avatar{
  width:28px;height:28px;
  border-radius:50%;
  background:var(--gray-200);
  color:var(--text-secondary);
  display:grid;place-items:center;
  font-size:11px;
  font-weight:700;
  flex-shrink:0;
  border:1px solid var(--border);
}
html[data-theme="dark"] .emp-avatar{
  background:var(--gray-200);
  color:var(--text-secondary);
}
.emp-info{min-width:0;}
.emp-name{
  font-size:13px;
  font-weight:600;
  color:var(--text-primary);
  line-height:1.3;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.emp-meta{
  font-size:11px;
  color:var(--text-tertiary);
  font-family:var(--mono);
  margin-top:1px;
}

.roster-grid tbody td.col-pos{
  position:sticky;
  left:220px;
  z-index:5;
  padding:8px 12px;
  background:var(--bg-surface);
  box-shadow:1px 0 0 var(--border);
  font-size:12px;
  font-weight:500;
  color:var(--text-secondary);
  white-space:nowrap;
}
.roster-grid tbody tr:hover td.col-pos{background:var(--bg-subtle);}

/* ============================================================
   SHIFT CELLS
   ============================================================ */
.shift-cell{
  position:relative;
  padding:4px !important;
}
.shift-btn{
  display:flex;
  align-items:center;
  justify-content:center;
  width:100%;
  height:32px;
  border-radius:6px;
  font-family:var(--font);
  font-size:11px;
  font-weight:700;
  letter-spacing:.2px;
  border:1px solid;
  cursor:pointer;
  transition:all .12s ease;
  font-variant-numeric:tabular-nums;
}
.shift-btn:hover{
  transform:translateY(-1px);
  box-shadow:var(--shadow-sm);
}
.shift-btn.morning  { background:var(--shift-morning-bg);   color:var(--shift-morning-fg);   border-color:var(--shift-morning-bd); }
.shift-btn.general  { background:var(--shift-general-bg);   color:var(--shift-general-fg);   border-color:var(--shift-general-bd); }
.shift-btn.afternoon{ background:var(--shift-afternoon-bg); color:var(--shift-afternoon-fg); border-color:var(--shift-afternoon-bd); }
.shift-btn.night    { background:var(--shift-night-bg);     color:var(--shift-night-fg);     border-color:var(--shift-night-bd); }

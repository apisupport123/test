<body>

<%
    // ============ PARAMETERS ============
    String monthYr = request.getParameter("myViewMonth");
    String m_strroles = request.getParameter("m_strroles");
    String username = request.getParameter("username");

    if (m_strroles == null || m_strroles.trim().isEmpty())
        m_strroles = (String) session.getAttribute("m_strrole");
    if (username == null || username.trim().isEmpty())
        username = (String) session.getAttribute("user");
    if (m_strroles == null) m_strroles = "";
    if (username == null) username = "";

    int year = 0, month = 0, noOfDays = 0;
    String selectedYear = null, selectedMonth = null, nameOfMonth = null;
    String sort_MonthYear = null;
    boolean showTable = false;

    if (monthYr != null && !monthYr.trim().isEmpty()) {
        String[] s = monthYr.split("-");
        if (s.length >= 2) {
            selectedYear = s[0];
            selectedMonth = s[1];
            try {
                year = Integer.parseInt(selectedYear);
                month = Integer.parseInt(selectedMonth);
                showTable = true;
                if (month == 1 || month == 3 || month == 5 || month == 7 || month == 8 || month == 10 || month == 12) noOfDays = 31;
                else if (month == 4 || month == 6 || month == 9 || month == 11) noOfDays = 30;
                else if (month == 2) noOfDays = ((year % 400 == 0) || (year % 100 != 0) && (year % 4 == 0)) ? 29 : 28;
                String[] mn = {"","January","February","March","April","May","June","July","August","September","October","November","December"};
                String[] sn = {"","Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"};
                nameOfMonth = mn[month];
                sort_MonthYear = sn[month] + "_" + selectedYear;
            } catch (Exception e) { showTable = false; }
        }
    }
    if (!showTable) {
        YearMonth ym = YearMonth.now(ZoneId.of("Asia/Kolkata"));
        year = ym.getYear(); month = ym.getMonthValue(); noOfDays = ym.lengthOfMonth();
        selectedYear = String.valueOf(year);
        selectedMonth = (month < 10 ? "0" : "") + month;
        String[] mn = {"","January","February","March","April","May","June","July","August","September","October","November","December"};
        String[] sn = {"","Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"};
        nameOfMonth = mn[month];
        sort_MonthYear = sn[month] + "_" + selectedYear;
        showTable = true;
    }

    // ============ LOAD ============
    List<Map<String,Object>> employees = new ArrayList<>();
    Connection conn = null;
    try {
        conn = DBUtilityAuto.getReportDBConnection();
        PreparedStatement ps = conn.prepareStatement("select * from rostertable where UPPER(TEAM)=UPPER(?) and UPPER(MONTHYEAR)=UPPER(?) order by id");
        ps.setString(1, m_strroles);
        ps.setString(2, sort_MonthYear);
        ResultSet rs = ps.executeQuery();
        while (rs.next()) {
            Map<String,Object> emp = new HashMap<>();
            emp.put("name", rs.getString("NAME"));
            emp.put("adId", rs.getString("AD_ID"));
            emp.put("position", rs.getString("POSITION"));
            for (int d = 1; d <= noOfDays; d++) emp.put("day_" + d, rs.getString("DAY_" + d));
            employees.add(emp);
        }
        rs.close(); ps.close();

        if (employees.isEmpty()) {
            PreparedStatement ps2 = conn.prepareStatement("select ad_id, FIRSTNAME || ' ' || LASTNAME as Fullname from eisupport_employee_master where TEAM = ? and isactive='Active'");
            ps2.setString(1, m_strroles);
            ResultSet rs2 = ps2.executeQuery();
            while (rs2.next()) {
                Map<String,Object> emp = new HashMap<>();
                emp.put("name", rs2.getString("Fullname"));
                emp.put("adId", rs2.getString("ad_id"));
                emp.put("position", null);
                for (int d = 1; d <= noOfDays; d++) emp.put("day_" + d, "Morning");
                employees.add(emp);
            }
            rs2.close(); ps2.close();
        }
    } catch (Exception e) { e.printStackTrace(); }
    finally { if (conn != null) try { conn.close(); } catch (Exception e) {} }

    int totalEmp = employees.size();
    String userInitial = (username != null && username.length() > 0) ? username.substring(0,1).toUpperCase() : "U";
%>


<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%
 // Session check
 if(session == null || session.getAttribute("role") == null) {
     response.sendRedirect(request.getContextPath() + "/login.action");
     return;
 }

 // Role check — galat role ko sahi header pe bhejo
 String __role = (String) session.getAttribute("role");
 if ("EIS Bank".equals(__role)) {
     response.sendRedirect(request.getContextPath() + "/jsp/Bankheader.jsp");
     return;
 }
 if ("Admin".equals(__role) || "ModuleLead".equals(__role)) {
     response.sendRedirect(request.getContextPath() + "/jsp/header.jsp");
     return;
 }

 // Cache headers
 response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate, max-age=0, private");
 response.setHeader("Pragma", "no-cache");
 response.setDateHeader("Expires", 0);
%>

<style>
:root{
  --brand:#F86F03;
  --brand-2:#FF9A3D;
  --brand-light:#FFF4EC;
  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F7F7F5;
  --sidebar-bg:#FFFFFF;
  --sidebar-text:#4B5563;
  --sidebar-text-hover:#0A0A0A;
  --sidebar-hover:#F5F5F4;
  --sidebar-active:#FFF4EC;
  --topnav-h:64px;
  --sidebar-w:260px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  font-family:'Inter',system-ui,sans-serif;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
}

/* Hide old junk */
.primary-nav,.hamburger,.menu,.overflow-container{display:none!important}

/* ============ SIDEBAR ============ */
.sidebar{
  position:fixed;
  top:0;left:0;bottom:0;
  width:var(--sidebar-w);
  background:var(--sidebar-bg);
  border-right:1px solid var(--line);
  z-index:60;
  display:flex;
  flex-direction:column;
  transition:transform .3s cubic-bezier(.4,0,.2,1);
}

.sb-head{
  padding:16px 20px;
  height:var(--topnav-h);
  display:flex;
  align-items:center;
  gap:11px;
  border-bottom:1px solid var(--line);
  flex-shrink:0;
}
.sb-logo{
  width:36px;height:36px;
  background:linear-gradient(135deg, var(--brand), var(--brand-2));
  border-radius:10px;
  display:grid;place-items:center;
  color:#fff;
  font-size:.9rem;
  box-shadow:0 6px 16px -6px var(--brand);
  flex-shrink:0;
}
.sb-title{
  font-weight:800;
  font-size:.95rem;
  letter-spacing:-.3px;
  line-height:1.1;
}
.sb-title small{
  display:block;
  font-size:.68rem;
  font-weight:500;
  color:var(--muted);
  letter-spacing:.4px;
  text-transform:uppercase;
  margin-top:2px;
}

.sb-search{
  padding:14px 16px 8px;
  flex-shrink:0;
}
.sb-search-box{
  position:relative;
  display:flex;
  align-items:center;
}
.sb-search-box i{
  position:absolute;
  left:12px;
  color:var(--muted);
  font-size:.8rem;
  pointer-events:none;
}
.sb-search-box input{
  width:100%;
  padding:9px 12px 9px 34px;
  background:#F5F5F4;
  border:1px solid transparent;
  border-radius:9px;
  color:var(--ink);
  font-family:inherit;
  font-size:.82rem;
  font-weight:500;
  outline:none;
  transition:all .2s ease;
}
.sb-search-box input::placeholder{color:#9CA3AF}
.sb-search-box input:focus{
  background:#fff;
  border-color:var(--brand);
  box-shadow:0 0 0 3px rgba(248,111,3,.12);
}

.sb-body{
  flex:1;
  overflow-y:auto;
  padding:8px 12px 20px;
}
.sb-body::-webkit-scrollbar{width:6px}
.sb-body::-webkit-scrollbar-thumb{background:#E5E5E5;border-radius:3px}
.sb-body::-webkit-scrollbar-thumb:hover{background:#D4D4D4}

.sb-group{
  padding:14px 10px 6px;
  font-size:.68rem;
  font-weight:700;
  color:#9CA3AF;
  letter-spacing:.8px;
  text-transform:uppercase;
}

.sb-item{
  display:flex;
  align-items:center;
  gap:11px;
  padding:8px 10px;
  border-radius:8px;
  font-size:.83rem;
  font-weight:500;
  color:var(--sidebar-text);
  text-decoration:none;
  transition:all .15s ease;
  cursor:pointer;
  line-height:1.35;
}
.sb-item:hover{
  background:var(--sidebar-hover);
  color:var(--sidebar-text-hover);
}
.sb-item .sb-icon{
  width:26px;height:26px;
  display:grid;place-items:center;
  background:#F5F5F4;
  border-radius:7px;
  font-size:.72rem;
  color:var(--sidebar-text);
  flex-shrink:0;
  transition:all .15s ease;
}
.sb-item:hover .sb-icon{
  background:var(--brand-light);
  color:var(--brand);
}
.sb-item.sb-active{
  background:var(--sidebar-active);
  color:var(--brand);
  font-weight:600;
}
.sb-item.sb-active .sb-icon{
  background:var(--brand);
  color:#fff;
}
.sb-item.sb-logout{
  color:#E53935;
  margin-top:6px;
}
.sb-item.sb-logout .sb-icon{
  background:#FFEBEE;
  color:#E53935;
}
.sb-item.sb-logout:hover{
  background:#FFEBEE;
  color:#C62828;
}
.sb-item.sb-logout:hover .sb-icon{
  background:#E53935;
  color:#fff;
}

/* ============ TOPNAV ============ */
.topnav{
  position:fixed;
  top:0;
  left:var(--sidebar-w);
  right:0;
  height:var(--topnav-h);
  background:rgba(247,247,245,.85);
  backdrop-filter:blur(14px) saturate(180%);
  -webkit-backdrop-filter:blur(14px) saturate(180%);
  border-bottom:1px solid var(--line);
  z-index:50;
  display:flex;
  align-items:center;
  padding:0 24px;
  gap:16px;
  transition:left .3s cubic-bezier(.4,0,.2,1);
}
.tn-toggle{
  display:none;
  width:36px;height:36px;
  background:transparent;
  border:1px solid var(--line);
  border-radius:9px;
  color:var(--ink);
  cursor:pointer;
  font-size:.85rem;
}
.tn-search{
  flex:1;
  max-width:520px;
  height:40px;
  background:#fff;
  border:1px solid var(--line);
  border-radius:11px;
  padding:0 14px;
  display:flex;
  align-items:center;
  gap:10px;
  color:var(--muted);
  font-size:.83rem;
  cursor:pointer;
  transition:all .2s ease;
  font-family:inherit;
}
.tn-search:hover{
  border-color:var(--brand);
  color:var(--ink);
  box-shadow:0 4px 14px rgba(248,111,3,.06);
}
.tn-search .kbd{
  margin-left:auto;
  display:inline-flex;
  align-items:center;
  padding:3px 7px;
  background:#F5F5F4;
  border:1px solid var(--line);
  border-radius:6px;
  font-size:.68rem;
  font-weight:600;
  color:var(--muted);
}
.tn-right{
  margin-left:auto;
  display:flex;
  align-items:center;
  gap:10px;
}
.tn-btn{
  width:36px;height:36px;
  display:grid;place-items:center;
  background:transparent;
  border:1px solid var(--line);
  border-radius:9px;
  color:var(--ink);
  cursor:pointer;
  font-size:.85rem;
  transition:all .15s ease;
  text-decoration:none;
}
.tn-btn:hover{
  background:var(--brand);
  border-color:var(--brand);
  color:#fff;
}
.tn-avatar{
  width:36px;height:36px;
  border-radius:50%;
  background:linear-gradient(135deg, var(--brand), var(--brand-2));
  display:grid;place-items:center;
  color:#fff;
  font-weight:700;
  font-size:.85rem;
  cursor:pointer;
  border:2px solid #fff;
  box-shadow:0 2px 8px rgba(0,0,0,.08);
}

/* ============ MAIN CONTENT OFFSET ============ */
.new-wrapper{
  margin-left:var(--sidebar-w);
  padding-top:var(--topnav-h);
  transition:margin-left .3s cubic-bezier(.4,0,.2,1);
}

/* ============ MOBILE ============ */
.sb-overlay{
  position:fixed;
  inset:0;
  background:rgba(10,10,10,.4);
  backdrop-filter:blur(2px);
  z-index:55;
  opacity:0;
  pointer-events:none;
  transition:opacity .25s ease;
}
html.sb-open .sb-overlay{opacity:1;pointer-events:auto}

@media (max-width:900px){
  .sidebar{transform:translateX(-100%);box-shadow:0 0 40px rgba(0,0,0,.1)}
  html.sb-open .sidebar{transform:translateX(0)}
  .topnav{left:0}
  .tn-toggle{display:grid;place-items:center}
  .new-wrapper{margin-left:0}
}
</style>
</head>

  text-align:left;
  padding:12px 20px;
  border-right:2px solid rgba(0,229,255,0.15);
  min-width:260px;
  max-width:280px;
  box-shadow:8px 0 16px -8px rgba(0,0,0,0.7), inset -2px 0 0 rgba(0,229,255,0.05);
}
table.roster thead th.col-emp{
  z-index:55;
  background:linear-gradient(180deg, #1A1A28, #0F0F18);
  color:var(--neon-cyan);
  font-size:13px;
  padding:12px 20px;
  text-shadow:0 0 12px rgba(0,229,255,0.5);
}
table.roster tbody tr:hover td.col-emp{
  background:linear-gradient(145deg, var(--bg-3), var(--bg-2));
}

table.roster th.col-role,
table.roster td.col-role{
  position:sticky;
  left:260px;
  z-index:19;
  background:linear-gradient(145deg, var(--bg-2), var(--bg-1));
  text-align:left;
  padding:12px 16px;
  border-right:2px solid rgba(163,113,247,0.2);
  min-width:120px;
  max-width:140px;
  font-size:12px;
  font-weight:800;
  color:var(--ink-2);
  text-transform:uppercase;
  letter-spacing:0.8px;
  box-shadow:8px 0 16px -8px rgba(0,0,0,0.7), inset -2px 0 0 rgba(163,113,247,0.05);
}
table.roster thead th.col-role{
  z-index:54;
  background:linear-gradient(180deg, #1A1A28, #0F0F18);
  color:var(--neon-purple);
  font-size:13px;
  text-shadow:0 0 12px rgba(163,113,247,0.5);
}
table.roster tbody tr:hover td.col-role{
  background:linear-gradient(145deg, var(--bg-3), var(--bg-2));
}

/* ============================================================
   TABLE BODY
   ============================================================ */
table.roster tbody td{
  background:var(--bg-0);
  border-bottom:1px solid rgba(255,255,255,0.04);
  border-right:1px solid rgba(255,255,255,0.03);
  padding:0;
  text-align:center;
  vertical-align:middle;
  height:64px;
  transition:background .15s;
}
table.roster tbody tr:nth-child(even) td:not(.col-emp):not(.col-role){
  background:#050508;
}
table.roster tbody tr:hover td:not(.col-emp):not(.col-role){
  background:#0E0E18;
}
table.roster tbody td.weekend:not(.col-emp):not(.col-role){
  background:rgba(163,113,247,0.06);
}
table.roster tbody tr:nth-child(even) td.weekend:not(.col-emp):not(.col-role){
  background:rgba(163,113,247,0.09);
}
table.roster tbody tr:hover td.weekend:not(.col-emp):not(.col-role){
  background:rgba(163,113,247,0.15);
}
table.roster tbody td.today:not(.col-emp):not(.col-role){
  background:rgba(255,138,61,0.12);
  box-shadow:inset 2px 0 0 rgba(255,138,61,0.6), inset -2px 0 0 rgba(255,138,61,0.6);
}
table.roster tbody tr:hover td.today:not(.col-emp):not(.col-role){
  background:rgba(255,138,61,0.22);
}

/* ============================================================
   EMPLOYEE CELL — 3D avatar
   ============================================================ */
.emp{display:flex;align-items:center;gap:14px}
.emp-av{
  width:42px;height:42px;
  border-radius:12px;
  background:linear-gradient(145deg, #00E5FF, #A371F7);
  color:#000;
  font-weight:900;
  font-size:15px;
  display:grid;place-items:center;
  flex-shrink:0;
  letter-spacing:0.4px;
  box-shadow:
    0 0 24px rgba(0,229,255,0.4),
    0 6px 14px rgba(163,113,247,0.3),
    inset 0 2px 0 rgba(255,255,255,0.4),
    inset 0 -3px 8px rgba(0,0,0,0.3);
  border:1px solid rgba(255,255,255,0.15);
}
.emp-name{
  font-size:15px;
  font-weight:800;
  color:#fff;
  line-height:1.2;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  max-width:170px;
  letter-spacing:-0.2px;
  text-shadow:0 0 12px rgba(0,229,255,0.2), 0 1px 2px rgba(0,0,0,0.8);
}
.emp-id{
  font-size:11px;
  font-weight:700;
  color:var(--neon-cyan);
  margin-top:4px;
  font-family:var(--ff-mono);
  letter-spacing:0.6px;
  opacity:0.8;
}

/* ============================================================
   DAY CELL — 3D dropdown
   ============================================================ */
td.day{
  position:relative;
  cursor:pointer;
  padding:0 !important;
  width:60px;
  min-width:60px;
  height:64px;
}
td.day select{
  width:calc(100% - 12px);
  height:calc(100% - 12px);
  position:absolute;
  top:6px;left:6px;
  border-radius:10px;
  font-size:15px;
  font-weight:900;
  font-family:var(--ff-mono);
  cursor:pointer;
  outline:none;
  border:1px solid rgba(255,255,255,0.15);
  text-align:center;
  text-align-last:center;
  padding:0 2px;
  transition:all .2s cubic-bezier(.4,0,.2,1);
  appearance:none;
  -webkit-appearance:none;
  box-shadow:
    inset 0 2px 0 rgba(255,255,255,0.35),
    inset 0 -3px 6px rgba(0,0,0,0.35),
    0 4px 10px rgba(0,0,0,0.5);
  text-shadow:0 1px 0 rgba(255,255,255,0.3);
  letter-spacing:-0.3px;
}
td.day select:hover{
  transform:scale(1.08);
  z-index:10;
  box-shadow:
    inset 0 2px 0 rgba(255,255,255,0.4),
    inset 0 -3px 6px rgba(0,0,0,0.4),
    0 8px 20px rgba(0,0,0,0.7),
    0 0 20px currentColor;
}
td.day select:focus{
  transform:scale(1.12);
  z-index:20;
  border:2px solid var(--neon-cyan);
  box-shadow:
    inset 0 2px 0 rgba(255,255,255,0.4),
    0 0 0 3px rgba(0,229,255,0.3),
    0 0 30px rgba(0,229,255,0.6),
    0 8px 24px rgba(0,0,0,0.7);
}

/* Shift color classes — 3D gradients */
td.day select.Morning,
td.day select.WFH-Morning,
td.day select.CC-Morning{
  background:linear-gradient(145deg, var(--morning-1), var(--morning-2));
  color:#3D2600;
  box-shadow:
    0 0 16px var(--morning-glow),
    inset 0 2px 0 rgba(255,255,255,0.45),
    inset 0 -3px 6px rgba(0,0,0,0.3),
    0 4px 10px rgba(0,0,0,0.5);
}
td.day select.General,
td.day select.Genral,
td.day select.WFH-General,
td.day select.CC-General{
  background:linear-gradient(145deg, var(--general-1), var(--general-2));
  color:#0A0D14;
  box-shadow:
    0 0 14px var(--general-glow),
    inset 0 2px 0 rgba(255,255,255,0.45),
    inset 0 -3px 6px rgba(0,0,0,0.35),
    0 4px 10px rgba(0,0,0,0.5);
}
td.day select.Afternoon,
td.day select.WFH-Afternoon,
td.day select.CC-Afternoon{
  background:linear-gradient(145deg, var(--afternoon-1), var(--afternoon-2));
  color:#3D1A00;
  box-shadow:
    0 0 16px var(--afternoon-glow),
    inset 0 2px 0 rgba(255,255,255,0.45),
    inset 0 -3px 6px rgba(0,0,0,0.3),
    0 4px 10px rgba(0,0,0,0.5);
}
td.day select.Night,
td.day select.WFH-Night,
td.day select.CC-Night{
  background:linear-gradient(145deg, var(--night-1), var(--night-2));
  color:#fff;
  text-shadow:0 1px 2px rgba(0,0,0,0.5);
  box-shadow:
    0 0 16px var(--night-glow),
    inset 0 2px 0 rgba(255,255,255,0.25),
    inset 0 -3px 6px rgba(0,0,0,0.4),
    0 4px 10px rgba(0,0,0,0.5);
}
td.day select.Weekoff,
td.day select.WeekoffAdjust{
  background:linear-gradient(145deg, var(--weekoff-1), var(--weekoff-2));
  color:#fff;
  text-shadow:0 1px 2px rgba(0,0,0,0.5);
  box-shadow:
    0 0 16px var(--weekoff-glow),
    inset 0 2px 0 rgba(255,255,255,0.25),
    inset 0 -3px 6px rgba(0,0,0,0.4),
    0 4px 10px rgba(0,0,0,0.5);
}
td.day select.SickLeave,
td.day select.CasualLeave,
td.day select.EarnedLeave,
td.day select.Leave{
  background:linear-gradient(145deg, var(--leave-1), var(--leave-2));
  color:#fff;
  text-shadow:0 1px 2px rgba(0,0,0,0.5);
  box-shadow:
    0 0 16px var(--leave-glow),
    inset 0 2px 0 rgba(255,255,255,0.25),
    inset 0 -3px 6px rgba(0,0,0,0.4),
    0 4px 10px rgba(0,0,0,0.5);
}
td.day select.FlexiLeave{
  background:linear-gradient(145deg, var(--flexi-1), var(--flexi-2));
  color:#fff;
  text-shadow:0 1px 2px rgba(0,0,0,0.5);
  box-shadow:
    0 0 16px var(--flexi-glow),
    inset 0 2px 0 rgba(255,255,255,0.25),
    inset 0 -3px 6px rgba(0,0,0,0.4),
    0 4px 10px rgba(0,0,0,0.5);
}
td.day select.HolidayLeave{
  background:linear-gradient(145deg, var(--holiday-1), var(--holiday-2));
  color:#fff;
  text-shadow:0 1px 2px rgba(0,0,0,0.5);
  box-shadow:
    0 0 16px var(--holiday-glow),
    inset 0 2px 0 rgba(255,255,255,0.25),
    inset 0 -3px 6px rgba(0,0,0,0.4),
    0 4px 10px rgba(0,0,0,0.5);
}
td.day select.NA,
td.day select.empty{
  background:linear-gradient(145deg, var(--na-1), var(--na-2));
  color:var(--ink-3);
  box-shadow:
    inset 0 2px 0 rgba(255,255,255,0.05),
    inset 0 -3px 6px rgba(0,0,0,0.4),
    0 4px 10px rgba(0,0,0,0.4);
}

/* ============================================================
   SUMMARY COLUMNS
   ============================================================ */
table.roster th.col-sum,
table.roster td.col-sum{
  min-width:80px;
  font-family:var(--ff-mono);
  font-size:18px;
  font-weight:900;
}
table.roster th.col-sum{
  font-family:var(--ff);
  font-size:13px;
  font-weight:900;
  letter-spacing:1.4px;
}
td.col-sum.wo{
  color:var(--neon-purple);
  background:rgba(163,113,247,0.08);
  text-shadow:0 0 16px rgba(163,113,247,0.6);
}
td.col-sum.lv{
  color:var(--neon-pink);
  background:rgba(255,45,155,0.08);
  text-shadow:0 0 16px rgba(255,45,155,0.6);
}

/* ============================================================
   AGGREGATE ROWS
   ============================================================ */
tr.agg td{
  background:linear-gradient(180deg, var(--bg-2), var(--bg-1)) !important;
  border-top:2px solid rgba(0,229,255,0.25);
  border-bottom:1px solid rgba(255,255,255,0.05);
  padding:14px 8px;
  text-align:center;
  height:auto;
  box-shadow:inset 0 2px 8px rgba(0,229,255,0.05);
}
tr.agg td.col-emp,
tr.agg td.col-role{
  background:linear-gradient(180deg, var(--bg-3), var(--bg-2)) !important;
  font-family:var(--ff);
  font-size:12px;
  font-weight:900;
  color:#fff;
  text-transform:uppercase;
  letter-spacing:1.4px;
  text-align:left;
  padding:14px 20px;
  text-shadow:0 0 10px rgba(0,229,255,0.3);
}
tr.agg td .agg-pill{
  display:inline-block;
  padding:6px 14px;
  border-radius:9px;
  min-width:38px;
  font-weight:900;
  font-family:var(--ff-mono);
  font-size:15px;
  border:1px solid rgba(255,255,255,0.15);
}
.agg-pill.morning{
  background:linear-gradient(145deg, var(--morning-1), var(--morning-2));
  color:#3D2600;
  box-shadow:0 0 16px var(--morning-glow), inset 0 2px 0 rgba(255,255,255,0.4);
}
.agg-pill.general{
  background:linear-gradient(145deg, var(--general-1), var(--general-2));
  color:#0A0D14;
  box-shadow:0 0 14px var(--general-glow), inset 0 2px 0 rgba(255,255,255,0.4);
}
.agg-pill.afternoon{
  background:linear-gradient(145deg, var(--afternoon-1), var(--afternoon-2));
  color:#3D1A00;
  box-shadow:0 0 16px var(--afternoon-glow), inset 0 2px 0 rgba(255,255,255,0.4);
}
.agg-pill.night{
  background:linear-gradient(145deg, var(--night-1), var(--night-2));
  color:#fff;
  box-shadow:0 0 16px var(--night-glow), inset 0 2px 0 rgba(255,255,255,0.3);
}
.agg-pill.total{
  background:linear-gradient(145deg, var(--neon-cyan), var(--neon-cyan-2));
  color:#000;
  box-shadow:
    0 0 24px rgba(0,229,255,0.6),
    inset 0 2px 0 rgba(255,255,255,0.5),
    inset 0 -3px 6px rgba(0,0,0,0.2);
  font-size:16px;
}

/* ============================================================
   FOOTER
   ============================================================ */
.footer{
  background:linear-gradient(180deg, var(--bg-1), var(--bg-0));
  border-top:1px solid rgba(0,229,255,0.15);
  padding:14px 28px;
  display:flex;
  align-items:center;
  gap:16px;
  flex-shrink:0;
  box-shadow:
    0 -4px 20px rgba(0,0,0,0.6),
    inset 0 1px 0 rgba(0,229,255,0.08);
  position:relative;
  z-index:100;
}
.footer-info{
  font-size:14px;
  font-weight:600;
  color:var(--ink-2);
  display:flex;
  align-items:center;
  gap:10px;
}
.footer-info strong{color:#fff;font-weight:800;text-shadow:0 0 10px rgba(0,229,255,0.3)}
.footer-info svg{
  width:16px;height:16px;
  stroke:var(--neon-cyan);fill:none;stroke-width:2.4;flex-shrink:0;
  filter:drop-shadow(0 0 6px rgba(0,229,255,0.6));
}
.footer-spacer{flex:1}

/* ============================================================
   EMPTY STATE
   ============================================================ */
.empty{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:80px 24px;text-align:center;color:var(--ink-3);height:100%;
}
.empty-icon{
  width:120px;height:120px;border-radius:28px;
  background:linear-gradient(145deg, var(--bg-2), var(--bg-1));
  border:2px solid rgba(0,229,255,0.2);
  display:grid;place-items:center;margin-bottom:28px;
  box-shadow:0 0 40px rgba(0,229,255,0.15), inset 0 2px 0 rgba(255,255,255,0.05);
}
.empty-icon svg{
  width:56px;height:56px;
  stroke:var(--neon-cyan);fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;
  filter:drop-shadow(0 0 12px rgba(0,229,255,0.6));
}
.empty h3{
  font-size:24px;font-weight:900;color:#fff;margin-bottom:10px;
  text-shadow:0 0 20px rgba(0,229,255,0.4);
}
.empty p{font-size:15px;font-weight:500;color:var(--ink-3);line-height:1.7}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width:900px){
  .header{padding:14px 16px;flex-wrap:wrap;gap:14px}
  .header-logo{width:48px;height:48px}
  .header-logo svg{width:26px;height:26px}
  .header-text h1{font-size:17px}
  .header-text p{font-size:11px}
  .header-stats{width:100%;overflow-x:auto;padding-bottom:4px}
  .hstat{min-width:82px;padding:10px 14px}
  .hstat-val{font-size:20px}
  .hstat-lbl{font-size:9px}
  .toolbar{padding:12px 16px;gap:10px}
  .field select, .field input{min-width:110px;padding:10px 12px;font-size:13px}
  .search-box input{width:100%}
  .search-box input:focus{width:100%}
  .toolbar-spacer{display:none}
  .legend-bar{padding:10px 16px;gap:8px;overflow-x:auto;flex-wrap:nowrap}
  .legend-lbl{display:none}
  .footer{padding:12px 16px;flex-direction:column;align-items:stretch;gap:10px}
  .btn{width:100%;justify-content:center}
  table.roster th.col-emp, table.roster td.col-emp{
    min-width:180px;max-width:180px;padding:10px 12px;
  }
  table.roster th.col-role, table.roster td.col-role{
    left:180px;min-width:80px;max-width:80px;padding:10px;
  }
  .emp-av{width:34px;height:34px;font-size:12px;border-radius:10px}
  .emp-name{font-size:13px;max-width:120px}
  .emp-id{font-size:10px}
  td.day{width:48px;min-width:48px;height:56px}
  td.day select{font-size:13px;border-radius:8px}
  table.roster thead th{min-width:48px;padding:10px 4px;font-size:11px}
  table.roster thead tr:nth-child(2) th{min-width:48px;font-size:10px}
}
</style>
</head>
<body>

<div class="app">

  <!-- HEADER -->
  <header class="header">
    <div class="header-title">
      <div class="header-logo">
        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </div>
      <div class="header-text">
        <h1><%= m_strrole %> Roster</h1>
        <p><%= nameOfMonth %> <%= year %> &middot; <%= username %></p>
      </div>
    </div>

    <div class="header-spacer"></div>

    <div class="header-stats">
      <div class="hstat">
        <div class="hstat-val cyan"><%= noOfDays %></div>
        <div class="hstat-lbl">Days</div>
      </div>
      <div class="hstat">
        <div class="hstat-val purple" id="statEmp">0</div>
        <div class="hstat-lbl">Team</div>
      </div>
      <div class="hstat">
        <div class="hstat-val green" id="statAssigned">0</div>
        <div class="hstat-lbl">Assigned</div>
      </div>
    </div>
  </header>

  <!-- TOOLBAR -->
  <div class="toolbar">
    <form method="get" action="" style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
      <div class="field">
        <label>Month</label>
        <select name="month">
          <% for (int m=1; m<=12; m++) { %>
            <option value="<%=m%>" <%= m==month ? "selected" : "" %>><%= monthNames[m] %></option>
          <% } %>
        </select>
      </div>
      <div class="field">
        <label>Year</label>
        <input type="number" name="year" min="2024" max="2100" value="<%=year%>" required style="min-width:110px;">
      </div>
      <input type="hidden" name="m_strroles" value="<%=m_strrole%>">
      <input type="hidden" name="username" value="<%=username%>">
      <button type="submit" class="btn btn-primary">
        <svg viewBox="0 0 24 24"><path d="M5 12h14"/><polyline points="12 5 19 12 12 19"/></svg>
        Load
      </button>
    </form>

    <div class="toolbar-spacer"></div>

    <div class="search-box">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="searchEmp" placeholder="Search employee name&hellip;" autocomplete="off">
    </div>
  </div>

  <!-- LEGEND -->
  <div class="legend-bar">
    <span class="legend-lbl">Legend</span>
    <span class="legend-chip"><span class="sw morning">M</span>Morning</span>
    <span class="legend-chip"><span class="sw general">D</span>General</span>
    <span class="legend-chip"><span class="sw afternoon">A</span>Afternoon</span>
    <span class="legend-chip"><span class="sw night">N</span>Night</span>
    <span class="legend-chip"><span class="sw weekoff">W</span>Weekoff</span>
    <span class="legend-chip"><span class="sw leave">SL</span>Leave</span>
    <span class="legend-chip"><span class="sw holiday">HL</span>Holiday</span>
  </div>

  <!-- ROSTER -->
  <div class="roster-wrap">

<% if (employees.isEmpty()) { %>
    <div class="empty">
      <div class="empty-icon">
        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M9 16l2 2 4-4"/></svg>
      </div>
      <h3>No Roster Found</h3>
      <p>No shifts saved for <strong><%= nameOfMonth %> <%= year %></strong>.<br>Upload a roster file or select a different month.</p>
    </div>
<% } else { %>
    <form id="rosterForm" method="post" action="<%=request.getContextPath()%>/RosterServlet">
      <input type="hidden" name="tableData" id="tableData">
      <input type="hidden" name="selectedMonth" value="<%=selectedMonth%>">
      <input type="hidden" name="selectedYear" value="<%=selectedYear%>">
      <input type="hidden" name="m_strroles" value="<%=m_strrole%>">
      <input type="hidden" name="username" value="<%=username%>">

    <table class="roster" id="rosterTable">
      <thead>
        <tr>
          <th class="col-emp" rowspan="2">Employee</th>
          <th class="col-role" rowspan="2">Role</th>
          <% for (int d=1; d<=noOfDays; d++) {
               LocalDate dt = LocalDate.of(year, month, d);
               boolean wk = (dt.getDayOfWeek()==DayOfWeek.SATURDAY || dt.getDayOfWeek()==DayOfWeek.SUNDAY);
               boolean isToday = dt.equals(today);
          %>
            <th class="<%= wk?"weekend":"" %> <%= isToday?"today":"" %>"><%= d %></th>
          <% } %>
          <th class="col-sum" rowspan="2">WO</th>
          <th class="col-sum" rowspan="2">LV</th>
        </tr>
        <tr>
          <% for (int d=1; d<=noOfDays; d++) {
               LocalDate dt = LocalDate.of(year, month, d);
               String ds = dt.getDayOfWeek().getDisplayName(TextStyle.SHORT, Locale.ENGLISH).substring(0,2);
               boolean wk = (dt.getDayOfWeek()==DayOfWeek.SATURDAY || dt.getDayOfWeek()==DayOfWeek.SUNDAY);
               boolean isToday = dt.equals(today);
          %>
            <th class="<%= wk?"weekend":"" %> <%= isToday?"today":"" %>"><%= ds %></th>
          <% } %>
        </tr>
      </thead>
      <tbody>
      <%
         int empIdx = 0;
         for (Map<String,Object> emp : employees) {
             String nm = emp.get("NAME") != null ? emp.get("NAME").toString() : "";
             String id = emp.get("AD_ID") != null ? emp.get("AD_ID").toString() : "";
             String pos = emp.get("POSITION") != null ? emp.get("POSITION").toString() : "";
             String ini = "U";
             if (nm.length()>0) {
                 String[] p = nm.trim().split("\\s+");
                 ini = (p.length>=2) ? (p[0].substring(0,1)+p[p.length-1].substring(0,1)) : nm.substring(0,1);
                 ini = ini.toUpperCase();
             }
      %>
        <tr class="emp-row" data-name="<%= nm.toLowerCase() %>">
          <td class="col-emp">
            <div class="emp">
              <div class="emp-av"><%= ini %></div>
              <div>
                <div class="emp-name"><%= nm %></div>
                <div class="emp-id"><%= id %></div>
              </div>
            </div>
            <input type="hidden" name="employeeName" value="<%= nm %>">
            <input type="hidden" name="adId" value="<%= id %>">
            <input type="hidden" name="position_<%= empIdx %>" value="<%= pos %>">
          </td>
          <td class="col-role"><%= pos.isEmpty() ? "—" : pos %></td>
          <%
             int wo=0, lv=0;
             for (int d=1; d<=noOfDays; d++) {
                 String key = "DAY_" + d;
                 Object v = emp.get(key);
                 String shift = (v != null) ? v.toString().trim() : "";
                 if (shift.isEmpty()) shift = "NA";
                 String sl = shift.toLowerCase();
                 if (sl.contains("weekoff")) wo++;
                 if (sl.contains("leave")) lv++;

                 LocalDate dt = LocalDate.of(year, month, d);
                 boolean wk = (dt.getDayOfWeek()==DayOfWeek.SATURDAY || dt.getDayOfWeek()==DayOfWeek.SUNDAY);
                 boolean isToday = dt.equals(today);

                 String optText = "—";
                 if (sl.contains("morning")) optText = sl.contains("wfh")?"WH":(sl.contains("cc")?"CC":"M");
                 else if (sl.contains("general")||sl.contains("genral")) optText = sl.contains("wfh")?"WD":(sl.contains("cc")?"CD":"D");
                 else if (sl.contains("afternoon")) optText = sl.contains("wfh")?"WA":(sl.contains("cc")?"CA":"A");
                 else if (sl.contains("night")) optText = sl.contains("wfh")?"WN":(sl.contains("cc")?"CN":"N");
                 else if (sl.contains("weekoffadjust")) optText = "WA";
                 else if (sl.contains("weekoff")) optText = "W";
                 else if (sl.contains("sickleave")) optText = "SL";
                 else if (sl.contains("casualleave")) optText = "CL";
                 else if (sl.contains("earnedleave")) optText = "EL";
                 else if (sl.contains("flexileave")) optText = "FL";
                 else if (sl.contains("holidayleave")) optText = "HL";
                 else if (sl.contains("leave")) optText = "L";
                 else if (sl.equals("na")) optText = "—";

                 // class for select — must match the option value's class
                 String shiftClass = shift.replaceAll("\\s+", "-");
          %>
          <td class="day <%= wk?"weekend":"" %> <%= isToday?"today":"" %>">
            <select name="mnt_<%= empIdx %>_<%= d %>" class="<%= shiftClass %>" onchange="applyClass(this)">
              <option value="Morning" class="Morning" <%= shift.equalsIgnoreCase("Morning")?"selected":"" %>>M</option>
              <option value="WFH-Morning" class="WFH-Morning" <%= shift.equalsIgnoreCase("WFH-Morning")?"selected":"" %>>WH</option>
              <option value="CC-Morning" class="CC-Morning" <%= shift.equalsIgnoreCase("CC-Morning")?"selected":"" %>>CC</option>
              <option value="General" class="General" <%= (shift.equalsIgnoreCase("General")||shift.equalsIgnoreCase("Genral"))?"selected":"" %>>D</option>
              <option value="WFH-General" class="WFH-General" <%= shift.equalsIgnoreCase("WFH-General")?"selected":"" %>>WD</option>
              <option value="CC-General" class="CC-General" <%= shift.equalsIgnoreCase("CC-General")?"selected":"" %>>CD</option>
              <option value="Afternoon" class="Afternoon" <%= shift.equalsIgnoreCase("Afternoon")?"selected":"" %>>A</option>
              <option value="WFH-Afternoon" class="WFH-Afternoon" <%= shift.equalsIgnoreCase("WFH-Afternoon")?"selected":"" %>>WA</option>
              <option value="CC-Afternoon" class="CC-Afternoon" <%= shift.equalsIgnoreCase("CC-Afternoon")?"selected":"" %>>CA</option>
              <option value="Night" class="Night" <%= shift.equalsIgnoreCase("Night")?"selected":"" %>>N</option>
              <option value="WFH-Night" class="WFH-Night" <%= shift.equalsIgnoreCase("WFH-Night")?"selected":"" %>>WN</option>
              <option value="CC-Night" class="CC-Night" <%= shift.equalsIgnoreCase("CC-Night")?"selected":"" %>>CN</option>
              <option value="Weekoff" class="Weekoff" <%= shift.equalsIgnoreCase("Weekoff")?"selected":"" %>>W</option>
              <option value="WeekoffAdjust" class="WeekoffAdjust" <%= shift.equalsIgnoreCase("WeekoffAdjust")?"selected":"" %>>WA</option>
              <option value="SickLeave" class="SickLeave" <%= shift.equalsIgnoreCase("SickLeave")?"selected":"" %>>SL</option>
              <option value="CasualLeave" class="CasualLeave" <%= shift.equalsIgnoreCase("CasualLeave")?"selected":"" %>>CL</option>
              <option value="EarnedLeave" class="EarnedLeave" <%= shift.equalsIgnoreCase("EarnedLeave")?"selected":"" %>>EL</option>
              <option value="FlexiLeave" class="FlexiLeave" <%= shift.equalsIgnoreCase("FlexiLeave")?"selected":"" %>>FL</option>
              <option value="HolidayLeave" class="HolidayLeave" <%= shift.equalsIgnoreCase("HolidayLeave")?"selected":"" %>>HL</option>
              <option value="NA" class="NA" <%= shift.equalsIgnoreCase("NA")?"selected":"" %>>—</option>
            </select>
          </td>
          <% } %>
          <td class="col-sum wo"><%= wo %></td>
          <td class="col-sum lv"><%= lv %></td>
        </tr>
      <% empIdx++; } %>

      <tr class="agg">
        <td class="col-emp" colspan="2">Morning Count</td>
        <% for (int d=1; d<=noOfDays; d++) {
             int c=0;
             for (Map<String,Object> emp : employees) {
                 Object v = emp.get("DAY_"+d);
                 if (v!=null && v.toString().toLowerCase().contains("morning")) c++;
             }
        %>
          <td><span class="agg-pill morning"><%= c %></span></td>
        <% } %>
        <td colspan="2"></td>
      </tr>
      <tr class="agg">
        <td class="col-emp" colspan="2">General Count</td>
        <% for (int d=1; d<=noOfDays; d++) {
             int c=0;
             for (Map<String,Object> emp : employees) {
                 Object v = emp.get("DAY_"+d);
                 if (v!=null) { String s=v.toString().toLowerCase(); if (s.contains("general")||s.contains("genral")) c++; }
             }
        %>
          <td><span class="agg-pill general"><%= c %></span></td>
        <% } %>
        <td colspan="2"></td>
      </tr>
      <tr class="agg">
        <td class="col-emp" colspan="2">Afternoon Count</td>
        <% for (int d=1; d<=noOfDays; d++) {
             int c=0;
             for (Map<String,Object> emp : employees) {
                 Object v = emp.get("DAY_"+d);
                 if (v!=null && v.toString().toLowerCase().contains("afternoon")) c++;
             }
        %>
          <td><span class="agg-pill afternoon"><%= c %></span></td>
        <% } %>
        <td colspan="2"></td>
      </tr>
      <tr class="agg">
        <td class="col-emp" colspan="2">Night Count</td>
        <% for (int d=1; d<=noOfDays; d++) {
             int c=0;
             for (Map<String,Object> emp : employees) {
                 Object v = emp.get("DAY_"+d);
                 if (v!=null && v.toString().toLowerCase().contains("night")) c++;
             }
        %>
          <td><span class="agg-pill night"><%= c %></span></td>
        <% } %>
        <td colspan="2"></td>
      </tr>
      <tr class="agg">
        <td class="col-emp" colspan="2">Total Assigned</td>
        <% for (int d=1; d<=noOfDays; d++) {
             int c=0;
             for (Map<String,Object> emp : employees) {
                 Object v = emp.get("DAY_"+d);
                 if (v!=null && !v.toString().trim().isEmpty() && !v.toString().equalsIgnoreCase("NA")) c++;
             }
        %>
          <td><span class="agg-pill total"><%= c %></span></td>
        <% } %>
        <td colspan="2"></td>
      </tr>
      </tbody>
    </table>
    </form>
<% } %>

  </div>

  <!-- FOOTER -->
  <% if (!employees.isEmpty()) { %>
  <div class="footer">
    <div class="footer-info">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      Click any cell &rarr; pick shift &rarr; <strong>Save Roster</strong>
    </div>
    <div class="footer-spacer"></div>
    <button type="button" class="btn btn-ghost" onclick="location.reload()">
      <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
      Reset
    </button>
    <button type="button" class="btn btn-success" onclick="submitRoster()">
      <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      Save Roster
    </button>
  </div>
  <% } %>

</div>

<script>
// Update stats
(function(){
  var empCount = document.querySelectorAll('tr.emp-row').length;
  document.getElementById('statEmp').textContent = empCount;
  var assigned = 0;
  document.querySelectorAll('td.day select').forEach(function(s){
    var v = s.value.toLowerCase();
    if (v !== 'na' && v !== '') assigned++;
  });
  document.getElementById('statAssigned').textContent = assigned;
})();

// Search
document.getElementById('searchEmp').addEventListener('input', function(e){
  var q = e.target.value.toLowerCase().trim();
  document.querySelectorAll('tr.emp-row').forEach(function(r){
    var n = r.getAttribute('data-name') || '';
    r.style.display = (!q || n.indexOf(q) !== -1) ? '' : 'none';
  });
});

// Apply class on change — change select class to match new value's color
function applyClass(sel){
  var val = sel.value;
  // Remove any existing shift class
  sel.classList.remove('Morning','WFH-Morning','CC-Morning',
                       'General','WFH-General','CC-General','Genral',
                       'Afternoon','WFH-Afternoon','CC-Afternoon',
                       'Night','WFH-Night','CC-Night',
                       'Weekoff','WeekoffAdjust',
                       'SickLeave','CasualLeave','EarnedLeave','Leave',
                       'FlexiLeave','HolidayLeave',
                       'NA','empty');
  // Add new
  sel.classList.add(val.replace(/\s+/g, '-'));
}

// Submit — same mnt_X_Y format
function submitRoster(){
  var data = [];
  var rows = document.querySelectorAll('#rosterTable tbody tr.emp-row');
  rows.forEach(function(row, idx){
    var nm = row.querySelector('input[name="employeeName"]').value;
    var id = row.querySelector('input[name="adId"]').value;
    var posEl = row.querySelector('input[name="position_'+idx+'"]');
    var obj = { name: nm, adId: id, position: posEl ? posEl.value : '', days: {} };
    row.querySelectorAll('select[name^="mnt_"]').forEach(function(sel){
      var m = sel.name.match(/mnt_(\d+)_(\d+)/);
      if (m) obj.days[m[2]] = sel.value;
    });
    data.push(obj);
  });
  document.getElementById('tableData').value = JSON.stringify(data);
  document.getElementById('rosterForm').submit();
}
</script>

</body>
</html>

.blob{position:fixed;border-radius:50%;filter:blur(80px);opacity:.45;z-index:0;animation:float 12s ease-in-out infinite}
.blob.b1{width:420px;height:420px;background:#F86F03;top:-120px;left:-120px}
.blob.b2{width:380px;height:380px;background:#FFA41B;bottom:-140px;right:-100px;animation-delay:-4s}
.blob.b3{width:300px;height:300px;background:#ff5e7e;top:40%;right:30%;animation-delay:-8s;opacity:.25}
@keyframes float{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(30px,-40px) scale(1.1)}}

.shell{
  position:relative;z-index:2;width:100%;max-width:1080px;
  background:rgba(255,255,255,.98);border-radius:24px;
  box-shadow:0 30px 80px rgba(0,0,0,.35);

/* ================================================================
   ORIGINAL STYLES — AS-IS
   ================================================================ */
.button-container{
    display: flex;
    justify-content: flex-end;
    margin-right: 10px;
}

.button{
    padding: 10px 20px;
    border: none;
    border-radius:5px;
    cursor: pointer;
    margin-right: 10px;
}

.card-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 30px;
}
.card {
    width: 310px;
    height: 180px;
    margin: 10px;
    text-align: center;
    transition: transform 0.3s ease, background-color 0.3s ease;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    color: white;
    cursor: pointer;
}
.card:hover {
    transform: scale(1.05);
}
.card-zero {
    background-color: #dc3545;
}
.card-zero:hover {
    background-color: #c82333;
}
.card-nonzero {
    background-color: #007bff;
}
.card-nonzero:hover {
    background-color: #0056b3;
}
.card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
}
.card-info {
    font-size: 14px;
}
.card-title {
    font-weight: bold;
    margin-bottom: 10px;
    font-size: 18px;
}
.section {
    margin-bottom: 30px;
}

/* ================================================================
   ✅ TIMER — theme-aware (FIX: dark mode me black nahi hoga)
   ================================================================ */
.timer {
    border: 5px solid var(--brand);
    display: inline;
    padding: 5px 12px;
    color: var(--brand) !important;      /* ✅ Light & Dark dono me orange */
    font-family: Verdana, sans-serif, Arial;
    font-size: 40px;
    height: 50px;
    font-weight: bold;
    text-decoration: none;
    border-radius: 8px;
    background: var(--brand-light);
}
html[data-theme="dark"] .timer {
    background: rgba(248,111,3,.15);    /* ✅ Dark mode me dark tinted bg */
}

.wait {
    font-family: arial;
    font-size: 13px;
    color: #ff0000;
    font-weight: bold;
    zoom: 10%;
}

/* ================================================================
   ✅ BLINK — theme-aware
   ================================================================ */
.blink {
    color: var(--ink) !important;       /* ✅ Light: black, Dark: white */
}

/* ================================================================
   THEME-AWARE OVERRIDES
   ================================================================ */
body {
    background-color: var(--bg) !important;
    color: var(--ink) !important;
    margin: 0 !important;
    padding: 0 !important;
    transition: background .3s ease, color .3s ease;
}

.topnav {
    background: var(--topnav-bg) !important;
    border-bottom: 1px solid var(--line) !important;
}
.topnav .tn-search {

package com.action;

import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.net.URLConnection;
import java.sql.Blob;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;

import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import com.jdbc.DBUtilityAuto;

@WebServlet("/DocumentDownloadServlet")
public class DocumentDownloadServlet extends HttpServlet {
    private static final long serialVersionUID = 1L;

    protected void doGet(HttpServletRequest request, HttpServletResponse response)
        throws ServletException, IOException {

        String empId = request.getParameter("empid");
        String docType = request.getParameter("type");

        if (empId == null || docType == null) {
            response.sendError(HttpServletResponse.SC_BAD_REQUEST, "Missing parameters");
            return;
        }

        Connection conn = null;
        PreparedStatement stmt = null;
        ResultSet rs = null;

        try {
            conn = DBUtilityAuto.getReportDBConnection();
            String sql = "SELECT ";

            switch (docType) {
                case "BGC":
                    sql += "BGC_DOCUMENT_PATH";
                    break;
                case "PHOTO":
                    sql += "PHOTO_PATH";
                    break;
                case "POLICE":
                    sql += "POLICE_VERIFICATION_PATH";
                    break;
                case "CV":
                    sql += "CV_DOCUMENT_PATH";
                    break;
                default:
                    response.sendError(HttpServletResponse.SC_BAD_REQUEST, "Invalid docType");
                    return;
            }

            sql += " FROM eisupport_employee_master WHERE EMPLOYEE_ID = ?";
            stmt = conn.prepareStatement(sql);
            stmt.setString(1, empId);
            rs = stmt.executeQuery();

            if (rs.next()) {
                Blob blob = rs.getBlob(1);
                if (blob != null) {
                    InputStream is = blob.getBinaryStream();

                    // Detect MIME type from stream (Java 7+)
                    String mimeType = URLConnection.guessContentTypeFromStream(is);
                    if (mimeType == null) {
                        mimeType = "application/octet-stream"; // fallback
                    }

                    // Use correct extension based on MIME type
                    String extension = getExtensionFromMimeType(mimeType);
                    String filename = docType.toLowerCase() + "_" + empId + extension;

                    response.setContentType(mimeType);
                    response.setHeader("Content-Disposition", "inline; filename=\"" + filename + "\"");

                    // Reset stream (we read it once above)
                    is = blob.getBinaryStream();

                    OutputStream os = response.getOutputStream();
                    byte[] buffer = new byte[4096];
                    int bytesRead;
                    while ((bytesRead = is.read(buffer)) != -1) {
                        os.write(buffer, 0, bytesRead);
                    }

                    is.close();
                    os.flush();
                    os.close();
                    return;
                }
            }

            response.sendError(HttpServletResponse.SC_NOT_FOUND, "Document not found");

        } catch (Exception e) {
            e.printStackTrace();
            response.sendError(HttpServletResponse.SC_INTERNAL_SERVER_ERROR, "Error retrieving document");
        } finally {
            try { if (rs != null) rs.close(); } catch (Exception ex) {}
            try { if (stmt != null) stmt.close(); } catch (Exception ex) {}
            try { if (conn != null) conn.close(); } catch (Exception ex) {}
        }
    }

    // Map MIME type to common extension
    private String getExtensionFromMimeType(String mimeType) {
        switch (mimeType) {
            case "image/png": return ".png";
            case "image/jpeg": return ".jpg";
            case "image/gif": return ".gif";
            case "application/pdf": return ".pdf";
            case "application/msword": return ".doc";
            case "application/vnd.openxmlformats-officedocument.wordprocessingml.document": return ".docx";
            default: return "";
        }
    }
}


<script>
        //input mask bundle ip address
        var ipv4_address = $('#ipv4');
        ipv4_address.inputmask({
            alias: "ip",
            greedy: false //The initial mask shown will be "" instead of "-____".
        });
    </script>

<script type="text/javascript">
	
	function submitReg(){
		if(document.forms[0].m_stremployee_id.value==""){
			   alert("Please Enter Employee ID");
		    return null;  
			   
		}
		if(document.forms[0].m_streduqualification.value=="Select"){
			   alert("Please Select Education Qualification");
		    return null;  
			   
		}
		if(document.forms[0].m_strtcsjoiningdate.value==""){
			   alert("Please Select TCS Joining Date");
		    return null;  
			   
		}
		if(document.forms[0].m_strcontactno.value==""){
			   alert("Please Enter Employee contact Number");
		    return null;  
			   
		}
		if(document.forms[0].m_strRole.value=="Select Role"){
			   alert("Please Select Role");
		    return null;  
			   
		}
		if(document.forms[0].m_strtcsmailid.value==""){
			   alert("Please Enter TCS mail ID");
		    return null;  
			   
		}
		if(document.forms[0].m_strstate.value=="Select"){
			   alert("Please Select State");
		    return null;  
			   
		}
		if(document.forms[0].m_strcity.value==""){
			   alert("Please Enter City");
		    return null;  
			   
		}
		if(document.forms[0].m_strlocaladdress.value==""){
			   alert("Please Enter Local Address");
		    return null;  
			   
		}
		if(document.forms[0].m_strdob.value==""){
			   alert("Please Enter Date of Birth");
		    return null;  
			   
		}
		if(document.forms[0].m_strfirstName.value==""){
			   alert("Please Enter First Name");
		    return null; 
		}
		if(document.forms[0].m_strmiddleName.value==""){
			   alert("Please Enter Middle Name");
		    return null; 
		}
		
		if(document.forms[0].m_strlastName.value==""){
			   alert("Please Enter Last Name");
		    return null; 
		}
		
		if(document.forms[0].m_strUserName.value==""){
			   alert("Please Enter User Name");
		    return null; 
		}
		if(document.forms[0].m_strPassword.value==""){
			   alert("Please Enter Password");
		    return null; 
		}
		
		document.forms[0].action = '<%=request.getContextPath() + "/EisRegistration.do?action=insert"%>';
		document.forms[0].submit();
	}
	
	function submitClear(){
		alert('clear');
	}
	
	</script>


<style>
    .modal {
        display: none;
        /* Hidden by default */

        z-index: 1;
        /* Sit on top */
        padding-top: 100px;
        /* Location of the box */
        left: 0;
        top: 0;
        width: 100%;
        /* Full width */
        height: 100%;
        /* Full height */
        overflow: auto;
        /* Enable scroll if needed */

    }

    /* Modal Content */
    .modal-content {
        background-color: #fefefe;
        margin: auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
    }

    /* The Close Button */
    .close {
        color: #aaaaaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
    }

    .close:hover,
    .close:focus {
        color: #000;
        text-decoration: none;
        cursor: pointer;
    }
    .footer {
   position: relative;
   left: 0;
   bottom: 0;
   width: 100%;
   color: white;
   text-align: center;
}
</style>
</head>

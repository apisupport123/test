.tile-mixed .sub-text { color: #7C3AED; }
.tile-mixed .bar .fill { background: #9B59B6; width: 80%; }
.tile-mixed.pulse { animation: mixed-pulse 2s ease-in-out infinite; }
@keyframes mixed-pulse {
    0%,100% { box-shadow: 0 0 0 rgba(155,89,182,0); }
    50% { box-shadow: 0 0 15px rgba(155,89,182,.5); }
}
html[data-theme="dark"] .tile-mixed { background: rgba(155,89,182,.25); }
html[data-theme="dark"] .tile-mixed .val,
html[data-theme="dark"] .tile-mixed .sub-text { color: #C084FC; }

.tile-hundred-healthy {
    background: rgba(46,204,113,.08);
    border-color: rgba(46,204,113,.25);
}
.tile-hundred-healthy .val { color: #16A34A; font-size: 0.95rem; font-weight: 900; }
.tile-hundred-healthy .sub-text { color: #16A34A; opacity: 0.75; }
.tile-hundred-healthy .bar .fill { background: #2ECC71; width: 15%; }
html[data-theme="dark"] .tile-hundred-healthy {
    background: rgba(46,204,113,.12);
}
html[data-theme="dark"] .tile-hundred-healthy .val,
html[data-theme="dark"] .tile-hundred-healthy .sub-text { color: #4ADE80; }

/* ================================================================
   LOADER
   ================================================================ */
#loaderWrapper {
    position: fixed;
    inset: 0;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    transition: opacity 0.6s ease;
}
#loaderWrapper.hidden { opacity: 0; pointer-events: none; }
.loader-ring {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 3px solid rgba(248,111,3,.1);
    border-top: 3px solid var(--brand);
    border-right: 3px solid var(--brand-2);
    animation: spin 1s cubic-bezier(0.6,0,.4,1) infinite;
    box-shadow: 0 0 40px rgba(248,111,3,.35);
}
@keyframes spin { to { transform: rotate(360deg); } }
.loader-text {
    margin-top: 18px;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--muted);
    letter-spacing: 4px;
    text-transform: uppercase;
}
.loader-text span {
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 900;
}

/* ================================================================
   TOOLTIP
   ================================================================ */
#customTooltip {
    position: fixed;
    display: none;
    background: var(--card);
    color: var(--ink);
    padding: 8px 16px;
    border-radius: 10px;
    font-size: 0.78rem;
    font-weight: 700;
    border: 1px solid var(--line);
    box-shadow: 0 20px 50px rgba(0,0,0,.25);
    pointer-events: none;
    z-index: 99999;
    white-space: nowrap;
    max-width: 400px;
    overflow: hidden;
    text-overflow: ellipsis;
    transform: translateX(-50%) translateY(-100%);
}
#customTooltip.tip-critical { color: #E74C3C; border-color: rgba(231,76,60,.4); }
#customTooltip.tip-healthy { color: #16A34A; border-color: rgba(46,204,113,.4); }
#customTooltip.tip-td { color: #E74C3C; border-color: rgba(231,76,60,.4); }
#customTooltip.tip-bd { color: #D97706; border-color: rgba(243,156,18,.4); }
#customTooltip.tip-mixed { color: #7C3AED; border-color: rgba(155,89,182,.4); }

/* ================================================================
   MODAL
   ================================================================ */
#modalContainer {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.7);
    backdrop-filter: blur(8px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 999999;
    animation: modal-in 0.3s ease;
    padding: 20px;
}
@keyframes modal-in { from { opacity: 0; } to { opacity: 1; } }

#alertBox {
    background: var(--card);
    border-radius: 20px;
    max-width: 620px;
    width: 95%;
    max-height: 88vh;
    padding: 26px 30px 30px 30px;
    border: 1px solid var(--line);
    box-shadow: 0 40px 100px rgba(0,0,0,.5);
    overflow-y: auto;
    position: relative;
}
#alertBox::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand), var(--brand-2), #E74C3C);
    border-radius: 20px 20px 0 0;
}
#alertBox::-webkit-scrollbar { width: 4px; }
#alertBox::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 10px;
}

#alertBox .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
}
#alertBox .head h3 {
    font-size: 1.25rem;
    font-weight: 900;
    color: #E74C3C;
    display: flex;
    align-items: center;
    gap: 12px;
}
#alertBox .head h3 i { font-size: 1.3rem; }
#alertBox .head .close-btn {
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 1.2rem;
    cursor: pointer;
    transition: 0.25s;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
}
#alertBox .head .close-btn:hover {
    color: #fff;
    background: #E74C3C;
    border-color: #E74C3C;
    transform: rotate(90deg);
}

#alertBox .body-text {
    background: var(--bg);
    border-radius: 12px;
    padding: 16px 18px;
    margin: 8px 0 18px 0;
    border-left: 3px solid var(--brand);
    font-size: 0.88rem;
    line-height: 2;
    color: var(--ink);
    max-height: 200px;
    overflow-y: auto;
}
#alertBox .body-text b { color: var(--ink); font-weight: 800; }
#alertBox .body-text .highlight-td { color: #E74C3C; font-weight: 800; }
#alertBox .body-text .highlight-bd { color: #D97706; font-weight: 800; }
#alertBox .body-text .highlight-mixed { color: #7C3AED; font-weight: 800; }

#alertBox .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}
#alertBox .field { margin-bottom: 6px; }
#alertBox .field label {
    display: block;
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 6px;
}
#alertBox .field select,
#alertBox .field textarea {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    color: var(--ink);
    font-size: 0.85rem;
    font-family: inherit;
    transition: 0.2s;
}
#alertBox .field select:focus,
#alertBox .field textarea:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 4px rgba(248,111,3,.12);
}
#alertBox .field textarea { min-height: 60px; resize: vertical; }
#alertBox .field.full { grid-column: 1 / -1; }

.modal-actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    margin-top: 16px;
    flex-wrap: wrap;
}
.modal-actions .btn-m {
    padding: 10px 24px;
    border-radius: 40px;
    font-weight: 800;
    font-size: 0.82rem;
    border: none;
    cursor: pointer;
    transition: 0.25s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-family: inherit;
}
.modal-actions .btn-m-primary {
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    color: #fff;
    box-shadow: 0 6px 20px -6px var(--brand);
}
.modal-actions .btn-m-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px -8px var(--brand);
}
.modal-actions .btn-m-danger {
    background: linear-gradient(135deg, #E74C3C, #C0392B);
    color: #fff;
    box-shadow: 0 6px 20px -6px #E74C3C;
}
.modal-actions .btn-m-danger:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px -8px #E74C3C;
}
.modal-actions .btn-m-secondary {
    background: var(--card);
    border: 1px solid var(--line);
    color: var(--muted);
}
.modal-actions .btn-m-secondary:hover {
    background: var(--bg);
    color: var(--ink);
}

/* ================================================================
   RESPONSIVE
   ================================================================ */
@media (max-width: 1400px) {
    .grid-main { grid-template-columns: repeat(4, 1fr); }
    .tile-grid { grid-template-columns: repeat(4, 1fr); }
}
@media (max-width: 1100px) {
    .grid-main { grid-template-columns: repeat(3, 1fr); }
    .tile-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 768px) {
    .grid-main { grid-template-columns: repeat(2, 1fr); }
    .tile-grid { grid-template-columns: repeat(2, 1fr); }
    .top-bar { flex-wrap: wrap; height: auto; padding: 10px; }
    .full-view { height: auto; overflow-y: auto; }
    #alertBox .form-row { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<div id="loaderWrapper">
    <div class="loader-ring"></div>
    <div class="loader-text">Initializing <span>EIS Command</span></div>
</div>

<%@include file="../userheader.jsp"%>

<div class="new-wrapper">
<div class="full-view">

    <!-- ============ TOP BAR ============ -->
    <div class="top-bar">
        <div class="brand">
            <div class="logo"><i class="fas fa-tower-broadcast"></i></div>
            <div>
                <div class="name">EIS COMMAND CENTER</div>
                <div class="sub">Service Monitoring</div>
            </div>
        </div>
        <div class="top-actions">
            <div class="live-badge"><span class="dot"></span> LIVE</div>
            <span class="timer-glass" id="ten-countdown">5:00</span>

            <a href="<%=request.getContextPath()%>/jsp/ServiceWiseFailure.jsp" class="btn-glass btn-ghost-glass" target="_blank" title="View ServiceWise Failures">
                <i class="fas fa-chart-line"></i> ServiceWise
            </a>
            <a href="<%=request.getContextPath()%>/jsp/100PercentFailure.jsp" class="btn-glass btn-ghost-glass" target="_blank" title="View 100% Failures">
                <i class="fas fa-percent"></i> 100% Failure
            </a>

            <button class="btn-glass btn-primary-glass" onclick="window.open('<%=request.getContextPath()%>/jsp/DisplayServiceWiseFailure.jsp','_blank')">
                <i class="fas fa-list"></i> SW
            </button>
            <button class="btn-glass btn-ghost-glass" onclick="window.open('<%=request.getContextPath()%>/jsp/DisplayTodayServiceWiseFailure.jsp','_blank')">
                <i class="fas fa-check-circle"></i> <span class="badge-count-glass"><%= swClosed %></span>

<script>
// Auto-hide alerts after 30s
setTimeout(function() {
  var alerts = document.querySelectorAll('.alert');
  alerts.forEach(function(a) {
    a.style.transition = 'opacity .5s ease';
    a.style.opacity = '0';
    setTimeout(function(){ a.style.display = 'none'; }, 500);

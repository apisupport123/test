    /**
     * Saves the uploaded file and returns the generated file name.
     * Uses the Struts 2/7 pattern: filename is separate from the File object.
     */
    private static String uploadFile(String originalName,
                                     File uploadedFile,
                                     String directoryPath,
                                     RegistrationActionForm l_obj) {

        String newFileName = "";
        InputStream in = null;
        OutputStream out = null;

        try {
            if (originalName == null || originalName.indexOf('.') < 0) {
                return "";
            }

            String base = originalName.substring(0, originalName.indexOf('.'));
            String ext  = originalName.substring(originalName.indexOf('.'));
            newFileName = Math.random() + "_" + base + ext;

            File dir = new File(directoryPath);
            if (!dir.isDirectory()) {
                dir.mkdirs();
            }

            in = new FileInputStream(uploadedFile);
            out = new FileOutputStream(directoryPath + newFileName);

            byte[] buffer = new byte[8192];
            int len;
            while ((len = in.read(buffer)) != -1) {
                out.write(buffer, 0, len);
            }

        } catch (Exception e) {
            l_obj.setM_strmsg("Error");
            e.printStackTrace();
        } finally {
            try { if (in  != null) in.close();  } catch (Exception ignore) {}
            try { if (out != null) out.close(); } catch (Exception ignore) {}
        }

        return newFileName;
    }

    /**
     * Loads the role list from rolemst and pushes it onto BOTH the form bean
     * and the action itself — so `<s:select list="rolelist"/>` resolves.
     */
    private void loadEISRole(RegistrationActionForm l_obj) {
        Connection con = null;
        Statement st = null;
        ResultSet rs = null;

        try {
            con = DBUtilityAuto.getReportDBConnection();

            ArrayList<String> list = new ArrayList<>();
            list.add("Select Role");

            st = con.createStatement();
            rs = st.executeQuery("select rolename from rolemst");

            while (rs.next()) {
                list.add(rs.getString("rolename"));
            }

            // Expose on BOTH the form bean and the action
            l_obj.setRolelist(list);
            this.setRolelist(list);

        } catch (Exception e) {
            e.printStackTrace();
        } finally {
            closeQuietly(rs, st, null, null, con);
        }
    }

    /** Safe close for JDBC resources. */
    private static void closeQuietly(ResultSet rs,
                                     Statement st,
                                     PreparedStatement ps1,
                                     PreparedStatement ps2,
                                     Connection con) {
        try { if (rs  != null) rs.close();  } catch (Exception ignore) {}
        try { if (st  != null) st.close();  } catch (Exception ignore) {}
        try { if (ps1 != null) ps1.close(); } catch (Exception ignore) {}
        try { if (ps2 != null) ps2.close(); } catch (Exception ignore) {}
        try { if (con != null) con.close(); } catch (Exception ignore) {}
    }
}


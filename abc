<div class="toast-host" id="toastHost"></div>

<script>
(function () {
    'use strict';
    var CTX = '<%=ctx%>';
    var EMP_ID = '<%= emp != null ? emp.getM_strEmployee_ID() : "" %>';

    /* ============================================================
       THEME
       ============================================================ */
    (function initTheme() {
        var saved = localStorage.getItem('eis-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', saved);
    })();

    var themeBtn = document.getElementById('themeToggle');
    if (themeBtn) {
        themeBtn.addEventListener('click', function () {
            var cur = document.documentElement.getAttribute('data-theme');
            var next = cur === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('eis-theme', next);
            toast('Switched to ' + next + ' mode', 'info');
        });
    }

    /* ============================================================
       PARTICLES
       ============================================================ */
    (function spawnParticles() {
        var host = document.getElementById('particles');
        if (!host) return;
        var colors = ['#ff0080', '#7928ca', '#00d4ff', '#00ff88', '#ffcc00'];
        for (var i = 0; i < 40; i++) {
            var p = document.createElement('div');
            p.className = 'particle';
            p.style.left = Math.random() * 100 + '%';
            p.style.background = colors[Math.floor(Math.random() * colors.length)];
            p.style.animationDuration = (8 + Math.random() * 12) + 's';
            p.style.animationDelay = (Math.random() * 10) + 's';
            p.style.width = p.style.height = (2 + Math.random() * 3) + 'px';
            host.appendChild(p);
        }
    })();

    /* ============================================================
       RIPPLE
       ============================================================ */
    document.addEventListener('click', function (e) {
        var target = e.target.closest('.card, .btn, .doc-item, .file-drop, .nav-btn, .theme-toggle');
        if (!target) return;
        var rect = target.getBoundingClientRect();
        var ripple = document.createElement('span');
        var size = Math.max(rect.width, rect.height);
        ripple.style.position = 'absolute';
        ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
        ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';
        ripple.style.width = ripple.style.height = size + 'px';
        ripple.style.borderRadius = '50%';
        ripple.style.background = 'radial-gradient(circle, rgba(255,255,255,.3), transparent 70%)';
        ripple.style.pointerEvents = 'none';
        ripple.style.transform = 'scale(0)';
        ripple.style.transition = 'transform .6s ease-out, opacity .6s ease-out';
        ripple.style.opacity = '1';
        if (getComputedStyle(target).position === 'static') {
            target.style.position = 'relative';
        }
        target.appendChild(ripple);
        requestAnimationFrame(function () {
            ripple.style.transform = 'scale(2.5)';
            ripple.style.opacity = '0';
        });
        setTimeout(function () { ripple.remove(); }, 700);
    });

    /* ============================================================
       TOAST
       ============================================================ */
    var toastHost = document.getElementById('toastHost');
    function toast(msg, type) {
        var el = document.createElement('div');
        el.className = 'toast ' + (type || 'info');
        var icons = { success: '✓', error: '✕', info: 'ℹ' };
        el.innerHTML = '<div class="toast-icon">' + (icons[type] || icons.info) + '</div><span>' + msg + '</span>';
        toastHost.appendChild(el);
        setTimeout(function () {
            el.style.transition = 'all .3s';
            el.style.opacity = '0';
            el.style.transform = 'translateX(30px)';
            setTimeout(function () { el.remove(); }, 300);
        }, 3200);
    }

    /* ============================================================
       PHOTO
       ============================================================ */
    window.previewPhoto = function (input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('profilePhoto').src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
            toast('New photo selected — save to apply', 'info');
        }
    };

    /* ============================================================
       FILE CHANGE
       ============================================================ */
    window.onFileChange = function (input, type) {
        var drop = document.getElementById('drop-' + type);
        var nameEl = drop.querySelector('.file-name');
        var hintEl = drop.querySelector('.file-hint');
        if (input.files && input.files[0]) {
            var f = input.files[0];
            nameEl.textContent = f.name;
            hintEl.textContent = Math.round(f.size / 1024) + ' KB · ready';
            drop.classList.add('has-file');
            toast(type + ' ready to upload', 'info');
        } else {
            nameEl.textContent = 'Choose ' + type + ' file';
            hintEl.textContent = 'Click to browse';
            drop.classList.remove('has-file');
        }
    };

    /* ============================================================
       OPEN DOC
       ============================================================ */
    window.openDocument = function (empid, docType) {
        if (!empid || !docType) return;
        var url = CTX + '/DocumentDownloadServlet'
                + '?empid=' + encodeURIComponent(empid)
                + '&type=' + encodeURIComponent(docType)
                + '&_t=' + Date.now();
        window.open(url, '_blank');
    };

    /* ============================================================
       SUBMIT
       ============================================================ */
    window.submitEdit = function () {
        var form = document.getElementById('editForm');
        if (!form) { toast('Form not found', 'error'); return; }
        var checks = [
            ['m_strfirstName', 'First Name'],
            ['m_strlastName', 'Last Name'],
            ['m_strUserName', 'Username'],
            ['m_strPassword', 'Password']
        ];
        for (var i = 0; i < checks.length; i++) {
            var el = document.getElementsByName(checks[i][0])[0];
            if (el && !el.value.trim()) {
                toast('Please enter ' + checks[i][1], 'error');
                el.focus();
                el.scrollIntoView({behavior:'smooth', block:'center'});
                return;
            }
        }
        form.action = CTX + '/EISRegistrationEditServletNew?action=edit&empid=' + encodeURIComponent(EMP_ID);
        form.submit();
    };

    /* ============================================================
       CTRL+S
       ============================================================ */
    document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
            e.preventDefault();
            submitEdit();
        }
    });

    /* ============================================================
       3D TILT
       ============================================================ */
    document.querySelectorAll('.card').forEach(function (card) {
        card.addEventListener('mousemove', function (e) {
            var rect = card.getBoundingClientRect();
            var x = e.clientX - rect.left;
            var y = e.clientY - rect.top;
            var cx = rect.width / 2;
            var cy = rect.height / 2;
            var rotX = ((y - cy) / cy) * -1.5;
            var rotY = ((x - cx) / cx) * 1.5;
            card.style.transform = 'translateY(-6px) perspective(1200px) rotateX(' + rotX + 'deg) rotateY(' + rotY + 'deg)';
        });
        card.addEventListener('mouseleave', function () {
            card.style.transform = '';
        });
    });

    /* ============================================================
       MAGNETIC BUTTONS
       ============================================================ */
    document.querySelectorAll('.btn').forEach(function (btn) {
        btn.addEventListener('mousemove', function (e) {
            var rect = btn.getBoundingClientRect();
            var x = e.clientX - rect.left - rect.width / 2;
            var y = e.clientY - rect.top - rect.height / 2;
            btn.style.transform = 'translate(' + (x * 0.15) + 'px, ' + (y * 0.15) + 'px) translateY(-3px) scale(1.03)';
        });
        btn.addEventListener('mouseleave', function () {
            btn.style.transform = '';
        });
    });

})();
</script>


<script>
(function () {
    'use strict';

    /* ---------- Cursor spotlight ---------- */
    const spotlight = document.getElementById('spotlight');
    let spotX = window.innerWidth / 2, spotY = window.innerHeight / 2;
    let curX = spotX, curY = spotY;
    document.addEventListener('mousemove', (e) => {
        spotX = e.clientX;
        spotY = e.clientY;
    });
    (function animateSpotlight() {
        curX += (spotX - curX) * 0.12;
        curY += (spotY - curY) * 0.12;
        spotlight.style.transform = 'translate(' + curX + 'px, ' + curY + 'px) translate(-50%, -50%)';
        requestAnimationFrame(animateSpotlight);
    })();

    /* ---------- Theme toggle ---------- */
    const themeToggle = document.getElementById('themeToggle');
    const saved = localStorage.getItem('eis-theme') || 'light';
    document.body.dataset.theme = saved;
    themeToggle.addEventListener('click', () => {
        const next = document.body.dataset.theme === 'dark' ? 'light' : 'dark';
        document.body.dataset.theme = next;
        localStorage.setItem('eis-theme', next);
    });

    /* ---------- Toast ---------- */
    const toastHost = document.getElementById('toastHost');
    function toast(msg, type) {
        const el = document.createElement('div');
        el.className = 'toast' + (type ? ' toast-' + type : '');
        const icons = { error: 'fa-circle-xmark', success: 'fa-circle-check', info: 'fa-circle-info' };
        el.innerHTML = '<i class="fa-solid ' + (icons[type] || icons.info) + '"></i><span>' + msg + '</span>';
        toastHost.appendChild(el);
        setTimeout(() => {
            el.style.transition = 'all .35s';
            el.style.opacity = '0';
            el.style.transform = 'translateX(40px)';
            setTimeout(() => el.remove(), 350);
        }, 3200);
    }

    /* ---------- Confetti ---------- */
    const confettiHost = document.getElementById('confettiHost');
    function fireConfetti(count) {
        const colors = ['#ff6a00','#ff2d95','#7c3aed','#06b6d4','#10b981','#f59e0b'];
        for (let i = 0; i < (count || 80); i++) {
            const p = document.createElement('div');
            p.className = 'confetti-piece';
            p.style.left = Math.random() * 100 + 'vw';
            p.style.top  = '-20px';
            p.style.background = colors[Math.floor(Math.random() * colors.length)];
            p.style.transform = 'rotate(' + (Math.random() * 360) + 'deg)';
            p.style.animationDelay = (Math.random() * 0.4) + 's';
            p.style.animationDuration = (2 + Math.random() * 1.4) + 's';
            if (Math.random() > 0.7) p.style.borderRadius = '50%';
            confettiHost.appendChild(p);
            setTimeout(() => p.remove(), 3800);
        }
    }

    /* ---------- Modal ---------- */
    const modal    = document.getElementById('laptopModal');
    const openBtn  = document.getElementById('openLaptopModal');
    const closeBtn = document.getElementById('closeLaptopModal');
    const cancelBtn= document.getElementById('cancelLaptopModal');
    const saveBtn  = document.getElementById('saveLaptopModal');

    openBtn.addEventListener('click', () => modal.classList.add('open'));
    function closeModal() { modal.classList.remove('open'); }
    closeBtn.addEventListener('click', closeModal);
    cancelBtn.addEventListener('click', closeModal);
    saveBtn.addEventListener('click', () => {
        toast('Laptop / VDI details captured', 'success');
        closeModal();
    });
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
    });

    /* ---------- Form ---------- */
    const form = document.getElementById('regForm');
    const submitBtn = document.getElementById('submitBtn');

    function val(name) {
        const el = form.querySelector('[name="' + name + '"]');
        return el ? el.value.trim() : '';
    }

    function validate() {
        const checks = [
            ['m_stremployee_id',      'Please enter Employee ID'],
            ['m_streduqualification', 'Please select Education Qualification'],
            ['m_strtcsjoiningdate',   'Please select TCS Joining Date'],
            ['m_strcontactno',        'Please enter Employee contact number'],
            ['m_strRole',             'Please select Team / Role'],
            ['m_strtcsmailid',        'Please enter TCS Mail ID'],
            ['m_strstate',            'Please select State'],
            ['m_strcity',             'Please enter City'],
            ['m_strlocaladdress',     'Please enter Local Address'],
            ['m_strdob',              'Please enter Date of Birth'],
            ['m_strfirstName',        'Please enter First Name'],
            ['m_strmiddleName',       'Please enter Middle Name'],
            ['m_strlastName',         'Please enter Last Name'],
            ['m_strUserName',         'Please enter Username'],
            ['m_strPassword',         'Please enter Password']
        ];
        for (const [name, msg] of checks) {
            if (!val(name)) { toast(msg, 'error'); return false; }
        }
        return true;
    }

    function doSubmit() {
        if (!validate()) return;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting...';
        fireConfetti(90);
        setTimeout(() => form.submit(), 550);
    }

    submitBtn.addEventListener('click', doSubmit);

    /* Keyboard shortcut: Ctrl+S */
    document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
            e.preventDefault();
            doSubmit();
        }
    });

    /* ---------- Number-only inputs ---------- */
    form.querySelectorAll('input[name="m_strcontactno"],input[name="m_stremergencycontactno"]')
        .forEach(inp => {
            inp.addEventListener('input', () => {
                inp.value = inp.value.replace(/\D/g, '').slice(0, 10);
            });
        });

    /* ---------- LIVE PROGRESS RING ---------- */
    const ringFg       = document.getElementById('ringFg');
    const progressNum  = document.getElementById('progressNum');
    const progressHead = document.getElementById('progressHeadline');
    const progressSub  = document.getElementById('progressSub');

    const requiredFields = [
        'm_stremployee_id', 'm_streduqualification', 'm_strtcsjoiningdate',
        'm_strcontactno', 'm_strRole', 'm_strtcsmailid', 'm_strstate',
        'm_strcity', 'm_strlocaladdress', 'm_strdob', 'm_strfirstName',
        'm_strmiddleName', 'm_strlastName', 'm_strUserName', 'm_strPassword'
    ];

    function updateProgress() {
        let filled = 0;
        requiredFields.forEach(name => { if (val(name)) filled++; });
        const pct = Math.round((filled / requiredFields.length) * 100);

        const circumference = 2 * Math.PI * 45; // r = 45
        const offset = circumference - (pct / 100) * circumference;
        ringFg.style.strokeDasharray = circumference;
        ringFg.style.strokeDashoffset = offset;

        progressNum.textContent = pct + '%';

        if (pct === 0)       { progressHead.textContent = "Let's begin";     progressSub.textContent = 'Fill any field to start'; }
        else if (pct < 40)   { progressHead.textContent = 'Getting started'; progressSub.textContent = filled + ' of ' + requiredFields.length + ' fields filled'; }
        else if (pct < 70)   { progressHead.textContent = 'Halfway there';   progressSub.textContent = filled + ' of ' + requiredFields.length + ' fields filled'; }
        else if (pct < 100)  { progressHead.textContent = 'Almost done';     progressSub.textContent = filled + ' of ' + requiredFields.length + ' fields filled'; }
        else                 { progressHead.textContent = 'Ready to submit'; progressSub.textContent = 'All required fields are filled ✓'; }
    }
    form.addEventListener('input',  updateProgress);
    form.addEventListener('change', updateProgress);
    updateProgress();

    /* ---------- 3D Tilt on cards ---------- */
    document.querySelectorAll('.bento-card').forEach(card => {
        card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const cx = rect.width / 2;
            const cy = rect.height / 2;
            const rotX = ((y - cy) / cy) * -3;
            const rotY = ((x - cx) / cx) * 3;
            card.style.transform = 'translateY(-4px) perspective(900px) rotateX(' + rotX + 'deg) rotateY(' + rotY + 'deg)';
        });
        card.addEventListener('mouseleave', () => {
            card.style.transform = '';
        });
    });

})();
</script>

</body>
</html>

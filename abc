<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@page import="com.actionform.RegistrationActionForm"%>
<%@page import="com.beans.EmployeeDetailsBean"%>
<%@page import="java.util.List"%>
<%@page import="java.util.ArrayList"%>

<%
    RegistrationActionForm regForm = (RegistrationActionForm) request.getAttribute("RegForm");
    List<EmployeeDetailsBean> employeeList = new ArrayList<>();
    String message = "";
    String messageType = "";

    if (regForm != null) {
        Object listObj = regForm.getM_lstViewEmployeeRegistrationdetail();
        if (listObj instanceof List) {
            @SuppressWarnings("unchecked")
            List<EmployeeDetailsBean> tempList = (List<EmployeeDetailsBean>) listObj;
            employeeList = tempList;
        }
        message = regForm.getM_strmsg() != null ? regForm.getM_strmsg() : "";
        if ("error".equals(message)) {
            messageType = "error";
        } else if ("delete".equals(message)) {
            messageType = "success";
        }
    }

    String ctx = request.getContextPath();
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Registration Details · EIS Portal</title>

<!-- Local CSS (DataTables + Bootstrap if available) -->
<link rel="stylesheet" href="<%=ctx%>/css/Reg_bootstrap.min.css">
<link rel="stylesheet" href="<%=ctx%>/css/Reg_dataTables.bootstrap5.min.css">

<style>
/* ================================================================
   RESET & TOKENS
   ================================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --brand-1: #ff6a00;
    --brand-2: #ff2d95;
    --brand-3: #7c3aed;
    --brand-4: #06b6d4;
    --brand-5: #10b981;
    --danger:  #ef4444;
    --warn:    #f59e0b;

    --text:       #0a0a0f;
    --text-muted: #6b7280;
    --bg-1:       #f5f3ff;
    --white:      #ffffff;
    --border:     #e5e7eb;

    --glass-bg:     rgba(255,255,255,.55);
    --glass-border: rgba(255,255,255,.75);
    --glass-shadow: 0 8px 32px rgba(15,23,42,.08), 0 2px 8px rgba(15,23,42,.04);

    --radius-sm: 10px;
    --radius:    16px;
    --radius-lg: 24px;

    --ease-out:    cubic-bezier(.22,1,.36,1);
    --ease-spring: cubic-bezier(.34,1.56,.64,1);

    --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                 "Helvetica Neue", Arial, sans-serif,
                 "Apple Color Emoji", "Segoe UI Emoji";
    --font-display: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

html { scroll-behavior: smooth; }

body {
    font-family: var(--font-sans);
    color: var(--text);
    background: var(--bg-1);
    min-height: 100vh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}

/* ================================================================
   ANIMATED MESH BACKGROUND
   ================================================================ */
.mesh-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: var(--bg-1);
}
.mesh-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: .55;
    mix-blend-mode: multiply;
    will-change: transform;
}
.mesh-blob.m1 {
    width: 500px; height: 500px;
    background: radial-gradient(circle, var(--brand-1), transparent 65%);
    top: -10%; left: -10%;
    animation: meshMove 22s ease-in-out infinite;
}
.mesh-blob.m2 {
    width: 560px; height: 560px;
    background: radial-gradient(circle, var(--brand-3), transparent 65%);
    top: 30%; right: -15%;
    animation: meshMove 26s ease-in-out infinite reverse;
}
.mesh-blob.m3 {
    width: 480px; height: 480px;
    background: radial-gradient(circle, var(--brand-4), transparent 65%);
    bottom: -12%; left: 30%;
    animation: meshMove 30s ease-in-out infinite;
    animation-delay: -8s;
}
@keyframes meshMove {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(60px, -50px) scale(1.15); }
    66%      { transform: translate(-50px, 60px) scale(.9); }
}

/* ================================================================
   PAGE WRAP
   ================================================================ */
.page-wrap {
    max-width: 1600px;
    margin: 0 auto;
    padding: 40px 24px;
}

/* ---------- HEADER ---------- */
.page-header {
    background: var(--glass-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
    margin-bottom: 24px;
    box-shadow: var(--glass-shadow);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    animation: headerIn .8s var(--ease-out) both;
}
@keyframes headerIn {
    from { opacity: 0; transform: translateY(-16px); }
    to   { opacity: 1; transform: translateY(0); }
}

.header-left {
    display: flex;
    align-items: center;
    gap: 16px;
}
.header-icon {
    width: 56px; height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    display: grid; place-items: center;
    color: #fff;
    font-size: 26px;
    box-shadow: 0 12px 30px rgba(255,106,0,.35);
    flex-shrink: 0;
}
.header-text h1 {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.5vw, 28px);
    font-weight: 800;
    letter-spacing: -.02em;
    color: var(--text);
    line-height: 1.15;
}
.header-text p {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 4px;
}

.header-stats {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}
.stat-pill {
    padding: 10px 18px;
    background: linear-gradient(135deg, rgba(255,106,0,.10), rgba(255,45,149,.06));
    border: 1px solid rgba(255,106,0,.20);
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-1);
    display: flex;
    align-items: center;
    gap: 8px;
}
.stat-pill .stat-num {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
}

/* ---------- ALERTS ---------- */
.alert-modern {
    padding: 16px 22px;
    border-radius: var(--radius);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 600;
    animation: alertIn .5s var(--ease-spring);
}
@keyframes alertIn {
    from { opacity: 0; transform: translateY(-10px) scale(.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
}
.alert-modern.alert-error {
    background: linear-gradient(135deg, rgba(239,68,68,.15), rgba(239,68,68,.05));
    border-left: 4px solid var(--danger);
    color: #991b1b;
}
.alert-modern.alert-success {
    background: linear-gradient(135deg, rgba(16,185,129,.15), rgba(16,185,129,.05));
    border-left: 4px solid var(--brand-5);
    color: #065f46;
}
.alert-modern .alert-icon {
    font-size: 22px;
    line-height: 1;
}
.alert-modern .alert-text {
    font-size: 14px;
}

/* ---------- MAIN CARD ---------- */
.main-card {
    background: var(--glass-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: var(--glass-shadow);
    animation: cardIn .8s var(--ease-out) .1s both;
}
@keyframes cardIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* ---------- TABLE TOOLBAR ---------- */
.table-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
}
.toolbar-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 10px;
}
.toolbar-title .icon {
    width: 30px; height: 30px;
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(255,106,0,.15), rgba(255,45,149,.10));
    display: grid; place-items: center;
    font-size: 14px;
}
.toolbar-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

/* ---------- BUTTONS ---------- */
.btn-modern {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 700;
    border-radius: var(--radius-sm);
    border: none;
    cursor: pointer;
    transition: all .3s var(--ease-spring);
    text-decoration: none;
    position: relative;
    overflow: hidden;
    white-space: nowrap;
}
.btn-modern.btn-primary {
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    color: #fff;
    box-shadow: 0 8px 22px rgba(255,106,0,.35);
}
.btn-modern.btn-primary:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 14px 32px rgba(255,106,0,.5);
}
.btn-modern.btn-success {
    background: linear-gradient(135deg, #10b981, #059669);
    color: #fff;
    box-shadow: 0 8px 22px rgba(16,185,129,.35);
}
.btn-modern.btn-success:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 14px 32px rgba(16,185,129,.5);
}
.btn-modern.btn-ghost {
    background: rgba(255,255,255,.6);
    color: var(--text);
    border: 1.5px solid var(--glass-border);
}
.btn-modern.btn-ghost:hover {
    background: var(--white);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(15,23,42,.08);
}

/* ---------- TABLE ---------- */
.table-responsive {
    overflow-x: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--white);
}
table.dataTable,
table.modern-table {
    width: 100% !important;
    margin: 0 !important;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 13px;
}
table.modern-table thead th {
    background: linear-gradient(180deg, #fafafa, #f3f4f6);
    color: var(--text);
    font-weight: 700;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: .6px;
    padding: 14px 12px;
    text-align: left;
    white-space: nowrap;
    border-bottom: 1.5px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 2;
}
table.modern-table tbody td {
    padding: 12px;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
    color: var(--text);
    white-space: nowrap;
}
table.modern-table tbody tr {
    transition: background .2s;
}
table.modern-table tbody tr:hover {
    background: linear-gradient(90deg, rgba(255,106,0,.04), rgba(255,45,149,.02));
}
table.modern-table tbody tr:nth-child(even) {
    background: rgba(249,250,251,.5);
}
table.modern-table tbody tr:nth-child(even):hover {
    background: linear-gradient(90deg, rgba(255,106,0,.06), rgba(255,45,149,.03));
}

/* Cell types */
td.cell-id {
    font-family: "SFMono-Regular", Consolas, monospace;
    font-weight: 600;
    color: var(--brand-1);
    font-size: 12.5px;
}
td.cell-center {
    text-align: center;
}
td.cell-actions {
    display: flex;
    gap: 6px;
    justify-content: center;
}

/* Status badges */
.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .4px;
}
.status-badge.active {
    background: rgba(16,185,129,.12);
    color: #065f46;
}
.status-badge.inactive {
    background: rgba(239,68,68,.12);
    color: #991b1b;
}

/* File preview cells */
.file-cell {
    display: flex;
    justify-content: center;
    align-items: center;
}
.file-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all .25s var(--ease-spring);
    position: relative;
    border: none;
    padding: 0;
    background: transparent;
}
.file-icon.has-file {
    background: linear-gradient(135deg, rgba(16,185,129,.15), rgba(16,185,129,.05));
    color: var(--brand-5);
    font-size: 18px;
}
.file-icon.has-file:hover {
    transform: scale(1.15) rotate(-3deg);
    box-shadow: 0 8px 20px rgba(16,185,129,.35);
}
.file-icon.no-file {
    background: rgba(107,114,128,.08);
    color: #9ca3af;
    font-size: 16px;
    cursor: not-allowed;
}

/* Action buttons in table */
.action-btn {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    border: none;
    cursor: pointer;
    transition: all .25s var(--ease-spring);
    color: #fff;
    font-size: 15px;
}
.action-btn.edit {
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    box-shadow: 0 4px 12px rgba(255,106,0,.3);
}
.action-btn.edit:hover {
    transform: translateY(-2px) scale(1.1);
    box-shadow: 0 10px 24px rgba(255,106,0,.5);
}
.action-btn.delete {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    box-shadow: 0 4px 12px rgba(239,68,68,.3);
}
.action-btn.delete:hover {
    transform: translateY(-2px) scale(1.1);
    box-shadow: 0 10px 24px rgba(239,68,68,.5);
}

/* ---------- NO DATA ---------- */
.no-data {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-muted);
}
.no-data .icon {
    font-size: 64px;
    margin-bottom: 16px;
    opacity: .4;
}
.no-data h3 {
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 6px;
}
.no-data p {
    font-size: 14px;
}

/* ---------- DATATABLES OVERRIDES ---------- */
.dataTables_wrapper {
    padding: 16px 0 0;
}
.dataTables_wrapper .dataTables_length,
.dataTables_wrapper .dataTables_filter {
    margin-bottom: 14px;
}
.dataTables_wrapper .dataTables_filter input {
    border: 1.5px solid var(--border);
    border-radius: 10px;
    padding: 8px 14px;
    font-size: 13px;
    outline: none;
    transition: all .2s;
    margin-left: 8px;
}
.dataTables_wrapper .dataTables_filter input:focus {
    border-color: var(--brand-1);
    box-shadow: 0 0 0 4px rgba(255,106,0,.15);
}
.dataTables_wrapper .dataTables_length select {
    border: 1.5px solid var(--border);
    border-radius: 10px;
    padding: 6px 10px;
    font-size: 13px;
    outline: none;
    margin: 0 6px;
}
.dataTables_wrapper .dataTables_info,
.dataTables_wrapper .dataTables_paginate {
    margin-top: 14px;
    font-size: 13px;
}
.dataTables_wrapper .dataTables_paginate .paginate_button {
    border-radius: 8px !important;
    border: 1px solid transparent !important;
    padding: 6px 12px !important;
    margin: 0 2px !important;
    color: var(--text) !important;
    transition: all .2s !important;
}
.dataTables_wrapper .dataTables_paginate .paginate_button:hover {
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2)) !important;
    color: #fff !important;
    border-color: transparent !important;
}
.dataTables_wrapper .dataTables_paginate .paginate_button.current {
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2)) !important;
    color: #fff !important;
    border-color: transparent !important;
    box-shadow: 0 4px 12px rgba(255,106,0,.3);
}
.dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
    opacity: .4;
    cursor: not-allowed;
}

/* ---------- TOAST ---------- */
.toast-host {
    position: fixed;
    top: 24px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.toast {
    background: var(--white);
    color: var(--text);
    padding: 14px 20px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 500;
    box-shadow: 0 20px 50px rgba(0,0,0,.15);
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 280px;
    border: 1px solid rgba(15,23,42,.06);
    animation: toastIn .35s var(--ease-spring);
    position: relative;
    overflow: hidden;
}
.toast::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
}
.toast.success::before { background: var(--brand-5); }
.toast.error::before   { background: var(--danger); }
.toast.info::before    { background: var(--brand-4); }
.toast .toast-icon { font-size: 18px; line-height: 1; }
.toast.success .toast-icon { color: var(--brand-5); }
.toast.error .toast-icon   { color: var(--danger); }
.toast.info .toast-icon    { color: var(--brand-4); }
@keyframes toastIn {
    from { opacity: 0; transform: translateX(40px) scale(.9); }
    to   { opacity: 1; transform: translateX(0) scale(1); }
}

/* ---------- FOOTER ---------- */
.site-footer {
    text-align: center;
    padding: 30px 20px;
    color: var(--text-muted);
    font-size: 13px;
}
.site-footer strong {
    background: linear-gradient(120deg, var(--brand-1), var(--brand-2), var(--brand-3));
    background-size: 300% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradientShift 6s linear infinite;
    font-weight: 700;
}
@keyframes gradientShift {
    to { background-position: 300% center; }
}

/* ---------- RESPONSIVE ---------- */
@media (max-width: 900px) {
    .page-header { flex-direction: column; align-items: flex-start; }
    .table-toolbar { flex-direction: column; align-items: stretch; }
    .toolbar-actions { width: 100%; }
    .toolbar-actions .btn-modern { flex: 1; justify-content: center; }
}
@media (max-width: 640px) {
    .page-wrap { padding: 20px 12px; }
    .page-header { padding: 22px 20px; }
    .main-card { padding: 16px; }
    .header-icon { width: 46px; height: 46px; font-size: 22px; }
    .toast-host { top: 12px; right: 12px; left: 12px; }
    .toast { min-width: auto; }
}

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, var(--brand-1), var(--brand-3));
    border-radius: 10px;
    border: 2px solid var(--bg-1);
}
</style>
</head>
<body>

<!-- ============================================================
     BACKGROUND
     ============================================================ -->
<div class="mesh-bg">
    <div class="mesh-blob m1"></div>
    <div class="mesh-blob m2"></div>
    <div class="mesh-blob m3"></div>
</div>

<div class="page-wrap">

    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->
    <header class="page-header">
        <div class="header-left">
            <div class="header-icon">📋</div>
            <div class="header-text">
                <h1>EIS Registration Details</h1>
                <p>Manage all registered employees in one place</p>
            </div>
        </div>
        <div class="header-stats">
            <div class="stat-pill">
                <span>👥</span>
                <span>Total: <span class="stat-num"><%= employeeList.size() %></span></span>
            </div>
        </div>
    </header>

    <!-- ============================================================
         ALERTS
         ============================================================ -->
    <% if ("error".equals(message)) { %>
        <div class="alert-modern alert-error">
            <span class="alert-icon">⚠️</span>
            <span class="alert-text">Something went wrong. Please try again!</span>
        </div>
    <% } %>

    <% if ("delete".equals(message)) { %>
        <div class="alert-modern alert-success">
            <span class="alert-icon">✅</span>
            <span class="alert-text">Employee record deleted successfully.</span>
        </div>
    <% } %>

    <!-- ============================================================
         MAIN CARD
         ============================================================ -->
    <div class="main-card">

        <!-- Toolbar -->
        <div class="table-toolbar">
            <div class="toolbar-title">
                <span class="icon">📊</span>
                <span>All Employees</span>
            </div>
            <div class="toolbar-actions">
                <button type="button" class="btn-modern btn-ghost" onclick="location.reload();">
                    🔄 Refresh
                </button>
                <button type="button" class="btn-modern btn-primary" onclick="goToRegistration();">
                    ➕ New Registration
                </button>
                <button type="button" class="btn-modern btn-success" onclick="ExportToExcel('xlsx','Employee_Details.xlsx');">
                    ⬇️ Export Excel
                </button>
            </div>
        </div>

        <!-- Table -->
        <div class="table-responsive" id="tbl_exporttable_to_xls">
            <table id="myTable" class="modern-table">
                <thead>
                    <tr>
                        <th>Emp ID</th>
                        <th>AD ID</th>
                        <th>Status</th>
                        <th>HID</th>
                        <th>Asset ID</th>
                        <th>Education</th>
                        <th>Joining Date</th>
                        <th>Contact</th>
                        <th>Emergency</th>
                        <th>Team</th>
                        <th>TCS Mail</th>
                        <th>SBI Mail</th>
                        <th>State</th>
                        <th>City</th>
                        <th>Address</th>
                        <th>Gender</th>
                        <th>DOB</th>
                        <th>First</th>
                        <th>Middle</th>
                        <th>Last</th>
                        <th>BGC</th>
                        <th>Photo</th>
                        <th>Police</th>
                        <th>VPN Host</th>
                        <th>Laptop Host</th>
                        <th>Remote</th>
                        <th>MAC</th>
                        <th>IP</th>
                        <th>CV</th>
                        <th>Username</th>
                        <th>Password</th>
                        <th style="text-align:center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                <% if (employeeList != null && !employeeList.isEmpty()) {
                       for (EmployeeDetailsBean employee : employeeList) {
                           String empId = employee.getM_strEmployee_ID() != null ? employee.getM_strEmployee_ID() : "";
                           String isActive = employee.getM_strISACTIVE() != null ? employee.getM_strISACTIVE() : "";
                           boolean active = "Y".equalsIgnoreCase(isActive) || "Yes".equalsIgnoreCase(isActive) || "1".equals(isActive);

                           String bgcPath    = employee.getM_strBGC_Documents_Path();
                           String photoPath  = employee.getM_strPhoto_Path();
                           String policePath = employee.getM_strPolice_Verification_Path();
                           String cvPath     = employee.getM_strCV_Document();

                           boolean hasBgc    = bgcPath    != null && !bgcPath.trim().isEmpty();
                           boolean hasPhoto  = photoPath  != null && !photoPath.trim().isEmpty();
                           boolean hasPolice = policePath != null && !policePath.trim().isEmpty();
                           boolean hasCv     = cvPath     != null && !cvPath.trim().isEmpty();
                %>
                    <tr>
                        <td class="cell-id"><%= empId %></td>
                        <td><%= safe(employee.getM_strAD_ID()) %></td>
                        <td class="cell-center">
                            <span class="status-badge <%= active ? "active" : "inactive" %>">
                                <%= active ? "Active" : "Inactive" %>
                            </span>
                        </td>
                        <td><%= safe(employee.getM_strHID()) %></td>
                        <td><%= safe(employee.getM_strAsset_ID()) %></td>
                        <td><%= safe(employee.getM_strEducation_Qualification()) %></td>
                        <td><%= safe(employee.getM_strTCS_Joining_Date()) %></td>
                        <td><%= safe(employee.getM_strEmployee_contact_Number()) %></td>
                        <td><%= safe(employee.getM_strEmergency_contact_Number()) %></td>
                        <td><%= safe(employee.getM_strTeam()) %></td>
                        <td><%= safe(employee.getM_strTCS_mail_ID()) %></td>
                        <td><%= safe(employee.getM_strSBI_mail_ID()) %></td>
                        <td><%= safe(employee.getM_strState()) %></td>
                        <td><%= safe(employee.getM_strCity()) %></td>
                        <td><%= safe(employee.getM_strLocal_Address()) %></td>
                        <td><%= safe(employee.getM_strGender()) %></td>
                        <td><%= safe(employee.getM_strDate_Of_Birth()) %></td>
                        <td><%= safe(employee.getM_strFirst_Name()) %></td>
                        <td><%= safe(employee.getM_strMiddle_Name()) %></td>
                        <td><%= safe(employee.getM_strLast_Name()) %></td>

                        <!-- BGC -->
                        <td class="cell-center">
                            <div class="file-cell">
                            <% if (hasBgc) { %>
                                <button type="button" class="file-icon has-file" title="View BGC Document"
                                        onclick="openDocument('<%= empId %>','BGC');">
                                    📄
                                </button>
                            <% } else { %>
                                <span class="file-icon no-file" title="No BGC Document">—</span>
                            <% } %>
                            </div>
                        </td>

                        <!-- Photo -->
                        <td class="cell-center">
                            <div class="file-cell">
                            <% if (hasPhoto) { %>
                                <button type="button" class="file-icon has-file" title="View Photo"
                                        onclick="openDocument('<%= empId %>','PHOTO');">
                                    🖼️
                                </button>
                            <% } else { %>
                                <span class="file-icon no-file" title="No Photo">—</span>
                            <% } %>
                            </div>
                        </td>

                        <!-- Police -->
                        <td class="cell-center">
                            <div class="file-cell">
                            <% if (hasPolice) { %>
                                <button type="button" class="file-icon has-file" title="View Police Verification"
                                        onclick="openDocument('<%= empId %>','POLICE');">
                                    🛡️
                                </button>
                            <% } else { %>
                                <span class="file-icon no-file" title="No Police Verification">—</span>
                            <% } %>
                            </div>
                        </td>

                        <td><%= safe(employee.getM_strVPN_Hostname()) %></td>
                        <td><%= safe(employee.getM_strLaptop_Hostname()) %></td>
                        <td><%= safe(employee.getM_strRemote_Type()) %></td>
                        <td><%= safe(employee.getM_strVPN_VDI_MAC_Address()) %></td>
                        <td><%= safe(employee.getM_strVPN_VDI_IP_Address()) %></td>

                        <!-- CV -->
                        <td class="cell-center">
                            <div class="file-cell">
                            <% if (hasCv) { %>
                                <button type="button" class="file-icon has-file" title="View CV"
                                        onclick="openDocument('<%= empId %>','CV');">
                                    📎
                                </button>
                            <% } else { %>
                                <span class="file-icon no-file" title="No CV">—</span>
                            <% } %>
                            </div>
                        </td>

                        <td><%= safe(employee.getM_strUserName()) %></td>
                        <td><%= safe(employee.getM_strPassword()) %></td>

                        <!-- Actions -->
                        <td class="cell-center">
                            <div class="cell-actions">
                                <button type="button" class="action-btn edit" title="Edit"
                                        onclick="editRecord('<%= empId %>');">
                                    ✏️
                                </button>
                                <button type="button" class="action-btn delete" title="Delete"
                                        onclick="deleteRecord('<%= empId %>');">
                                    🗑️
                                </button>
                            </div>
                        </td>
                    </tr>
                <% } } else { %>
                    <tr>
                        <td colspan="32">
                            <div class="no-data">
                                <div class="icon">📭</div>
                                <h3>No employee records found</h3>
                                <p>Start by registering a new employee</p>
                            </div>
                        </td>
                    </tr>
                <% } %>
                </tbody>
            </table>
        </div>

    </div>

    <footer class="site-footer">
        <p>Designed by <strong>@Shubham Chaudhari</strong> &nbsp;·&nbsp; Developed by <strong>@Amit Avhad</strong></p>
    </footer>
</div>

<!-- Toast host -->
<div class="toast-host" id="toastHost"></div>

<!-- ================================================================
     SCRIPTS (local, no CDN)
     ================================================================ -->
<script src="<%=ctx%>/js/jquery-3.7.0.min.js"></script>
<script src="<%=ctx%>/js/bootstrap.bundle.minV5.3.3.js"></script>
<script src="<%=ctx%>/js/cdn.datatables.net_1.13.6_jquery.dataTables.min.js"></script>
<script src="<%=ctx%>/js/cdn.datatables.net_1.13.6_dataTables.bootstrap5.min.js"></script>
<script src="<%=ctx%>/js/dist_xlsx.full.min.js"></script>

<script>
(function () {
    'use strict';

    var CTX = '<%=ctx%>';

    /* ============================================================
       TOAST
       ============================================================ */
    var toastHost = document.getElementById('toastHost');
    function toast(msg, type) {
        var el = document.createElement('div');
        el.className = 'toast ' + (type || 'info');
        var icons = { success: '✅', error: '❌', info: 'ℹ️' };
        el.innerHTML = '<span class="toast-icon">' + (icons[type] || icons.info) + '</span><span>' + msg + '</span>';
        toastHost.appendChild(el);
        setTimeout(function () {
            el.style.transition = 'all .35s';
            el.style.opacity = '0';
            el.style.transform = 'translateX(40px)';
            setTimeout(function () { el.remove(); }, 350);
        }, 3200);
    }

    /* ============================================================
       DOCUMENT OPEN — servlet based (works for both uploaded & filename)
       ============================================================ */
    window.openDocument = function (empId, type) {
        if (!empId || !type) return;
        var url = CTX + '/DocumentDownloadServlet?empid=' + encodeURIComponent(empId)
                + '&type=' + encodeURIComponent(type)
                + '&_t=' + Date.now(); // cache-buster
        toast('Opening ' + type + ' document...', 'info');
        window.open(url, '_blank');
    };

    /* ============================================================
       EDIT / DELETE
       ============================================================ */
    window.editRecord = function (empId) {
        if (!empId) return;
        window.location.href = CTX + '/jsp/EditProfileNew.jsp?action=edit&empid=' + encodeURIComponent(empId);
    };

    window.deleteRecord = function (empId) {
        if (!empId) return;
        if (!confirm('Are you sure you want to delete employee ' + empId + '?\nThis action cannot be undone.')) return;
        toast('Deleting employee ' + empId + '...', 'info');
        window.location.href = CTX + '/ViewEisRegistrationDetails.action?action=delete&empid=' + encodeURIComponent(empId);
    };

    /* ============================================================
       NEW REGISTRATION
       ============================================================ */
    window.goToRegistration = function () {
        window.location.href = CTX + '/showregpage.action';
    };

    /* ============================================================
       EXPORT TO EXCEL
       ============================================================ */
    window.ExportToExcel = function (type, filename) {
        try {
            var elt = document.getElementById('tbl_exporttable_to_xls');
            var wb = XLSX.utils.table_to_book(elt, { sheet: 'Sheet1' });
            XLSX.writeFile(wb, filename || ('Employee_Details.' + (type || 'xlsx')));
            toast('Excel exported successfully', 'success');
        } catch (e) {
            toast('Export failed: ' + e.message, 'error');
        }
    };

    /* ============================================================
       DATATABLES INIT
       ============================================================ */
    jQuery(function ($) {
        if (!$.fn.DataTable.isDataTable('#myTable')) {
            $('#myTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'All']],
                order: [[0, 'desc']],
                language: {
                    search: '',
                    searchPlaceholder: '🔍 Search employees...',
                    lengthMenu: 'Show _MENU_ entries',
                    info: 'Showing _START_ to _END_ of _TOTAL_ employees',
                    infoEmpty: 'No employees',
                    infoFiltered: '(filtered from _MAX_ total)',
                    zeroRecords: 'No matching records found',
                    emptyTable: 'No data available',
                    paginate: {
                        first: '«',
                        last: '»',
                        next: '›',
                        previous: '‹'
                    }
                },
                columnDefs: [
                    // Disable sorting on file and action columns
                    { orderable: false, targets: [20, 21, 22, 28, 31] }
                ],
                initComplete: function () {
                    // Add a subtle styling to filter input
                    $('.dataTables_filter input').attr('type', 'search');
                }
            });
        }
    });

})();
</script>

<%!
    /**
     * Safe string helper — returns empty string for null.
     */
    private static String safe(String s) {
        return s != null ? s : "";
    }
%>

</body>
</html>

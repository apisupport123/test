    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all .2s;
    white-space: nowrap;
    text-transform: uppercase;
}
.tx-logs-btn:hover {
    background: #00a4dc;
}

/* ================================================================
   TOP CRITICAL CHIPS — red theme (#ff1a1a)
   ================================================================ */
.tx-crit-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 20px;
    background: var(--card);
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
    overflow-x: auto;
}
.tx-crit-bar::-webkit-scrollbar { height: 4px; }
.tx-crit-bar::-webkit-scrollbar-thumb { background: var(--line); border-radius: 2px; }

.tx-crit-bar .tx-crit-title {
    font-size: 11px;
    font-weight: 900;
    color: #ff1a1a;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    white-space: nowrap;
    padding-right: 12px;
    border-right: 1px solid var(--line);
    flex-shrink: 0;
}

.tx-crit-chip {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: rgba(255, 26, 26, 0.08);
    border: 1px solid rgba(255, 26, 26, 0.4);
    border-radius: 8px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.2s;
}
.tx-crit-chip:hover {
    background: rgba(255, 26, 26, 0.15);
}
.tx-crit-chip.critical {
    animation: txChipBlink 2s ease-in-out infinite;
}
@keyframes txChipBlink {
    0%, 100% { box-shadow: 0 0 0 rgba(255,26,26,0); }
    50%      { box-shadow: 0 0 14px rgba(255,26,26,.6); }
}
.tx-crit-chip .name {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    max-width: 170px;
    overflow: hidden;
    text-overflow: ellipsis;
}
.tx-crit-chip .pct {
    font-family: 'Courier New', monospace;
    font-size: 18px;
    font-weight: 900;
    color: #ff1a1a;
}

/* ================================================================
   CHART HEADER
   ================================================================ */
.tx-chart-header {
    flex-shrink: 0;
    padding: 8px 20px 4px;
    background: var(--bg);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
}
.tx-chart-header h2 {
    font-size: 22px;

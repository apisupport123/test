package com.action;

import jakarta.servlet.RequestDispatcher;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

import java.io.File;
import java.io.IOException;
import java.sql.Blob;
import java.sql.Clob;
import java.sql.Connection;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.ArrayList;
import java.util.List;

import com.actionform.RegistrationActionForm;
import com.jdbc.DBUtilityAuto;
import com.beans.EmployeeDetailsBean;
/**
 * Servlet implementation class ViewEISRegistrationDetailsActionNew
 */
@WebServlet("/ViewEISRegistrationDetailsActionNew")
public class ViewEISRegistrationDetailsActionNew extends HttpServlet {
	private static final long serialVersionUID = 1L;
       
    /**
     * @see HttpServlet#HttpServlet()
     */
    public ViewEISRegistrationDetailsActionNew() {
        super();
        // TODO Auto-generated constructor stub
    }

	/**
	 * @see HttpServlet#doGet(HttpServletRequest request, HttpServletResponse response)
	 */
	protected void doGet(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		// TODO Auto-generated method stub
		processRequest(request, response);
	}

	/**
	 * @see HttpServlet#doPost(HttpServletRequest request, HttpServletResponse response)
	 */
	protected void doPost(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
		// TODO Auto-generated method stub
		processRequest(request, response);
	}
	 protected void processRequest(HttpServletRequest request, HttpServletResponse response) 
	            throws ServletException, IOException {
	        
	        RegistrationActionForm regForm = new RegistrationActionForm();
	        regForm.setM_strmsg("clear");
	        
	        String action = request.getParameter("action");
	        String empId = request.getParameter("empid");
	        
	        if (action != null && action.equals("delete") && empId != null && !empId.isEmpty()) {
	            try {
	                deleteEmployeeDetails(empId, regForm);
	            } catch (SQLException e) {
	                e.printStackTrace();
	                regForm.setM_strmsg("error");
	            }
	        }
	        
	        try {
	            viewemployeedetailsdata(regForm);
	        } catch (SQLException e) {
	            e.printStackTrace();
	            regForm.setM_strmsg("error");
	        }
	        
	        request.setAttribute("RegForm", regForm);
	        RequestDispatcher dispatcher = request.getRequestDispatcher("/jsp/ViewEISRegistrationDetailsNew.jsp");
	        dispatcher.forward(request, response);
	    }
	    
	    private void deleteEmployeeDetails(String empId, RegistrationActionForm regForm) throws SQLException {
	        Connection conn = null;
	        Statement stmt = null;
	        ResultSet rs = null;
	        
	        try {
	            conn = DBUtilityAuto.getReportDBConnection();
	            stmt = conn.createStatement();
	            
	            // First get file paths
	            String selectQuery = "SELECT * FROM eisupport_employee_master WHERE EMPLOYEE_ID='" + empId + "'";
	            rs = stmt.executeQuery(selectQuery);
	            
	            if (rs.next()) {
	                // Delete associated files
	                deleteFile(rs.getString("BGC_DOCUMENT_PATH"), "BGC");
	                deleteFile(rs.getString("PHOTO_PATH"), "PHOTO");
	                deleteFile(rs.getString("POLICE_VERIFICATION_PATH"), "Police");
	                deleteFile(rs.getString("CV_DOCUMENT_PATH"), "CV");
	                
	                // Delete database record
	                String deleteQuery = "DELETE FROM eisupport_employee_master WHERE EMPLOYEE_ID='" + empId + "'";
	                int rowsDeleted = stmt.executeUpdate(deleteQuery);
	                
	                if (rowsDeleted > 0) {
	                    regForm.setM_strmsg("delete");
	                    System.out.println("Employee " + empId + " deleted successfully.");
	                } else {
	                    regForm.setM_strmsg("error");
	                    System.out.println("Failed to delete employee " + empId);
	                }
	            } else {
	                regForm.setM_strmsg("error");
	                System.out.println("Employee " + empId + " not found.");
	            }
	            
	        } catch (Exception e) {
	            regForm.setM_strmsg("error");
	            e.printStackTrace();
	        } finally {
	            closeResources(rs, stmt, conn);
	        }
	    }
	    
	    private void deleteFile(String filePath, String folder) {
	        if (filePath != null && !filePath.trim().isEmpty()) {
	            try {
	                String basePath = System.getProperty("catalina.base");
	                String fullPath = basePath + "/webapps/EISEMPLOYEEDOCUMENT/" + folder + "/" + filePath;
	                File file = new File(fullPath);
	                
	                if (file.exists()) {
	                    if (file.delete()) {
	                        System.out.println(folder + " file deleted: " + filePath);
	                    } else {
	                        System.out.println("Failed to delete " + folder + " file: " + filePath);
	                    }
	                }
	            } catch (Exception e) {
	                System.out.println("Error deleting file: " + e.getMessage());
	            }
	        }
	    }
	    
	    private void viewemployeedetailsdata(RegistrationActionForm regForm) throws SQLException {
	        Connection conn = null;
	        Statement stmt = null;
	        ResultSet rs = null;
	        
	        try {
	            conn = DBUtilityAuto.getReportDBConnection();
	            stmt = conn.createStatement();
	            String query = "SELECT * FROM eisupport_employee_master ORDER BY EMPLOYEE_ID";
	            rs = stmt.executeQuery(query);
	            
	            List<EmployeeDetailsBean> employeeList = new ArrayList<>();
	            
	            while (rs.next()) {
	                EmployeeDetailsBean employee = new EmployeeDetailsBean();
	                
	                employee.setM_strEmployee_ID(rs.getString("EMPLOYEE_ID"));
	                employee.setM_strAD_ID(rs.getString("AD_ID"));
	                employee.setM_strHID(rs.getString("HID"));
	                employee.setM_strAsset_ID(rs.getString("ASSET_ID"));
	                employee.setM_strEducation_Qualification(rs.getString("EDU_QUALIFICATION"));
	                employee.setM_strTCS_Joining_Date(rs.getString("TCS_JOINING_DATE"));
	                employee.setM_strEmployee_contact_Number(rs.getString("CONTACTNUMBER"));
	                employee.setM_strEmergency_contact_Number(rs.getString("EMERGENCY_CONTACTNUMBER"));
	                employee.setM_strTeam(rs.getString("TEAM"));
	                employee.setM_strTCS_mail_ID(rs.getString("TCS_MAILID"));
	                employee.setM_strSBI_mail_ID(rs.getString("SBI_MAILID"));
	                employee.setM_strState(rs.getString("STATE"));
	                employee.setM_strCity(rs.getString("CITY"));
	                employee.setM_strLocal_Address(rs.getString("LOCAL_ADDRESS"));
	                employee.setM_strGender(rs.getString("GENDER"));
	                employee.setM_strDate_Of_Birth(rs.getString("DOB"));
	                employee.setM_strFirst_Name(rs.getString("FIRSTNAME"));
	                employee.setM_strMiddle_Name(rs.getString("MIDDLENAME"));
	                employee.setM_strLast_Name(rs.getString("LASTNAME"));
	                employee.setM_strVPN_Hostname(rs.getString("VPN_HOSTNAME"));
	                employee.setM_strLaptop_Hostname(rs.getString("LAPTOP_HOSTNAME"));
	                employee.setM_strRemote_Type(rs.getString("REMOTETYPE"));
	                employee.setM_strVPN_VDI_MAC_Address(rs.getString("VPN_VDI_MACADDRESS"));
	                employee.setM_strVPN_VDI_IP_Address(rs.getString("VPN_VDI_IPADDRESS"));
	             // Handle BLOB/CLOB columns - these might be file paths or actual BLOBs
	                String cvDocument = getColumnValue(rs, "CV_DOCUMENT_PATH");
	                String bgcDocument = getColumnValue(rs, "BGC_DOCUMENT_PATH");
	                String photoPath = getColumnValue(rs, "PHOTO_PATH");
	                String policeVerification = getColumnValue(rs, "POLICE_VERIFICATION_PATH");
	               
	                employee.setM_strCV_Document(cvDocument);
	                employee.setM_strBGC_Documents_Path(bgcDocument);
	                employee.setM_strPhoto_Path(photoPath);
	                employee.setM_strPolice_Verification_Path(policeVerification);

	                employee.setM_strUserName(rs.getString("USERNAME"));
	                employee.setM_strPassword(rs.getString("password"));
	                employee.setM_strISACTIVE(rs.getString("ISACTIVE"));
	                
	                employeeList.add(employee);
	            }
	            
	            regForm.setM_lstViewEmployeeRegistrationdetail(employeeList);
	            System.out.println("Loaded " + employeeList.size() + " employee records.");
	            
	        } catch (Exception e) {
	            e.printStackTrace();
	            regForm.setM_strmsg("error");
	        } finally {
	            closeResources(rs, stmt, conn);
	        }
	    }
	    
	    private String getColumnValue(ResultSet rs, String columnName) throws SQLException {
	        try {
	          // First try to get as String (for VARCHAR columns)
	          return rs.getString(columnName);
	        } catch (SQLException e) {
	          // If getString fails, it might be a BLOB/CLOB
	          try {
	            Object obj = rs.getObject(columnName);
	            if (obj == null) {
	              return null;
	            } else if (obj instanceof Blob) {
	              Blob blob = (Blob) obj;
	              // For BLOB, you might want to read as bytes or store as file
	              // Since it's a file path, return the blob length or handle differently
	              return "[BLOB - Size: " + blob.length() + " bytes]";
	            } else if (obj instanceof Clob) {
	              Clob clob = (Clob) obj;
	              // For CLOB, read the string content
	              return clob.getSubString(1, (int) Math.min(clob.length(), 1000));
	            } else {
	              return obj.toString();
	            }
	          } catch (Exception ex) {
	            System.out.println("Error getting column " + columnName + ": " + ex.getMessage());
	            return null;
	          }
	        }
	      }
	    private void closeResources(ResultSet rs, Statement stmt, Connection conn) {
	        try {
	            if (rs != null) rs.close();
	        } catch (SQLException e) {
	            e.printStackTrace();
	        }
	        try {
	            if (stmt != null) stmt.close();
	        } catch (SQLException e) {
	            e.printStackTrace();
	        }
	        try {
	            if (conn != null) conn.close();
	        } catch (SQLException e) {
	            e.printStackTrace();
	        }
	    }
	}

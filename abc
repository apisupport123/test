<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<title>EIS Portal — Home</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="js/jquery.min.js"></script>
<style>
:root{
  --brand:#F86F03;
  --brand-dark:#E85D00;
  --brand-light:#FFF4EC;
  --text:#0A0A0A;
  --muted:#6B7280;
  --line:#E5E7EB;
  --bg:#FAFAFA;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:'Plus Jakarta Sans',system-ui,sans-serif;
  background:var(--bg);
  color:var(--text);
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
a{color:inherit;text-decoration:none}

/* ============ MAIN CONTENT AREA ============ */
.welcome-wrap{
  margin-left:64px; /* hamburger space */
  min-height:100vh;
  display:flex;
  flex-direction:column;
  padding:0;
  background:
    radial-gradient(900px 500px at 100% 0%, rgba(248,111,3,.08), transparent 60%),
    radial-gradient(700px 400px at 0% 100%, rgba(248,111,3,.05), transparent 60%),
    var(--bg);
}

.hero{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:56px 40px 32px;
  position:relative;
}
.hero-inner{
  max-width:1080px;
  width:100%;
  display:grid;
  grid-template-columns: 1.1fr 1fr;
  gap:56px;
  align-items:center;
}

.hero-text .eyebrow{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:6px 14px;
  background:var(--brand-light);
  color:var(--brand);
  font-size:.75rem;
  font-weight:700;
  letter-spacing:.5px;
  text-transform:uppercase;
  border-radius:999px;
  margin-bottom:20px;
}
.hero-text .eyebrow .dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--brand);
  animation:blink 2s ease-in-out infinite;
}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}

.hero-text h1{
  font-size:3rem;
  font-weight:800;
  letter-spacing:-1.5px;
  line-height:1.1;
  margin-bottom:18px;
  color:var(--text);
}
.hero-text h1 .accent{
  background:linear-gradient(135deg, var(--brand) 0%, #FF9A3D 100%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}
.hero-text p{
  font-size:1.05rem;
  line-height:1.7;
  color:var(--muted);
  max-width:480px;
  margin-bottom:32px;
}
.hero-text .stats{
  display:flex;
  gap:36px;
  padding-top:24px;
  border-top:1px solid var(--line);
}
.stat-item .num{
  font-size:1.6rem;
  font-weight:800;
  color:var(--text);
  letter-spacing:-.5px;
}
.stat-item .lbl{
  font-size:.8rem;
  color:var(--muted);
  font-weight:500;
  margin-top:2px;
}

.hero-visual{
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
}
.hero-visual img{
  width:100%;
  max-width:460px;
  filter:drop-shadow(0 20px 40px rgba(248,111,3,.15));
  animation:float 6s ease-in-out infinite;
}
@keyframes float{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-12px)}
}

/* ============ FOOTER ============ */
.foot{
  padding:20px 40px;
  border-top:1px solid var(--line);
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-size:.82rem;
  color:var(--muted);
  margin-left:0;
}
.foot .brandline{
  font-weight:600;
  color:var(--text);
}
.foot .brandline span{color:var(--brand)}

/* ============ RESPONSIVE ============ */
@media (max-width: 900px){
  .welcome-wrap{margin-left:56px}
  .hero{padding:40px 24px}
  .hero-inner{grid-template-columns:1fr;gap:32px}
  .hero-text h1{font-size:2.2rem}
  .hero-visual img{max-width:340px}
  .hero-text .stats{gap:24px}
  .foot{flex-direction:column;gap:6px;text-align:center;padding:16px 20px}
}
@media (max-width: 480px){
  .hero-text h1{font-size:1.8rem}
  .hero-text p{font-size:.95rem}
  .stat-item .num{font-size:1.3rem}
  .hero{padding:32px 18px}
}
</style>
</head>
<body>

<!-- ✅ Header include — as is, no changes -->
<%@include file="./userheader.jsp"%>

<div class="welcome-wrap">
  <section class="hero">
    <div class="hero-inner">

      <div class="hero-text">
        <div class="eyebrow">
          <span class="dot"></span>
          System Online
        </div>
        <h1>Welcome to <span class="accent">EIS Portal</span></h1>
        <p>
          Your unified command center for enterprise monitoring, deployment tracking,
          incident management, and operational dashboards — all in one secure place.
        </p>

        <div class="stats">
          <div class="stat-item">
            <div class="num">24×7</div>
            <div class="lbl">Uptime</div>
          </div>
          <div class="stat-item">
            <div class="num">100+</div>
            <div class="lbl">Services</div>
          </div>
          <div class="stat-item">
            <div class="num">EIS</div>
            <div class="lbl">Automation Team</div>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <img src="./images/Cybersecurity.png" alt="EIS Portal">
      </div>

    </div>
  </section>

  <footer class="foot">
    <div class="brandline">EIS <span>Portal</span> · Internal Use Only</div>
    <div>Designed &amp; Developed by EIS Automation Team</div>
  </footer>
</div>

</body>
</html>




response.setIntHeader("Refresh", 600);

Connection conn=DBUtilityAuto.getReportDBConnection();

String sql="SELECT txn_endpoint, total_hits, td_count, td_percent from ( SELECT txn_endpoint, total_hits, td_count, td_percent from txnendpoint WHERE time >= SYSTIMESTAMP - INTERVAL '10' MINUTE order by td_percent desc) where rownum <= 12";

System.out.println(sql);
Statement statement=conn.createStatement();
ResultSet resultSet= statement.executeQuery(sql);

List<String> labels= new ArrayList<String>();
List<Double> failure= new ArrayList<Double>();
int j=0;
while(resultSet.next()){
    String name="<p style='color:#ff9933; font-weight: bolder; '>"+Integer.toString(resultSet.getInt("td_count"))+"</p><br><p style='color:#FFFFFF; font-weight: bolder;'>"+resultSet.getString("txn_endpoint").replaceAll("_", "</p><br><p style='color:#FFFFFF; font-weight: bolder;'>")+"</p><br>"+"<p style='color:#32CD32; font-weight: bolder;'>"+Integer.toString(resultSet.getInt("total_hits")) +"</p>";

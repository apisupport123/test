<%!
public String formatAPINameWithLineBreaks(String apiName) {
    if (apiName == null || apiName.isEmpty()) return "";
    apiName = apiName.replace("_", " ");
    if (apiName.length() <= 16) return apiName;
    StringBuilder formatted = new StringBuilder();
    for (int i = 0; i < apiName.length(); i += 16) {
        if (i > 0) {
            formatted.append("</p><br><p class='ep-name' style='font-weight: bolder; font-size: 15px'>");
        }
        int endIndex = Math.min(i + 16, apiName.length());
        formatted.append(apiName.substring(i, endIndex));
    }
    return formatted.toString();
}

public String formatBrokerNameOnly(String brokerName) {
    if (brokerName == null || brokerName.trim().isEmpty()) {
        return "<span style='color:#FFA500; font-weight:bold; font-size:13px;'>N/A</span>";
    }
    return "<span style='color:#FFA500; font-weight:bold; font-size:13px;'>" + brokerName + "</span>";
}
%>

<%
/* ============ Data holders ============ */
class ExpDataHolder {
    List<String> labels = new ArrayList<>();
    List<Double> values = new ArrayList<>();
    List<String> apiNames = new ArrayList<>();
    List<String> brokerNames = new ArrayList<>();
    List<String> errorCodes = new ArrayList<>();
    boolean loaded = false;
}

class SysDataHolder {
    List<String> labels = new ArrayList<>();
    List<Double> values = new ArrayList<>();
    List<String> apiNames = new ArrayList<>();
    List<String> brokerNames = new ArrayList<>();
    List<String> errorCodes = new ArrayList<>();
    boolean loaded = false;
}

final ExpDataHolder expHolder = new ExpDataHolder();
final SysDataHolder sysHolder = new SysDataHolder();

Thread expThread = new Thread(new Runnable() {
    public void run() {
        try {
            Connection conn = null;
            String flagStatus = null;
            String sql = null;

            try (Connection conn1 = DBUtilityAuto.getReportDBConnection();
                 Statement smt = conn1.createStatement();
                 ResultSet rs = smt.executeQuery("SELECT FLAG FROM connection_master")) {
                if (rs.next()) {
                    flagStatus = rs.getString("FLAG");
                    if (flagStatus == null) flagStatus = "DR";
                }
            } catch(Exception e) { flagStatus = "DR"; }

            try {
                conn = DBUtilityAuto.getReportDBConnection();
                String dbLink = flagStatus.equalsIgnoreCase("PR") ? "MIDB_LINK" : "HIDB_LINK";

                sql = "WITH filtered_logs AS ( "
                    + " SELECT /*+MATERIALIZE*/ API_NAME, BROKER_NAME, error_code, "
                    + " CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) AND error_code <> '00014' THEN 1 ELSE 0 END AS is_td_error "
                    + " FROM eisapp.API_LOG@" + dbLink + " "
                    + " WHERE REQUEST_DATE_TIME >= SYSDATE - INTERVAL '10' MINUTE "
                    + " AND API_NAME NOT LIKE '%gen.%' "
                    + " AND trim(CONCAT(API_NAME, SOURCE_ID) || error_description) NOT IN ( "
                    + "   SELECT trim(CONCAT(API_NAME, SOURCE_ID) || error_description) FROM vaild_bd_master "
                    + " ) "
                    + ") "
                    + "SELECT * FROM ( "
                    + " SELECT API_NAME, BROKER_NAME, COUNT(1) AS TOTAL_HITS, SUM(is_td_error) AS TD_COUNT, "
                    + " ROUND(SUM(is_td_error) * 100 / COUNT(1), 2) AS TD_PERCENT, "
                    + " TRIM(',' FROM "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI001' THEN 1 ELSE 0 END) > 0 THEN ',SI001' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI002' THEN 1 ELSE 0 END) > 0 THEN ',SI002' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN substr(error_code,3,3) = '002' AND error_code <> 'SI002' THEN 1 ELSE 0 END) > 0 THEN ',DYNAMIC 002' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI007' AND error_code <> '70007' THEN 1 ELSE 0 END) > 0 THEN ',SI007' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI051' THEN 1 ELSE 0 END) > 0 THEN ',SI051' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN substr(error_code,3,3) = '014' AND error_code <> '00014' THEN 1 ELSE 0 END) > 0 THEN ',014' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI569' THEN 1 ELSE 0 END) > 0 THEN ',SI569' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI570' THEN 1 ELSE 0 END) > 0 THEN ',SI570' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI015' THEN 1 ELSE 0 END) > 0 THEN ',SI015' ELSE '' END "
                    + " ) AS ACTIVE_ERROR_CODES "
                    + " FROM filtered_logs GROUP BY API_NAME, BROKER_NAME "
                    + " HAVING ROUND(SUM(is_td_error) * 100 / COUNT(1), 2) >= 0.5 "
                    + " ORDER BY TD_PERCENT DESC "
                    + ") WHERE ROWNUM <= 10";

                System.out.println("EXP Query :- " + sql);
                Statement statement = conn.createStatement();
                ResultSet resultSet = statement.executeQuery(sql);

                while (resultSet.next()) {
                    String brokerNameOnly = resultSet.getString("BROKER_NAME");
                    String formattedBrokerOnly = formatBrokerNameOnly(brokerNameOnly);
                    String name = "<p style='color:#ff9933; font-weight: bolder;font-size: 15px'>"
                        + Integer.toString(resultSet.getInt("TD_COUNT"))
                        + "</p><br><p class='ep-name' style='font-weight: bolder;font-size: 15px'>"
                        + formatAPINameWithLineBreaks(resultSet.getString("API_NAME"))
                        + "</p><br>" + formattedBrokerOnly
                        + "<br><p style='color:#32CD32; font-weight: bolder;font-size: 15px'>"
                        + Integer.toString(resultSet.getInt("TOTAL_HITS")) + "</p>";
                    expHolder.labels.add(name);
                    expHolder.values.add(resultSet.getDouble("TD_PERCENT"));
                    expHolder.apiNames.add(resultSet.getString("API_NAME"));
                    expHolder.brokerNames.add(brokerNameOnly == null ? "N/A" : brokerNameOnly);
                    String activeErrorCodes = resultSet.getString("ACTIVE_ERROR_CODES");
                    if (activeErrorCodes == null || activeErrorCodes.trim().isEmpty()) activeErrorCodes = "None";
                    expHolder.errorCodes.add(activeErrorCodes);
                }
                resultSet.close();
                statement.close();
            } catch (Exception e) { e.printStackTrace(); }
            finally { if (conn != null) try { conn.close(); } catch (Exception e) {} }
            expHolder.loaded = true;
        } catch(Exception e) { e.printStackTrace(); expHolder.loaded = true; }
    }
});

Thread sysThread = new Thread(new Runnable() {
    public void run() {
        try {
            Connection connSys = null;
            try {
                connSys = DBUtilityAuto.getIIBDBConnection();
                ZonedDateTime CurrentDate = ZonedDateTime.now(ZoneId.of("Asia/Kolkata"));
                DateTimeFormatter formatter = DateTimeFormatter.ofPattern("MMM_yy").withLocale(Locale.US);
                String PART = CurrentDate.format(formatter).toUpperCase();

                String SysSql = "WITH filtered_logs AS ( "
                    + " SELECT /*+PARALLEL(04)*/ API_NAME, SYS_BROKER, error_code, "
                    + " CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) AND error_code <> '00014' THEN 1 ELSE 0 END AS is_td_error "
                    + " FROM eisapp.backend_log PARTITION(" + PART + ") "
                    + " WHERE REQUEST_DATE_TIME >= SYSDATE - INTERVAL '10' MINUTE "
                    + " AND API_NAME NOT LIKE '%gen.%' "
                    + ") "
                    + "SELECT * FROM ( "
                    + " SELECT API_NAME, SYS_BROKER, COUNT(1) AS TOTAL_HITS, SUM(is_td_error) AS TD_COUNT, "
                    + " ROUND(SUM(is_td_error) * 100 / COUNT(1), 2) AS TD_PERCENT, "
                    + " TRIM(',' FROM "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI001' THEN 1 ELSE 0 END) > 0 THEN ',SI001' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI002' THEN 1 ELSE 0 END) > 0 THEN ',SI002' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN substr(error_code,3,3) = '002' AND error_code <> 'SI002' THEN 1 ELSE 0 END) > 0 THEN ',DYNAMIC 002' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI007' AND error_code <> '70007' THEN 1 ELSE 0 END) > 0 THEN ',SI007' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI051' THEN 1 ELSE 0 END) > 0 THEN ',SI051' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN substr(error_code,3,3) = '014' AND error_code <> '00014' THEN 1 ELSE 0 END) > 0 THEN ',014' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI569' THEN 1 ELSE 0 END) > 0 THEN ',SI569' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI570' THEN 1 ELSE 0 END) > 0 THEN ',SI570' ELSE '' END || "
                    + " CASE WHEN SUM(CASE WHEN error_code = 'SI015' THEN 1 ELSE 0 END) > 0 THEN ',SI015' ELSE '' END "
                    + " ) AS ACTIVE_ERROR_CODES "
                    + " FROM filtered_logs GROUP BY API_NAME, SYS_BROKER "
                    + " HAVING COUNT(1)>10 "
                    + " ORDER BY TD_PERCENT DESC "
                    + ") WHERE ROWNUM <= 10";

                System.out.println("SYS Query :- " + SysSql);
                Statement statement = connSys.createStatement();
                ResultSet resultSet = statement.executeQuery(SysSql);

                while (resultSet.next()) {
                    String sysBrokerOnly = resultSet.getString("SYS_BROKER");
                    String formattedSysBrokerOnly = formatBrokerNameOnly(sysBrokerOnly);
                    String name = "<p style='color:#ff9933; font-weight: bolder; font-size: 15px'>"
                        + Integer.toString(resultSet.getInt("TD_COUNT"))
                        + "</p><br><p class='ep-name' style='font-weight: bolder;font-size: 15px'>"
                        + formatAPINameWithLineBreaks(resultSet.getString("API_NAME"))
                        + "</p><br>" + formattedSysBrokerOnly
                        + "<br><p style='color:#32CD32; font-weight: bolder;font-size: 15px'>"
                        + Integer.toString(resultSet.getInt("TOTAL_HITS")) + "</p>";
                    sysHolder.labels.add(name);
                    sysHolder.values.add(resultSet.getDouble("TD_PERCENT"));
                    sysHolder.apiNames.add(resultSet.getString("API_NAME"));
                    sysHolder.brokerNames.add(sysBrokerOnly == null ? "N/A" : sysBrokerOnly);
                    String activeErrorCodes = resultSet.getString("ACTIVE_ERROR_CODES");
                    if (activeErrorCodes == null || activeErrorCodes.trim().isEmpty()) activeErrorCodes = "None";
                    sysHolder.errorCodes.add(activeErrorCodes);
                }
                resultSet.close();
                statement.close();
            } catch (Exception e) { e.printStackTrace(); }
            finally { if (connSys != null) try { connSys.close(); } catch (Exception e) {} }
            sysHolder.loaded = true;
        } catch(Exception e) { e.printStackTrace(); sysHolder.loaded = true; }
    }
});

expThread.start();
sysThread.start();
expThread.join();
sysThread.join();

request.setAttribute("expLabels", expHolder.labels);
request.setAttribute("expValues", expHolder.values);
request.setAttribute("expApiNames", expHolder.apiNames);
request.setAttribute("expBrokerNames", expHolder.brokerNames);
request.setAttribute("expErrorCodes", expHolder.errorCodes);
request.setAttribute("sysLabels", sysHolder.labels);
request.setAttribute("sysValues", sysHolder.values);
request.setAttribute("sysApiNames", sysHolder.apiNames);
request.setAttribute("sysBrokerNames", sysHolder.brokerNames);
request.setAttribute("sysErrorCodes", sysHolder.errorCodes);

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Team Roster &mdash; EIS Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

<style>
/* ============================================================
   DESIGN TOKENS
   ============================================================ */
:root{
  --gray-0:#FFFFFF;
  --gray-25:#FCFCFD;
  --gray-50:#F9FAFB;
  --gray-100:#F2F4F7;
  --gray-200:#EAECF0;
  --gray-300:#D0D5DD;
  --gray-400:#98A2B3;
  --gray-500:#667085;
  --gray-600:#475467;
  --gray-700:#344054;
  --gray-800:#1D2939;
  --gray-900:#101828;

  --accent:#635BFF;
  --accent-hover:#5249E0;
  --accent-soft:#EEF0FF;
  --accent-line:#C7CBFF;

  --success:#12B76A;
  --warning:#F79009;
  --danger:#F04438;

  /* Shift colors */
  --m-bg:#FFF6ED; --m-fg:#C4320A; --m-bd:#F9DBAF;
  --d-bg:#F2F4F7; --d-fg:#344054; --d-bd:#D0D5DD;
  --a-bg:#FFFAEB; --a-fg:#B54708; --a-bd:#FEDF89;
  --n-bg:#EFF8FF; --n-fg:#175CD3; --n-bd:#B2DDFF;
  --w-bg:#EEF4FF; --w-fg:#3538CD; --w-bd:#C7D7FE;
  --l-bg:#FEF3F2; --l-fg:#B42318; --l-bd:#FECDCA;
  --f-bg:#FDF2FA; --f-fg:#C11574; --f-bd:#FCCEEE;
  --h-bg:#ECFDF3; --h-fg:#027A48; --h-bd:#A6F4C5;
  --x-bg:#F9FAFB; --x-fg:#98A2B3; --x-bd:#EAECF0;

  --bg-page:var(--gray-50);
  --bg-surface:var(--gray-0);
  --bg-subtle:var(--gray-25);
  --border:var(--gray-200);
  --border-strong:var(--gray-300);
  --text-primary:var(--gray-900);
  --text-secondary:var(--gray-600);
  --text-tertiary:var(--gray-500);

  --radius-sm:6px;
  --radius-md:8px;
  --radius-lg:12px;

  --shadow-xs:0 1px 2px 0 rgba(16,24,40,.05);
  --shadow-sm:0 1px 3px 0 rgba(16,24,40,.10);
  --shadow-md:0 4px 8px -2px rgba(16,24,40,.10);
  --shadow-lg:0 12px 16px -4px rgba(16,24,40,.10);
  --shadow-xl:0 20px 24px -4px rgba(16,24,40,.10);

  --font:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,monospace;
}

html[data-theme="dark"]{
  --gray-0:#0B0E14;
  --gray-25:#10131A;
  --gray-50:#12161D;
  --gray-100:#171B23;
  --gray-200:#22262F;
  --gray-300:#2E333C;
  --gray-400:#5A6270;
  --gray-500:#8A94A6;
  --gray-600:#A6B0C2;
  --gray-700:#C4CCDA;
  --gray-800:#E1E6EF;
  --gray-900:#F5F7FA;

  --accent:#8B83FF;
  --accent-hover:#A29AFF;
  --accent-soft:#1E1B4B;
  --accent-line:#3730A3;

  --m-bg:#3A1D0A; --m-fg:#FDB022; --m-bd:#5C2C0F;
  --d-bg:#1A1E26; --d-fg:#A6B0C2; --d-bd:#2E333C;
  --a-bg:#3D2A05; --a-fg:#FDB022; --a-bd:#5C3F0F;
  --n-bg:#0A2540; --n-fg:#53B1FD; --n-bd:#0F3A66;
  --w-bg:#1E1B4B; --w-fg:#8B83FF; --w-bd:#3730A3;
  --l-bg:#3A1211; --l-fg:#F97066; --l-bd:#5A1A18;
  --f-bg:#3D1030; --f-fg:#F670C7; --f-bd:#5E1A4A;
  --h-bg:#052E1F; --h-fg:#32D583; --h-bd:#0A5133;
  --x-bg:#12161D; --x-fg:#5A6270; --x-bd:#22262F;

  --bg-page:var(--gray-50);
  --bg-surface:var(--gray-25);
  --bg-subtle:var(--gray-0);
  --border:var(--gray-200);
  --border-strong:var(--gray-300);
  --text-primary:var(--gray-900);
  --text-secondary:var(--gray-600);
  --text-tertiary:var(--gray-500);

  --shadow-xs:0 1px 2px 0 rgba(0,0,0,.4);
  --shadow-sm:0 1px 3px 0 rgba(0,0,0,.5);
  --shadow-md:0 4px 8px -2px rgba(0,0,0,.4);
  --shadow-lg:0 12px 16px -4px rgba(0,0,0,.5);
  --shadow-xl:0 20px 24px -4px rgba(0,0,0,.6);
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--font);
  font-size:14px;
  line-height:1.5;
  background:var(--bg-page);
  color:var(--text-primary);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  transition:background-color .2s ease, color .2s ease;
  overflow-x:hidden;
}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}

/* ============================================================
   APP BAR — compact
   ============================================================ */
.appbar{
  position:sticky; top:0; z-index:100;
  background:var(--bg-surface);
  border-bottom:1px solid var(--border);
  height:56px;
  display:flex; align-items:center;
  padding:0 20px; gap:14px;
}
.appbar-logo{
  width:28px;height:28px;border-radius:7px;
  background:linear-gradient(135deg,var(--accent), #7A5CFF);
  display:grid;place-items:center;color:#fff;
}
.appbar-logo svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.4;}
.appbar-title{font-size:14px;font-weight:700;letter-spacing:-.2px;}
.appbar-title .crumb{color:var(--text-tertiary);font-weight:500;margin-left:4px;}
.appbar-spacer{flex:1;}
.appbar-actions{display:flex;align-items:center;gap:4px;}

.icon-btn{
  width:34px;height:34px;
  display:grid;place-items:center;
  border-radius:var(--radius-md);
  color:var(--text-secondary);
  transition:all .15s ease;
}
.icon-btn:hover{
  background:var(--bg-subtle); color:var(--text-primary);
}
.icon-btn svg{
  width:17px;height:17px;
  stroke:currentColor;fill:none;
  stroke-width:1.8;
  stroke-linecap:round;stroke-linejoin:round;
}
.icon-btn .icon-sun{display:block;}
.icon-btn .icon-moon{display:none;}
html[data-theme="dark"] .icon-btn .icon-sun{display:none;}
html[data-theme="dark"] .icon-btn .icon-moon{display:block;}

.user-chip{
  display:flex; align-items:center; gap:7px;
  padding:4px 10px 4px 4px;
  border-radius:999px;
  border:1px solid var(--border);
  transition:all .15s ease;
  margin-left:4px;
}
.user-chip:hover{border-color:var(--border-strong); background:var(--bg-subtle);}
.user-chip .avatar{
  width:24px;height:24px;border-radius:50%;
  background:linear-gradient(135deg,var(--accent),#7A5CFF);
  color:#fff;display:grid;place-items:center;
  font-size:10px;font-weight:700;
}
.user-chip .name{font-size:12px;font-weight:600;}

/* ============================================================
   CONTEXT ROW — single compact line
   ============================================================ */
.context-row{
  background:var(--bg-surface);
  border-bottom:1px solid var(--border);
  padding:14px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  flex-wrap:wrap;
}
.context-left{
  display:flex;
  align-items:baseline;
  gap:16px;
  flex-wrap:wrap;
}
.context-title{
  font-size:17px;
  font-weight:700;
  letter-spacing:-.3px;
  color:var(--text-primary);
}
.context-title .accent{color:var(--accent);}
.context-meta{
  display:flex; align-items:center; gap:8px;
  font-size:12px; color:var(--text-tertiary); font-weight:500;
}
.context-meta b{color:var(--text-primary); font-weight:600;}
.context-meta .sep{
  width:3px;height:3px;border-radius:50%;background:var(--gray-300);
}

.context-right{
  display:flex;
  align-items:center;
  gap:8px;
}

/* Compact inputs */
.c-input{
  font-family:var(--font);
  font-size:13px;
  font-weight:500;
  color:var(--text-primary);
  background:var(--bg-surface);
  border:1px solid var(--border-strong);
  border-radius:var(--radius-md);
  padding:6px 10px;
  outline:none;
  transition:all .15s ease;
  height:34px;
}
.c-input:focus{
  border-color:var(--accent);
  box-shadow:0 0 0 3px var(--accent-soft);
}

.btn{
  display:inline-flex; align-items:center; gap:6px;
  padding:6px 14px;
  font-family:var(--font); font-size:13px; font-weight:600;
  border-radius:var(--radius-md);
  border:1px solid transparent;
  transition:all .15s ease;
  height:34px;
  white-space:nowrap;
}
.btn svg{
  width:14px;height:14px;
  stroke:currentColor;fill:none;stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round;
}
.btn-primary{background:var(--accent); color:#fff;}
.btn-primary:hover{background:var(--accent-hover);}

/* ============================================================
   TOOLBAR — single line, compact
   ============================================================ */
.toolbar{
  background:var(--bg-page);
  padding:12px 20px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}
.toolbar-left{
  display:flex; align-items:center; gap:10px;
}
.search-input{
  position:relative;
  display:flex; align-items:center;
  width:280px;
}
.search-input svg{
  position:absolute; left:11px;
  width:14px;height:14px;
  stroke:var(--text-tertiary); fill:none; stroke-width:2;
  pointer-events:none;
}
.search-input input{
  width:100%;
  font-family:var(--font); font-size:13px; font-weight:500;
  background:var(--bg-surface);
  border:1px solid var(--border-strong);
  border-radius:var(--radius-md);
  padding:7px 12px 7px 32px;
  outline:none;
  color:var(--text-primary);
  transition:all .15s ease;
  height:34px;
}
.search-input input::placeholder{color:var(--text-tertiary);}
.search-input input:focus{
  border-color:var(--accent);
  box-shadow:0 0 0 3px var(--accent-soft);
}

.toolbar-right{
  display:flex; align-items:center; gap:8px;
}
.stat-inline{
  display:inline-flex; align-items:center; gap:6px;
  padding:5px 10px;
  background:var(--bg-surface);
  border:1px solid var(--border);
  border-radius:var(--radius-md);
  font-size:12px; font-weight:500;
  color:var(--text-secondary);
}
.stat-inline b{color:var(--text-primary); font-weight:700; font-variant-numeric:tabular-nums;}

/* Legend trigger button */
.legend-trigger{
  display:inline-flex; align-items:center; gap:6px;
  padding:5px 12px;
  background:var(--bg-surface);
  border:1px solid var(--border-strong);
  border-radius:var(--radius-md);
  font-size:12px; font-weight:600;
  color:var(--text-secondary);
  cursor:pointer;
  transition:all .15s ease;
  height:34px;
}
.legend-trigger:hover{
  border-color:var(--accent);
  color:var(--accent);
  background:var(--accent-soft);
}
.legend-trigger svg{
  width:14px;height:14px;
  stroke:currentColor;fill:none;stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round;
}

/* Legend Popover */
.legend-pop{
  position:absolute;
  top:calc(100% + 8px);
  right:0;
  z-index:200;
  background:var(--bg-surface);
  border:1px solid var(--border);
  border-radius:var(--radius-lg);
  box-shadow:var(--shadow-xl);
  padding:14px;
  width:340px;
  display:none;
}
.legend-pop.open{display:block; animation:pop .15s ease;}
@keyframes pop{from{opacity:0;transform:translateY(-4px);}to{opacity:1;transform:translateY(0);}}

.legend-pop h4{
  font-size:11px; font-weight:700;
  text-transform:uppercase; letter-spacing:.5px;
  color:var(--text-tertiary);
  margin-bottom:10px;
}
.legend-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:6px;
}
.legend-item{
  display:flex; align-items:center; gap:8px;
  padding:6px 8px;
  border-radius:var(--radius-sm);
  font-size:12px;
  font-weight:500;
  color:var(--text-secondary);
  transition:background .1s ease;
}
.legend-item:hover{background:var(--bg-subtle);}
.legend-swatch{
  display:inline-flex;
  align-items:center; justify-content:center;
  width:26px; height:22px;
  border-radius:4px;
  font-size:10px; font-weight:800;
  border:1px solid;
  flex-shrink:0;
}
.legend-swatch.morning{background:var(--m-bg);color:var(--m-fg);border-color:var(--m-bd);}
.legend-swatch.general{background:var(--d-bg);color:var(--d-fg);border-color:var(--d-bd);}
.legend-swatch.afternoon{background:var(--a-bg);color:var(--a-fg);border-color:var(--a-bd);}
.legend-swatch.night{background:var(--n-bg);color:var(--n-fg);border-color:var(--n-bd);}
.legend-swatch.weekoff{background:var(--w-bg);color:var(--w-fg);border-color:var(--w-bd);}
.legend-swatch.leave{background:var(--l-bg);color:var(--l-fg);border-color:var(--l-bd);}
.legend-swatch.flexi{background:var(--f-bg);color:var(--f-fg);border-color:var(--f-bd);}
.legend-swatch.holiday{background:var(--h-bg);color:var(--h-fg);border-color:var(--h-bd);}
.legend-swatch.na{background:var(--x-bg);color:var(--x-fg);border-color:var(--x-bd);}

/* ============================================================
   ROSTER GRID
   ============================================================ */
.grid-wrap{
  padding:0 20px 90px;
  overflow-x:auto;
}
.roster-grid{
  width:100%;
  min-width:1200px;
  border-collapse:separate;
  border-spacing:0;
  background:var(--bg-surface);
  border:1px solid var(--border);
  border-radius:var(--radius-lg);
  overflow:hidden;
  font-size:13px;
}
.roster-grid thead th{
  position:sticky; top:0; z-index:10;
  background:var(--bg-subtle);
  padding:8px 6px;
  font-size:10px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.4px;
  color:var(--text-tertiary);
  border-bottom:1px solid var(--border);
  text-align:center;
  white-space:nowrap;
}
.roster-grid thead th .day-num{
  font-size:12px; font-weight:700;
  color:var(--text-primary);
  font-variant-numeric:tabular-nums;
}
.roster-grid thead th .day-name{
  display:block; font-size:9px; font-weight:600;
  color:var(--text-tertiary); margin-top:1px;
}
.roster-grid thead th.is-weekend{
  background:#FEF6EE; color:#C4320A;
}
html[data-theme="dark"] .roster-grid thead th.is-weekend{
  background:#3A1D0A; color:#FDB022;
}

.roster-grid thead th.col-emp{
  position:sticky; left:0; z-index:20;
  text-align:left; padding-left:16px;
  min-width:200px;
  background:var(--bg-subtle);
  box-shadow:1px 0 0 var(--border);
}
.roster-grid thead th.col-pos{
  position:sticky; left:200px; z-index:20;
  text-align:left; min-width:110px;
  background:var(--bg-subtle);
  box-shadow:1px 0 0 var(--border);
}
.roster-grid thead th.col-sum{min-width:44px; font-variant-numeric:tabular-nums;}

.roster-grid tbody td{
  padding:0;
  border-bottom:1px solid var(--border);
  vertical-align:middle;
  background:var(--bg-surface);
}
.roster-grid tbody tr:last-child td{border-bottom:none;}
.roster-grid tbody tr:hover td{background:var(--bg-subtle);}
.roster-grid tbody td.col-emp{
  position:sticky; left:0; z-index:5;
  padding:7px 14px 7px 16px;
  background:var(--bg-surface);
  box-shadow:1px 0 0 var(--border);
}
.roster-grid tbody tr:hover td.col-emp{background:var(--bg-subtle);}
.emp-row{display:flex; align-items:center; gap:9px;}
.emp-avatar{
  width:26px;height:26px;border-radius:50%;
  background:var(--gray-200); color:var(--text-secondary);
  display:grid;place-items:center;
  font-size:10px; font-weight:700; flex-shrink:0;
  border:1px solid var(--border);
}
.emp-name{
  font-size:13px; font-weight:600;
  color:var(--text-primary);
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  line-height:1.2;
}
.emp-id{
  font-size:10px; color:var(--text-tertiary);
  font-family:var(--mono); margin-top:1px;
}
.roster-grid tbody td.col-pos{
  position:sticky; left:200px; z-index:5;
  padding:7px 10px;
  background:var(--bg-surface);
  box-shadow:1px 0 0 var(--border);
  font-size:12px; font-weight:500;
  color:var(--text-secondary);
  white-space:nowrap;
}
.roster-grid tbody tr:hover td.col-pos{background:var(--bg-subtle);}

/* ============================================================
   SHIFT CELL — tight, badge + hidden native select
   ============================================================ */
.shift-cell{
  position:relative;
  padding:3px !important;
}
.shift-badge{
  display:flex; align-items:center; justify-content:center;
  width:100%; height:28px;
  border-radius:5px;
  font-size:10px; font-weight:700;
  letter-spacing:.2px;
  border:1px solid;
  font-variant-numeric:tabular-nums;
  transition:all .12s ease;
  pointer-events:none;
}
.shift-cell:hover .shift-badge{
  box-shadow:var(--shadow-sm);
}
.shift-badge.morning  {background:var(--m-bg);color:var(--m-fg);border-color:var(--m-bd);}
.shift-badge.general  {background:var(--d-bg);color:var(--d-fg);border-color:var(--d-bd);}
.shift-badge.afternoon{background:var(--a-bg);color:var(--a-fg);border-color:var(--a-bd);}
.shift-badge.night    {background:var(--n-bg);color:var(--n-fg);border-color:var(--n-bd);}
.shift-badge.weekoff  {background:var(--w-bg);color:var(--w-fg);border-color:var(--w-bd);}
.shift-badge.leave    {background:var(--l-bg);color:var(--l-fg);border-color:var(--l-bd);}
.shift-badge.flexi    {background:var(--f-bg);color:var(--f-fg);border-color:var(--f-bd);}
.shift-badge.holiday  {background:var(--h-bg);color:var(--h-fg);border-color:var(--h-bd);}
.shift-badge.na       {background:var(--x-bg);color:var(--x-fg);border-color:var(--x-bd);}

.shift-cell select.shift-native{
  position:absolute;
  inset:3px;
  width:calc(100% - 6px);
  height:28px;
  opacity:0;
  cursor:pointer;
  font-family:var(--font);
  font-size:10px;
  border-radius:5px;
  border:1px solid var(--border-strong);
}
.shift-cell select.shift-native:focus{
  opacity:1;
  box-shadow:var(--shadow-md);
  outline:2px solid var(--accent);
  outline-offset:-1px;
}

/* ============================================================
   SUMMARY ROWS
   ============================================================ */
.summary-row td{
  background:var(--bg-subtle) !important;
  padding:5px 6px !important;
  font-size:11px; font-weight:700;
  color:var(--text-primary);
  font-variant-numeric:tabular-nums;
  border-top:1px solid var(--border);
  text-align:center;
}
.summary-row td.col-emp{
  background:var(--bg-subtle) !important;
  font-size:10px; font-weight:600;
  text-transform:uppercase; letter-spacing:.4px;
  color:var(--text-tertiary);
  text-align:left;
  padding-left:16px !important;
}
.summary-row td.col-pos{
  background:var(--bg-subtle) !important;
}
.summary-row .pill{
  display:inline-flex; align-items:center; justify-content:center;
  min-width:22px; height:20px; padding:0 5px;
  background:var(--bg-surface);
  border:1px solid var(--border);
  border-radius:4px;
  font-size:10px; font-weight:700;
  color:var(--text-primary);
}

/* ============================================================
   ACTION BAR
   ============================================================ */
.action-bar{
  position:fixed; bottom:0; left:0; right:0; z-index:50;
  background:var(--bg-surface);
  border-top:1px solid var(--border);
  padding:10px 20px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  box-shadow:0 -1px 3px rgba(16,24,40,.06);
}
.action-info{
  display:flex; align-items:center; gap:10px;
  font-size:12px; color:var(--text-tertiary);
}
.action-info .dot{

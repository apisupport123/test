<div class="field">
    <label class="field-label"><span class="dot"></span>Team / Role</label>
    <select class="field-select" name="m_strRole" id="m_strRole">
        <option value="">Select Role</option>
        <%
            String[] roles = {
                "Incident Management",
                "Event Management",
                "EIS Bank",
                "Service Reporting Management",
                "Manager",
                "Problem Management",
                "Service Desk",
                "Process Improvement",
                "Team Lead",
                "EIS Infra",
                "EIS Development",
                "test"
            };
            String currentRole = emp.getM_strTeam() != null ? emp.getM_strTeam() : "";
            for (String r : roles) {
        %>
            <option value="<%=r%>" <%=r.equals(currentRole) ? "selected" : ""%>><%=r%></option>
        <% } %>
    </select>
</div>

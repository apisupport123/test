    @keyframes crit-pulse {
        0%,100% { border-color: rgba(231,76,60,0.25); box-shadow: 0 2px 6px rgba(0,0,0,0.3), 0 0 15px rgba(231,76,60,0.15), inset 0 1px 0 rgba(255,255,255,0.05); }
        50% { border-color: rgba(231,76,60,0.5); box-shadow: 0 2px 6px rgba(0,0,0,0.3), 0 0 25px rgba(231,76,60,0.4), inset 0 1px 0 rgba(255,255,255,0.05); }
    }
    
    .tile-healthy {
        background: linear-gradient(145deg, rgba(46,204,113,0.09), rgba(15,151,61,0.02));
        border-color: rgba(46,204,113,0.08);
    }
    .tile-healthy .val { color: #3ddc84; font-size: 13px; font-weight: 800; text-shadow: 0 0 8px rgba(46,204,113,0.3); }
    .tile-healthy .sub-text { color: #3ddc84; opacity: 0.7; font-size: 7px; }
    .tile-healthy .bar .fill { background: #2ecc71; width: 15%; }
    
    .tile-td {
        background: linear-gradient(145deg, rgba(231,76,60,0.22), rgba(192,57,43,0.08));
        border-color: rgba(231,76,60,0.3);
        box-shadow: 
            0 2px 6px rgba(0,0,0,0.3),
            0 0 20px rgba(231,76,60,0.25),
            inset 0 1px 0 rgba(255,255,255,0.05);
    }
    .tile-td .val { color: #ff6b5b; font-size: 17px; text-shadow: 0 0 12px rgba(231,76,60,0.6); }
    .tile-td .sub-text { color: #ff6b5b; opacity: 0.9; font-size: 6.5px; }
    .tile-td .bar .fill { background: linear-gradient(90deg, #e74c3c, #ff6b5b); width: 80%; box-shadow: 0 0 10px #e74c3c; }
    .tile-td.pulse { animation: td-pulse 2s ease-in-out infinite; }
    @keyframes td-pulse {
        0%,100% { border-color: rgba(231,76,60,0.3); box-shadow: 0 2px 6px rgba(0,0,0,0.3), 0 0 20px rgba(231,76,60,0.25), inset 0 1px 0 rgba(255,255,255,0.05); }
        50% { border-color: rgba(231,76,60,0.6); box-shadow: 0 2px 6px rgba(0,0,0,0.3), 0 0 35px rgba(231,76,60,0.5), inset 0 1px 0 rgba(255,255,255,0.05); }
    }
    
    .tile-bd {
        background: linear-gradient(145deg, rgba(243,156,18,0.22), rgba(230,126,34,0.08));
        border-color: rgba(243,156,18,0.3);
        box-shadow: 
            0 2px 6px rgba(0,0,0,0.3),
            0 0 20px rgba(243,156,18,0.25),
            inset 0 1px 0 rgba(255,255,255,0.05);
    }
    .tile-bd .val { color: #ffb347; font-size: 17px; text-shadow: 0 0 12px rgba(243,156,18,0.6); }
    .tile-bd .sub-text { color: #ffb347; opacity: 0.9; font-size: 6.5px; }
    .tile-bd .bar .fill { background: linear-gradient(90deg, #f39c12, #ffb347); width: 80%; box-shadow: 0 0 10px #f39c12; }
    .tile-bd.pulse { animation: bd-pulse 2s ease-in-out infinite; }
    @keyframes bd-pulse {
        0%,100% { border-color: rgba(243,156,18,0.3); box-shadow: 0 2px 6px rgba(0,0,0,0.3), 0 0 20px rgba(243,156,18,0.25), inset 0 1px 0 rgba(255,255,255,0.05); }
        50% { border-color: rgba(243,156,18,0.6); box-shadow: 0 2px 6px rgba(0,0,0,0.3), 0 0 35px rgba(243,156,18,0.5), inset 0 1px 0 rgba(255,255,255,0.05); }
    }
    
    .tile-mixed {
        background: linear-gradient(145deg, rgba(155,89,182,0.22), rgba(142,68,173,0.08));
        border-color: rgba(155,89,182,0.3);
        box-shadow: 
            0 2px 6px rgba(0,0,0,0.3),
            0 0 20px rgba(155,89,182,0.25),
            inset 0 1px 0 rgba(255,255,255,0.05);
    }
    .tile-mixed .val { color: #c084fc; font-size: 17px; text-shadow: 0 0 12px rgba(155,89,182,0.6); }
    .tile-mixed .sub-text { color: #c084fc; opacity: 0.9; font-size: 6.5px; }
    .tile-mixed .bar .fill { background: linear-gradient(90deg, #9b59b6, #c084fc); width: 80%; box-shadow: 0 0 10px #9b59b6; }
    .tile-mixed.pulse { animation: mixed-pulse 2s ease-in-out infinite; }
    @keyframes mixed-pulse {
        0%,100% { border-color: rgba(155,89,182,0.3); box-shadow: 0 2px 6px rgba(0,0,0,0.3), 0 0 20px rgba(155,89,182,0.25), inset 0 1px 0 rgba(255,255,255,0.05); }
        50% { border-color: rgba(155,89,182,0.6); box-shadow: 0 2px 6px rgba(0,0,0,0.3), 0 0 35px rgba(155,89,182,0.5), inset 0 1px 0 rgba(255,255,255,0.05); }
    }
    
    .tile-hundred-healthy {
        background: linear-gradient(145deg, rgba(46,204,113,0.09), rgba(15,151,61,0.02));
        border-color: rgba(46,204,113,0.08);
    }
    .tile-hundred-healthy .val { color: #3ddc84; font-size: 13px; font-weight: 800; text-shadow: 0 0 8px rgba(46,204,113,0.3); }
    .tile-hundred-healthy .sub-text { color: #3ddc84; opacity: 0.7; font-size: 7px; }
    .tile-hundred-healthy .bar .fill { background: #2ecc71; width: 15%; }
    
    /* TOOLTIP */
    #customTooltip {
        position: fixed;
        display: none;
        background: rgba(5,8,15,0.98);
        backdrop-filter: blur(20px);
        color: #e8edf5;
        padding: 6px 16px;
        border-radius: 10px;
        font-size: 10px;
        font-weight: 600;
        border: 1px solid rgba(79,156,247,0.2);
        box-shadow: 0 20px 50px rgba(0,0,0,0.9), 0 0 30px rgba(79,156,247,0.15);
        pointer-events: none;
        z-index: 99999;
        font-family: 'Inter', sans-serif;
        white-space: nowrap;
        max-width: 400px;
        overflow: hidden;
        text-overflow: ellipsis;
        transform: translateX(-50%) translateY(-100%);
    }
    #customTooltip::after {
        content: '';
        position: absolute;
        bottom: -6px;
        left: 50%;
        transform: translateX(-50%);
        border: 6px solid transparent;
        border-top-color: rgba(5,8,15,0.98);
    }
    #customTooltip.tip-critical { color: #ff6b5b; border-color: rgba(231,76,60,0.3); }
    #customTooltip.tip-healthy { color: #3ddc84; border-color: rgba(46,204,113,0.3); }
    #customTooltip.tip-td { color: #ff6b5b; border-color: rgba(231,76,60,0.3); }
    #customTooltip.tip-bd { color: #ffb347; border-color: rgba(243,156,18,0.3); }
    #customTooltip.tip-mixed { color: #c084fc; border-color: rgba(155,89,182,0.3); }
    
    /* MODAL */
    #modalContainer {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.94);
        backdrop-filter: blur(28px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 999999;
        animation: modal-in 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        padding: 20px;
    }
    @keyframes modal-in { from { opacity: 0; transform: scale(0.92) translateY(30px); } to { opacity: 1; transform: scale(1) translateY(0); } }
    
    #alertBox {
        background: linear-gradient(145deg, #0d1526, #05080f);
        border-radius: 20px;
        max-width: 580px;
        width: 95%;
        max-height: 85vh;
        padding: 26px 30px 30px 30px;
        border: 1px solid rgba(79,156,247,0.15);
        box-shadow: 
            0 40px 100px rgba(0,0,0,0.95),
            0 0 60px rgba(79,156,247,0.15),
            inset 0 1px 0 rgba(255,255,255,0.05);
        overflow-y: auto;
        position: relative;
    }
    #alertBox::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #4f9cf7, #7c3aed, #e74c3c);
        border-radius: 20px 20px 0 0;
    }
    #alertBox::-webkit-scrollbar { width: 4px; }
    #alertBox::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #4f9cf7, #7c3aed); border-radius: 10px; }
    
    #alertBox .head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 14px;
        padding-bottom: 14px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    #alertBox .head h3 {
        font-size: 22px;
        font-weight: 800;
        color: #ff6b5b;
        display: flex;
        align-items: center;
        gap: 12px;
        text-shadow: 0 0 20px rgba(231,76,60,0.5);
    }
    #alertBox .head h3 i { font-size: 24px; }
    #alertBox .head .close-btn {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        color: #4a6a8a;
        font-size: 20px;
        cursor: pointer;
        transition: 0.3s;
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
    }
    #alertBox .head .close-btn:hover { 
        color: #fff; 
        background: rgba(231,76,60,0.2);
        border-color: rgba(231,76,60,0.3);
        transform: rotate(90deg);
    }
    
    #alertBox .body-text {
        background: rgba(0,0,0,0.35);
        border-radius: 12px;
        padding: 16px 18px;
        margin: 8px 0 18px 0;
        border-left: 3px solid #4f9cf7;
        font-size: 12px;
        line-height: 2;
        color: #b0c8e0;
        max-height: 180px;
        overflow-y: auto;
        box-shadow: inset 0 2px 10px rgba(0,0,0,0.3);
    }
    #alertBox .body-text b { color: #ffffff; }
    #alertBox .body-text .highlight-td { color: #ff6b5b; font-weight: 700; text-shadow: 0 0 8px rgba(231,76,60,0.4); }
    #alertBox .body-text .highlight-bd { color: #ffb347; font-weight: 700; text-shadow: 0 0 8px rgba(243,156,18,0.4); }
    #alertBox .body-text .highlight-mixed { color: #c084fc; font-weight: 700; text-shadow: 0 0 8px rgba(155,89,182,0.4); }
    
    #alertBox .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }
    #alertBox .field { margin-bottom: 6px; }
    #alertBox .field label {
        display: block;
        font-size: 9px;
        font-weight: 700;
        color: #4a6a8a;
        text-transform: uppercase;
        letter-spacing: 0.9px;
        margin-bottom: 4px;
    }
    #alertBox .field select, #alertBox .field textarea {
        width: 100%;
        background: rgba(0,0,0,0.4);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 8px;
        padding: 8px 12px;
        color: #ffffff;
        font-size: 12px;
        font-family: 'Inter', sans-serif;
        transition: 0.25s;
    }
    #alertBox .field select:focus, #alertBox .field textarea:focus {
        outline: none;
        border-color: #4f9cf7;
        box-shadow: 0 0 0 4px rgba(79,156,247,0.1), 0 0 20px rgba(79,156,247,0.15);
        background: rgba(0,0,0,0.5);
    }
    #alertBox .field textarea { min-height: 42px; resize: vertical; }
    #alertBox .field.full { grid-column: 1 / -1; }
    
    .modal-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        margin-top: 16px;
        flex-wrap: wrap;
    }
    .modal-actions .btn-m {
        padding: 8px 24px;
        border-radius: 40px;
        font-weight: 700;
        font-size: 10px;
        border: none;
        cursor: pointer;
        transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        font-family: 'Inter', sans-serif;
    }
    .modal-actions .btn-m-primary {
        background: linear-gradient(135deg, #4f9cf7, #7c3aed);
        color: #fff;
        box-shadow: 0 6px 20px rgba(79,156,247,0.3), inset 0 1px 0 rgba(255,255,255,0.2);
    }
    .modal-actions .btn-m-primary:hover { 
        transform: translateY(-2px); 
        box-shadow: 0 10px 30px rgba(79,156,247,0.45), inset 0 1px 0 rgba(255,255,255,0.2);
    }
    .modal-actions .btn-m-danger { 
        background: linear-gradient(135deg, #e74c3c, #c0392b); 
        color: #fff;
        box-shadow: 0 6px 20px rgba(231,76,60,0.3), inset 0 1px 0 rgba(255,255,255,0.2);
    }
    .modal-actions .btn-m-danger:hover { 
        transform: translateY(-2px); 
        box-shadow: 0 10px 30px rgba(231,76,60,0.45), inset 0 1px 0 rgba(255,255,255,0.2);
    }
    .modal-actions .btn-m-secondary {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        color: #6a8aaa;
    }
    .modal-actions .btn-m-secondary:hover { 
        background: rgba(255,255,255,0.06); 
        color: #ffffff;
    }
    
    /* RESPONSIVE */
    @media (max-width: 1400px) { 
        .grid-main { grid-template-columns: repeat(4, 1fr); } 
        .tile-grid { grid-template-columns: repeat(4, 1fr); }
    }
    @media (max-width: 1100px) { 
        .grid-main { grid-template-columns: repeat(3, 1fr); } 
        .tile-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 768px) { 
        .grid-main { grid-template-columns: repeat(2, 1fr); } 
        .tile-grid { grid-template-columns: repeat(2, 1fr); }
        .top-bar { flex-wrap: wrap; height: auto; }
    }
    
    ::-webkit-scrollbar { width: 3px; }
    ::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #4f9cf7, #7c3aed); border-radius: 10px; }
</style>
</head>
<body>

<!-- LOADER -->
<div id="loaderWrapper">
    <div class="loader-ring"></div>
    <div class="loader-text">Initializing <span>EIS Command</span></div>
</div>

<!-- BACKGROUND -->
<div class="bg-layer"></div>
<div class="bg-grid"></div>
<div class="orb orb-1"></div>
<div class="orb orb-2"></div>
<div class="orb orb-3"></div>

<!-- WRAPPER -->
<div class="wrapper">

    <!-- TOP BAR -->
    <div class="top-bar">
        <div class="brand">
            <div class="logo"><i class="fas fa-shield-halved"></i></div>
            <div>
                <div class="name">EIS COMMAND</div>
                <div class="sub">Service Monitoring Center</div>
            </div>
        </div>
        <div class="top-actions">
            <div class="live-badge"><span class="dot"></span> LIVE</div>
            <span class="timer-glass" id="ten-countdown">5:00</span>
            
            <div class="shortcut-links">
                <a href="<%=request.getContextPath() %>/jsp/ServiceWiseFailure.jsp" class="shortcut-link sw" target="_blank" title="View ServiceWise Failures">
                    <i class="fas fa-chart-line"></i> ServiceWise
                </a>
                <span class="shortcut-divider"></span>
                <a href="<%=request.getContextPath() %>/jsp/100PercentFailure.jsp" class="shortcut-link hundred" target="_blank" title="View 100% Failures">
                    <i class="fas fa-percent"></i> 100% Failure
                </a>
            </div>
            
            <button class="btn-glass btn-primary-glass" onclick="window.open('<%=request.getContextPath() %>/jsp/DisplayServiceWiseFailure.jsp','_blank')">
                <i class="fas fa-list"></i> SW
            </button>
            <button class="btn-glass btn-ghost-glass" onclick="window.open('<%=request.getContextPath() %>/jsp/DisplayTodayServiceWiseFailure.jsp','_blank')">
                <i class="fas fa-check-circle"></i> <span class="badge-count-glass"><%= swClosed %></span>
            </button>
            <button class="btn-glass btn-primary-glass" onclick="window.open('<%=request.getContextPath() %>/jsp/DisplayHundredPercentFailure.jsp','_blank')">
                <i class="fas fa-percent"></i> 100%
            </button>
            <button class="btn-glass btn-ghost-glass" onclick="window.open('<%=request.getContextPath() %>/jsp/DisplayTodayHundredPercentFailure.jsp','_blank')">
                <i class="fas fa-check-circle"></i> <span class="badge-count-glass"><%= hundredClosed %></span>
            </button>
        </div>
    </div>

    <!-- TICKER -->
    <div class="ticker-bar">
        <div class="ticker-wrap">
            <div class="ticker-text">
                <span>● <span class="hl">MONITORING:</span> ServiceWise (TD &gt; 1%) + <span class="hl2">100% Failure</span></span>
                <span>● <span class="hl">LEGEND:</span> <span style="color:#e74c3c;">● TD</span> <span style="color:#f39c12;">● BD</span> <span style="color:#9b59b6;">● Mixed</span> <span style="color:#2ecc71;">● Healthy</span></span>
                <span>● <span class="hl">REFRESH:</span> Every 5 minutes</span>
                <span>● <span class="hl">SORTED BY:</span> Highest failure count first</span>
                <span>● <span class="hl">CLICK:</span> Any tile for detailed alert</span>
            </div>
        </div>
    </div>

    <!-- INFO BAR -->
    <div class="info-bar">
        <div class="legend">
            <span class="item"><span class="swatch sw-td"></span> TD</span>
            <span class="item"><span class="swatch sw-bd"></span> BD</span>
            <span class="item"><span class="swatch sw-mixed"></span> Mixed</span>
            <span class="item"><span class="swatch sw-health"></span> Healthy</span>
        </div>
        <div class="timestamp-display">
            <i class="fas fa-clock"></i> Last Update: <%= lastUpdate %>
        </div>
    </div>

    <!-- MAIN GRID -->
    <div class="grid-main">

        <!-- ============================================================ -->
        <!-- CARD 1: ServiceWise - GEN-5 -->
        <!-- ============================================================ -->
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="title"><i class="fas fa-server"></i> GEN-5</span>
                <span class="badge-count" id="swGen5Count">0</span>
            </div>
            <div class="tile-grid" id="sw-gen5">
                <%
                    List<Double> swGen5Per = new ArrayList<>();
                    List<String> swGen5Name = new ArrayList<>();
                    List<String> swGen5Source = new ArrayList<>();
                    List<String> swGen5Error = new ArrayList<>();
                    List<Integer> swGen5Hits = new ArrayList<>();
                    List<Integer> swGen5Td = new ArrayList<>();
                    List<String> swGen5Time = new ArrayList<>();
                    List<Integer> swGen5Si = new ArrayList<>();
                    
                    try {
                        String q = "SELECT * FROM(SELECT api_name,source_id, error_code,SUM(total_hits) AS total_hits,SUM(success) AS success,issue_time, SUM(td) AS td,round(AVG(td_per), 2) AS td_per, SUM(SI_EEROR) AS SI_EEROR FROM gen5_servicewise_fail temp WHERE TRIM(concat(temp.api_name, temp.source_id)) NOT IN (SELECT TRIM(concat(api_name, source_id) || error_description) FROM vaild_bd_master) AND trim(temp.error_code ) not in (select DISTINCT ERRCODE FROM cbs_err_map WHERE substr(errcode,3,3) NOT in ('002','014') OR errcode in ('SI001','SI007','SI051','SI569','SI570')) AND substr(api_name, 1, 3) NOT IN 'gen' AND insert_time >= sysdate - INTERVAL '10' MINUTE AND api_name NOT IN (SELECT service_name FROM service_temporary_pause_master WHERE service_name IS NOT NULL) GROUP BY api_name, source_id, error_code, issue_time ORDER BY SUM(td) DESC) temp WHERE issue_time = (SELECT MAX(issue_time) FROM gen5_servicewise_fail temp_in WHERE temp_in.api_name = temp.api_name GROUP BY api_name)";
                        ResultSet rs = con.createStatement().executeQuery(q);
                        while(rs.next()) {
                            if(rs.getDouble("TD") >= 50) {
                                swGen5Per.add(rs.getDouble("TD_PER"));
                                swGen5Name.add(nvl(rs.getString("API_NAME"), "N/A"));
                                swGen5Source.add(nvl(rs.getString("SOURCE_ID"), "N/A"));
                                swGen5Error.add(nvl(rs.getString("ERROR_CODE"), "N/A"));
                                swGen5Hits.add(rs.getInt("TOTAL_HITS"));
                                swGen5Td.add(rs.getInt("TD"));
                                swGen5Time.add(nvl(rs.getString("ISSUE_TIME"), "N/A"));
                                swGen5Si.add(rs.getInt("SI_EEROR"));
                            }
                        }
                        rs.close();
                    } catch(Exception e) { e.printStackTrace(); }
                    
                    // ⭐ SORT BY TD COUNT (DESCENDING)
                    Integer[] gen5Idx = new Integer[swGen5Td.size()];
                    for(int i = 0; i < gen5Idx.length; i++) gen5Idx[i] = i;
                    Arrays.sort(gen5Idx, (a, b) -> swGen5Td.get(b) - swGen5Td.get(a));
                    
                    int maxTiles = Math.max(swGen5Per.size(), 35);
                    for(int i = 0; i < maxTiles; i++) {
                        String cls = "tile tile-healthy";
                        String val = "✓";
                        String sub = "HEALTHY";
                        String bar = "15%";
                        String tip = "✅ Healthy";
                        String tipClass = "tip-healthy";
                        String onclick = "";
                        if(i < gen5Idx.length) {
                            int idx = gen5Idx[i];
                            Double pct = swGen5Per.get(idx);
                            cls = "tile tile-critical pulse";
                            val = String.format("%.1f", pct) + "%";
                            sub = "TD";
                            bar = "80%";
                            tip = "⚠ " + swGen5Name.get(idx) + " | TD: " + swGen5Td.get(idx);
                            tipClass = "tip-critical";
                            String alertMsg = "<b>Service:</b> " + swGen5Name.get(idx) + "<br><b>Source:</b> " + swGen5Source.get(idx) + "<br><b>Error:</b> " + swGen5Error.get(idx) + "<br><b>Hits:</b> " + swGen5Hits.get(idx) + "<br><b>TD Count:</b> <span class='highlight-td'>" + swGen5Td.get(idx) + "</span><br><b>Fail %:</b> <span class='highlight-td'>" + String.format("%.2f", pct) + "%</span><br><b>SI Error:</b> " + swGen5Si.get(idx) + "<br><b>Time:</b> " + swGen5Time.get(idx);
                            String name = swGen5Name.get(idx).replace("'", "\\'");
                            onclick = "onclick=\"openModal('" + alertMsg.replace("'", "\\'") + "','" + name + "','GEN-5','ServiceWise','" + swGen5Source.get(idx).replace("'", "\\'") + "','" + swGen5Error.get(idx).replace("'", "\\'") + "','" + swGen5Hits.get(idx) + "','" + swGen5Td.get(idx) + "','" + swGen5Time.get(idx).replace("'", "\\'") + "')\"";
                        }
                        out.print("<div class='" + cls + "' data-tip='" + tip + "' data-tip-class='" + tipClass + "' " + onclick + ">");
                        out.print("<span class='val'>" + val + "</span>");
                        out.print("<span class='sub-text'>" + sub + "</span>");
                        out.print("<div class='bar'><div class='fill' style='width:" + bar + ";'></div></div>");
                        out.print("</div>");
                    }
                %>
            </div>
        </div>


<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@page import="com.actionform.RegistrationActionForm"%>
<%@page import="com.beans.EmployeeDetailsBean"%>
<%@page import="java.util.List"%>
<%@page import="java.util.ArrayList"%>

<%
    RegistrationActionForm regForm = (RegistrationActionForm) request.getAttribute("RegForm");
    List<EmployeeDetailsBean> employeeList = new ArrayList<>();
    String message = "";

    if (regForm != null) {
        Object listObj = regForm.getM_lstViewEmployeeRegistrationdetail();
        if (listObj instanceof List) {
            @SuppressWarnings("unchecked")
            List<EmployeeDetailsBean> tempList = (List<EmployeeDetailsBean>) listObj;
            employeeList = tempList;
        }
        message = regForm.getM_strmsg() != null ? regForm.getM_strmsg() : "";
    }

    String ctx = request.getContextPath();

    // Count active employees
    int activeCount = 0;
    for (EmployeeDetailsBean e : employeeList) {
        String s = e.getM_strISACTIVE();
        if ("Y".equalsIgnoreCase(s) || "Yes".equalsIgnoreCase(s) || "1".equals(s)) activeCount++;
    }
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EIS Employee Registry</title>

<style>
/* ================================================================
   NEO-BRUTALISM RESET
   ================================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --black:   #000000;
    --white:   #FFFFFF;
    --yellow:  #FFD93D;
    --pink:    #FF6B9D;
    --cyan:    #4ECDC4;
    --lime:    #C4F82A;
    --orange:  #FF8C42;
    --purple:  #A78BFA;
    --red:     #FF5757;
    --green:   #22C55E;
    --bg:      #FDF6E3;
    --border:  3px solid var(--black);
    --shadow-sm: 4px 4px 0 var(--black);
    --shadow:    6px 6px 0 var(--black);
    --shadow-lg: 10px 10px 0 var(--black);

    --font: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
            "Helvetica Neue", Arial, sans-serif;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
}

html, body {
    font-family: var(--font);
    color: var(--black);
    background: var(--bg);
    min-height: 100vh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}

/* Subtle grid background */
body {
    background-image:
        linear-gradient(rgba(0,0,0,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,0,0,.04) 1px, transparent 1px);
    background-size: 40px 40px;
}

/* ================================================================
   PAGE WRAP
   ================================================================ */
.page {
    max-width: 1600px;
    margin: 0 auto;
    padding: 24px 20px 60px;
}

/* ================================================================
   HERO HEADER — BIG and BOLD
   ================================================================ */
.hero {
    background: var(--yellow);
    border: var(--border);
    box-shadow: var(--shadow-lg);
    padding: 32px 36px;
    margin-bottom: 24px;
    position: relative;
    overflow: hidden;
    transform: rotate(-0.4deg);
}
.hero::before {
    content: "";
    position: absolute;
    top: -20px; right: -20px;
    width: 180px; height: 180px;
    background: var(--pink);
    border: var(--border);
    border-radius: 50%;
    transform: rotate(15deg);
}
.hero::after {
    content: "";
    position: absolute;
    bottom: -30px; right: 60px;
    width: 120px; height: 120px;
    background: var(--cyan);
    border: var(--border);
    transform: rotate(45deg);
}
.hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
}
.hero h1 {
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -3px;
    text-transform: uppercase;
    color: var(--black);
    text-shadow: 3px 3px 0 var(--white);
}
.hero h1 .accent {
    background: var(--black);
    color: var(--yellow);
    padding: 0 12px;
    display: inline-block;
    transform: rotate(-1.5deg);
    box-shadow: 4px 4px 0 var(--pink);
}
.hero-sub {
    font-size: 14px;
    font-weight: 700;
    margin-top: 14px;
    color: var(--black);
    opacity: .75;
    letter-spacing: 1px;
    text-transform: uppercase;
}

/* Hero sticker */
.hero-sticker {
    background: var(--black);
    color: var(--lime);
    padding: 16px 24px;
    font-weight: 900;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    transform: rotate(3deg);
    box-shadow: 6px 6px 0 var(--pink);
    border: 2px solid var(--black);
    white-space: nowrap;
}
.hero-sticker .blink {
    animation: blink 1s steps(2, start) infinite;
}
@keyframes blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0; }
}

/* ================================================================
   STAT CARDS ROW
   ================================================================ */
.stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}
.stat-card {
    border: var(--border);
    box-shadow: var(--shadow);
    padding: 20px 22px;
    display: flex;
    align-items: center;
    gap: 16px;
    transition: all .15s ease;
    cursor: pointer;
    position: relative;
}
.stat-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-lg);
}
.stat-card:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--black);
}
.stat-card.yellow { background: var(--yellow); }
.stat-card.pink   { background: var(--pink); }
.stat-card.cyan   { background: var(--cyan); }
.stat-card.lime   { background: var(--lime); }

.stat-icon {
    width: 52px; height: 52px;
    border: var(--border);
    background: var(--white);
    display: grid; place-items: center;
    font-size: 26px;
    box-shadow: 3px 3px 0 var(--black);
    flex-shrink: 0;
}
.stat-info .label {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    opacity: .7;
    margin-bottom: 2px;
}
.stat-info .value {
    font-size: 32px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -1.5px;
}

/* ================================================================
   TOOLBAR
   ================================================================ */
.toolbar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    align-items: center;
}
.search-box {
    flex: 1;
    min-width: 240px;
    position: relative;
}
.search-box input {
    width: 100%;
    padding: 14px 16px 14px 48px;
    font-size: 15px;
    font-weight: 600;
    border: var(--border);
    background: var(--white);
    box-shadow: var(--shadow-sm);
    outline: none;
    font-family: inherit;
    transition: all .15s;
}
.search-box input:focus {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow);
}
.search-box::before {
    content: "🔍";
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 18px;
    pointer-events: none;
}

.btn {
    padding: 14px 22px;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: var(--border);
    background: var(--white);
    color: var(--black);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all .15s ease;
    white-space: nowrap;
    text-decoration: none;
}
.btn:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow);
}
.btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--black);
}
.btn.black  { background: var(--black); color: var(--yellow); }
.btn.pink   { background: var(--pink); }
.btn.cyan   { background: var(--cyan); }
.btn.lime   { background: var(--lime); }
.btn.yellow { background: var(--yellow); }
.btn.red    { background: var(--red); color: var(--white); }

/* ================================================================
   SPLIT LAYOUT
   ================================================================ */
.split {
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: 20px;
    align-items: start;
}

/* ================================================================
   EMPLOYEE LIST (LEFT)
   ================================================================ */
.list-panel {
    border: var(--border);
    background: var(--white);
    box-shadow: var(--shadow);
    overflow: hidden;
}
.list-header {
    background: var(--black);
    color: var(--lime);
    padding: 16px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    border-bottom: var(--border);
}
.list-header .count-badge {
    background: var(--lime);
    color: var(--black);
    padding: 3px 10px;
    border: 2px solid var(--black);
    font-size: 12px;
    font-weight: 900;
    box-shadow: 2px 2px 0 var(--pink);
}

.list-scroll {
    max-height: 700px;
    overflow-y: auto;
}

/* Employee row */
.emp-row {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: 16px;
    padding: 16px 20px;
    border-bottom: 2px solid var(--black);
    cursor: pointer;
    transition: all .15s;
    background: var(--white);
    align-items: center;
    position: relative;
}
.emp-row:last-child { border-bottom: none; }
.emp-row:hover {
    background: var(--yellow);
    transform: translateX(4px);
}
.emp-row.active {
    background: var(--cyan);
    border-left: 8px solid var(--black);
}
.emp-row.active::before {
    content: "▶";
    position: absolute;
    left: -22px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 16px;
    color: var(--black);
}

.emp-avatar {
    width: 52px;
    height: 52px;
    border: var(--border);
    background: var(--pink);
    display: grid;
    place-items: center;
    font-size: 22px;
    font-weight: 900;
    color: var(--black);
    box-shadow: 3px 3px 0 var(--black);
    overflow: hidden;
    flex-shrink: 0;
}
.emp-avatar img {
    width: 100%; height: 100%; object-fit: cover;
}

.emp-info {
    min-width: 0;
}
.emp-name {
    font-size: 16px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -.3px;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.emp-meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 11px;
    font-weight: 700;
}
.meta-tag {
    background: var(--black);
    color: var(--white);
    padding: 3px 8px;
    letter-spacing: .5px;
    text-transform: uppercase;
    font-family: var(--mono);
}
.meta-tag.yellow { background: var(--yellow); color: var(--black); }
.meta-tag.pink   { background: var(--pink); color: var(--black); }
.meta-tag.cyan   { background: var(--cyan); color: var(--black); }
.meta-tag.red    { background: var(--red); color: var(--white); }
.meta-tag.green  { background: var(--green); color: var(--white); }

.emp-actions-inline {
    display: flex;
    gap: 6px;
}
.mini-btn {
    width: 34px; height: 34px;
    border: 2px solid var(--black);
    background: var(--white);
    cursor: pointer;
    display: grid;
    place-items: center;
    font-size: 14px;
    transition: all .15s;
    padding: 0;
}
.mini-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 2px 2px 0 var(--black);
}
.mini-btn.edit:hover   { background: var(--cyan); }
.mini-btn.delete:hover { background: var(--red); color: var(--white); }

/* ================================================================
   DETAIL PANEL (RIGHT)
   ================================================================ */
.detail-panel {
    border: var(--border);
    background: var(--white);
    box-shadow: var(--shadow);
    position: sticky;
    top: 20px;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
    display: none;
}
.detail-panel.show { display: block; }

.detail-header {
    background: var(--black);
    color: var(--lime);
    padding: 20px 24px;
    border-bottom: var(--border);
    position: relative;
    overflow: hidden;
}
.detail-header h2 {
    font-size: 22px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -1px;
    line-height: 1.1;
    margin-bottom: 4px;
}
.detail-header .empid {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--yellow);
    letter-spacing: 1.5px;
}
.detail-header::after {
    content: "";
    position: absolute;
    top: -20px; right: -20px;
    width: 100px; height: 100px;
    background: var(--pink);
    border: 2px solid var(--black);
    border-radius: 50%;
    opacity: .4;
}

.detail-body {
    padding: 20px 24px;
}

/* Empty state */
.empty-state {
    padding: 80px 40px;
    text-align: center;
}
.empty-state .emoji {
    font-size: 80px;
    margin-bottom: 16px;
    display: block;
}
.empty-state h3 {
    font-size: 20px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -.5px;
    margin-bottom: 8px;
}
.empty-state p {
    font-size: 13px;
    font-weight: 600;
    opacity: .6;
}

/* Detail sections */
.detail-section {
    margin-bottom: 20px;
}
.detail-section-title {
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--black);
    padding: 6px 12px;
    background: var(--lime);
    border: 2px solid var(--black);
    display: inline-block;
    box-shadow: 3px 3px 0 var(--black);
    margin-bottom: 12px;
}

.detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}
.detail-field {
    padding: 10px 12px;
    background: #FAFAFA;
    border: 2px solid var(--black);
    min-width: 0;
}
.detail-field.full { grid-column: 1 / -1; }
.detail-field .k {
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: .55;
    margin-bottom: 3px;
}
.detail-field .v {
    font-size: 14px;
    font-weight: 700;
    color: var(--black);
    word-break: break-word;
    overflow-wrap: anywhere;
}
.detail-field .v.mono {
    font-family: var(--mono);
    font-size: 13px;
}

/* Document cards */
.docs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}
.doc-card {
    border: 2px solid var(--black);
    background: var(--white);
    padding: 14px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: all .15s;
    text-decoration: none;
    color: var(--black);
    position: relative;
    box-shadow: 3px 3px 0 var(--black);
}
.doc-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--black);
}
.doc-card.has {
    background: var(--lime);
}
.doc-card.has.photo  { background: var(--pink); }
.doc-card.has.bgc    { background: var(--cyan); }
.doc-card.has.police { background: var(--yellow); }
.doc-card.has.cv     { background: var(--lime); }
.doc-card.none {
    background: #F0F0F0;
    opacity: .55;
    cursor: not-allowed;
    box-shadow: 3px 3px 0 #999;
    border-color: #999;
}
.doc-icon {
    width: 34px;
    height: 34px;
    border: 2px solid var(--black);
    background: var(--white);
    display: grid;
    place-items: center;
    font-size: 18px;
    flex-shrink: 0;
}
.doc-info {
    min-width: 0;
}
.doc-info .name {
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1px;
}
.doc-info .status {
    font-size: 10px;
    font-weight: 700;
    opacity: .7;
}

/* Avatar in detail */
.detail-avatar {
    width: 100px;
    height: 100px;
    border: var(--border);
    background: var(--pink);
    display: grid;
    place-items: center;
    font-size: 42px;
    font-weight: 900;
    box-shadow: var(--shadow-sm);
    margin-bottom: 16px;
    overflow: hidden;
}
.detail-avatar img {
    width: 100%; height: 100%; object-fit: cover;
}

/* Detail action bar */
.detail-actions {
    display: flex;
    gap: 10px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 3px dashed var(--black);
}
.detail-actions .btn { flex: 1; justify-content: center; }

/* ================================================================
   TOAST
   ================================================================ */
.toast-host {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 340px;
}
.toast {
    background: var(--white);
    border: var(--border);
    box-shadow: var(--shadow-sm);
    padding: 14px 18px;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .5px;
    display: flex;
    align-items: center;
    gap: 10px;
    animation: toastIn .25s ease;
    transform: rotate(-1deg);
}
.toast.success { background: var(--lime); }
.toast.error   { background: var(--red); color: var(--white); }
.toast.info    { background: var(--cyan); }
.toast .ticon { font-size: 18px; }
@keyframes toastIn {
    from { opacity: 0; transform: translateX(40px) rotate(-1deg); }
    to   { opacity: 1; transform: translateX(0) rotate(-1deg); }
}

/* ================================================================
   MESSAGE BANNER
   ================================================================ */
.banner {
    border: var(--border);
    padding: 16px 24px;
    margin-bottom: 24px;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    gap: 12px;
    transform: rotate(-0.5deg);
}
.banner.success { background: var(--lime); }
.banner.error   { background: var(--red); color: var(--white); }

/* ================================================================
   RESPONSIVE
   ================================================================ */
@media (max-width: 1100px) {
    .split { grid-template-columns: 1fr; }
    .detail-panel {
        position: fixed;
        inset: 20px;
        z-index: 1000;
        max-height: calc(100vh - 40px);
        background: var(--white);
    }
    .detail-panel.show::before {
        content: "";
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.5);
        z-index: -1;
    }
}
@media (max-width: 640px) {
    .page { padding: 16px 12px 40px; }
    .hero { padding: 24px 20px; }
    .hero h1 { letter-spacing: -1.5px; }
    .emp-row { padding: 12px 14px; gap: 12px; grid-template-columns: 44px 1fr auto; }
    .emp-avatar { width: 42px; height: 42px; font-size: 18px; }
    .detail-grid { grid-template-columns: 1fr; }
    .docs-grid { grid-template-columns: 1fr; }
    .toast-host { top: 12px; right: 12px; left: 12px; max-width: none; }
}

/* Scrollbar */
.list-scroll::-webkit-scrollbar,
.detail-panel::-webkit-scrollbar { width: 14px; }
.list-scroll::-webkit-scrollbar-track,
.detail-panel::-webkit-scrollbar-track { background: var(--bg); border-left: 2px solid var(--black); }
.list-scroll::-webkit-scrollbar-thumb,
.detail-panel::-webkit-scrollbar-thumb {
    background: var(--yellow);
    border: 2px solid var(--black);
}
</style>
</head>
<body>

<div class="page">

    <!-- ============================================================
         HERO
         ============================================================ -->
    <header class="hero">
        <div class="hero-content">
            <div>
                <h1>EMPLOYEE <span class="accent">REGISTRY</span></h1>
                <div class="hero-sub">// MANAGE · VIEW · EDIT · DELETE</div>
            </div>
            <div class="hero-sticker">
                <span class="blink">●</span> LIVE DATA
            </div>
        </div>
    </header>

    <!-- ============================================================
         BANNERS
         ============================================================ -->
    <% if ("error".equals(message)) { %>
        <div class="banner error">
            <span>⚠️</span>
            <span>SOMETHING WENT WRONG. PLEASE TRY AGAIN.</span>
        </div>
    <% } %>
    <% if ("delete".equals(message)) { %>
        <div class="banner success">
            <span>✅</span>
            <span>EMPLOYEE RECORD DELETED SUCCESSFULLY.</span>
        </div>
    <% } %>

    <!-- ============================================================
         STATS ROW
         ============================================================ -->
    <div class="stats-row">
        <div class="stat-card yellow">
            <div class="stat-icon">👥</div>
            <div class="stat-info">
                <div class="label">Total</div>
                <div class="value"><%= employeeList.size() %></div>
            </div>
        </div>
        <div class="stat-card lime">
            <div class="stat-icon">✅</div>
            <div class="stat-info">
                <div class="label">Active</div>
                <div class="value"><%= activeCount %></div>
            </div>
        </div>
        <div class="stat-card pink">
            <div class="stat-icon">⛔</div>
            <div class="stat-info">
                <div class="label">Inactive</div>
                <div class="value"><%= employeeList.size() - activeCount %></div>
            </div>
        </div>
        <div class="stat-card cyan">
            <div class="stat-icon">📄</div>
            <div class="stat-info">
                <div class="label">Documents</div>
                <div class="value">4</div>
            </div>
        </div>
    </div>

    <!-- ============================================================
         TOOLBAR
         ============================================================ -->
    <div class="toolbar">
        <div class="search-box">
            <input type="text" id="searchInput" placeholder="SEARCH BY NAME, ID, TEAM..." autocomplete="off"/>
        </div>
        <button type="button" class="btn black" onclick="goToRegistration();">
            ➕ NEW
        </button>
        <button type="button" class="btn pink" onclick="exportToExcel();">
            ⬇️ EXPORT
        </button>
        <button type="button" class="btn cyan" onclick="location.reload();">
            🔄 REFRESH
        </button>
    </div>

    <!-- ============================================================
         SPLIT LAYOUT
         ============================================================ -->
    <div class="split">

        <!-- LEFT: EMPLOYEE LIST -->
        <div class="list-panel">
            <div class="list-header">
                <span>📋 EMPLOYEE LIST</span>
                <span class="count-badge" id="listCount"><%= employeeList.size() %></span>
            </div>
            <div class="list-scroll" id="employeeList">
            <% if (employeeList != null && !employeeList.isEmpty()) {
                   int idx = 0;
                   for (EmployeeDetailsBean e : employeeList) {
                       String empId = e.getM_strEmployee_ID() != null ? e.getM_strEmployee_ID() : "";
                       String fname = e.getM_strFirst_Name() != null ? e.getM_strFirst_Name() : "";
                       String lname = e.getM_strLast_Name() != null ? e.getM_strLast_Name() : "";
                       String fullName = (fname + " " + lname).trim();
                       if (fullName.isEmpty()) fullName = "Employee " + empId;
                       String initials = (fname.isEmpty() ? "?" : fname.substring(0,1)).toUpperCase()
                                       + (lname.isEmpty() ? "" : lname.substring(0,1).toUpperCase());
                       String team = e.getM_strTeam() != null ? e.getM_strTeam() : "";
                       String isActive = e.getM_strISACTIVE() != null ? e.getM_strISACTIVE() : "";
                       boolean active = "Y".equalsIgnoreCase(isActive) || "Yes".equalsIgnoreCase(isActive) || "1".equals(isActive);
                       String photoPath = e.getM_strPhoto_Path();
                       boolean hasPhoto = photoPath != null && !photoPath.trim().isEmpty();
            %>
                <div class="emp-row" data-id="<%= empId %>"
                     data-index="<%= idx %>"
                     data-search="<%= (fullName + " " + empId + " " + team).toLowerCase() %>"
                     onclick="selectEmployee(this, <%= idx %>);">

                    <div class="emp-avatar">
                        <% if (hasPhoto) { %>
                            <img src="<%=ctx%>/DocumentDownloadServlet?empid=<%= empId %>&type=PHOTO"
                                 alt="<%= fullName %>"
                                 onerror="this.style.display='none'; this.parentNode.textContent='<%= initials %>';"/>
                        <% } else { %>
                            <%= initials %>
                        <% } %>
                    </div>

                    <div class="emp-info">
                        <div class="emp-name"><%= fullName %></div>
                        <div class="emp-meta">
                            <span class="meta-tag yellow">#<%= empId %></span>
                            <% if (!team.isEmpty()) { %>
                                <span class="meta-tag cyan"><%= team %></span>
                            <% } %>
                            <span class="meta-tag <%= active ? "green" : "red" %>">
                                <%= active ? "● ACTIVE" : "○ INACTIVE" %>
                            </span>
                        </div>
                    </div>

                    <div class="emp-actions-inline" onclick="event.stopPropagation();">
                        <button type="button" class="mini-btn edit" title="Edit"
                                onclick="editRecord('<%= empId %>');">✏️</button>
                        <button type="button" class="mini-btn delete" title="Delete"
                                onclick="deleteRecord('<%= empId %>');">🗑️</button>
                    </div>
                </div>
            <%     idx++;
                   }
               } else { %>
                <div class="empty-state">
                    <span class="emoji">📭</span>
                    <h3>NO EMPLOYEES YET</h3>
                    <p>Click "NEW" to register your first employee</p>
                </div>
            <% } %>
            </div>
        </div>

        <!-- RIGHT: DETAIL PANEL -->
        <aside class="detail-panel" id="detailPanel">
            <div id="detailContent">
                <div class="empty-state">
                    <span class="emoji">👈</span>
                    <h3>SELECT AN EMPLOYEE</h3>
                    <p>Click any row on the left to see full details here</p>
                </div>
            </div>
        </aside>

    </div>

</div>


}
@media (max-width: 900px) {
    .tx-top-strip { grid-template-columns: 1fr auto; gap: 10px; }
    .tx-kpi-row { grid-column: span 2; }
    .tx-right-block .tx-sev-chips { display: none; }
    .new-wrapper { margin-left: 0 !important; }
}
</style>

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Home &mdash; EIS Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

<style>
:root{
  --gray-0:#FFFFFF; --gray-25:#FCFCFD; --gray-50:#F9FAFB; --gray-100:#F2F4F7;
  --gray-200:#EAECF0; --gray-300:#D0D5DD; --gray-400:#98A2B3; --gray-500:#667085;
  --gray-600:#475467; --gray-700:#344054; --gray-800:#1D2939; --gray-900:#101828;

  --accent:#635BFF; --accent-hover:#5249E0; --accent-soft:#EEF0FF; --accent-line:#C7CBFF;
  --success:#12B76A; --success-soft:#ECFDF3;
  --warning:#F79009; --warning-soft:#FFFAEB;
  --danger:#F04438; --danger-soft:#FEF3F2;
  --info:#2E90FA; --info-soft:#EFF8FF;

  --bg-page:var(--gray-50); --bg-surface:var(--gray-0); --bg-subtle:var(--gray-25);
  --border:var(--gray-200); --border-strong:var(--gray-300);
  --text-primary:var(--gray-900); --text-secondary:var(--gray-600); --text-tertiary:var(--gray-500);

  --radius-sm:6px; --radius-md:8px; --radius-lg:12px; --radius-xl:16px;

  --shadow-xs:0 1px 2px 0 rgba(16,24,40,.05);
  --shadow-sm:0 1px 3px 0 rgba(16,24,40,.10);
  --shadow-md:0 4px 8px -2px rgba(16,24,40,.10);
  --shadow-lg:0 12px 16px -4px rgba(16,24,40,.08);
  --shadow-xl:0 20px 24px -4px rgba(16,24,40,.08);

  --topnav-h:64px; --sidebar-w:260px;

  --font:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,monospace;
}

html[data-theme="dark"]{
  --gray-0:#0B0E14; --gray-25:#10131A; --gray-50:#12161D; --gray-100:#171B23;
  --gray-200:#22262F; --gray-300:#2E333C; --gray-400:#5A6270; --gray-500:#8A94A6;
  --gray-600:#A6B0C2; --gray-700:#C4CCDA; --gray-800:#E1E6EF; --gray-900:#F5F7FA;

  --accent:#8B83FF; --accent-hover:#A29AFF; --accent-soft:#1E1B4B; --accent-line:#3730A3;
  --success:#32D583; --success-soft:#052E1F;
  --warning:#FDB022; --warning-soft:#3D2A05;
  --danger:#F97066; --danger-soft:#3A1211;
  --info:#53B1FD; --info-soft:#0A2540;

  --bg-page:var(--gray-50); --bg-surface:var(--gray-25); --bg-subtle:var(--gray-0);
  --border:var(--gray-200); --border-strong:var(--gray-300);
  --text-primary:var(--gray-900); --text-secondary:var(--gray-600); --text-tertiary:var(--gray-500);

  --shadow-xs:0 1px 2px 0 rgba(0,0,0,.4);
  --shadow-sm:0 1px 3px 0 rgba(0,0,0,.5);
  --shadow-md:0 4px 8px -2px rgba(0,0,0,.4);
  --shadow-lg:0 12px 16px -4px rgba(0,0,0,.5);
  --shadow-xl:0 20px 24px -4px rgba(0,0,0,.6);
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--font);
  font-size:14px;
  line-height:1.5;
  font-weight:400;
  background:var(--bg-page);
  color:var(--text-primary);
  -webkit-font-smoothing:antialiased;
  font-feature-settings:"cv02","cv03","cv04","cv11";
  transition:background-color .2s ease, color .2s ease;
  overflow-x:hidden;
}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}

.icon-svg{
  width:16px;height:16px;
  display:inline-block;flex-shrink:0;
  stroke:currentColor;fill:none;
  stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round;
}

/* ============ APP BAR ============ */
.appbar{
  position:sticky; top:0; z-index:100;
  background:var(--bg-surface);
  border-bottom:1px solid var(--border);
  height:56px;
  display:flex; align-items:center; padding:0 20px; gap:14px;
}
.appbar-logo{
  width:28px;height:28px;border-radius:7px;
  background:linear-gradient(135deg,var(--accent), #7A5CFF);
  display:grid;place-items:center;color:#fff;
}
.appbar-logo svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.4;}
.appbar-title{font-size:14px;font-weight:700;letter-spacing:-.2px;}
.appbar-title .crumb{color:var(--text-tertiary);font-weight:500;margin-left:4px;}
.appbar-spacer{flex:1;}
.appbar-actions{display:flex;align-items:center;gap:4px;}

.icon-btn{
  width:34px;height:34px;display:grid;place-items:center;
  border-radius:var(--radius-md); color:var(--text-secondary);
  transition:all .15s ease;
}
.icon-btn:hover{background:var(--bg-subtle); color:var(--text-primary);}
.icon-btn svg{
  width:17px;height:17px; stroke:currentColor; fill:none; stroke-width:1.8;
  stroke-linecap:round;stroke-linejoin:round;
}
.icon-btn .icon-sun{display:block;}
.icon-btn .icon-moon{display:none;}
html[data-theme="dark"] .icon-btn .icon-sun{display:none;}
html[data-theme="dark"] .icon-btn .icon-moon{display:block;}

.user-chip{
  display:flex; align-items:center; gap:7px;
  padding:4px 10px 4px 4px; border-radius:999px;
  border:1px solid var(--border); transition:all .15s ease;
  margin-left:4px;
}
.user-chip:hover{border-color:var(--border-strong); background:var(--bg-subtle);}
.user-chip .avatar{
  width:24px;height:24px;border-radius:50%;
  background:linear-gradient(135deg,var(--accent),#7A5CFF);
  color:#fff;display:grid;place-items:center;
  font-size:10px;font-weight:700;
}
.user-chip .name{font-size:12px;font-weight:600;}

/* ============ WRAPPER ============ */
.new-wrapper{
  margin-left:var(--sidebar-w);
  padding-top:var(--topnav-h);
  transition:margin-left .3s cubic-bezier(.4,0,.2,1);
  min-height:100vh;
}
html.sb-collapsed .new-wrapper{margin-left:0}

/* ============ PAGE ============ */
.page-wrap{
  padding:24px 32px 60px;
  max-width:1500px;
  margin:0 auto;
}

/* ============ WELCOME BAR ============ */
.welcome-bar{
  background:var(--bg-surface);
  border:1px solid var(--border);
  border-radius:var(--radius-xl);
  padding:24px 28px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  margin-bottom:20px;
  flex-wrap:wrap;
}
.welcome-left{
  display:flex;
  align-items:center;
  gap:16px;
  flex:1;
  min-width:280px;
}
.welcome-avatar{
  width:56px;height:56px;
  border-radius:14px;
  background:linear-gradient(135deg,var(--accent),#7A5CFF);
  display:grid;place-items:center;
  color:#fff;
  font-size:20px;
  font-weight:800;
  letter-spacing:-.5px;
  flex-shrink:0;
  box-shadow:var(--shadow-md);
}
.welcome-text h1{
  font-size:20px;
  font-weight:700;
  letter-spacing:-.4px;
  line-height:1.3;
  margin-bottom:2px;
}
.welcome-text h1 .accent{color:var(--accent);}
.welcome-text p{
  font-size:13px;
  color:var(--text-tertiary);
  font-weight:500;
}
.welcome-text p b{color:var(--text-secondary);font-weight:600;}

.welcome-right{
  display:flex;
  align-items:center;
  gap:10px;
}
.clock-badge{
  background:var(--bg-subtle);
  border:1px solid var(--border);
  border-radius:var(--radius-lg);
  padding:8px 14px;
  display:flex;
  align-items:center;
  gap:10px;
}
.clock-badge .clock-icon{
  width:28px;height:28px;
  border-radius:8px;
  background:var(--accent-soft);
  color:var(--accent);
  display:grid;place-items:center;
  flex-shrink:0;
}
.clock-badge .clock-icon .icon-svg{width:14px;height:14px}
.clock-badge .clock-time{
  font-family:var(--mono);
  font-size:14px;
  font-weight:700;
  letter-spacing:-.3px;
  line-height:1.1;
  font-variant-numeric:tabular-nums;
}
.clock-badge .clock-date{
  font-size:10px;
  color:var(--text-tertiary);
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.3px;
}

/* ============ KPI STRIP ============ */
.kpi-strip{
  background:var(--bg-surface);
  border:1px solid var(--border);
  border-radius:var(--radius-xl);
  padding:16px;
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));
  gap:1px;
  margin-bottom:20px;
  overflow:hidden;
}
.kpi{
  padding:10px 20px;
  border-left:1px solid var(--border);
  display:flex;
  flex-direction:column;
  gap:4px;
  position:relative;
}
.kpi:first-child{border-left:none;padding-left:4px;}
.kpi-label{
  font-size:11px;
  font-weight:600;
  text-transform:uppercase;
  letter-spacing:.5px;
  color:var(--text-tertiary);
}
.kpi-value{
  font-size:22px;
  font-weight:700;
  letter-spacing:-.5px;
  color:var(--text-primary);
  font-variant-numeric:tabular-nums;
  line-height:1.1;
  display:flex;
  align-items:baseline;
  gap:4px;
}
.kpi-value .unit{
  font-size:12px;
  font-weight:500;
  color:var(--text-tertiary);
}
.kpi-meta{
  font-size:11px;
  color:var(--text-tertiary);
  font-weight:500;
}
.kpi-meta .dot{
  display:inline-block;
  width:6px;height:6px;
  border-radius:50%;
  background:var(--success);
  margin-right:5px;
  vertical-align:middle;
}

/* ============ CONTROLS BAR ============ */
.controls-bar{
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:20px;
  flex-wrap:wrap;
}
.search-input{
  position:relative;
  display:flex;
  align-items:center;
  flex:1;
  min-width:220px;
  max-width:420px;
}
.search-input svg{
  position:absolute;
  left:12px;
  width:14px;height:14px;
  stroke:var(--text-tertiary); fill:none; stroke-width:2;
  pointer-events:none;
}
.search-input input{
  width:100%;
  font-family:var(--font);
  font-size:13px;
  font-weight:500;
  background:var(--bg-surface);
  border:1px solid var(--border-strong);
  border-radius:var(--radius-md);
  padding:9px 12px 9px 34px;
  outline:none;
  color:var(--text-primary);
  transition:all .15s ease;
  height:38px;
}
.search-input input::placeholder{color:var(--text-tertiary);}
.search-input input:focus{
  border-color:var(--accent);
  box-shadow:0 0 0 3px var(--accent-soft);
}

.filter-tabs{
  display:flex;
  gap:2px;
  background:var(--bg-surface);
  border:1px solid var(--border);
  padding:3px;
  border-radius:var(--radius-md);
  overflow-x:auto;
}
.filter-tab{
  padding:6px 12px;
  border-radius:var(--radius-sm);
  font-family:var(--font);
  font-size:12px;
  font-weight:600;
  color:var(--text-tertiary);
  cursor:pointer;
  transition:all .15s ease;
  white-space:nowrap;
}
.filter-tab:hover{color:var(--text-primary);background:var(--bg-subtle);}
.filter-tab.active{
  background:var(--accent);
  color:#fff;
}

/* ============ RECENT SECTION ============ */
.recent-section{
  margin-bottom:20px;
}
.section-title{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:12px;
}
.section-title h3{
  font-size:11px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.5px;
  color:var(--text-tertiary);
  display:flex;
  align-items:center;
  gap:8px;
}
.section-title h3 .count{
  background:var(--bg-subtle);
  color:var(--text-secondary);
  padding:2px 8px;
  border-radius:999px;
  font-size:10px;
  font-weight:700;
  border:1px solid var(--border);
}
.section-title .line{
  flex:1;
  height:1px;
  background:linear-gradient(90deg, var(--border), transparent);
}

.recent-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(200px, 1fr));
  gap:10px;
}
.recent-card{
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px 12px;
  background:var(--bg-surface);
  border:1px solid var(--border);
  border-radius:var(--radius-md);
  transition:all .15s ease;
  cursor:pointer;
}
.recent-card:hover{
  border-color:var(--accent);
  transform:translateY(-1px);
  box-shadow:var(--shadow-sm);
}
.recent-card .rc-icon{
  width:32px;height:32px;
  border-radius:8px;
  background:var(--accent-soft);
  color:var(--accent);
  display:grid;place-items:center;
  flex-shrink:0;
}
.recent-card .rc-icon svg{width:14px;height:14px;}
.recent-card .rc-text{flex:1;min-width:0;}
.recent-card .rc-name{
  font-size:12px;
  font-weight:600;
  color:var(--text-primary);
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  line-height:1.3;
}
.recent-card .rc-time{
  font-size:10px;
  color:var(--text-tertiary);
  font-weight:500;
  margin-top:2px;
}

/* ============ BENTO GRID ============ */
.bento-grid{
  display:grid;
  grid-template-columns:repeat(6, 1fr);
  gap:14px;
  margin-bottom:24px;
}

.bcard{
  background:var(--bg-surface);
  border:1px solid var(--border);
  border-radius:var(--radius-lg);
  padding:20px;
  display:flex;
  flex-direction:column;
  gap:12px;
  transition:all .2s ease;
  cursor:pointer;
  position:relative;
  overflow:hidden;
  min-height:160px;
  text-decoration:none;
  color:var(--text-primary);
}
.bcard:hover{
  border-color:var(--accent);
  transform:translateY(-3px);
  box-shadow:var(--shadow-lg);
}
.bcard:hover .bico{
  background:var(--accent);
  color:#fff;
}
.bcard:hover .barrow{
  opacity:1;
  transform:translate(2px, -2px);
}

.bcard-header{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:10px;
}
.bico{
  width:40px;height:40px;
  border-radius:10px;
  background:var(--accent-soft);
  color:var(--accent);
  display:grid;place-items:center;
  flex-shrink:0;
  transition:all .25s ease;
}
.bico .icon-svg{width:18px;height:18px;stroke-width:2.4;}

.fav-btn{
  background:transparent;
  border:none;
  color:var(--text-tertiary);
  cursor:pointer;
  padding:4px;
  border-radius:6px;
  transition:all .15s ease;
  opacity:.4;
  z-index:2;
}
.fav-btn:hover, .fav-btn.active{
  color:var(--warning);
  opacity:1;
}
.fav-btn .icon-svg{width:14px;height:14px;}
.fav-btn.active .icon-svg{fill:var(--warning);stroke:var(--warning);}

.bcard-body{
  display:flex;
  flex-direction:column;
  gap:6px;
  margin-top:auto;
}
.btitle{
  font-size:14px;
  font-weight:700;
  letter-spacing:-.2px;
  color:var(--text-primary);
  display:flex;
  align-items:center;
  gap:6px;
  line-height:1.3;
}
.barrow{
  opacity:0;
  transition:all .2s ease;
  color:var(--accent);
}
.barrow .icon-svg{width:12px;height:12px;}
.bsub{
  font-size:12px;
  color:var(--text-tertiary);
  font-weight:500;
  line-height:1.4;
}
.btags{
  display:flex;
  gap:4px;
  flex-wrap:wrap;
  margin-top:6px;
}
.btag{
  font-size:10px;
  font-weight:700;
  padding:2px 7px;
  border-radius:4px;
  background:var(--accent-soft);
  color:var(--accent);
  text-transform:uppercase;
  letter-spacing:.3px;
}
.btag.gray{
  background:var(--bg-subtle);
  color:var(--text-tertiary);
}
.btag.danger{
  background:var(--danger-soft);
  color:var(--danger);
}
.btag.success{
  background:var(--success-soft);
  color:var(--success);
}

/* Card variants */
.bcard.feat{
  grid-column:span 3;
  grid-row:span 2;
  min-height:auto;
  background:linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
  color:#fff;
  border-color:transparent;
  padding:24px;
}
.bcard.feat .btitle{color:#fff;font-size:18px;letter-spacing:-.4px;}
.bcard.feat .bsub{color:rgba(255,255,255,.7);font-size:13px;}
.bcard.feat .bico{
  background:rgba(139,131,255,.25);
  color:#A29AFF;
  width:48px;height:48px;
}
.bcard.feat .bico .icon-svg{width:22px;height:22px;}
.bcard.feat:hover .bico{background:var(--accent);color:#fff;}
.bcard.feat .btag{
  background:rgba(255,255,255,.12);
  color:rgba(255,255,255,.9);
}
.bcard.feat .btag.gray{
  background:rgba(255,255,255,.08);
  color:rgba(255,255,255,.7);
}
.bcard.feat .fav-btn{color:rgba(255,255,255,.6);}

.bcard.med{grid-column:span 3;}
.bcard.sm{grid-column:span 2;min-height:140px;}
.bcard.xs{grid-column:span 1;}
.bcard.xs .bico{width:32px;height:32px;border-radius:8px;}
.bcard.xs .bico .icon-svg{width:14px;height:14px;}
.bcard.xs .btitle{font-size:12px;}
.bcard.xs .bsub{display:none;}

.bcard.alert{
  background:linear-gradient(135deg, #F04438 0%, #DC2626 100%);
  color:#fff;
  border-color:transparent;
}
.bcard.alert .btitle{color:#fff;}
.bcard.alert .bsub{color:rgba(255,255,255,.85);}
.bcard.alert .bico{background:rgba(255,255,255,.2);color:#fff;}
.bcard.alert:hover .bico{background:#fff;color:var(--danger);}
.bcard.alert .btag{background:rgba(255,255,255,.2);color:#fff;}
.bcard.alert .fav-btn{color:rgba(255,255,255,.6);}

.bcard.success{
  background:linear-gradient(135deg, #12B76A 0%, #059669 100%);
  color:#fff;
  border-color:transparent;
}
.bcard.success .btitle{color:#fff;}
.bcard.success .bsub{color:rgba(255,255,255,.85);}
.bcard.success .bico{background:rgba(255,255,255,.2);color:#fff;}
.bcard.success:hover .bico{background:#fff;color:var(--success);}
.bcard.success .btag{background:rgba(255,255,255,.2);color:#fff;}
.bcard.success .fav-btn{color:rgba(255,255,255,.6);}

.bcard.hidden{display:none;}

/* ============ FOOTER ============ */
.foot{
  margin-top:40px;
  padding-top:24px;
  border-top:1px solid var(--border);
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-size:12px;
  color:var(--text-tertiary);
  font-weight:500;
  flex-wrap:wrap;
  gap:12px;
}
.foot b{color:var(--accent);font-weight:700;}

/* ============ EMPTY ============ */
.empty-state{
  grid-column:1 / -1;
  padding:60px 20px;
  text-align:center;
  color:var(--text-tertiary);
}
.empty-state svg{
  width:48px;height:48px;
  stroke:var(--text-tertiary);fill:none;stroke-width:1.5;
  opacity:.4;margin-bottom:12px;
}
.empty-state h3{
  font-size:14px;
  color:var(--text-primary);
  font-weight:600;
  margin-bottom:4px;
}
.empty-state p{font-size:12px;}

/* ============ RESPONSIVE ============ */
@media (max-width:1100px){
  .bento-grid{grid-template-columns:repeat(4,1fr)}
  .bcard.feat{grid-column:span 4;grid-row:span 1;}
  .bcard.med{grid-column:span 2;}
  .bcard.sm{grid-column:span 2;}
}
@media (max-width:900px){
  .new-wrapper{margin-left:0;}
  .page-wrap{padding:20px 16px 40px;}
  .bento-grid{grid-template-columns:repeat(3,1fr)}
  .bcard.feat{grid-column:span 3;}
  .bcard.med{grid-column:span 3;}

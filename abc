def execute_command(command):

    result = subprocess.run(
    command.split(),
    capture_output=True,
    text=True,
    check=True
    )

    return result.stdout.strip()


def ingest_data(ip,mount_point,script_run,uptime,env,ram,cpu_core,os_version,kernel_version,kernel_update,ace_version,mq_version,firewall_status,rpm_count,dshtts,splunk,ragent,reference_id,system_time,eisuserPasswdexp,rootPasswdexp,SOCVAPasswdexp,addmitamPasswdexp,comvault):

    url = "http://localhost:14499/metrics/ingest"
    headers = {
    "Content-Type": "text/plain; charset=utf-8"
    }

    # Metric with two dimensions
    payload = f'eis.compliance.report,ip="{ip}",mount_point="{mount_point}",script_run="{script_run}",uptime="{uptime}",env="{env}",ram="{ram}",cpu_core="{cpu_core}",os_version="{os_version}",kernel_version="{kernel_version}",kernel_update="{kernel_update}",ace_version="{ace_version}",mq_version="{mq_version}",firewall_status="{firewall_status}",rpm_count="{rpm_count}",dshtts="{dshtts}",splunk="{splunk}",ragent="{ragent}",reference_id="{reference_id}",system_time="{system_time}",eisuser_passwd_exp="{eisuserPasswdexp}",root_passwd_exp="{rootPasswdexp}",soc_va_passwd_exp="{SOCVAPasswdexp}",addm_itam_passwd_exp="{addmitamPasswdexp}",comvault="{comvault}" 1'
    print(payload)
    # exit()
    try:
        response = requests.post(
        url,
        headers=headers,
        data=payload,
        timeout=5
        )

        logging.info("HTTP Status: %s", response.status_code)
        logging.info("Dynatrace Response: %s", response.text)

        if response.status_code in [200, 202]:
            logging.info("Metric successfully sent to Dynatrace!")
        else:
            logging.error("Metric ingestion failed!")

    except requests.exceptions.RequestException as e:
        logging.error("Connection error: %s", e)






<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="com.actionform.RegistrationActionForm"%>
<%@page import="com.beans.EmployeeDetailsBean"%>
<%@page import="java.util.List"%>
<%@page import="java.util.ArrayList"%>
<%
    RegistrationActionForm regForm = (RegistrationActionForm) request.getAttribute("RegForm");
    List<EmployeeDetailsBean> employeeList = new ArrayList<>();
    String message = "";
    String messageType = "";
    
    if (regForm != null) {
    	// Get the list and cast it properly
    	 Object listObj = regForm.getM_lstViewEmployeeRegistrationdetail();
    	 if (listObj instanceof List) {
    	 @SuppressWarnings("unchecked")
    	 List<EmployeeDetailsBean> tempList = (List<EmployeeDetailsBean>) listObj;
    	 employeeList = tempList;
    	}
        
        if ("error".equals(message)) {
            messageType = "error";
        } else if ("delete".equals(message)) {
            messageType = "success";
        }
    }
%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link href="./css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="./css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="./css/dist_bootstrap-table.min.css">
    <link rel="stylesheet" href="./css/all.css">
    <script src="./js/jquery.min.js"></script>
    
    
    <title>Registration Details</title>
    <script>
        function showattachment(filelocation, filetype) {
            var m_strFileAccess;
            if (filetype == "BGC") {
                m_strFileAccess = 'https://10.191.171.12:5443/EISPortal/EISEMPLOYEEDOCUMENT/BGC/' + filelocation;
            }
            if (filetype == "PHOTO") {
                m_strFileAccess = 'https://10.191.171.12:5443/EISPortal/EISEMPLOYEEDOCUMENT/PHOTO/' + filelocation;
            }
            if (filetype == "POLICE") {
                m_strFileAccess = 'https://10.191.171.12:5443/EISPortal/EISEMPLOYEEDOCUMENT/Police/' + filelocation;
            }
            if (filetype == "CV") {
                m_strFileAccess = 'https://10.191.171.12:5443/EISPortal/EISEMPLOYEEDOCUMENT/CV/' + filelocation;
            }
            window.open(m_strFileAccess, '_blank');
        }
        
        function deleterecord(employeeID) {
            if (confirm('Are you sure you want to delete this employee?')) {
                window.location.href = 'ViewEisRegistrationDetails?action=delete&empid=' + employeeID;
            }
        }
        
        function Editrecord(employeeID) {
            window.location.href = './jsp/EditProfileNew.jsp?action=edit&empid=' + employeeID;
        }
        
        function ExportToExcel(type, fn, dl) {
            var elt = document.getElementById('tbl_exporttable_to_xls');
            var wb = XLSX.utils.table_to_book(elt, { sheet: "sheet1" });
            return dl ?
                XLSX.write(wb, { bookType: type, bookSST: true, type: 'base64' }) :
                XLSX.writeFile(wb, fn || ('Employee Details.' + (type || 'xlsx')));
        }
        
        $(document).ready(function(){
            $('#myTable').DataTable({
                pageLength: 10,
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                responsive: true,
                columnDefs: [
                    { orderable: false, targets: [20, 21, 22, 28, 31, 32] } // Disable sorting for image and action columns
                ]
            });
        });
    </script>
</head>


<script type="text/javascript">
function insertservice() {
    var month = document.getElementById('myMonth').value;
    var fileInput = document.querySelector('input[type="file"]');
    if (!month) {
        alert('Please select a month.');
        return;
    }
    if (!fileInput.files.length) {
        alert('Please select a file to upload.');
        return;
    }
    document.forms[0].action = '<%=request.getContextPath() + "/ExcelRosterAction"%>';
    document.forms[0].submit();
}

function viewDate() {
    var month = document.getElementById('myViewMonth').value;
    if (!month) {
        alert('Please select a month.');
        return;
    }
    document.forms[1].action = '<%=request.getContextPath() + "/jsp/testRoster.jsp"%>';
    document.forms[1].submit();
}

function updateRoster() {
    var month = document.getElementById('updateViewMonth').value;
    if (!month) {
        alert('Please select a month.');
        return;
    }
    document.forms[2].action = '<%=request.getContextPath() + "/jsp/UpdateMonthlyRoster.jsp"%>';
    document.forms[2].submit();
}

function viewRocDate() {
    var month = document.getElementById('myRocMonthView').value;
    if (!month) {
        alert('Please select a month.');
        return;
    }
    document.forms[3].action = '<%=request.getContextPath() + "/jsp/ROCRosterView.jsp"%>';
    document.forms[3].submit();
}

function openNewRocPage() {
    window.location.href = '<%=request.getContextPath() + "/jsp/ROCRoster.jsp"%>';
}
</script>

<style>
:root{
  --ml-primary:#7C3AED;
  --ml-primary-2:#8B5CF6;
  --ml-primary-light:#F3E8FF;
  --ml-accent:#EC4899;
  --ml-accent-2:#F472B6;
  --ml-accent-light:#FCE7F3;

  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F5F7FA;
  --card:#FFFFFF;

  --success:#16A34A;
  --danger:#DC2626;
  --warning:#F59E0B;

  --radius:20px;
  --radius-sm:12px;

  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

html[data-theme="dark"]{
  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#272727;
  --bg:#0A0614;
  --card:#130A24;
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--font-stack);
  font-weight:600;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  min-height:100vh;
  transition:background .3s ease,color .3s ease;
}
a{color:inherit;text-decoration:none}

/* ============ PAGE HEADER ============ */
.page-head{
  background:
    radial-gradient(circle at top right, rgba(236,72,153,.15), transparent 60%),
    radial-gradient(circle at bottom left, rgba(124,58,237,.2), transparent 60%),
    linear-gradient(135deg, #1A0B2E 0%, #2D1854 100%);
  border-radius:0 0 var(--radius) var(--radius);
  padding:40px 40px 50px;
  margin-bottom:32px;
  color:#fff;
  position:relative;
  overflow:hidden;
}
.page-head::before{
  content:"";
  position:absolute;top:-150px;right:-150px;
  width:450px;height:450px;border-radius:50%;
  background:radial-gradient(circle, rgba(124,58,237,.4) 0%, transparent 70%);
}
.page-head-inner{
  max-width:1400px;
  margin:0 auto;
  position:relative;z-index:2;
}
.page-head .badge-line{
  display:inline-flex;align-items:center;gap:8px;
  padding:6px 14px;
  background:rgba(236,72,153,.2);
  border:1px solid rgba(236,72,153,.4);
  border-radius:999px;
  font-size:.7rem;font-weight:800;
  color:var(--ml-accent-2);letter-spacing:1px;
  text-transform:uppercase;margin-bottom:16px;
}
.page-head .badge-line .dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--ml-accent-2);
  box-shadow:0 0 8px var(--ml-accent-2);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.page-head h1{
  font-size:2.4rem;font-weight:900;
  letter-spacing:-1px;line-height:1.15;margin-bottom:10px;
}
.page-head h1 .gradient{
  background:linear-gradient(135deg,var(--ml-primary-2),var(--ml-accent-2));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.page-head p{
  font-size:.95rem;color:rgba(255,255,255,.75);
  font-weight:500;max-width:620px;line-height:1.6;
}

/* ============ CARDS GRID ============ */
.roster-grid{
  max-width:1400px;
  margin:0 auto;
  padding:0 32px 60px;
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(340px, 1fr));
  gap:24px;
}

.roster-card{
  background:var(--card);
  border:1.5px solid var(--line);
  border-radius:var(--radius);
  padding:32px 28px;
  display:flex;flex-direction:column;gap:20px;
  transition:all .3s cubic-bezier(.4,0,.2,1);
  position:relative;overflow:hidden;
  box-shadow:0 2px 12px rgba(0,0,0,.03);
}
.roster-card::before{
  content:"";
  position:absolute;top:0;left:0;right:0;height:4px;
  background:linear-gradient(90deg,var(--ml-primary),var(--ml-accent));
  opacity:0;transition:opacity .3s ease;
}
.roster-card:hover::before{opacity:1}
.roster-card:hover{
  transform:translateY(-6px);
  border-color:var(--ml-primary);
  box-shadow:0 20px 48px -16px rgba(124,58,237,.35);
}

.card-icon-wrap{
  width:64px;height:64px;border-radius:18px;
  background:linear-gradient(135deg,var(--ml-primary-light),var(--ml-accent-light));
  display:grid;place-items:center;
  color:var(--ml-primary);
  transition:all .3s ease;
  flex-shrink:0;
}
html[data-theme="dark"] .card-icon-wrap{
  background:linear-gradient(135deg,rgba(124,58,237,.2),rgba(236,72,153,.2));
  color:var(--ml-primary-2);
}
.roster-card:hover .card-icon-wrap{
  transform:scale(1.1) rotate(-5deg);
  background:linear-gradient(135deg,var(--ml-primary),var(--ml-accent));
  color:#fff;
}
.card-icon-wrap svg{
  width:32px;height:32px;
  stroke:currentColor;fill:none;
  stroke-width:2;stroke-linecap:round;stroke-linejoin:round;
}

.card-title{
  font-size:1.25rem;font-weight:900;
  color:var(--ink);letter-spacing:-.4px;
  line-height:1.2;
}
.card-desc{
  font-size:.85rem;color:var(--muted);
  font-weight:500;line-height:1.5;
  margin-top:4px;
}

.form-group{
  display:flex;flex-direction:column;gap:8px;
}
.form-label{
  font-size:.72rem;font-weight:800;
  text-transform:uppercase;letter-spacing:.8px;
  color:var(--muted);
}
.form-control{
  width:100%;
  padding:12px 16px;
  background:var(--bg);
  border:1.5px solid var(--line);
  border-radius:var(--radius-sm);
  color:var(--ink);
  font-family:inherit;
  font-size:.9rem;
  font-weight:600;
  outline:none;
  transition:all .2s ease;
}
.form-control:focus{
  border-color:var(--ml-primary);
  background:var(--card);
  box-shadow:0 0 0 4px rgba(124,58,237,.12);
}

.file-input-wrap{
  position:relative;
}
.file-input-wrap input[type="file"]{
  width:100%;
  padding:12px 16px;
  background:var(--bg);
  border:2px dashed var(--line);
  border-radius:var(--radius-sm);
  color:var(--ink);
  font-family:inherit;
  font-size:.82rem;
  font-weight:600;
  cursor:pointer;
  outline:none;
  transition:all .2s ease;
}
.file-input-wrap input[type="file"]:hover{
  border-color:var(--ml-primary);
  background:var(--ml-primary-light);
}
html[data-theme="dark"] .file-input-wrap input[type="file"]:hover{
  background:rgba(124,58,237,.1);
}
.file-input-wrap input[type="file"]::file-selector-button{
  margin-right:14px;
  padding:8px 18px;
  border:none;
  border-radius:8px;
  background:var(--ml-primary);
  color:#fff;
  font-family:inherit;
  font-weight:700;
  font-size:.78rem;
  cursor:pointer;
  transition:all .2s ease;
  text-transform:uppercase;
  letter-spacing:.4px;
}
.file-input-wrap input[type="file"]::file-selector-button:hover{
  background:var(--ml-accent);
}

.btn{
  width:100%;
  padding:14px 20px;
  border:none;
  border-radius:var(--radius-sm);
  font-family:inherit;
  font-size:.88rem;
  font-weight:800;
  letter-spacing:.4px;
  text-transform:uppercase;
  cursor:pointer;
  transition:all .25s ease;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  position:relative;
  overflow:hidden;
}
.btn svg{
  width:18px;height:18px;
  stroke:currentColor;fill:none;
  stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;
}
.btn-primary{
  background:linear-gradient(135deg,var(--ml-primary),var(--ml-accent));
  color:#fff;
  box-shadow:0 8px 22px -8px var(--ml-primary);
}
.btn-primary:hover{
  transform:translateY(-2px);
  box-shadow:0 14px 32px -8px var(--ml-primary);
}
.btn-primary:active{transform:translateY(0)}

.btn-sample{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:10px 16px;
  background:var(--ml-primary-light);
  color:var(--ml-primary);
  border-radius:var(--radius-sm);
  font-size:.78rem;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.4px;
  text-decoration:none;
  transition:all .2s ease;
  border:1.5px solid transparent;
}
html[data-theme="dark"] .btn-sample{
  background:rgba(124,58,237,.15);
  color:var(--ml-primary-2);
}
.btn-sample:hover{
  background:var(--ml-primary);
  color:#fff;
  border-color:var(--ml-primary);
}
.btn-sample svg{
  width:14px;height:14px;
  stroke:currentColor;fill:none;
  stroke-width:2.4;
}

.alert{
  max-width:1400px;
  margin:0 auto 24px;
  padding:16px 22px;
  border-radius:var(--radius-sm);
  font-size:.88rem;
  font-weight:600;
  display:flex;
  align-items:flex-start;
  gap:12px;
  animation:slideDown .4s ease;
}
@keyframes slideDown{
  from{opacity:0;transform:translateY(-10px);}
  to{opacity:1;transform:translateY(0);}
}
.alert-error{
  background:#FEE2E2;
  color:#991B1B;
  border:1px solid #FCA5A5;
}
.alert-success{
  background:#DCFCE7;
  color:#166534;
  border:1px solid #86EFAC;
}
.alert svg{
  width:20px;height:20px;
  flex-shrink:0;
  stroke:currentColor;fill:none;
  stroke-width:2.4;
  margin-top:1px;
}

.footer-note{
  max-width:1400px;
  margin:0 auto;
  padding:0 32px 40px;
  text-align:center;
  color:var(--muted);
  font-size:.78rem;
  font-weight:600;
}

@media (max-width:768px){
  .page-head{padding:32px 20px 40px;border-radius:0 0 16px 16px;}
  .page-head h1{font-size:1.6rem;}
  .page-head p{font-size:.85rem;}
  .roster-grid{padding:0 16px 40px;grid-template-columns:1fr;gap:16px;}
  .roster-card{padding:24px 20px;}
  .card-icon-wrap{width:52px;height:52px;border-radius:14px;}
  .card-icon-wrap svg{width:26px;height:26px;}
  .card-title{font-size:1.1rem;}
}
</style>

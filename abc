<!-- ============ TOP HEADER ============ -->
<header class="top-header">
  <div class="header-left">
    <div class="badge">
      <span class="dot"></span>
      <%= m_strroles %> &middot; Roster Dashboard
    </div>
    <h1>
      <span class="gradient"><%= nameOfMonth %> <%= selectedYear %></span>
    </h1>
    <div class="meta">
      <span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        <%= totalEmp %> Employees
      </span>
      <span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <%= noOfDays %> Days
      </span>
      <span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <%= username %>
      </span>
    </div>
  </div>

  <div class="header-right">
    <form method="get" style="display:flex;gap:8px;align-items:center;">
      <div class="month-picker">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <select name="month" id="month">
          <option value="">Month</option>
          <% for (int m = 1; m <= 12; m++) {
              String mn = String.format("%02d", m);
              String sel = (m == month) ? "selected" : "";
              String[] mNames = {"","Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"};
          %>
          <option value="<%= mn %>" <%= sel %>><%= mNames[m] %></option>
          <% } %>
        </select>
        <input type="number" name="year" min="2024" max="2100" value="<%= selectedYear %>" required>
      </div>
      <input type="hidden" name="m_strroles" value="<%= m_strroles %>">
      <input type="hidden" name="username" value="<%= username %>">
      <button type="submit" class="btn-header btn-primary-header">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        View
      </button>
    </form>

    <!-- THEME TOGGLE -->
    <button class="theme-toggle" onclick="toggleTheme()" title="Toggle Theme">
      <svg class="icon-sun" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>
</header>

<!-- ============ STATS ============ -->
<section class="stats-bar">
  <div class="stat-box">
    <div class="st-lbl">Total Employees</div>
    <div class="st-val primary"><%= totalEmp %></div>
  </div>
  <div class="stat-box">
    <div class="st-lbl">Days in Month</div>
    <div class="st-val"><%= noOfDays %></div>
  </div>
  <div class="stat-box">
    <div class="st-lbl">Team</div>
    <div class="st-val primary" style="font-size:.95rem;margin-top:8px;"><%= m_strroles %></div>
  </div>
  <div class="stat-box">
    <div class="st-lbl">Period</div>
    <div class="st-val" style="font-size:.95rem;margin-top:8px;"><%= nameOfMonth %> <%= selectedYear %></div>
  </div>
</section>

<!-- ============ LEGEND ============ -->
<section class="legend-bar">
  <span class="legend-label">Legend:</span>
  <span class="legend-item"><span class="legend-dot morning"></span>Morning</span>
  <span class="legend-item"><span class="legend-dot general"></span>General</span>
  <span class="legend-item"><span class="legend-dot afternoon"></span>Afternoon</span>
  <span class="legend-item"><span class="legend-dot night"></span>Night</span>
  <span class="legend-item"><span class="legend-dot weekoff"></span>Weekoff</span>
  <span class="legend-item"><span class="legend-dot leave"></span>Leave</span>
  <span class="legend-item"><span class="legend-dot flexi"></span>Flexi</span>
  <span class="legend-item"><span class="legend-dot holiday"></span>Holiday</span>
</section>

<!-- ============ SEARCH ============ -->
<section class="search-bar">
  <div class="search-box">
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="text" id="searchInput" placeholder="Search employee by name or position..." oninput="filterEmployees()">
  </div>
  <div class="search-info" id="searchInfo">Showing <b><%= totalEmp %></b> employees</div>
</section>

<!-- ============ ROSTER TABLE ============ -->
<form id="rosterForm" method="post" action="<%=request.getContextPath()%>/RosterServlet">
<input type="hidden" name="tableData" id="tableData">
<input type="hidden" name="m_strroles" value="<%= m_strroles %>">
<input type="hidden" name="username" value="<%= username %>">
<input type="hidden" name="selectedMonth" value="<%= selectedMonth %>">
<input type="hidden" name="selectedYear" value="<%= selectedYear %>">

<div class="roster-wrap">
<% if (totalEmp == 0) { %>
  <div class="empty-state">
    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
    <h3>No Employees Found</h3>
    <p>No active employees found in team <b><%= m_strroles %></b>.</p>
  </div>
<% } else { %>

<table class="roster-table" id="rosterTable">
  <thead>
    <tr>
      <th class="emp-col">Employee</th>
      <th class="pos-col">Position</th>
      <% for (int d = 1; d <= noOfDays; d++) {
          LocalDate curDate = LocalDate.of(year, month, d);
          DayOfWeek dow = curDate.getDayOfWeek();
          boolean isWeekend = (dow == DayOfWeek.SATURDAY || dow == DayOfWeek.SUNDAY);
          String dayShort = dow.getDisplayName(TextStyle.SHORT, Locale.ENGLISH);
      %>
      <th class="<%= isWeekend ? "weekend-header" : "" %>" title="<%= curDate %> - <%= dayShort %>">
        <%= d %><br><span style="font-size:.6rem;opacity:.7;"><%= dayShort %></span>
      </th>
      <% } %>
      <th title="Weekoffs">WO</th>
      <th title="Leaves">LV</th>
    </tr>
  </thead>
  <tbody>
    <% for (int i = 0; i < employees.size(); i++) {
        Map<String,Object> emp = employees.get(i);
        String name = (String) emp.get("name");
        String pos = (String) emp.get("position");
        String initial = (name != null && name.length() > 0) ? name.substring(0,1).toUpperCase() : "?";
    %>
    <tr class="emp-row" data-name="<%= name != null ? name.toLowerCase() : "" %>" data-pos="<%= pos != null ? pos.toLowerCase() : "" %>">
      <td class="emp-col">
        <div class="emp-cell">
          <div class="emp-avatar"><%= initial %></div>
          <div class="emp-name">
            <%= name %>
            <input type="hidden" name="employeeName" value="<%= name %>">
            <input type="hidden" name="adId" value="<%= emp.get("adId") %>">
          </div>
        </div>
      </td>
      <td class="pos-col">
        <% if (pos != null && !pos.trim().isEmpty()) { %>
          <%= pos %>
        <% } else { %>
          <span style="color:var(--muted);font-size:.72rem;">-</span>
        <% } %>
        <input type="hidden" name="position_<%= i %>" value="<%= pos != null ? pos : "" %>">
      </td>
      <%
        int woCount = 0, lvCount = 0;
        for (int d = 1; d <= noOfDays; d++) {
          String shift = (String) emp.get("day_" + d);
          if (shift == null) shift = "Morning";
          String shiftLc = shift.toLowerCase();

          String cls = "morning";
          String val = "Morning";
          String label = "M";

          // Determine shift class + label
          if (shiftLc.equals("morning"))         { cls="morning";   val="Morning";       label="M"; }
          else if (shiftLc.equals("wfh-morning")){ cls="morning";   val="WFH-Morning";   label="WFH-M"; }
          else if (shiftLc.equals("cc-morning")) { cls="morning";   val="CC-Morning";    label="CC-M"; }
          else if (shiftLc.equals("general")||shiftLc.equals("genral")) { cls="general"; val="General"; label="D"; }
          else if (shiftLc.equals("wfh-general")||shiftLc.equals("wfh-genral")) { cls="general"; val="WFH-General"; label="WFH-D"; }
          else if (shiftLc.equals("cc-general")) { cls="general";   val="CC-General";    label="CC-D"; }
          else if (shiftLc.equals("afternoon"))  { cls="afternoon"; val="Afternoon";     label="A"; }
          else if (shiftLc.equals("wfh-afternoon")){ cls="afternoon"; val="WFH-Afternoon"; label="WFH-A"; }
          else if (shiftLc.equals("cc-afternoon")) { cls="afternoon"; val="CC-Afternoon"; label="CC-A"; }
          else if (shiftLc.equals("night"))      { cls="night";     val="Night";         label="N"; }
          else if (shiftLc.equals("wfh-night"))  { cls="night";     val="WFH-Night";     label="WFH-N"; }
          else if (shiftLc.equals("cc-night"))   { cls="night";     val="CC-Night";      label="CC-N"; }
          else if (shiftLc.equals("weekoff"))    { cls="weekoff";   val="Weekoff";       label="W"; woCount++; }
          else if (shiftLc.equals("weekoffadjust")){ cls="weekoff"; val="WeekoffAdjust"; label="WA"; }
          else if (shiftLc.equals("leave"))      { cls="leave";     val="Leave";         label="L"; lvCount++; }
          else if (shiftLc.equals("sickleave"))  { cls="leave";     val="SickLeave";     label="SL"; lvCount++; }
          else if (shiftLc.equals("casualleave")){ cls="leave";     val="CasualLeave";   label="CL"; lvCount++; }
          else if (shiftLc.equals("earnedleave")){ cls="leave";     val="EarnedLeave";   label="EL"; lvCount++; }
          else if (shiftLc.equals("flexileave")) { cls="flexi";     val="FlexiLeave";    label="FL"; }
          else if (shiftLc.equals("holidayleave")){cls="holiday";   val="HolidayLeave";  label="HL"; }
          else if (shiftLc.equals("na"))         { cls="na";        val="NA";            label="-"; }
      %>
      <td class="shift-cell">
        <select name="mnt_<%= i %>_<%= d %>" class="shift-select <%= cls %>"
                onchange="updateShiftClass(this)">
          <option value="Morning" class="morning" <%= shiftLc.equals("morning")?"selected":"" %>>M</option>
          <option value="WFH-Morning" class="morning" <%= shiftLc.equals("wfh-morning")?"selected":"" %>>WFH-M</option>
          <option value="CC-Morning" class="morning" <%= shiftLc.equals("cc-morning")?"selected":"" %>>CC-M</option>
          <option value="General" class="general" <%= (shiftLc.equals("general")||shiftLc.equals("genral"))?"selected":"" %>>D</option>
          <option value="WFH-General" class="general" <%= (shiftLc.equals("wfh-general")||shiftLc.equals("wfh-genral"))?"selected":"" %>>WFH-D</option>
          <option value="CC-General" class="general" <%= shiftLc.equals("cc-general")?"selected":"" %>>CC-D</option>
          <option value="Afternoon" class="afternoon" <%= shiftLc.equals("afternoon")?"selected":"" %>>A</option>
          <option value="WFH-Afternoon" class="afternoon" <%= shiftLc.equals("wfh-afternoon")?"selected":"" %>>WFH-A</option>
          <option value="CC-Afternoon" class="afternoon" <%= shiftLc.equals("cc-afternoon")?"selected":"" %>>CC-A</option>
          <option value="Night" class="night" <%= shiftLc.equals("night")?"selected":"" %>>N</option>
          <option value="WFH-Night" class="night" <%= shiftLc.equals("wfh-night")?"selected":"" %>>WFH-N</option>
          <option value="CC-Night" class="night" <%= shiftLc.equals("cc-night")?"selected":"" %>>CC-N</option>
          <option value="Weekoff" class="weekoff" <%= shiftLc.equals("weekoff")?"selected":"" %>>W</option>
          <option value="WeekoffAdjust" class="weekoff" <%= shiftLc.equals("weekoffadjust")?"selected":"" %>>WA</option>
          <option value="Leave" class="leave" <%= shiftLc.equals("leave")?"selected":"" %>>L</option>
          <option value="SickLeave" class="leave" <%= shiftLc.equals("sickleave")?"selected":"" %>>SL</option>
          <option value="CasualLeave" class="leave" <%= shiftLc.equals("casualleave")?"selected":"" %>>CL</option>
          <option value="EarnedLeave" class="leave" <%= shiftLc.equals("earnedleave")?"selected":"" %>>EL</option>
          <option value="FlexiLeave" class="flexi" <%= shiftLc.equals("flexileave")?"selected":"" %>>FL</option>
          <option value="HolidayLeave" class="holiday" <%= shiftLc.equals("holidayleave")?"selected":"" %>>HL</option>
          <option value="NA" class="na" <%= shiftLc.equals("na")?"selected":"" %>>-</option>
        </select>
      </td>
      <% } %>
      <td style="font-weight:900;color:var(--weekoff);font-size:.95rem;"><%= woCount %></td>
      <td style="font-weight:900;color:var(--leave);font-size:.95rem;"><%= lvCount %></td>
    </tr>
    <% } %>

    <!-- ============ SUMMARY ROWS ============ -->
    <tr class="summary-row">
      <td class="emp-col">Morning Total</td>
      <td class="pos-col"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int cnt = 0;
          for (Map<String,Object> emp : employees) {
              String s = (String) emp.get("day_" + d);
              if (s != null && s.toLowerCase().contains("morning")) cnt++;
          }
      %>
      <td><%= cnt %></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
    <tr class="summary-row">
      <td class="emp-col">General Total</td>
      <td class="pos-col"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int cnt = 0;
          for (Map<String,Object> emp : employees) {
              String s = (String) emp.get("day_" + d);
              if (s != null && (s.toLowerCase().contains("general") || s.toLowerCase().contains("genral"))) cnt++;
          }
      %>
      <td><%= cnt %></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
    <tr class="summary-row">
      <td class="emp-col">Afternoon Total</td>
      <td class="pos-col"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int cnt = 0;
          for (Map<String,Object> emp : employees) {
              String s = (String) emp.get("day_" + d);
              if (s != null && s.toLowerCase().contains("afternoon")) cnt++;
          }
      %>
      <td><%= cnt %></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
    <tr class="summary-row">
      <td class="emp-col">Night Total</td>
      <td class="pos-col"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int cnt = 0;
          for (Map<String,Object> emp : employees) {
              String s = (String) emp.get("day_" + d);
              if (s != null && s.toLowerCase().contains("night")) cnt++;
          }
      %>
      <td><%= cnt %></td>
      <% } %>
      <td colspan="2"></td>
    </tr>

  </tbody>
</table>
<% } %>
</div>

<!-- ============ FOOTER ============ -->
<div class="footer-actions">
  <div class="footer-info">
    <b><%= m_strroles %></b> &middot; <%= nameOfMonth %> <%= selectedYear %> &middot; <%= totalEmp %> employees
  </div>
  <div>
    <% if (year > YearMonth.now().getYear() || (year == YearMonth.now().getYear() && month >= YearMonth.now().getMonthValue())) { %>
      <button type="button" class="btn-primary" onclick="prepareData()">
        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        Submit Roster
      </button>
    <% } else { %>
      <span class="footer-info" style="color:var(--warning);">
        Past month &middot; read only
      </span>
    <% } %>
  </div>
</div>
</form>

<script>
// ============ THEME ============
(function(){
  try {
    var t = localStorage.getItem('eis-theme');
    if (!t) { t = 'light'; localStorage.setItem('eis-theme', 'light'); }
    document.documentElement.setAttribute('data-theme', t);
  } catch(e){}
})();

function toggleTheme() {
  var cur = document.documentElement.getAttribute('data-theme') || 'light';
  var next = cur === 'light' ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', next);
  try { localStorage.setItem('eis-theme', next); } catch(e){}
}

// ============ SEARCH ============
function filterEmployees() {
  var input = document.getElementById('searchInput').value.toLowerCase();
  var rows = document.querySelectorAll('.emp-row');
  var visible = 0;
  rows.forEach(function(row) {
    var name = row.getAttribute('data-name') || '';
    var pos = row.getAttribute('data-pos') || '';
    if (name.includes(input) || pos.includes(input)) {
      row.style.display = '';
      visible++;
    } else {
      row.style.display = 'none';
    }
  });
  document.getElementById('searchInfo').innerHTML = 'Showing <b>' + visible + '</b> employees';
}

// ============ SHIFT CLASS UPDATE ============
function updateShiftClass(selectEl) {
  // Remove all shift classes
  var classes = ['morning','general','afternoon','night','weekoff','leave','flexi','holiday','na'];
  classes.forEach(function(c){ selectEl.classList.remove(c); });

  // Determine new class from selected value
  var v = selectEl.value.toLowerCase();
  var cls = 'morning';
  if (v.includes('morning')) cls = 'morning';
  else if (v.includes('general') || v.includes('genral')) cls = 'general';
  else if (v.includes('afternoon')) cls = 'afternoon';
  else if (v.includes('night')) cls = 'night';
  else if (v.includes('weekoff')) cls = 'weekoff';
  else if (v.includes('sickleave') || v.includes('casualleave') || v.includes('earnedleave') || v === 'leave') cls = 'leave';
  else if (v.includes('flexi')) cls = 'flexi';
  else if (v.includes('holiday')) cls = 'holiday';
  else if (v === 'na') cls = 'na';

  selectEl.classList.add(cls);
}

// ============ SUBMIT ============
function prepareData() {
  document.getElementById('rosterForm').action = '<%=request.getContextPath()%>/RosterServlet';
  document.getElementById('rosterForm').submit();
}
</script>

</body>
</html>

package com.action;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

import java.io.File;
import java.io.FileInputStream;
import java.io.IOException;
import java.io.InputStream;
import java.io.OutputStream;
import java.net.URLConnection;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;

import com.jdbc.DBUtilityAuto;

@WebServlet("/DocumentDownloadServlet")
public class DocumentDownloadServlet extends HttpServlet {

    private static final long serialVersionUID = 1L;

    /** Base path relative to catalina.base. */
    private static final String UPLOAD_BASE =
            "/webapps/EISPortalVer2/EISEMPLOYEEDOCUMENT/";

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        String empId   = request.getParameter("empid");
        String docType = request.getParameter("type");

        System.out.println("[DOC-DOWNLOAD] empid=" + empId + " type=" + docType);

        if (empId == null || empId.trim().isEmpty() ||
            docType == null || docType.trim().isEmpty()) {
            response.sendError(HttpServletResponse.SC_BAD_REQUEST, "Missing parameters");
            return;
        }

        Connection conn = null;
        PreparedStatement stmt = null;
        ResultSet rs = null;

        try {
            conn = DBUtilityAuto.getReportDBConnection();

            // ---- Pick column based on docType ----
            String columnName;
            String folderName;
            switch (docType.toUpperCase()) {
                case "BGC":
                    columnName = "BGC_DOCUMENT_PATH";
                    folderName = "BGC";
                    break;
                case "PHOTO":
                    columnName = "PHOTO_PATH";
                    folderName = "PHOTO";
                    break;
                case "POLICE":
                    columnName = "POLICE_VERIFICATION_PATH";
                    folderName = "Police";
                    break;
                case "CV":
                    columnName = "CV_DOCUMENT_PATH";
                    folderName = "CV";
                    break;
                default:
                    response.sendError(HttpServletResponse.SC_BAD_REQUEST, "Invalid docType");
                    return;
            }

            // ---- Fetch filename from DB ----
            String sql = "SELECT " + columnName
                       + " FROM eisupport_employee_master WHERE EMPLOYEE_ID = ?";
            stmt = conn.prepareStatement(sql);
            stmt.setString(1, empId);
            rs = stmt.executeQuery();

            if (!rs.next()) {
                System.out.println("[DOC-DOWNLOAD] Employee not found: " + empId);
                response.sendError(HttpServletResponse.SC_NOT_FOUND, "Employee not found");
                return;
            }

            String storedValue = rs.getString(1);

            System.out.println("[DOC-DOWNLOAD] DB value: [" + storedValue + "]");

            if (storedValue == null || storedValue.trim().isEmpty()
                    || "Uploaded".equalsIgnoreCase(storedValue.trim())) {
                System.out.println("[DOC-DOWNLOAD] No file path stored for " + docType);
                response.sendError(HttpServletResponse.SC_NOT_FOUND, "No document uploaded");
                return;
            }

            // ---- Locate file on disk ----
            String fullPath = System.getProperty("catalina.base")
                            + UPLOAD_BASE + folderName + "/" + storedValue;
            File file = new File(fullPath);

            System.out.println("[DOC-DOWNLOAD] Looking for: " + fullPath);

            if (!file.exists()) {
                System.out.println("[DOC-DOWNLOAD] File NOT found");
                response.sendError(HttpServletResponse.SC_NOT_FOUND,
                                   "File missing on server: " + storedValue);
                return;
            }

            // ---- Determine MIME type ----
            String mimeType = getServletContext().getMimeType(file.getName());
            if (mimeType == null) {
                mimeType = URLConnection.guessContentTypeFromName(file.getName());
            }
            if (mimeType == null) {
                mimeType = "application/octet-stream";
            }

            // ---- Stream file back ----
            response.setContentType(mimeType);
            response.setContentLengthLong(file.length());

            // Inline for images/PDFs, attachment otherwise
            boolean inline = mimeType.startsWith("image/") || mimeType.equals("application/pdf");
            String disposition = (inline ? "inline" : "attachment")
                               + "; filename=\"" + file.getName() + "\"";
            response.setHeader("Content-Disposition", disposition);

            try (InputStream in  = new FileInputStream(file);
                 OutputStream out = response.getOutputStream()) {
                byte[] buffer = new byte[8192];
                int n;
                while ((n = in.read(buffer)) != -1) {
                    out.write(buffer, 0, n);
                }
                out.flush();
            }

            System.out.println("[DOC-DOWNLOAD] Served: " + file.getName()
                               + " (" + file.length() + " bytes)");

        } catch (Exception e) {
            e.printStackTrace();
            response.sendError(HttpServletResponse.SC_INTERNAL_SERVER_ERROR,
                               "Error retrieving document");
        } finally {
            try { if (rs   != null) rs.close();   } catch (Exception ignore) {}
            try { if (stmt != null) stmt.close(); } catch (Exception ignore) {}
            try { if (conn != null) conn.close(); } catch (Exception ignore) {}
        }
    }

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        doGet(request, response);
    }
}



<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    height: 100%;
    font-family: 'Rajdhani', sans-serif;
    background: #05060f;
    color: #fff;
    overflow-x: hidden;
  }

  /* Animated gradient background */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(circle at 15% 20%, rgba(120, 40, 200, 0.35), transparent 45%),
      radial-gradient(circle at 85% 15%, rgba(0, 200, 255, 0.25), transparent 40%),
      radial-gradient(circle at 50% 90%, rgba(255, 60, 100, 0.25), transparent 45%);
    animation: bgShift 18s ease-in-out infinite alternate;
    z-index: -2;
  }
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    z-index: -1;
    mask-image: radial-gradient(circle at center, black 30%, transparent 85%);
  }
  @keyframes bgShift {
    0%   { filter: hue-rotate(0deg)   brightness(1); }
    100% { filter: hue-rotate(35deg)  brightness(1.15); }
  }

  /* ============ TOP BAR ============ */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 28px;
    background: rgba(10, 12, 26, 0.75);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(120, 40, 200, 0.4);
    box-shadow: 0 4px 30px rgba(120, 40, 200, 0.35);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .brand .logo-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #00ffb3;
    box-shadow: 0 0 14px #00ffb3, 0 0 28px #00ffb3;
    animation: pulseDot 1.6s infinite;
  }
  @keyframes pulseDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.35); opacity: 0.65; }
  }
  .brand h1 {
    font-family: 'Orbitron', sans-serif;
    font-size: 20px;
    letter-spacing: 2px;
    background: linear-gradient(90deg, #a259ff, #00d4ff, #ff4b8b);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-transform: uppercase;
  }
  .brand .sub {
    font-size: 12px;
    color: #8b8fa8;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .status-wrap {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .time-window {
    font-size: 14px;
    color: #a0a4be;
    letter-spacing: 1px;
  }
  .time-window b { color: #fff; }

  /* Countdown ring */
  .ring-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 14px;
    background: rgba(120, 40, 200, 0.15);
    border: 1px solid rgba(160, 89, 255, 0.5);
    border-radius: 40px;
    box-shadow: 0 0 18px rgba(160, 89, 255, 0.3);
  }
  .ring-label {
    font-size: 12px;
    letter-spacing: 2px;
    color: #cfc5ff;
    text-transform: uppercase;
  }
  .ring {
    position: relative;
    width: 46px;
    height: 46px;
  }
  .ring svg { transform: rotate(-90deg); }
  .ring circle {
    fill: none;
    stroke-width: 4;
  }
  .ring .bg { stroke: rgba(255,255,255,0.1); }
  .ring .fg {
    stroke: #00d4ff;
    stroke-linecap: round;
    stroke-dasharray: 125.6;
    stroke-dashoffset: 0;
    filter: drop-shadow(0 0 4px #00d4ff);
    transition: stroke-dashoffset 1s linear;
  }
  .ring .num {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Orbitron', sans-serif;
    font-size: 15px;
    color: #00d4ff;
    font-weight: 700;
  }

  /* ============ LAYOUT ============ */
  .main {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 20px;
    padding: 22px;
    min-height: calc(100vh - 90px);
  }

  /* ============ SIDE PANEL ============ */
  .side {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card {
    background: rgba(16, 18, 34, 0.72);
    border: 1px solid rgba(120, 40, 200, 0.35);
    border-radius: 16px;
    padding: 18px;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.5), inset 0 0 0 1px rgba(255,255,255,0.03);
    animation: fadeUp 0.6s ease both;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .card h3 {
    font-family: 'Orbitron', sans-serif;
    font-size: 13px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #a0a4be;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .card h3::before {
    content: '';
    width: 4px;
    height: 14px;
    background: linear-gradient(#a259ff, #00d4ff);
    border-radius: 2px;
  }

  /* Severity legend */
  .legend-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 0;
    font-size: 14px;
    border-bottom: 1px dashed rgba(255,255,255,0.07);
  }
  .legend-row:last-child { border-bottom: none; }
  .dot {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-right: 10px;
    vertical-align: middle;
    box-shadow: 0 0 8px currentColor;
  }
  .dot.crit { background: #ff2d55; color: #ff2d55; }
  .dot.high { background: #ff8c00; color: #ff8c00; }
  .dot.med  { background: #ffd60a; color: #ffd60a; }
  .dot.low  { background: #00ffb3; color: #00ffb3; }

  /* Top critical list */
  .crit-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .crit-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    background: rgba(255, 45, 85, 0.08);
    border-left: 3px solid #ff2d55;
    border-radius: 8px;
    font-size: 13px;
    transition: all 0.25s;
    animation: fadeUp 0.5s ease both;
  }
  .crit-item:hover {
    background: rgba(255, 45, 85, 0.18);
    transform: translateX(4px);
    box-shadow: 0 0 18px rgba(255,45,85,0.3);
  }
  .crit-item .name {
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.5px;
  }
  .crit-item .val {
    font-family: 'Orbitron', sans-serif;
    color: #ff6b8b;
    font-weight: 700;
    font-size: 14px;
  }

  .empty-note {
    color: #6b6f88;
    font-size: 13px;
    text-align: center;
    padding: 10px;
    font-style: italic;
  }

  /* ============ CHART PANEL ============ */
  .chart-wrap {
    background: rgba(16, 18, 34, 0.72);
    border: 1px solid rgba(120, 40, 200, 0.35);
    border-radius: 18px;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.5), inset 0 0 0 1px rgba(255,255,255,0.03);
    position: relative;
    overflow: hidden;
    animation: fadeUp 0.7s ease both;
    padding: 8px;
  }

  .chart-title {
    position: absolute;
    top: 16px;
    left: 22px;
    z-index: 5;
    font-family: 'Orbitron', sans-serif;
    font-size: 22px;
    letter-spacing: 3px;
    background: linear-gradient(90deg, #ff4b8b, #a259ff, #00d4ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-transform: uppercase;
  }
  .chart-sub {
    position: absolute;
    top: 48px;
    left: 22px;
    z-index: 5;
    font-size: 12px;
    letter-spacing: 4px;
    color: #7d81a0;
    text-transform: uppercase;
  }

  #myChart {
    width: 100%;
    height: 100%;
    min-height: 640px;
  }

  /* ============ REFRESHING OVERLAY ============ */
  .refresh-overlay {
    position: fixed;
    inset: 0;
    background: rgba(5, 6, 15, 0.85);
    backdrop-filter: blur(6px);
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 20px;
    z-index: 999;
  }
  .refresh-overlay.active { display: flex; }
  .spinner {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 4px solid rgba(160, 89, 255, 0.2);
    border-top-color: #a259ff;
    border-right-color: #00d4ff;
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .refresh-overlay p {
    font-family: 'Orbitron', sans-serif;
    letter-spacing: 3px;
    color: #cfc5ff;
    text-transform: uppercase;
    font-size: 14px;
  }

  /* Responsive */
  @media (max-width: 1000px) {
    .main { grid-template-columns: 1fr; }
    .brand h1 { font-size: 15px; }
    .time-window { display: none; }
  }
</style>
</head>

<body onload="myFunction_Time()">

<!-- ============ TOP BAR ============ -->
<div class="topbar">
  <div class="brand">
    <span class="logo-dot"></span>
    <div>
      <h1>Transaction Endpoint Monitor</h1>
      <div class="sub">Failure Analytics &bull; Live</div>
    </div>
  </div>

  <div class="status-wrap">
    <div class="time-window" id="timeRangeMessage"></div>
    <div class="ring-wrap">
      <span class="ring-label">Refresh In</span>
      <div class="ring">
        <svg width="46" height="46">
          <circle class="bg" cx="23" cy="23" r="20"></circle>
          <circle class="fg" cx="23" cy="23" r="20" id="ringProgress"></circle>
        </svg>
        <div class="num" id="ringNum">10</div>
      </div>
    </div>
  </div>
</div>

<!-- ============ MAIN ============ -->
<div class="main">

  <!-- SIDE PANEL -->
  <aside class="side">
    <div class="card">
      <h3>Severity Legend</h3>
      <div class="legend-row"><span><span class="dot crit"></span>Critical</span><span>&gt; 5.0%</span></div>
      <div class="legend-row"><span><span class="dot high"></span>High</span><span>2.0 &ndash; 5.0%</span></div>
      <div class="legend-row"><span><span class="dot med"></span>Medium</span><span>1.0 &ndash; 2.0%</span></div>
      <div class="legend-row"><span><span class="dot low"></span>Low</span><span>&lt; 1.0%</span></div>
    </div>

    <div class="card">
      <h3>Top Critical</h3>
      <ul class="crit-list" id="critList">
        <li class="empty-note">Loading...</li>
      </ul>
    </div>

    <div class="card">
      <h3>How To Read</h3>
      <div style="font-size:13px; line-height:1.7; color:#a0a4be;">
        <b style="color:#ff9933;">Orange</b> &rarr; TD Count<br>
        <b style="color:#ffffff;">White</b> &rarr; Endpoint Name<br>
        <b style="color:#32CD32;">Green</b> &rarr; Total Hits<br>
        <b style="color:#00d4ff;">Bar</b> &rarr; Failure %<br>
        <span style="color:#ff6b8b;">Click any bar</span> for drill-down.
      </div>
    </div>
  </aside>

  <!-- CHART -->
  <section class="chart-wrap">
    <div class="chart-title">Failure % &middot; Endpoint Wise</div>
    <div class="chart-sub">Last 10 minutes &middot; Top 12</div>

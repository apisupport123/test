                    <%=active ? "ACTIVE" : "INACTIVE"%>
                </span>
            </div>

            <!-- Section navigation -->
            <div class="nav-sections">
                <div class="nav-item active" onclick="scrollToSection('s1', this);">
                    <span class="num">01</span> Identity <span class="dot"></span>
                </div>
                <div class="nav-item" onclick="scrollToSection('s2', this);">
                    <span class="num">02</span> Personal <span class="dot"></span>
                </div>
                <div class="nav-item" onclick="scrollToSection('s3', this);">
                    <span class="num">03</span> Work <span class="dot"></span>
                </div>
                <div class="nav-item" onclick="scrollToSection('s4', this);">
                    <span class="num">04</span> Contact <span class="dot"></span>
                </div>
                <div class="nav-item" onclick="scrollToSection('s5', this);">
                    <span class="num">05</span> VPN <span class="dot"></span>
                </div>
                <div class="nav-item" onclick="scrollToSection('s6', this);">
                    <span class="num">06</span> Credentials <span class="dot"></span>
                </div>
                <div class="nav-item" onclick="scrollToSection('s7', this);">
                    <span class="num">07</span> Documents <span class="dot"></span>
                </div>
            </div>

            <!-- Docs panel -->
            <div class="docs-panel">
                <div class="docs-panel-title">
                    <span>// documents</span>
                    <span class="count">
                        <%
                            int docCount = 0;
                            if (emp.getM_strBGC_Documents_Path() != null && !emp.getM_strBGC_Documents_Path().isEmpty()) docCount++;
                            if (emp.getM_strPolice_Verification_Path() != null && !emp.getM_strPolice_Verification_Path().isEmpty()) docCount++;
                            if (emp.getM_strCV_Document() != null && !emp.getM_strCV_Document().isEmpty()) docCount++;
                            out.print(docCount + "/3");
                        %>

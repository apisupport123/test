<%@page import="com.jdbc.DBUtilityAuto"%>
<%@page import="com.beans.EmployeeDetailsBean"%>
<%@page import="java.sql.Connection"%>
<%@page import="java.sql.PreparedStatement"%>
<%@page import="java.sql.ResultSet"%>
<%@page import="java.sql.Blob"%>

<%
    String ctx = request.getContextPath();
    String empid = request.getParameter("empid");
    EmployeeDetailsBean emp = null;

    if (empid != null && !empid.trim().isEmpty()) {
        Connection con = null;
        PreparedStatement ps = null;
        ResultSet rs = null;
        try {
            con = DBUtilityAuto.getReportDBConnection();
            ps = con.prepareStatement("SELECT * FROM eisupport_employee_master WHERE EMPLOYEE_ID = ?");
            ps.setString(1, empid);
            rs = ps.executeQuery();
            if (rs.next()) {
                emp = new EmployeeDetailsBean();
                emp.setM_strEmployee_ID(rs.getString("EMPLOYEE_ID"));
                emp.setM_strAD_ID(rs.getString("AD_ID"));
                emp.setM_strHID(rs.getString("HID"));
                emp.setM_strAsset_ID(rs.getString("ASSET_ID"));
                emp.setM_strEducation_Qualification(rs.getString("EDU_QUALIFICATION"));
                emp.setM_strTCS_Joining_Date(rs.getString("TCS_JOINING_DATE"));
                emp.setM_strEmployee_contact_Number(rs.getString("CONTACTNUMBER"));
                emp.setM_strEmergency_contact_Number(rs.getString("EMERGENCY_CONTACTNUMBER"));
                emp.setM_strTeam(rs.getString("TEAM"));
                emp.setM_strTCS_mail_ID(rs.getString("TCS_MAILID"));
                emp.setM_strSBI_mail_ID(rs.getString("SBI_MAILID"));
                emp.setM_strState(rs.getString("STATE"));
                emp.setM_strCity(rs.getString("CITY"));
                emp.setM_strLocal_Address(rs.getString("LOCAL_ADDRESS"));
                emp.setM_strGender(rs.getString("GENDER"));
                emp.setM_strDate_Of_Birth(rs.getString("DOB"));
                emp.setM_strFirst_Name(rs.getString("FIRSTNAME"));
                emp.setM_strMiddle_Name(rs.getString("MIDDLENAME"));
                emp.setM_strLast_Name(rs.getString("LASTNAME"));
                emp.setM_strISACTIVE(rs.getString("ISACTIVE"));
                emp.setM_strVPN_Hostname(rs.getString("VPN_HOSTNAME"));
                emp.setM_strLaptop_Hostname(rs.getString("LAPTOP_HOSTNAME"));
                emp.setM_strRemote_Type(rs.getString("REMOTETYPE"));
                emp.setM_strVPN_VDI_MAC_Address(rs.getString("VPN_VDI_MACADDRESS"));
                emp.setM_strVPN_VDI_IP_Address(rs.getString("VPN_VDI_IPADDRESS"));
                emp.setM_strUserName(rs.getString("USERNAME"));
                emp.setM_strPassword(rs.getString("PASSWORD"));

                Blob p = rs.getBlob("PHOTO_PATH");
                Blob b = rs.getBlob("BGC_DOCUMENT_PATH");
                Blob po = rs.getBlob("POLICE_VERIFICATION_PATH");
                Blob c = rs.getBlob("CV_DOCUMENT_PATH");
                emp.setM_strPhoto_Path(p != null && p.length() > 0 ? "Uploaded" : "");
                emp.setM_strBGC_Documents_Path(b != null && b.length() > 0 ? "Uploaded" : "");
                emp.setM_strPolice_Verification_Path(po != null && po.length() > 0 ? "Uploaded" : "");
                emp.setM_strCV_Document(c != null && c.length() > 0 ? "Uploaded" : "");
                if (p != null) p.free();
                if (b != null) b.free();
                if (po != null) po.free();
                if (c != null) c.free();
            }
        } catch (Exception e) { e.printStackTrace(); }
        finally {
            try { if (rs != null) rs.close(); } catch (Exception ignore) {}
            try { if (ps != null) ps.close(); } catch (Exception ignore) {}
            try { if (con != null) con.close(); } catch (Exception ignore) {}
        }
    }

    String fname = emp != null && emp.getM_strFirst_Name() != null ? emp.getM_strFirst_Name() : "";
    String lname = emp != null && emp.getM_strLast_Name() != null ? emp.getM_strLast_Name() : "";
    String fullName = (fname + " " + lname).trim();
    if (fullName.isEmpty()) fullName = "Employee";
    String initial = fname.isEmpty() ? "?" : fname.substring(0,1).toUpperCase();
    String isActive = emp != null && emp.getM_strISACTIVE() != null ? emp.getM_strISACTIVE() : "";
    boolean active = "Active".equalsIgnoreCase(isActive.trim());
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EIS · Edit Profile</title>

<style>
/* ============================================================
   TOKENS — COMMAND CENTER THEME
   ============================================================ */
:root {
    --bg:        #0a0e1a;
    --bg-2:      #0d1220;
    --panel:     #0f1626;
    --panel-2:   #131b2e;
    --border:    #1e2a44;
    --border-2:  #2a3a5c;
    --border-hi: #3b4a6b;

    --text:      #e2e8f0;
    --text-2:    #a4b1c9;
    --text-3:    #6b7a99;
    --text-4:    #48546e;

    --neon:      #00ffaa;   /* primary accent — neon green */
    --neon-dim:  #00cc88;
    --cyan:      #22d3ee;
    --magenta:   #f43f5e;
    --amber:     #fbbf24;

    --success:   #00ffaa;
    --danger:    #f43f5e;
    --warn:      #fbbf24;

    --mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Consolas, 'Liberation Mono', Menlo, monospace;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    line-height: 1.5;
    background-image:
        linear-gradient(rgba(30, 42, 68, .35) 1px, transparent 1px),
        linear-gradient(90deg, rgba(30, 42, 68, .35) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: -1px -1px;
}

/* Radial glow at top */
body::before {
    content: "";
    position: fixed;
    top: -40%; left: 50%;
    transform: translateX(-50%);
    width: 1200px; height: 800px;
    background: radial-gradient(circle, rgba(0, 255, 170, .08), transparent 60%);
    pointer-events: none;
    z-index: 0;
}

/* ============================================================
   TOP BAR — Command Strip
   ============================================================ */
.topbar {
    position: sticky; top: 0; z-index: 100;
    background: rgba(10, 14, 26, .85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    padding: 0 24px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 12px;
}
.topbar-left {
    display: flex;
    align-items: center;
    gap: 16px;
}
.logo-mark {
    width: 30px; height: 30px;
    background: var(--neon);
    color: var(--bg);
    display: grid; place-items: center;
    font-weight: 800;
    font-size: 13px;
    font-family: var(--mono);
    clip-path: polygon(0 0, 100% 0, 100% 70%, 70% 100%, 0 100%);
    letter-spacing: -.5px;
}
.logo-text {
    display: flex;
    flex-direction: column;
    gap: 0;
}
.logo-text .main {
    color: var(--text);
    font-weight: 700;
    letter-spacing: .5px;
    font-size: 12.5px;
}
.logo-text .sub {
    color: var(--text-3);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}
.topbar-sep {
    color: var(--border-2);
    font-size: 16px;
}
.breadcrumb {
    color: var(--text-3);
    font-size: 11.5px;
    letter-spacing: .5px;
}
.breadcrumb .current { color: var(--neon); }

.topbar-right {
    display: flex;
    align-items: center;
    gap: 10px;
}
.status-dot {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-3);
    font-size: 11px;
    letter-spacing: .5px;
    text-transform: uppercase;
}
.status-dot::before {
    content: "";
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--neon);
    box-shadow: 0 0 8px var(--neon);
    animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: .4; transform: scale(.85); }
}

.tb-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-2);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .5px;
    cursor: pointer;
    transition: all .15s ease;
    text-decoration: none;
    text-transform: uppercase;
}
.tb-btn:hover {
    border-color: var(--neon);
    color: var(--neon);
    background: rgba(0, 255, 170, .05);
}
.tb-btn.primary {
    background: var(--neon);
    color: var(--bg);
    border-color: var(--neon);
    font-weight: 700;
}
.tb-btn.primary:hover {
    background: var(--neon-dim);
    box-shadow: 0 0 20px rgba(0, 255, 170, .4);
}
.tb-btn .kbd {
    padding: 2px 6px;
    background: rgba(0, 0, 0, .3);
    font-size: 10px;
    border-radius: 3px;
}

/* ============================================================
   MAIN LAYOUT
   ============================================================ */
.page {
    max-width: 1500px;
    margin: 0 auto;
    padding: 28px 24px 100px;
    position: relative;
    z-index: 1;
}

/* Header block */
.header {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
}
.header-left { display: flex; flex-direction: column; gap: 4px; }
.header-eyebrow {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--neon);
    letter-spacing: 2px;
    text-transform: uppercase;
}
.header h1 {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -.5px;
    color: var(--text);
    line-height: 1.1;
}
.header h1 .accent {
    color: var(--text-3);
    font-weight: 400;
}
.header-meta {
    display: flex;
    gap: 20px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
}
.header-meta .kv {
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.header-meta .kv .k {
    font-size: 9.5px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-4);
}
.header-meta .kv .v {
    color: var(--text);
    font-size: 12px;
    font-weight: 600;
}

/* Grid */
.layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 20px;
    align-items: start;
}

/* ============================================================
   LEFT SIDEBAR
   ============================================================ */
.sidebar {
    background: var(--panel);
    border: 1px solid var(--border);
    position: sticky;
    top: 80px;
    overflow: hidden;
}

/* Profile mini card */
.profile-mini {
    padding: 24px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: linear-gradient(180deg, rgba(0,255,170,.03), transparent);
}
.photo-frame {
    width: 90px;
    height: 90px;
    position: relative;
    margin-bottom: 14px;
    border: 2px solid var(--border-2);
    background: var(--bg-2);
    overflow: hidden;
    transition: border-color .2s ease;
}
.photo-frame:hover {
    border-color: var(--neon);
    box-shadow: 0 0 20px rgba(0, 255, 170, .3);
}
/* Corner brackets */
.photo-frame::before, .photo-frame::after,
.photo-frame .bracket::before, .photo-frame .bracket::after {
    content: "";
    position: absolute;
    width: 10px; height: 10px;
    border-color: var(--neon);
    pointer-events: none;
    z-index: 2;
}
.photo-frame::before {
    top: -1px; left: -1px;
    border-top: 2px solid; border-left: 2px solid;
}
.photo-frame::after {
    top: -1px; right: -1px;
    border-top: 2px solid; border-right: 2px solid;
}
.photo-frame .bracket::before {
    bottom: -1px; left: -1px;
    border-bottom: 2px solid; border-left: 2px solid;
}
.photo-frame .bracket::after {
    bottom: -1px; right: -1px;
    border-bottom: 2px solid; border-right: 2px solid;
}

.photo-frame img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
}
.photo-overlay-btn {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, .75);
    color: var(--neon);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    opacity: 0;
    transition: opacity .2s ease;
}
.photo-frame:hover .photo-overlay-btn { opacity: 1; }
.photo-overlay-btn .icon { font-size: 20px; }

.profile-mini .name {
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 4px;
    letter-spacing: -.2px;
}
.profile-mini .empid {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: .5px;
    margin-bottom: 12px;
}

.tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border: 1px solid;
}
.tag.active {
    color: var(--neon);
    border-color: rgba(0, 255, 170, .3);
    background: rgba(0, 255, 170, .08);
}
.tag.inactive {
    color: var(--danger);
    border-color: rgba(244, 63, 94, .3);
    background: rgba(244, 63, 94, .08);
}
.tag::before {
    content: "";
    width: 5px; height: 5px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
}

/* Sidebar nav — sections */
.nav-sections {
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
}
.nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: .5px;
    color: var(--text-3);
    cursor: pointer;
    transition: all .15s ease;
    border-left: 2px solid transparent;
    text-transform: uppercase;
}
.nav-item:hover {
    color: var(--text);
    background: var(--panel-2);
}
.nav-item.active {
    color: var(--neon);
    background: rgba(0, 255, 170, .04);
    border-left-color: var(--neon);
    padding-left: 22px;
}
.nav-item .num {
    color: var(--text-4);
    font-size: 10px;
    min-width: 18px;
}
.nav-item.active .num { color: var(--neon); }
.nav-item .dot {
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--text-4);
    margin-left: auto;
}
.nav-item.active .dot {
    background: var(--neon);
    box-shadow: 0 0 8px var(--neon);
}

/* Sidebar docs */
.docs-panel {
    padding: 16px 20px;
}
.docs-panel-title {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-4);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}
.docs-panel-title .count {
    color: var(--neon);
    font-weight: 700;
}

.doc-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px dashed var(--border);
    font-family: var(--mono);
    font-size: 11px;
}
.doc-row:last-child { border-bottom: none; }
.doc-row .code {
    color: var(--text-4);
    font-size: 10px;
    min-width: 22px;
}
.doc-row .label {
    flex: 1;
    color: var(--text-2);
    letter-spacing: .5px;
}
.doc-row .indicator {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--text-4);
}
.doc-row.ok .indicator {
    background: var(--neon);
    box-shadow: 0 0 6px var(--neon);
}
.doc-row .view-btn {
    background: none;
    border: none;
    color: var(--text-3);
    cursor: pointer;
    padding: 2px 6px;
    font-size: 11px;
    font-family: var(--mono);
    letter-spacing: .5px;
    transition: color .15s ease;
}
.doc-row .view-btn:hover { color: var(--neon); }

/* ============================================================
   RIGHT: FORM PANEL
   ============================================================ */
.form-panel {
    background: var(--panel);
    border: 1px solid var(--border);
    overflow: hidden;
}

.form-panel-header {
    padding: 16px 28px;
    background: var(--panel-2);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-3);
}
.form-panel-header .path {
    color: var(--text-2);
    display: flex;
    align-items: center;
    gap: 8px;
}
.form-panel-header .path .slash {
    color: var(--text-4);
}
.form-panel-header .path .current { color: var(--neon); }

/* Section */
.section {
    border-bottom: 1px solid var(--border);
    padding: 28px 28px 32px;
    scroll-margin-top: 80px;
}
.section:last-of-type { border-bottom: none; }

.section-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
}
.section-num {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--neon);
    padding: 3px 8px;
    border: 1px solid rgba(0, 255, 170, .3);
    background: rgba(0, 255, 170, .05);
}
.section-title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -.2px;
    color: var(--text);
}
.section-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
    margin-left: 12px;
}

/* Fields grid */
.fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 16px;
}
.fields .span-2 { grid-column: span 2; }
@media (max-width: 700px) {
    .fields .span-2 { grid-column: span 1; }
}

.field { display: flex; flex-direction: column; gap: 6px; }

.field-label {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--text-4);
    display: flex;
    align-items: center;
    gap: 6px;
}
.field-label .req {
    color: var(--danger);
    font-size: 12px;
}

.field-input,
.field-select,
.field-textarea {
    width: 100%;
    padding: 11px 14px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: .2px;
    outline: none;
    transition: all .15s ease;
    /* sharp edges — no radius */
    border-radius: 0;
}
.field-input:focus,
.field-select:focus,
.field-textarea:focus {
    border-color: var(--neon);
    background: var(--panel-2);
    box-shadow: 0 0 0 3px rgba(0, 255, 170, .08), inset 0 0 0 1px rgba(0, 255, 170, .15);
}
.field-input:hover:not(:focus):not(:read-only),
.field-select:hover:not(:focus) {
    border-color: var(--border-hi);
}
.field-input:read-only {
    color: var(--text-3);
    cursor: not-allowed;
    background: var(--panel);
    border-style: dashed;
}
.field-textarea {
    resize: vertical;
    min-height: 80px;
    font-family: var(--sans);
    font-size: 13.5px;
}
.field-select {
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2300ffaa' stroke-width='2'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 14px;
    padding-right: 38px;
    cursor: pointer;
}

/* File drop zone */
.file-drop {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: var(--bg-2);
    border: 1px dashed var(--border-2);
    cursor: pointer;
    transition: all .2s ease;
    position: relative;
}
.file-drop::before {
    content: ">_";
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-4);
    font-weight: 700;
}
.file-drop:hover {
    border-color: var(--neon);
    background: rgba(0, 255, 170, .03);
}
.file-drop:hover::before { color: var(--neon); }
.file-drop.has-file {
    border-style: solid;
    border-color: var(--neon);
    background: rgba(0, 255, 170, .05);
}
.file-drop.has-file::before { color: var(--neon); }

.file-drop input[type="file"] { display: none; }

.file-drop .file-label {
    flex: 1;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: .5px;
    color: var(--text-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.file-drop.has-file .file-label {
    color: var(--neon);
    font-weight: 600;
}

/* ============================================================
   ACTION BAR — Commit bar
   ============================================================ */
.commit-bar {
    position: sticky;
    bottom: 0;
    z-index: 10;
    background: rgba(10, 14, 26, .95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid var(--border);
    padding: 14px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}
.commit-info {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: .5px;
}
.commit-info .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 8px var(--amber);
    animation: pulse 2s ease-in-out infinite;
}
.commit-actions {
    display: flex;
    gap: 10px;
}

.btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    border: 1px solid;
    cursor: pointer;
    transition: all .15s ease;
    text-decoration: none;
    border-radius: 0;
    background: transparent;
}
.btn.ghost {
    border-color: var(--border-2);
    color: var(--text-2);
}
.btn.ghost:hover {
    border-color: var(--text-3);
    color: var(--text);
    background: var(--panel-2);
}
.btn.primary {
    background: var(--neon);
    color: var(--bg);
    border-color: var(--neon);
    font-weight: 700;
    position: relative;
    overflow: hidden;
}
.btn.primary:hover {
    background: var(--neon-dim);
    box-shadow: 0 0 30px rgba(0, 255, 170, .4);
    transform: translateY(-1px);
}
.btn.primary:active { transform: translateY(0); }

/* ============================================================
   TOAST — Terminal style
   ============================================================ */
.toast-host {
    position: fixed;
    top: 76px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 360px;
}
.toast {
    background: var(--panel);
    border: 1px solid var(--border-2);
    border-left: 3px solid var(--neon);
    padding: 12px 16px;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: .3px;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 10px;
    animation: toastIn .2s ease;
    box-shadow: 0 10px 40px rgba(0, 0, 0, .5);
}
.toast.error   { border-left-color: var(--danger); }
.toast.info    { border-left-color: var(--cyan); }
.toast.success { border-left-color: var(--neon); }
.toast .prefix {
    color: var(--text-4);
    font-weight: 700;
}
.toast.success .prefix { color: var(--neon); }
.toast.error .prefix   { color: var(--danger); }
.toast.info .prefix    { color: var(--cyan); }
@keyframes toastIn {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 1024px) {
    .layout { grid-template-columns: 1fr; }
    .sidebar { position: static; }
    .nav-sections { display: none; }
}
@media (max-width: 640px) {
    .page { padding: 20px 16px 80px; }
    .section { padding: 20px 18px; }
    .commit-bar { padding: 12px 18px; }
    .commit-info { display: none; }
    .commit-actions { width: 100%; }
    .commit-actions .btn { flex: 1; justify-content: center; }
    .header h1 { font-size: 20px; }
    .topbar { padding: 0 12px; }
    .breadcrumb { display: none; }
}

/* Scrollbar */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb {
    background: var(--border-2);
    border: 2px solid var(--bg);
}
::-webkit-scrollbar-thumb:hover { background: var(--border-hi); }
</style>

            }
            expHolder.loaded = true;
        } catch(Exception e) {
            e.printStackTrace();
            expHolder.loaded = true;
        }
    }
});

Thread sysThread = new Thread(new Runnable() {
    public void run() {
        try {
            Connection connSys = null;
            try {
                connSys = DBUtilityAuto.getIIBDBConnection();
                ZonedDateTime CurrentDate = ZonedDateTime.now(ZoneId.of("Asia/Kolkata"));
                DateTimeFormatter formatter = DateTimeFormatter.ofPattern("MMM_yy").withLocale(Locale.US);
                String PART = CurrentDate.format(formatter).toUpperCase();
                String SysSql = "WITH filtered_logs AS ( " +
                    " SELECT /*+PARALLEL(04)*/ " +
                    " API_NAME, " +
                    " SYS_BROKER, " +
                    " error_code, " +
                    " CASE " +
                    " WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) " +
                    " AND error_code <> '00014' THEN 1 " +
                    " ELSE 0 " +
                    " END AS is_td_error " +
                    " FROM eisapp.backend_log PARTITION(" + PART + ") " +
                    " WHERE " +
                    " REQUEST_DATE_TIME >= SYSDATE - INTERVAL '10' MINUTE " +
                    " AND API_NAME NOT LIKE '%gen.%' " +
                    ") " +
                    "SELECT * FROM ( " +
                    " SELECT " +
                    " API_NAME, " +
                    " SYS_BROKER, " +
                    " COUNT(1) AS TOTAL_HITS, " +
                    " SUM(is_td_error) AS TD_COUNT, " +
                    " ROUND(SUM(is_td_error) * 100 / COUNT(1), 2) AS TD_PERCENT, " +
                    " TRIM(',' FROM " +
                    " CASE WHEN SUM(CASE WHEN error_code = 'SI001' THEN 1 ELSE 0 END) > 0 THEN ',SI001' ELSE '' END || " +
                    " CASE WHEN SUM(CASE WHEN error_code = 'SI002' THEN 1 ELSE 0 END) > 0 THEN ',SI002' ELSE '' END || " +
                    " CASE WHEN SUM(CASE WHEN substr(error_code,3,3) = '002' AND error_code <> 'SI002' THEN 1 ELSE 0 END) > 0 THEN ',DYNAMIC 002' ELSE '' END || " +
                    " CASE WHEN SUM(CASE WHEN error_code = 'SI007' AND error_code <> '70007' THEN 1 ELSE 0 END) > 0 THEN ',SI007' ELSE '' END || " +
                    " CASE WHEN SUM(CASE WHEN error_code = 'SI051' THEN 1 ELSE 0 END) > 0 THEN ',SI051' ELSE '' END || " +
                    " CASE WHEN SUM(CASE WHEN substr(error_code,3,3) = '014' AND error_code <> '00014' THEN 1 ELSE 0 END) > 0 THEN ',014' ELSE '' END || " +
                    " CASE WHEN SUM(CASE WHEN error_code = 'SI569' THEN 1 ELSE 0 END) > 0 THEN ',SI569' ELSE '' END || " +
                    " CASE WHEN SUM(CASE WHEN error_code = 'SI570' THEN 1 ELSE 0 END) > 0 THEN ',SI570' ELSE '' END || " +
                    " CASE WHEN SUM(CASE WHEN error_code = 'SI015' THEN 1 ELSE 0 END) > 0 THEN ',SI015' ELSE '' END" +
                    " ) AS ACTIVE_ERROR_CODES " +
                    " FROM filtered_logs " +
                    " GROUP BY API_NAME, SYS_BROKER " +
                    " HAVING COUNT(1)>10 "+
                   // " HAVING ROUND(SUM(is_td_error) * 100 / COUNT(1), 2) >= 0.5 " +
                    " ORDER BY TD_PERCENT DESC " +
                    ") WHERE ROWNUM <= 10";
                System.out.println(" Sys Query :- "+ SysSql);
                System.out.println("SYS Query Started at :"+LocalTime.now() + " on thread: " + Thread.currentThread().getName());
                Statement statement = connSys.createStatement();
                ResultSet resultSet = statement.executeQuery(SysSql);
                System.out.println("SYS Query End at :"+LocalTime.now());
                
                while (resultSet.next()) {
                    String sysBrokerOnly = resultSet.getString("SYS_BROKER");
                    String formattedSysBrokerOnly = formatBrokerNameOnly(sysBrokerOnly);
                    String name = "<p style='color:#ff9933; font-weight: bolder; font-size: 15px'>"
                        + Integer.toString(resultSet.getInt("TD_COUNT"))
                        + "</p><br><p style='color:#FFFFFF; font-weight: bolder;font-size: 15px'>"
                        + formatAPINameWithLineBreaks(resultSet.getString("API_NAME"))
                        + "</p><br>"
                        + formattedSysBrokerOnly
                        + "<br><p style='color:#32CD32; font-weight: bolder;font-size: 15px'>"
                        + Integer.toString(resultSet.getInt("TOTAL_HITS")) + "</p>";
                    sysHolder.labels.add(name);
                    sysHolder.values.add(resultSet.getDouble("TD_PERCENT"));
                    sysHolder.apiNames.add(resultSet.getString("API_NAME"));
                    sysHolder.brokerNames.add(sysBrokerOnly == null ? "N/A" : sysBrokerOnly);
                    String activeErrorCodes = resultSet.getString("ACTIVE_ERROR_CODES");
                    if (activeErrorCodes == null || activeErrorCodes.trim().isEmpty()) {
                        activeErrorCodes = "None";
                    }
                    sysHolder.errorCodes.add(activeErrorCodes);
                }
                resultSet.close();
                statement.close();
            } catch (Exception e) {
                e.printStackTrace();
            } finally {
                if (connSys != null) try { connSys.close(); } catch (Exception e) {}
            }
            sysHolder.loaded = true;
        } catch(Exception e) {
            e.printStackTrace();
            sysHolder.loaded = true;
        }
    }
});

// Start BOTH threads simultaneously - THEY RUN IN PARALLEL!
expThread.start();
sysThread.start();

// Wait for both threads to complete
expThread.join();
sysThread.join();

// Store in request attributes for access

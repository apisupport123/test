<!-- ============ ROSTER GRID ============ -->
<form id="rosterForm" method="post" action="<%=request.getContextPath()%>/RosterServlet">
<input type="hidden" name="tableData" id="tableData">
<input type="hidden" name="m_strroles" value="<%= m_strroles %>">
<input type="hidden" name="username" value="<%= username %>">
<input type="hidden" name="selectedMonth" value="<%= selectedMonth %>">
<input type="hidden" name="selectedYear" value="<%= selectedYear %>">

<div class="grid-wrap">
<% if (totalEmp == 0) { %>
  <div class="empty">
    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
    <h3>No employees found</h3>
    <p>No active employees in team <b><%= m_strroles %></b>.</p>
  </div>
<% } else { %>

<table class="roster-grid">
  <thead>
    <tr>
      <th class="col-emp">Employee</th>
      <th class="col-pos">Position</th>
      <% for (int d = 1; d <= noOfDays; d++) {
          LocalDate cd = LocalDate.of(year, month, d);
          DayOfWeek dow = cd.getDayOfWeek();
          boolean wknd = (dow == DayOfWeek.SATURDAY || dow == DayOfWeek.SUNDAY);
      %>
      <th class="<%= wknd ? "is-weekend" : "" %>">
        <span class="day-num"><%= d %></span>
        <span class="day-name"><%= dow.getDisplayName(TextStyle.SHORT, Locale.ENGLISH) %></span>
      </th>
      <% } %>
      <th class="col-sum">WO</th>
      <th class="col-sum">LV</th>
    </tr>
  </thead>
  <tbody>
    <% for (int i = 0; i < employees.size(); i++) {
        Map<String,Object> emp = employees.get(i);
        String name = (String) emp.get("name");
        String pos = (String) emp.get("position");
        String adId = (String) emp.get("adId");
        String init = (name != null && name.length() > 0) ? name.substring(0,1).toUpperCase() : "?";
    %>
    <tr class="emp-row-tr" data-name="<%= name != null ? name.toLowerCase() : "" %>" data-pos="<%= pos != null ? pos.toLowerCase() : "" %>">
      <td class="col-emp">
        <div class="emp-row">
          <div class="emp-avatar"><%= init %></div>
          <div style="min-width:0;">
            <div class="emp-name"><%= name %></div>
            <div class="emp-id"><%= adId != null ? adId : "" %></div>
            <input type="hidden" name="employeeName" value="<%= name %>">
            <input type="hidden" name="adId" value="<%= adId %>">
          </div>
        </div>
      </td>
      <td class="col-pos">
        <%= (pos != null && !pos.trim().isEmpty()) ? pos : "—" %>
        <input type="hidden" name="position_<%= i %>" value="<%= pos != null ? pos : "" %>">
      </td>
      <%
        int woCount = 0, lvCount = 0;
        for (int d = 1; d <= noOfDays; d++) {
          String shift = (String) emp.get("day_" + d);
          if (shift == null || shift.trim().isEmpty()) shift = "Morning";
          String lc = shift.toLowerCase();
          String cls = "morning", label = "M";
          if (lc.equals("morning"))                 {cls="morning";   label="M";}
          else if (lc.equals("wfh-morning"))        {cls="morning";   label="WFH-M";}
          else if (lc.equals("cc-morning"))         {cls="morning";   label="CC-M";}
          else if (lc.equals("general")||lc.equals("genral")) {cls="general"; label="D";}
          else if (lc.equals("wfh-general")||lc.equals("wfh-genral")) {cls="general"; label="WFH-D";}
          else if (lc.equals("cc-general"))         {cls="general";   label="CC-D";}
          else if (lc.equals("afternoon"))          {cls="afternoon"; label="A";}
          else if (lc.equals("wfh-afternoon"))      {cls="afternoon"; label="WFH-A";}
          else if (lc.equals("cc-afternoon"))       {cls="afternoon"; label="CC-A";}
          else if (lc.equals("night"))              {cls="night";     label="N";}
          else if (lc.equals("wfh-night"))          {cls="night";     label="WFH-N";}
          else if (lc.equals("cc-night"))           {cls="night";     label="CC-N";}
          else if (lc.equals("weekoff"))            {cls="weekoff";   label="W"; woCount++;}
          else if (lc.equals("weekoffadjust"))      {cls="weekoff";   label="WA";}
          else if (lc.equals("leave"))              {cls="leave";     label="L"; lvCount++;}
          else if (lc.equals("sickleave"))          {cls="leave";     label="SL"; lvCount++;}
          else if (lc.equals("casualleave"))        {cls="leave";     label="CL"; lvCount++;}
          else if (lc.equals("earnedleave"))        {cls="leave";     label="EL"; lvCount++;}
          else if (lc.equals("flexileave"))         {cls="flexi";     label="FL";}
          else if (lc.equals("holidayleave"))       {cls="holiday";   label="HL";}
          else if (lc.equals("na"))                 {cls="na";        label="—";}
      %>
      <td class="shift-cell">
        <span class="shift-badge <%= cls %>"><%= label %></span>
        <select name="mnt_<%= i %>_<%= d %>" class="shift-native" onchange="onShiftChange(this)">
          <option value="Morning"       <%= lc.equals("morning")?"selected":"" %>>M — Morning</option>
          <option value="WFH-Morning"   <%= lc.equals("wfh-morning")?"selected":"" %>>WFH-M</option>
          <option value="CC-Morning"    <%= lc.equals("cc-morning")?"selected":"" %>>CC-M</option>
          <option value="General"       <%= (lc.equals("general")||lc.equals("genral"))?"selected":"" %>>D — General</option>
          <option value="WFH-General"   <%= (lc.equals("wfh-general")||lc.equals("wfh-genral"))?"selected":"" %>>WFH-D</option>
          <option value="CC-General"    <%= lc.equals("cc-general")?"selected":"" %>>CC-D</option>
          <option value="Afternoon"     <%= lc.equals("afternoon")?"selected":"" %>>A — Afternoon</option>
          <option value="WFH-Afternoon" <%= lc.equals("wfh-afternoon")?"selected":"" %>>WFH-A</option>
          <option value="CC-Afternoon"  <%= lc.equals("cc-afternoon")?"selected":"" %>>CC-A</option>
          <option value="Night"         <%= lc.equals("night")?"selected":"" %>>N — Night</option>
          <option value="WFH-Night"     <%= lc.equals("wfh-night")?"selected":"" %>>WFH-N</option>
          <option value="CC-Night"      <%= lc.equals("cc-night")?"selected":"" %>>CC-N</option>
          <option value="Weekoff"       <%= lc.equals("weekoff")?"selected":"" %>>W — Weekoff</option>
          <option value="WeekoffAdjust" <%= lc.equals("weekoffadjust")?"selected":"" %>>WA — Weekoff Adjust</option>
          <option value="Leave"         <%= lc.equals("leave")?"selected":"" %>>L — Leave</option>
          <option value="SickLeave"     <%= lc.equals("sickleave")?"selected":"" %>>SL — Sick Leave</option>
          <option value="CasualLeave"   <%= lc.equals("casualleave")?"selected":"" %>>CL — Casual Leave</option>
          <option value="EarnedLeave"   <%= lc.equals("earnedleave")?"selected":"" %>>EL — Earned Leave</option>
          <option value="FlexiLeave"    <%= lc.equals("flexileave")?"selected":"" %>>FL — Flexi Leave</option>
          <option value="HolidayLeave"  <%= lc.equals("holidayleave")?"selected":"" %>>HL — Holiday</option>
          <option value="NA"            <%= lc.equals("na")?"selected":"" %>>— Not Assigned</option>
        </select>
      </td>
      <% } %>
      <td style="text-align:center;font-weight:700;font-variant-numeric:tabular-nums;color:var(--w-fg);"><%= woCount %></td>
      <td style="text-align:center;font-weight:700;font-variant-numeric:tabular-nums;color:var(--l-fg);"><%= lvCount %></td>
    </tr>
    <% } %>

    <!-- Summary rows -->
    <tr class="summary-row">
      <td class="col-emp">Morning</td>
      <td class="col-pos"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int c = 0; for (Map<String,Object> e : employees) { String s = (String) e.get("day_" + d); if (s != null && s.toLowerCase().contains("morning")) c++; }

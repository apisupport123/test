<div>
  <div class="shell">
    <aside class="brand-panel">
      <div class="brand-logo">
        <i class="fa-solid fa-shield-halved"></i>
        <span>EIS PORTAL</span>
      </div>
      <div class="brand-hero">
        <h1>Welcome back to your workspace.</h1>
        <p>Secure single sign-on for Enterprise Information Systems. Access dashboards, monitoring tools, and reports — all in one place.</p>
        <div class="brand-stats">
          <div class="stat"><b>24×7</b><span>Uptime</span></div>
          <div class="stat"><b>100+</b><span>Services</span></div>
          <div class="stat"><b>Secure</b><span>Access</span></div>
        </div>
      </div>
      <div style="font-size:.8rem;opacity:.85;">© <%= java.time.Year.now() %> EIS Portal · Internal Use Only</div>
    </aside>

    <main class="form-panel">
      <div class="tabs">
        <button class="tab active" data-tab="user">User Login</button>
        <button class="tab" data-tab="admin">Admin Login</button>
      </div>

      <s:form action="login" method="post" theme="simple" id="loginForm">
        <div class="form-view active" id="view-user">
          <h2 class="form-title">Sign in</h2>
          <p class="form-sub">Enter your credentials to continue</p>

          <div class="alert error" id="userAlert"><i class="fa-solid fa-circle-exclamation"></i><span></span></div>

          <div class="field">
            <i class="fa-solid fa-user"></i>
            <input type="text" placeholder="Username" name="m_strUserName" id="m_strUserName" autocomplete="username" />
          </div>

          <div class="field">
            <i class="fa-solid fa-lock"></i>
            <input type="password" placeholder="Password" name="m_struserPassword" id="m_struserPassword" autocomplete="current-password" />
          </div>

          <div class="field">
            <i class="fa-solid fa-user-tag"></i>
            <s:select
              name="m_strRole"
              id="m_strRole"
              list="rolelist"
              headerKey=""
              headerValue="Select Role"
              theme="simple"
            />
          </div>

          <button type="button" class="btn-primary" id="btnUserLogin" onclick="usersign()">
            <span class="spinner"></span>
            <span class="btn-text">Sign In</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>

        <div class="form-view" id="view-admin">
          <h2 class="form-title">Admin Login</h2>
          <p class="form-sub">Restricted access — admins only</p>

          <div class="alert error" id="adminAlert"><i class="fa-solid fa-circle-exclamation"></i><span></span></div>

          <div class="field">
            <i class="fa-solid fa-user-shield"></i>
            <input type="text" placeholder="Admin Username" name="m_stradminUserName" id="m_stradminUserName" autocomplete="username" />
          </div>

          <div class="field">
            <i class="fa-solid fa-lock"></i>
            <input type="password" placeholder="Admin Password" name="m_stradminPassword" id="m_stradminPassword" autocomplete="current-password" />
          </div>

          <button type="button" class="btn-primary" id="btnAdminLogin" onclick="adminsign()">
            <span class="spinner"></span>
            <span class="btn-text">Sign In as Admin</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </div>
      </s:form>

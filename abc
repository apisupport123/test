                    + "WHERE username LIKE ? "
                    + "AND password = ? "
                    + "AND rolename = ?";

            con = DBUtilityAuto.getReportDBConnection();
            ps = con.prepareStatement(query);
            ps.setString(1, "%" + user + "%");
            ps.setString(2, pass);
            ps.setString(3, role);
            rs = ps.executeQuery();
            if (rs.next()) count = rs.getInt(1);
            return count > 0;
        } catch (Exception e) {
            e.printStackTrace();
            return false;
        } finally {
            if (rs != null) try { rs.close(); } catch (Exception ignored) {}
            if (ps != null) try { ps.close(); } catch (Exception ignored) {}
            if (con != null) try { con.close(); } catch (Exception ignored) {}
        }
    }


        return "success";
    }

    /**
     * Handles the insert submission (action=insert) and the clear case.
     * URL: saveRegistration.action
     */
    public String saveRegistration() throws Exception {
        RegistrationActionForm form = getOrCreateForm();
        loadEISRole(form);

        HttpServletRequest request = ServletActionContext.getRequest();
        String actionParam = request.getParameter("action");

        // No action param → just show the form
        if (actionParam == null) {
            clearForm(form);
            return "success";
        }

        // Anything other than insert → clear
        if (!"insert".equals(actionParam)) {
            clearForm(form);
            return "success";
        }

        // ---------------- INSERT path ----------------
        Connection con = null;
        PreparedStatement psEmp = null;
        PreparedStatement psRoster = null;
        Statement checkSt = null;
        ResultSet checkRs = null;

        try {
            con = DBUtilityAuto.getReportDBConnection();

            // ---- Duplicate check ----
            String countQuery = "select count(*) from eisupport_employee_master where EMPLOYEE_ID='"
                    + request.getParameter("m_stremployee_id") + "'";
            checkSt = con.createStatement();
            checkRs = checkSt.executeQuery(countQuery);

            int count = 0;
            if (checkRs != null && checkRs.next()) {
                count = checkRs.getInt(1);
            }

            if (count > 0) {
                form.setM_strmsg("duplicate");
                return "success";
            }

            // ---- Upload files ----
            String photoPath  = "";
            String bgcPath    = "";
            String policePath = "";
            String cvPath     = "";

            String baseUpload = System.getProperty("catalina.base")
                    + "/webapps/EISPortalVer2/EISEMPLOYEEDOCUMENT/";

            if (form.getM_strthePhotofile() != null
                    && form.getM_strthePhotofile().length() > 0
                    && form.getM_strthePhotofileFileName() != null) {
                photoPath = uploadFile(
                        form.getM_strthePhotofileFileName(),
                        form.getM_strthePhotofile(),
                        baseUpload + "PHOTO/",
                        form);
            }
            if (form.getM_strtheBgcfile() != null
                    && form.getM_strtheBgcfile().length() > 0
                    && form.getM_strtheBgcfileFileName() != null) {
                bgcPath = uploadFile(
                        form.getM_strtheBgcfileFileName(),
                        form.getM_strtheBgcfile(),
                        baseUpload + "BGC/",
                        form);
            }
            if (form.getM_strthePoliceverificationfile() != null
                    && form.getM_strthePoliceverificationfile().length() > 0
                    && form.getM_strthePoliceverificationfileFileName() != null) {
                policePath = uploadFile(
                        form.getM_strthePoliceverificationfileFileName(),
                        form.getM_strthePoliceverificationfile(),
                        baseUpload + "Police/",
                        form);
            }
            if (form.getM_strtheCvfile() != null
                    && form.getM_strtheCvfile().length() > 0
                    && form.getM_strtheCvfileFileName() != null) {
                cvPath = uploadFile(
                        form.getM_strtheCvfileFileName(),
                        form.getM_strtheCvfile(),
                        baseUpload + "CV/",
                        form);
            }

            // ---- Insert into eisupport_employee_master ----
            String sqlEmp =
                    "INSERT INTO eisupport_employee_master ("
                  + "EMPLOYEE_ID,AD_ID,ASSET_ID,EDU_QUALIFICATION,TCS_JOINING_DATE,CONTACTNUMBER,"
                  + "EMERGENCY_CONTACTNUMBER,TEAM,TCS_MAILID,STATE,CITY,LOCAL_ADDRESS,GENDER,DOB,FIRSTNAME,"
                  + "MIDDLENAME,LASTNAME,VPN_HOSTNAME,LAPTOP_HOSTNAME,REMOTETYPE,VPN_VDI_MACADDRESS,"
                  + "VPN_VDI_IPADDRESS,CV_DOCUMENT_PATH,BGC_DOCUMENT_PATH,PHOTO_PATH,POLICE_VERIFICATION_PATH,"
                  + "USERNAME,PASSWORD,HID,SBI_MAILID) "
                  + "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)";

            psEmp = con.prepareStatement(sqlEmp);
            bindInsertParams(psEmp, request, cvPath, bgcPath, photoPath, policePath);
            psEmp.addBatch();
            psEmp.executeBatch();

            // ---- Insert into roster_employee_details ----
            String sqlRoster =
                    "INSERT INTO roster_employee_details ("
                  + "EMPLOYEE_ID,AD_ID,ASSET_ID,EDU_QUALIFICATION,TCS_JOINING_DATE,CONTACTNUMBER,"
                  + "EMERGENCY_CONTACTNUMBER,TEAM,TCS_MAILID,STATE,CITY,LOCAL_ADDRESS,GENDER,DOB,FIRSTNAME,"
                  + "MIDDLENAME,LASTNAME,VPN_HOSTNAME,LAPTOP_HOSTNAME,REMOTETYPE,VPN_VDI_MACADDRESS,"
                  + "VPN_VDI_IPADDRESS,CV_DOCUMENT_PATH,BGC_DOCUMENT_PATH,PHOTO_PATH,POLICE_VERIFICATION_PATH,"
                  + "USERNAME,PASSWORD,HID,SBI_MAILID) "
                  + "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)";

            psRoster = con.prepareStatement(sqlRoster);
            bindInsertParams(psRoster, request, cvPath, bgcPath, photoPath, policePath);
            psRoster.addBatch();
            psRoster.executeBatch();

            System.out.println("Updated in Roster Employee Table");

            clearForm(form);
            return "thanks";

        } catch (Exception e) {
            e.printStackTrace();
            form.setM_strmsg("error");
            return "success";
        } finally {
            closeQuietly(checkRs, checkSt, psEmp, psRoster, con);
        }
    }

    // =====================================================================
    // PRIVATE HELPERS

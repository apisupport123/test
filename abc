<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    background: #05060a;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ============ HEADER / TIMER STRIP ============ */
  .top-strip {
    background: #0d1018;
    border-bottom: 1px solid #1c2030;
    padding: 18px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .timer-block {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .timer-label {
    font-size: 20px;
    font-weight: 700;
    color: #b8bcd4;
    letter-spacing: 0.3px;
  }

  .timer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 130px;
    padding: 8px 18px;
    border: 3px solid #6366f1;
    border-radius: 10px;
    color: #ffffff;
    font-family: 'Courier New', monospace;
    font-size: 38px;
    font-weight: 900;
    background: rgba(99, 102, 241, 0.08);
    letter-spacing: 1px;
  }

  .time-range {
    font-size: 16px;
    font-weight: 600;
    color: #8b90b0;
    font-family: 'Courier New', monospace;
  }

  .live-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    color: #10b981;
    letter-spacing: 1.5px;
  }

  .live-badge .pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #10b981;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* ============ KPI STRIP ============ */
  .kpi-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: #1c2030;
    border-bottom: 1px solid #1c2030;
  }

  .kpi {
    background: #0a0d15;
    padding: 22px 28px;
  }

  .kpi-label {
    font-size: 14px;
    font-weight: 700;
    color: #8b90b0;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 10px;
  }

  .kpi-value {
    font-family: 'Courier New', monospace;
    font-size: 52px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -1px;
    color: #ffffff;
  }

  .kpi-value.red    { color: #ef4444; }
  .kpi-value.orange { color: #f59e0b; }
  .kpi-value.green  { color: #10b981; }

  .kpi-sub {
    font-size: 12px;
    color: #5c6183;
    font-family: 'Courier New', monospace;
    margin-top: 8px;
  }

  /* ============ MAIN LAYOUT ============ */
  .main {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 16px;
    padding: 20px 24px 24px;
  }

  .chart-wrap {
    background: #0d1018;
    border: 1px solid #1c2030;
    border-radius: 12px;
    padding: 8px;
    min-height: 820px;
  }

  #myChart {
    width: 100%;
    height: 800px;
    position: relative;
  }

  /* ============ SIDE PANEL ============ */
  .side {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .panel {
    background: #0d1018;
    border: 1px solid #1c2030;
    border-radius: 12px;
    overflow: hidden;
  }

  .panel-head {
    padding: 16px 20px;
    border-bottom: 1px solid #1c2030;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #8b90b0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .panel-head::before {
    content: '';
    width: 4px;
    height: 16px;
    background: #6366f1;
    border-radius: 2px;
  }

  .panel-body {
    padding: 16px 20px;
  }

  /* Severity rows */
  .sev {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    font-size: 17px;
    font-weight: 700;
  }
  .sev + .sev { border-top: 1px solid #1c2030; }

  .sev-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .sev-swatch {
    width: 8px;
    height: 32px;
    border-radius: 4px;
  }

  .sev-range {
    font-family: 'Courier New', monospace;
    font-size: 15px;
    color: #8b90b0;
    font-weight: 700;
  }

  /* Critical list */
  .crit-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid #1c2030;
  }
  .crit-row:last-child { border-bottom: none; }

  .crit-name {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 200px;
  }

  .crit-pct {
    font-family: 'Courier New', monospace;
    font-size: 24px;
    font-weight: 900;
    color: #ef4444;
  }

  .empty-msg {
    font-size: 16px;
    color: #5c6183;
    text-align: center;
    padding: 24px 0;
    font-family: 'Courier New', monospace;
    font-weight: 700;
  }

  /* Help */
  .help {
    font-size: 15px;
    line-height: 2.1;
    color: #8b90b0;
    font-weight: 500;
  }
  .help b { color: #ffffff; font-weight: 800; }

  .footer {
    text-align: center;
    color: #5c6183;
    font-size: 13px;
    padding: 20px;
    font-family: 'Courier New', monospace;
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .main { grid-template-columns: 1fr; }
    .side { display: grid; grid-template-columns: repeat(3, 1fr); }
    .kpi-strip { grid-template-columns: repeat(2, 1fr); }
    .kpi-value { font-size: 40px; }
    .timer { font-size: 30px; min-width: 110px; }
  }
  @media (max-width: 700px) {
    .side { grid-template-columns: 1fr; }
    .kpi-strip { grid-template-columns: 1fr 1fr; }
    .kpi-value { font-size: 32px; }
    .kpi { padding: 16px; }
    .timer-label { font-size: 16px; }
    .timer { font-size: 24px; min-width: 90px; padding: 6px 12px; }
    #myChart { height: 640px; }
  }
</style>

</head>

<body onload="myFunction_Time()">

<!-- ============ TOP STRIP: TIMER + LIVE ============ -->

    transition: all .3s;
    box-shadow: 0 6px 20px rgba(124,58,237,.35);
    font-family: 'Inter', sans-serif;
    letter-spacing: .8px;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
}
.apply-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(124,58,237,.5); }
.apply-btn.reset { background: rgba(255,255,255,.08); box-shadow: none; }
.apply-btn.reset:hover { background: rgba(255,255,255,.15); }

/* ═══════════════════════════════════════════════════════════
   SQL MODAL — OVERLAY (no page push)
   ═══════════════════════════════════════════════════════════ */
.sql-box {
    display: none;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2000;
    width: 90vw;
    max-width: 900px;
    max-height: 80vh;
    overflow-y: auto;
    background: rgba(0,0,0,.95);
    border: 1px solid rgba(251,191,36,.35);
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 30px 80px rgba(0,0,0,.9);
}
.sql-box.show { display: block; }
.sql-box pre {
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: #a5b4fc;
    white-space: pre-wrap;
    word-break: break-all;
    margin: 0;
    padding: 10px;
    background: rgba(255,255,255,.05);
    border-radius: 8px;
    border-left: 3px solid #fbbf24;
}
.sql-box .copy-btn {
    margin-top: 6px;
    background: rgba(251,191,36,.18);
    border: 1px solid rgba(251,191,36,.4);
    color: #fbbf24;
    padding: 5px 14px;
    border-radius: 30px;
    font-size: 10px;
    font-weight: 900;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    letter-spacing: .5px;
    text-transform: uppercase;
}
.sql-box .copy-btn:hover { background: rgba(251,191,36,.32); }
.sql-box .copy-msg { color: #34d399; font-size: 11px; margin-left: 8px; display: none; font-weight: 800; }
.sql-box .lbl {
    color: #fbbf24;
    font-weight: 900;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 6px;
    margin-top: 12px;
}
.sql-box .lbl:first-child { margin-top: 0; }
.sql-box .lbl.inbound { color: #60a5fa; }
.sql-box .lbl.outbound { color: #fbbf24; }
.sql-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.75);
    backdrop-filter: blur(4px);
    z-index: 1999;
}
.sql-overlay.show { display: block; }

/* ═══════════════════════════════════════════════════════════
   PANELS — FILL REMAINING HEIGHT
   ═══════════════════════════════════════════════════════════ */
.panels {
    flex: 1;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 10px;
    min-height: 0;
    overflow: hidden;
}
@media (max-width: 1200px) { .panels { grid-template-columns: 1fr; } }

.panel {
    background: linear-gradient(145deg, rgba(255,255,255,.04), rgba(255,255,255,.015));
    backdrop-filter: blur(20px);
    border-radius: 18px;
    padding: 12px 14px;
    border: 1px solid rgba(255,255,255,.06);
    box-shadow: 0 16px 40px rgba(0,0,0,.35);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
}
.panel::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, #a78bfa, #60a5fa, transparent);
    opacity: .7;
}
.panel.outbound-panel::before {
    background: linear-gradient(90deg, transparent, #fbbf24, #f59e0b, transparent);
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255,255,255,.06);
    flex-shrink: 0;
}
.panel-title {
    font-size: 16px;
    font-weight: 900;
    letter-spacing: -.3px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.panel-title .icon {
    width: 30px;
    height: 30px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    background: linear-gradient(145deg, rgba(167,139,250,.25), rgba(96,165,250,.15));
    border: 1px solid rgba(167,139,250,.35);
}
.panel.outbound-panel .panel-title .icon {
    background: linear-gradient(145deg, rgba(251,191,36,.25), rgba(245,158,11,.15));
    border-color: rgba(251,191,36,.35);
}
.panel-title .txt {
    background: linear-gradient(135deg, #fff, #c4b5fd);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.panel.outbound-panel .panel-title .txt {
    background: linear-gradient(135deg, #fff, #fbbf24);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.panel-sub {
    font-size: 9px;
    color: rgba(255,255,255,.35);
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-top: 1px;
}
.elapsed-badge {
    background: rgba(52,211,153,.12);
    border: 1px solid rgba(52,211,153,.3);
    color: #34d399;
    padding: 4px 10px;
    border-radius: 30px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1px;
}

/* ═══════════════════════════════════════════════════════════
   OUTBOUND HERO — compact
   ═══════════════════════════════════════════════════════════ */
.outbound-hero {
    background: linear-gradient(145deg, rgba(251,191,36,.12), rgba(245,158,11,.04));
    border: 1px solid rgba(251,191,36,.3);
    border-radius: 16px;
    padding: 18px 14px;
    text-align: center;
    position: relative;
    overflow: hidden;
    margin-bottom: 10px;
    flex-shrink: 0;
}
.outbound-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(251,191,36,.15), transparent 60%);
    pointer-events: none;
}
.outbound-hero .label {
    font-size: 10px;
    font-weight: 900;
    color: rgba(251,191,36,.7);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 6px;
}
.outbound-hero .value {
    font-size: 64px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -3px;
    background: linear-gradient(135deg, #fbbf24, #f59e0b, #fbbf24);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 25px rgba(251,191,36,.35));
}
.outbound-hero .unit {
    font-size: 11px;
    font-weight: 800;
    color: rgba(255,255,255,.4);
    letter-spacing: 3px;
    margin-top: 4px;
    text-transform: uppercase;
}
.outbound-hero .status {
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 60px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
}
.outbound-hero .status.up {
    background: rgba(52,211,153,.15);
    color: #34d399;
    border: 1px solid rgba(52,211,153,.35);
}
.outbound-hero .status.down {
    background: rgba(248,113,113,.15);
    color: #f87171;
    border: 1px solid rgba(248,113,113,.35);
}
.outbound-hero.blink-down { animation: blinkAmber 1s ease-in-out infinite; }
@keyframes blinkAmber {
    0%,100% { border-color: rgba(251,191,36,.3); }
    50% { border-color: #f87171; box-shadow: 0 0 30px rgba(248,113,113,.3); }
}

.outbound-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    flex-shrink: 0;
}
.meta-box {
    background: rgba(0,0,0,.3);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 10px;
    padding: 8px 10px;
    text-align: center;
}
.meta-box .mlabel {
    font-size: 8px;
    font-weight: 900;
    color: rgba(255,255,255,.35);
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-bottom: 3px;
}
.meta-box .mvalue { font-size: 12px; font-weight: 900; color: #fff; }

/* ═══════════════════════════════════════════════════════════
   INBOUND MINI STATS — 4 in row
   ═══════════════════════════════════════════════════════════ */
.mini-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 10px;
    flex-shrink: 0;
}
.mini-stat {
    background: rgba(0,0,0,.35);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 12px;
    padding: 9px 10px;
    position: relative;
    overflow: hidden;
}
.mini-stat::before {
    content: '';
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 3px;
    border-radius: 3px;
}
.mini-stat.purple::before { background: #a78bfa; }
.mini-stat.green::before { background: #34d399; }
.mini-stat.blue::before { background: #60a5fa; }
.mini-stat.red::before { background: #f87171; }
.mini-stat .mlabel {
    font-size: 9px;
    font-weight: 900;
    color: rgba(255,255,255,.4);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 3px;
}
.mini-stat .mvalue {
    font-size: 20px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -.5px;
}
.mini-stat.purple .mvalue {
    background: linear-gradient(135deg, #a78bfa, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.mini-stat.green .mvalue {
    background: linear-gradient(135deg, #34d399, #6ee7b7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.mini-stat.blue .mvalue {
    background: linear-gradient(135deg, #60a5fa, #3b82f6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.mini-stat.red .mvalue {
    background: linear-gradient(135deg, #f87171, #ef4444);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.mini-stat.blink-zero { animation: blinkStat 1.2s ease-in-out infinite; }
@keyframes blinkStat {
    0%,100% { background: rgba(0,0,0,.35); }
    50% { background: rgba(248,113,113,.12); }
}

/* ═══════════════════════════════════════════════════════════
   CARTS — INTERNAL SCROLL ONLY
   ═══════════════════════════════════════════════════════════ */
.carts-title {
    font-size: 10px;
    font-weight: 900;
    color: rgba(255,255,255,.6);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}
.carts-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(255,255,255,.15), transparent);
}
.carts {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 10px;
    overflow-y: auto;
    padding: 2px 6px 4px 2px;
    min-height: 0;
    align-content: start;
}
.cart {
    background: linear-gradient(145deg, rgba(255,255,255,.055), rgba(255,255,255,.02));
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 16px;
    padding: 12px 11px 10px;
    transition: all .35s cubic-bezier(.23,1,.32,1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 6px 18px rgba(0,0,0,.3);
    min-height: 140px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}
.cart::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 30% 15%, rgba(167,139,250,.12), transparent 65%);
    pointer-events: none;
    opacity: 0;
    transition: opacity .5s;
}
.cart:hover::before { opacity: 1; }
.cart:hover {
    transform: translateY(-3px);
    border-color: rgba(167,139,250,.35);
    box-shadow: 0 16px 36px rgba(0,0,0,.55);
}
.cart-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255,255,255,.07);
}
.cart-ip {
    font-size: 16px;
    font-weight: 900;
    color: #fff;
    letter-spacing: -.4px;
    line-height: 1.1;
    background: linear-gradient(135deg, #fff, #c4b5fd);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.cart-ip small {
    display: block;
    font-size: 9px;
    color: rgba(255,255,255,.35);
    font-weight: 700;
    margin-top: 2px;
    letter-spacing: .3px;
    -webkit-text-fill-color: rgba(255,255,255,.35);
}
.mode-tag {
    padding: 3px 9px;
    border-radius: 30px;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
    flex-shrink: 0;
}
.mode-tag.pr {
    background: linear-gradient(145deg, #f43f5e, #e11d48);
    color: #fff;
    box-shadow: 0 3px 10px rgba(244,63,94,.4);
}
.mode-tag.dr {
    background: linear-gradient(145deg, #10b981, #059669);
    color: #fff;
    box-shadow: 0 3px 10px rgba(16,185,129,.4);
}
.cart-hits {
    font-size: 38px;
    font-weight: 900;
    text-align: center;
    line-height: 1;
    letter-spacing: -2px;
    background: linear-gradient(135deg, #fff, #a78bfa 60%, #60a5fa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 4px 0;
    filter: drop-shadow(0 0 15px rgba(167,139,250,.25));
}
.cart-hits .u {
    font-size: 9px;
    font-weight: 900;
    -webkit-text-fill-color: rgba(255,255,255,.35);
    letter-spacing: 2px;
    display: block;
    margin-top: 2px;
}
.cart-status {
    text-align: center;
    padding: 5px;
    border-radius: 9px;
    font-size: 9px;
    font-weight: 900;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.06);
    letter-spacing: 1px;
    text-transform: uppercase;
}
.cart-status.up {
    color: #34d399;
    background: rgba(52,211,153,.08);
    border-color: rgba(52,211,153,.2);
}
.cart-status.down {
    color: #f87171;
    background: rgba(248,113,113,.08);
    border-color: rgba(248,113,113,.25);
}
.cart.blink-zero { animation: blinkRed 1s ease-in-out infinite; border-color: #f87171; }
@keyframes blinkRed {
    0%,100% { background: linear-gradient(145deg, rgba(255,255,255,.055), rgba(255,255,255,.02)); border-color: rgba(248,113,113,.3); }
    50% { background: linear-gradient(145deg, rgba(248,113,113,.14), rgba(248,113,113,.06)); border-color: #f87171; box-shadow: 0 0 30px rgba(248,113,113,.3); }
}

.empty-state {
    text-align: center;
    padding: 30px 20px;
    background: rgba(255,255,255,.02);
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,.05);
}
.empty-state h3 {
    font-size: 16px;
    font-weight: 800;
    margin-bottom: 6px;
    background: linear-gradient(135deg, #fff, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.empty-state p { color: rgba(255,255,255,.4); font-size: 12px; }
.error-box {
    background: rgba(248,113,113,.08);
    border: 1px solid rgba(248,113,113,.3);
    border-radius: 12px;
    padding: 12px;
    color: #f87171;
    font-size: 11px;
    font-weight: 700;
    word-break: break-word;
}

/* ═══════════════════════════════════════════════════════════
   FOOTER — TINY
   ═══════════════════════════════════════════════════════════ */
.footer {
    flex-shrink: 0;
    text-align: center;
    padding: 6px;
    color: rgba(255,255,255,.25);
    font-size: 9px;
    letter-spacing: .8px;
    border-top: 1px solid rgba(255,255,255,.05);
    font-weight: 700;
    text-transform: uppercase;
}
.footer strong { color: rgba(255,255,255,.5); }

/* ═══════════════════════════════════════════════════════════
   MUTE BUTTON
   ═══════════════════════════════════════════════════════════ */
.audio-controls { position: fixed; bottom: 16px; right: 16px; z-index: 1000; }
.mute-btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
    color: #fff;
    font-size: 10px;
    font-weight: 900;
    cursor: pointer;
    transition: all .3s;
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 28px rgba(0,0,0,.5);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    letter-spacing: 1px;
}
.mute-btn:hover { transform: scale(1.08); }
.mute-btn.sound-on { background: rgba(52,211,153,.18); border-color: rgba(52,211,153,.4); color: #34d399; }
.mute-btn.sound-off { background: rgba(248,113,113,.15); border-color: rgba(248,113,113,.35); color: #f87171; }
.mute-btn .indicator {
    position: absolute;
    top: -3px;
    right: -3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #34d399;
    border: 2px solid #06080f;
    animation: pulseDot 1.5s ease-in-out infinite;
}
.mute-btn.sound-off .indicator { background: #f87171; }

/* ═══════════════════════════════════════════════════════════
   SCROLLBAR
   ═══════════════════════════════════════════════════════════ */
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: rgba(255,255,255,.02); }
::-webkit-scrollbar-thumb { background: rgba(167,139,250,.3); border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: rgba(167,139,250,.5); }

/* ═══════════════════════════════════════════════════════════
   MOBILE — allow scroll
   ═══════════════════════════════════════════════════════════ */
@media (max-width: 768px) {
    html, body { overflow: auto; height: auto; }
    body { padding: 8px; }
    .container { height: auto; }
    .header h1 { font-size: 16px; }
    .header h1 small { font-size: 9px; margin-left: 6px; }
    .header { padding: 10px 12px; }
    .panels { grid-template-columns: 1fr; }
    .carts { max-height: 400px; }
    .mini-stats { grid-template-columns: repeat(2, 1fr); }
    .outbound-hero .value { font-size: 48px; }
    .chip { font-size: 10px; padding: 5px 9px; }
    .dt-picker { flex-direction: column; }
    .dt-input { min-width: 100%; }
    .apply-btn { width: 100%; justify-content: center; }
    .outbound-meta { grid-template-columns: 1fr 1fr; }
}
</style>
</head>
<body>
<div class="container">

<!-- ═══════════════════ HEADER ═══════════════════ -->
<div class="header">
<div class="header-top">
<div>
<h1>DMZ DPG Monitoring <small>Inbound &amp; Outbound · Parallel · Real-time</small></h1>
</div>
<div class="header-actions">
<span class="live-badge"><span class="dot"></span> LIVE</span>
<button class="btn" onclick="refreshPage()" id="refreshBtn">
<svg viewBox="0 0 24 24"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg> Refresh
</button>
<a href="<%= request.getRequestURI() %>?action=refreshMaster&mute=<%= isMuted %><%= (manualFromTime!=null?"&fromTime="+manualFromTime:"") %><%= (manualToTime!=null?"&toTime="+manualToTime:"") %>" class="btn btn-refresh-ip" onclick="return confirm('Refresh IP list?');">
<svg viewBox="0 0 24 24"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg> IPs
</a>
<button class="btn btn-sql" onclick="toggleSqlBox()">
<svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg> SQL
</button>
</div>
</div>

<!-- ── INFO BAR + COUNTDOWN ── -->
<div class="info-bar">
<div class="chip"><span>⏱</span> <span class="val"><%= timeRangeDisplay %></span></div>
<div class="chip partition"><span>📅</span> <%= activePartition %></div>
<div class="chip timing"><span>⚡</span> <span class="val"><%= totalElapsed %> ms</span></div>
<div class="chip countdown-chip" id="countdownChip">
<span>🔄</span> NEXT: <span class="val" id="countdown">10:00</span>
</div>
<div class="chip"><span>🕐</span> <span class="val"><%= currentTime %></span></div>
</div>

<!-- ── DATETIME ── -->
<div class="dt-section">
<form method="get" action="" id="mainForm">
<input type="hidden" name="mute" value="<%= isMuted %>">
<div class="dt-picker">
<div class="dt-input"><label>FROM</label><input type="datetime-local" name="fromTime" id="fromTime" value="<%= manualFromTime!=null?manualFromTime:"" %>"></div>
<div class="dt-input"><label>TO</label><input type="datetime-local" name="toTime" id="toTime" value="<%= manualToTime!=null?manualToTime:"" %>"></div>
<button type="submit" class="apply-btn">APPLY</button>
<% if(manualFromTime != null || manualToTime != null) { %>
<a href="<%= request.getRequestURI() %>?mute=<%= isMuted %>" class="apply-btn reset">RESET</a>
<% } %>
</div>
</form>
</div>
</div>

<!-- ═══════════════════ SQL MODAL ═══════════════════ -->
<div id="sqlOverlay" class="sql-overlay" onclick="toggleSqlBox()"></div>
<div id="sqlBox" class="sql-box">
<div class="lbl inbound">🔵 Inbound Query — API_LOG</div>
<pre id="inboundSql"><%= displayInboundQ %></pre>
<button class="copy-btn" onclick="copySql('inboundSql','copyMsg1')">Copy Inbound</button>
<span id="copyMsg1" class="copy-msg">✓ Copied!</span>

<div class="lbl outbound">🟡 Outbound Query — BACKEND_LOG (port 7443)</div>
<pre id="outboundSql"><%= displayOutboundQ %></pre>
<button class="copy-btn" onclick="copySql('outboundSql','copyMsg2')">Copy Outbound</button>
<span id="copyMsg2" class="copy-msg">✓ Copied!</span>
</div>

<!-- ═══════════════════ TWO PANELS ═══════════════════ -->
<div class="panels">

<!-- ─── INBOUND PANEL ─── -->
<div class="panel">
<div class="panel-header">
<div>
<div class="panel-title">
<span class="icon">🔵</span>
<span class="txt">Inbound Traffic</span>
</div>
<div class="panel-sub">API_LOG · DPG IP Carts</div>
</div>
<div class="elapsed-badge">⚡ <%= inRes.elapsedMs %> ms</div>
</div>

<% if (inRes.error != null) { %>
<div class="error-box">❌ <%= inRes.error %></div>
<% } else if (inRes.ips.isEmpty()) { %>
<div class="empty-state">
<h3>IP Master List is Empty</h3>
<p>Click <strong>Refresh IPs</strong> to populate from API_LOG.</p>
</div>
<% } else { %>

<div class="mini-stats">
<div class="mini-stat purple <%= inRes.totalHits==0?"blink-zero":"" %>">
<div class="mlabel">Total Hits</div>
<div class="mvalue"><%= inRes.totalHits %></div>
</div>
<div class="mini-stat red <%= inRes.zeroHits>0?"blink-zero":"" %>">
<div class="mlabel">Zero Hit</div>
<div class="mvalue"><%= inRes.zeroHits %></div>
</div>
<div class="mini-stat blue">
<div class="mlabel">Carts</div>
<div class="mvalue"><%= inRes.ips.size() %></div>
</div>
<div class="mini-stat green">
<div class="mlabel">PR / DR</div>
<div class="mvalue"><%= inRes.prCount %>/<%= inRes.drCount %></div>
</div>
</div>

<div class="carts-title">🔵 Live Carts — <%= inRes.ips.size() %> DPG IPs</div>
<div class="carts">
<%
List<String> sortedIps = new ArrayList<>(inRes.ips);
Collections.sort(sortedIps);
for (String ip : sortedIps) {
    int hits = inRes.countMap.getOrDefault(ip, 0);
    String mode = getMode(ip);
    String badge = "PR".equals(mode) ? "pr" : "dr";
    boolean zero = hits == 0;
%>
<div class="cart <%= zero?"blink-zero":"" %>">
<div class="cart-header">
<div class="cart-ip"><%= maskIp(ip) %><small><%= ip %></small></div>
<span class="mode-tag <%= badge %>"><%= mode %></span>
</div>
<div class="cart-hits"><%= hits %><span class="u">HITS</span></div>
<div class="cart-status <%= zero?"down":"up" %>"><%= zero?"● DOWN":"● UP" %></div>
</div>
<% } %>
</div>
<% } %>
</div>

<!-- ─── OUTBOUND PANEL ─── -->
<div class="panel outbound-panel">
<div class="panel-header">
<div>
<div class="panel-title">
<span class="icon">🟡</span>
<span class="txt">Outbound Traffic</span>
</div>
<div class="panel-sub">BACKEND_LOG · Port 7443</div>
</div>
<div class="elapsed-badge">⚡ <%= outRes.elapsedMs %> ms</div>
</div>

<% if (outRes.error != null) { %>
<div class="error-box">❌ <%= outRes.error %></div>
<% } else { %>

<div class="outbound-hero <%= outRes.hits==0?"blink-down":"" %>">
<div class="label">Total Outbound Hits</div>
<div class="value"><%= outRes.hits %></div>
<div class="unit">Requests on Port 7443</div>
<div class="status <%= outRes.hits>0?"up":"down" %>">
<%= outRes.hits>0?"● ACTIVE":"● NO TRAFFIC" %>
</div>
</div>

<div class="outbound-meta">
<div class="meta-box">
<div class="mlabel">Port</div>
<div class="mvalue">7443</div>
</div>
<div class="meta-box">
<div class="mlabel">Partition</div>
<div class="mvalue" style="color:#fbbf24;"><%= outRes.partition %></div>
</div>
<div class="meta-box">
<div class="mlabel">Table</div>
<div class="mvalue" style="font-size:11px;">BACKEND_LOG</div>
</div>
</div>

<% } %>
</div>

</div><!-- end panels -->

<!-- ═══════════════════ FOOTER ═══════════════════ -->
<div class="footer">
DMZ DPG Monitoring · <strong>PR</strong> 171.x · <strong>DR</strong> 176.x · Parallel · Auto-refresh 10 min · Partition: <strong style="color:#fbbf24;"><%= activePartition %></strong>
</div>
</div>

<!-- ── MUTE ── -->
<div class="audio-controls">
<%
String newMute = isMuted ? "false" : "true";
String muteUrl = request.getRequestURI() + "?mute=" + newMute;
if (manualFromTime != null) muteUrl += "&fromTime=" + manualFromTime;
if (manualToTime != null) muteUrl += "&toTime=" + manualToTime;
%>
<a href="<%= muteUrl %>" class="mute-btn <%= isMuted ? "sound-off" : "sound-on" %>">
<%= isMuted ? "OFF" : "ON" %>
<span class="indicator"></span>
</a>
</div>

<audio id="alertSound" preload="auto">
<source src="data:audio/wav;base64," type="audio/wav">
</audio>

<script>
// ═══════════════════════════════════════════════════════════
// LIVE COUNTDOWN — 10 min auto-refresh
// ═══════════════════════════════════════════════════════════
const REFRESH_INTERVAL_SEC = 600;
let secondsLeft = REFRESH_INTERVAL_SEC;

const countdownEl = document.getElementById('countdown');
const countdownChip = document.getElementById('countdownChip');

function updateCountdown() {
    const mins = Math.floor(secondsLeft / 60);
    const secs = secondsLeft % 60;
    countdownEl.textContent = String(mins).padStart(2,'0') + ':' + String(secs).padStart(2,'0');

    if (secondsLeft <= 60) {
        countdownChip.classList.add('warning');
    } else {
        countdownChip.classList.remove('warning');
    }

    if (secondsLeft <= 0) {
        countdownEl.textContent = 'RELOADING...';
        document.getElementById('mainForm').submit();
        return;
    }
    secondsLeft--;
}
updateCountdown();
setInterval(updateCountdown, 1000);

// ═══════════════════════════════════════════════════════════
// AUDIO ALERT
// ═══════════════════════════════════════════════════════════
const totalHits = <%= inRes.totalHits %>;
const zeroHits = <%= inRes.zeroHits %>;
const outboundHits = <%= outRes.hits %>;
let isMuted = <%= isMuted %>;
let alertPlayed = false;

const audio = document.getElementById('alertSound');
audio.load();

function checkAndPlayAlert() {
    if (totalHits === 0 && !isMuted && !alertPlayed) {
        audio.currentTime = 0;
        audio.play().catch(e => console.log('Audio failed:', e));
        alertPlayed = true;
        setTimeout(() => { alertPlayed = false; }, 5000);
    }
}
checkAndPlayAlert();
setInterval(checkAndPlayAlert, 3000);

// ═══════════════════════════════════════════════════════════
// SQL MODAL TOGGLE
// ═══════════════════════════════════════════════════════════
function toggleSqlBox() {
    document.getElementById('sqlBox').classList.toggle('show');
    document.getElementById('sqlOverlay').classList.toggle('show');
}

function copySql(id, msgId) {
    const text = document.getElementById(id).innerText;
    navigator.clipboard.writeText(text).then(() => {
        const m = document.getElementById(msgId);
        m.style.display = 'inline';
        setTimeout(() => { m.style.display = 'none'; }, 2500);
    }).catch(() => {
        const range = document.createRange();
        range.selectNode(document.getElementById(id));
        window.getSelection().removeAllRanges();
        window.getSelection().addRange(range);
        document.execCommand('copy');
        const m = document.getElementById(msgId);
        m.style.display = 'inline';
        setTimeout(() => { m.style.display = 'none'; }, 2500);
    });
}

function refreshPage() {
    const btn = document.getElementById('refreshBtn');
    btn.querySelector('svg').classList.add('spin');
    btn.disabled = true;
    btn.style.opacity = '0.6';
    document.getElementById('mainForm').submit();
}

document.addEventListener('DOMContentLoaded', () => {
    const f = document.getElementById('fromTime');
    const t = document.getElementById('toTime');
    if (!f.value) f.value = new Date(Date.now() - 10*60000).toISOString().slice(0,16);
    if (!t.value) t.value = new Date().toISOString().slice(0,16);
});

console.log('⚡ Parallel — total:', <%= totalElapsed %> + 'ms');
console.log('🔵 Inbound:', totalHits, '| 🟡 Outbound:', outboundHits);
console.log('🔄 Auto-refresh in 10:00 (countdown visible in header)');
</script>
</body>
</html>

      <td><span class="pill"><%= c %></span></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
    <tr class="summary-row">
      <td class="col-emp">General</td>
      <td class="col-pos"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int c = 0; for (Map<String,Object> e : employees) { String s = (String) e.get("day_" + d); if (s != null && (s.toLowerCase().contains("general")||s.toLowerCase().contains("genral"))) c++; }
      %>
      <td><span class="pill"><%= c %></span></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
    <tr class="summary-row">
      <td class="col-emp">Afternoon</td>
      <td class="col-pos"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int c = 0; for (Map<String,Object> e : employees) { String s = (String) e.get("day_" + d); if (s != null && s.toLowerCase().contains("afternoon")) c++; }
      %>
      <td><span class="pill"><%= c %></span></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
    <tr class="summary-row">
      <td class="col-emp">Night</td>
      <td class="col-pos"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int c = 0; for (Map<String,Object> e : employees) { String s = (String) e.get("day_" + d); if (s != null && s.toLowerCase().contains("night")) c++; }
      %>
      <td><span class="pill"><%= c %></span></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
  </tbody>
</table>
<% } %>

                            <option value="Female" <%="Female".equalsIgnoreCase(emp.getM_strGender()) ? "selected" : ""%>>Female</option>
                            <option value="Other" <%="Other".equalsIgnoreCase(emp.getM_strGender()) ? "selected" : ""%>>Other</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="field-label">Date of Birth</label>
                        <input class="field-input" type="date" name="m_strdob"
                               value="<%=emp.getM_strDate_Of_Birth() != null ? emp.getM_strDate_Of_Birth() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">Status</label>
                        <select class="field-select" name="m_strISACTIVE">
                            <option value="Active" <%="Active".equalsIgnoreCase(isActive) ? "selected" : ""%>>Active</option>
                            <option value="InActive" <%="InActive".equalsIgnoreCase(isActive) ? "selected" : ""%>>InActive</option>
                        </select>
                    </div>
                </div>
            </section>

            <!-- SECTION 03 — WORK -->
            <section class="section" id="s3">
                <div class="section-head">
                    <span class="section-num">03</span>
                    <span class="section-title">Work Information</span>
                    <span class="section-line"></span>
                </div>
                <div class="fields">
                    <div class="field">
                        <label class="field-label">Team / Role</label>
                        <input class="field-input" type="text" name="m_strRole"
                               value="<%=emp.getM_strTeam() != null ? emp.getM_strTeam() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">Education Qualification</label>
                        <select class="field-select" name="m_streduqualification">
                            <option value="">Select</option>
                            <%
                                String[] quals = {"B-Tech", "M-Tech", "BSC", "MSC", "BCA", "MCA"};
                                String currentQual = emp.getM_strEducation_Qualification() != null ? emp.getM_strEducation_Qualification() : "";
                                for (String q : quals) {
                            %>
                                <option value="<%=q%>" <%=q.equals(currentQual) ? "selected" : ""%>><%=q%></option>
                            <% } %>
                        </select>

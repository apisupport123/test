<script>
(function(){
  try{
    var t = localStorage.getItem('eis-theme');
    if(!t){
      t = 'dark';
      localStorage.setItem('eis-theme', 'dark');
    }
    document.documentElement.setAttribute('data-theme', t);

    var tabName = window.name || '';

    if (tabName === 'eis-original-tab') {
      // original tab — panel OPEN
    } else if (tabName === 'eis-sub-tab') {
      document.documentElement.classList.add('sb-collapsed');
    } else {
      var freshLogin = sessionStorage.getItem('eis-fresh-login');

      if (freshLogin === '1') {
        sessionStorage.removeItem('eis-fresh-login');
        window.name = 'eis-original-tab';
      } else {
        document.documentElement.classList.add('sb-collapsed');
        window.name = 'eis-sub-tab';
      }
    }
  }catch(e){}
})();
</script>


}
html[data-theme="dark"] .btn-ghost-glass .badge-count-glass {
    background: rgba(248,111,3,.15);
}

/* ================================================================
   TICKER BAR
   ================================================================ */
.ticker-bar {
    display: flex;
    align-items: center;
    padding: 5px 14px;

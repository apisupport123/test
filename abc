<%@ page language="java" contentType="text/html; charset=ISO-8859-1" pageEncoding="ISO-8859-1"%>
<%@ taglib prefix="s" uri="/struts-tags" %>

<!DOCTYPE html>
<html>
<head>
<meta charset="ISO-8859-1">
<title>Failure Services</title>
<script src="${pageContext.request.contextPath}/js/jquery-3.3.1.min.js"></script>
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/bootstrap.min.css">
</head>

<body>

<s:form action="showFailureServicesWise" method="post">
    <%-- Preserve params across form submit --%>
    <s:hidden name="ServiceCategory" id="ServiceCategory" value="%{ServiceCategory}" />
    <s:hidden name="url"         id="url"         value="%{url}" />
    <s:hidden name="server"      id="server"      value="%{server}" />
    <s:hidden name="broker_Name" id="broker_Name" value="%{broker_Name}" />

    <div class="card my-3">
        <h5 class="card-header text-center">Failure Services</h5>
        <div class="card-body">

            <!-- Debug Info -->
            <div class="alert alert-info">
                <b>Debug Info:</b><br/>
                Server = <strong><s:property value="server" /></strong><br/>
                Broker Name = <strong><s:property value="broker_Name" /></strong><br/>
                ServiceCategory = <strong><s:property value="ServiceCategory" /></strong><br/>
                API Name = <strong><s:property value="url" /></strong><br/>
                DB_ENVLOCATION = <strong><s:property value="m_strENVLOCATION" /></strong><br/>
            </div>

            <!-- Total records -->
            <p>
                Total records loaded:
                <strong><s:property value="m_lstFailureServicedetail.size()" /></strong>
            </p>

            <s:if test="m_lstFailureServicedetail == null || m_lstFailureServicedetail.isEmpty()">
                <div class="alert alert-warning">No failure service data available!</div>
            </s:if>

            <s:else>
            <table class="table table-bordered table-sm table-hover">
                <thead class="thead-light">
                    <tr>
                        <th>API NAME</th>
                        <th>Broker Name</th>
                        <th>BrokerEG</th>
                        <th>Total Hits</th>
                        <th>Success</th>
                        <th>SI001</th>
                        <th>002</th>
                        <th>SI002</th>
                        <th>SI007</th>
                        <th>SI051</th>
                        <th>014</th>
                        <th>SI014</th>
                        <th>PARSING EXCEPTION</th>
                        <th>SI569</th>
                        <th>SI570</th>
                        <th>TD</th>
                        <th>TD Percent</th>
                        <th>BD</th>
                        <th>BD Percent</th>
                    </tr>
                </thead>
                <tbody>
                <s:iterator value="m_lstFailureServicedetail" var="list">
                    <tr>
                        <td><s:property value="#list.m_strAPIName" /></td>
                        <td><s:property value="#list.m_strbroker_name" /></td>
                        <td><s:property value="#list.m_strbroker_eg" /></td>
                        <td><s:property value="#list.m_strTOTAL_HITS" /></td>
                        <td><s:property value="#list.m_strSUCCESS" /></td>

                        <td style="cursor:pointer"
                            onclick="showreferenceno('SI001','<s:property value="#list.m_strAPIName" />')">
                            <s:property value="#list.m_str001" />
                        </td>
                        <td style="cursor:pointer"
                            onclick="showreferenceno('002','<s:property value="#list.m_strAPIName" />')">
                            <s:property value="#list.m_str002" />
                        </td>
                        <td style="cursor:pointer"
                            onclick="showreferenceno('SI002','<s:property value="#list.m_strAPIName" />')">
                            <s:property value="#list.m_strSI002" />
                        </td>
                        <td style="cursor:pointer"
                            onclick="showreferenceno('SI007','<s:property value="#list.m_strAPIName" />')">
                            <s:property value="#list.m_str007" />
                        </td>
                        <td style="cursor:pointer"
                            onclick="showreferenceno('SI051','<s:property value="#list.m_strAPIName" />')">
                            <s:property value="#list.m_str051" />
                        </td>
                        <td style="cursor:pointer"
                            onclick="showreferenceno('014','<s:property value="#list.m_strAPIName" />')">
                            <s:property value="#list.m_str014" />
                        </td>
                        <td style="cursor:pointer"
                            onclick="showreferenceno('SI014','<s:property value="#list.m_strAPIName" />')">
                            <s:property value="#list.m_strSI014" />
                        </td>
                        <td style="cursor:pointer"
                            onclick="showreferenceno('PARSING_EXCEPTION','<s:property value="#list.m_strAPIName" />')">
                            <s:property value="#list.m_strPARSINGEXCEPTION" />
                        </td>
                        <td style="cursor:pointer"
                            onclick="showreferenceno('SI569','<s:property value="#list.m_strAPIName" />')">
                            <s:property value="#list.m_str569" />
                        </td>
                        <td style="cursor:pointer"
                            onclick="showreferenceno('SI570','<s:property value="#list.m_strAPIName" />')">
                            <s:property value="#list.m_str570" />
                        </td>

                        <td><s:property value="#list.m_strTD" /></td>
                        <td><s:property value="#list.m_strTD_PERCENT" /></td>
                        <td><s:property value="#list.m_strBD" /></td>
                        <td><s:property value="#list.m_strBD_PERCENT" /></td>
                    </tr>
                </s:iterator>
                </tbody>
            </table>
            </s:else>
        </div>
    </div>
</s:form>

<script>
function showreferenceno(errorcode, apiname) {
    var serviceCategory = document.getElementById("ServiceCategory").value;
    var url = '${pageContext.request.contextPath}/Multiple?action=showfailurerefernceno'
        + '&errorcode=' + encodeURIComponent(errorcode)
        + '&apiname=' + encodeURIComponent(apiname)
        + '&ServiceCategory=' + encodeURIComponent(serviceCategory);
    window.open(url, '_blank');
}
</script>

</body>
</html>

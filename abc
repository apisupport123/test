    /**
     * Handles insert submission and clear case.
     * URL: saveRegistration.action
     */
    public String saveRegistration() throws Exception {

        System.out.println("========== saveRegistration START ==========");

        RegistrationActionForm form = getOrCreateForm();
        loadEISRole(form);

        HttpServletRequest request = ServletActionContext.getRequest();
        String actionParam = request.getParameter("action");

        System.out.println("[DEBUG] actionParam = " + actionParam);

        if (actionParam == null) {
            clearForm(form);
            return "success";
        }
        if (!"insert".equals(actionParam)) {
            clearForm(form);
            return "success";
        }

        Connection con = null;
        PreparedStatement psEmp = null;
        PreparedStatement psRoster = null;
        Statement checkSt = null;
        ResultSet checkRs = null;

        try {
            con = DBUtilityAuto.getReportDBConnection();
            System.out.println("[DEBUG] DB Connected OK");

            // ---- Duplicate check ----
            String empId = request.getParameter("m_stremployee_id");
            String countQuery = "select count(*) from eisupport_employee_master where EMPLOYEE_ID='"
                    + empId + "'";
            checkSt = con.createStatement();
            checkRs = checkSt.executeQuery(countQuery);

            int count = 0;
            if (checkRs != null && checkRs.next()) {
                count = checkRs.getInt(1);
            }
            System.out.println("[DEBUG] Duplicate count = " + count);

            if (count > 0) {
                form.setM_strmsg("duplicate");
                this.setM_strmsg("duplicate");
                return "success";
            }

            // ============================================================
            // FILE UPLOAD — Now with proper logging & checks
            // ============================================================
            String photoPath  = "";
            String bgcPath    = "";
            String policePath = "";
            String cvPath     = "";

            String baseUpload = System.getProperty("catalina.base")
                    + "/webapps/EISPortalVer2/EISEMPLOYEEDOCUMENT/";

            System.out.println("[DEBUG] Upload base path: " + baseUpload);

            // ---- PHOTO ----
            File   photoFile = form.getM_strthePhotofile();
            String photoName = form.getM_strthePhotofileFileName();
            System.out.println("[DEBUG] PHOTO File object   = " + photoFile);
            System.out.println("[DEBUG] PHOTO original name = " + photoName);
            if (photoFile != null && photoName != null && photoName.trim().length() > 0) {
                photoPath = uploadFile(photoName, photoFile, baseUpload + "PHOTO/", form);
                System.out.println("[DEBUG] PHOTO saved as = " + photoPath);
            }

            // ---- BGC ----
            File   bgcFile = form.getM_strtheBgcfile();
            String bgcName = form.getM_strtheBgcfileFileName();
            System.out.println("[DEBUG] BGC File object   = " + bgcFile);
            System.out.println("[DEBUG] BGC original name = " + bgcName);
            if (bgcFile != null && bgcName != null && bgcName.trim().length() > 0) {
                bgcPath = uploadFile(bgcName, bgcFile, baseUpload + "BGC/", form);
                System.out.println("[DEBUG] BGC saved as = " + bgcPath);
            }

            // ---- POLICE VERIFICATION ----
            File   policeFile = form.getM_strthePoliceverificationfile();
            String policeName = form.getM_strthePoliceverificationfileFileName();
            System.out.println("[DEBUG] POLICE File object   = " + policeFile);
            System.out.println("[DEBUG] POLICE original name = " + policeName);
            if (policeFile != null && policeName != null && policeName.trim().length() > 0) {
                policePath = uploadFile(policeName, policeFile, baseUpload + "Police/", form);
                System.out.println("[DEBUG] POLICE saved as = " + policePath);
            }

            // ---- CV ----
            File   cvFile = form.getM_strtheCvfile();
            String cvName = form.getM_strtheCvfileFileName();
            System.out.println("[DEBUG] CV File object   = " + cvFile);
            System.out.println("[DEBUG] CV original name = " + cvName);
            if (cvFile != null && cvName != null && cvName.trim().length() > 0) {
                cvPath = uploadFile(cvName, cvFile, baseUpload + "CV/", form);
                System.out.println("[DEBUG] CV saved as = " + cvPath);
            }

            System.out.println("[DEBUG] Final paths: photo=" + photoPath
                    + " bgc=" + bgcPath + " police=" + policePath + " cv=" + cvPath);

            // ============================================================
            // INSERT — eisupport_employee_master
            // ============================================================
            String sqlEmp =
                    "INSERT INTO eisupport_employee_master ("
                  + "EMPLOYEE_ID,AD_ID,ASSET_ID,EDU_QUALIFICATION,TCS_JOINING_DATE,CONTACTNUMBER,"
                  + "EMERGENCY_CONTACTNUMBER,TEAM,TCS_MAILID,STATE,CITY,LOCAL_ADDRESS,GENDER,DOB,FIRSTNAME,"
                  + "MIDDLENAME,LASTNAME,VPN_HOSTNAME,LAPTOP_HOSTNAME,REMOTETYPE,VPN_VDI_MACADDRESS,"
                  + "VPN_VDI_IPADDRESS,CV_DOCUMENT_PATH,BGC_DOCUMENT_PATH,PHOTO_PATH,POLICE_VERIFICATION_PATH,"
                  + "USERNAME,PASSWORD,HID,SBI_MAILID) "
                  + "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)";

            psEmp = con.prepareStatement(sqlEmp);
            bindInsertParams(psEmp, request, cvPath, bgcPath, photoPath, policePath);
            psEmp.executeUpdate();
            System.out.println("[DEBUG] Inserted into eisupport_employee_master");

            // ============================================================
            // INSERT — roster_employee_details
            // ============================================================
            String sqlRoster =
                    "INSERT INTO roster_employee_details ("
                  + "EMPLOYEE_ID,AD_ID,ASSET_ID,EDU_QUALIFICATION,TCS_JOINING_DATE,CONTACTNUMBER,"
                  + "EMERGENCY_CONTACTNUMBER,TEAM,TCS_MAILID,STATE,CITY,LOCAL_ADDRESS,GENDER,DOB,FIRSTNAME,"
                  + "MIDDLENAME,LASTNAME,VPN_HOSTNAME,LAPTOP_HOSTNAME,REMOTETYPE,VPN_VDI_MACADDRESS,"
                  + "VPN_VDI_IPADDRESS,CV_DOCUMENT_PATH,BGC_DOCUMENT_PATH,PHOTO_PATH,POLICE_VERIFICATION_PATH,"
                  + "USERNAME,PASSWORD,HID,SBI_MAILID) "
                  + "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)";

            psRoster = con.prepareStatement(sqlRoster);
            bindInsertParams(psRoster, request, cvPath, bgcPath, photoPath, policePath);
            psRoster.executeUpdate();
            System.out.println("[DEBUG] Inserted into roster_employee_details");

            clearForm(form);
            System.out.println("========== saveRegistration SUCCESS ==========");
            return "thanks";

        } catch (Exception e) {
            System.out.println("========== saveRegistration FAILED ==========");
            System.out.println("[ERROR] " + e.getClass().getName() + ": " + e.getMessage());
            e.printStackTrace();
            form.setM_strmsg("error");
            this.setM_strmsg("error");
            return "success";
        } finally {
            closeQuietly(checkRs, checkSt, psEmp, psRoster, con);
        }
    }


<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 7.0//EN"
    "https://struts.apache.org/dtds/struts-7.0.dtd">
<struts>

    <!-- ============================================================
         GLOBAL CONSTANTS (Struts 7 safe defaults)
         ============================================================ -->

    <!-- DMI off (security best practice in Struts 7) -->
    <constant name="struts.enable.DynamicMethodInvocation" value="false"/>

    <!-- devMode: production me false rakho, debug me true -->
    <constant name="struts.devMode" value="false"/>

    <!-- Action extension: .action and extensionless URLs -->
    <constant name="struts.action.extension" value="action,,"/>

    <!-- File upload max size: 20 MB -->
    <constant name="struts.multipart.maxSize" value="20971520"/>

    <!-- JSON plugin -->
    <constant name="struts.json.contentType" value="application/json"/>

    <!-- Optional: i18n encoding -->
    <constant name="struts.i18n.encoding" value="UTF-8"/>

    <!-- ============================================================
         DEFAULT PACKAGE
         ============================================================ -->
    <package name="default"
             namespace="/"
             extends="struts-default,json-default"
             strict-method-invocation="true">

        <!-- Global whitelist: ALL action methods must be listed here
             when strict-method-invocation="true" -->
        <global-allowed-methods>
            execute,
            usersign,
            adminsign,
            showeisissue,
            showregpage,
            saveRegistration,
            displayServices
        </global-allowed-methods>

        <!-- ========================================================
             TEST / DEBUG
             ======================================================== -->
        <action name="test">
            <result>/debug.jsp</result>
        </action>

        <!-- ========================================================
             LOGIN
             ======================================================== -->
        <action name="login" class="com.action.LoginAction" method="execute">
            <result name="success">/jsp/Eislogin.jsp</result>
            <result name="successadmin">/jsp/header.jsp</result>
            <result name="successmodule">/jsp/moduleHeader.jsp</result>
            <result name="successbanker">/jsp/Bankheader.jsp</result>
            <result name="successuser" type="redirectAction">userhomescreen</result>

            <!-- JSON results for AJAX -->
            <result name="jsonsuccess" type="json">
                <param name="root">jsonData</param>
                <param name="contentType">application/json</param>
                <param name="ignoreHierarchy">false</param>
                <param name="excludeNullProperties">true</param>
            </result>
            <result name="jsonerror" type="json">
                <param name="root">jsonData</param>
                <param name="contentType">application/json</param>
                <param name="ignoreHierarchy">false</param>
                <param name="excludeNullProperties">true</param>
            </result>
        </action>

        <action name="logout" class="com.action.LogoutAction" method="execute">
            <result name="success" type="redirect">login.action</result>
        </action>

        <!-- ========================================================
             HOME / DASHBOARDS
             ======================================================== -->
        <action name="userhomescreen" class="com.action.UserHomeScreenAction">
            <result name="success">/jsp/UserHomeScreen.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <!-- ========================================================
             MASTER SCREENS
             ======================================================== -->
        <action name="eissop" class="com.action.SOPMasterAction">
            <result name="success">/jsp/SopMaster.jsp</result>
        </action>

        <action name="role" class="com.action.RoleMasterAction">
            <result name="success">/jsp/RoleMaster.jsp</result>
        </action>

        <action name="rolesetting" class="com.action.RoleSettingMasterAction">
            <result name="success">/jsp/RoleSettingMaster.jsp</result>
        </action>

        <action name="showkpi" class="com.action.showkpi">
            <result name="success">/jsp/KPI.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="expmonitoring" class="com.action.EXPMonitorPortalAction">
            <result name="success">/jsp/EXPMonitoringPortal.jsp</result>
        </action>

        <action name="sysmonitoring" class="com.action.SYSMonitorPortalAction">
            <result name="success">/jsp/SYSMonitoringPortal.jsp</result>
        </action>

        <action name="top20service" class="com.action.Top20ServiceAction">
            <result name="success">/jsp/Top20Service.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="top20nongen5service" class="com.action.Top20NonGen5ServiceAction">
            <result name="success">/jsp/Top20NonGen5Service.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="TEST_Multithreding" class="com.action.TEST_Multithreding">
            <result name="success">/jsp/Multithreding.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="EpayVan" class="com.action.Epay_VANAction">
            <result name="success">/jsp/EpayVan.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="adharvault" class="com.action.AdharvaultAction">
            <result name="success">/jsp/AdharVault.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="HundreadPercentageFailureservices"
                class="com.action.HundreadPercentageFailureservicesAction">
            <result name="success">/jsp/hundreadpercentagefailure.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="eisappissue" class="com.action.EISAPPIssueAction" method="execute">
            <result name="success">/jsp/EISAPPIssue.jsp</result>
        </action>

        <action name="eisusersop" class="com.action.UserSOPMasterAction">
            <result name="success">/jsp/UserSopMaster.jsp</result>
            <result name="successBank">/jsp/BankSopMaster.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="showTop20Failureservices"
                class="com.action.ShowTop20failureServicesAction">
            <result name="success">/jsp/showTop20failureservice.jsp</result>
        </action>

        <action name="showFailureServicesWise"
                class="com.action.ShowfailureServicesWiseAction">
            <result name="success">/jsp/ShowfailureServiceWise.jsp</result>
        </action>

        <action name="showservices" class="com.action.ShowfailureServicesAction">
            <result name="success">/jsp/showfailureservice.jsp</result>
        </action>

        <action name="monitoringwithdatetime"
                class="com.action.EXPMonitorPortalWithDateTimeAction">
            <result name="success">/jsp/EXPMonitoringPortalwithDatetime.jsp</result>
        </action>

        <action name="dpginconsistancy" class="com.action.DpgInconsistancyAction">
            <result name="success">/jsp/DpgInconsistancy.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="yono" class="com.action.YonoDasboardAction">
            <result name="success">/jsp/YonoDashboard.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="apiwisenohitsonserver"
                class="com.action.ApiwisenohitsonserverAction">
            <result name="success">/jsp/Apiwisenohitsserver.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="apiwisehundreadpercfailonserver"
                class="com.action.ApiwisehundreadpercfailonserverAction">
            <result name="success">/jsp/Apiwisehundreadpercfailonserver.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="showErrorCodeWiseFailureservices"
                class="com.action.ShowErrorCodeWiseFailureServicesAction">
            <result name="success">/jsp/showErrorCodewisefailureservice.jsp</result>
        </action>

        <action name="showNonGen5ErrorCodeWiseFailureservices"
                class="com.action.ShowNonGen5ErrorCodeWiseFailureServicesAction">
            <result name="success">/jsp/showNonGen5ErrorCodeWiseFailureservices.jsp</result>
        </action>

        <action name="monitoringstatus" class="com.action.MonitoringStatusAction">
            <result name="success">/jsp/MonitoringStatus.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="autoRefreshApiwisehundreadpercfailonserver"
                class="com.action.AutoRefreshApiwisehundreadpercfailonserverAction">
            <result name="success">/jsp/AutoRefreshApiwisehundreadpercfailonserver.jsp</result>
        </action>

        <action name="autoRefreshApiwisehundreadpercfailonNonGen5server"
                class="com.action.AutoRefreshApiwisehundreadpercfailonNonGen5serverAction">
            <result name="success">/jsp/AutoRefreshApiwisehundreadpercfailonNonGen5server.jsp</result>
        </action>

        <action name="autoRefreshApiwisenohitsserver"
                class="com.action.AutoRefreshApiwisenohitsserverAction">
            <result name="success">/jsp/AutoRefreshApiwisenohitsserver.jsp</result>
        </action>

        <action name="multipleservicewisetdbdperc"
                class="com.action.MultipleServiceWiseTDBDPercAction">
            <result name="success">/jsp/MultipleServiceWiseTDBDPer.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="deploymentsheet" class="com.action.DeploymentsheetAction">
            <result name="success">/jsp/Deploymentsheet.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="viewdeploymentsheet" class="com.action.ViewDeploymentsheetAction">
            <result name="success">/jsp/ViewDeploymentsheet.jsp</result>
            <result name="successbanker">/jsp/ViewDeploymentsheetBanker.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <!-- ========================================================
             EIS REGISTRATION (main fix)
             ======================================================== -->

        <!-- Show registration page (fixes NoSuchMethodException) -->
        <action name="showregpage"
                class="com.action.EISRegistrationAction"
                method="showregpage">
            <result name="success">/jsp/EISRegistration.jsp</result>
            <result name="input">/jsp/EISRegistration.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <!-- Save registration (form submit) -->
        <action name="saveRegistration"
                class="com.action.EISRegistrationAction"
                method="saveRegistration">
            <result name="success">/jsp/EISRegistration.jsp</result>
            <result name="thanks">/Thanks.html</result>
            <result name="input">/jsp/EISRegistration.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <!-- Legacy name kept for backward compatibility -->
        <action name="EisRegistration" class="com.action.EISRegistrationAction">
            <result name="success">/jsp/EISRegistration.jsp</result>
            <result name="thanks">/Thanks.html</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

        <action name="ViewEisRegistrationDetails"
                class="com.action.ViewEISRegistrationDetailsAction">
            <result name="success">/jsp/ViewEISRegistrationDetails.jsp</result>
            <result name="session">/Sessionexpired.html</result>
        </action>

    </package>
</struts>




  </section>
</div>

<!-- Refresh Overlay -->
<div class="refresh-overlay" id="refreshOverlay">
  <div class="spinner"></div>
  <p>Fetching Latest Data&hellip;</p>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var currentTime = new Date();
  var tenMinutesAgo = new Date();
  tenMinutesAgo.setMinutes(currentTime.getMinutes() - 10);

  var formatTime = function(date) {
    var hours = date.getHours();
    var minutes = date.getMinutes();
    hours = hours < 10 ? '0' + hours : hours;
    minutes = minutes < 10 ? '0' + minutes : minutes;
    return hours + ':' + minutes;
  };
  document.getElementById('timeRangeMessage').innerHTML =
    'Session <b>' + formatTime(tenMinutesAgo) + '</b> &rarr; <b>' + formatTime(currentTime) + '</b>';
});

function myFunction_Time() {
  var x = document.lastModified;
  var demo = document.getElementById("demo");
  if (demo) demo.innerHTML = x;
}
</script>

<%
/* ============================================================
   BACKEND: Fetch data from Oracle DB
   ============================================================ */
response.setIntHeader("Refresh", 600);

Connection conn = null;
Statement statement = null;
ResultSet resultSet = null;

List<String> labels    = new ArrayList<String>();
List<String> rawNames  = new ArrayList<String>();
List<Double> failure   = new ArrayList<Double>();
List<Integer> tdCounts = new ArrayList<Integer>();
List<Integer> totalHits = new ArrayList<Integer>();

try {
    conn = DBUtilityAuto.getIIBDBConnection();

    ZonedDateTime CurrentDate = ZonedDateTime.now(ZoneId.of("Asia/Kolkata"));
    DateTimeFormatter formatter = DateTimeFormatter.ofPattern("MMM_yy").withLocale(Locale.US);
    String PART = CurrentDate.format(formatter).toUpperCase();

    String sql = "Select * from("
        + "select txn_endpoint, "
        + "COUNT(1) AS TOTAL_HITS, "
        + "SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END) AS TD_COUNT, "
        + "ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT "
        + "from eisapp.backend_log PARTITION(" + PART + ") "
        + "where txn_endpoint != 'NATIONAL_PORTAL' "
        + "and REQUEST_DATE_TIME>=SYSDATE - INTERVAL '10' MINUTE "
        + "GROUP BY txn_endpoint "
        + "having ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END)*100)/COUNT(1),2)>= 0.5 "
        + "order by TD_PERCENT desc"
        + ") where ROWNUM <=12";

    statement = conn.createStatement();
    resultSet = statement.executeQuery(sql);

    while (resultSet.next()) {
        String rawName  = resultSet.getString("txn_endpoint");
        int    tdCount  = resultSet.getInt("TD_COUNT");
        int    totalHit = resultSet.getInt("TOTAL_HITS");
        double pct      = resultSet.getDouble("TD_PERCENT");

        String label = "<span style='color:#ff9933;font-weight:900;font-size:22px;'>" + tdCount + "</span>"
            + "<br><span style='color:#ffffff;font-weight:700;font-size:16px;letter-spacing:1px;'>"
            + rawName.replaceAll("_", "_<br>") + "</span>"
            + "<br><span style='color:#32CD32;font-weight:900;font-size:18px;'>" + totalHit + "</span>";

        labels.add(label);
        rawNames.add(rawName);
        failure.add(pct);
        tdCounts.add(tdCount);
        totalHits.add(totalHit);
    }
} catch (Exception e) {
    e.printStackTrace();
} finally {
    try { if (resultSet != null) resultSet.close(); } catch (Exception ignored) {}
    try { if (statement != null) statement.close(); } catch (Exception ignored) {}
    try { if (conn != null) conn.close(); } catch (Exception ignored) {}
}

/* Pad to minimum 5 bars for a nicer chart when data is sparse */
while (labels.size() < 5) {
    labels.add("&nbsp;");
    rawNames.add("");
    failure.add(0.0);
    tdCounts.add(0);
    totalHits.add(0);
}
%>

<script>
// ============================================================
// Build JS arrays from server-side data
// ============================================================
var labelArr = [
<%
for (int k = 0; k < labels.size(); k++) {
    String lbl = labels.get(k).replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "").replace("\r", "");
    out.print("\"" + lbl + "\"");
    if (k < labels.size() - 1) out.print(",");
}
%>
];

var nameArr = [
<%
for (int k = 0; k < rawNames.size(); k++) {
    String n = rawNames.get(k).replace("\\", "\\\\").replace("\"", "\\\"");
    out.print("\"" + n + "\"");
    if (k < rawNames.size() - 1) out.print(",");
}
%>
];

var valueArr = [
<%
for (int k = 0; k < failure.size(); k++) {
    out.print(failure.get(k));
    if (k < failure.size() - 1) out.print(",");
}
%>
];

var tdArr = [
<%
for (int k = 0; k < tdCounts.size(); k++) {
    out.print(tdCounts.get(k));
    if (k < tdCounts.size() - 1) out.print(",");
}
%>
];

var totalArr = [
<%
for (int k = 0; k < totalHits.size(); k++) {
    out.print(totalHits.get(k));
    if (k < totalHits.size() - 1) out.print(",");
}
%>
];

// ============================================================
// Side panel: Top Critical list
// ============================================================
(function buildCritList() {
  var items = [];
  for (var k = 0; k < nameArr.length; k++) {
    if (nameArr[k] && valueArr[k] > 0) {
      items.push({ name: nameArr[k], pct: valueArr[k], td: tdArr[k] });
    }
  }
  items.sort(function(a, b) { return b.pct - a.pct; });
  var top = items.slice(0, 5);
  var ul = document.getElementById('critList');
  if (!top.length) {
    ul.innerHTML = '<li class="empty-note">All clear &check; No failures</li>';
    return;
  }
  ul.innerHTML = top.map(function(it) {
    var shown = it.name.length > 18 ? it.name.substring(0, 18) + '…' : it.name;
    return '<li class="crit-item"><span class="name" title="' + it.name + '">' + shown
         + '</span><span class="val">' + it.pct + '%</span></li>';
  }).join('');
})();

// ============================================================
// Per-bar severity colors
// ============================================================
var barColors = valueArr.map(function(v) {
  if (v >= 5) return "#ff2d55";
  if (v >= 2) return "#ff8c00";
  if (v >= 1) return "#ffd60a";
  return "#00ffb3";
});

// ============================================================
// ZingChart config
// ============================================================
var chartConfig = {
  type: "bar3d",
  "3dAspect": { depth: 28, true3d: 0, yAngle: 10 },
  backgroundColor: "transparent",
  plotarea: {
    backgroundColor: "transparent",
    margin: "90px 30px 190px 90px"
  },
  globals: {
    fontFamily: "Rajdhani, sans-serif"
  },
  scaleX: {
    values: labelArr,
    lineColor: "rgba(255,255,255,0.15)",
    tick: { visible: false },
    item: { fontColor: "#fff", fontSize: 15, offsetY: 6 },
    guide: { visible: false }
  },
  scaleY: {
    lineColor: "rgba(255,255,255,0.1)",
    guide: {
      visible: true,
      lineColor: "rgba(255,255,255,0.08)",
      lineStyle: "dashed"
    },
    tick: { visible: false },
    item: { fontColor: "#a0a4be", fontSize: 13, paddingRight: 8 },
    label: {
      text: "Failure %",
      fontColor: "#8b8fa8",
      fontSize: 13,
      offsetX: -10
    }
  },
  plot: {
    animation: { effect: "ANIMATION_SLIDE_BOTTOM", speed: 800, delay: 60, sequence: "ANIMATION_BY_NODE" },
    tooltip: {
      text: "<b>%kl</b><br>Failure: %v%",
      backgroundColor: "rgba(20,22,42,0.95)",
      borderColor: "rgba(160,89,255,0.6)",
      borderRadius: "8px",
      fontColor: "#fff",
      fontSize: 13,
      padding: "8px 14px",
      shadow: false
    },
    barWidth: "45%",
    borderWidth: 0,
    styles: barColors
  },
  series: [{
    values: valueArr,
    lineColor: "#a259ff",
    lineWidth: 1,
    backgroundColor: "#673AB7",
    "value-box": {
      visible: true,
      text: "%v%",
      placement: "top",
      fontColor: "#ffffff",
      fontSize: 14,
      fontWeight: "bold",
      offsetY: -6,
      rules: [
        { rule: "%v >= 5", fontColor: "#ff6b8b" },
        { rule: "%v >= 2", fontColor: "#ffb454" },
        { rule: "%v >= 1", fontColor: "#ffe066" }
      ]
    }
  }]
};

// ============================================================
// Click handler → drill-down
// ============================================================
function updateChart(p) {
  var idx = p.nodeindex;
  if (!nameArr[idx]) return;
  var url = '<%=request.getContextPath() + "/jsp/TransactionEndpointWiseService.jsp?txnEndPoint="%>' + encodeURIComponent(nameArr[idx]);
  window.open(url, '_blank');
}

// ============================================================
// Render
// ============================================================
zingchart.render({
  id: 'myChart',
  data: chartConfig,
  height: '100%',
  width: '100%'
});

zingchart.bind('myChart', 'node_click', updateChart);
</script>

<!-- ============ COUNTDOWN RING ============ -->
<script>
(function countdownRing() {
  var totalSeconds = 10 * 60;   // 10 minutes
  var remaining = totalSeconds;
  var CIRC = 2 * Math.PI * 20;  // r = 20

  var ring    = document.getElementById('ringProgress');
  var num     = document.getElementById('ringNum');
  var overlay = document.getElementById('refreshOverlay');

  ring.style.strokeDasharray  = CIRC;
  ring.style.strokeDashoffset = 0;

  function tick() {
    remaining--;
    if (remaining <= 0) {
      overlay.classList.add('active');
      return;
    }
    var progress = remaining / totalSeconds;
    ring.style.strokeDashoffset = CIRC * (1 - progress);

    var m = Math.floor(remaining / 60);
    var s = remaining % 60;
    num.textContent = (m > 0) ? (m + ':' + (s < 10 ? '0' + s : s)) : s;
  }
  setInterval(tick, 1000);
})();
</script>


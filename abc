                </div>

                <div class="doc-row <%=emp.getM_strBGC_Documents_Path() != null && !emp.getM_strBGC_Documents_Path().isEmpty() ? "ok" : ""%>">
                    <span class="code">01</span>
                    <span class="label">BGC</span>
                    <span class="indicator"></span>
                    <% if (emp.getM_strBGC_Documents_Path() != null && !emp.getM_strBGC_Documents_Path().isEmpty()) { %>
                        <button type="button" class="view-btn" onclick="openDocument('<%=emp.getM_strEmployee_ID()%>','BGC');">VIEW</button>
                    <% } %>
                </div>

                <div class="doc-row <%=emp.getM_strPolice_Verification_Path() != null && !emp.getM_strPolice_Verification_Path().isEmpty() ? "ok" : ""%>">
                    <span class="code">02</span>
                    <span class="label">POLICE</span>
                    <span class="indicator"></span>
                    <% if (emp.getM_strPolice_Verification_Path() != null && !emp.getM_strPolice_Verification_Path().isEmpty()) { %>
                        <button type="button" class="view-btn" onclick="openDocument('<%=emp.getM_strEmployee_ID()%>','POLICE');">VIEW</button>
                    <% } %>
                </div>

                <div class="doc-row <%=emp.getM_strCV_Document() != null && !emp.getM_strCV_Document().isEmpty() ? "ok" : ""%>">
                    <span class="code">03</span>
                    <span class="label">CV</span>
                    <span class="indicator"></span>
                    <% if (emp.getM_strCV_Document() != null && !emp.getM_strCV_Document().isEmpty()) { %>
                        <button type="button" class="view-btn" onclick="openDocument('<%=emp.getM_strEmployee_ID()%>','CV');">VIEW</button>
                    <% } %>
                </div>
            </div>

        </aside>

        <!-- ============================================================
             FORM PANEL
             ============================================================ -->
        <main class="form-panel">

            <div class="form-panel-header">
                <div class="path">
                    <span>EIS</span>
                    <span class="slash">/</span>
                    <span>employees</span>
                    <span class="slash">/</span>
                    <span class="current">edit</span>
                </div>
                <div>MODE: UPDATE</div>
            </div>

            <!-- SECTION 01 — IDENTITY -->
            <section class="section" id="s1">
                <div class="section-head">
                    <span class="section-num">01</span>
                    <span class="section-title">Identity</span>
                    <span class="section-line"></span>
                </div>
                <div class="fields">
                    <div class="field">
                        <label class="field-label">Employee ID <span class="req">*</span></label>
                        <input class="field-input" type="text" name="m_stremployee_id"
                               value="<%=emp.getM_strEmployee_ID()%>" readonly/>
                    </div>
                    <div class="field">
                        <label class="field-label">AD ID</label>
                        <input class="field-input" type="text" name="m_strad_id"
                               value="<%=emp.getM_strAD_ID() != null ? emp.getM_strAD_ID() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">HID</label>
                        <input class="field-input" type="text" name="m_strhid"
                               value="<%=emp.getM_strHID() != null ? emp.getM_strHID() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">Asset ID</label>
                        <input class="field-input" type="text" name="m_strasset_id"
                               value="<%=emp.getM_strAsset_ID() != null ? emp.getM_strAsset_ID() : ""%>"/>
                    </div>
                </div>
            </section>

            <!-- SECTION 02 — PERSONAL -->
            <section class="section" id="s2">
                <div class="section-head">
                    <span class="section-num">02</span>
                    <span class="section-title">Personal Information</span>
                    <span class="section-line"></span>
                </div>
                <div class="fields">
                    <div class="field">
                        <label class="field-label">First Name <span class="req">*</span></label>
                        <input class="field-input" type="text" name="m_strfirstName"
                               value="<%=emp.getM_strFirst_Name() != null ? emp.getM_strFirst_Name() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">Middle Name</label>
                        <input class="field-input" type="text" name="m_strmiddleName"
                               value="<%=emp.getM_strMiddle_Name() != null ? emp.getM_strMiddle_Name() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">Last Name <span class="req">*</span></label>
                        <input class="field-input" type="text" name="m_strlastName"
                               value="<%=emp.getM_strLast_Name() != null ? emp.getM_strLast_Name() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">Gender</label>

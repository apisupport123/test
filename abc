/* ============ MODULE LEAD DASHBOARD CONTENT ============ */
.ml-dash{
  padding:28px 32px 60px;
  max-width:1500px;
  margin:0 auto;
}

.ml-hero{
  background:
    radial-gradient(circle at top right, rgba(236,72,153,.3), transparent 60%),
    radial-gradient(circle at bottom left, rgba(124,58,237,.4), transparent 60%),
    linear-gradient(135deg, #1A0B2E 0%, #2D1854 100%);
  border-radius:20px;
  padding:36px 40px;
  color:#fff;
  position:relative;overflow:hidden;
  margin-bottom:24px;
  border:1px solid rgba(124,58,237,.3);
}
.ml-hero::before{
  content:"";position:absolute;top:-100px;right:-100px;
  width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle, rgba(124,58,237,.4) 0%, transparent 70%);
}
.ml-hero-inner{
  position:relative;z-index:2;
  display:flex;justify-content:space-between;align-items:center;
  gap:24px;flex-wrap:wrap;
}
.ml-hero-text .badge-line{
  display:inline-flex;align-items:center;gap:8px;
  padding:6px 14px;
  background:rgba(236,72,153,.2);
  border:1px solid rgba(236,72,153,.4);
  border-radius:999px;
  font-size:.7rem;font-weight:800;
  color:var(--ml-accent-2);letter-spacing:1px;
  text-transform:uppercase;margin-bottom:16px;
}
.ml-hero-text .badge-line .dot{
  width:6px;height:6px;border-radius:50%;
  background:var(--ml-accent-2);
  box-shadow:0 0 8px var(--ml-accent-2);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.ml-hero-text h1{
  font-size:2.2rem;font-weight:900;
  letter-spacing:-1px;line-height:1.15;margin-bottom:12px;
}
.ml-hero-text h1 .gradient{
  background:linear-gradient(135deg,var(--ml-primary-2),var(--ml-accent-2));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.ml-hero-text p{
  font-size:.92rem;color:rgba(255,255,255,.75);
  font-weight:600;max-width:520px;line-height:1.6;
}

.ml-hero-visual{display:flex;gap:14px;flex-wrap:wrap;}
.hero-stat{
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.15);

<script>
const CTX = '<%=request.getContextPath()%>';

/* ✅ Default DARK theme */
(function(){
  try{
    var t = localStorage.getItem('eis-theme');
    if(!t){
      t = 'dark';
      localStorage.setItem('eis-theme', 'dark');
    }
    document.documentElement.setAttribute('data-theme', t);
  }catch(e){}
})();

/* ✅ Dropdown toggle */
function toggleDrop(id){
  var el = document.getElementById(id);
  // Close others
  document.querySelectorAll('.quick-card.dropdown').forEach(function(other){
    if(other.id !== id) other.classList.remove('open');
  });
  el.classList.toggle('open');
}
// Outside click pe band karo
document.addEventListener('click', function(e){
  if(!e.target.closest('.quick-card.dropdown')){
    document.querySelectorAll('.quick-card.dropdown').forEach(function(el){
      el.classList.remove('open');
    });
  }
});

/* ---------- Tab Switching ---------- */
document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.form-view').forEach(v => v.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('view-' + tab.dataset.tab).classList.add('active');

    const title = document.getElementById('formTitle');
    const sub = document.getElementById('formSubtitle');
    if (tab.dataset.tab === 'user') {
      title.textContent = 'Welcome back';
      sub.textContent = 'Sign in to continue to your workspace';
    } else {
      title.textContent = 'Admin access';
      sub.textContent = 'Restricted access — authorized personnel only';
    }
  });
});

/* ---------- Helpers ---------- */
function showAlert(id, msg, type) {
  const el = document.getElementById(id);
  el.className = 'alert ' + (type || 'error');
  el.querySelector('span').textContent = msg;
  el.style.display = 'flex';
}
function hideAlert(id) {
  const el = document.getElementById(id);
  el.className = 'alert';
  el.style.display = 'none';
}
function setLoading(btnId, isLoading) {
  const btn = document.getElementById(btnId);
  btn.disabled = isLoading;
  btn.classList.toggle('loading', isLoading);
}
function togglePw(id, btn){
  const inp = document.getElementById(id);
  if(inp.type === 'password'){
    inp.type = 'text';
    btn.innerHTML = '<svg class="icon-svg" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
  } else {
    inp.type = 'password';
    btn.innerHTML = '<svg class="icon-svg" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
  }
}

/* ---------- AJAX Login ---------- */
async function submitLogin(url, formEl, btnId, alertId) {
  hideAlert(alertId);
  setLoading(btnId, true);
  try {
    const fd = new FormData(formEl);
    const res = await fetch(url, {
      method: 'POST',
      body: fd,
      credentials: 'same-origin',
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });
    const ct = res.headers.get('content-type') || '';
    if (ct.includes('application/json')) {
      const data = await res.json();
      if (data.status === 'success') {
        showAlert(alertId, 'Login successful, redirecting...', 'success');
        try{
          sessionStorage.setItem('eis-fresh-login', '1');   // ✅ Fresh login flag
        }catch(e){}
        setTimeout(() => {
          window.location.href = data.redirectUrl || (CTX + '/userhomescreen.action');
        }, 400);
      } else {
        showAlert(alertId, data.message || 'Invalid credentials', 'error');
      }
    } else {
      formEl.action = url;
      formEl.submit();
    }
  } catch (err) {
    console.error(err);
    showAlert(alertId, 'Network error. Please try again.', 'error');
  } finally {
    setLoading(btnId, false);
  }
}

/* ---------- User Login ---------- */
function usersign() {
  const form = document.getElementById('loginForm');
  const u = document.getElementById('m_strUserName').value.trim();
  const p = document.getElementById('m_struserPassword').value;
  const r = document.getElementById('m_strRole').value;
  if (!u) { showAlert('userAlert', 'Please enter username'); return; }
  if (!p) { showAlert('userAlert', 'Please enter password'); return; }
  if (!r || r === 'Select your role') { showAlert('userAlert', 'Please select a role'); return; }
  localStorage.removeItem('eis-sidebar-closed');
  submitLogin(CTX + '/login!usersign.action', form, 'btnUserLogin', 'userAlert');
}

/* ---------- Admin Login ---------- */
function adminsign() {
  const form = document.getElementById('loginForm');
  const u = document.getElementById('m_stradminUserName').value.trim();
  const p = document.getElementById('m_stradminPassword').value;
  if (!u) { showAlert('adminAlert', 'Please enter admin username'); return; }
  if (!p) { showAlert('adminAlert', 'Please enter admin password'); return; }
  localStorage.removeItem('eis-sidebar-closed');
  submitLogin(CTX + '/login!adminsign.action', form, 'btnAdminLogin', 'adminAlert');
}

/* ---------- Enter key submit ---------- */
document.getElementById('loginForm').addEventListener('keydown', e => {
  if (e.key === 'Enter') {
    e.preventDefault();
    const active = document.querySelector('.tab.active').dataset.tab;
    active === 'user' ? usersign() : adminsign();
  }
});
</script>


<script>
document.addEventListener('DOMContentLoaded', function() {
  var now = new Date();
  var past = new Date();
  past.setMinutes(now.getMinutes() - 10);
  function fmt(d) {
    var h = d.getHours(), m = d.getMinutes();
    return (h < 10 ? '0' + h : h) + ':' + (m < 10 ? '0' + m : m);
  }
  document.getElementById('timeRangeMessage').innerHTML =
    'session <b>' + fmt(past) + '</b> → <b>' + fmt(now) + '</b>';
});
function myFunction_Time() {
  var demo = document.getElementById("demo");
  if (demo) demo.innerHTML = document.lastModified;
}
</script>

<%
/* ============ BACKEND ============ */
response.setIntHeader("Refresh", 600);

Connection conn = null;
Statement statement = null;
ResultSet resultSet = null;

List<String> labels = new ArrayList<String>();
List<String> rawNames = new ArrayList<String>();
List<Double> failure = new ArrayList<Double>();
List<Integer> tdCounts = new ArrayList<Integer>();
List<Integer> totalHits = new ArrayList<Integer>();

try {
    conn = DBUtilityAuto.getIIBDBConnection();

    ZonedDateTime CurrentDate = ZonedDateTime.now(ZoneId.of("Asia/Kolkata"));
    DateTimeFormatter formatter = DateTimeFormatter.ofPattern("MMM_yy").withLocale(Locale.US);
    String PART = CurrentDate.format(formatter).toUpperCase();

    String sql = "Select * from("
        + "select txn_endpoint, "
        + "COUNT(1) AS TOTAL_HITS, "
        + "SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END) AS TD_COUNT, "
        + "ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT "
        + "from eisapp.backend_log PARTITION(" + PART + ") "
        + "where txn_endpoint != 'NATIONAL_PORTAL' "
        + "and REQUEST_DATE_TIME>=SYSDATE - INTERVAL '10' MINUTE "
        + "GROUP BY txn_endpoint "
        + "having ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END)*100)/COUNT(1),2)>= 0.5 "
        + "order by TD_PERCENT desc"
        + ") where ROWNUM <=12";

    statement = conn.createStatement();
    resultSet = statement.executeQuery(sql);

    while (resultSet.next()) {
        String rawName = resultSet.getString("txn_endpoint");
        int tdCount = resultSet.getInt("TD_COUNT");
        int totalHit = resultSet.getInt("TOTAL_HITS");
        double pct = resultSet.getDouble("TD_PERCENT");

        String label = "<span style='color:#f59e0b;font-weight:600;font-size:12px;font-family:JetBrains Mono,monospace;'>" + tdCount + "</span>"
            + "<br><span style='color:#ededf4;font-weight:500;font-size:11px;'>"
            + rawName.replaceAll("_", "_<br>") + "</span>"
            + "<br><span style='color:#10b981;font-weight:600;font-size:11px;font-family:JetBrains Mono,monospace;'>" + totalHit + "</span>";

        labels.add(label);
        rawNames.add(rawName);
        failure.add(pct);
        tdCounts.add(tdCount);
        totalHits.add(totalHit);
    }
} catch (Exception e) {
    e.printStackTrace();
} finally {
    try { if (resultSet != null) resultSet.close(); } catch (Exception ignored) {}
    try { if (statement != null) statement.close(); } catch (Exception ignored) {}
    try { if (conn != null) conn.close(); } catch (Exception ignored) {}
}

while (labels.size() < 5) {
    labels.add("&nbsp;");
    rawNames.add("");
    failure.add(0.0);
    tdCounts.add(0);
    totalHits.add(0);
}
%>

<script>
var labelArr = [
<%
for (int k = 0; k < labels.size(); k++) {
    String lbl = labels.get(k).replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "").replace("\r", "");
    out.print("\"" + lbl + "\"");
    if (k < labels.size() - 1) out.print(",");
}
%>
];

var nameArr = [
<%
for (int k = 0; k < rawNames.size(); k++) {
    String n = rawNames.get(k).replace("\\", "\\\\").replace("\"", "\\\"");
    out.print("\"" + n + "\"");
    if (k < rawNames.size() - 1) out.print(",");
}
%>
];

var valueArr = [
<%
for (int k = 0; k < failure.size(); k++) {
    out.print(failure.get(k));
    if (k < failure.size() - 1) out.print(",");
}
%>
];

var tdArr = [
<%
for (int k = 0; k < tdCounts.size(); k++) {
    out.print(tdCounts.get(k));
    if (k < tdCounts.size() - 1) out.print(",");
}
%>
];

var totalArr = [
<%
for (int k = 0; k < totalHits.size(); k++) {
    out.print(totalHits.get(k));
    if (k < totalHits.size() - 1) out.print(",");
}
%>
];

/* ============ STATS ============ */
(function computeStats() {
  var totalEndpoints = 0, critical = 0, warning = 0, maxVal = 0;
  for (var i = 0; i < nameArr.length; i++) {
    if (!nameArr[i]) continue;
    totalEndpoints++;
    if (valueArr[i] >= 5) critical++;
    else if (valueArr[i] >= 1) warning++;
    if (valueArr[i] > maxVal) maxVal = valueArr[i];
  }
  document.getElementById('statTotal').textContent = totalEndpoints;
  document.getElementById('statCritical').textContent = critical;
  document.getElementById('statWarning').textContent = warning;
  var maxEl = document.getElementById('statMax');
  maxEl.textContent = maxVal.toFixed(2) + '%';
  maxEl.className = 'kpi-value ' + (maxVal >= 5 ? 'crit' : (maxVal >= 2 ? 'warn' : 'ok'));
})();

/* ============ CRITICAL LIST ============ */
(function buildCritList() {
  var items = [];
  for (var k = 0; k < nameArr.length; k++) {
    if (nameArr[k] && valueArr[k] > 0) {
      items.push({ name: nameArr[k], pct: valueArr[k] });
    }
  }
  items.sort(function(a, b) { return b.pct - a.pct; });
  var top = items.slice(0, 5);
  var box = document.getElementById('critList');
  if (!top.length) {
    box.innerHTML = '<div class="empty-msg">all_clear ✓</div>';
    return;
  }
  box.innerHTML = top.map(function(it) {
    return '<div class="crit-row">'
      + '<span class="crit-name" title="' + it.name + '">' + it.name + '</span>'
      + '<span class="crit-pct">' + it.pct + '%</span>'
      + '</div>';
  }).join('');
})();

/* ============ BAR COLORS ============ */
var barColors = valueArr.map(function(v) {
  if (v >= 5) return "#ef4444";
  if (v >= 2) return "#f59e0b";
  if (v >= 1) return "#8b5cf6";
  return "#10b981";
});

/* ============ CHART ============ */
var chartConfig = {
  type: "bar3d",
  "3dAspect": { depth: 18, true3d: 0, yAngle: 6 },
  backgroundColor: "transparent",
  plotarea: {
    backgroundColor: "transparent",
    margin: "60px 36px 150px 72px"
  },
  globals: {
    fontFamily: "Space Grotesk, sans-serif"
  },
  scaleX: {
    values: labelArr,
    lineColor: "#26263a",
    tick: { visible: false },
    item: { fontColor: "#ededf4", fontSize: 11 },
    guide: { visible: false }
  },
  scaleY: {
    lineColor: "#26263a",
    guide: {
      visible: true,
      lineColor: "#1e1e2e",
      lineStyle: "solid"
    },
    tick: { lineColor: "#26263a", visible: true },
    item: { fontColor: "#7a7a95", fontSize: 10, paddingRight: 6 },
    label: {
      text: "failure %",
      fontColor: "#7a7a95",
      fontSize: 10,
      fontFamily: "JetBrains Mono, monospace",
      offsetX: -8
    }
  },
  plot: {
    animation: { effect: "ANIMATION_SLIDE_BOTTOM", speed: 500, delay: 30, sequence: "ANIMATION_BY_NODE" },
    tooltip: {
      text: "<b>%kl</b><br>failure: %v%",
      backgroundColor: "#1a1a24",
      borderColor: "#26263a",
      borderWidth: 1,
      borderRadius: "6px",
      fontColor: "#ededf4",
      fontSize: 11,
      padding: "8px 12px",
      shadow: false
    },
    barWidth: "38%",
    borderWidth: 0,
    styles: barColors
  },
  series: [{
    values: valueArr,
    lineColor: "#6366f1",
    lineWidth: 1,
    "value-box": {
      visible: true,
      text: "%v%",
      placement: "top",
      fontColor: "#ededf4",
      fontSize: 10,
      fontFamily: "JetBrains Mono, monospace",
      fontWeight: "600",
      offsetY: -4
    }
  }]
};

function updateChart(p) {
  var idx = p.nodeindex;
  if (!nameArr[idx]) return;
  var url = '<%=request.getContextPath() + "/jsp/TransactionEndpointWiseService.jsp?txnEndPoint="%>' + encodeURIComponent(nameArr[idx]);
  window.open(url, '_blank');
}

zingchart.render({
  id: 'myChart',
  data: chartConfig,
  height: '100%',
  width: '100%'
});

zingchart.bind('myChart', 'node_click', updateChart);
</script>

<script>
(function countdown() {
  var total = 10 * 60;
  var left = total;
  var num = document.getElementById('countdownNum');
  var bar = document.getElementById('topProgress');

  function tick() {
    left--;
    if (left <= 0) {
      bar.classList.add('active');
      return;
    }
    var m = Math.floor(left / 60);
    var s = left % 60;
    num.textContent = m + ':' + (s < 10 ? '0' + s : s);
    if (left <= 60) num.classList.add('low');
  }
  setInterval(tick, 1000);
})();
</script>


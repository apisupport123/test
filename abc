<script>
function search_animal() {
  let input = document.getElementById('searchbar').value.toLowerCase();
  let x = document.getElementsByClassName('animals');
  let groups = document.querySelectorAll('.sb-group');
  for (let i = 0; i < x.length; i++) {
    if (!x[i].innerText.toLowerCase().includes(input)) {
      x[i].style.display = "none";
    } else {
      x[i].style.display = "flex";
    }
  }
  // hide empty groups
  groups.forEach(g => {
    let next = g.nextElementSibling;
    let hasVisible = false;
    while(next && !next.classList.contains('sb-group')){
      if(next.classList.contains('animals') && next.style.display !== 'none'){ hasVisible = true; break; }
      next = next.nextElementSibling;
    }
    g.style.display = hasVisible || input === '' ? 'block' : 'none';
  });
}
function focusSidebarSearch(){
  if(window.innerWidth <= 900){
    document.documentElement.classList.add('sb-open');
  }
  setTimeout(()=>document.getElementById('searchbar').focus(), 150);
}
document.addEventListener('keydown', e => {
  if((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k'){
    e.preventDefault();
    focusSidebarSearch();
  }
});
</script>

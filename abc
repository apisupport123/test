<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%
 // ✅ Session check
 if(session == null || session.getAttribute("role") == null) {
     response.sendRedirect(request.getContextPath() + "/login.action");
     return;
 }

 // ✅ Strict cache headers
 response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate, max-age=0, private");
 response.setHeader("Pragma", "no-cache");
 response.setDateHeader("Expires", 0);
%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<title>EIS Portal — Home</title>
<script src="<%=request.getContextPath()%>/js/jquery.min.js"></script>
<style>
:root{
  --brand:#F86F03;
  --brand-2:#FF9A3D;
  --brand-light:#FFF4EC;
  --brand-glow:rgba(248,111,3,.4);
  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F7F7F5;
  --card:#FFFFFF;
  --hero-dark:#1A1A1A;
  --hero-dark-2:#2A2A2A;
  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --sidebar-w:260px;
  --topnav-h:64px;
  --green:#10B981;
  --blue:#3B82F6;
  --purple:#8B5CF6;
  --pink:#EC4899;
  --amber:#F59E0B;
  --cyan:#06B6D4;
}
html[data-theme="dark"]{
  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#272727;
  --bg:#0F0F0F;
  --card:#161616;
  --hero-dark:#0B0B0B;
  --hero-dark-2:#1A1A1A;
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  font-family:var(--font-stack);
  font-weight:700;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  min-height:100vh;
  transition:background .3s ease,color .3s ease;
}
a{color:inherit;text-decoration:none}
h1,h2,h3,h4,h5,h6,strong,b{font-weight:800;letter-spacing:-.3px}

.icon-svg{
  width:16px;height:16px;
  display:inline-block;flex-shrink:0;
  stroke:currentColor;fill:none;
  stroke-width:2.2;
  stroke-linecap:round;stroke-linejoin:round;
}

/* ============ WRAPPER ============ */
.new-wrapper{
  margin-left:var(--sidebar-w);
  padding-top:var(--topnav-h);
  transition:margin-left .3s cubic-bezier(.4,0,.2,1);
  min-height:100vh;
}
html.sb-collapsed .new-wrapper{margin-left:0}
.dash-wrap{
  max-width:1500px;
  margin:0 auto;
  padding:28px 28px 60px;
}

/* ============ WELCOME BAR ============ */
.welcome-bar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:24px;
  gap:16px;
  flex-wrap:wrap;
}
.welcome-left{
  display:flex;
  align-items:center;
  gap:16px;
}
.welcome-avatar{
  width:56px;height:56px;
  border-radius:16px;
  background:linear-gradient(135deg,var(--brand),var(--brand-2));
  display:grid;place-items:center;
  color:#fff;
  font-size:1.4rem;
  font-weight:900;
  box-shadow:0 10px 30px -8px var(--brand-glow);
  position:relative;
  flex-shrink:0;
}
.welcome-avatar::after{
  content:"";
  position:absolute;
  bottom:-2px;right:-2px;
  width:16px;height:16px;
  background:var(--green);
  border:3px solid var(--card);
  border-radius:50%;
  box-shadow:0 0 8px var(--green);
}
.welcome-text h1{
  font-size:1.6rem;
  font-weight:900;
  letter-spacing:-.6px;
  color:var(--ink);
  margin-bottom:3px;
  line-height:1.2;
}
.welcome-text h1 .grad{
  background:linear-gradient(135deg,var(--brand),var(--brand-2));
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}
.welcome-text p{
  font-size:.82rem;
  color:var(--muted);
  font-weight:600;
}
.welcome-text p b{color:var(--ink);font-weight:800}

.welcome-right{
  display:flex;
  align-items:center;
  gap:12px;
}
.live-clock{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:14px;
  padding:10px 16px;
  display:flex;
  align-items:center;
  gap:10px;
  box-shadow:0 2px 8px rgba(0,0,0,.03);
}
.live-clock .clock-icon{
  width:32px;height:32px;
  border-radius:9px;
  background:linear-gradient(135deg,var(--brand),var(--brand-2));
  color:#fff;
  display:grid;place-items:center;
}
.live-clock .clock-icon .icon-svg{width:16px;height:16px}
.live-clock .clock-text{
  display:flex;flex-direction:column;gap:1px;
}
.live-clock .clock-time{
  font-family:'JetBrains Mono',Consolas,monospace;
  font-size:1rem;
  font-weight:800;
  color:var(--ink);
  letter-spacing:-.3px;
  line-height:1.1;
}
.live-clock .clock-date{
  font-size:.68rem;
  color:var(--muted);
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.4px;
}

/* ============ TOP STATS ============ */
.stats-row{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
  margin-bottom:28px;
}
.stat-card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  padding:18px;
  display:flex;
  align-items:center;
  gap:14px;
  transition:all .25s ease;
  position:relative;
  overflow:hidden;
  cursor:default;
}
.stat-card:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 32px -10px rgba(0,0,0,.15);
  border-color:var(--brand);
}
.stat-card .sicon{
  width:46px;height:46px;
  border-radius:12px;
  display:grid;place-items:center;
  flex-shrink:0;
  position:relative;
}
.stat-card .sicon .icon-svg{width:20px;height:20px;stroke-width:2.4}
.stat-card .stext{flex:1;min-width:0}
.stat-card .snum{
  font-size:1.4rem;
  font-weight:900;
  letter-spacing:-.6px;
  line-height:1;
  color:var(--ink);
  display:flex;
  align-items:baseline;
  gap:4px;
}
.stat-card .snum small{font-size:.75rem;font-weight:700;color:var(--muted)}
.stat-card .slabel{
  font-size:.72rem;
  color:var(--muted);
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.4px;
  margin-top:3px;
}
.stat-card.s-brand .sicon{background:var(--brand-light);color:var(--brand)}
html[data-theme="dark"] .stat-card.s-brand .sicon{background:rgba(248,111,3,.15)}
.stat-card.s-green .sicon{background:rgba(16,185,129,.12);color:var(--green)}
.stat-card.s-blue .sicon{background:rgba(59,130,246,.12);color:var(--blue)}
.stat-card.s-purple .sicon{background:rgba(139,92,246,.12);color:var(--purple)}

/* ============ SEARCH + FILTERS ============ */
.controls-bar{
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:24px;
  flex-wrap:wrap;
}
.search-inline{
  flex:1;
  min-width:220px;
  max-width:420px;
  position:relative;
  display:flex;
  align-items:center;
}
.search-inline .icon-svg{
  position:absolute;
  left:14px;
  color:var(--muted);
  pointer-events:none;
  width:15px;height:15px;
}
.search-inline input{
  width:100%;
  padding:12px 16px 12px 42px;
  background:var(--card);
  border:1.5px solid var(--line);
  border-radius:12px;
  color:var(--ink);
  font-family:inherit;
  font-size:.88rem;
  font-weight:700;
  outline:none;
  transition:all .2s ease;
}
.search-inline input::placeholder{color:var(--muted);opacity:.7;font-weight:600}
.search-inline input:focus{
  border-color:var(--brand);
  box-shadow:0 0 0 4px var(--brand-light);
  background:var(--card);
}
html[data-theme="dark"] .search-inline input:focus{box-shadow:0 0 0 4px rgba(248,111,3,.15)}
.search-inline .kbd{
  position:absolute;
  right:12px;
  padding:3px 8px;
  background:var(--bg);
  border:1px solid var(--line);
  border-radius:6px;
  font-size:.65rem;
  font-weight:800;
  color:var(--muted);
}

.filter-tabs{
  display:flex;
  gap:4px;
  background:var(--card);
  border:1.5px solid var(--line);
  padding:4px;
  border-radius:12px;
  overflow-x:auto;
  flex-shrink:0;
}
.filter-tab{
  padding:8px 14px;
  border:none;
  background:transparent;
  color:var(--muted);
  font-family:inherit;
  font-size:.76rem;
  font-weight:800;
  border-radius:8px;
  cursor:pointer;
  transition:all .2s ease;
  white-space:nowrap;
  text-transform:uppercase;
  letter-spacing:.4px;
}
.filter-tab:hover{color:var(--ink)}
.filter-tab.active{
  background:linear-gradient(135deg,var(--brand),var(--brand-2));
  color:#fff;
  box-shadow:0 4px 12px -3px var(--brand-glow);
}

/* ============ RECENT SECTION ============ */
.recent-section{
  margin-bottom:28px;
}
.sec-title{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:14px;
  gap:12px;
}
.sec-title h3{
  font-size:.85rem;
  font-weight:900;
  color:var(--ink);
  text-transform:uppercase;
  letter-spacing:1px;
  display:flex;
  align-items:center;
  gap:10px;
}
.sec-title h3 .icon-svg{width:16px;height:16px;color:var(--brand)}
.sec-title h3 .count{
  background:var(--brand-light);
  color:var(--brand);
  padding:2px 8px;
  border-radius:999px;
  font-size:.65rem;
  font-weight:800;
}
html[data-theme="dark"] .sec-title h3 .count{background:rgba(248,111,3,.15)}
.sec-title .line{
  flex:1;
  height:1px;
  background:linear-gradient(90deg,var(--line),transparent);
}

.recent-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  gap:12px;
}
.recent-card{
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px 16px;
  background:var(--card);
  border:1.5px solid var(--line);
  border-radius:14px;
  transition:all .25s ease;
  position:relative;
  overflow:hidden;
  cursor:pointer;
}
.recent-card:hover{
  border-color:var(--brand);
  transform:translateY(-2px);
  box-shadow:0 10px 24px -8px var(--brand-glow);
}
.recent-card .rc-icon{
  width:38px;height:38px;
  border-radius:10px;
  background:var(--brand-light);
  color:var(--brand);
  display:grid;place-items:center;
  flex-shrink:0;
}
html[data-theme="dark"] .recent-card .rc-icon{background:rgba(248,111,3,.15)}
.recent-card .rc-icon .icon-svg{width:16px;height:16px}
.recent-card .rc-text{flex:1;min-width:0}
.recent-card .rc-name{
  font-size:.82rem;
  font-weight:800;
  color:var(--ink);
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.recent-card .rc-time{
  font-size:.65rem;
  color:var(--muted);
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.3px;
  margin-top:2px;
}

/* ============ MAIN BENTO GRID ============ */
.bento-main{
  display:grid;
  grid-template-columns:repeat(6,1fr);
  gap:16px;
  margin-bottom:24px;
}

.bcard{
  background:var(--card);
  border:1.5px solid var(--line);
  border-radius:20px;
  padding:22px;
  position:relative;
  overflow:hidden;
  text-decoration:none;
  color:var(--ink);
  transition:all .3s cubic-bezier(.4,0,.2,1);
  cursor:pointer;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  min-height:180px;
}
.bcard::before{
  content:"";
  position:absolute;
  inset:0;
  background:radial-gradient(circle at top right, rgba(248,111,3,.08), transparent 60%);
  opacity:0;
  transition:opacity .3s ease;
  pointer-events:none;
}
.bcard:hover{
  transform:translateY(-5px);
  border-color:var(--brand);
  box-shadow:0 20px 50px -15px var(--brand-glow);
}
.bcard:hover::before{opacity:1}
.bcard:hover .bico{
  transform:scale(1.1) rotate(-5deg);
  background:var(--brand);
  color:#fff;
}
.bcard:hover .barrow{
  opacity:1;
  transform:translate(4px,-4px);
  color:var(--brand);
}

/* Card header */
.bcard .btop{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:12px;
  position:relative;
  z-index:2;
}
.bcard .bico{
  width:46px;height:46px;
  border-radius:14px;
  background:var(--brand-light);
  color:var(--brand);
  display:grid;place-items:center;
  transition:all .3s cubic-bezier(.4,0,.2,1);
  flex-shrink:0;
}
html[data-theme="dark"] .bcard .bico{background:rgba(248,111,3,.15)}
.bcard .bico .icon-svg{width:20px;height:20px;stroke-width:2.4}

/* Favorite star */
.bcard .fav-btn{
  background:transparent;
  border:none;
  color:var(--muted);
  cursor:pointer;
  padding:4px;
  transition:all .2s ease;
  z-index:3;
  opacity:.4;
}
.bcard .fav-btn:hover,
.bcard .fav-btn.active{
  color:var(--amber);
  opacity:1;
}
.bcard .fav-btn.active .icon-svg{fill:var(--amber);stroke:var(--amber)}
.bcard .fav-btn .icon-svg{width:16px;height:16px}

/* Card body */
.bcard .bbody{
  position:relative;
  z-index:2;
  margin-top:auto;
}
.bcard .btitle{
  font-size:1rem;
  font-weight:800;
  letter-spacing:-.3px;
  color:var(--ink);
  line-height:1.3;
  display:flex;
  align-items:center;
  gap:6px;
}
.bcard .barrow{
  opacity:0;
  transition:all .25s ease;
  color:var(--muted);
}
.bcard .barrow .icon-svg{width:14px;height:14px}
.bcard .bsub{
  font-size:.75rem;
  color:var(--muted);
  font-weight:600;
  margin-top:5px;
  line-height:1.4;
}
.bcard .btags{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
  margin-top:12px;
}
.bcard .btag{
  font-size:.62rem;
  font-weight:800;
  padding:3px 8px;
  border-radius:999px;
  background:var(--brand-light);
  color:var(--brand);
  text-transform:uppercase;
  letter-spacing:.3px;
}
html[data-theme="dark"] .bcard .btag{background:rgba(248,111,3,.15)}
.bcard .btag.gray{
  background:var(--bg);
  color:var(--muted);
}

/* Card sizes */
.bcard.feat{grid-column:span 3;grid-row:span 2;background:linear-gradient(135deg,var(--hero-dark) 0%,var(--hero-dark-2) 100%);color:#fff;border-color:transparent;min-height:260px;padding:30px}
.bcard.feat::before{background:radial-gradient(circle at top right, rgba(248,111,3,.35), transparent 60%)}
.bcard.feat .btitle{color:#fff;font-size:1.5rem;letter-spacing:-.6px}
.bcard.feat .bsub{color:rgba(255,255,255,.7);font-size:.85rem;margin-top:8px}
.bcard.feat .bico{background:rgba(248,111,3,.2);color:var(--brand);width:56px;height:56px}
.bcard.feat .bico .icon-svg{width:24px;height:24px}
.bcard.feat:hover .bico{background:var(--brand);color:#fff}
.bcard.feat .btag{background:rgba(255,255,255,.12);color:#fff}
.bcard.feat .btag.gray{background:rgba(255,255,255,.08);color:rgba(255,255,255,.7)}
.bcard.feat .fav-btn{color:rgba(255,255,255,.5)}
.bcard.feat .barrow{color:rgba(255,255,255,.5)}

.bcard.wide{grid-column:span 3}
.bcard.tall{grid-row:span 2}
.bcard.med{grid-column:span 2}
.bcard.sm{grid-column:span 1;min-height:140px}
.bcard.sm .bico{width:38px;height:38px;border-radius:11px}
.bcard.sm .bico .icon-svg{width:16px;height:16px}
.bcard.sm .btitle{font-size:.85rem}
.bcard.sm .bsub{font-size:.68rem;margin-top:3px}

/* Color variants */
.bcard.alert{
  background:linear-gradient(135deg, #F86F03 0%, #FF9A3D 100%);
  color:#fff;border-color:transparent;
}
.bcard.alert::before{background:radial-gradient(circle at top right, rgba(255,255,255,.25), transparent 60%)}
.bcard.alert .bico{background:rgba(255,255,255,.2);color:#fff}
.bcard.alert:hover .bico{background:#fff;color:var(--brand)}
.bcard.alert .btitle{color:#fff}
.bcard.alert .bsub{color:rgba(255,255,255,.85)}
.bcard.alert .btag{background:rgba(255,255,255,.2);color:#fff}
.bcard.alert .fav-btn{color:rgba(255,255,255,.6)}

.bcard.success{
  background:linear-gradient(135deg, #10B981 0%, #059669 100%);
  color:#fff;border-color:transparent;
}
.bcard.success::before{background:radial-gradient(circle at top right, rgba(255,255,255,.25), transparent 60%)}
.bcard.success .bico{background:rgba(255,255,255,.2);color:#fff}
.bcard.success:hover .bico{background:#fff;color:var(--green)}
.bcard.success .btitle{color:#fff}
.bcard.success .bsub{color:rgba(255,255,255,.85)}
.bcard.success .btag{background:rgba(255,255,255,.2);color:#fff}
.bcard.success .fav-btn{color:rgba(255,255,255,.6)}

.bcard.purple{
  background:linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%);
  color:#fff;border-color:transparent;
}
.bcard.purple::before{background:radial-gradient(circle at top right, rgba(255,255,255,.25), transparent 60%)}
.bcard.purple .bico{background:rgba(255,255,255,.2);color:#fff}
.bcard.purple:hover .bico{background:#fff;color:var(--purple)}
.bcard.purple .btitle{color:#fff}
.bcard.purple .bsub{color:rgba(255,255,255,.85)}
.bcard.purple .btag{background:rgba(255,255,255,.2);color:#fff}
.bcard.purple .fav-btn{color:rgba(255,255,255,.6)}

.bcard.blue{
  background:linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color:#fff;border-color:transparent;
}
.bcard.blue::before{background:radial-gradient(circle at top right, rgba(255,255,255,.25), transparent 60%)}
.bcard.blue .bico{background:rgba(255,255,255,.2);color:#fff}
.bcard.blue:hover .bico{background:#fff;color:var(--blue)}
.bcard.blue .btitle{color:#fff}
.bcard.blue .bsub{color:rgba(255,255,255,.85)}
.bcard.blue .btag{background:rgba(255,255,255,.2);color:#fff}
.bcard.blue .fav-btn{color:rgba(255,255,255,.6)}

/* Hidden (for filter) */
.bcard.hidden{display:none}

/* ============ FOOTER ============ */
.foot{
  margin-top:40px;
  padding-top:24px;
  border-top:1px solid var(--line);
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-size:.75rem;
  color:var(--muted);
  font-weight:600;
  flex-wrap:wrap;
  gap:12px;
}
.foot .brandline b{color:var(--brand)}

/* ============ RESPONSIVE ============ */
@media (max-width:1200px){
  .bento-main{grid-template-columns:repeat(4,1fr)}
  .bcard.feat{grid-column:span 4;grid-row:span 1}
  .bcard.wide{grid-column:span 2}
  .bcard.med{grid-column:span 2}
}
@media (max-width:900px){
  .new-wrapper{margin-left:0}
  .stats-row{grid-template-columns:repeat(2,1fr)}
  .bento-main{grid-template-columns:repeat(3,1fr)}
  .bcard.feat{grid-column:span 3}
  .bcard.wide,.bcard.med{grid-column:span 2}
}
@media (max-width:640px){
  .dash-wrap{padding:20px 16px 40px}
  .stats-row{grid-template-columns:1fr}
  .bento-main{grid-template-columns:1fr}
  .bcard.feat,.bcard.wide,.bcard.med,.bcard.sm{grid-column:span 1}
  .welcome-bar{flex-direction:column;align-items:flex-start}
  .welcome-text h1{font-size:1.3rem}
  .recent-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>

<%@include file="./userheader.jsp"%>

<%
  String roleForDisplay = (String) session.getAttribute("role");
  String userInitial = (roleForDisplay != null && roleForDisplay.length() > 0) 
                       ? roleForDisplay.substring(0,1).toUpperCase() : "U";
%>

<div class="new-wrapper">
<div class="dash-wrap">

  <!-- ============ WELCOME BAR ============ -->
  <section class="welcome-bar">
    <div class="welcome-left">
      <div class="welcome-avatar"><%= userInitial %></div>
      <div class="welcome-text">
        <h1><span id="greeting">Welcome back</span>, <span class="grad"><%= roleForDisplay != null ? roleForDisplay : "Operator" %></span></h1>
        <p>You have <b>10+ dashboards</b> ready · <b>All systems operational</b></p>
      </div>
    </div>
    <div class="welcome-right">
      <div class="live-clock">

private void getEISRole(RegistrationActionForm l_obj) throws SQLException {
Connection con = null;
Statement l_objstatement = null;
ResultSet l_bjres = null;

try {
con = DBUtilityAuto.getReportDBConnection();
ArrayList<String> list = new ArrayList<>();
list.add("Select Role");

String query = "SELECT rolename FROM rolemst";
l_objstatement = con.createStatement();
l_bjres = l_objstatement.executeQuery(query);

if (l_bjres != null) {
while (l_bjres.next()) {
list.add(l_bjres.getString("rolename"));
}
}

l_obj.setRolelist(list);
} catch (SQLException e) {
e.printStackTrace();
throw e;
} finally {
// Close resources
try {
if (l_bjres != null) l_bjres.close();
if (l_objstatement != null) l_objstatement.close();
if (con != null) con.close();
} catch (SQLException e) {
e.printStackTrace();
}
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>EIS Portal — Sign In</title>
<script src="<%=request.getContextPath()%>/js/jquery.min.js"></script>
<style>
:root{
  --brand:#F86F03;
  --brand-2:#FF9A3D;
  --brand-light:#FFF4EC;
  --brand-glow:rgba(248,111,3,.4);
  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F7F7F5;
  --card:#FFFFFF;
  --dark-1:#0A0A0A;
  --dark-2:#1A1A1A;
  --dark-3:#2A2A2A;
  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
html[data-theme="dark"]{
  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#272727;
  --bg:#0F0F0F;
  --card:#161616;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{
  height:100vh;
  width:100vw;
  overflow:hidden;
}
body{
  font-family:var(--font-stack);
  font-weight:700;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  transition:background .3s ease,color .3s ease;
}
a{color:inherit;text-decoration:none}
h1,h2,h3,h4,h5,h6,strong,b{font-weight:800;letter-spacing:-.3px}

.icon-svg{
  width:16px;height:16px;
  display:inline-block;flex-shrink:0;
  stroke:currentColor;fill:none;
  stroke-width:2.2;
  stroke-linecap:round;
  stroke-linejoin:round;
}

/* ============================================================
   MAIN SHELL — 3-column, single screen, no scroll
   ============================================================ */
.shell{
  width:100vw;
  height:100vh;
  display:grid;
  grid-template-columns: 400px 1fr 400px;
  overflow:hidden;
}

/* ============================================================
   LEFT: BRAND PANEL (dark, value props)
   ============================================================ */
.brand-panel{
  background:linear-gradient(160deg, #0A0A0A 0%, #1A1A1A 50%, #2A2A2A 100%);
  padding:36px 32px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  position:relative;
  overflow:hidden;
  color:#fff;
  height:100vh;
}
.brand-panel::before{
  content:"";
  position:absolute;
  top:-100px;right:-100px;
  width:380px;height:380px;
  border-radius:50%;
  background:radial-gradient(circle, rgba(248,111,3,.35) 0%, transparent 70%);
  animation:float 14s ease-in-out infinite;
}
.brand-panel::after{
  content:"";
  position:absolute;
  bottom:-120px;left:-80px;
  width:320px;height:320px;
  border-radius:50%;
  background:radial-gradient(circle, rgba(255,154,61,.2) 0%, transparent 70%);
  animation:float 18s ease-in-out infinite reverse;
}
@keyframes float{
  0%,100%{transform:translate(0,0) scale(1)}
  50%{transform:translate(30px,-40px) scale(1.1)}
}

.brand-top{
  position:relative;
  z-index:2;
  display:flex;
  align-items:center;
  gap:14px;
}
.brand-mark{
  width:48px;height:48px;
  background:linear-gradient(135deg, var(--brand), var(--brand-2));
  display:grid;place-items:center;
  border-radius:13px;
  box-shadow:0 10px 28px -8px var(--brand);
  position:relative;
  flex-shrink:0;
}
.brand-mark::after{
  content:"";
  position:absolute;
  inset:0;
  border-radius:13px;
  border:2px solid var(--brand);
  opacity:.4;
  animation:ping 2.5s ease-out infinite;
}
@keyframes ping{
  0%{transform:scale(1);opacity:.5}
  100%{transform:scale(1.5);opacity:0}
}
.brand-mark .icon-svg{width:22px;height:22px;stroke-width:2.6}

.brand-text{display:flex;flex-direction:column;gap:2px}
.brand-text .title{
  font-size:1.25rem;font-weight:900;
  letter-spacing:.4px;
  color:#fff;
}
.brand-text .sub{
  font-size:.68rem;font-weight:800;
  color:var(--brand);
  letter-spacing:2.4px;
  text-transform:uppercase;
}

.brand-middle{
  position:relative;
  z-index:2;
  display:flex;
  flex-direction:column;
  gap:24px;
  padding:20px 0;
}
.brand-eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  width:fit-content;
  padding:6px 14px;
  background:rgba(248,111,3,.14);
  border:1px solid rgba(248,111,3,.35);
  border-radius:999px;
  font-size:.68rem;font-weight:800;
  color:var(--brand);
  letter-spacing:1.4px;
  text-transform:uppercase;
}
.brand-eyebrow .dot{
  width:6px;height:6px;
  border-radius:50%;
  background:var(--brand);
  box-shadow:0 0 10px var(--brand);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

.brand-heading{
  font-size:2.1rem;
  font-weight:900;
  line-height:1.1;
  letter-spacing:-1.2px;
  color:#fff;
}
.brand-heading .grad{
  background:linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.brand-desc{
  font-size:.88rem;
  line-height:1.7;
  color:rgba(255,255,255,.65);
  font-weight:600;
}

.brand-features{
  display:flex;
  flex-direction:column;
  gap:10px;
  margin-top:8px;
}
.feature-item{
  display:flex;align-items:center;gap:12px;
  padding:11px 14px;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.08);
  border-radius:11px;
  font-size:.82rem;
  font-weight:700;
  color:rgba(255,255,255,.88);
  transition:all .2s ease;
}
.feature-item:hover{
  background:rgba(248,111,3,.1);
  border-color:rgba(248,111,3,.35);
  transform:translateX(4px);
}
.feature-item .fi{
  width:26px;height:26px;
  display:grid;place-items:center;
  background:rgba(248,111,3,.18);
  color:var(--brand);
  border-radius:7px;
  flex-shrink:0;
}
.feature-item .fi .icon-svg{width:13px;height:13px;stroke-width:2.6}

.brand-bottom{
  position:relative;
  z-index:2;
  display:flex;
  flex-direction:column;
  gap:10px;
}
.brand-status{
  display:flex;align-items:center;gap:8px;
  font-size:.72rem;font-weight:800;
  color:#4ADE80;
  letter-spacing:1px;
  text-transform:uppercase;
}
.brand-status .dot{
  width:7px;height:7px;
  border-radius:50%;
  background:#4ADE80;
  box-shadow:0 0 10px #4ADE80;
  animation:pulse 2s ease-in-out infinite;
}
.brand-copyright{
  font-size:.7rem;
  color:rgba(255,255,255,.4);
  font-weight:700;
}

/* ============================================================
   CENTER: FORM PANEL
   ============================================================ */
.form-panel{
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40px 56px;
  background:var(--card);
  height:100vh;
  overflow:hidden;
}
.form-inner{
  width:100%;
  max-width:440px;
}

.form-header{
  margin-bottom:26px;
  text-align:center;
}
.form-header .step{
  display:inline-flex;align-items:center;gap:8px;
  font-size:.68rem;font-weight:800;
  color:var(--brand);
  letter-spacing:2px;
  text-transform:uppercase;
  margin-bottom:12px;
  padding:5px 14px;
  background:var(--brand-light);
  border-radius:999px;
}
html[data-theme="dark"] .form-header .step{
  background:rgba(248,111,3,.15);
}
.form-header h2{
  font-size:2rem;
  font-weight:900;
  letter-spacing:-.8px;
  margin-bottom:8px;
  color:var(--ink);
}
.form-header p{
  color:var(--muted);
  font-size:.9rem;
  font-weight:700;
}

/* Tabs */
.tabs{
  display:flex;
  gap:5px;
  background:var(--bg);
  padding:5px;
  border-radius:14px;
  margin-bottom:24px;
  border:1px solid var(--line);
}
.tab{
  flex:1;
  padding:12px;
  border:none;
  background:transparent;
  color:var(--muted);
  font-family:inherit;
  font-size:.82rem;
  font-weight:800;
  border-radius:10px;
  cursor:pointer;
  transition:all .2s ease;
  display:flex;align-items:center;justify-content:center;gap:8px;
  text-transform:uppercase;
  letter-spacing:.6px;
  position:relative;
}
.tab .icon-svg{width:14px;height:14px}
.tab.active{
  background:var(--card);
  color:var(--brand);
  box-shadow:0 2px 10px rgba(0,0,0,.08);
}
.tab.active::before{
  content:"";
  position:absolute;
  top:-1px;left:25%;right:25%;
  height:2px;
  background:var(--brand);
  border-radius:2px;
}

.field{margin-bottom:16px;position:relative}
.field label{
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-size:.72rem;
  font-weight:800;
  color:var(--ink);
  margin-bottom:8px;
  text-transform:uppercase;
  letter-spacing:.8px;
}
.field label .req{
  font-size:.6rem;
  color:var(--muted);
  font-weight:700;
  letter-spacing:.4px;
}
.input-box{
  position:relative;
  display:flex;align-items:center;
  border:1.5px solid var(--line);
  background:var(--bg);
  border-radius:12px;
  transition:all .25s ease;
}
.input-box:focus-within{
  border-color:var(--brand);
  background:var(--card);
  box-shadow:0 0 0 4px var(--brand-light);
}
html[data-theme="dark"] .input-box:focus-within{
  box-shadow:0 0 0 4px rgba(248,111,3,.2);
}
.input-box > .icon-svg{
  color:var(--muted);
  margin-left:16px;
  transition:color .25s ease;
  width:16px;height:16px;
}
.input-box:focus-within > .icon-svg{color:var(--brand)}
.input-box input,
.input-box select{
  flex:1;
  padding:14px 16px 14px 12px;
  background:transparent;
  border:none;
  outline:none;
  font-family:inherit;
  font-size:.9rem;
  font-weight:700;
  color:var(--ink);
  width:100%;
}
.input-box select{
  cursor:pointer;
  appearance:none;
  padding-right:40px;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%236B7280' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
  background-repeat:no-repeat;
  background-position:right 16px center;
}
.input-box select option{
  background: var(--card);
  color: var(--ink);
}
.input-box input::placeholder{color:var(--muted);font-weight:600;opacity:.65}

.pw-toggle{
  background:transparent;border:none;
  color:var(--muted);
  padding:0 16px;
  cursor:pointer;
  transition:color .2s ease;
  display:grid;place-items:center;
}
.pw-toggle .icon-svg{width:16px;height:16px}
.pw-toggle:hover{color:var(--brand)}

.alert{
  display:none;
  padding:12px 16px;
  border-radius:11px;
  font-size:.84rem;
  font-weight:700;
  margin-bottom:16px;
  align-items:center;gap:10px;
}
.alert.error{background:#FEF2F2;color:#B91C1C;border:1px solid #FECACA}
.alert.success{background:#F0FDF4;color:#15803D;border:1px solid #BBF7D0}
.alert.show{display:flex}
.alert .icon-svg{width:16px;height:16px}

.btn-primary{
  width:100%;
  padding:15px;
  border:none;
  border-radius:12px;
  background:linear-gradient(135deg, var(--brand), var(--brand-2));
  color:#fff;
  font-family:inherit;
  font-weight:800;
  font-size:.92rem;
  letter-spacing:.6px;
  text-transform:uppercase;
  cursor:pointer;
  transition:all .25s ease;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  box-shadow:0 8px 22px -8px var(--brand-glow);
  position:relative;
  overflow:hidden;
}
.btn-primary::before{
  content:"";
  position:absolute;
  top:0;left:-100%;
  width:100%;height:100%;
  background:linear-gradient(90deg, transparent, rgba(255,255,255,.3), transparent);
  transition:left .7s ease;
}
.btn-primary:hover::before{left:100%}
.btn-primary:hover{
  transform:translateY(-2px);
  box-shadow:0 12px 32px -8px var(--brand-glow);
}
.btn-primary:active{transform:translateY(0)}
.btn-primary:disabled{opacity:.65;cursor:not-allowed;transform:none}

.spinner{
  width:16px;height:16px;
  border:2px solid rgba(255,255,255,.35);
  border-top-color:#fff;
  border-radius:50%;
  animation:spin .7s linear infinite;
  display:none;
}
.btn-primary.loading .spinner{display:block}
@keyframes spin{to{transform:rotate(360deg)}}

.form-view{display:none;animation:fadeIn .35s ease}
.form-view.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

.foot-note{
  margin-top:22px;
  text-align:center;
  font-size:.74rem;
  color:var(--muted);
  font-weight:700;
}
.foot-note a{
  color:var(--brand);
  text-decoration:none;
  font-weight:800;
}
.foot-note a:hover{text-decoration:underline}

/* ============================================================
   RIGHT: QUICK LINKS PANEL (all visible, scrollable)
   ============================================================ */
.links-panel{
  background:var(--bg);
  border-left:1px solid var(--line);
  padding:26px 22px;
  height:100vh;
  overflow-y:auto;
  position:relative;
}
.links-panel::-webkit-scrollbar{width:6px}
.links-panel::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}

.links-header{
  display:flex;
  align-items:center;
  gap:12px;
  margin-bottom:18px;
  padding-bottom:14px;
  border-bottom:1px solid var(--line);
}
.links-header .lh-icon{
  width:34px;height:34px;
  display:grid;place-items:center;
  background:var(--brand-light);
  color:var(--brand);
  border-radius:10px;
  flex-shrink:0;
}
html[data-theme="dark"] .links-header .lh-icon{
  background:rgba(248,111,3,.15);
}
.links-header .lh-icon .icon-svg{width:16px;height:16px}
.links-header .lh-text{
  display:flex;
  flex-direction:column;
  gap:1px;
}
.links-header .lh-title{
  font-size:.92rem;
  font-weight:900;
  color:var(--ink);
  letter-spacing:-.3px;
}
.links-header .lh-sub{
  font-size:.68rem;
  font-weight:700;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.6px;
}
.links-header .lh-count{
  margin-left:auto;
  font-size:.7rem;
  font-weight:800;
  color:var(--brand);
  background:var(--brand-light);
  padding:4px 10px;
  border-radius:999px;
}
html[data-theme="dark"] .links-header .lh-count{
  background:rgba(248,111,3,.15);
}

/* ============================================================
   ✅ ALL LINKS — 2-column grid, directly visible
   ============================================================ */
.links-grid{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap:8px;
}

.link-card{
  display:flex;
  flex-direction:column;
  gap:8px;
  padding:12px 12px;
  background:var(--card);
  border:1.5px solid var(--line);
  border-radius:11px;
  color:var(--ink);
  text-decoration:none;
  font-weight:800;
  transition:all .2s ease;
  cursor:pointer;
  position:relative;
  overflow:hidden;
}
.link-card::before{
  content:"";
  position:absolute;
  top:0;left:0;
  width:3px;height:100%;
  background:var(--brand);
  transform:scaleY(0);
  transform-origin:bottom;
  transition:transform .25s ease;
}
.link-card:hover{
  border-color:var(--brand);
  background:var(--brand-light);
  color:var(--brand);
  transform:translateY(-2px);
  box-shadow:0 8px 20px -8px var(--brand-glow);
}
.link-card:hover::before{
  transform:scaleY(1);
  transform-origin:top;
}
html[data-theme="dark"] .link-card:hover{
  background:rgba(248,111,3,.15);
}

.link-card .lc-icon{
  width:32px;height:32px;
  display:grid;place-items:center;
  background:var(--brand-light);
  color:var(--brand);
  border-radius:9px;
  flex-shrink:0;
  transition:all .2s ease;
}
html[data-theme="dark"] .link-card .lc-icon{
  background:rgba(248,111,3,.15);
}
.link-card .lc-icon .icon-svg{width:15px;height:15px;stroke-width:2.4}
.link-card:hover .lc-icon{
  background:var(--brand);
  color:#fff;
}

.link-card .lc-text{
  display:flex;
  flex-direction:column;
  gap:2px;
  min-width:0;
}
.link-card .lc-name{
  font-weight:800;
  font-size:.76rem;
  line-height:1.25;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  color:inherit;
}
.link-card .lc-sub{
  font-size:.6rem;
  font-weight:700;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.4px;
}
.link-card:hover .lc-sub{
  color:var(--brand);
  opacity:.8;
}

/* Sub-links (dropdown content — ab visible) */
.sub-links{
  display:flex;
  flex-direction:column;
  gap:2px;
  margin-top:4px;
  padding-top:8px;
  border-top:1px dashed var(--line);
}
.sub-link{
  font-size:.7rem;
  font-weight:700;
  color:var(--muted);
  display:flex;
  align-items:center;
  gap:6px;
  padding:3px 0;
  transition:color .15s ease;
}
.sub-link:hover{
  color:var(--brand);
}
.sub-link .bullet{
  width:5px;height:5px;
  border-radius:50%;
  background:var(--brand);
  flex-shrink:0;
  opacity:.6;
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 1280px){
  .shell{grid-template-columns: 360px 1fr 360px}
}
@media (max-width: 1100px){
  html,body{overflow:auto;height:auto}
  .shell{
    grid-template-columns: 1fr;
    height:auto;
    overflow:visible;
  }
  .brand-panel{height:auto;min-height:auto;padding:32px 28px}
  .form-panel{height:auto;padding:36px 28px}
  .links-panel{
    height:auto;
    overflow:visible;
    padding:28px 24px 40px;
    border-left:none;
    border-top:1px solid var(--line);
  }
  .brand-heading{font-size:1.7rem}
}
@media (max-width: 600px){
  .brand-features{display:none}
  .brand-heading{font-size:1.4rem}
  .links-grid{grid-template-columns: 1fr}
  .form-header h2{font-size:1.5rem}
}
</style>
</head>
<body>

<div class="shell">

  <!-- ============================================================
       LEFT: BRAND PANEL
       ============================================================ -->
  <aside class="brand-panel">
    <div class="brand-top">
      <div class="brand-mark">
        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div class="brand-text">
        <span class="title">EIS Portal</span>
        <span class="sub">Enterprise Integration Services</span>
      </div>
    </div>

    <div class="brand-middle">
      <div class="brand-eyebrow">
        <span class="dot"></span>
        Secure Access Terminal
      </div>
      <h1 class="brand-heading">
        Your <span class="grad">integration</span><br>command center.
      </h1>
      <p class="brand-desc">
        One secure gateway to dashboards, monitoring, reports and operational tools — built for the EIS team to move faster.
      </p>

      <div class="brand-features">
        <div class="feature-item">
          <span class="fi"><svg class="icon-svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
          Single sign-on across all tools
        </div>
        <div class="feature-item">
          <span class="fi"><svg class="icon-svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
          Real-time monitoring dashboards
        </div>
        <div class="feature-item">
          <span class="fi"><svg class="icon-svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
          Enterprise-grade security
        </div>

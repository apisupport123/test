<style>
  /* ============================================================
     CSS VARIABLES — dark (default) & light
     ============================================================ */
  :root, html[data-theme="dark"] {
    --bg: #020308;
    --panel: #0a0d15;
    --panel-2: #0f1219;
    --line: #1c2030;
    --ink: #ffffff;
    --muted: #8b90b0;
    --subtle: #5c6183;

    /* accent (timer) */
    --brand: #6366f1;
    --brand-glow: rgba(99, 102, 241, 0.35);

    /* severity palette — ✅ #ff1a1a red */
    --critical: #ff1a1a;
    --critical-soft: rgba(255, 26, 26, 0.10);
    --critical-border: rgba(255, 26, 26, 0.45);
    --warning: #f59e0b;
    --ok: #10b981;

    --chart-bg: #0a0d15;
    --chart-border: #1c2030;
    --chart-grid: #2a2f45;
    --chart-tick: #1c2030;
    --chip-bg: #0a0d15;
  }

  html[data-theme="light"] {
    --bg: #f4f5f7;
    --panel: #ffffff;
    --panel-2: #f9fafb;
    --line: #e5e7eb;
    --ink: #0a0a0a;
    --muted: #6b7280;
    --subtle: #9ca3af;

    --brand: #4f46e5;
    --brand-glow: rgba(79, 70, 229, 0.25);

    --critical: #e60000;                  /* slightly darker for light bg readability */
    --critical-soft: rgba(255, 26, 26, 0.08);
    --critical-border: rgba(255, 26, 26, 0.40);
    --warning: #f59e0b;
    --ok: #10b981;

    --chart-bg: #ffffff;
    --chart-border: #e5e7eb;
    --chart-grid: #e5e7eb;
    --chart-tick: #d1d5db;
    --chip-bg: #ffffff;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    transition: background .3s ease, color .3s ease;
  }

  .app {
    display: flex;
    flex-direction: column;
    height: 100vh;
    width: 100vw;
  }

  /* ============================================================
     TOP BAR
     ============================================================ */
  .topbar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
    padding: 12px 22px;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
    transition: background .3s ease, border-color .3s ease;
  }

  .timer-block {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .timer-label {
    font-size: 15px;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.2;
  }
  .timer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 110px;
    padding: 6px 14px;
    border: 3px solid var(--brand);
    border-radius: 8px;
    color: var(--ink);
    font-family: 'Courier New', monospace;
    font-size: 32px;
    font-weight: 900;
    background: var(--brand-glow);
    box-shadow: 0 0 12px var(--brand-glow);
    letter-spacing: 1px;
    line-height: 1;
  }

  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
    height: 100%;
  }
  .kpi {
    background: var(--panel);
    padding: 8px 18px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    transition: background .3s ease;
  }
  .kpi-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    white-space: nowrap;
  }
  .kpi-value {
    font-family: 'Courier New', monospace;
    font-size: 34px;
    font-weight: 900;
    line-height: 1;
    margin-top: 4px;
    color: var(--ink);
    letter-spacing: -1px;
  }
  .kpi-value.red    { color: var(--critical); }
  .kpi-value.orange { color: var(--warning); }
  .kpi-value.green  { color: var(--ok); }

  .blink-red {
    animation: blinkRed 1.4s ease-in-out infinite;
  }
  @keyframes blinkRed {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.4; }
  }

  .right-block {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sev-chips { display: flex; gap: 8px; }
  .sev-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--chip-bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
  }
  .sev-dot {
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }

  .live-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(16, 185, 129, 0.14);
    border: 1px solid rgba(16, 185, 129, 0.4);
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    color: var(--ok);
    letter-spacing: 1.5px;
  }
  .live-badge .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
    animation: pulseGreen 1.6s infinite;
  }
  @keyframes pulseGreen {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.4; transform: scale(0.8); }
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--chip-bg);
    border: 1px solid var(--line);
    color: var(--ink);
    cursor: pointer;
    font-size: 20px;
    transition: all .2s ease;
    user-select: none;
  }
  .theme-toggle:hover {
    border-color: var(--brand);
    color: var(--brand);
    transform: translateY(-1px);
  }

  /* ============================================================
     TOP CRITICAL BAR
     ============================================================ */
  .crit-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 22px;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
    overflow-x: auto;
    transition: background .3s ease, border-color .3s ease;
  }
  .crit-bar::-webkit-scrollbar { height: 4px; }
  .crit-bar::-webkit-scrollbar-thumb { background: var(--line); border-radius: 2px; }

  .crit-bar .title {
    font-size: 12px;
    font-weight: 800;
    color: var(--critical);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    white-space: nowrap;
    padding-right: 12px;
    border-right: 1px solid var(--line);
    flex-shrink: 0;
  }

  .crit-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: var(--critical-soft);
    border: 1px solid var(--critical-border);
    border-radius: 8px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.2s;
  }
  .crit-chip:hover {
    background: rgba(255, 26, 26, 0.18);
  }
  .crit-chip.critical {
    animation: chipBlink 2s ease-in-out infinite;
  }
  @keyframes chipBlink {
    0%, 100% { box-shadow: 0 0 0 rgba(255,26,26,0); }
    50%      { box-shadow: 0 0 16px rgba(255,26,26,.6); }
  }
  .crit-chip .name {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .crit-chip .pct {
    font-family: 'Courier New', monospace;
    font-size: 20px;
    font-weight: 900;
    color: var(--critical);
  }

  /* ============================================================
     CHART AREA
     ============================================================ */
  .chart-area {
    flex: 1;
    min-height: 0;
    padding: 8px;
    background: var(--bg);
    transition: background .3s ease;
  }
  #myChart {
    width: 100%;
    height: 100%;
    background: var(--chart-bg);
    border: 1px solid var(--chart-border);
    border-radius: 10px;
    transition: background .3s ease, border-color .3s ease;
  }

  /* Responsive */
  @media (max-width: 1280px) {
    .timer-label { font-size: 13px; }
    .timer { font-size: 26px; min-width: 95px; }
    .kpi-value { font-size: 28px; }
    .kpi { padding: 6px 12px; }
    .sev-chip { padding: 4px 8px; font-size: 11px; }
  }
  @media (max-width: 900px) {
    .topbar { grid-template-columns: 1fr 1fr; gap: 10px; }
    .right-block { display: none; }
    .kpi-row { grid-column: span 2; }
    .sev-chips { display: none; }
  }
</style>

</head>


    borderWidth: "1px",
    guide: { visible: false },
    item: { fontColor: "#fff", fontSize: 20 },
    tick: { alpha: 0.2, lineColor: "#1c2030" },
    label: {
      text: '<p style="color:#ff9933;font-size:19px;font-weight:800;margin:3px 0;">TD</p>'
          + '<p style="color:#FFFFFF;font-size:19px;font-weight:800;margin:3px 0;">ENDPOINT</p>'
          + '<p style="color:#32CD32;font-size:19px;font-weight:800;margin:3px 0;">HITS</p>',

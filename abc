<script>
function adminLogout(){
  window.__logoutInProgress = true;
  try{
    sessionStorage.clear();
    localStorage.removeItem('eis-sidebar-closed');
  }catch(e){}
  window.location.replace('<%=ctx%>/login.action?logout=true');
}

(function(){
  window.history.pushState({ page: 'admin-home' }, '', window.location.href);
  window.addEventListener('popstate', function(e){
    if(window.__logoutInProgress === true) return;
    window.history.pushState({ page: 'admin-home' }, '', window.location.href);
  });
})();

function toggleTheme(){
  var cur = document.documentElement.getAttribute('data-theme') || 'dark';
  var next = cur === 'light' ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', next);
  try{ localStorage.setItem('eis-theme', next); }catch(e){}
  updateThemeIcon();
}
function updateThemeIcon(){
  var t = document.documentElement.getAttribute('data-theme') || 'dark';
  var sun = document.getElementById('themeIconSun');
  var moon = document.getElementById('themeIconMoon');
  if(!sun || !moon) return;
  if(t === 'dark'){
    sun.style.display = 'block';
    moon.style.display = 'none';
  } else {
    sun.style.display = 'none';
    moon.style.display = 'block';
  }
}
document.addEventListener('DOMContentLoaded', updateThemeIcon);
updateThemeIcon();

function toggleSidebar(){
  var root = document.documentElement;
  if(window.innerWidth <= 900){
    root.classList.toggle('sb-open');
  } else {
    root.classList.toggle('sb-collapsed');
    try{
      localStorage.setItem('eis-sidebar-closed', root.classList.contains('sb-collapsed'));
    }catch(e){}
  }
}

function search_animal() {
  var input = document.getElementById('searchbar').value.toLowerCase();
  var x = document.getElementsByClassName('animals');
  var groups = document.querySelectorAll('.sb-group');
  for (var i = 0; i < x.length; i++) {
    if (!x[i].innerText.toLowerCase().includes(input)) {
      x[i].style.display = "none";
    } else {
      x[i].style.display = "flex";
    }
  }
  groups.forEach(function(g){
    var next = g.nextElementSibling;
    var hasVisible = false;
    while(next && !next.classList.contains('sb-group')){
      if(next.classList.contains('animals') && next.style.display !== 'none'){ hasVisible = true; break; }
      next = next.nextElementSibling;
    }
    g.style.display = (hasVisible || input === '') ? 'block' : 'none';
  });
}
</script>

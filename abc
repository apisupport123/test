<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit Profile · EIS Portal</title>

<style>
/* ============================================================
   RESET & TOKENS
   ============================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --bg: #0b0714;
    --surface: rgba(255, 255, 255, .04);
    --surface-2: rgba(255, 255, 255, .07);
    --surface-3: rgba(255, 255, 255, .10);
    --border: rgba(255, 255, 255, .09);
    --border-hi: rgba(255, 255, 255, .18);

    --text: #f5f3ff;
    --text-2: #c4b5fd;
    --text-3: #8b8ba7;
    --text-4: #575779;

    --pink:    #ec4899;
    --purple:  #a855f7;
    --violet:  #8b5cf6;
    --blue:    #3b82f6;
    --cyan:    #06b6d4;
    --teal:    #14b8a6;
    --green:   #10b981;
    --lime:    #84cc16;
    --amber:   #f59e0b;
    --orange:  #f97316;
    --red:     #ef4444;

    --radius-sm: 12px;
    --radius:    20px;
    --radius-lg: 28px;
    --radius-xl: 36px;

    --font-sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif;
    --font-mono: ui-monospace, "SF Mono", Consolas, monospace;
}

html, body {
    font-family: var(--font-sans);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    line-height: 1.5;
    letter-spacing: -.01em;
}

/* ============================================================
   MORPHING BLOB BACKGROUND
   ============================================================ */
.blob-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: var(--bg);
}
.blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: .5;
    animation: morph 20s ease-in-out infinite;
    will-change: transform, border-radius;
}
.blob-1 {
    width: 550px; height: 550px;
    background: linear-gradient(135deg, var(--pink), var(--purple));
    top: -15%; left: -10%;
}
.blob-2 {
    width: 600px; height: 600px;
    background: linear-gradient(135deg, var(--cyan), var(--blue));
    top: 20%; right: -15%;
    animation-delay: -7s;
}
.blob-3 {
    width: 500px; height: 500px;
    background: linear-gradient(135deg, var(--teal), var(--green));
    bottom: -20%; left: 25%;
    animation-delay: -14s;
}
.blob-4 {
    width: 450px; height: 450px;
    background: linear-gradient(135deg, var(--amber), var(--orange));
    top: 50%; left: 40%;
    animation-delay: -3s;
    opacity: .35;
}
@keyframes morph {
    0%, 100% { transform: translate(0, 0) scale(1); border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
    33%      { transform: translate(80px, -60px) scale(1.15); border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; }
    66%      { transform: translate(-60px, 70px) scale(.9); border-radius: 50% 50% 40% 60% / 40% 50% 50% 60%; }
}

/* Subtle noise */
.blob-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/></svg>");
    opacity: .04;
    pointer-events: none;
}

/* ============================================================
   TOP NAV
   ============================================================ */
.topnav {
    position: sticky;
    top: 16px;
    z-index: 100;
    max-width: 1480px;
    margin: 16px auto 0;
    padding: 0 20px;
}
.topnav-inner {
    background: rgba(20, 15, 40, .65);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, .4);
}
.brand { display: flex; align-items: center; gap: 14px; }
.brand-logo {
    width: 42px; height: 42px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--pink), var(--purple), var(--violet));
    display: grid; place-items: center;
    color: #fff;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: -.5px;
    box-shadow: 0 8px 24px rgba(168, 85, 247, .5),
                inset 0 1px 0 rgba(255, 255, 255, .3);
    position: relative;
    overflow: hidden;
}
.brand-logo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, .35), transparent);
    animation: shine 3s ease-in-out infinite;
    transform: translateX(-100%);
}
@keyframes shine {
    0%, 100% { transform: translateX(-100%); }
    50%      { transform: translateX(100%); }
}
.brand-text .title {
    font-size: 15px;
    font-weight: 700;
    background: linear-gradient(135deg, #fff, var(--text-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}
.brand-text .sub {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 1px;
}
.nav-right { display: flex; align-items: center; gap: 10px; }

/* Buttons */
.btn-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 100px;
    border: 1px solid var(--border-hi);
    background: var(--surface-2);
    color: var(--text);
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all .3s cubic-bezier(.34, 1.56, .64, 1);
    white-space: nowrap;
    letter-spacing: -.01em;
}
.btn-pill:hover {
    background: var(--surface-3);
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, .3);
    box-shadow: 0 12px 30px rgba(0, 0, 0, .3);
}
.btn-pill.primary {
    background: linear-gradient(135deg, var(--pink), var(--purple));
    border-color: transparent;
    box-shadow: 0 8px 24px rgba(168, 85, 247, .4),
                inset 0 1px 0 rgba(255, 255, 255, .3);
}
.btn-pill.primary:hover {
    box-shadow: 0 14px 40px rgba(168, 85, 247, .6),
                inset 0 1px 0 rgba(255, 255, 255, .4);
}

/* ============================================================
   PAGE
   ============================================================ */
.page {
    max-width: 1480px;
    margin: 0 auto;
    padding: 32px 20px 100px;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 28px;
    flex-wrap: wrap;
}
.page-header h1 {
    font-size: 42px;
    font-weight: 800;
    letter-spacing: -.04em;
    line-height: 1.05;
    background: linear-gradient(135deg, #fff 20%, var(--text-2) 70%, var(--pink));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 8px;
}
.page-header .subtitle {
    font-size: 15px;
    color: var(--text-3);
    letter-spacing: -.01em;
}
.chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}
.chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 100px;
    font-size: 12.5px;
    font-weight: 600;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-2);
    letter-spacing: -.01em;
    backdrop-filter: blur(12px);
}
.chip .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 12px var(--green);
    animation: pulse 2s ease-in-out infinite;
}
.chip.active {
    background: rgba(16, 185, 129, .15);
    border-color: rgba(16, 185, 129, .3);
    color: #6ee7b7;
}
.chip.inactive {
    background: rgba(239, 68, 68, .15);
    border-color: rgba(239, 68, 68, .3);
    color: #fca5a5;
}
@keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: .5; transform: scale(.85); }
}

/* ============================================================
   BENTO GRID LAYOUT
   ============================================================ */
.bento {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 20px;
    align-items: start;
}

/* ============================================================
   LEFT SIDEBAR — PROFILE CARD
   ============================================================ */
.sidebar-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: sticky;
    top: 96px;
}

/* Profile Card — glass + gradient */
.profile-card {
    background: linear-gradient(155deg,
        rgba(255, 255, 255, .08),
        rgba(255, 255, 255, .03));
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px 24px;
    text-align: center;
    position: relative;
    overflow: hidden;
    transition: transform .4s cubic-bezier(.22, 1, .36, 1);
    will-change: transform;
}
.profile-card::before {
    content: "";
    position: absolute;
    top: -50%; right: -50%;
    width: 200%; height: 200%;
    background: conic-gradient(from 0deg,
        transparent,
        rgba(236, 72, 153, .3),
        rgba(168, 85, 247, .3),
        transparent);
    animation: rotateGlow 8s linear infinite;
    z-index: -1;
}
@keyframes rotateGlow {
    to { transform: rotate(360deg); }
}

/* Animated Avatar Ring */
.avatar-wrap {
    position: relative;
    width: 140px; height: 140px;
    margin: 0 auto 20px;
    display: grid;
    place-items: center;
}
.avatar-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(from 0deg,
        var(--pink),
        var(--purple),
        var(--violet),
        var(--blue),
        var(--cyan),
        var(--pink));
    animation: rotateRing 4s linear infinite;
    z-index: 0;
}
.avatar-ring-2 {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: conic-gradient(from 180deg,
        var(--amber),
        var(--orange),
        var(--red),
        var(--pink),
        var(--amber));
    animation: rotateRing 6s linear infinite reverse;
    z-index: -1;
    opacity: .6;
}
.avatar-ring-3 {
    position: absolute;
    inset: -16px;
    border-radius: 50%;
    background: conic-gradient(from 90deg,
        var(--cyan),
        var(--blue),
        var(--purple),
        var(--cyan));
    animation: rotateRing 8s linear infinite;
    z-index: -2;
    opacity: .4;
    filter: blur(12px);
}
@keyframes rotateRing {
    to { transform: rotate(360deg); }
}
.avatar-img {
    position: relative;
    width: 128px; height: 128px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--bg);
    border: 4px solid var(--bg);
    z-index: 1;
    display: block;
}
.avatar-overlay {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: rgba(0, 0, 0, .7);
    backdrop-filter: blur(4px);
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    opacity: 0;
    cursor: pointer;
    transition: opacity .3s ease;
    z-index: 2;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
}
.avatar-overlay .icon { font-size: 26px; }
.avatar-wrap:hover .avatar-overlay { opacity: 1; }

.profile-name {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -.03em;
    color: var(--text);
    margin-bottom: 6px;
    line-height: 1.2;
}
.profile-role {
    font-size: 13.5px;
    color: var(--text-3);
    margin-bottom: 16px;
    letter-spacing: -.01em;
}

.profile-quick {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
}
.quick-item {
    text-align: left;
    padding: 10px 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: all .2s ease;
}
.quick-item:hover {
    background: var(--surface-2);
    border-color: var(--border-hi);
    transform: translateY(-2px);
}
.quick-item .label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-4);
    margin-bottom: 4px;
}
.quick-item .value {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Documents Panel */
.docs-panel {
    background: linear-gradient(155deg,
        rgba(255, 255, 255, .06),
        rgba(255, 255, 255, .02));
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 22px;
    position: relative;
    overflow: hidden;
}
.docs-panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
}
.docs-panel-head .title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -.01em;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 8px;
}
.docs-panel-head .title::before {
    content: "";
    width: 8px; height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--pink), var(--purple));
    box-shadow: 0 0 12px rgba(168, 85, 247, .7);
}
.docs-panel-head .count {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 100px;
    background: rgba(168, 85, 247, .15);
    border: 1px solid rgba(168, 85, 247, .3);
    color: #d8b4fe;
}

.doc-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    margin-bottom: 8px;
    background: var(--surface);
    transition: all .25s cubic-bezier(.34, 1.56, .64, 1);
    cursor: pointer;
    position: relative;
    overflow: hidden;
}
.doc-row:hover {
    transform: translateX(4px);
    border-color: var(--border-hi);
    background: var(--surface-2);
}
.doc-row.uploaded {
    border-color: rgba(16, 185, 129, .3);
    background: linear-gradient(135deg,
        rgba(16, 185, 129, .08),
        rgba(6, 182, 212, .04));
}
.doc-row.uploaded::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--teal), var(--green));
    box-shadow: 0 0 12px var(--teal);
}
.doc-icon {
    width: 36px; height: 36px;
    border-radius: 10px;
    display: grid; place-items: center;
    background: var(--surface-3);
    font-size: 16px;
    flex-shrink: 0;
    transition: all .25s ease;
}
.doc-row.uploaded .doc-icon {
    background: linear-gradient(135deg, var(--teal), var(--green));
    color: #fff;
    box-shadow: 0 4px 14px rgba(16, 185, 129, .4);
}
.doc-info { flex: 1; min-width: 0; }
.doc-info .name {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 2px;
    letter-spacing: -.01em;
}
.doc-info .status {
    font-size: 11px;
    color: var(--text-3);
    font-weight: 500;
}
.doc-row.uploaded .doc-info .status { color: #6ee7b7; }
.doc-view {
    width: 32px; height: 32px;
    border-radius: 8px;
    border: none;
    background: var(--surface-3);
    color: var(--text-2);
    cursor: pointer;
    display: grid; place-items: center;
    font-size: 14px;
    transition: all .2s ease;
    flex-shrink: 0;
}
.doc-view:hover {
    background: linear-gradient(135deg, var(--pink), var(--purple));
    color: #fff;
    transform: scale(1.1) rotate(-8deg);
}

/* ============================================================
   RIGHT — BENTO CARDS
   ============================================================ */
.bento-col {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
}

.bento-card {
    grid-column: span 12;
    background: linear-gradient(155deg,
        rgba(255, 255, 255, .07),
        rgba(255, 255, 255, .02));
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    position: relative;
    overflow: hidden;
    transition: all .4s cubic-bezier(.22, 1, .36, 1);
    will-change: transform;
    opacity: 0;
    transform: translateY(24px);
    animation: bentoIn .6s cubic-bezier(.22, 1, .36, 1) forwards;
}
.bento-card:nth-child(1) { animation-delay: .05s; }
.bento-card:nth-child(2) { animation-delay: .10s; }
.bento-card:nth-child(3) { animation-delay: .15s; }
.bento-card:nth-child(4) { animation-delay: .20s; }
.bento-card:nth-child(5) { animation-delay: .25s; }
.bento-card:nth-child(6) { animation-delay: .30s; }
.bento-card:nth-child(7) { animation-delay: .35s; }

@keyframes bentoIn {
    to { opacity: 1; transform: translateY(0); }
}

/* Card top gradient accent bar */
.bento-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    opacity: .9;
}
.bento-card.c-pink::before    { background: linear-gradient(90deg, var(--pink), var(--purple)); }
.bento-card.c-purple::before  { background: linear-gradient(90deg, var(--purple), var(--violet)); }
.bento-card.c-cyan::before    { background: linear-gradient(90deg, var(--cyan), var(--blue)); }
.bento-card.c-green::before   { background: linear-gradient(90deg, var(--green), var(--teal)); }
.bento-card.c-amber::before   { background: linear-gradient(90deg, var(--amber), var(--orange)); }
.bento-card.c-red::before     { background: linear-gradient(90deg, var(--red), var(--pink)); }
.bento-card.c-violet::before  { background: linear-gradient(90deg, var(--violet), var(--purple)); }

.bento-card:hover {
    transform: translateY(-6px) scale(1.005);
    border-color: var(--border-hi);
    box-shadow: 0 30px 60px rgba(0, 0, 0, .5);
}

/* Card header */
.card-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
}
.card-icon {
    width: 48px; height: 48px;
    border-radius: 14px;
    display: grid; place-items: center;
    font-size: 22px;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    transition: transform .3s cubic-bezier(.34, 1.56, .64, 1);
}
.card-icon::before {
    content: "";
    position: absolute;
    inset: 0;
    background: inherit;
    filter: blur(20px);
    opacity: .5;
    z-index: -1;
}
.bento-card:hover .card-icon {
    transform: scale(1.1) rotate(-6deg);
}
.card-icon.i-pink   { background: linear-gradient(135deg, var(--pink), var(--purple)); box-shadow: 0 8px 24px rgba(236, 72, 153, .35); }
.card-icon.i-cyan   { background: linear-gradient(135deg, var(--cyan), var(--blue)); box-shadow: 0 8px 24px rgba(6, 182, 212, .35); }
.card-icon.i-green  { background: linear-gradient(135deg, var(--green), var(--teal)); box-shadow: 0 8px 24px rgba(16, 185, 129, .35); }
.card-icon.i-amber  { background: linear-gradient(135deg, var(--amber), var(--orange)); box-shadow: 0 8px 24px rgba(245, 158, 11, .35); }
.card-icon.i-purple { background: linear-gradient(135deg, var(--purple), var(--violet)); box-shadow: 0 8px 24px rgba(168, 85, 247, .35); }
.card-icon.i-red    { background: linear-gradient(135deg, var(--red), var(--pink)); box-shadow: 0 8px 24px rgba(239, 68, 68, .35); }

.card-title-block { flex: 1; min-width: 0; }
.card-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -.02em;
    margin-bottom: 2px;
}
.card-sub {
    font-size: 12px;
    color: var(--text-3);
    letter-spacing: -.01em;
}

/* Fields grid */
.fields-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
}
.fields-grid .span-2 { grid-column: span 2; }
@media (max-width: 700px) {
    .fields-grid .span-2 { grid-column: span 1; }
}

.field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: relative;
}
.field-label {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--text-3);
    letter-spacing: .01em;
    display: flex;
    align-items: center;
    gap: 4px;
    padding-left: 2px;
}
.field-label .req { color: var(--red); font-size: 14px; }

.field-input,
.field-select,
.field-textarea {
    width: 100%;
    padding: 13px 16px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    background: rgba(255, 255, 255, .04);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    outline: none;
    transition: all .25s cubic-bezier(.22, 1, .36, 1);
    letter-spacing: -.01em;
}
.field-input:hover:not(:focus):not(:read-only),
.field-select:hover:not(:focus),
.field-textarea:hover:not(:focus) {
    background: rgba(255, 255, 255, .06);
    border-color: var(--border-hi);
}
.field-input:focus,
.field-select:focus,
.field-textarea:focus {
    background: rgba(255, 255, 255, .08);
    border-color: rgba(236, 72, 153, .5);
    box-shadow: 0 0 0 4px rgba(236, 72, 153, .15),
                0 8px 24px rgba(0, 0, 0, .3);
    transform: translateY(-1px);
}
.field-input:read-only {
    color: var(--text-3);
    cursor: not-allowed;
    background: rgba(255, 255, 255, .02);
    border-style: dashed;
}
.field-select {
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23c4b5fd' stroke-width='2.5'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat: no-repeat;
    background-position: right 14px center;
    background-size: 16px;
    padding-right: 42px;
    cursor: pointer;
}
.field-select option {
    background: #1a1526;
    color: var(--text);
}
.field-textarea {
    resize: vertical;
    min-height: 90px;
    line-height: 1.5;
}

/* File upload — glass drop zone */
.file-drop {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    background: rgba(255, 255, 255, .03);
    border: 1.5px dashed var(--border-hi);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all .3s cubic-bezier(.22, 1, .36, 1);
    position: relative;
    overflow: hidden;
}
.file-drop:hover {
    border-color: rgba(236, 72, 153, .5);
    background: linear-gradient(135deg,
        rgba(236, 72, 153, .08),
        rgba(168, 85, 247, .05));
    transform: translateY(-2px);
}
.file-drop.has-file {
    border-style: solid;
    border-color: rgba(16, 185, 129, .5);
    background: linear-gradient(135deg,
        rgba(16, 185, 129, .1),
        rgba(6, 182, 212, .06));
}
.file-drop::before {
    content: "⬆";
    width: 40px; height: 40px;
    border-radius: 12px;
    display: grid; place-items: center;
    background: linear-gradient(135deg, var(--pink), var(--purple));
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    flex-shrink: 0;
    transition: transform .3s cubic-bezier(.34, 1.56, .64, 1);
    box-shadow: 0 4px 14px rgba(236, 72, 153, .35);
}
.file-drop:hover::before {
    transform: scale(1.1) rotate(-8deg);
}
.file-drop.has-file::before {
    content: "✓";
    background: linear-gradient(135deg, var(--green), var(--teal));
    box-shadow: 0 4px 14px rgba(16, 185, 129, .4);
}
.file-drop input[type="file"] { display: none; }

.file-drop-text {
    flex: 1;
    min-width: 0;
}
.file-drop-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 2px;
    letter-spacing: -.01em;
}
.file-drop-hint {
    font-size: 11.5px;
    color: var(--text-3);
    letter-spacing: -.01em;
}
.file-drop.has-file .file-drop-name { color: #6ee7b7; }

/* ============================================================
   ACTION BAR
   ============================================================ */
.action-bar {
    grid-column: span 12;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    background: linear-gradient(155deg,
        rgba(255, 255, 255, .08),
        rgba(255, 255, 255, .03));
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 50px rgba(0, 0, 0, .4);
    position: sticky;
    bottom: 20px;
    z-index: 10;
    opacity: 0;
    animation: bentoIn .6s cubic-bezier(.22, 1, .36, 1) .4s forwards;
}
.action-hint {
    font-size: 13px;
    color: var(--text-3);
    display: flex;
    align-items: center;
    gap: 10px;
    letter-spacing: -.01em;
}
.action-hint .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 12px var(--amber);
    animation: pulse 2s ease-in-out infinite;
}

.btn-action {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 26px;
    border-radius: 100px;
    border: 1px solid var(--border-hi);
    background: var(--surface-2);
    color: var(--text);
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 700;
    letter-spacing: -.02em;
    cursor: pointer;
    text-decoration: none;
    transition: all .3s cubic-bezier(.34, 1.56, .64, 1);
    white-space: nowrap;
    position: relative;
    overflow: hidden;
}
.btn-action:hover {
    background: var(--surface-3);
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 16px 40px rgba(0, 0, 0, .4);
}
.btn-action.primary {
    background: linear-gradient(135deg, var(--pink), var(--purple), var(--violet));
    border-color: transparent;
    box-shadow: 0 12px 32px rgba(236, 72, 153, .4),
                inset 0 1px 0 rgba(255, 255, 255, .3);
    color: #fff;
}
.btn-action.primary::after {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 50%;
    background: linear-gradient(180deg, rgba(255, 255, 255, .25), transparent);
    border-radius: 100px 100px 0 0;
    pointer-events: none;
}
.btn-action.primary:hover {
    box-shadow: 0 20px 50px rgba(236, 72, 153, .6),
                inset 0 1px 0 rgba(255, 255, 255, .4);
}

/* ============================================================
   TOAST
   ============================================================ */
.toast-host {
    position: fixed;
    top: 100px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 360px;
}
.toast {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-radius: var(--radius-sm);
    background: rgba(20, 15, 40, .9);
    backdrop-filter: blur(24px);
    border: 1px solid var(--border-hi);
    color: var(--text);
    font-size: 13.5px;
    font-weight: 500;
    box-shadow: 0 20px 40px rgba(0, 0, 0, .5);
    animation: toastIn .35s cubic-bezier(.34, 1.56, .64, 1);
    position: relative;
    overflow: hidden;
    letter-spacing: -.01em;
}
.toast::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
}
.toast.success::before { background: linear-gradient(180deg, var(--green), var(--teal)); }
.toast.error::before   { background: linear-gradient(180deg, var(--red), var(--pink)); }
.toast.info::before    { background: linear-gradient(180deg, var(--purple), var(--violet)); }
.toast .ticon {
    width: 30px; height: 30px;
    border-radius: 10px;
    display: grid; place-items: center;
    font-size: 15px;
    font-weight: 700;
    flex-shrink: 0;
}
.toast.success .ticon { background: linear-gradient(135deg, var(--green), var(--teal)); color: #fff; }
.toast.error   .ticon { background: linear-gradient(135deg, var(--red), var(--pink)); color: #fff; }
.toast.info    .ticon { background: linear-gradient(135deg, var(--purple), var(--violet)); color: #fff; }
@keyframes toastIn {
    from { opacity: 0; transform: translateX(30px) scale(.9); }
    to   { opacity: 1; transform: translateX(0) scale(1); }
}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width: 1100px) {
    .bento { grid-template-columns: 1fr; }
    .sidebar-col { position: static; flex-direction: row; flex-wrap: wrap; }
    .profile-card, .docs-panel { flex: 1 1 340px; }
    .avatar-wrap { width: 110px; height: 110px; }
    .avatar-img { width: 100px; height: 100px; }
}
@media (max-width: 640px) {
    .page { padding: 20px 16px 80px; }
    .page-header h1 { font-size: 28px; }
    .topnav { padding: 0 12px; top: 8px; }
    .topnav-inner { padding: 10px 14px; }
    .brand-text .sub { display: none; }
    .action-bar { flex-direction: column; align-items: stretch; }
    .action-hint { justify-content: center; }
    .btn-action { justify-content: center; }
    .toast-host { top: 90px; right: 12px; left: 12px; max-width: none; }
    .sidebar-col { flex-direction: column; }
}
</style>
</head>
<body>

<!-- Blob background -->
<div class="blob-bg">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="blob blob-4"></div>
</div>

<!-- Top Nav -->
<div class="topnav">
    <div class="topnav-inner">
        <div class="brand">
            <div class="brand-logo">EIS</div>
            <div class="brand-text">
                <div class="title">Employee Portal</div>
                <div class="sub">Edit Profile</div>
            </div>
        </div>
        <div class="nav-right">
            <a href="<%=ctx%>/ViewEISRegistrationDetailsActionNew" class="btn-pill">
                ← Back
            </a>
        </div>
    </div>
</div>

<div class="page">

<% if (emp == null) { %>

    <div class="bento" style="grid-template-columns:1fr;">
        <div class="bento-card c-red" style="text-align:center; padding:80px 40px;">
            <div class="card-icon i-red" style="margin:0 auto 24px;width:80px;height:80px;font-size:36px;">⚠</div>
            <h2 class="card-title" style="font-size:24px;margin-bottom:12px;">Employee Not Found</h2>
            <p style="color:var(--text-3);margin-bottom:28px;">
                No employee exists with ID: <strong style="color:var(--pink);"><%=empid%></strong>
            </p>
            <a href="<%=ctx%>/ViewEISRegistrationDetailsActionNew" class="btn-action primary">Go to List</a>
        </div>
    </div>

<% } else { %>

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1>Hey, <%=fullName%> 👋</h1>
            <p class="subtitle">Let's update your profile. Every field is editable — make your changes and hit save.</p>
        </div>
        <div class="chips">
            <div class="chip">
                <span style="opacity:.7;">ID</span>
                <strong><%=emp.getM_strEmployee_ID()%></strong>
            </div>
            <div class="chip <%=active ? "active" : "inactive"%>">
                <span class="dot"></span>
                <%=active ? "Active" : "Inactive"%>
            </div>
        </div>
    </div>

    <form id="editForm" method="post" enctype="multipart/form-data">

    <div class="bento">

        <!-- ====================== SIDEBAR ====================== -->
        <div class="sidebar-col">

            <!-- Profile Card -->
            <div class="profile-card">
                <div class="avatar-wrap">
                    <div class="avatar-ring-3"></div>
                    <div class="avatar-ring-2"></div>
                    <div class="avatar-ring"></div>
                    <img id="profilePhoto" class="avatar-img"
                         src="<%=ctx%>/DocumentDownloadServlet?empid=<%=emp.getM_strEmployee_ID()%>&type=PHOTO&_t=<%=System.currentTimeMillis()%>"
                         alt="Profile"
                         onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><defs><linearGradient id=%22g%22 x1=%220%22 y1=%220%22 x2=%221%22 y2=%221%22><stop offset=%220%25%22 stop-color=%22%23ec4899%22/><stop offset=%22100%25%22 stop-color=%22%23a855f7%22/></linearGradient></defs><rect fill=%22url(%23g)%22 width=%22128%22 height=%22128%22/><text x=%2264%22 y=%2286%22 text-anchor=%22middle%22 font-size=%2264%22 font-weight=%22800%22 fill=%22white%22 font-family=%22sans-serif%22><%=initial%></text></svg>'"/>
                    <label class="avatar-overlay" for="photoInput">
                        <span class="icon">📷</span>
                        <span>Change Photo</span>
                    </label>
                    <input type="file" id="photoInput" name="m_strthePhotofile"
                           accept="image/*" style="display:none;" onchange="previewPhoto(this);"/>
                </div>

                <div class="profile-name"><%=fullName%></div>
                <div class="profile-role">
                    <%=emp.getM_strTeam() != null && !emp.getM_strTeam().isEmpty() ? emp.getM_strTeam() : "Team not set"%>
                </div>

                <div class="profile-quick">
                    <div class="quick-item">
                        <div class="label">AD ID</div>
                        <div class="value"><%=emp.getM_strAD_ID() != null && !emp.getM_strAD_ID().isEmpty() ? emp.getM_strAD_ID() : "—"%></div>
                    </div>
                    <div class="quick-item">
                        <div class="label">HID</div>
                        <div class="value"><%=emp.getM_strHID() != null && !emp.getM_strHID().isEmpty() ? emp.getM_strHID() : "—"%></div>
                    </div>
                    <div class="quick-item">
                        <div class="label">Asset</div>
                        <div class="value"><%=emp.getM_strAsset_ID() != null && !emp.getM_strAsset_ID().isEmpty() ? emp.getM_strAsset_ID() : "—"%></div>
                    </div>
                    <div class="quick-item">
                        <div class="label">Qualification</div>
                        <div class="value"><%=emp.getM_strEducation_Qualification() != null && !emp.getM_strEducation_Qualification().isEmpty() ? emp.getM_strEducation_Qualification() : "—"%></div>
                    </div>
                </div>
            </div>

            <!-- Documents -->
            <div class="docs-panel">
                <div class="docs-panel-head">
                    <div class="title">Your Documents</div>
                    <span class="count">
                        <%
                            int docCount = 0;
                            if (emp.getM_strBGC_Documents_Path() != null && !emp.getM_strBGC_Documents_Path().isEmpty()) docCount++;
                            if (emp.getM_strPolice_Verification_Path() != null && !emp.getM_strPolice_Verification_Path().isEmpty()) docCount++;
                            if (emp.getM_strCV_Document() != null && !emp.getM_strCV_Document().isEmpty()) docCount++;
                            out.print(docCount + " / 3");
                        %>
                    </span>
                </div>

                <div class="doc-row <%=emp.getM_strBGC_Documents_Path() != null && !emp.getM_strBGC_Documents_Path().isEmpty() ? "uploaded" : ""%>">
                    <div class="doc-icon">📄</div>
                    <div class="doc-info">
                        <div class="name">BGC Document</div>
                        <div class="status"><%=emp.getM_strBGC_Documents_Path() != null && !emp.getM_strBGC_Documents_Path().isEmpty() ? "Ready" : "Not uploaded"%></div>
                    </div>
                    <% if (emp.getM_strBGC_Documents_Path() != null && !emp.getM_strBGC_Documents_Path().isEmpty()) { %>
                        <button type="button" class="doc-view" onclick="openDocument('<%=emp.getM_strEmployee_ID()%>','BGC');" title="View">👁</button>
                    <% } %>
                </div>

                <div class="doc-row <%=emp.getM_strPolice_Verification_Path() != null && !emp.getM_strPolice_Verification_Path().isEmpty() ? "uploaded" : ""%>">
                    <div class="doc-icon">🛡️</div>
                    <div class="doc-info">
                        <div class="name">Police Verification</div>
                        <div class="status"><%=emp.getM_strPolice_Verification_Path() != null && !emp.getM_strPolice_Verification_Path().isEmpty() ? "Ready" : "Not uploaded"%></div>
                    </div>
                    <% if (emp.getM_strPolice_Verification_Path() != null && !emp.getM_strPolice_Verification_Path().isEmpty()) { %>
                        <button type="button" class="doc-view" onclick="openDocument('<%=emp.getM_strEmployee_ID()%>','POLICE');" title="View">👁</button>
                    <% } %>
                </div>

                <div class="doc-row <%=emp.getM_strCV_Document() != null && !emp.getM_strCV_Document().isEmpty() ? "uploaded" : ""%>">
                    <div class="doc-icon">📎</div>
                    <div class="doc-info">
                        <div class="name">CV Document</div>
                        <div class="status"><%=emp.getM_strCV_Document() != null && !emp.getM_strCV_Document().isEmpty() ? "Ready" : "Not uploaded"%></div>
                    </div>
                    <% if (emp.getM_strCV_Document() != null && !emp.getM_strCV_Document().isEmpty()) { %>
                        <button type="button" class="doc-view" onclick="openDocument('<%=emp.getM_strEmployee_ID()%>','CV');" title="View">👁</button>
                    <% } %>
                </div>
            </div>

        </div>

        <!-- ====================== BENTO CARDS ====================== -->
        <div class="bento-col">

            <!-- CARD 1: Identity -->
            <div class="bento-card c-pink tilt">
                <div class="card-head">
                    <div class="card-icon i-pink">🎯</div>
                    <div class="card-title-block">
                        <div class="card-title">Identity</div>
                        <div class="card-sub">Your unique identifiers</div>
                    </div>
                </div>
                <div class="fields-grid">
                    <div class="field">
                        <label class="field-label">Employee ID <span class="req">*</span></label>
                        <input class="field-input" type="text" name="m_stremployee_id"
                               value="<%=emp.getM_strEmployee_ID()%>" readonly/>
                    </div>
                    <div class="field">
                        <label class="field-label">AD ID</label>
                        <input class="field-input" type="text" name="m_strad_id"
                               value="<%=emp.getM_strAD_ID() != null ? emp.getM_strAD_ID() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">HID</label>
                        <input class="field-input" type="text" name="m_strhid"
                               value="<%=emp.getM_strHID() != null ? emp.getM_strHID() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">Asset ID</label>
                        <input class="field-input" type="text" name="m_strasset_id"
                               value="<%=emp.getM_strAsset_ID() != null ? emp.getM_strAsset_ID() : ""%>"/>
                    </div>
                </div>
            </div>

            <!-- CARD 2: Personal -->
            <div class="bento-card c-purple tilt">
                <div class="card-head">
                    <div class="card-icon i-purple">👤</div>
                    <div class="card-title-block">
                        <div class="card-title">Personal Information</div>
                        <div class="card-sub">Basic details about you</div>
                    </div>
                </div>
                <div class="fields-grid">
                    <div class="field">
                        <label class="field-label">First Name <span class="req">*</span></label>
                        <input class="field-input" type="text" name="m_strfirstName"

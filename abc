<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Team Roster &mdash; EIS Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

<style>
/* ============================================================
   DESIGN TOKENS
   ============================================================ */
:root{
  --gray-0:#FFFFFF; --gray-25:#FCFCFD; --gray-50:#F9FAFB; --gray-100:#F2F4F7;
  --gray-200:#EAECF0; --gray-300:#D0D5DD; --gray-400:#98A2B3; --gray-500:#667085;
  --gray-600:#475467; --gray-700:#344054; --gray-800:#1D2939; --gray-900:#101828;

  --accent:#635BFF; --accent-hover:#5249E0; --accent-soft:#EEF0FF; --accent-line:#C7CBFF;
  --success:#12B76A; --warning:#F79009; --danger:#F04438;

  /* Shift colors (light) — vivid */
  --m-bg:#FFE4CC; --m-fg:#8A2C00; --m-bd:#FFB380; --m-dot:#FF8C00;
  --d-bg:#E5E8EC; --d-fg:#1F2937; --d-bd:#B8BFC9; --d-dot:#696969;
  --a-bg:#FFF1B8; --a-fg:#7A4F00; --a-bd:#F5D45F; --a-dot:#DAA520;
  --n-bg:#CCE4FF; --n-fg:#003D80; --n-bd:#80B8FF; --n-dot:#1E90FF;
  --w-bg:#D6DCFF; --w-fg:#1E1E8A; --w-bd:#9BA5FF; --w-dot:#1E40AF;
  --l-bg:#FFD6D6; --l-fg:#8A0F0F; --l-bd:#FF9E9E; --l-dot:#DC2626;
  --f-bg:#FFD6EB; --f-fg:#8A0047; --f-bd:#FF9ECC; --f-dot:#EA580C;
  --h-bg:#C8F0D6; --h-fg:#0F5A2D; --h-bd:#8ADCA8; --h-dot:#16A34A;
  --x-bg:#EDEFF2; --x-fg:#667085; --x-bd:#D0D5DD; --x-dot:#98A2B3;

  --bg-page:var(--gray-50); --bg-surface:var(--gray-0); --bg-subtle:var(--gray-25);
  --border:var(--gray-200); --border-strong:var(--gray-300);
  --text-primary:var(--gray-900); --text-secondary:var(--gray-600); --text-tertiary:var(--gray-500);

  --radius-sm:6px; --radius-md:8px; --radius-lg:12px;

  --shadow-xs:0 1px 2px 0 rgba(16,24,40,.05);
  --shadow-sm:0 1px 3px 0 rgba(16,24,40,.10);
  --shadow-md:0 4px 8px -2px rgba(16,24,40,.10);
  --shadow-lg:0 12px 16px -4px rgba(16,24,40,.10);
  --shadow-xl:0 20px 24px -4px rgba(16,24,40,.15);

  --font:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,monospace;
}

html[data-theme="dark"]{
  --gray-0:#0B0E14; --gray-25:#10131A; --gray-50:#12161D; --gray-100:#171B23;
  --gray-200:#22262F; --gray-300:#2E333C; --gray-400:#5A6270; --gray-500:#8A94A6;
  --gray-600:#A6B0C2; --gray-700:#C4CCDA; --gray-800:#E1E6EF; --gray-900:#F5F7FA;

  --accent:#8B83FF; --accent-hover:#A29AFF; --accent-soft:#1E1B4B; --accent-line:#3730A3;

  --m-bg:#3A1D0A; --m-fg:#FDB022; --m-bd:#5C2C0F; --m-dot:#FB923C;
  --d-bg:#1A1E26; --d-fg:#A6B0C2; --d-bd:#2E333C; --d-dot:#9CA3AF;
  --a-bg:#3D2A05; --a-fg:#FDB022; --a-bd:#5C3F0F; --a-dot:#FBBF24;
  --n-bg:#0A2540; --n-fg:#53B1FD; --n-bd:#0F3A66; --n-dot:#60A5FA;
  --w-bg:#1E1B4B; --w-fg:#8B83FF; --w-bd:#3730A3; --w-dot:#818CF8;
  --l-bg:#3A1211; --l-fg:#F97066; --l-bd:#5A1A18; --l-dot:#F87171;
  --f-bg:#3D1030; --f-fg:#F670C7; --f-bd:#5E1A4A; --f-dot:#FB923C;
  --h-bg:#052E1F; --h-fg:#32D583; --h-bd:#0A5133; --h-dot:#4ADE80;
  --x-bg:#12161D; --x-fg:#5A6270; --x-bd:#22262F; --x-dot:#374151;

  --bg-page:var(--gray-50); --bg-surface:var(--gray-25); --bg-subtle:var(--gray-0);
  --border:var(--gray-200); --border-strong:var(--gray-300);
  --text-primary:var(--gray-900); --text-secondary:var(--gray-600); --text-tertiary:var(--gray-500);

  --shadow-xs:0 1px 2px 0 rgba(0,0,0,.4);
  --shadow-sm:0 1px 3px 0 rgba(0,0,0,.5);
  --shadow-md:0 4px 8px -2px rgba(0,0,0,.4);
  --shadow-lg:0 12px 16px -4px rgba(0,0,0,.5);
  --shadow-xl:0 20px 24px -4px rgba(0,0,0,.6);
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--font); font-size:14px; line-height:1.5;
  background:var(--bg-page); color:var(--text-primary);
  -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;
  transition:background-color .2s ease, color .2s ease;
  overflow-x:hidden;
}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}

/* ============ APP BAR ============ */
.appbar{
  position:sticky; top:0; z-index:100;
  background:var(--bg-surface);
  border-bottom:1px solid var(--border);
  height:56px;
  display:flex; align-items:center; padding:0 20px; gap:14px;
}
.appbar-logo{
  width:28px;height:28px;border-radius:7px;
  background:linear-gradient(135deg,var(--accent), #7A5CFF);
  display:grid;place-items:center;color:#fff;
}
.appbar-logo svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.4;}
.appbar-title{font-size:14px;font-weight:700;letter-spacing:-.2px;}
.appbar-title .crumb{color:var(--text-tertiary);font-weight:500;margin-left:4px;}
.appbar-spacer{flex:1;}
.appbar-actions{display:flex;align-items:center;gap:4px;}

.icon-btn{
  width:34px;height:34px;display:grid;place-items:center;
  border-radius:var(--radius-md); color:var(--text-secondary);
  transition:all .15s ease;
}
.icon-btn:hover{background:var(--bg-subtle); color:var(--text-primary);}
.icon-btn svg{
  width:17px;height:17px; stroke:currentColor; fill:none; stroke-width:1.8;
  stroke-linecap:round;stroke-linejoin:round;
}
.icon-btn .icon-sun{display:block;}
.icon-btn .icon-moon{display:none;}
html[data-theme="dark"] .icon-btn .icon-sun{display:none;}
html[data-theme="dark"] .icon-btn .icon-moon{display:block;}

.user-chip{
  display:flex; align-items:center; gap:7px;
  padding:4px 10px 4px 4px; border-radius:999px;
  border:1px solid var(--border); transition:all .15s ease;
  margin-left:4px;
}
.user-chip:hover{border-color:var(--border-strong); background:var(--bg-subtle);}
.user-chip .avatar{
  width:24px;height:24px;border-radius:50%;
  background:linear-gradient(135deg,var(--accent),#7A5CFF);
  color:#fff;display:grid;place-items:center;
  font-size:10px;font-weight:700;
}
.user-chip .name{font-size:12px;font-weight:600;}

/* ============ CONTEXT ROW ============ */
.context-row{
  background:var(--bg-surface); border-bottom:1px solid var(--border);
  padding:14px 20px; display:flex; align-items:center;
  justify-content:space-between; gap:16px; flex-wrap:wrap;
}
.context-left{display:flex; align-items:baseline; gap:16px; flex-wrap:wrap;}
.context-title{font-size:17px; font-weight:700; letter-spacing:-.3px;}
.context-title .accent{color:var(--accent);}
.context-meta{
  display:flex; align-items:center; gap:8px;
  font-size:12px; color:var(--text-tertiary); font-weight:500;
}
.context-meta b{color:var(--text-primary); font-weight:600;}
.context-meta .sep{width:3px;height:3px;border-radius:50%;background:var(--gray-300);}
.context-right{display:flex; align-items:center; gap:8px;}

.c-input{
  font-family:var(--font); font-size:13px; font-weight:500;
  color:var(--text-primary); background:var(--bg-surface);
  border:1px solid var(--border-strong); border-radius:var(--radius-md);
  padding:6px 10px; outline:none; transition:all .15s ease; height:34px;
}
.c-input:focus{
  border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft);
}

.btn{
  display:inline-flex; align-items:center; gap:6px;
  padding:6px 14px; font-family:var(--font); font-size:13px; font-weight:600;
  border-radius:var(--radius-md); border:1px solid transparent;
  transition:all .15s ease; height:34px; white-space:nowrap;
}
.btn svg{
  width:14px;height:14px; stroke:currentColor; fill:none; stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round;
}
.btn-primary{background:var(--accent); color:#fff;}
.btn-primary:hover{background:var(--accent-hover);}

/* ============ TOOLBAR ============ */
.toolbar{
  background:var(--bg-page); padding:12px 20px 10px;
  display:flex; justify-content:space-between; align-items:center;
  gap:12px; flex-wrap:wrap;
}
.toolbar-left{display:flex; align-items:center; gap:10px;}
.search-input{position:relative; display:flex; align-items:center; width:280px;}
.search-input svg{
  position:absolute; left:11px; width:14px;height:14px;
  stroke:var(--text-tertiary); fill:none; stroke-width:2; pointer-events:none;
}
.search-input input{
  width:100%; font-family:var(--font); font-size:13px; font-weight:500;
  background:var(--bg-surface); border:1px solid var(--border-strong);
  border-radius:var(--radius-md); padding:7px 12px 7px 32px;
  outline:none; color:var(--text-primary); transition:all .15s ease; height:34px;
}
.search-input input::placeholder{color:var(--text-tertiary);}
.search-input input:focus{
  border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-soft);
}

.stat-inline{
  display:inline-flex; align-items:center; gap:6px;
  padding:5px 10px; background:var(--bg-surface); border:1px solid var(--border);
  border-radius:var(--radius-md); font-size:12px; font-weight:500;
  color:var(--text-secondary); height:34px;
}
.stat-inline b{color:var(--text-primary); font-weight:700; font-variant-numeric:tabular-nums;}

/* ============ LEGEND BAR — HORIZONTAL ============ */
.legend-bar{
  background:var(--bg-surface); border-bottom:1px solid var(--border);
  padding:10px 20px; display:flex; align-items:center; gap:8px;
  overflow-x:auto; overflow-y:hidden; scrollbar-width:thin;
}
.legend-bar::-webkit-scrollbar{height:4px;}
.legend-bar::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:2px;}

.legend-label{
  flex-shrink:0; font-size:10px; font-weight:700;
  text-transform:uppercase; letter-spacing:.6px;
  color:var(--text-tertiary); padding-right:8px;
  border-right:1px solid var(--border); margin-right:4px; white-space:nowrap;
}

.legend-chip{
  flex-shrink:0; display:inline-flex; align-items:center; gap:6px;
  padding:5px 10px; border-radius:6px; font-size:11px; font-weight:700;
  border:1px solid; white-space:nowrap; transition:all .12s ease;
  font-variant-numeric:tabular-nums;
}
.legend-chip .swatch{width:8px;height:8px;border-radius:2px;flex-shrink:0;}

.legend-chip.morning  {background:var(--m-bg);color:var(--m-fg);border-color:var(--m-bd);}
.legend-chip.general  {background:var(--d-bg);color:var(--d-fg);border-color:var(--d-bd);}
.legend-chip.afternoon{background:var(--a-bg);color:var(--a-fg);border-color:var(--a-bd);}
.legend-chip.night    {background:var(--n-bg);color:var(--n-fg);border-color:var(--n-bd);}
.legend-chip.weekoff  {background:var(--w-bg);color:var(--w-fg);border-color:var(--w-bd);}
.legend-chip.leave    {background:var(--l-bg);color:var(--l-fg);border-color:var(--l-bd);}
.legend-chip.flexi    {background:var(--f-bg);color:var(--f-fg);border-color:var(--f-bd);}
.legend-chip.holiday  {background:var(--h-bg);color:var(--h-fg);border-color:var(--h-bd);}
.legend-chip.na       {background:var(--x-bg);color:var(--x-fg);border-color:var(--x-bd);}

/* ============ ROSTER GRID ============ */
.grid-wrap{padding:16px 20px 90px; overflow-x:auto;}
.roster-grid{
  width:100%; min-width:1200px;
  border-collapse:separate; border-spacing:0;
  background:var(--bg-surface);
  border:1px solid var(--border); border-radius:var(--radius-lg);
  overflow:hidden; font-size:13px;
}
.roster-grid thead th{
  position:sticky; top:0; z-index:10;
  background:var(--bg-subtle); padding:8px 6px;
  font-size:10px; font-weight:600; text-transform:uppercase;
  letter-spacing:.4px; color:var(--text-tertiary);
  border-bottom:1px solid var(--border);
  text-align:center; white-space:nowrap;
}
.roster-grid thead th .day-num{
  font-size:12px; font-weight:700; color:var(--text-primary);
  font-variant-numeric:tabular-nums;
}
.roster-grid thead th .day-name{
  display:block; font-size:9px; font-weight:600;
  color:var(--text-tertiary); margin-top:1px;
}
.roster-grid thead th.is-weekend{background:#FEF6EE; color:#C4320A;}
html[data-theme="dark"] .roster-grid thead th.is-weekend{background:#3A1D0A; color:#FDB022;}

.roster-grid thead th.col-emp{
  position:sticky; left:0; z-index:20; text-align:left; padding-left:16px;
  min-width:200px; background:var(--bg-subtle);
  box-shadow:1px 0 0 var(--border);
}
.roster-grid thead th.col-pos{
  position:sticky; left:200px; z-index:20; text-align:left;
  min-width:110px; background:var(--bg-subtle);
  box-shadow:1px 0 0 var(--border);
}
.roster-grid thead th.col-sum{min-width:44px; font-variant-numeric:tabular-nums;}

.roster-grid tbody td{
  padding:0; border-bottom:1px solid var(--border);
  vertical-align:middle; background:var(--bg-surface);
}
.roster-grid tbody tr:last-child td{border-bottom:none;}
.roster-grid tbody tr:hover td{background:var(--bg-subtle);}
.roster-grid tbody td.col-emp{
  position:sticky; left:0; z-index:5;
  padding:7px 14px 7px 16px; background:var(--bg-surface);
  box-shadow:1px 0 0 var(--border);
}
.roster-grid tbody tr:hover td.col-emp{background:var(--bg-subtle);}
.emp-row{display:flex; align-items:center; gap:9px;}
.emp-avatar{
  width:26px;height:26px;border-radius:50%;
  background:var(--gray-200); color:var(--text-secondary);
  display:grid;place-items:center;
  font-size:10px; font-weight:700; flex-shrink:0;
  border:1px solid var(--border);
}
.emp-name{
  font-size:13px; font-weight:600; color:var(--text-primary);
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis; line-height:1.2;
}
.emp-id{
  font-size:10px; color:var(--text-tertiary);
  font-family:var(--mono); margin-top:1px;
}
.roster-grid tbody td.col-pos{
  position:sticky; left:200px; z-index:5;
  padding:7px 10px; background:var(--bg-surface);
  box-shadow:1px 0 0 var(--border);
  font-size:12px; font-weight:500; color:var(--text-secondary);
  white-space:nowrap;
}
.roster-grid tbody tr:hover td.col-pos{background:var(--bg-subtle);}

/* ============ SHIFT CELL ============ */
.shift-cell{
  position:relative;
  padding:3px !important;
}
.shift-btn{
  display:flex; align-items:center; justify-content:center;
  width:100%; height:30px;
  border-radius:5px; font-size:10px; font-weight:800;
  letter-spacing:.2px; border:1.5px solid;
  font-variant-numeric:tabular-nums;
  transition:all .12s ease;
  cursor:pointer;
  box-shadow:inset 0 -1px 0 rgba(0,0,0,.05);
}
.shift-btn:hover{
  transform:translateY(-1px);
  box-shadow:var(--shadow-sm);
}
.shift-btn.morning  {background:var(--m-bg);color:var(--m-fg);border-color:var(--m-bd);}
.shift-btn.general  {background:var(--d-bg);color:var(--d-fg);border-color:var(--d-bd);}
.shift-btn.afternoon{background:var(--a-bg);color:var(--a-fg);border-color:var(--a-bd);}
.shift-btn.night    {background:var(--n-bg);color:var(--n-fg);border-color:var(--n-bd);}
.shift-btn.weekoff  {background:var(--w-bg);color:var(--w-fg);border-color:var(--w-bd);}
.shift-btn.leave    {background:var(--l-bg);color:var(--l-fg);border-color:var(--l-bd);}
.shift-btn.flexi    {background:var(--f-bg);color:var(--f-fg);border-color:var(--f-bd);}
.shift-btn.holiday  {background:var(--h-bg);color:var(--h-fg);border-color:var(--h-bd);}
.shift-btn.na       {background:var(--x-bg);color:var(--x-fg);border-color:var(--x-bd);}

/* Hidden native select (for form submission) */
.shift-cell select.shift-hidden{
  position:absolute;
  opacity:0;
  pointer-events:none;
  width:1px;height:1px;
  top:0;left:0;
  border:none;
  padding:0;
}

/* ============ CUSTOM DROPDOWN ============ */
.dropdown-menu{
  position:fixed;
  z-index:9999;
  background:var(--bg-surface);
  border:1px solid var(--border-strong);
  border-radius:var(--radius-md);
  box-shadow:var(--shadow-xl);
  padding:4px;
  min-width:180px;
  max-height:400px;
  overflow-y:auto;
  display:none;
  animation:ddFade .12s ease;
}
@keyframes ddFade{
  from{opacity:0;transform:translateY(-2px);}
  to{opacity:1;transform:translateY(0);}
}
.dropdown-menu.open{display:block;}

.dropdown-menu::-webkit-scrollbar{width:6px;}
.dropdown-menu::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:3px;}

.dd-item{
  display:flex;
  align-items:center;
  gap:10px;
  padding:8px 10px;
  border-radius:var(--radius-sm);
  font-family:var(--font);
  font-size:12px;
  font-weight:700;
  cursor:pointer;
  transition:all .1s ease;
  border:1px solid transparent;
  white-space:nowrap;
}
.dd-item:hover{
  transform:translateX(2px);
  box-shadow:var(--shadow-sm);
}
.dd-item.selected{
  box-shadow:inset 0 0 0 2px var(--accent);
}

.dd-dot{
  width:10px;height:10px;border-radius:3px;flex-shrink:0;
}

/* Dropdown item colors — vivid, same as badge */
.dd-item.morning  {background:var(--m-bg);color:var(--m-fg);border-color:var(--m-bd);}
.dd-item.morning .dd-dot{background:var(--m-dot);}
.dd-item.general  {background:var(--d-bg);color:var(--d-fg);border-color:var(--d-bd);}
.dd-item.general .dd-dot{background:var(--d-dot);}
.dd-item.afternoon{background:var(--a-bg);color:var(--a-fg);border-color:var(--a-bd);}
.dd-item.afternoon .dd-dot{background:var(--a-dot);}
.dd-item.night    {background:var(--n-bg);color:var(--n-fg);border-color:var(--n-bd);}
.dd-item.night .dd-dot{background:var(--n-dot);}
.dd-item.weekoff  {background:var(--w-bg);color:var(--w-fg);border-color:var(--w-bd);}
.dd-item.weekoff .dd-dot{background:var(--w-dot);}
.dd-item.leave    {background:var(--l-bg);color:var(--l-fg);border-color:var(--l-bd);}
.dd-item.leave .dd-dot{background:var(--l-dot);}
.dd-item.flexi    {background:var(--f-bg);color:var(--f-fg);border-color:var(--f-bd);}
.dd-item.flexi .dd-dot{background:var(--f-dot);}
.dd-item.holiday  {background:var(--h-bg);color:var(--h-fg);border-color:var(--h-bd);}
.dd-item.holiday .dd-dot{background:var(--h-dot);}
.dd-item.na       {background:var(--x-bg);color:var(--x-fg);border-color:var(--x-bd);}
.dd-item.na .dd-dot{background:var(--x-dot);}

/* ============ SUMMARY ROWS ============ */
.summary-row td{
  background:var(--bg-subtle) !important;
  padding:5px 6px !important;
  font-size:11px; font-weight:700; color:var(--text-primary);
  font-variant-numeric:tabular-nums;
  border-top:1px solid var(--border); text-align:center;
}
.summary-row td.col-emp{
  background:var(--bg-subtle) !important;
  font-size:10px; font-weight:600;
  text-transform:uppercase; letter-spacing:.4px;
  color:var(--text-tertiary); text-align:left;
  padding-left:16px !important;
}
.summary-row td.col-pos{background:var(--bg-subtle) !important;}
.summary-row .pill{
  display:inline-flex; align-items:center; justify-content:center;

<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="java.sql.*,java.time.LocalTime,java.time.LocalDate,java.util.Date"%>
<%@page import="java.util.*,java.text.*"%>
<%@page import="com.jdbc.DBUtilityAuto"%>
<%
    // ✅ Session check
    if(session == null || session.getAttribute("role") == null) {
        response.sendRedirect(request.getContextPath() + "/login.action");
        return;
    }

    // ✅ Cache headers
    response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate, private");
    response.setHeader("Pragma", "no-cache");
    response.setDateHeader("Expires", 0);

    Timestamp startTs = null;
    Timestamp endTs = null;
    Timestamp snappedStartTs = null;
    Timestamp snappedEndTs = null;
    String runTimeDisplay = "No data";
    String fromDateTime = "";
    String toDateTime = "";
    String flagStatus = "DR";
    boolean fallbackApplied = false;
    int slotsIncluded = 0;

    Map<String, String> brokerMapping = new HashMap<>();
    Map<String, String> portMapping = new HashMap<>();
    Map<String, List<String>> brokerIPMapping = new HashMap<>();
    List<Map<String, Object>> brokerDataList = new ArrayList<>();
    List<Map<String, String>> impactedServersList = new ArrayList<>();
    List<Map<String, String>> isolatedServersList = new ArrayList<>();
    Map<String, List<String>> criticalServersByBroker = new LinkedHashMap<>();

    int totalBrokers = 0;
    int criticalBrokers = 0;
    int warningBrokers = 0;
    int healthyBrokers = 0;
    int isolatedBrokersCount = 0;
    int totalServers = 0;
    int impactedServers = 0;
    int isolatedServers = 0;

    Connection reportConn = null;
    try {
        reportConn = DBUtilityAuto.getReportDBConnection();

        String fromParam = request.getParameter("fromDateTime");
        String toParam = request.getParameter("toDateTime");

        if (fromParam == null || toParam == null || fromParam.trim().isEmpty() || toParam.trim().isEmpty()) {
            String latestSql = "SELECT MAX(RUN_START) AS MAX_START FROM EXP_BROKER_HOURLY_STATS";
            try (Statement stmt = reportConn.createStatement();
                 ResultSet rs = stmt.executeQuery(latestSql)) {
                if (rs.next()) {
                    Timestamp maxStart = rs.getTimestamp("MAX_START");
                    if (maxStart != null) {
                        Calendar cal = Calendar.getInstance();
                        cal.setTime(maxStart);
                        cal.add(Calendar.HOUR_OF_DAY, 1);
                        startTs = maxStart;
                        endTs = new Timestamp(cal.getTimeInMillis());
                    }
                }
            }
            if (startTs == null) {
                Calendar cal = Calendar.getInstance();
                cal.set(Calendar.MINUTE, 0);
                cal.set(Calendar.SECOND, 0);
                cal.set(Calendar.MILLISECOND, 0);
                endTs = new Timestamp(cal.getTimeInMillis());
                cal.add(Calendar.HOUR_OF_DAY, -1);
                startTs = new Timestamp(cal.getTimeInMillis());
            }
        } else {
            try {
                SimpleDateFormat isoFmt = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm");
                java.util.Date startDate = isoFmt.parse(fromParam.trim());
                java.util.Date endDate = isoFmt.parse(toParam.trim());
                startTs = new Timestamp(startDate.getTime());
                endTs = new Timestamp(endDate.getTime());
                if (endTs.before(startTs) || endTs.equals(startTs)) {
                    Calendar calFix = Calendar.getInstance();
                    calFix.setTime(endTs);
                    calFix.add(Calendar.HOUR_OF_DAY, 1);
                    endTs = new Timestamp(calFix.getTimeInMillis());
                }
            } catch (ParseException pe) {
                Calendar cal = Calendar.getInstance();
                cal.set(Calendar.MINUTE, 0);
                cal.set(Calendar.SECOND, 0);
                cal.set(Calendar.MILLISECOND, 0);
                endTs = new Timestamp(cal.getTimeInMillis());
                cal.add(Calendar.HOUR_OF_DAY, -1);
                startTs = new Timestamp(cal.getTimeInMillis());
            }
        }

        // Snap to 10-min
        Calendar snapStart = Calendar.getInstance();
        snapStart.setTime(startTs);
        snapStart.set(Calendar.MINUTE, (snapStart.get(Calendar.MINUTE) / 10) * 10);
        snapStart.set(Calendar.SECOND, 0);
        snapStart.set(Calendar.MILLISECOND, 0);
        snappedStartTs = new Timestamp(snapStart.getTimeInMillis());

        Calendar snapEnd = Calendar.getInstance();
        snapEnd.setTime(endTs);
        snapEnd.set(Calendar.MINUTE, (snapEnd.get(Calendar.MINUTE) / 10) * 10);
        snapEnd.set(Calendar.SECOND, 0);
        snapEnd.set(Calendar.MILLISECOND, 0);
        snappedEndTs = new Timestamp(snapEnd.getTimeInMillis());

        if (!snappedEndTs.after(snappedStartTs)) {
            Calendar c = Calendar.getInstance();
            c.setTime(snappedEndTs);
            c.add(Calendar.MINUTE, 10);
            snappedEndTs = new Timestamp(c.getTimeInMillis());
        }

        SimpleDateFormat displayFmt = new SimpleDateFormat("dd-MM-yyyy HH:mm");
        runTimeDisplay = displayFmt.format(new Date(snappedStartTs.getTime())) + " to " + displayFmt.format(new Date(snappedEndTs.getTime()));

        // Broker mapping
        try (Statement stmt = reportConn.createStatement();
             ResultSet rs = stmt.executeQuery("SELECT BROKER_NAME, EXP_PORT, MAPPED_PORT FROM EXP_BROKER_PORT_MAPPING")) {
            while (rs.next()) {
                String broker = rs.getString("BROKER_NAME");
                String expPort = rs.getString("EXP_PORT");
                String mappedPort = rs.getString("MAPPED_PORT");
                if (broker != null && expPort != null && mappedPort != null) {
                    brokerMapping.put(broker.trim(), expPort.trim());
                    portMapping.put(broker.trim(), mappedPort.trim());
                }
            }
        }

        // Flag status
        try (Statement stmt = reportConn.createStatement();
             ResultSet rs = stmt.executeQuery("SELECT FLAG FROM connection_master")) {
            if (rs.next()) {
                flagStatus = rs.getString("FLAG");
                if (flagStatus == null) flagStatus = "DR";
            }
        }

        // IP mapping
        try (Statement stmt = reportConn.createStatement();
             ResultSet rs = stmt.executeQuery("SELECT DISTINCT a.EXP_IP, a.BROKER_NAME FROM EXP_IP_BROKER_DETAILS a ORDER BY a.BROKER_NAME, a.EXP_IP")) {
            while (rs.next()) {
                String broker = rs.getString("BROKER_NAME");
                String ip = rs.getString("EXP_IP");
                if (broker == null || ip == null) continue;
                broker = broker.trim(); ip = ip.trim();
                boolean include = false;
                if ("PR".equals(flagStatus)) {
                    include = ip.startsWith("10.188.24.") || ip.startsWith("10.188.25.");
                } else if ("DR".equals(flagStatus)) {
                    include = ip.startsWith("10.177.40.") || ip.startsWith("10.177.41.");
                }
                if (include) brokerIPMapping.computeIfAbsent(broker, k -> new ArrayList<>()).add(ip);
            }
            for (List<String> ips : brokerIPMapping.values()) {
                Collections.sort(ips, (ip1, ip2) -> {
                    try {
                        return Integer.compare(Integer.parseInt(ip1.split("\\.")[3]), Integer.parseInt(ip2.split("\\.")[3]));
                    } catch (Exception e) { return ip1.compareTo(ip2); }
                });
            }
        }

        // Broker stats
        String brokerStatsSQL = "SELECT BROKER, PORT, " +
            "SUM(TOTAL_HITS) AS TOTAL_HITS, " +
            "SUM(HEALTHY_SERVERS) AS HEALTHY_SERVERS, " +
            "SUM(WARNING_SERVERS) AS WARNING_SERVERS, " +
            "SUM(CRITICAL_SERVERS) AS CRITICAL_SERVERS, " +
            "SUM(ISOLATED_SERVERS) AS ISOLATED_SERVERS, " +
            "MAX(TOTAL_SERVERS) AS TOTAL_SERVERS, " +
            "COUNT(*) AS SLOT_COUNT " +
            "FROM EXP_BROKER_HOURLY_STATS WHERE RUN_START >= ? AND RUN_START <= ? " +
            "GROUP BY BROKER, PORT ORDER BY BROKER";

        try (PreparedStatement ps = reportConn.prepareStatement(brokerStatsSQL)) {
            ps.setTimestamp(1, snappedStartTs);
            ps.setTimestamp(2, snappedEndTs);
            try (ResultSet rs = ps.executeQuery()) {
                while (rs.next()) {
                    Map<String, Object> brokerData = new HashMap<>();
                    String broker = rs.getString("BROKER");
                    String port = rs.getString("PORT");
                    int totalHits = rs.getInt("TOTAL_HITS");
                    int healthy = rs.getInt("HEALTHY_SERVERS");
                    int warning = rs.getInt("WARNING_SERVERS");
                    int critical = rs.getInt("CRITICAL_SERVERS");
                    int isolated = rs.getInt("ISOLATED_SERVERS");
                    int totalServersRow = rs.getInt("TOTAL_SERVERS");
                    int slotCount = rs.getInt("SLOT_COUNT");

                    String status;
                    if (critical > 0) status = "critical";
                    else if (warning > 0) status = "warning";
                    else if (isolated > 0) status = "isolated";
                    else status = "healthy";

                    List<String> ipList = brokerIPMapping.getOrDefault(broker, new ArrayList<>());
                    brokerData.put("broker", broker);
                    brokerData.put("port", port);
                    brokerData.put("totalHits", totalHits);
                    brokerData.put("brokerStatus", status);
                    brokerData.put("healthyCount", healthy);
                    brokerData.put("warningCount", warning);
                    brokerData.put("criticalCount", critical);
                    brokerData.put("isolatedCount", isolated);
                    brokerData.put("serverCount", totalServersRow);
                    brokerData.put("ipList", ipList);
                    brokerData.put("slotCount", slotCount);
                    brokerDataList.add(brokerData);
                }
            }
        }

        if (!brokerDataList.isEmpty()) slotsIncluded = (Integer) brokerDataList.get(0).get("slotCount");

        // Impacted servers
        Map<String, Map<String, String>> allServerStats = new HashMap<>();
        String impactedSQL = "SELECT BROKER, IP, SUM(HITS) AS HITS, MAX(STATUS) AS STATUS " +
            "FROM EXP_IMPACTED_SERVERS_HOURLY WHERE RUN_START >= ? AND RUN_START <= ? " +
            "GROUP BY BROKER, IP ORDER BY BROKER, IP";

        try (PreparedStatement ps = reportConn.prepareStatement(impactedSQL)) {
            ps.setTimestamp(1, snappedStartTs);
            ps.setTimestamp(2, snappedEndTs);
            try (ResultSet rs = ps.executeQuery()) {
                while (rs.next()) {
                    String broker = rs.getString("BROKER");
                    String ip = rs.getString("IP");
                    int hits = rs.getInt("HITS");
                    String status = rs.getString("STATUS");

                    String key = broker + "|" + ip;
                    Map<String, String> stats = new HashMap<>();
                    stats.put("hits", String.valueOf(hits));
                    stats.put("status", status);
                    allServerStats.put(key, stats);

                    Map<String, String> server = new HashMap<>();
                    server.put("broker", broker);
                    server.put("ip", ip);
                    server.put("displayIP", ip.split("\\.")[2] + "." + ip.split("\\.")[3]);
                    server.put("hits", String.valueOf(hits));
                    server.put("status", status);

                    if ("isolated".equals(status)) {
                        isolatedServersList.add(server);
                    } else if ("critical".equals(status) || "warning".equals(status)) {
                        impactedServersList.add(server);
                        if ("critical".equals(status)) {
                            criticalServersByBroker.computeIfAbsent(broker, k -> new ArrayList<>()).add(server.get("displayIP"));
                        }
                    }
                }
            }
        }

        // Attach server list to broker data
        for (Map<String, Object> brokerData : brokerDataList) {
            String broker = (String) brokerData.get("broker");
            List<String> ipList = (List<String>) brokerData.get("ipList");
            List<Map<String, String>> serverList = new ArrayList<>();
            for (String ip : ipList) {
                String key = broker + "|" + ip;
                Map<String, String> stats = allServerStats.get(key);
                String status = "healthy";
                String hits = "0";
                if (stats != null) {
                    status = stats.get("status");
                    hits = stats.get("hits");
                }
                Map<String, String> serverInfo = new HashMap<>();
                serverInfo.put("ip", ip);
                serverInfo.put("displayIP", ip.split("\\.")[2] + "." + ip.split("\\.")[3]);
                serverInfo.put("status", status);
                serverInfo.put("hits", hits);
                serverList.add(serverInfo);
            }
            brokerData.put("serverList", serverList);
        }

        // Sort brokers
        brokerDataList.sort((a, b) -> {
            String statusA = (String) a.get("brokerStatus");
            String statusB = (String) b.get("brokerStatus");
            int priorityA = statusA.equals("isolated") ? 0 : statusA.equals("critical") ? 1 : statusA.equals("warning") ? 2 : 3;
            int priorityB = statusB.equals("isolated") ? 0 : statusB.equals("critical") ? 1 : statusB.equals("warning") ? 2 : 3;
            if (priorityA != priorityB) return Integer.compare(priorityA, priorityB);
            return Integer.compare((Integer) b.get("totalHits"), (Integer) a.get("totalHits"));
        });

        totalBrokers = brokerDataList.size();
        criticalBrokers = 0; warningBrokers = 0; healthyBrokers = 0; isolatedBrokersCount = 0;
        impactedServers = impactedServersList.size();
        isolatedServers = isolatedServersList.size();

        Set<String> uniqueIPs = new HashSet<>();
        for (List<String> ips : brokerIPMapping.values()) uniqueIPs.addAll(ips);
        totalServers = uniqueIPs.size();

        for (Map<String, Object> bd : brokerDataList) {
            String status = (String) bd.get("brokerStatus");
            if ("critical".equals(status)) criticalBrokers++;
            else if ("warning".equals(status)) warningBrokers++;
            else if ("isolated".equals(status)) isolatedBrokersCount++;
            else if ("healthy".equals(status)) healthyBrokers++;
        }

        // Date format for inputs
        SimpleDateFormat inputFmt = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm");
        fromDateTime = inputFmt.format(new Date(snappedStartTs.getTime()));
        toDateTime = inputFmt.format(new Date(snappedEndTs.getTime()));

    } catch (Exception e) {
        e.printStackTrace();
    } finally {
        if (reportConn != null) try { reportConn.close(); } catch (SQLException e) {}
    }

    // ✅ FIXED: jsBrokerMap — simple, no setLength, no errors
    StringBuilder jsBrokerMap = new StringBuilder();
    if (criticalServersByBroker != null && !criticalServersByBroker.isEmpty()) {
        int brokerIndex = 0;
        for (Map.Entry<String, List<String>> entry : criticalServersByBroker.entrySet()) {
            if (brokerIndex > 0) jsBrokerMap.append(",");
            String broker = entry.getKey();
            broker = broker.replace("\\", "\\\\").replace("'", "\\'").replace("\"", "&quot;");
            jsBrokerMap.append("\"").append(broker).append("\":[");
            List<String> ips = entry.getValue();
            for (int i = 0; i < ips.size(); i++) {
                if (i > 0) jsBrokerMap.append(",");
                String ip = ips.get(i);
                ip = ip.replace("\\", "\\\\").replace("'", "\\'").replace("\"", "&quot;");
                jsBrokerMap.append("\"").append(ip).append("\"");
            }
            jsBrokerMap.append("]");
            brokerIndex++;
        }
    }
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EXP Broker Monitor</title>
    <link rel="stylesheet" href="<%=request.getContextPath()%>/css/expsys-all.min.css">
    <style>
        :root, [data-theme="light"] {
            --primary: #F86F03; --primary-dark: #E85D00; --primary-light: #FFA41B;
            --success: #10b981; --warning: #f59e0b; --danger: #ef4444;
            --isolated: #8b5cf6; --info: #0ea5e9;
            --bg-card: #ffffff; --bg-elevated: #f8fafc; --bg-hover: #f1f5f9; --bg-footer: #f8fafc;
            --text-primary: #0f172a; --text-secondary: #334155; --text-muted: #64748b; --text-faint: #94a3b8;
            --border: #e2e8f0; --border-strong: #cbd5e1;
            --shadow-sm: 0 1px 3px 0 rgba(15, 23, 42, 0.08);
            --shadow-md: 0 4px 12px -2px rgba(15, 23, 42, 0.12);
            --shadow-lg: 0 12px 28px -6px rgba(15, 23, 42, 0.16);
            --scrollbar-track: #f1f5f9; --scrollbar-thumb: #cbd5e1;
        }
        [data-theme="dark"] {
            --primary: #FF9A3D; --primary-dark: #F86F03; --primary-light: #FFA41B;
            --success: #34d399; --warning: #fbbf24; --danger: #f87171;
            --isolated: #a78bfa; --info: #38bdf8;
            --bg-card: #1e293b; --bg-elevated: #293548; --bg-hover: #334155; --bg-footer: #172032;
            --text-primary: #f1f5f9; --text-secondary: #cbd5e1; --text-muted: #94a3b8; --text-faint: #64748b;
            --border: #334155; --border-strong: #475569;
            --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.4);
            --shadow-md: 0 4px 12px -2px rgba(0, 0, 0, 0.5);
            --shadow-lg: 0 12px 28px -6px rgba(0, 0, 0, 0.6);
            --scrollbar-track: #1e293b; --scrollbar-thumb: #475569;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg); color: var(--text-primary);
            line-height: 1.4; font-size: 17px; overflow-x: hidden;
        }

        .exp-content { padding: 20px 24px 40px; max-width: 100%; width: 100%; }

        /* TOPBAR */
        .topbar {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 14px; padding: 0.7rem 1.25rem;
            display: flex; align-items: center; justify-content: space-between;
            gap: 1rem; flex-wrap: wrap; box-shadow: var(--shadow-sm); margin-bottom: 16px;
        }
        .brand { display: flex; align-items: center; gap: 0.7rem; flex-shrink: 0; }
        .brand-logo {
            width: 38px; height: 38px; border-radius: 10px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white; display: flex; align-items: center; justify-content: center;
            font-size: 1rem; box-shadow: 0 4px 12px rgba(248, 111, 3, 0.35);
        }
        .brand-title { font-size: 1.15rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
        .brand-sub { font-size: 0.78rem; color: var(--text-muted); font-weight: 500; margin-top: 2px; }

        .topbar-center { display: flex; align-items: center; gap: 0.55rem; flex: 1; justify-content: center; flex-wrap: wrap; }

        .pill {
            display: inline-flex; align-items: center; gap: 0.45rem;
            padding: 0.45rem 0.9rem; border-radius: 999px;
            font-size: 0.85rem; font-weight: 700;
            background: var(--bg-elevated); border: 1px solid var(--border);
            color: var(--text-secondary); white-space: nowrap;
        }
        .pill.timer { background: rgba(248, 111, 3, 0.12); color: var(--primary); border-color: rgba(248, 111, 3, 0.35); }
        .pill.timer.warning-state { background: rgba(245, 158, 11, 0.15); color: var(--warning); border-color: rgba(245, 158, 11, 0.5); }
        .pill.pr { background: rgba(16, 185, 129, 0.14); color: var(--success); border-color: rgba(16, 185, 129, 0.4); }
        .pill.dr { background: rgba(139, 92, 246, 0.14); color: var(--isolated); border-color: rgba(139, 92, 246, 0.4); }

        .topbar-actions { display: flex; align-items: center; gap: 0.45rem; flex-shrink: 0; }
        .icon-btn {
            width: 38px; height: 38px; border-radius: 10px;
            background: var(--bg-elevated); border: 1px solid var(--border);
            color: var(--text-secondary); display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: all 0.2s ease; font-size: 0.9rem;
        }
        .icon-btn:hover {
            background: var(--primary); color: white; border-color: var(--primary);
            transform: translateY(-2px); box-shadow: 0 4px 12px rgba(248, 111, 3, 0.35);
        }

        /* STATS */
        .stats-bar {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 14px; padding: 0.7rem 1rem;
            display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 0.6rem; margin-bottom: 16px; box-shadow: var(--shadow-sm);
        }
        .stat-mini {
            display: flex; align-items: center; gap: 0.7rem;
            padding: 0.55rem 0.8rem; border-radius: 0.7rem;
            background: var(--bg-elevated); border: 1px solid var(--border);
            border-left: 4px solid var(--primary); min-width: 0;
        }
        .stat-mini:hover { background: var(--bg-hover); transform: translateY(-2px); }
        .stat-mini.critical { border-left-color: var(--danger); }
        .stat-mini.warning { border-left-color: var(--warning); }
        .stat-mini.healthy { border-left-color: var(--success); }
        .stat-mini.isolated { border-left-color: var(--isolated); }
        .stat-mini.info { border-left-color: var(--info); }
        .stat-mini-icon {
            width: 36px; height: 36px; border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.9rem; color: white; flex-shrink: 0;
            background: var(--primary); box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }
        .stat-mini.info .stat-mini-icon { background: var(--info); }
        .stat-mini.critical .stat-mini-icon { background: var(--danger); }
        .stat-mini.warning .stat-mini-icon { background: var(--warning); }
        .stat-mini.healthy .stat-mini-icon { background: var(--success); }
        .stat-mini.isolated .stat-mini-icon { background: var(--isolated); }
        .stat-mini-text { display: flex; flex-direction: column; min-width: 0; }
        .stat-mini-value { font-size: 1.3rem; font-weight: 800; line-height: 1; }
        .stat-mini-label { font-size: 0.72rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 2px; }

        /* MAIN */
        .main-content {
            display: grid; grid-template-columns: 380px minmax(0, 1fr);
            gap: 16px; align-items: start; width: 100%;
        }
        .left-panel { display: flex; flex-direction: column; gap: 0.85rem; min-width: 0; }
        .right-panel { min-width: 0; }

        .card {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 0.85rem; box-shadow: var(--shadow-sm); overflow: hidden;
        }

        /* TIME FILTER */
        .time-filter-header {
            padding: 0.8rem 1rem; display: flex; justify-content: space-between; align-items: center;
            cursor: pointer; background: var(--bg-elevated);
        }
        .time-filter-header:hover { background: var(--bg-hover); }
        .time-filter-title { font-size: 0.95rem; font-weight: 800; display: flex; align-items: center; gap: 0.5rem; }
        .time-filter-title i { color: var(--primary); }
        .time-filter-toggle { color: var(--text-muted); transition: transform 0.3s ease; font-size: 0.85rem; }
        .time-filter-toggle.expanded { transform: rotate(180deg); }
        .time-filter-content { display: none; padding: 1rem; border-top: 1px solid var(--border); }
        .time-filter-content.expanded { display: block; }
        .time-filter-form { display: flex; flex-direction: column; gap: 0.7rem; }
        .time-filter-group { display: flex; flex-direction: column; gap: 0.35rem; }
        .time-filter-label { font-size: 0.82rem; font-weight: 700; color: var(--text-secondary); }
        .time-filter-input {
            padding: 0.55rem 0.7rem; border: 1px solid var(--border-strong);
            border-radius: 0.5rem; font-size: 0.9rem;
            background: var(--bg-card); color: var(--text-primary); font-family: inherit; width: 100%;
        }
        .time-filter-input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(248, 111, 3, 0.15); }
        .time-filter-actions { display: flex; gap: 0.45rem; }
        .time-filter-actions .btn { flex: 1; justify-content: center; }
        .quick-filter-buttons { display: flex; gap: 0.35rem; margin-top: 0.7rem; flex-wrap: wrap; }
        .quick-filter-btn {
            background: var(--bg-elevated); color: var(--text-secondary);
            border: 1px solid var(--border-strong); padding: 0.45rem 0.7rem;
            border-radius: 0.5rem; font-weight: 700; cursor: pointer;
            transition: all 0.2s; font-size: 0.8rem; font-family: inherit; flex: 1; min-width: 0;
        }
        .quick-filter-btn:hover { background: var(--bg-hover); border-color: var(--primary); color: var(--primary); }
        .quick-filter-btn.active { background: var(--primary); color: white; border-color: var(--primary); }

        /* BUTTONS */
        .btn {
            background: var(--bg-elevated); color: var(--text-secondary);
            border: 1px solid var(--border-strong); padding: 0.55rem 1rem;
            border-radius: 0.5rem; font-weight: 700; cursor: pointer;
            transition: all 0.2s; font-size: 0.87rem;
            display: inline-flex; align-items: center; gap: 0.45rem;
            font-family: inherit; white-space: nowrap;
        }
        .btn:hover { background: var(--bg-hover); border-color: var(--primary); color: var(--primary); transform: translateY(-1px); }
        .btn.primary { background: var(--primary); color: white; border-color: var(--primary); }
        .btn.primary:hover { background: var(--primary-dark); color: white; }
        .btn.isolated { background: var(--isolated); color: white; border-color: var(--isolated); }
        .btn.success { background: var(--success); color: white; border-color: var(--success); }
        .controls-row { display: flex; gap: 0.45rem; flex-wrap: wrap; padding: 0.7rem; }
        .controls-row .btn { flex: 1; justify-content: center; }

        /* IMPACTED */
        .impacted-section { border-left: 5px solid var(--danger); }
        .impacted-section.isolated { border-left-color: var(--isolated); }
        .impacted-header {
            padding: 0.7rem 1rem; display: flex; justify-content: space-between; align-items: center;
            gap: 0.5rem; border-bottom: 1px solid var(--border); background: var(--bg-elevated);
        }
        .impacted-title { font-size: 0.95rem; font-weight: 800; color: var(--danger); display: flex; align-items: center; gap: 0.45rem; }
        .impacted-title.isolated { color: var(--isolated); }
        .impacted-count {
            background: var(--danger); color: white; padding: 0.15rem 0.7rem;
            border-radius: 999px; font-size: 0.78rem; font-weight: 800;
        }
        .impacted-count.isolated { background: var(--isolated); }
        .impacted-content { padding: 0.65rem 0.85rem 0.85rem; max-height: 280px; overflow-y: auto; }
        .impacted-list { display: flex; flex-direction: column; gap: 0.45rem; }
        .impacted-server-item {
            background: var(--bg-elevated); border: 1px solid var(--border);
            border-radius: 0.55rem; padding: 0.6rem 0.85rem;
            display: flex; align-items: center; justify-content: space-between;
            gap: 0.55rem; font-size: 0.88rem;
            position: relative; overflow: hidden;
        }
        .impacted-server-item::before { content: ''; position: absolute; left: 0; top: 0; height: 100%; width: 4px; background: var(--danger); }
        .impacted-server-item.warning::before { background: var(--warning); }
        .impacted-server-item.isolated::before { background: var(--isolated); }
        .impacted-server-item:hover { background: var(--bg-hover); transform: translateX(3px); }
        .impacted-broker { font-weight: 800; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .impacted-ip { color: var(--text-muted); font-family: 'Courier New', monospace; flex-shrink: 0; font-weight: 700; font-size: 0.85rem; }
        .impacted-hits {
            color: white; padding: 0.2rem 0.6rem; border-radius: 0.4rem;
            font-weight: 800; font-size: 0.78rem; min-width: 55px; text-align: center;
        }
        .impacted-hits.critical { background: var(--danger); }
        .impacted-hits.warning { background: var(--warning); }
        .impacted-hits.isolated { background: var(--isolated); }

        /* BROKER CARDS */
        .broker-cards-container {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
            gap: 0.9rem; width: 100%;
        }
        .broker-card {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 0.85rem; box-shadow: var(--shadow-sm);
            transition: all 0.25s ease; display: flex; flex-direction: column;
            position: relative; overflow: hidden; min-width: 0;
        }
        .broker-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; }
        .broker-card.critical::before { background: var(--danger); }
        .broker-card.warning::before { background: var(--warning); }
        .broker-card.healthy::before { background: var(--success); }
        .broker-card.isolated::before { background: var(--isolated); }
        .broker-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }

        .broker-header {
            padding: 0.9rem 1.1rem; border-bottom: 1px solid var(--border);
            display: flex; justify-content: space-between; align-items: flex-start; gap: 0.7rem;
        }
        .broker-info { flex: 1; min-width: 0; }
        .broker-name {
            font-size: 1.15rem; font-weight: 800; margin-bottom: 0.25rem;
            display: flex; align-items: center; gap: 0.5rem;
            word-break: break-word; line-height: 1.2;
        }
        .broker-port { color: var(--text-muted); font-size: 0.85rem; font-weight: 700; }
        .broker-port i { margin-right: 0.3rem; color: var(--text-faint); }
        .broker-status { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; flex-shrink: 0; }
        .status-badge {
            padding: 0.3rem 0.75rem; border-radius: 999px;
            font-size: 0.72rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 0.04em; white-space: nowrap; color: white;
        }
        .status-badge.healthy { background: var(--success); }
        .status-badge.warning { background: var(--warning); }
        .status-badge.critical { background: var(--danger); }
        .status-badge.isolated { background: var(--isolated); }
        .total-hits { font-size: 1.2rem; font-weight: 800; white-space: nowrap; line-height: 1; }
        .total-hits-label { font-size: 0.68rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; }

        .broker-body { padding: 0.9rem 1.1rem; flex: 1; display: flex; flex-direction: column; gap: 0.9rem; }
        .server-stats {
            display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 0.4rem; padding-bottom: 0.85rem; border-bottom: 1px solid var(--border);
        }
        .server-stat {
            text-align: center; padding: 0.5rem 0.25rem;
            border-radius: 0.5rem; background: var(--bg-elevated); min-width: 0;
        }
        .server-stat-value { font-size: 1.15rem; font-weight: 800; line-height: 1; margin-bottom: 0.25rem; }
        .server-stat-label { font-size: 0.68rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; }

        .server-list {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0.45rem;
        }
        .server-item {
            display: flex; justify-content: space-between; align-items: center;
            padding: 0.55rem 0.7rem; background: var(--bg-elevated);
            border-radius: 0.5rem; font-size: 0.85rem;
            border-left: 3px solid var(--border-strong); min-width: 0;
        }
        .server-item:hover { background: var(--bg-hover); transform: translateX(2px); }
        .server-ip {
            font-weight: 800; color: var(--text-secondary);
            font-family: 'Courier New', monospace;
            display: flex; align-items: center; gap: 0.45rem;
            font-size: 0.85rem; min-width: 0;
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }
        .server-hits {
            font-weight: 800; padding: 0.25rem 0.55rem;
            border-radius: 0.4rem; background: var(--bg-card);
            border: 1px solid var(--border); min-width: 3rem;
            text-align: center; font-size: 0.8rem; flex-shrink: 0;
        }
        .server-hits.healthy { color: var(--success); border-color: var(--success); background: rgba(16, 185, 129, 0.12); }
        .server-hits.warning { color: var(--warning); border-color: var(--warning); background: rgba(245, 158, 11, 0.12); }
        .server-hits.critical, .server-hits.zero { color: var(--danger); border-color: var(--danger); background: rgba(239, 68, 68, 0.12); }
        .server-hits.isolated { color: var(--isolated); border-color: var(--isolated); background: rgba(139, 92, 246, 0.12); }

        .broker-footer {
            padding: 0.55rem 1.1rem; background: var(--bg-footer);
            border-top: 1px solid var(--border);
            display: flex; justify-content: space-between; align-items: center;
            font-size: 0.78rem; color: var(--text-muted); font-weight: 600;
        }

        .status-indicator { display: inline-block; width: 11px; height: 11px; border-radius: 50%; flex-shrink: 0; }
        .status-indicator.healthy { background: var(--success); }
        .status-indicator.warning { background: var(--warning); }
        .status-indicator.critical { background: var(--danger); }
        .status-indicator.isolated { background: var(--isolated); }

        [data-full-ip] { position: relative; cursor: help; }
        [data-full-ip]:hover::after {
            content: attr(data-full-ip);
            position: absolute; bottom: 100%; left: 50%;
            transform: translateX(-50%);
            padding: 0.4rem 0.8rem; background: var(--text-primary);
            color: var(--bg-card); border-radius: 0.4rem;
            font-size: 0.78rem; white-space: nowrap; z-index: 1000;
            pointer-events: none; margin-bottom: 0.4rem; font-weight: 700;
        }

        .no-impacted {
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            text-align: center; color: var(--text-muted);
            padding: 1.5rem 1rem; min-height: 120px;
        }
        .no-impacted i { font-size: 1.75rem; margin-bottom: 0.5rem; display: block; }
        .no-impacted p { margin-bottom: 0.2rem; font-weight: 700; color: var(--text-secondary); }
        .no-impacted small { color: var(--text-faint); font-size: 0.78rem; }

        .impacted-content::-webkit-scrollbar { width: 8px; }
        .impacted-content::-webkit-scrollbar-track { background: var(--scrollbar-track); border-radius: 4px; }
        .impacted-content::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb); border-radius: 4px; }

        @media (max-width: 1200px) {
            .stats-bar { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .main-content { grid-template-columns: 340px minmax(0, 1fr); }
        }
        @media (max-width: 1024px) {
            .main-content { grid-template-columns: 1fr; }
        }
        @media (max-width: 768px) {
            body { font-size: 16px; }
            .exp-content { padding: 16px 14px 32px; }
            .stats-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .broker-cards-container { grid-template-columns: 1fr; }
            .topbar-center { display: none; }
            .brand-sub { display: none; }
        }
    </style>
</head>
<body>

<%@include file="../userheader.jsp"%>

<div class="new-wrapper">
<div class="exp-content">

<!-- TOPBAR -->
<div class="topbar">
    <div class="brand">
        <div class="brand-logo"><i class="fas fa-server"></i></div>
        <div>
            <div class="brand-title">EXP Broker Monitor</div>
            <div class="brand-sub">Rolling 60-min window - updated every 10 min</div>
        </div>
    </div>

    <div class="topbar-center">
        <span class="pill timer" id="refreshTimer"><i class="fas fa-sync-alt"></i> <span id="ten-countdown">10:00</span></span>
        <span class="pill window"><i class="fas fa-clock"></i> <%=runTimeDisplay%></span>
        <% if ("PR".equals(flagStatus)) { %>
            <span class="pill pr"><i class="fas fa-circle-check"></i> PR</span>
        <% } else if ("DR".equals(flagStatus)) { %>
            <span class="pill dr"><i class="fas fa-shield-halved"></i> DR</span>
        <% } %>
    </div>

    <div class="topbar-actions">
        <button class="icon-btn" onclick="toggleBlinking()" id="blinkToggleBtn" title="Toggle blinking">
            <i class="fas fa-eye" id="blinkIcon"></i>
        </button>
    </div>
</div>

<!-- STATS BAR -->
<div class="stats-bar">
    <div class="stat-mini">
        <div class="stat-mini-icon"><i class="fas fa-server"></i></div>
        <div class="stat-mini-text">
            <span class="stat-mini-value"><%=totalBrokers%></span>
            <span class="stat-mini-label">Brokers</span>
        </div>
    </div>
    <div class="stat-mini info">
        <div class="stat-mini-icon"><i class="fas fa-network-wired"></i></div>
        <div class="stat-mini-text">
            <span class="stat-mini-value"><%=totalServers%></span>
            <span class="stat-mini-label">Servers</span>
        </div>
    </div>
    <div class="stat-mini isolated">
        <div class="stat-mini-icon"><i class="fas fa-shield-alt"></i></div>
        <div class="stat-mini-text">
            <span class="stat-mini-value"><%=isolatedBrokersCount%></span>
            <span class="stat-mini-label">Isolated</span>
        </div>
    </div>
    <div class="stat-mini critical">
        <div class="stat-mini-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="stat-mini-text">
            <span class="stat-mini-value"><%=criticalBrokers%></span>
            <span class="stat-mini-label">Critical</span>
        </div>
    </div>
    <div class="stat-mini warning">
        <div class="stat-mini-icon"><i class="fas fa-exclamation-circle"></i></div>
        <div class="stat-mini-text">
            <span class="stat-mini-value"><%=warningBrokers%></span>
            <span class="stat-mini-label">Warning</span>
        </div>
    </div>
    <div class="stat-mini healthy">
        <div class="stat-mini-icon"><i class="fas fa-check-circle"></i></div>
        <div class="stat-mini-text">
            <span class="stat-mini-value"><%=healthyBrokers%></span>
            <span class="stat-mini-label">Healthy</span>
        </div>
    </div>
</div>

<!-- MAIN -->
<div class="main-content">
    <div class="left-panel">
        <!-- Time Filter -->
        <div class="card">
            <div class="time-filter-header" onclick="toggleTimeFilter()">
                <div class="time-filter-title"><i class="fas fa-filter"></i> Time Filter</div>
                <div class="time-filter-toggle"><i class="fas fa-chevron-down"></i></div>
            </div>
            <div class="time-filter-content" id="timeFilterContent">
                <form id="timeFilterForm" method="GET" class="time-filter-form">
                    <div class="time-filter-group">
                        <label class="time-filter-label" for="fromDateTime">From:</label>
                        <input type="datetime-local" id="fromDateTime" name="fromDateTime" class="time-filter-input" value="<%=fromDateTime%>">
                    </div>
                    <div class="time-filter-group">
                        <label class="time-filter-label" for="toDateTime">To:</label>
                        <input type="datetime-local" id="toDateTime" name="toDateTime" class="time-filter-input" value="<%=toDateTime%>">
                    </div>
                    <div class="time-filter-actions">
                        <button type="submit" class="btn primary"><i class="fas fa-search"></i> Apply</button>
                        <button type="button" class="btn" onclick="resetTimeFilter()"><i class="fas fa-rotate-left"></i> Reset</button>
                    </div>
                </form>
                <div class="quick-filter-buttons">
                    <button type="button" class="quick-filter-btn" onclick="setQuickFilter(10)">10m</button>
                    <button type="button" class="quick-filter-btn" onclick="setQuickFilter(20)">20m</button>
                    <button type="button" class="quick-filter-btn" onclick="setQuickFilter(30)">30m</button>
                    <button type="button" class="quick-filter-btn" onclick="setQuickFilter(60)">1h</button>
                    <button type="button" class="quick-filter-btn" onclick="setQuickFilter(120)">2h</button>
                    <button type="button" class="quick-filter-btn" onclick="setQuickFilter(360)">6h</button>
                </div>
            </div>
        </div>

        <!-- Controls -->
        <div class="card">
            <div class="controls-row">
                <button class="btn primary" onclick="openNewPage()"><i class="fas fa-exchange-alt"></i> SYS</button>
                <button class="btn isolated" onclick="showIsolatedOnly()"><i class="fas fa-shield-alt"></i> ISO Only</button>
                <button class="btn success" onclick="showAllBrokers()" id="showAllBtn" style="display: none;"><i class="fas fa-globe"></i> All</button>
            </div>
        </div>

        <!-- Impacted -->
        <div class="card impacted-section">
            <div class="impacted-header">
                <div class="impacted-title"><i class="fas fa-exclamation-triangle"></i> Impacted Servers <span class="impacted-count"><%=impactedServers%></span></div>
            </div>
            <div class="impacted-content">
                <% if (impactedServers > 0) { %>
                <div class="impacted-list">
                    <% for (Map<String, String> server : impactedServersList) { %>
                    <div class="impacted-server-item <%=server.get("status")%>" data-full-ip="<%=server.get("ip")%>">
                        <span class="impacted-broker"><%=server.get("broker")%></span>
                        <span class="impacted-ip"><%=server.get("displayIP")%></span>
                        <span class="impacted-hits <%=server.get("status")%>"><%=String.format("%,d", Integer.parseInt(server.get("hits")))%></span>
                    </div>
                    <% } %>
                </div>
                <% } else { %>
                <div class="no-impacted">
                    <i class="fas fa-check-circle" style="color: var(--success);"></i>
                    <p>No Impacted Servers</p>
                    <small>All systems normal</small>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Isolated -->
        <div class="card impacted-section isolated">
            <div class="impacted-header">
                <div class="impacted-title isolated"><i class="fas fa-shield-alt"></i> Isolated Servers <span class="impacted-count isolated"><%=isolatedServers%></span></div>
            </div>
            <div class="impacted-content">
                <% if (isolatedServers > 0) { %>
                <div class="impacted-list">
                    <% for (Map<String, String> server : isolatedServersList) { %>
                    <div class="impacted-server-item isolated" data-full-ip="<%=server.get("ip")%>">
                        <span class="impacted-broker"><%=server.get("broker")%></span>
                        <span class="impacted-ip"><%=server.get("displayIP")%></span>
                        <span class="impacted-hits isolated">ISO</span>
                    </div>
                    <% } %>
                </div>
                <% } else { %>
                <div class="no-impacted">
                    <i class="fas fa-check-circle" style="color: var(--success);"></i>
                    <p>No Isolated Servers</p>
                    <small>All brokers normal</small>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <div class="right-panel">
        <div class="broker-cards-container" id="brokerCardsContainer">
            <%
                if (brokerDataList.isEmpty()) {
            %>
                <div class="card" style="grid-column: 1 / -1; text-align: center; padding: 3rem 1.5rem;">
                    <i class="fas fa-database" style="font-size: 3rem; color: var(--text-faint); margin-bottom: 0.9rem;"></i>
                    <h3 style="color: var(--text-secondary); margin-bottom: 0.5rem;">No Brokers Found</h3>
                    <p style="color: var(--text-muted); font-size: 0.9rem;">No data available for selected range.</p>
                </div>
            <%
                } else {
                    for (Map<String, Object> brokerData : brokerDataList) {
                        String broker = (String) brokerData.get("broker");
                        String port = (String) brokerData.get("port");
                        String brokerStatus = (String) brokerData.get("brokerStatus");
                        List<Map<String, String>> serverList = (List<Map<String, String>>) brokerData.get("serverList");
                        int totalHits = (Integer) brokerData.get("totalHits");
                        int criticalCount = (Integer) brokerData.get("criticalCount");
                        int warningCount = (Integer) brokerData.get("warningCount");
                        int isolatedCount = (Integer) brokerData.get("isolatedCount");
                        int serverCount = (Integer) brokerData.get("serverCount");
                        int healthyCount = (Integer) brokerData.get("healthyCount");
            %>
                <div class="broker-card <%= brokerStatus %>" data-status="<%= brokerStatus %>" data-broker="<%= broker %>">
                    <div class="broker-header">
                        <div class="broker-info">
                            <div class="broker-name"><span class="status-indicator <%= brokerStatus %>"></span><%= broker != null ? broker : "Unknown" %></div>
                            <div class="broker-port"><i class="fas fa-plug"></i>Port: <%= port != null ? port : "N/A" %></div>
                        </div>
                        <div class="broker-status">
                            <div class="status-badge <%= brokerStatus %>"><%= brokerStatus.equals("healthy") ? "Healthy" : brokerStatus.equals("warning") ? "Warning" : brokerStatus.equals("critical") ? "Critical" : "Isolated" %></div>
                            <div class="total-hits"><%= String.format("%,d", totalHits) %></div>
                            <div class="total-hits-label">Total Hits</div>
                        </div>
                    </div>
                    <div class="broker-body">
                        <div class="server-stats">
                            <div class="server-stat"><div class="server-stat-value"><%= serverCount %></div><div class="server-stat-label">Total</div></div>
                            <div class="server-stat"><div class="server-stat-value" style="color: var(--success);"><%= healthyCount %></div><div class="server-stat-label">OK</div></div>
                            <div class="server-stat"><div class="server-stat-value" style="color: var(--warning);"><%= warningCount %></div><div class="server-stat-label">Warn</div></div>
                            <div class="server-stat"><div class="server-stat-value" style="color: var(--danger);"><%= criticalCount %></div><div class="server-stat-label">Crit</div></div>
                            <div class="server-stat"><div class="server-stat-value" style="color: var(--isolated);"><%= isolatedCount %></div><div class="server-stat-label">ISO</div></div>
                        </div>
                        <div class="server-list">
                            <%
                                for (Map<String, String> server : serverList) {
                                    String ip = server.get("ip");
                                    String displayIP = server.get("displayIP");
                                    String hits = server.get("hits");
                                    String status = server.get("status");
                            %>
                                <div class="server-item" data-full-ip="<%= ip %>">
                                    <span class="server-ip"><span class="status-indicator <%= status %>"></span><%= displayIP %></span>
                                    <span class="server-hits <%= status %>">
                                        <% if (status.equals("isolated")) { %>ISO<% } else { %><%= String.format("%,d", Integer.parseInt(hits)) %><% } %>
                                    </span>
                                </div>
                            <%
                                }
                            %>
                        </div>
                    </div>
                    <div class="broker-footer">
                        <span><i class="far fa-clock"></i> <%=runTimeDisplay%></span>
                    </div>
                </div>
            <%
                    }
                }
            %>
        </div>
    </div>
</div>

</div>
</div>

<script>
/* ============ BACK BUTTON BLOCK ============ */
(function(){
    window.history.pushState({ page: 'exp' }, '', window.location.href);
    window.addEventListener('popstate', function(e){
        if(window.__logoutInProgress === true) return;
        window.history.pushState({ page: 'exp' }, '', window.location.href);
    });
})();

/* ✅ Logout handler — capture phase */
document.addEventListener('click', function(e){
    var target = e.target.closest('.sb-logout, a[href*="login.action"], .sb-home-btn, a[href*="userhomescreen.action"]');
    if(target){
        e.preventDefault();
        e.stopPropagation();
        window.__logoutInProgress = true;
        try{
            sessionStorage.clear();
            localStorage.removeItem('eis-sidebar-closed');
        }catch(err){}
        var isLogout = target.classList.contains('sb-logout') || (target.href && target.href.indexOf('login.action') !== -1);
        if(isLogout){
            window.location.replace('<%=request.getContextPath()%>/login.action?logout=true');
        } else {
            window.location.href = '<%=request.getContextPath()%>/userhomescreen.action';
        }
    }
}, true);

/* ============ TIMER ============ */
function countdown(elementName, minutes, seconds) {
    var element = document.getElementById(elementName);
    if (!element) return;
    var endTime = (+new Date) + 1000 * (60 * minutes + seconds);
    function twoDigits(n) { return (n <= 9 ? "0" + n : n); }
    function updateTimer() {
        var msLeft = endTime - (+new Date);
        if (msLeft < 1000) {
            element.innerHTML = "...";
            var rt = document.getElementById('refreshTimer');
            if (rt) rt.classList.add('warning-state');
            setTimeout(function() {
                // ✅ Modern reload — filter params preserve karo
                window.location.href = window.location.pathname + window.location.search;
            }, 1000);
        } else {
            var time = new Date(msLeft);
            var hours = time.getUTCHours();
            var mins = time.getUTCMinutes();
            element.innerHTML = (hours ? hours + ':' + twoDigits(mins) : mins) + ':' + twoDigits(time.getUTCSeconds());
            var rt = document.getElementById('refreshTimer');
            if (rt) {
                if (msLeft < 60000) rt.classList.add('warning-state');
                else rt.classList.remove('warning-state');
            }
            setTimeout(updateTimer, time.getUTCMilliseconds() + 500);
        }
    }
    updateTimer();
}

/* ============ TIME FILTER ============ */
function toggleTimeFilter() {
    var content = document.getElementById('timeFilterContent');
    var toggle = document.querySelector('.time-filter-toggle');
    if (content) content.classList.toggle('expanded');
    if (toggle) toggle.classList.toggle('expanded');
}
function resetTimeFilter() {
    window.location.href = window.location.pathname;
}
function setQuickFilter(minutes) {
    var now = new Date();
    var start = new Date(now.getTime() - minutes * 60000);
    document.getElementById('fromDateTime').value = formatDateForInput(start);
    document.getElementById('toDateTime').value = formatDateForInput(now);
    document.querySelectorAll('.quick-filter-btn').forEach(b => b.classList.remove('active'));
    if (event && event.target) event.target.classList.add('active');
    document.getElementById('timeFilterForm').submit();
}
function formatDateForInput(date) {
    var y = date.getFullYear();
    var m = String(date.getMonth()+1).padStart(2,'0');
    var d = String(date.getDate()).padStart(2,'0');
    var h = String(date.getHours()).padStart(2,'0');
    var min = String(date.getMinutes()).padStart(2,'0');
    return y + '-' + m + '-' + d + 'T' + h + ':' + min;
}

/* ============ BLINKING ============ */
function toggleBlinking() {
    var body = document.body;
    var icon = document.getElementById('blinkIcon');
    if (body.classList.contains('no-blink')) {
        body.classList.remove('no-blink');
        if (icon) icon.className = 'fas fa-eye';
        localStorage.setItem('blinkingEnabled', 'true');
    } else {
        body.classList.add('no-blink');
        if (icon) icon.className = 'fas fa-eye-slash';
        localStorage.setItem('blinkingEnabled', 'false');
    }
}

/* ============ ISO FILTER ============ */
function showIsolatedOnly() {
    var cards = document.querySelectorAll('.broker-card');
    var isolatedCount = 0;
    cards.forEach(function(card) {
        if (card.classList.contains('isolated')) { card.style.display = 'flex'; isolatedCount++; }
        else card.style.display = 'none';
    });
    var showAllBtn = document.getElementById('showAllBtn');
    if (showAllBtn) showAllBtn.style.display = 'inline-flex';
    var container = document.getElementById('brokerCardsContainer');
    var existing = document.getElementById('noIsolatedMessage');
    if (isolatedCount === 0 && !existing) {
        var div = document.createElement('div');
        div.id = 'noIsolatedMessage';
        div.className = 'card';
        div.style.cssText = 'grid-column: 1 / -1; text-align: center; padding: 3rem 1.5rem;';
        div.innerHTML = '<i class="fas fa-shield-alt" style="font-size: 3rem; color: var(--text-faint); margin-bottom: 0.9rem;"></i><h3 style="color: var(--text-secondary);">No Isolated Brokers</h3><button class="btn primary" onclick="showAllBrokers()" style="margin-top: 1rem;"><i class="fas fa-globe"></i> Show All</button>';
        container.appendChild(div);
    } else if (existing && isolatedCount > 0) existing.remove();
}
function showAllBrokers() {
    document.querySelectorAll('.broker-card').forEach(c => c.style.display = 'flex');
    var showAllBtn = document.getElementById('showAllBtn');
    if (showAllBtn) showAllBtn.style.display = 'none';
    var msg = document.getElementById('noIsolatedMessage');
    if (msg) msg.remove();
}

/* ============ OPEN SYS PAGE ============ */
function openNewPage() {
    window.open('<%= request.getContextPath() + "/jsp/A_SYS_SERVERWISE_COUNT_LDAP.jsp" %>', '_blank');
}

/* ============ KEYBOARD SHORTCUTS ============ */
document.addEventListener('keydown', function(e) {
    var isRefreshKey = (e.key === 'F5') || (e.ctrlKey && (e.key === 'r' || e.key === 'R'));
    if (isRefreshKey) {
        var hasFilter = window.location.search && window.location.search.length > 1;
        if (hasFilter) { e.preventDefault(); window.location.href = window.location.pathname; return false; }
    }
    if (e.ctrlKey && e.key === 'b') { e.preventDefault(); toggleBlinking(); }
    if (e.ctrlKey && e.key === 'i') { e.preventDefault(); showIsolatedOnly(); }
    if (e.ctrlKey && e.key === 'a') { e.preventDefault(); showAllBrokers(); }
});

/* ============ INIT ============ */
document.addEventListener('DOMContentLoaded', function() {
    // Blinking preference
    var blinkingPref = localStorage.getItem('blinkingEnabled');
    if (blinkingPref === 'false') {
        document.body.classList.add('no-blink');
        var bi = document.getElementById('blinkIcon');
        if (bi) bi.className = 'fas fa-eye-slash';
    }

    // Timer start — 10 minutes
    countdown('ten-countdown', 10, 0);

    // Active quick filter highlight
    var urlParams = new URLSearchParams(window.location.search);
    var fromDateTime = urlParams.get('fromDateTime');
    var toDateTime = urlParams.get('toDateTime');
    if (fromDateTime && toDateTime) {
        var diffMinutes = Math.round((new Date(toDateTime) - new Date(fromDateTime)) / (1000 * 60));
        document.querySelectorAll('.quick-filter-btn').forEach(function(btn) {
            btn.classList.remove('active');
            var match = btn.getAttribute('onclick')?.match(/\d+/);
            var minutes = match ? parseInt(match[0]) : 60;
            if (Math.abs(diffMinutes - minutes) < 5) btn.classList.add('active');
        });
    }
});
</script>


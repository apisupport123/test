                                             "<br><b>TD Count:</b> <span class='highlight-td'>" + h3MixedTd.get(idx) + "</span>" +
                                             "<br><b>BD Count:</b> <span class='highlight-bd'>" + h3MixedBd.get(idx) + "</span>" +
                                             "<br><b>Time:</b> " + h3MixedTime.get(idx);
                            String name = h3MixedName.get(idx).replace("'", "\\'");
                            String source = h3MixedSource.get(idx).replace("'", "\\'");
                            String error = h3MixedError.get(idx).replace("'", "\\'");
                            String time = h3MixedTime.get(idx).replace("'", "\\'");
                            String transaction = h3MixedTransaction.get(idx).replace("'", "\\'");
                            String supurl = h3MixedSupUrl.get(idx).replace("'", "\\'");
                            String onclick = "onclick=\"openModal100Full('" + alertMsg.replace("'", "\\'") + "','" + name + "','ThirdParty','MIXED','" + source + "','" + error + "','" + h3MixedHits.get(idx) + "','" + h3MixedTd.get(idx) + "','" + time + "','" + transaction + "','" + supurl + "','" + name + "')\"";
                            out.print("<div class='" + cls + "' data-tip='" + tip + "' data-tip-class='tip-mixed' " + onclick + ">");
                            out.print("<span class='val'>100%</span><span class='sub-text'>MIX</span>");
                            out.print("<div class='bar'><div class='fill'></div></div></div>");
                        }
                        h3Idx++;
                    }

                    for(int k = h3Idx; k < maxTiles; k++) {
                        out.print("<div class='tile tile-hundred-healthy' data-tip='✅ Healthy' data-tip-class='tip-healthy'>");
                        out.print("<span class='val'>✓</span><span class='sub-text'>HEALTHY</span>");
                        out.print("<div class='bar'><div class='fill'></div></div></div>");
                    }
                %>
            </div>
        </div>

    </div>
</div>
</div>

<div id="customTooltip"></div>

<div id="modalContainer">
    <div id="alertBox">
        <div class="head">
            <h3><i class="fas fa-exclamation-triangle"></i> <span id="modalTitle">Service Alert</span></h3>
            <button class="close-btn" onclick="closeModal()">✕</button>
        </div>
        <div class="body-text" id="modalMsg"></div>

        <div class="form-row">
            <div class="field">
                <label>Closed Time</label>
                <select id="pasuseTime">
                    <option value="1">1 Hour</option><option value="2">2 Hours</option>
                    <option value="3">3 Hours</option><option value="4">4 Hours</option>
                    <option value="5">5 Hours</option><option value="6">6 Hours</option>
                    <option value="7">7 Hours</option><option value="8">8 Hours</option>
                    <option value="9">9 Hours</option><option value="10">10 Hours</option>
                    <option value="11">11 Hours</option><option value="12">12 Hours</option>
                    <option value="13">13 Hours</option><option value="14">14 Hours</option>
                    <option value="15">15 Hours</option><option value="16">16 Hours</option>
                    <option value="17">17 Hours</option><option value="18">18 Hours</option>
                    <option value="19">19 Hours</option><option value="20">20 Hours</option>
                    <option value="21">21 Hours</option><option value="22">22 Hours</option>
                    <option value="23">23 Hours</option><option value="24">24 Hours</option>
                </select>
            </div>
            <div class="field">
                <label>Closed By</label>
                <select id="closeName">
                    <option value="">Select</option>
                    <%
                        try {
                            Statement stmt1 = con.createStatement();
                            ResultSet rs1 = stmt1.executeQuery("select FIRSTNAME || ' ' || lastname as Fullname from eisupport_employee_master where lower(team) like '%event%' and ISACTIVE='Active'");
                            while(rs1.next()){
                                out.print("<option value='"+rs1.getString("Fullname")+"'>"+rs1.getString("Fullname")+"</option>");
                            }
                            rs1.close(); stmt1.close();
                        } catch(Exception e) { }
                    %>
                </select>
            </div>
        </div>
        <div class="field full">
            <label>Comment</label>
            <textarea id="TextArea" placeholder="Enter closure comments..."></textarea>
        </div>

        <div class="modal-actions">
            <button class="btn-m btn-m-primary" id="closeBtn"><i class="fas fa-check"></i> Close</button>
            <button class="btn-m btn-m-danger" id="detailsBtn"><i class="fas fa-eye"></i> View</button>
            <button class="btn-m btn-m-secondary" onclick="closeModal()">Cancel</button>
        </div>
    </div>
</div>

<%
    try { if(con != null) con.close(); } catch(Exception e) { }
%>

<%!
    public static String nvl(String value, String defaultValue) {
        return (value == null || value.trim().isEmpty()) ? defaultValue : value;
    }
%>

<script>
    var mApi = '', mCat = '', mType = '', mSource = '', mError = '', mHits = '', mTD = '', mTime = '';
    var mTransaction = '', mSupUrl = '', mOriginalUrn = '', mApiName = '';
    var isHundred = false;

    document.addEventListener('DOMContentLoaded', function() {
        var tooltip = document.getElementById('customTooltip');
        var tiles = document.querySelectorAll('.tile[data-tip]');
        var timeoutId = null;

        tiles.forEach(function(tile) {
            tile.addEventListener('mouseenter', function(e) {
                var text = this.getAttribute('data-tip');
                var tipClass = this.getAttribute('data-tip-class') || '';
                tooltip.textContent = text;
                tooltip.className = tipClass;
                tooltip.style.display = 'block';
                var rect = this.getBoundingClientRect();
                tooltip.style.left = (rect.left + rect.width/2) + 'px';
                tooltip.style.top = (rect.top - 10) + 'px';
                if(timeoutId) { clearTimeout(timeoutId); timeoutId = null; }
            });
            tile.addEventListener('mousemove', function(e) {
                tooltip.style.left = e.clientX + 'px';
                tooltip.style.top = (e.clientY - 10) + 'px';
            });
            tile.addEventListener('mouseleave', function() {
                timeoutId = setTimeout(function() {
                    tooltip.style.display = 'none';
                    timeoutId = null;
                }, 100);
            });
        });
    });

    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            document.getElementById('loaderWrapper').classList.add('hidden');
        }, 1200);
        window.addEventListener('load', function() {
            document.getElementById('loaderWrapper').classList.add('hidden');
        });
    });

    function countdownTimer(el, minutes, seconds) {
        var element = document.getElementById(el);
        if(!element) return;
        var endTime = (+new Date) + 1000 * (60 * minutes + seconds);
        function update() {
            var msLeft = endTime - (+new Date);
            if (msLeft < 1000) { element.innerHTML = "⟳"; }
            else {
                var t = new Date(msLeft);
                var m = t.getUTCMinutes();
                var s = t.getUTCSeconds();
                element.innerHTML = (m ? m + ':' : '') + (m ? String(s).padStart(2,'0') : s);
                setTimeout(update, 100);
            }
        }
        update();
    }
    countdownTimer('ten-countdown', 5, 0);

    function openModal(msg, api, cat, type, src, err, hits, td, time, transaction, supurl, originalurn, apiname) {
        mApi = api || '';
        mCat = cat || 'GEN-5';
        mType = type || 'ServiceWise';
        mSource = src || '';
        mError = err || '';
        mHits = hits || '';
        mTD = td || '';
        mTime = time || '';
        mTransaction = transaction || '';
        mSupUrl = supurl || '';
        mOriginalUrn = originalurn || '';
        mApiName = apiname || '';
        isHundred = false;
        document.getElementById('modalTitle').textContent = 'Service Alert';
        document.getElementById('modalMsg').innerHTML = msg;
        document.getElementById('modalContainer').style.display = 'flex';
        document.getElementById('TextArea').value = '';
        document.getElementById('closeName').value = '';
    }

    function openModal100Full(msg, api, cat, type, src, err, hits, td, time, transaction, supurl, originalurn) {
        mApi = api || '';
        mCat = cat || 'GEN-5';
        mType = type || 'TD';
        mSource = src || '';
        mError = err || '';
        mHits = hits || '';
        mTD = td || '';
        mTime = time || '';
        mTransaction = transaction || '';
        mSupUrl = supurl || '';
        mOriginalUrn = originalurn || '';
        mApiName = '';
        isHundred = true;
        document.getElementById('modalTitle').textContent = '100% Failure Alert';
        document.getElementById('modalMsg').innerHTML = msg;
        document.getElementById('modalContainer').style.display = 'flex';
        document.getElementById('TextArea').value = '';
        document.getElementById('closeName').value = '';
    }

    function openModal100(msg, api, cat, type, src, err, hits, td, time) {
        mApi = api || '';
        mCat = cat || 'GEN-5';
        mType = type || 'TD';
        mSource = src || '';
        mError = err || '';
        mHits = hits || '';
        mTD = td || '';
        mTime = time || '';
        mTransaction = '';
        mSupUrl = '';
        mOriginalUrn = '';
        mApiName = '';
        isHundred = true;
        document.getElementById('modalTitle').textContent = '100% Failure Alert';
        document.getElementById('modalMsg').innerHTML = msg;
        document.getElementById('modalContainer').style.display = 'flex';
        document.getElementById('TextArea').value = '';
        document.getElementById('closeName').value = '';
    }

    function closeModal() {
        document.getElementById('modalContainer').style.display = 'none';
    }

    document.addEventListener('DOMContentLoaded', function() {
        var swGen5 = document.querySelectorAll('#sw-gen5 .tile-critical').length || 0;
        var swThird = document.querySelectorAll('#sw-third .tile-critical').length || 0;
        var swComb = document.querySelectorAll('#sw-comb .tile-critical').length || 0;

        document.getElementById('swGen5Count').textContent = swGen5;
        document.getElementById('swGen5Count').className = 'badge-count' + (swGen5 > 0 ? ' danger' : '');
        document.getElementById('swThirdCount').textContent = swThird;
        document.getElementById('swThirdCount').className = 'badge-count' + (swThird > 0 ? ' danger' : '');
        document.getElementById('swCombCount').textContent = swComb;
        document.getElementById('swCombCount').className = 'badge-count' + (swComb > 0 ? ' danger' : '');

        var hGen5 = document.querySelectorAll('#h-gen5 .tile-td, #h-gen5 .tile-bd, #h-gen5 .tile-mixed').length || 0;
        var hThird = document.querySelectorAll('#h-third .tile-td, #h-third .tile-bd, #h-third .tile-mixed').length || 0;

        document.getElementById('hGen5Count').textContent = hGen5;
        document.getElementById('hGen5Count').className = 'badge-count' + (hGen5 > 0 ? ' danger' : '');
        document.getElementById('hThirdCount').textContent = hThird;
        document.getElementById('hThirdCount').className = 'badge-count' + (hThird > 0 ? ' danger' : '');
    });

    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('closeBtn').addEventListener('click', function() {
            var comment = document.getElementById('TextArea').value;
            var closer = document.getElementById('closeName').value;
            var pTime = document.getElementById('pasuseTime').value;

            if(comment.trim() == '' || closer == '') {
                alert('⚠️ Please fill Comment and Closed By');
                return;
            }

            var url = '';
            if(isHundred) {
                url = '<%=request.getContextPath()%>/jsp/100PercentFailureAction.jsp?Api_Name='
                    + encodeURIComponent(mApi)
                    + '&SourceID=' + encodeURIComponent(mSource)
                    + '&TextArea=' + encodeURIComponent(comment)
                    + '&pasuseTime=' + encodeURIComponent(pTime)
                    + '&ErrorCode=' + encodeURIComponent(mError)
                    + '&closeName=' + encodeURIComponent(closer)
                    + '&ServiceCategory=' + encodeURIComponent(mCat)
                    + '&FailureType=' + encodeURIComponent(mType)
                    + '&TransactionURN=' + encodeURIComponent(mTransaction)
                    + '&SupUrl=' + encodeURIComponent(mSupUrl)
                    + '&OriginalUrn=' + encodeURIComponent(mOriginalUrn);
            } else {
                url = '<%=request.getContextPath()%>/jsp/ServiceWiseFailureAction.jsp?Api_Name='
                    + encodeURIComponent(mApi)
                    + '&SourceID=' + encodeURIComponent(mSource)
                    + '&TextArea=' + encodeURIComponent(comment)
                    + '&pasuseTime=' + encodeURIComponent(pTime)
                    + '&ErrorCode=' + encodeURIComponent(mError)
                    + '&closeName=' + encodeURIComponent(closer)
                    + '&ServiceCategory=' + encodeURIComponent(mCat)
                    + '&TransactionURN=' + encodeURIComponent(mTransaction)
                    + '&SupUrl=' + encodeURIComponent(mSupUrl)
                    + '&OriginalUrn=' + encodeURIComponent(mOriginalUrn)
                    + '&ApiName=' + encodeURIComponent(mApiName);
            }

            closeModal();
            location.replace(url);
        });

        document.getElementById('detailsBtn').addEventListener('click', function() {
            var viewCat = mCat;
            if(viewCat === 'I4C') viewCat = 'ThirdParty';

            if(mApi != '' && mApi != 'N/A') {
                var url = '<%=request.getContextPath()%>/showFailureServicesWise.action'
                    + '?url=' + encodeURIComponent(mApi)
                    + '&ServiceCategory=' + encodeURIComponent(viewCat);
                window.open(url, '_blank');
            } else {
                alert('No service name available for details.');
            }
        });
    });

    document.getElementById('modalContainer').addEventListener('click', function(e) {
        if(e.target === this) closeModal();
    });
    document.addEventListener('keydown', function(e) {
        if(e.key === 'Escape') closeModal();
    });
</script>

</body>
</html>

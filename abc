<style>
.button-container{
        display: flex;
        justify-content: flex-end;
        margin-right: 10px; 
}

.button{
  padding: 10px 20px;
  border: none;
  border-radius:5px;
  cursor: pointer;
  margin-right: 10px; 
}

.card-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 30px;
}
.card {
    width: 310px;
    height: 180px;
    margin: 10px;
    text-align: center;
    transition: transform 0.3s ease, background-color 0.3s ease;
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    color: white;
    cursor: pointer;
}
.card:hover {
    transform: scale(1.05);
}
.card-zero {
    background-color: #dc3545; /* Red for zero hits */
}
.card-zero:hover {
    background-color: #c82333; /* Darker red on hover */
}
.card-nonzero {
    background-color: #007bff; /* Blue for non-zero hits */
}
.card-nonzero:hover {
    background-color: #0056b3; /* Darker blue on hover */
}
.card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
}
.card-info {
    font-size: 14px;
}
.card-title {
    font-weight: bold;
    margin-bottom: 10px;
    font-size: 18px;
}
.section {
    margin-bottom: 30px;
}
.timer {
    border: 5px solid white;
    display: inline;
    padding: 5px;
    color: black;
    font-family: Verdana, sans-serif, Arial;
    font-size: 40px;
    height: 50px;
    font-weight: bold;
    text-decoration: none;
}
.wait {
    font-family: arial;
    font-size: 13px;
    color: #ff0000;
    font-weight: bold;
    zoom: 10%;
}
</style>

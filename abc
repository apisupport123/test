<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="java.util.*"%>
<%@page import="java.sql.*"%>
<%@page import="com.jdbc.DBUtilityAuto" %>
<%@page import="com.jdbc.DBUtility" %>
<%@page import="java.time.ZoneId, java.time.ZonedDateTime, java.time.format.DateTimeFormatter, java.util.Locale" %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Transaction Monitor</title>

<script nonce="undefined" src="../js/zingchart.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="../js/LdapAuth.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #09090b;
    --surface: #121215;
    --surface-2: #18181c;
    --border: #27272a;
    --text: #fafafa;
    --text-muted: #a1a1aa;
    --crit: #ef4444;
    --warn: #f59e0b;
    --ok: #10b981;
    --mono: 'JetBrains Mono', monospace;
    --sans: 'Inter', -apple-system, sans-serif;
  }

  html, body {
    height: 100%;
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    font-size: 16px;
    overflow-x: hidden;
  }

  /* ============ HEADER ============ */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 32px;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .brand-mark {
    width: 44px;
    height: 44px;
    background: #6366f1;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--mono);
    font-size: 20px;
    font-weight: 700;
    color: #fff;
  }

  .brand h1 {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .brand .sub {
    font-size: 13px;
    color: var(--text-muted);
    font-family: var(--mono);
    margin-top: 2px;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .session {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--text-muted);
  }
  .session b { color: var(--text); font-size: 16px; }

  .live-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ok);
    letter-spacing: 0.5px;
  }

  .live-badge .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ok);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .countdown {
    font-family: var(--mono);
    font-size: 18px;
    font-weight: 700;
    color: #6366f1;
    padding: 10px 18px;
    border: 1px solid var(--border);
    border-radius: 8px;
    min-width: 90px;
    text-align: center;
  }
  .countdown.low { color: var(--crit); border-color: rgba(239,68,68,0.3); }

  /* ============ KPI ROW ============ */
  .kpi-row {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border-bottom: 1px solid var(--border);
  }

  .kpi {
    background: var(--bg);
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .kpi-label {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--text-muted);
  }

  .kpi-value {
    font-family: var(--mono);
    font-size: 56px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -2px;
  }

  .kpi-value.crit { color: var(--crit); }
  .kpi-value.warn { color: var(--warn); }
  .kpi-value.ok { color: var(--ok); }

  .kpi-sub {
    font-size: 13px;
    color: var(--text-muted);
    font-family: var(--mono);
  }

  /* ============ MAIN ============ */
  .main {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 20px;
    padding: 20px 32px 32px;
    min-height: calc(100vh - 220px);
  }

  /* ============ CHART PANEL ============ */
  .chart-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .chart-head {
    padding: 22px 26px;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .chart-head h2 {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.3px;
  }

  .chart-head p {
    font-size: 13px;
    color: var(--text-muted);
    font-family: var(--mono);
    margin-top: 4px;
  }

  .chart-badge {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-muted);
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  #myChart {
    flex: 1;
    min-height: 600px;
    width: 100%;
  }

  /* ============ SIDE ============ */
  .side {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }

  .card-head {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
  }

  .card-body {
    padding: 18px 20px;
  }

  /* Severity rows — thick colored left border */
  .sev {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    font-size: 16px;
    font-weight: 600;
  }
  .sev + .sev { border-top: 1px solid var(--border); }

  .sev-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .sev-block {
    width: 6px;
    height: 32px;
    border-radius: 3px;
  }

  .sev-range {
    font-family: var(--mono);
    font-size: 14px;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Critical list — big numbers */
  .crit-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .crit-row:last-child { border-bottom: none; }

  .crit-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .crit-pct {
    font-family: var(--mono);
    font-size: 22px;
    font-weight: 700;
    color: var(--crit);
  }

  .empty-msg {
    font-size: 15px;
    color: var(--text-muted);
    text-align: center;
    padding: 20px 0;
    font-family: var(--mono);
  }

  /* Help */
  .help {
    font-size: 14px;
    line-height: 2;
    color: var(--text-muted);
  }
  .help b { color: var(--text); font-weight: 600; }

  /* Progress bar */
  .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0;
    background: #6366f1;
    z-index: 999;
  }
  .progress-bar.active {
    animation: load 0.8s ease-in-out infinite;
  }
  @keyframes load {
    0% { width: 5%; opacity: 1; }
    50% { width: 70%; opacity: 1; }
    100% { width: 95%; opacity: 0.3; }
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .main { grid-template-columns: 1fr; }
    .side { display: grid; grid-template-columns: repeat(3, 1fr); }
    .kpi-row { grid-template-columns: repeat(2, 1fr); }
    .kpi-value { font-size: 42px; }
  }
  @media (max-width: 700px) {
    .side { grid-template-columns: 1fr; }
    .kpi-row { grid-template-columns: 1fr 1fr; }
    .kpi-value { font-size: 36px; }
    .header { padding: 16px; flex-wrap: wrap; gap: 12px; }
    .session { display: none; }
    .main { padding: 16px; }
  }
</style>
</head>

<body onload="myFunction_Time()">

<div class="progress-bar" id="progressBar"></div>

<!-- ============ HEADER ============ -->
<header class="header">
  <div class="brand">
    <div class="brand-mark">T</div>
    <div>
      <h1>Transaction Monitor</h1>
      <div class="sub">endpoint_failure // last 10 min</div>
    </div>
  </div>

  <div class="header-right">
    <div class="session" id="sessionInfo"></div>
    <div class="live-badge">
      <span class="dot"></span>
      LIVE
    </div>
    <div class="countdown" id="countdownNum">10:00</div>
  </div>
</header>

<!-- ============ KPI ROW ============ -->
<div class="kpi-row">
  <div class="kpi">
    <div class="kpi-label">Endpoints Monitored</div>
    <div class="kpi-value" id="statTotal">—</div>
    <div class="kpi-sub">unique endpoints with failures</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Critical &gt; 5%</div>
    <div class="kpi-value crit" id="statCritical">—</div>
    <div class="kpi-sub">immediate action</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">High / Medium</div>
    <div class="kpi-value warn" id="statWarning">—</div>
    <div class="kpi-sub">monitor closely</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Highest Failure</div>
    <div class="kpi-value" id="statMax">—</div>
    <div class="kpi-sub">worst performer</div>
  </div>
</div>

<!-- ============ MAIN ============ -->
<div class="main">

  <section class="chart-panel">
    <div class="chart-head">
      <div>
        <h2>Failure % by Endpoint</h2>
        <p>top 12 &middot; sorted desc</p>
      </div>
      <div class="chart-badge">auto-refresh 10m</div>
    </div>
    <div id="myChart"></div>
  </section>

  <aside class="side">
    <div class="card">
      <div class="card-head">Severity</div>
      <div class="card-body">
        <div class="sev">
          <div class="sev-left">
            <span class="sev-block" style="background:#ef4444;"></span>
            <span>Critical</span>
          </div>
          <span class="sev-range">&gt; 5%</span>
        </div>
        <div class="sev">
          <div class="sev-left">
            <span class="sev-block" style="background:#f59e0b;"></span>
            <span>High</span>
          </div>
          <span class="sev-range">2 – 5%</span>
        </div>
        <div class="sev">
          <div class="sev-left">
            <span class="sev-block" style="background:#8b5cf6;"></span>
            <span>Medium</span>
          </div>
          <span class="sev-range">1 – 2%</span>
        </div>
        <div class="sev">
          <div class="sev-left">
            <span class="sev-block" style="background:#10b981;"></span>
            <span>Low</span>
          </div>
          <span class="sev-range">&lt; 1%</span>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">Top Critical</div>
      <div class="card-body" id="critList">
        <div class="empty-msg">loading…</div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">Legend</div>
      <div class="card-body">
        <div class="help">
          Bar height = <b>failure %</b><br>
          Bar color = <b>severity</b><br>
          <b style="color:#f59e0b;">Orange</b> → TD Count<br>
          <b style="color:#fafafa;">White</b> → Endpoint<br>
          <b style="color:#10b981;">Green</b> → Total Hits<br>
          <span style="color:#6366f1;">Click bar → drill down</span>
        </div>
      </div>
    </div>
  </aside>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var now = new Date();
  var past = new Date();
  past.setMinutes(now.getMinutes() - 10);
  function fmt(d) {
    var h = d.getHours(), m = d.getMinutes();
    return (h < 10 ? '0' + h : h) + ':' + (m < 10 ? '0' + m : m);
  }
  document.getElementById('sessionInfo').innerHTML =
    '<b>' + fmt(past) + '</b> → <b>' + fmt(now) + '</b>';
});
function myFunction_Time() {
  var demo = document.getElementById("demo");
  if (demo) demo.innerHTML = document.lastModified;
}
</script>

<%
/* ============ BACKEND ============ */
response.setIntHeader("Refresh", 600);

Connection conn = null;
Statement statement = null;
ResultSet resultSet = null;

List<String> labels = new ArrayList<String>();
List<String> rawNames = new ArrayList<String>();
List<Double> failure = new ArrayList<Double>();
List<Integer> tdCounts = new ArrayList<Integer>();
List<Integer> totalHits = new ArrayList<Integer>();

try {
    conn = DBUtilityAuto.getIIBDBConnection();

    ZonedDateTime CurrentDate = ZonedDateTime.now(ZoneId.of("Asia/Kolkata"));
    DateTimeFormatter formatter = DateTimeFormatter.ofPattern("MMM_yy").withLocale(Locale.US);
    String PART = CurrentDate.format(formatter).toUpperCase();

    String sql = "Select * from("
        + "select txn_endpoint, "
        + "COUNT(1) AS TOTAL_HITS, "
        + "SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END) AS TD_COUNT, "
        + "ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT "
        + "from eisapp.backend_log PARTITION(" + PART + ") "
        + "where txn_endpoint != 'NATIONAL_PORTAL' "
        + "and REQUEST_DATE_TIME>=SYSDATE - INTERVAL '10' MINUTE "
        + "GROUP BY txn_endpoint "
        + "having ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END)*100)/COUNT(1),2)>= 0.5 "
        + "order by TD_PERCENT desc"
        + ") where ROWNUM <=12";

    statement = conn.createStatement();
    resultSet = statement.executeQuery(sql);

    while (resultSet.next()) {
        String rawName = resultSet.getString("txn_endpoint");
        int tdCount = resultSet.getInt("TD_COUNT");
        int totalHit = resultSet.getInt("TOTAL_HITS");
        double pct = resultSet.getDouble("TD_PERCENT");

        String label = "<span style='color:#f59e0b;font-weight:700;font-size:18px;font-family:JetBrains Mono,monospace;'>" + tdCount + "</span>"
            + "<br><span style='color:#fafafa;font-weight:600;font-size:13px;'>"
            + rawName.replaceAll("_", "_<br>") + "</span>"
            + "<br><span style='color:#10b981;font-weight:700;font-size:16px;font-family:JetBrains Mono,monospace;'>" + totalHit + "</span>";

        labels.add(label);
        rawNames.add(rawName);
        failure.add(pct);
        tdCounts.add(tdCount);
        totalHits.add(totalHit);
    }
} catch (Exception e) {
    e.printStackTrace();
} finally {
    try { if (resultSet != null) resultSet.close(); } catch (Exception ignored) {}
    try { if (statement != null) statement.close(); } catch (Exception ignored) {}
    try { if (conn != null) conn.close(); } catch (Exception ignored) {}
}

while (labels.size() < 5) {
    labels.add("&nbsp;");
    rawNames.add("");
    failure.add(0.0);
    tdCounts.add(0);
    totalHits.add(0);
}
%>

<script>
var labelArr = [
<%
for (int k = 0; k < labels.size(); k++) {
    String lbl = labels.get(k).replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "").replace("\r", "");
    out.print("\"" + lbl + "\"");
    if (k < labels.size() - 1) out.print(",");
}
%>
];

var nameArr = [
<%
for (int k = 0; k < rawNames.size(); k++) {
    String n = rawNames.get(k).replace("\\", "\\\\").replace("\"", "\\\"");
    out.print("\"" + n + "\"");
    if (k < rawNames.size() - 1) out.print(",");
}
%>
];

var valueArr = [
<%
for (int k = 0; k < failure.size(); k++) {
    out.print(failure.get(k));
    if (k < failure.size() - 1) out.print(",");
}
%>
];

var tdArr = [
<%
for (int k = 0; k < tdCounts.size(); k++) {
    out.print(tdCounts.get(k));
    if (k < tdCounts.size() - 1) out.print(",");
}
%>
];

var totalArr = [
<%
for (int k = 0; k < totalHits.size(); k++) {
    out.print(totalHits.get(k));
    if (k < totalHits.size() - 1) out.print(",");
}
%>
];

/* ============ STATS ============ */
(function computeStats() {
  var totalEndpoints = 0, critical = 0, warning = 0, maxVal = 0;
  for (var i = 0; i < nameArr.length; i++) {
    if (!nameArr[i]) continue;
    totalEndpoints++;
    if (valueArr[i] >= 5) critical++;
    else if (valueArr[i] >= 1) warning++;
    if (valueArr[i] > maxVal) maxVal = valueArr[i];
  }
  document.getElementById('statTotal').textContent = totalEndpoints;
  document.getElementById('statCritical').textContent = critical;
  document.getElementById('statWarning').textContent = warning;
  var maxEl = document.getElementById('statMax');
  maxEl.textContent = maxVal.toFixed(2) + '%';
  maxEl.className = 'kpi-value ' + (maxVal >= 5 ? 'crit' : (maxVal >= 2 ? 'warn' : 'ok'));
})();

/* ============ CRITICAL LIST ============ */
(function buildCritList() {
  var items = [];
  for (var k = 0; k < nameArr.length; k++) {
    if (nameArr[k] && valueArr[k] > 0) {
      items.push({ name: nameArr[k], pct: valueArr[k] });
    }
  }
  items.sort(function(a, b) { return b.pct - a.pct; });
  var top = items.slice(0, 5);
  var box = document.getElementById('critList');
  if (!top.length) {
    box.innerHTML = '<div class="empty-msg">all_clear ✓</div>';
    return;
  }
  box.innerHTML = top.map(function(it) {
    return '<div class="crit-row">'
      + '<span class="crit-name" title="' + it.name + '">' + it.name + '</span>'
      + '<span class="crit-pct">' + it.pct + '%</span>'
      + '</div>';
  }).join('');
})();

/* ============ BAR COLORS ============ */
var barColors = valueArr.map(function(v) {
  if (v >= 5) return "#ef4444";
  if (v >= 2) return "#f59e0b";
  if (v >= 1) return "#8b5cf6";
  return "#10b981";
});

/* ============ CHART — clean 2D bar, large fonts ============ */
var chartConfig = {
  type: "bar",
  backgroundColor: "transparent",
  plotarea: {
    backgroundColor: "transparent",
    margin: "80px 40px 180px 90px"
  },
  globals: {
    fontFamily: "Inter, sans-serif"
  },
  scaleX: {
    values: labelArr,
    lineColor: "#27272a",
    tick: { visible: false },
    item: { fontColor: "#fafafa", fontSize: 13 },
    guide: { visible: false }
  },
  scaleY: {
    lineColor: "#27272a",
    guide: {
      visible: true,
      lineColor: "#18181c",
      lineStyle: "solid"
    },
    tick: { lineColor: "#27272a", visible: true },
    item: { fontColor: "#a1a1aa", fontSize: 14, fontFamily: "JetBrains Mono, monospace", paddingRight: 10 },
    label: {
      text: "FAILURE %",
      fontColor: "#a1a1aa",
      fontSize: 12,
      fontFamily: "JetBrains Mono, monospace",
      offsetX: -10
    }
  },
  plot: {
    animation: { effect: "ANIMATION_SLIDE_BOTTOM", speed: 600, delay: 40, sequence: "ANIMATION_BY_NODE" },
    tooltip: {
      text: "<b>%kl</b><br>failure: %v%",
      backgroundColor: "#18181c",
      borderColor: "#27272a",
      borderWidth: 1,
      borderRadius: "6px",
      fontColor: "#fafafa",
      fontSize: 14,
      padding: "10px 14px",
      shadow: false
    },
    barWidth: "40%",
    borderWidth: 0,
    styles: barColors
  },
  series: [{
    values: valueArr,
    "value-box": {
      visible: true,
      text: "%v%",
      placement: "top",
      fontColor: "#fafafa",
      fontSize: 14,
      fontFamily: "JetBrains Mono, monospace",
      fontWeight: "700",
      offsetY: -6
    }
  }]
};

function updateChart(p) {
  var idx = p.nodeindex;
  if (!nameArr[idx]) return;
  var url = '<%=request.getContextPath() + "/jsp/TransactionEndpointWiseService.jsp?txnEndPoint="%>' + encodeURIComponent(nameArr[idx]);
  window.open(url, '_blank');
}

zingchart.render({
  id: 'myChart',
  data: chartConfig,
  height: '100%',
  width: '100%'
});

zingchart.bind('myChart', 'node_click', updateChart);
</script>

<script>
(function countdown() {
  var total = 10 * 60;
  var left = total;
  var num = document.getElementById('countdownNum');
  var bar = document.getElementById('progressBar');

  function tick() {
    left--;
    if (left <= 0) {
      bar.classList.add('active');
      return;
    }
    var m = Math.floor(left / 60);
    var s = left % 60;
    num.textContent = m + ':' + (s < 10 ? '0' + s : s);
    if (left <= 60) num.classList.add('low');
  }
  setInterval(tick, 1000);
})();
</script>

</body>
</html>

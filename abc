select /+parallel(32)/
REQ_REF_NO || '^'||
REQ_DATE_TIME || '^'||
REQ_BRANCH || '^'||
upper(REQ_KIOSKID) || '^'||
RESP_DATE_TIME || '^'||
ACK_DATE_TIME || '^'||
RESP_CODE || '^'||
ERROR_CODE || '^'||
trim(ERROR_DESC) || '^'||
STATUS || '^'||
DEC_ACC_NO
from
(
SELECT
a.urn REQ_REF_NO,
a.request_date_time REQ_DATE_TIME,
JSON_VALUE(b.input_data, '$.BRANCH_CODE') REQ_BRANCH,
Upper(JSON_VALUE(b.input_data, '$.REQ_KIOSK_ID')) REQ_KIOSKID,
a.response_date_time RESP_DATE_TIME,
null as ACK_DATE_TIME,
a.response_status RESP_CODE,
a.error_code ERROR_CODE,
trim(a.error_description) ERROR_DESC,
case when a.response_status = '0' then 'RCV'
when a.error_code BETWEEN '0' and '9999' then 'NEG'
else 'ERR'
end as status,
JSON_VALUE(d.input_data, '$.BARCODE') DEC_ACC_NO
FROM
eisapp.api_log a,
eisapp.api_details b,
eisapp.orch_api_log c,
eisapp.orch_api_details d
WHERE
a.urn = b.urn
AND a.urn = c.urn
AND a.urn = d.urn
AND c.urn_child = d.urn_child
AND c.url = 'http://system.api:9010/NBC/001650/bancs/cbs/accounts'
and a.url = 'http://eispri.sbi.co.in:3010/passbook_th/printTxn/accounts'
AND
--a.request_date_time>= sysdate - interval '10' minute
trunc(a.request_date_time) = '$testing1'
union all
SELECT * FROM ( WITH tempap as (select JSON_VALUE(input_data, '$.PRINT_REFERENCE_NUMBER') as urn from eisapp.api_details where urn in (
SELECT urn FROM EISAPP.API_LOG WHERE URL='http://eispri.sbi.co.in:3010/passbook_th/negativeAck/accounts' and
trunc(request_date_time)= '$testing1'))
SELECT
a.urn REQ_REF_NO,
a.request_date_time REQ_DATE_TIME,
JSON_VALUE(b.input_data, '$.BRANCH_CODE') REQ_BRANCH,
Upper(JSON_VALUE(b.input_data, '$.REQ_KIOSK_ID')) REQ_KIOSKID,
a.response_date_time RESP_DATE_TIME,
null as ACK_DATE_TIME,
a.response_status RESP_CODE,
a.error_code ERROR_CODE,
a.error_description ERROR_DESC,
'NACK' as status,
JSON_VALUE(d.input_data, '$.BARCODE') DEC_ACC_NO
FROM
eisapp.api_log a,
eisapp.api_details b,
eisapp.orch_api_log c,
eisapp.orch_api_details d,
tempap
WHERE
a.urn = b.urn
AND a.urn = c.urn
AND a.urn = d.urn
AND c.urn_child = d.urn_child
AND a.urn = tempap.urn
AND c.url = 'http://system.api:9010/NBC/001650/bancs/cbs/accounts'
AND trunc(a.request_date_time) = '$testing1')
union all
select REQ_REF_NO,
REQ_DATE_TIME,
REQ_BRANCH,
REQ_KIOSKID,
RESP_DATE_TIME,
ACK_DATE_TIME,
RESP_CODE,
ERROR_CODE,
ERROR_DESC,
STATUS,
DEC_ACC_NO
from EISAPP.passbook_table
where status='REP' AND
trunc(REQ_DATE_TIME)='$testing1');

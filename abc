                if (policeBytes != null)
                    System.out.println("[UPLOAD] POLICE read " + policeBytes.length + " bytes");
            }

            // --- CV ---
            File cvFile = form.getM_strtheCvfile();
            String cvName = form.getM_strtheCvfileFileName();
            System.out.println("[UPLOAD] CV file=" + cvFile + " name=" + cvName);
            if (cvFile != null && cvName != null && !cvName.trim().isEmpty()) {
                cvBytes = readFileBytes(cvFile);
                if (cvBytes != null)
                    System.out.println("[UPLOAD] CV read " + cvBytes.length + " bytes");
            }

            // ============================================================
            // INSERT — eisupport_employee_master
            // ============================================================
            String sqlEmp =
                    "INSERT INTO eisupport_employee_master ("
                  + "EMPLOYEE_ID,AD_ID,ASSET_ID,EDU_QUALIFICATION,TCS_JOINING_DATE,CONTACTNUMBER,"
                  + "EMERGENCY_CONTACTNUMBER,TEAM,TCS_MAILID,STATE,CITY,LOCAL_ADDRESS,GENDER,DOB,FIRSTNAME,"
                  + "MIDDLENAME,LASTNAME,VPN_HOSTNAME,LAPTOP_HOSTNAME,REMOTETYPE,VPN_VDI_MACADDRESS,"
                  + "VPN_VDI_IPADDRESS,CV_DOCUMENT_PATH,BGC_DOCUMENT_PATH,PHOTO_PATH,POLICE_VERIFICATION_PATH,"
                  + "USERNAME,PASSWORD,HID,SBI_MAILID) "
                  + "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)";

            psEmp = con.prepareStatement(sqlEmp);
            bindInsertParams(psEmp, request, cvBytes, bgcBytes, photoBytes, policeBytes);
            psEmp.executeUpdate();
            System.out.println("[DEBUG] Inserted into eisupport_employee_master");

            // ============================================================
            // INSERT — roster_employee_details
            // ============================================================
            String sqlRoster =
                    "INSERT INTO roster_employee_details ("
                  + "EMPLOYEE_ID,AD_ID,ASSET_ID,EDU_QUALIFICATION,TCS_JOINING_DATE,CONTACTNUMBER,"
                  + "EMERGENCY_CONTACTNUMBER,TEAM,TCS_MAILID,STATE,CITY,LOCAL_ADDRESS,GENDER,DOB,FIRSTNAME,"

package com.action;

import java.sql.Connection;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.ArrayList;
import java.util.List;

import org.apache.struts2.ServletActionContext;
import com.opensymphony.xwork2.ActionSupport;
import com.opensymphony.xwork2.ModelDriven;

import com.actionform.LoginForm;
import com.jdbc.DBUtilityAuto;
import com.jdbc.TrippleDes;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpSession;

@SuppressWarnings("serial")
public class LoginAction extends ActionSupport implements ModelDriven<LoginForm> {

    private LoginForm loginForm = new LoginForm(); // ModelDriven object

    @Override
    public LoginForm getModel() {
        return loginForm;
    }

    public List<String> getRolelist() {
        return loginForm.getRolelist();
    }

    // ðŸ”§ Default execute method: load roles
    @Override
    public String execute() throws Exception {
        System.out.println(">>> LoginAction.execute() called!.");
        HttpServletRequest request = ServletActionContext.getRequest();

        // Populate roles into loginForm
        this.getEISRole(loginForm);
        System.out.println("Roles Loaded : " + loginForm.getRolelist());

        return "success"; // just load login page with roles
    }

    // ðŸ”§ Called when form is submitted to login!usersign.action
    public String usersign() throws Exception {
        System.out.println(">>> usersign() called");

        HttpServletRequest request = ServletActionContext.getRequest();

        if (request.getParameter("m_struserPassword") != null) {
            boolean hasRole = this.checkRole(loginForm, request);

            if (hasRole) {
                HttpSession session = request.getSession();
                session.setAttribute("role", request.getParameter("m_strRole"));

                if ("EIS Bank".equals(request.getParameter("m_strRole"))) {
                    return "successbanker";
                } else {
                    return "successuser"; // triggers redirect to userhomescreen
                }
            } else {
                loginForm.setM_strMessage("Validation failed");
                return "success";
            }
        }

        return "success";
    }

    // ðŸ”§ Called when form is submitted to login!adminsign.action
    public String adminsign() throws Exception {
        System.out.println(">>> adminsign() called");

        HttpServletRequest request = ServletActionContext.getRequest();
        String m_stradminUserName = request.getParameter("m_stradminUserName");

        if ("Admin".equalsIgnoreCase(m_stradminUserName)
                && "admin".equals(request.getParameter("m_stradminPassword"))) {
            return "successadmin";
        } else {
            // Check module user
            String user = m_stradminUserName;
            Connection con = DBUtilityAuto.getReportDBConnection();
            String query = "SELECT * FROM a_module_leads WHERE LOWER(username) = LOWER('" + user + "')";
            Statement stmt = con.createStatement();
            ResultSet rs = stmt.executeQuery(query);

            String password = null;

            if (rs.next()) {
                password = rs.getString("passwords");
            }

            rs.close();
            stmt.close();
            con.close();

            if (password != null && password.equals(request.getParameter("m_stradminPassword"))) {
                return "successmodule";
            }
        }

        return "success";
    }

    // For REST plugin
    public String index() throws Exception {
        return execute();
    }

    private boolean checkRole(LoginForm loginForm, HttpServletRequest request) throws SQLException {
        Connection con = DBUtilityAuto.getReportDBConnection();
        Statement stmt = null;
        ResultSet rs = null;

        try {
            TrippleDes td = new TrippleDes();
            int count = 0;

            String query = "SELECT COUNT(1) FROM rolemst WHERE username LIKE '%" + request.getParameter("m_strUserName") + "%' "
                    + "AND password='" + td.encrypt(request.getParameter("m_struserPassword").trim()) + "' "
                    + "AND rolename='" + request.getParameter("m_strRole") + "'";

            stmt = con.createStatement();
            rs = stmt.executeQuery(query);

            if (rs.next()) {
                count = rs.getInt(1);
            }

            return count > 0;

        } catch (Exception e) {
            e.printStackTrace();
            return false;
        } finally {
            if (rs != null) rs.close();
            if (stmt != null) stmt.close();
            if (con != null) con.close();
        }
    }

    private void getEISRole(LoginForm loginForm) throws SQLException {
        Connection con = DBUtilityAuto.getReportDBConnection();
        Statement stmt = null;
        ResultSet rs = null;

        try {
            ArrayList<String> list = new ArrayList<>();
            //list.add("Select Role");

            String query = "SELECT rolename FROM rolemst";
            stmt = con.createStatement();
            rs = stmt.executeQuery(query);

            while (rs.next()) {
                list.add(rs.getString("rolename"));
            }

            loginForm.setRolelist(list);
            System.out.println("Roles loaded: " + list);
        } catch (Exception e) {
            e.printStackTrace();
        } finally {
            if (rs != null) rs.close();
            if (stmt != null) stmt.close();
            if (con != null) con.close();
        }
    }
}

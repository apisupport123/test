<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="java.util.*"%>
<%@page import="java.sql.*"%>
<%@page import="com.jdbc.DBUtilityAuto" %>
<%@page import="com.jdbc.DBUtility" %>
<%@page import="java.time.ZoneId, java.time.ZonedDateTime, java.time.format.DateTimeFormatter, java.util.Locale" %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Transaction Endpoint Monitor</title>

<script nonce="undefined" src="../js/zingchart.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="../js/LdapAuth.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    height: 100%;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: #0d1117;
    color: #e6edf3;
    font-size: 14px;
    overflow-x: hidden;
  }

  /* ============ TOP HEADER ============ */
  .header {
    background: #161b22;
    border-bottom: 1px solid #21262d;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .header-left .brand-icon {
    width: 32px;
    height: 32px;
    background: #1f6feb;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 16px;
    color: #fff;
  }

  .header-left .title-block h1 {
    font-size: 15px;
    font-weight: 600;
    color: #e6edf3;
    letter-spacing: 0.2px;
  }

  .header-left .title-block .sub {
    font-size: 11px;
    color: #8b949e;
    margin-top: 2px;
    letter-spacing: 0.4px;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .session-info {
    font-size: 12px;
    color: #8b949e;
  }
  .session-info b { color: #e6edf3; font-weight: 500; }

  .refresh-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #21262d;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    color: #8b949e;
  }
  .refresh-badge .countdown {
    font-family: 'Courier New', monospace;
    font-weight: 700;
    color: #58a6ff;
    font-size: 13px;
    min-width: 36px;
    text-align: right;
  }
  .refresh-badge.low .countdown { color: #f85149; }

  /* Live dot */
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3fb950;
    box-shadow: 0 0 0 3px rgba(63, 185, 80, 0.2);
    animation: livePulse 2s infinite;
  }
  @keyframes livePulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(63, 185, 80, 0.2); }
    50%      { box-shadow: 0 0 0 5px rgba(63, 185, 80, 0.05); }
  }

  /* ============ STATS BAR ============ */
  .stats-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: #21262d;
    border-bottom: 1px solid #21262d;
  }

  .stat {
    background: #0d1117;
    padding: 14px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stat-label {
    font-size: 11px;
    color: #8b949e;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 500;
  }
  .stat-value {
    font-size: 22px;
    font-weight: 700;
    color: #e6edf3;
    font-family: 'Courier New', monospace;
    line-height: 1;
  }
  .stat-value.critical { color: #f85149; }
  .stat-value.warning  { color: #d29922; }
  .stat-value.ok       { color: #3fb950; }

  /* ============ MAIN LAYOUT ============ */
  .main {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 16px;
    padding: 16px 24px 24px;
    min-height: calc(100vh - 160px);
  }

  /* ============ SIDE PANEL ============ */
  .side {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .panel {
    background: #161b22;
    border: 1px solid #21262d;
    border-radius: 8px;
    overflow: hidden;
  }

  .panel-head {
    padding: 10px 14px;
    background: #0d1117;
    border-bottom: 1px solid #21262d;
    font-size: 11px;
    font-weight: 600;
    color: #8b949e;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .panel-body {
    padding: 12px 14px;
  }

  /* Legend */
  .legend-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 0;
    font-size: 12px;
    color: #c9d1d9;
  }
  .legend-item + .legend-item { border-top: 1px solid #21262d; }
  .legend-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .legend-swatch {
    width: 12px;
    height: 12px;
    border-radius: 2px;
  }
  .legend-range {
    color: #8b949e;
    font-family: 'Courier New', monospace;
    font-size: 11px;
  }

  /* Critical list */
  .crit-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9px 0;
    font-size: 12px;
    border-bottom: 1px solid #21262d;
  }
  .crit-item:last-child { border-bottom: none; }
  .crit-item .name {
    color: #c9d1d9;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 160px;
  }
  .crit-item .val {
    color: #f85149;
    font-weight: 700;
    font-family: 'Courier New', monospace;
    font-size: 12px;
  }

  .empty-note {
    color: #6e7681;
    font-size: 12px;
    text-align: center;
    padding: 14px 0;
  }

  .help-text {
    font-size: 12px;
    line-height: 1.7;
    color: #8b949e;
  }
  .help-text b { color: #e6edf3; font-weight: 600; }

  /* ============ CHART PANEL ============ */
  .chart-panel {
    background: #161b22;
    border: 1px solid #21262d;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .chart-head {
    padding: 12px 16px;
    border-bottom: 1px solid #21262d;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .chart-head-left h2 {
    font-size: 14px;
    font-weight: 600;
    color: #e6edf3;
  }
  .chart-head-left p {
    font-size: 11px;
    color: #8b949e;
    margin-top: 3px;
    letter-spacing: 0.3px;
  }
  .chart-head-right {
    font-size: 11px;
    color: #8b949e;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #myChart {
    width: 100%;
    flex: 1;
    min-height: 620px;
  }

  /* ============ TOP PROGRESS BAR (refresh) ============ */
  .top-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: #58a6ff;
    z-index: 200;
    transition: width 0.9s linear;
  }
  .top-progress.active {
    animation: loadBar 0.8s ease-in-out infinite;
  }
  @keyframes loadBar {
    0%   { width: 5%;  opacity: 1; }
    50%  { width: 70%; opacity: 1; }
    100% { width: 95%; opacity: 0.4; }
  }

  /* Responsive */
  @media (max-width: 1000px) {
    .main { grid-template-columns: 1fr; }
    .stats-bar { grid-template-columns: repeat(2, 1fr); }
    .session-info { display: none; }
  }
</style>
</head>

<body onload="myFunction_Time()">

<div class="top-progress" id="topProgress"></div>

<!-- ============ HEADER ============ -->
<header class="header">
  <div class="header-left">
    <div class="brand-icon">T</div>
    <div class="title-block">
      <h1>Transaction Endpoint Monitor</h1>
      <div class="sub">Failure analytics &middot; Last 10 minutes &middot; Auto-refresh</div>
    </div>
  </div>

  <div class="header-right">
    <div class="session-info" id="timeRangeMessage"></div>
    <div class="refresh-badge" id="refreshBadge">
      <span class="live-dot"></span>
      <span>Next refresh</span>
      <span class="countdown" id="countdownNum">10:00</span>
    </div>
  </div>
</header>

<!-- ============ STATS BAR ============ -->
<div class="stats-bar">
  <div class="stat">
    <div class="stat-label">Total Endpoints</div>
    <div class="stat-value" id="statTotal">—</div>
  </div>
  <div class="stat">
    <div class="stat-label">Critical (&gt;5%)</div>
    <div class="stat-value critical" id="statCritical">—</div>
  </div>
  <div class="stat">
    <div class="stat-label">High / Medium</div>
    <div class="stat-value warning" id="statWarning">—</div>
  </div>
  <div class="stat">
    <div class="stat-label">Highest Failure</div>
    <div class="stat-value" id="statMax">—</div>
  </div>
</div>

<!-- ============ MAIN ============ -->
<div class="main">

  <!-- SIDE PANEL -->
  <aside class="side">
    <div class="panel">
      <div class="panel-head">Severity Scale</div>
      <div class="panel-body">
        <div class="legend-item">
          <div class="legend-left">
            <span class="legend-swatch" style="background:#f85149;"></span>
            <span>Critical</span>
          </div>
          <span class="legend-range">&gt; 5.0%</span>
        </div>
        <div class="legend-item">
          <div class="legend-left">
            <span class="legend-swatch" style="background:#d29922;"></span>
            <span>High</span>
          </div>
          <span class="legend-range">2.0 – 5.0%</span>
        </div>
        <div class="legend-item">
          <div class="legend-left">
            <span class="legend-swatch" style="background:#a371f7;"></span>
            <span>Medium</span>
          </div>
          <span class="legend-range">1.0 – 2.0%</span>
        </div>
        <div class="legend-item">
          <div class="legend-left">
            <span class="legend-swatch" style="background:#3fb950;"></span>
            <span>Low</span>
          </div>
          <span class="legend-range">&lt; 1.0%</span>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">Top Critical Endpoints</div>
      <div class="panel-body" id="critList">
        <div class="empty-note">Loading…</div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head">Reading Guide</div>
      <div class="panel-body">
        <div class="help-text">
          Chart bar height = <b>failure %</b>.<br>
          Bar color = <b>severity</b>.<br>
          X-axis label shows:<br>
          &nbsp;&nbsp;<b style="color:#d29922;">Orange</b> – TD count<br>
          &nbsp;&nbsp;<b style="color:#e6edf3;">White</b> – Endpoint<br>
          &nbsp;&nbsp;<b style="color:#3fb950;">Green</b> – Total hits<br>
          <span style="display:block;margin-top:8px;color:#58a6ff;">Click a bar to drill down.</span>
        </div>
      </div>
    </div>
  </aside>

  <!-- CHART -->
  <section class="chart-panel">
    <div class="chart-head">
      <div class="chart-head-left">
        <h2>Failure % by Endpoint</h2>
        <p>Top 12 endpoints sorted by failure rate</p>
      </div>
      <div class="chart-head-right">
        <span class="live-dot"></span>
        <span>Live</span>
      </div>
    </div>
    <div id="myChart"></div>
  </section>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var currentTime = new Date();
  var tenMinutesAgo = new Date();
  tenMinutesAgo.setMinutes(currentTime.getMinutes() - 10);

  function fmt(d) {
    var h = d.getHours(), m = d.getMinutes();
    return (h < 10 ? '0' + h : h) + ':' + (m < 10 ? '0' + m : m);
  }
  document.getElementById('timeRangeMessage').innerHTML =
    'Session <b>' + fmt(tenMinutesAgo) + '</b> &rarr; <b>' + fmt(currentTime) + '</b>';
});

function myFunction_Time() {
  var demo = document.getElementById("demo");
  if (demo) demo.innerHTML = document.lastModified;
}
</script>

<%
/* ============================================================
   BACKEND: Fetch data from Oracle DB
   ============================================================ */
response.setIntHeader("Refresh", 600);

Connection conn = null;
Statement statement = null;
ResultSet resultSet = null;

List<String> labels    = new ArrayList<String>();
List<String> rawNames  = new ArrayList<String>();
List<Double> failure   = new ArrayList<Double>();
List<Integer> tdCounts = new ArrayList<Integer>();
List<Integer> totalHits = new ArrayList<Integer>();

try {
    conn = DBUtilityAuto.getIIBDBConnection();

    ZonedDateTime CurrentDate = ZonedDateTime.now(ZoneId.of("Asia/Kolkata"));
    DateTimeFormatter formatter = DateTimeFormatter.ofPattern("MMM_yy").withLocale(Locale.US);
    String PART = CurrentDate.format(formatter).toUpperCase();

    String sql = "Select * from("
        + "select txn_endpoint, "
        + "COUNT(1) AS TOTAL_HITS, "
        + "SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END) AS TD_COUNT, "
        + "ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END)*100)/COUNT(1),2) AS TD_PERCENT "
        + "from eisapp.backend_log PARTITION(" + PART + ") "
        + "where txn_endpoint != 'NATIONAL_PORTAL' "
        + "and REQUEST_DATE_TIME>=SYSDATE - INTERVAL '10' MINUTE "
        + "GROUP BY txn_endpoint "
        + "having ROUND((SUM(CASE WHEN (substr(error_code,3,3) in ('002','014') OR error_code in ('SI001','SI007','SI569','SI570','SI015')) and error_code <> '00014' and error_code <> '3P002' THEN 1 ELSE 0 END)*100)/COUNT(1),2)>= 0.5 "
        + "order by TD_PERCENT desc"
        + ") where ROWNUM <=12";

    statement = conn.createStatement();
    resultSet = statement.executeQuery(sql);

    while (resultSet.next()) {
        String rawName  = resultSet.getString("txn_endpoint");
        int    tdCount  = resultSet.getInt("TD_COUNT");
        int    totalHit = resultSet.getInt("TOTAL_HITS");
        double pct      = resultSet.getDouble("TD_PERCENT");

        String label = "<span style='color:#d29922;font-weight:600;font-size:13px;'>" + tdCount + "</span>"
            + "<br><span style='color:#e6edf3;font-weight:500;font-size:11px;'>"
            + rawName.replaceAll("_", "_<br>") + "</span>"
            + "<br><span style='color:#3fb950;font-weight:600;font-size:12px;'>" + totalHit + "</span>";

        labels.add(label);
        rawNames.add(rawName);
        failure.add(pct);
        tdCounts.add(tdCount);
        totalHits.add(totalHit);
    }
} catch (Exception e) {
    e.printStackTrace();
} finally {
    try { if (resultSet != null) resultSet.close(); } catch (Exception ignored) {}
    try { if (statement != null) statement.close(); } catch (Exception ignored) {}
    try { if (conn != null) conn.close(); } catch (Exception ignored) {}
}

while (labels.size() < 5) {
    labels.add("&nbsp;");
    rawNames.add("");
    failure.add(0.0);
    tdCounts.add(0);
    totalHits.add(0);
}
%>

<script>
// ============================================================
// JS arrays from server data
// ============================================================
var labelArr = [
<%
for (int k = 0; k < labels.size(); k++) {
    String lbl = labels.get(k).replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "").replace("\r", "");
    out.print("\"" + lbl + "\"");
    if (k < labels.size() - 1) out.print(",");
}
%>
];

var nameArr = [
<%
for (int k = 0; k < rawNames.size(); k++) {
    String n = rawNames.get(k).replace("\\", "\\\\").replace("\"", "\\\"");
    out.print("\"" + n + "\"");
    if (k < rawNames.size() - 1) out.print(",");
}
%>
];

var valueArr = [
<%
for (int k = 0; k < failure.size(); k++) {
    out.print(failure.get(k));
    if (k < failure.size() - 1) out.print(",");
}
%>
];

var tdArr = [
<%
for (int k = 0; k < tdCounts.size(); k++) {
    out.print(tdCounts.get(k));
    if (k < tdCounts.size() - 1) out.print(",");
}
%>
];

var totalArr = [
<%
for (int k = 0; k < totalHits.size(); k++) {
    out.print(totalHits.get(k));
    if (k < totalHits.size() - 1) out.print(",");
}
%>
];

// ============================================================
// Stats bar
// ============================================================
(function computeStats() {
  var totalEndpoints = 0, critical = 0, warning = 0, maxVal = 0;
  for (var i = 0; i < nameArr.length; i++) {
    if (!nameArr[i]) continue;
    totalEndpoints++;
    if (valueArr[i] >= 5) critical++;
    else if (valueArr[i] >= 1) warning++;
    if (valueArr[i] > maxVal) maxVal = valueArr[i];
  }
  document.getElementById('statTotal').textContent    = totalEndpoints;
  document.getElementById('statCritical').textContent = critical;
  document.getElementById('statWarning').textContent  = warning;
  document.getElementById('statMax').textContent      = maxVal.toFixed(2) + '%';
  document.getElementById('statMax').className =
    'stat-value ' + (maxVal >= 5 ? 'critical' : (maxVal >= 2 ? 'warning' : 'ok'));
})();

// ============================================================
// Top critical list
// ============================================================
(function buildCritList() {
  var items = [];
  for (var k = 0; k < nameArr.length; k++) {
    if (nameArr[k] && valueArr[k] > 0) {
      items.push({ name: nameArr[k], pct: valueArr[k], td: tdArr[k] });
    }
  }
  items.sort(function (a, b) { return b.pct - a.pct; });
  var top = items.slice(0, 5);
  var box = document.getElementById('critList');
  if (!top.length) {
    box.innerHTML = '<div class="empty-note">All clear &middot; No failures detected</div>';
    return;
  }
  box.innerHTML = top.map(function (it) {
    return '<div class="crit-item">'
         + '<span class="name" title="' + it.name + '">' + it.name + '</span>'
         + '<span class="val">' + it.pct + '%</span>'
         + '</div>';
  }).join('');
})();

// ============================================================
// Bar colors by severity
// ============================================================
var barColors = valueArr.map(function (v) {
  if (v >= 5) return "#f85149";   // critical - red
  if (v >= 2) return "#d29922";   // high - amber
  if (v >= 1) return "#a371f7";   // medium - purple
  return "#3fb950";               // low - green
});

// ============================================================
// ZingChart config — clean enterprise look
// ============================================================
var chartConfig = {
  type: "bar3d",
  "3dAspect": { depth: 22, true3d: 0, yAngle: 8 },
  backgroundColor: "transparent",
  plotarea: {
    backgroundColor: "transparent",
    margin: "70px 40px 170px 80px"
  },
  globals: {
    fontFamily: "Inter, sans-serif"
  },
  scaleX: {
    values: labelArr,
    lineColor: "#30363d",
    tick: { visible: false },
    item: { fontColor: "#e6edf3", fontSize: 12 },
    guide: { visible: false }
  },
  scaleY: {
    lineColor: "#30363d",
    guide: {
      visible: true,
      lineColor: "#21262d",
      lineStyle: "solid"
    },
    tick: { lineColor: "#30363d", visible: true },
    item: { fontColor: "#8b949e", fontSize: 11, paddingRight: 8 },
    label: {
      text: "Failure %",
      fontColor: "#8b949e",
      fontSize: 11,
      offsetX: -10
    }
  },
  plot: {
    animation: { effect: "ANIMATION_SLIDE_BOTTOM", speed: 600, delay: 40, sequence: "ANIMATION_BY_NODE" },
    tooltip: {
      text: "<b>%kl</b><br>Failure: %v%",
      backgroundColor: "#21262d",
      borderColor: "#30363d",
      borderWidth: 1,
      borderRadius: "4px",
      fontColor: "#e6edf3",
      fontSize: 12,
      padding: "8px 12px",
      shadow: false
    },
    barWidth: "42%",
    borderWidth: 0,
    styles: barColors
  },
  series: [{
    values: valueArr,
    lineColor: "#58a6ff",
    lineWidth: 1,
    "value-box": {
      visible: true,
      text: "%v%",
      placement: "top",
      fontColor: "#e6edf3",
      fontSize: 12,
      fontWeight: "600",
      offsetY: -4
    }
  }]
};

function updateChart(p) {
  var idx = p.nodeindex;
  if (!nameArr[idx]) return;
  var url = '<%=request.getContextPath() + "/jsp/TransactionEndpointWiseService.jsp?txnEndPoint="%>' + encodeURIComponent(nameArr[idx]);
  window.open(url, '_blank');
}

zingchart.render({
  id: 'myChart',
  data: chartConfig,
  height: '100%',
  width: '100%'
});

zingchart.bind('myChart', 'node_click', updateChart);
</script>

<!-- ============ COUNTDOWN ============ -->
<script>
(function countdown() {
  var total = 10 * 60;
  var left = total;
  var badge = document.getElementById('refreshBadge');
  var num   = document.getElementById('countdownNum');
  var bar   = document.getElementById('topProgress');

  function tick() {
    left--;
    if (left <= 0) {
      bar.classList.add('active');
      return;
    }
    var m = Math.floor(left / 60);
    var s = left % 60;
    num.textContent = m + ':' + (s < 10 ? '0' + s : s);
    if (left <= 60) badge.classList.add('low');
  }
  setInterval(tick, 1000);
})();
</script>

</body>
</html>

/* ============================================================
   CUSTOM DROPDOWN
   ============================================================ */
var activeCellId = null;

function openDropdown(ev, rowIdx, dayIdx, currentCls, currentLabel) {
  ev.stopPropagation();

  var dd = document.getElementById('dropdownMenu');
  var btn = ev.currentTarget;
  var rect = btn.getBoundingClientRect();

  // Build items
  var sel = document.getElementById('sel_' + rowIdx + '_' + dayIdx);
  var currentValue = sel ? sel.value : 'Morning';

  var html = '';
  for (var k = 0; k < SHIFT_OPTIONS.length; k++) {
    var o = SHIFT_OPTIONS[k];
    var isSel = (o.value === currentValue) ? ' selected' : '';
    html += '<div class="dd-item ' + o.cls + isSel + '"'
         +  ' data-value="' + o.value + '"'
         +  ' data-cls="' + o.cls + '"'
         +  ' onclick="selectShift(event, ' + rowIdx + ', ' + dayIdx + ', \'' + o.value + '\', \'' + o.cls + '\')">'
         +  '<span class="dd-dot"></span>'
         +  '<span>' + o.label + '</span>'
         +  '</div>';
  }
  dd.innerHTML = html;

  // Position
  var top = rect.bottom + 4;
  var left = rect.left;
  var minW = 220;
  var maxLeft = window.innerWidth - minW - 10;
  if (left > maxLeft) left = maxLeft;
  if (left < 10) left = 10;

  dd.style.top = top + 'px';
  dd.style.left = left + 'px';
  dd.style.minWidth = minW + 'px';

  // If dropdown would overflow bottom, flip up
  dd.classList.add('open');
  var ddRect = dd.getBoundingClientRect();
  if (ddRect.bottom > window.innerHeight - 10) {
    dd.style.top = (rect.top - ddRect.height - 4) + 'px';
  }

  activeCellId = rowIdx + '_' + dayIdx;
}

function selectShift(ev, rowIdx, dayIdx, value, cls) {
  ev.stopPropagation();
  var dd = document.getElementById('dropdownMenu');
  dd.classList.remove('open');

  // Update hidden select
  var sel = document.getElementById('sel_' + rowIdx + '_' + dayIdx);
  if (sel) sel.value = value;

  // Update badge
  var cell = document.querySelector('td.shift-cell[data-cell-id="' + rowIdx + '_' + dayIdx + '"]');
  if (cell) {
    var btn = cell.querySelector('.shift-btn');
    if (btn) {
      btn.className = 'shift-btn ' + cls;
      btn.textContent = LABEL_MAP[value] || value;
    }
  }
  activeCellId = null;
}

/* Close dropdown on outside click / Esc */
document.addEventListener('click', function(e){
  var dd = document.getElementById('dropdownMenu');
  if (!dd.contains(e.target)) dd.classList.remove('open');
});
document.addEventListener('keydown', function(e){
  if (e.key === 'Escape') {
    document.getElementById('dropdownMenu').classList.remove('open');
  }
});

/* Reposition on scroll/resize */
window.addEventListener('resize', function(){
  document.getElementById('dropdownMenu').classList.remove('open');
});
window.addEventListener('scroll', function(){
  document.getElementById('dropdownMenu').classList.remove('open');
}, true);


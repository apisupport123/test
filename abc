.mute-btn.sound-on { background:rgba(52,211,153,0.15); border-color:rgba(52,211,153,0.25); color:#34d399; }
.mute-btn.sound-off { background:rgba(248,113,113,0.12); border-color:rgba(248,113,113,0.2); color:#f87171; }
.mute-btn .indicator { position:absolute; top:-4px; right:-4px; width:16px; height:16px; border-radius:50%; background:#34d399; border:2px solid #0b0e1a; animation:pulseDot 1.6s ease-in-out infinite; }
.mute-btn.sound-off .indicator { background:#f87171; }
.footer { margin-top:50px; text-align:center; padding:28px; color:rgba(255,255,255,0.2); font-size:13px; letter-spacing:0.5px; border-top:1px solid rgba(255,255,255,0.03); }
.footer strong { color:rgba(255,255,255,0.3); font-weight:600; }
@media (max-width:768px) { body { padding:16px; } .header { padding:24px 20px; } .header h1 { font-size:24px; } .header-top { flex-direction:column; align-items:stretch; } .header-actions { justify-content:center; } .datetime-picker { flex-direction:column; } .datetime-input { min-width:100%; } .manual-btn { width:100%; justify-content:center; } .stats-panel { grid-template-columns:1fr 1fr; } .stat-value { font-size:30px; } .carts-container { grid-template-columns:1fr; } .hits-value { font-size:48px; } .time-range-display { font-size:12px; padding:8px 16px; } .audio-controls { bottom:16px; right:16px; } .mute-btn { width:56px; height:56px; font-size:12px; } }
@media (max-width:480px) { .stats-panel { grid-template-columns:1fr; } .header h1 { font-size:20px; } .header h1 small { font-size:13px; } }
::-webkit-scrollbar { width:6px; }
::-webkit-scrollbar-track { background:rgba(255,255,255,0.02); }
::-webkit-scrollbar-thumb { background:rgba(167,139,250,0.3); border-radius:10px; }
::-webkit-scrollbar-thumb:hover { background:rgba(167,139,250,0.5); }
</style>
</head>
<body>
<div class="container">
<div class="header">
<div class="header-top">
<h1>DMZ DPG Incoming Transaction Monitoring <small>- Real-time</small></h1>
<div class="header-actions">
<span class="live-badge"><span class="dot"></span> LIVE</span>
<button class="btn" onclick="refreshPage()" id="refreshBtn">
<svg viewBox="0 0 24 24"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg> Refresh
</button>
<a href="<%= request.getRequestURI() %>?action=refreshMaster&mute=<%= isMuted %><%= (manualFromTime!=null?"&fromTime="+manualFromTime:"") %><%= (manualToTime!=null?"&toTime="+manualToTime:"") %>" class="btn btn-refresh-ip" onclick="return confirm('Refresh IP list? This will delete and reload all IPs from IIB.');">
<svg viewBox="0 0 24 24"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg> Refresh IP List
</a>
<button class="btn btn-sql" onclick="toggleSqlBox()">
<svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg> Show SQL Query
</button>
<span style="font-size:13px;color:rgba(255,255,255,0.25);font-weight:500;"><%= currentTime %></span>
</div>
</div>
<div id="sqlBox" class="sql-box">
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
<span style="color:#fbbf24; font-weight:600; font-size:14px;">QUERY RUN EVERY 10 MINUTES (USING IN CLAUSE)</span>
</div>
<pre id="sqlQueryText"><%= displayQuery %></pre>
<div>
<button class="copy-btn" onclick="copySql()">Copy to Clipboard</button>
<span id="copyMsg" class="copy-msg">Copied Successfully!</span>
</div>
</div>
<div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:14px;">
<div class="time-range-display">DATA FROM: <span class="time-value"><%= timeRangeDisplay %></span></div>
</div>
<div class="datetime-section">
<form method="get" action="" id="mainForm">
<input type="hidden" name="mute" id="muteInput" value="<%= isMuted %>">
<div class="datetime-picker">
<div class="datetime-input"><label>FROM</label><input type="datetime-local" name="fromTime" id="fromTime" value="<%= manualFromTime!=null?manualFromTime:"" %>"></div>
<div class="datetime-input"><label>TO</label><input type="datetime-local" name="toTime" id="toTime" value="<%= manualToTime!=null?manualToTime:"" %>"></div>
<button type="submit" class="manual-btn">APPLY</button>
<% if(manualFromTime != null || manualToTime != null) { %>
<a href="<%= request.getRequestURI() %>?mute=<%= isMuted %>" class="manual-btn reset-btn">RESET</a>
<% } %>
</div>
</form>
</div>
</div>

<div class="stats-panel">
<div class="stat-card" id="totalHitsCard"><div class="stat-label">Total Hits</div><div class="stat-value purple" id="totalHits">0</div></div>
<div class="stat-card" id="zeroHitsCard"><div class="stat-label">Zero Hit Carts</div><div class="stat-value red" id="zeroHitsCount">0</div></div>
<div class="stat-card"><div class="stat-label">Active Carts</div><div class="stat-value blue" id="totalCarts">0</div></div>
<div class="stat-card"><div class="stat-label">PR Mode</div><div class="stat-value green" id="prCount">0</div></div>
<div class="stat-card"><div class="stat-label">DR Mode</div><div class="stat-value" id="drCount" style="background:linear-gradient(135deg,#60a5fa,#3b82f6);-webkit-background-clip:text;">0</div></div>
</div>

<div id="cartsContainer" class="carts-container">
<%
// ── Read Master IP List from Report DB ──
List<String> allIps = new ArrayList<>();
Connection connRead = null;
Statement stmtRead = null;
ResultSet rsRead = null;
try {
    connRead = DBUtilityAuto.getReportDBConnection();
    stmtRead = connRead.createStatement();
    rsRead = stmtRead.executeQuery("SELECT DPG_IP FROM DPG_IP_MASTER ORDER BY DPG_IP");
    while (rsRead.next()) {
        allIps.add(rsRead.getString("DPG_IP"));
    }
} catch (SQLException e) {
    e.printStackTrace();
} finally {
    try { if (rsRead != null) rsRead.close(); } catch (Exception e) {}
    try { if (stmtRead != null) stmtRead.close(); } catch (Exception e) {}
    try { if (connRead != null) connRead.close(); } catch (Exception e) {}
}

if (allIps == null || allIps.isEmpty()) {
%>
<div class="no-data">
<h3>IP Master List is Empty</h3>
<p>Please click <strong>"Refresh IP List"</strong> button to populate the master table, or wait for the next auto-refresh (it will auto-populate at 12:01 AM).</p>
</div>
<%
    prCount = 0; drCount = 0; totalHits = 0; totalCarts = 0; zeroHitCarts = 0;
} else {
    // ── Build IN clause with all IPs ──
    StringBuilder inClause = new StringBuilder();
    for (int i = 0; i < allIps.size(); i++) {
        inClause.append("'").append(allIps.get(i)).append("'");
        if (i < allIps.size() - 1) inClause.append(",");
    }

    // ── Fetch hit counts from IIB using IN clause ──
    Connection connIIB = null;
    PreparedStatement pstmtIIB = null;
    ResultSet rsIIB = null;
    try {
        connIIB = DBUtilityAuto.getIIBDBConnection();
        String timeCondition = "";
        if(manualFromTime != null && manualToTime != null && !manualFromTime.isEmpty() && !manualToTime.isEmpty()) {
            String fromDate = manualFromTime.replace("T", " ").replace("-", "/");
            String toDate = manualToTime.replace("T", " ").replace("-", "/");
            timeCondition = "AND REQUEST_DATE_TIME BETWEEN TO_DATE('" + fromDate + "', 'YYYY/MM/DD HH24:MI') " +
                            "AND TO_DATE('" + toDate + "', 'YYYY/MM/DD HH24:MI') ";
        } else {
            timeCondition = "AND request_date_time >= SYSDATE - INTERVAL '10' MINUTE ";
        }

        String countQuery =
            "SELECT /*+ PARALLEL(4) */ TRIM(DPG_IP) AS DPG_IP, COUNT(1) AS TOTAL_HITS " +
            "FROM EISAPP.API_LOG " +
            "WHERE TRIM(DPG_IP) IN (" + inClause.toString() + ") " +
            timeCondition +
            "GROUP BY TRIM(DPG_IP)";
        
        // Print the query to console for debugging
        System.out.println("===== 10-min hit count query =====");
        System.out.println(countQuery);
        System.out.println("===================================");

        pstmtIIB = connIIB.prepareStatement(countQuery);
        rsIIB = pstmtIIB.executeQuery();
        Map<String, Integer> countMap = new HashMap<>();
        while (rsIIB.next()) {
            String ip = rsIIB.getString("DPG_IP");
            int hits = rsIIB.getInt("TOTAL_HITS");
            countMap.put(ip, hits);
        }

        // ── Build dataList ──
        for (String ip : allIps) {
            Map<String, Object> row = new HashMap<>();
            int hits = countMap.getOrDefault(ip, 0);
            row.put("dpgIp", ip);
            row.put("hits", hits);
            dataList.add(row);
            totalHits += hits;
            totalCarts++;
            if (hits == 0) zeroHitCarts++;
            String mode = getModeFromIp(ip);
            if ("PR".equals(mode)) prCount++;
            else if ("DR".equals(mode)) drCount++;
        }

    } catch (Exception e) {
        e.printStackTrace();
%>
<div class="no-data">
<h3>System Error</h3>
<p><%= e.getMessage() %></p>
</div>
<%
    } finally {
        try { if (rsIIB != null) rsIIB.close(); } catch (Exception e) {}
        try { if (pstmtIIB != null) pstmtIIB.close(); } catch (Exception e) {}
        try { if (connIIB != null) connIIB.close(); } catch (Exception e) {}
    }
}
%>

<%
if (dataList != null && !dataList.isEmpty()) {
    Collections.sort(dataList, (a,b) -> ((String)a.get("dpgIp")).compareTo((String)b.get("dpgIp")));
    for(Map<String, Object> row : dataList) {
        String fullIp = (String) row.get("dpgIp");
        String maskedIp = maskIp(fullIp);
        int hits = (Integer) row.get("hits");
        String mode = getModeFromIp(fullIp);
        boolean isPr = "PR".equals(mode);
        String badgeClass = isPr ? "pr" : "dr";
        String statusClass, statusText, cartExtraClass = "";
        if (hits == 0) {
            statusClass = "down";
            statusText = "IP Down / No Traffic";
            cartExtraClass = "blink-zero";
        } else {
            statusClass = "up";
            statusText = "Up & Running";
        }
%>
<div class="cart <%= cartExtraClass %>" data-mode="<%= mode %>" data-hits="<%= hits %>">
<div class="cart-header">
<span class="dpg-ip"><%= maskedIp %><span class="full-ip"><%= fullIp %></span></span>
<span class="mode-badge <%= badgeClass %>"><%= mode %></span>
</div>
<div class="hits-value"><%= hits %><span class="label">HITS</span></div>
<div class="hit-status <%= statusClass %>"><%= statusText %></div>
<div class="last-updated">Updated: <%= currentTime %></div>
</div>
<%
    }
} else if (dataList != null && dataList.isEmpty() && allIps != null && !allIps.isEmpty()) {
%>
<div class="no-data">
<h3>No Data Available</h3>
<p>No DPG IP records found in the selected time range.</p>
</div>
<%
}
%>
</div>

<div class="footer">
<p>DMZ DPG Incoming Transaction Monitoring - <strong>PR</strong> (171.x) &amp; <strong>DR</strong> (176.x) - Auto-refresh every 10 min</p>
<p style="font-size:11px;margin-top:6px;color:rgba(255,255,255,0.12);">Data Range: <%= timeRangeDisplay %></p>
</div>
</div>

<div class="audio-controls">
<%
String newMute = isMuted ? "false" : "true";
String muteUrl = request.getRequestURI() + "?mute=" + newMute;
if (manualFromTime != null) muteUrl += "&fromTime=" + manualFromTime;
if (manualToTime != null) muteUrl += "&toTime=" + manualToTime;
%>
<a href="<%= muteUrl %>" class="mute-btn <%= isMuted ? "sound-off" : "sound-on" %>">
<%= isMuted ? "OFF" : "ON" %>
<span class="indicator"></span>
</a>
</div>

<audio id="alertSound" preload="auto">
<source src="data:audio/wav;base64," type="audio/wav">
</audio>

<script>
// ── Update Stats ──
const totalHits = <%= totalHits %>;
const zeroHits = <%= zeroHitCarts %>;
document.getElementById('totalHits').textContent = totalHits;
document.getElementById('zeroHitsCount').textContent = zeroHits;
document.getElementById('totalCarts').textContent = '<%= totalCarts %>';
document.getElementById('prCount').textContent = '<%= prCount %>';
document.getElementById('drCount').textContent = '<%= drCount %>';

// ── Blink Cards ──
const zeroHitsCard = document.getElementById('zeroHitsCard');
if (zeroHits > 0) zeroHitsCard.classList.add('blink-zero-stat');
else zeroHitsCard.classList.remove('blink-zero-stat');

const totalHitsCard = document.getElementById('totalHitsCard');
if (totalHits === 0) totalHitsCard.classList.add('blink-zero-stat');
else totalHitsCard.classList.remove('blink-zero-stat');

// ── Audio (only when total hits is zero) ──
const audio = document.getElementById('alertSound');
let isMuted = <%= isMuted %>;
let alertPlayed = false;
audio.load();

function checkAndPlayAlert() {
    if (totalHits === 0 && !isMuted && !alertPlayed) {
        audio.currentTime = 0;
        audio.play().catch(e => console.log('Audio play failed:', e));
        alertPlayed = true;
        setTimeout(() => { alertPlayed = false; }, 5000);
    }
}
checkAndPlayAlert();
setInterval(checkAndPlayAlert, 3000);

// ── SQL Box toggle ──
function toggleSqlBox() {
    document.getElementById('sqlBox').classList.toggle('show');
}

// ── Copy SQL ──
function copySql() {
    const text = document.getElementById('sqlQueryText').innerText;
    navigator.clipboard.writeText(text).then(() => {
        const msg = document.getElementById('copyMsg');
        msg.style.display = 'inline';
        setTimeout(() => { msg.style.display = 'none'; }, 3000);
    }).catch(() => {
        const range = document.createRange();
        const pre = document.getElementById('sqlQueryText');
        range.selectNode(pre);
        window.getSelection().removeAllRanges();
        window.getSelection().addRange(range);
        document.execCommand('copy');
        const msg = document.getElementById('copyMsg');
        msg.style.display = 'inline';
        setTimeout(() => { msg.style.display = 'none'; }, 3000);
    });
}

// ── Refresh Page ──
function refreshPage() {
    const btn = document.getElementById('refreshBtn');
    const svg = btn.querySelector('svg');
    svg.classList.add('spin');
    btn.disabled = true;
    btn.style.opacity = '0.6';
    document.getElementById('mainForm').submit();
    setTimeout(() => {
        svg.classList.remove('spin');
        btn.disabled = false;
        btn.style.opacity = '1';
    }, 3000);
}

// ── Init datetime ──
document.addEventListener('DOMContentLoaded', () => {
    const from = document.getElementById('fromTime');
    const to = document.getElementById('toTime');
    if (!from.value) {
        const now = new Date();
        const tenMinsAgo = new Date(now.getTime() - 10 * 60000);
        from.value = tenMinsAgo.toISOString().slice(0, 16);
    }
    if (!to.value) {
        const now = new Date();
        to.value = now.toISOString().slice(0, 16);
    }
});

// ── 3D Tilt ──
document.querySelectorAll('.cart').forEach(card => {
    card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(1200px) rotateX(${y*6}deg) rotateY(${-x*6}deg) translateZ(12px)`;
    });
    card.addEventListener('mouseleave', () => {
        card.style.transform = 'perspective(1200px) rotateX(0deg) rotateY(0deg) translateZ(0px)';
    });
});

// ── Parallax ──
document.addEventListener('mousemove', (e) => {
    const x = e.clientX / window.innerWidth;
    const y = e.clientY / window.innerHeight;
    document.body.style.background =
        `radial-gradient(ellipse at ${x*100}% ${y*100}%, rgba(88,70,255,0.12) 0%, transparent 50%),
         radial-gradient(ellipse at ${(1-x)*100}% ${(1-y)*100}%, rgba(0,200,255,0.07) 0%, transparent 50%),
         #0b0e1a`;
});

console.log('DMZ DPG Incoming Transaction Monitoring loaded (Master Table Mode with separate connections)');
console.log('PR count: <%= prCount %>, DR count: <%= drCount %>');
console.log('Sound: <%= isMuted ? "OFF" : "ON" %>');
console.log('Total Hits:', totalHits);
console.log('Zero Hit Carts:', zeroHits);
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Roster &middot; <%= nameOfMonth %> <%= year %></title>

<style>
/* ============ DESIGN TOKENS ============ */
:root{
  /* Brand */
  --brand-1:#6366F1;   /* Indigo */
  --brand-2:#8B5CF6;   /* Violet */
  --brand-3:#EC4899;   /* Pink */
  --brand-grad: linear-gradient(135deg, #6366F1 0%, #8B5CF6 45%, #EC4899 100%);

  /* Surfaces (dark-first) */
  --surface-0: #0B0B0F;
  --surface-1: #13131A;
  --surface-2: #1B1B24;
  --surface-3: #23232E;
  --line: rgba(255,255,255,0.08);
  --line-strong: rgba(255,255,255,0.14);

  /* Ink */
  --ink: #F5F5FA;
  --ink-muted: #9CA3AF;
  --ink-dim: #6B7280;

  /* Shift colors (vibrant dark) */
  --shift-morning: #FBBF24;
  --shift-morning-bg: rgba(251,191,36,0.14);
  --shift-general: #A1A1AA;
  --shift-general-bg: rgba(161,161,170,0.12);
  --shift-afternoon: #F59E0B;
  --shift-afternoon-bg: rgba(245,158,11,0.14);
  --shift-night: #60A5FA;
  --shift-night-bg: rgba(96,165,250,0.16);
  --shift-weekoff: #A78BFA;
  --shift-weekoff-bg: rgba(167,139,250,0.16);
  --shift-leave: #F87171;
  --shift-leave-bg: rgba(248,113,113,0.14);
  --shift-flexi: #FB923C;
  --shift-flexi-bg: rgba(251,146,60,0.14);
  --shift-holiday: #34D399;
  --shift-holiday-bg: rgba(52,211,153,0.14);
  --shift-na: #52525B;
  --shift-na-bg: rgba(82,82,91,0.12);

  --radius: 14px;
  --radius-sm: 10px;
  --radius-xs: 6px;

  --shadow-sm: 0 2px 8px rgba(0,0,0,.25);
  --shadow-md: 0 8px 24px rgba(0,0,0,.35);
  --shadow-lg: 0 20px 50px -12px rgba(99,102,241,.35);

  --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --mono: 'JetBrains Mono', 'Consolas', monospace;
}

html[data-theme="light"]{
  --surface-0: #F4F5FA;
  --surface-1: #FFFFFF;
  --surface-2: #FAFAFC;
  --surface-3: #F1F2F7;
  --line: rgba(15,15,30,0.08);
  --line-strong: rgba(15,15,30,0.15);
  --ink: #0F0F1A;
  --ink-muted: #52525B;
  --ink-dim: #71717A;
  --shift-morning-bg: rgba(251,191,36,0.22);
  --shift-general-bg: rgba(161,161,170,0.2);
  --shift-afternoon-bg: rgba(245,158,11,0.22);
  --shift-night-bg: rgba(96,165,250,0.22);
  --shift-weekoff-bg: rgba(167,139,250,0.22);
  --shift-leave-bg: rgba(248,113,113,0.2);
  --shift-flexi-bg: rgba(251,146,60,0.22);
  --shift-holiday-bg: rgba(52,211,153,0.22);
  --shadow-sm: 0 2px 8px rgba(15,15,30,.06);
  --shadow-md: 0 8px 24px rgba(15,15,30,.08);
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--font);
  font-weight:500;
  background:var(--surface-0);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  min-height:100vh;
  overflow-x:hidden;
  transition:background .3s, color .3s;
}
a{color:inherit;text-decoration:none}
button{font-family:inherit}

/* ============ AMBIENT BACKGROUND ============ */
.ambient{
  position:fixed;
  inset:0;
  z-index:0;
  overflow:hidden;
  pointer-events:none;
}
.ambient::before,
.ambient::after{
  content:"";
  position:absolute;
  width:60vw;height:60vw;
  border-radius:50%;
  filter:blur(120px);
  opacity:.35;
}
.ambient::before{
  background:radial-gradient(circle, #6366F1 0%, transparent 70%);
  top:-20vw;left:-15vw;
  animation:float1 20s ease-in-out infinite;
}
.ambient::after{
  background:radial-gradient(circle, #EC4899 0%, transparent 70%);
  bottom:-20vw;right:-15vw;
  animation:float2 25s ease-in-out infinite;
}
@keyframes float1{
  0%,100%{transform:translate(0,0) scale(1)}
  50%{transform:translate(10vw,5vw) scale(1.1)}
}
@keyframes float2{
  0%,100%{transform:translate(0,0) scale(1)}
  50%{transform:translate(-8vw,-6vw) scale(1.05)}
}
html[data-theme="light"] .ambient::before{opacity:.15}
html[data-theme="light"] .ambient::after{opacity:.12}

/* ============ APP SHELL ============ */
.app{
  position:relative;
  z-index:1;
  min-height:100vh;
  display:flex;
  flex-direction:column;
}

/* ============ TOP BAR ============ */
.topbar{
  position:sticky;
  top:0;
  z-index:50;
  backdrop-filter:blur(20px) saturate(180%);
  -webkit-backdrop-filter:blur(20px) saturate(180%);
  background:rgba(11,11,15,0.72);
  border-bottom:1px solid var(--line);
  padding:14px 28px;
  display:flex;
  align-items:center;
  gap:20px;
}
html[data-theme="light"] .topbar{background:rgba(255,255,255,0.75)}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
  flex-shrink:0;
}
.brand-mark{
  width:40px;height:40px;
  border-radius:11px;
  background:var(--brand-grad);
  display:grid;place-items:center;
  color:#fff;
  box-shadow:0 8px 24px -6px rgba(99,102,241,.6);
  position:relative;
}
.brand-mark::after{
  content:"";
  position:absolute;inset:-2px;
  border-radius:13px;
  background:var(--brand-grad);
  filter:blur(12px);
  opacity:.5;
  z-index:-1;
}
.brand-mark svg{width:22px;height:22px;stroke:#fff;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.brand-text .t{
  font-size:1rem;
  font-weight:800;
  letter-spacing:-.3px;
  line-height:1.1;
}
.brand-text .s{
  font-size:.68rem;
  font-weight:700;
  color:var(--ink-muted);
  text-transform:uppercase;
  letter-spacing:1.2px;
  margin-top:2px;
}

.topbar-spacer{flex:1}

.topbar-actions{
  display:flex;
  align-items:center;
  gap:10px;
  flex-shrink:0;
}
.icon-btn{
  width:38px;height:38px;
  border-radius:10px;
  border:1px solid var(--line);
  background:var(--surface-2);
  color:var(--ink);
  display:grid;place-items:center;
  cursor:pointer;
  transition:all .15s ease;
}
.icon-btn:hover{
  border-color:var(--brand-2);
  color:var(--brand-2);
  transform:translateY(-1px);
}
.icon-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}

.user-chip{
  display:flex;
  align-items:center;
  gap:10px;
  padding:6px 14px 6px 6px;
  background:var(--surface-2);
  border:1px solid var(--line);
  border-radius:999px;
  font-size:.82rem;
  font-weight:700;
}
.user-avatar{
  width:30px;height:30px;border-radius:50%;
  background:var(--brand-grad);
  color:#fff;
  font-weight:900;
  font-size:.75rem;
  display:grid;place-items:center;
  flex-shrink:0;
}

/* ============ HERO ============ */
.hero{
  padding:40px 32px 32px;
  max-width:1700px;
  width:100%;
  margin:0 auto;
}
.hero-inner{
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap:24px;
  flex-wrap:wrap;
}
.hero-tag{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:5px 12px;
  background:rgba(139,92,246,0.14);
  border:1px solid rgba(139,92,246,0.35);
  border-radius:999px;
  font-size:.68rem;
  font-weight:800;
  letter-spacing:1.2px;
  text-transform:uppercase;
  color:#C4B5FD;
  margin-bottom:14px;
}
html[data-theme="light"] .hero-tag{color:var(--brand-2);background:rgba(139,92,246,0.1)}
.hero-tag .pulse{
  width:6px;height:6px;border-radius:50%;
  background:#A78BFA;
  box-shadow:0 0 10px #A78BFA;
  animation:pulse 2s infinite;
}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.3)}}
.hero h1{
  font-size:2.6rem;
  font-weight:900;
  letter-spacing:-1.4px;
  line-height:1.05;
  margin-bottom:10px;
}
.hero h1 .grad{
  background:var(--brand-grad);
  -webkit-background-clip:text;background-clip:text;
  color:transparent;
}
.hero-sub{
  font-size:.9rem;
  color:var(--ink-muted);
  font-weight:500;
  max-width:520px;
  line-height:1.6;
}

/* Month picker */
.picker{
  display:flex;
  align-items:center;
  gap:8px;
  padding:8px;
  background:var(--surface-1);
  border:1px solid var(--line);
  border-radius:var(--radius);
  box-shadow:var(--shadow-md);
  flex-shrink:0;
}
.picker-field{position:relative;}
.picker-field label{
  position:absolute;
  top:-8px;left:12px;
  padding:0 6px;
  background:var(--surface-1);
  font-size:.6rem;
  font-weight:800;
  color:var(--ink-muted);
  letter-spacing:1.1px;
  text-transform:uppercase;
}
.picker-field select,
.picker-field input{
  appearance:none;
  -webkit-appearance:none;
  background:var(--surface-2);
  border:1px solid var(--line);
  border-radius:var(--radius-xs);
  padding:11px 36px 11px 14px;
  color:var(--ink);
  font-family:inherit;
  font-size:.85rem;
  font-weight:700;
  outline:none;
  cursor:pointer;
  transition:all .2s ease;
  min-width:120px;
}
.picker-field select:hover,
.picker-field input:hover{
  border-color:var(--brand-2);
}
.picker-field select:focus,
.picker-field input:focus{
  border-color:var(--brand-2);
  box-shadow:0 0 0 3px rgba(139,92,246,.18);
}
.picker-field .chev{
  position:absolute;
  right:12px;top:50%;
  transform:translateY(-50%);
  pointer-events:none;
  width:12px;height:12px;
  stroke:var(--ink-muted);
  fill:none;
  stroke-width:2.5;
}
.picker-btn{
  padding:11px 22px;
  background:var(--brand-grad);
  border:none;
  border-radius:var(--radius-xs);
  color:#fff;
  font-size:.82rem;
  font-weight:800;
  letter-spacing:.4px;
  text-transform:uppercase;
  cursor:pointer;
  transition:all .2s ease;
  box-shadow:0 8px 20px -6px rgba(99,102,241,.6);
  display:inline-flex;
  align-items:center;
  gap:8px;
  white-space:nowrap;
}
.picker-btn:hover{transform:translateY(-1px);box-shadow:0 12px 28px -6px rgba(99,102,241,.7)}
.picker-btn svg{width:14px;height:14px;stroke:#fff;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}

/* ============ MAIN ============ */
.main{
  flex:1;
  padding:0 32px 60px;
  max-width:1700px;
  width:100%;
  margin:0 auto;
}

/* KPI strip */
.kpis{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));
  gap:14px;
  margin-bottom:20px;
}
.kpi{
  background:var(--surface-1);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:16px 18px;
  display:flex;
  align-items:center;
  gap:14px;
  position:relative;
  overflow:hidden;
  transition:all .25s ease;
}
.kpi::before{
  content:"";
  position:absolute;
  top:0;left:0;right:0;
  height:3px;
  background:var(--brand-grad);
  opacity:0;
  transition:opacity .25s;
}
.kpi:hover{
  transform:translateY(-3px);
  border-color:var(--line-strong);
  box-shadow:var(--shadow-md);
}
.kpi:hover::before{opacity:1}
.kpi-icon{
  width:44px;height:44px;
  border-radius:12px;
  display:grid;place-items:center;
  flex-shrink:0;
  background:var(--brand-grad);
  color:#fff;
  box-shadow:0 8px 16px -6px rgba(99,102,241,.5);
}
.kpi-icon svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
.kpi-val{
  font-size:1.4rem;font-weight:900;
  letter-spacing:-.5px;line-height:1;
}
.kpi-lbl{
  font-size:.66rem;font-weight:700;
  color:var(--ink-muted);
  text-transform:uppercase;
  letter-spacing:1px;
  margin-top:5px;
}

/* Toolbar */
.toolbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:14px;
  flex-wrap:wrap;
  margin-bottom:14px;
}
.search{
  position:relative;
  flex:1;
  max-width:340px;
}
.search svg{
  position:absolute;
  left:14px;top:50%;
  transform:translateY(-50%);
  width:15px;height:15px;
  stroke:var(--ink-muted);fill:none;stroke-width:2.2;
  pointer-events:none;
}
.search input{
  width:100%;
  padding:11px 14px 11px 40px;
  background:var(--surface-1);
  border:1px solid var(--line);
  border-radius:var(--radius-sm);
  color:var(--ink);
  font-family:inherit;
  font-size:.85rem;
  font-weight:600;
  outline:none;
  transition:all .2s ease;
}
.search input::placeholder{color:var(--ink-dim);font-weight:500}
.search input:focus{
  border-color:var(--brand-2);
  box-shadow:0 0 0 3px rgba(139,92,246,.18);
}

.legend{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  align-items:center;
}
.legend-item{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:5px 11px;
  background:var(--surface-1);
  border:1px solid var(--line);
  border-radius:999px;
  font-size:.7rem;
  font-weight:700;
  color:var(--ink-muted);
  white-space:nowrap;
}
.legend-item .sw{
  width:9px;height:9px;border-radius:3px;
  flex-shrink:0;
}
.sw.morning{background:var(--shift-morning)}
.sw.general{background:var(--shift-general)}
.sw.afternoon{background:var(--shift-afternoon)}
.sw.night{background:var(--shift-night)}
.sw.weekoff{background:var(--shift-weekoff)}
.sw.leave{background:var(--shift-leave)}
.sw.holiday{background:var(--shift-holiday)}

/* ============ ROSTER PANEL ============ */
.panel{
  background:var(--surface-1);
  border:1px solid var(--line);
  border-radius:var(--radius);
  overflow:hidden;
  box-shadow:var(--shadow-md);
}
.scroll{
  overflow:auto;
  max-height:72vh;
  position:relative;
}
.scroll::-webkit-scrollbar{width:10px;height:10px}
.scroll::-webkit-scrollbar-track{background:transparent}
.scroll::-webkit-scrollbar-thumb{
  background:var(--line-strong);
  border-radius:5px;
  border:2px solid var(--surface-1);
}
.scroll::-webkit-scrollbar-thumb:hover{background:var(--ink-dim)}

table.roster{
  border-collapse:separate;
  border-spacing:0;
  width:100%;
  font-size:.78rem;
}
table.roster th,
table.roster td{
  padding:0;
  vertical-align:middle;
  white-space:nowrap;
}

/* Header */
table.roster thead th{
  position:sticky;
  top:0;
  z-index:5;
  background:var(--surface-2);
  color:var(--ink-muted);
  font-size:.62rem;
  font-weight:800;
  letter-spacing:.7px;
  text-transform:uppercase;
  padding:8px 6px;
  text-align:center;
  border-bottom:1px solid var(--line);
}
table.roster thead tr:first-child th{
  top:0;
  background:var(--surface-3);
  color:var(--ink);
  height:34px;
  font-size:.68rem;
}
table.roster thead tr:nth-child(2) th{
  top:34px;
  font-size:.58rem;
  opacity:.7;
}

/* Sticky first columns */
table.roster th.stick-1,
table.roster td.stick-1{
  position:sticky;
  left:0;
  z-index:3;
  background:var(--surface-1);
  text-align:left;
  padding:10px 14px;
  border-right:1px solid var(--line);
  width:200px;
  min-width:200px;
}
table.roster th.stick-1{
  z-index:6;
  background:var(--surface-3);
  color:var(--ink);
}
table.roster thead tr:nth-child(2) th.stick-1{background:var(--surface-3)}

table.roster th.stick-2,
table.roster td.stick-2{
  position:sticky;
  left:200px;
  z-index:3;
  background:var(--surface-1);
  text-align:left;
  padding:10px 12px;
  border-right:2px solid var(--line-strong);
  width:110px;
  min-width:110px;
  font-size:.7rem;
  color:var(--ink-muted);
  text-transform:uppercase;
  font-weight:800;
  letter-spacing:.4px;
}
table.roster th.stick-2{
  z-index:6;
  background:var(--surface-3);
  color:var(--ink);
}

/* Rows */
table.roster tbody tr{
  transition:background .12s ease;
}
table.roster tbody tr:hover td{
  background:var(--surface-2);
}
table.roster tbody tr:hover td.stick-1{background:var(--surface-2)}
table.roster tbody tr:hover td.stick-2{background:var(--surface-2)}
table.roster tbody td{
  border-bottom:1px solid var(--line);
  background:var(--surface-1);
}
table.roster tbody tr:last-child td{border-bottom:none}

/* Employee cell */
.emp{
  display:flex;
  align-items:center;
  gap:10px;
}
.emp .av{
  width:30px;height:30px;
  border-radius:9px;
  background:var(--brand-grad);
  color:#fff;
  font-weight:900;
  font-size:.68rem;
  display:grid;place-items:center;
  flex-shrink:0;
  letter-spacing:.3px;
}
.emp .nm{
  font-weight:800;
  font-size:.78rem;
  color:var(--ink);
  line-height:1.2;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  max-width:130px;
}
.emp .id{
  font-size:.6rem;
  color:var(--ink-dim);
  font-weight:700;
  margin-top:2px;
  letter-spacing:.4px;
}

/* Position pill */
.pos-pill{
  display:inline-block;
  padding:4px 9px;
  border-radius:999px;
  font-size:.6rem;
  font-weight:800;
  letter-spacing:.5px;
  text-transform:uppercase;
  background:var(--surface-3);
  color:var(--ink-muted);
  border:1px solid var(--line);
}
.pos-pill.Senior{background:rgba(99,102,241,.15);color:#A5B4FC;border-color:rgba(99,102,241,.3)}
.pos-pill.Junior{background:rgba(236,72,153,.12);color:#F9A8D4;border-color:rgba(236,72,153,.3)}
.pos-pill.Manager{background:rgba(251,191,36,.15);color:#FCD34D;border-color:rgba(251,191,36,.35)}
.pos-pill\.Team\.Lead,
.pos-pill[data-pos="Team Lead"]{background:rgba(52,211,153,.14);color:#6EE7B7;border-color:rgba(52,211,153,.3)}
html[data-theme="light"] .pos-pill.Senior{color:#4338CA}
html[data-theme="light"] .pos-pill.Junior{color:#BE185D}
html[data-theme="light"] .pos-pill.Manager{color:#B45309}
html[data-theme="light"] .pos-pill[data-pos="Team Lead"]{color:#047857}

/* Day cells */
td.day{
  position:relative;
  padding:0 !important;
  width:42px;
  min-width:42px;
  height:44px;
  text-align:center;
  cursor:pointer;
}
td.day .badge{
  position:absolute;
  inset:6px;
  display:grid;
  place-items:center;
  border-radius:9px;
  font-size:.68rem;
  font-weight:900;
  letter-spacing:-.2px;
  transition:all .18s cubic-bezier(.4,0,.2,1);
  border:1.5px solid transparent;
}
td.day:hover .badge{
  transform:scale(1.12);
  box-shadow:0 6px 16px rgba(0,0,0,.3);
}
td.day .select-native{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  opacity:0;
  cursor:pointer;
  appearance:none;
  -webkit-appearance:none;
  border:none;
  background:transparent;
  color:transparent;
  font-family:inherit;
  z-index:2;
}
td.day.picking{
  z-index:20;
}
td.day.picking .badge{
  opacity:0;
}
td.day.picking .select-native{
  opacity:1;
  color:var(--ink);
  background:var(--surface-2);
  border:2px solid var(--brand-2);
  border-radius:9px;
  inset:2px;
  width:calc(100% - 4px);
  height:calc(100% - 4px);
  padding:0 4px;
  font-size:.72rem;
  font-weight:700;
  box-shadow:0 0 0 3px rgba(139,92,246,.25);
}

/* Badge colors */
.badge.Morning, .badge.WFHM, .badge.CCM{
  background:var(--shift-morning-bg);
  color:var(--shift-morning);
  border-color:rgba(251,191,36,.4);
}
.badge.General, .badge.Genral, .badge.WFHG, .badge.CCG{
  background:var(--shift-general-bg);
  color:var(--shift-general);
  border-color:rgba(161,161,170,.35);
}
.badge.Afternoon, .badge.WFHA, .badge.CCA{
  background:var(--shift-afternoon-bg);
  color:var(--shift-afternoon);
  border-color:rgba(245,158,11,.4);
}
.badge.Night, .badge.WFHN, .badge.CCN{
  background:var(--shift-night-bg);
  color:var(--shift-night);
  border-color:rgba(96,165,250,.4);
}
.badge.Weekoff{
  background:var(--shift-weekoff-bg);
  color:var(--shift-weekoff);
  border-color:rgba(167,139,250,.4);
}
.badge.SL, .badge.CL, .badge.EL, .badge.Leave{
  background:var(--shift-leave-bg);
  color:var(--shift-leave);
  border-color:rgba(248,113,113,.4);
}
.badge.FlexiLeave{
  background:var(--shift-flexi-bg);
  color:var(--shift-flexi);
  border-color:rgba(251,146,60,.4);
}
.badge.HolidayLeave{
  background:var(--shift-holiday-bg);
  color:var(--shift-holiday);
  border-color:rgba(52,211,153,.4);
}
.badge.NA, .badge.empty{
  background:var(--shift-na-bg);
  color:var(--shift-na);
  border-color:transparent;
}

/* Weekend tint */
td.day.weekend, th.weekend{
  background:rgba(139,92,246,.055) !important;
}
td.day.weekend .badge{
  box-shadow:inset 0 0 0 1px rgba(139,92,246,.1);
}

/* WO/Lv summary cells */
td.summary{
  font-weight:900;
  font-size:.8rem;
  color:var(--ink);
  padding:0 8px;
  text-align:center;
  min-width:50px;
}
td.summary.wo{color:var(--shift-weekoff)}
td.summary.lv{color:var(--shift-leave)}

/* Bottom summary rows */
tr.aggregate td{
  background:var(--surface-2) !important;
  border-top:1px solid var(--line-strong);
  font-weight:800;
  font-size:.7rem;
  color:var(--ink-muted);
  padding:9px 6px;
  text-align:center;
}
tr.aggregate td.stick-1,
tr.aggregate td.stick-2{
  background:var(--surface-2) !important;
  color:var(--ink);
  text-transform:uppercase;
  letter-spacing:.6px;
  font-size:.66rem;
  font-weight:900;
}
tr.aggregate td .agg{
  display:inline-block;
  padding:2px 8px;
  border-radius:6px;
  min-width:26px;
  font-weight:900;
  font-size:.72rem;
}
.agg.morning{background:var(--shift-morning-bg);color:var(--shift-morning)}
.agg.general{background:var(--shift-general-bg);color:var(--shift-general)}
.agg.afternoon{background:var(--shift-afternoon-bg);color:var(--shift-afternoon)}
.agg.night{background:var(--shift-night-bg);color:var(--shift-night)}
.agg.total{background:var(--surface-3);color:var(--ink);border:1px solid var(--line-strong)}

/* Empty state */
.empty{
  padding:80px 24px;
  text-align:center;
  color:var(--ink-muted);
}
.empty-orb{
  width:80px;height:80px;
  margin:0 auto 20px;
  border-radius:24px;
  background:var(--brand-grad);
  display:grid;place-items:center;
  color:#fff;
  box-shadow:0 20px 40px -12px rgba(99,102,241,.5);
  position:relative;
}
.empty-orb svg{width:36px;height:36px;stroke:#fff;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.empty h3{font-size:1.1rem;font-weight:800;color:var(--ink);margin-bottom:6px}
.empty p{font-size:.85rem;font-weight:500;line-height:1.6}

/* Footer / Save bar */
.bar{
  padding:16px 22px;
  background:var(--surface-2);
  border-top:1px solid var(--line);
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  flex-wrap:wrap;
}
.bar-tip{
  font-size:.78rem;
  color:var(--ink-muted);
  font-weight:600;
  display:flex;
  align-items:center;
  gap:8px;
}
.bar-tip svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.2;flex-shrink:0}
.bar-actions{display:flex;gap:10px;align-items:center}

.btn{
  padding:11px 24px;
  border:none;
  border-radius:var(--radius-sm);
  font-size:.8rem;
  font-weight:800;
  letter-spacing:.4px;
  text-transform:uppercase;
  cursor:pointer;
  transition:all .22s ease;
  display:inline-flex;
  align-items:center;
  gap:9px;
  font-family:inherit;
}
.btn svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}

.btn-primary{
  background:var(--brand-grad);
  color:#fff;
  box-shadow:0 10px 24px -8px rgba(99,102,241,.7);
}
.btn-primary:hover{
  transform:translateY(-2px);
  box-shadow:0 16px 32px -8px rgba(99,102,241,.8);
}
.btn-ghost{
  background:var(--surface-1);
  border:1px solid var(--line);
  color:var(--ink);
}
.btn-ghost:hover{
  border-color:var(--brand-2);
  color:var(--brand-2);
}

/* ============ RESPONSIVE ============ */
@media (max-width:900px){
  .topbar{padding:12px 16px}
  .brand-text{display:none}
  .hero{padding:28px 16px 24px}
  .hero h1{font-size:1.7rem;letter-spacing:-.8px}
  .hero-sub{font-size:.82rem}
  .main{padding:0 16px 40px}
  .picker{width:100%;flex-wrap:wrap}
  .picker-field{flex:1}
  .picker-field select, .picker-field input{min-width:0;width:100%}
  .picker-btn{width:100%;justify-content:center}
  table.roster th.stick-1, table.roster td.stick-1{width:150px;min-width:150px;padding:8px 10px}
  table.roster th.stick-2, table.roster td.stick-2{left:150px;width:70px;min-width:70px;font-size:.6rem}
  .emp .nm{font-size:.72rem;max-width:100px}
  .emp .av{width:26px;height:26px;font-size:.6rem}
  td.day{width:36px;min-width:36px;height:40px}
  td.day .badge{inset:5px;font-size:.6rem;border-radius:7px}
  .kpis{grid-template-columns:repeat(2,1fr)}
  .kpi{padding:12px 14px}
  .kpi-val{font-size:1.1rem}
  .kpi-icon{width:36px;height:36px}
  .kpi-icon svg{width:16px;height:16px}
  .bar{flex-direction:column;align-items:stretch}
  .btn{width:100%;justify-content:center}
}
</style>
</head>
<body>

<div class="ambient"></div>

<div class="app">

  <!-- ============ TOPBAR ============ -->
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">
        <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div class="brand-text">
        <div class="t">EIS Portal</div>
        <div class="s">Roster Manager</div>
      </div>
    </div>

    <div class="topbar-spacer"></div>

    <div class="topbar-actions">
      <button class="icon-btn" onclick="toggleTheme()" title="Toggle theme">
        <svg id="iconMoon" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg id="iconSun" style="display:none" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4"/>
          <line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/>
          <line x1="4.93" y1="4.93" x2="6.34" y2="6.34"/><line x1="17.66" y1="17.66" x2="19.07" y2="19.07"/>
          <line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/>
          <line x1="4.93" y1="19.07" x2="6.34" y2="17.66"/><line x1="17.66" y1="6.34" x2="19.07" y2="4.93"/>
        </svg>
      </button>
      <div class="user-chip">
        <div class="user-avatar"><%= (username != null && !username.isEmpty()) ? username.substring(0,1).toUpperCase() : "U" %></div>
        <span><%= username != null && !username.isEmpty() ? username : "User" %></span>
      </div>
    </div>
  </header>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-inner">
      <div>
        <div class="hero-tag"><span class="pulse"></span><%= m_strrole %> &middot; Live Roster</div>
        <h1>Team <span class="grad">Roster</span></h1>
        <p class="hero-sub">Manage monthly shifts for <strong><%= nameOfMonth %> <%= year %></strong>. Click any day cell to change the shift &mdash; save when you're done.</p>
      </div>

      <form method="get" action="" class="picker" id="monthYearForm">
        <div class="picker-field">
          <label>Month</label>
          <select name="month" id="monthSel">
            <% for (int m=1; m<=12; m++) { %>
              <option value="<%=m%>" <%= m==month ? "selected" : "" %>><%= monthNames[m] %></option>
            <% } %>
          </select>
          <svg class="chev" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div class="picker-field">
          <label>Year</label>
          <input type="number" id="yearSel" name="year" min="2024" max="2100" value="<%=year%>" required>
        </div>
        <input type="hidden" name="m_strroles" value="<%=m_strrole%>">
        <input type="hidden" name="username" value="<%=username%>">
        <button type="submit" class="picker-btn">
          <svg viewBox="0 0 24 24"><path d="M5 12h14"/><polyline points="12 5 19 12 12 19"/></svg>
          Load
        </button>
      </form>
    </div>
  </section>

  <!-- ============ MAIN ============ -->
  <main class="main">

<%
    // ---- Load data ----
    List<Map<String,Object>> employees = new ArrayList<>();
    Connection conn = null;
    PreparedStatement ps = null;
    ResultSet rsData = null;
    try {
        conn = DBUtilityAuto.getReportDBConnection();
        String q = "select * from rostertable where UPPER(TEAM) = UPPER(?) and UPPER(MONTHYEAR) = UPPER(?) order by id";
        ps = conn.prepareStatement(q);
        ps.setString(1, m_strrole);
        ps.setString(2, sort_MonthYear);
        rsData = ps.executeQuery();
        ResultSetMetaData md = rsData.getMetaData();
        int cc = md.getColumnCount();
        while (rsData.next()) {
            Map<String,Object> row = new HashMap<>();
            for (int i=1; i<=cc; i++) row.put(md.getColumnName(i).toUpperCase(), rsData.getObject(i));
            employees.add(row);
        }
    } catch (Exception e) { e.printStackTrace(); }
    finally {
        if (rsData != null) try { rsData.close(); } catch (Exception e) {}
        if (ps != null) try { ps.close(); } catch (Exception e) {}
    }
%>

    <!-- KPI strip -->
    <div class="kpis">
      <div class="kpi">
        <div class="kpi-icon"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
        <div><div class="kpi-val"><%= employees.size() %></div><div class="kpi-lbl">Employees</div></div>
      </div>
      <div class="kpi">
        <div class="kpi-icon"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></div>
        <div><div class="kpi-val"><%= noOfDays %></div><div class="kpi-lbl">Days</div></div>
      </div>
      <div class="kpi">
        <div class="kpi-icon"><svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
        <div><div class="kpi-val" style="font-size:1rem;"><%= sort_MonthYear %></div><div class="kpi-lbl">Period</div></div>
      </div>
      <div class="kpi">
        <div class="kpi-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
        <div><div class="kpi-val" style="font-size:.85rem;"><%= m_strrole %></div><div class="kpi-lbl">Team</div></div>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="toolbar">
      <div class="search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="searchEmp" placeholder="Search employee name..." autocomplete="off">
      </div>
      <div class="legend">
        <span class="legend-item"><span class="sw morning"></span>Morning</span>
        <span class="legend-item"><span class="sw general"></span>General</span>
        <span class="legend-item"><span class="sw afternoon"></span>Afternoon</span>
        <span class="legend-item"><span class="sw night"></span>Night</span>
        <span class="legend-item"><span class="sw weekoff"></span>Weekoff</span>
        <span class="legend-item"><span class="sw leave"></span>Leave</span>
        <span class="legend-item"><span class="sw holiday"></span>Holiday</span>
      </div>
    </div>

    <!-- Roster panel -->
    <div class="panel">
      <form id="rosterForm" method="post" action="<%=request.getContextPath()%>/RosterServlet">
        <input type="hidden" name="tableData" id="tableData">
        <input type="hidden" name="selectedMonth" value="<%=selectedMonth%>">
        <input type="hidden" name="selectedYear" value="<%=selectedYear%>">
        <input type="hidden" name="m_strroles" value="<%=m_strrole%>">
        <input type="hidden" name="username" value="<%=username%>">

        <div class="scroll">

<% if (employees.isEmpty()) { %>
        <div class="empty">
          <div class="empty-orb">
            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M9 16l2 2 4-4"/></svg>
          </div>
          <h3>No Roster Yet</h3>
          <p>No shifts saved for <strong><%= nameOfMonth %> <%= year %></strong>.<br>Upload a roster file or pick a different month.</p>
        </div>
<% } else { %>
        <table class="roster" id="rosterTable">
          <thead>
            <tr>
              <th class="stick-1" rowspan="2">Employee</th>
              <th class="stick-2" rowspan="2">Role</th>
              <% for (int d=1; d<=noOfDays; d++) {
                   LocalDate dt = LocalDate.of(year, month, d);
                   boolean wk = (dt.getDayOfWeek()==DayOfWeek.SATURDAY || dt.getDayOfWeek()==DayOfWeek.SUNDAY);
              %>
                <th class="<%= wk?"weekend":"" %>"><%= d %></th>
              <% } %>
              <th rowspan="2" style="min-width:52px;">WO</th>
              <th rowspan="2" style="min-width:52px;">Lv</th>
            </tr>
            <tr>
              <% for (int d=1; d<=noOfDays; d++) {
                   LocalDate dt = LocalDate.of(year, month, d);
                   String ds = dt.getDayOfWeek().getDisplayName(TextStyle.SHORT, Locale.ENGLISH).substring(0,2);
                   boolean wk = (dt.getDayOfWeek()==DayOfWeek.SATURDAY || dt.getDayOfWeek()==DayOfWeek.SUNDAY);
              %>
                <th class="<%= wk?"weekend":"" %>"><%= ds %></th>
              <% } %>
            </tr>
          </thead>
          <tbody>
          <%
             int empIdx = 0;
             for (Map<String,Object> emp : employees) {
                 String nm = emp.get("NAME") != null ? emp.get("NAME").toString() : "";
                 String id = emp.get("AD_ID") != null ? emp.get("AD_ID").toString() : "";
                 String pos = emp.get("POSITION") != null ? emp.get("POSITION").toString() : "";
                 String ini = "U";
                 if (nm.length()>0) {
                     String[] p = nm.trim().split("\\s+");
                     ini = (p.length>=2) ? (p[0].substring(0,1)+p[p.length-1].substring(0,1)) : nm.substring(0,1);
                     ini = ini.toUpperCase();
                 }
          %>
            <tr class="emp-row" data-name="<%= nm.toLowerCase() %>">
              <td class="stick-1">
                <div class="emp">
                  <div class="av"><%= ini %></div>
                  <div>
                    <div class="nm"><%= nm %></div>
                    <div class="id"><%= id %></div>
                  </div>
                </div>
                <input type="hidden" name="employeeName" value="<%= nm %>">
                <input type="hidden" name="adId" value="<%= id %>">
                <input type="hidden" name="position_<%= empIdx %>" value="<%= pos %>">
              </td>
              <td class="stick-2">
                <span class="pos-pill <%= pos.replaceAll("\\s+","") %>" data-pos="<%= pos %>"><%= pos.isEmpty() ? "—" : pos %></span>
              </td>

              <%
                 int wo=0, lv=0;
                 for (int d=1; d<=noOfDays; d++) {
                     String key = "DAY_" + d;
                     Object v = emp.get(key);
                     String shift = (v != null) ? v.toString().trim() : "";
                     if (shift.isEmpty()) shift = "NA";
                     String sl = shift.toLowerCase();
                     if (sl.contains("weekoff")) wo++;
                     if (sl.contains("leave")) lv++;

                     LocalDate dt = LocalDate.of(year, month, d);
                     boolean wk = (dt.getDayOfWeek()==DayOfWeek.SATURDAY || dt.getDayOfWeek()==DayOfWeek.SUNDAY);

                     String label = "·";
                     String bcls = "empty";
                     if (sl.contains("morning")) {
                         label = sl.contains("wfh")?"WH":(sl.contains("cc")?"CC":"M");
                         bcls = sl.contains("wfh")?"WFHM":(sl.contains("cc")?"CCM":"Morning");
                     } else if (sl.contains("general") || sl.contains("genral")) {
                         label = sl.contains("wfh")?"WD":(sl.contains("cc")?"CD":"D");
                         bcls = sl.contains("wfh")?"WFHG":(sl.contains("cc")?"CCG":"General");
                     } else if (sl.contains("afternoon")) {
                         label = sl.contains("wfh")?"WA":(sl.contains("cc")?"CA":"A");
                         bcls = sl.contains("wfh")?"WFHA":(sl.contains("cc")?"CCA":"Afternoon");
                     } else if (sl.contains("night")) {
                         label = sl.contains("wfh")?"WN":(sl.contains("cc")?"CN":"N");
                         bcls = sl.contains("wfh")?"WFHN":(sl.contains("cc")?"CCN":"Night");
                     } else if (sl.contains("weekoffadjust")) { label="WA"; bcls="Weekoff"; }
                     else if (sl.contains("weekoff")) { label="W"; bcls="Weekoff"; }
                     else if (sl.contains("sickleave")) { label="SL"; bcls="SL"; }
                     else if (sl.contains("casualleave")) { label="CL"; bcls="CL"; }
                     else if (sl.contains("earnedleave")) { label="EL"; bcls="EL"; }
                     else if (sl.contains("flexileave")) { label="FL"; bcls="FlexiLeave"; }
                     else if (sl.contains("holidayleave")) { label="HL"; bcls="HolidayLeave"; }
                     else if (sl.contains("leave")) { label="L"; bcls="Leave"; }
              %>
              <td class="day <%= wk?"weekend":"" %>" data-emp="<%=empIdx%>" data-day="<%=d%>">
                <div class="badge <%= bcls %>"><%= label %></div>
                <select name="mnt_<%= empIdx %>_<%= d %>" class="select-native" onchange="onPick(this)" onfocus="markPick(this)" onblur="unmarkPick(this)">
                  <option value="Morning" <%= shift.equalsIgnoreCase("Morning")?"selected":"" %>>Morning</option>
                  <option value="WFH-Morning" <%= shift.equalsIgnoreCase("WFH-Morning")?"selected":"" %>>WFH-Morning</option>
                  <option value="CC-Morning" <%= shift.equalsIgnoreCase("CC-Morning")?"selected":"" %>>CC-Morning</option>
                  <option value="General" <%= (shift.equalsIgnoreCase("General")||shift.equalsIgnoreCase("Genral"))?"selected":"" %>>General</option>
                  <option value="WFH-General" <%= shift.equalsIgnoreCase("WFH-General")?"selected":"" %>>WFH-General</option>
                  <option value="CC-General" <%= shift.equalsIgnoreCase("CC-General")?"selected":"" %>>CC-General</option>
                  <option value="Afternoon" <%= shift.equalsIgnoreCase("Afternoon")?"selected":"" %>>Afternoon</option>
                  <option value="WFH-Afternoon" <%= shift.equalsIgnoreCase("WFH-Afternoon")?"selected":"" %>>WFH-Afternoon</option>
                  <option value="CC-Afternoon" <%= shift.equalsIgnoreCase("CC-Afternoon")?"selected":"" %>>CC-Afternoon</option>
                  <option value="Night" <%= shift.equalsIgnoreCase("Night")?"selected":"" %>>Night</option>
                  <option value="WFH-Night" <%= shift.equalsIgnoreCase("WFH-Night")?"selected":"" %>>WFH-Night</option>
                  <option value="CC-Night" <%= shift.equalsIgnoreCase("CC-Night")?"selected":"" %>>CC-Night</option>
                  <option value="Weekoff" <%= shift.equalsIgnoreCase("Weekoff")?"selected":"" %>>Weekoff</option>
                  <option value="WeekoffAdjust" <%= shift.equalsIgnoreCase("WeekoffAdjust")?"selected":"" %>>Weekoff (Adjust)</option>
                  <option value="SickLeave" <%= shift.equalsIgnoreCase("SickLeave")?"selected":"" %>>Sick Leave</option>
                  <option value="CasualLeave" <%= shift.equalsIgnoreCase("CasualLeave")?"selected":"" %>>Casual Leave</option>
                  <option value="EarnedLeave" <%= shift.equalsIgnoreCase("EarnedLeave")?"selected":"" %>>Earned Leave</option>
                  <option value="FlexiLeave" <%= shift.equalsIgnoreCase("FlexiLeave")?"selected":"" %>>Flexi Leave</option>
                  <option value="HolidayLeave" <%= shift.equalsIgnoreCase("HolidayLeave")?"selected":"" %>>Holiday</option>
                  <option value="NA" <%= shift.equalsIgnoreCase("NA")?"selected":"" %>>Not Assigned</option>
                </select>
              </td>
              <% } %>
              <td class="summary wo"><%= wo %></td>
              <td class="summary lv"><%= lv %></td>
            </tr>
          <% empIdx++; } %>

          <!-- Aggregates -->
          <tr class="aggregate">
            <td class="stick-1" colspan="2">Morning Count</td>
            <% for (int d=1; d<=noOfDays; d++) {
                 int c=0;
                 for (Map<String,Object> emp : employees) {
                     Object v = emp.get("DAY_"+d);
                     if (v!=null && v.toString().toLowerCase().contains("morning")) c++;
                 }
            %>
              <td><span class="agg morning"><%= c %></span></td>
            <% } %>
            <td colspan="2"></td>
          </tr>
          <tr class="aggregate">
            <td class="stick-1" colspan="2">General Count</td>
            <% for (int d=1; d<=noOfDays; d++) {
                 int c=0;
                 for (Map<String,Object> emp : employees) {
                     Object v = emp.get("DAY_"+d);
                     if (v!=null) { String s=v.toString().toLowerCase(); if (s.contains("general")||s.contains("genral")) c++; }
                 }
            %>
              <td><span class="agg general"><%= c %></span></td>
            <% } %>
            <td colspan="2"></td>
          </tr>
          <tr class="aggregate">
            <td class="stick-1" colspan="2">Afternoon Count</td>
            <% for (int d=1; d<=noOfDays; d++) {
                 int c=0;
                 for (Map<String,Object> emp : employees) {
                     Object v = emp.get("DAY_"+d);
                     if (v!=null && v.toString().toLowerCase().contains("afternoon")) c++;
                 }
            %>
              <td><span class="agg afternoon"><%= c %></span></td>
            <% } %>
            <td colspan="2"></td>
          </tr>
          <tr class="aggregate">
            <td class="stick-1" colspan="2">Night Count</td>
            <% for (int d=1; d<=noOfDays; d++) {
                 int c=0;
                 for (Map<String,Object> emp : employees) {
                     Object v = emp.get("DAY_"+d);
                     if (v!=null && v.toString().toLowerCase().contains("night")) c++;
                 }
            %>
              <td><span class="agg night"><%= c %></span></td>
            <% } %>
            <td colspan="2"></td>
          </tr>
          <tr class="aggregate">
            <td class="stick-1" colspan="2">Total Assigned</td>
            <% for (int d=1; d<=noOfDays; d++) {
                 int c=0;
                 for (Map<String,Object> emp : employees) {
                     Object v = emp.get("DAY_"+d);
                     if (v!=null && !v.toString().trim().isEmpty() && !v.toString().equalsIgnoreCase("NA")) c++;
                 }
            %>
              <td><span class="agg total"><%= c %></span></td>
            <% } %>
            <td colspan="2"></td>
          </tr>

          </tbody>
        </table>
<% } %>

        </div>

        <% if (!employees.isEmpty()) { %>
        <div class="bar">
          <div class="bar-tip">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            Click any cell &rarr; pick a shift &rarr; click Save
          </div>
          <div class="bar-actions">
            <button type="button" class="btn btn-ghost" onclick="location.reload()">
              <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
              Reset
            </button>
            <button type="button" class="btn btn-primary" onclick="submitRoster()">
              <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Save Roster
            </button>
          </div>
        </div>
        <% } %>

      </form>
    </div>

  </main>
</div>

<script>
/* ============ THEME ============ */
(function(){
  var saved = null;
  try { saved = localStorage.getItem('roster-theme'); } catch(e){}
  if (saved === 'light') document.documentElement.setAttribute('data-theme','light');
  updateIcon();
})();
function toggleTheme(){
  var cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
  var next = cur === 'light' ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', next);
  try { localStorage.setItem('roster-theme', next); } catch(e){}
  updateIcon();
}
function updateIcon(){
  var isLight = document.documentElement.getAttribute('data-theme') === 'light';
  var m = document.getElementById('iconMoon'), s = document.getElementById('iconSun');
  if (!m || !s) return;
  m.style.display = isLight ? 'none' : 'block';
  s.style.display = isLight ? 'block' : 'none';
}

/* ============ SEARCH ============ */
document.getElementById('searchEmp').addEventListener('input', function(e){
  var q = e.target.value.toLowerCase().trim();
  document.querySelectorAll('tr.emp-row').forEach(function(r){
    var n = r.getAttribute('data-name') || '';
    r.style.display = (!q || n.indexOf(q) !== -1) ? '' : 'none';
  });
});

/* ============ CELL PICK ============ */
function markPick(sel){
  var td = sel.closest('td.day');
  if (td) td.classList.add('picking');
}
function unmarkPick(sel){
  var td = sel.closest('td.day');
  if (td) setTimeout(function(){ td.classList.remove('picking'); }, 150);
}
function onPick(sel){
  var td = sel.closest('td.day');
  var bd = td.querySelector('.badge');
  var v  = sel.value;
  var lv = v.toLowerCase();
  var label = "·", cls = "empty";

  if (lv.indexOf('morning')!==-1) { label = lv.indexOf('wfh')!==-1?'WH':(lv.indexOf('cc')!==-1?'CC':'M'); cls = lv.indexOf('wfh')!==-1?'WFHM':(lv.indexOf('cc')!==-1?'CCM':'Morning'); }
  else if (lv.indexOf('general')!==-1 || lv.indexOf('genral')!==-1) { label = lv.indexOf('wfh')!==-1?'WD':(lv.indexOf('cc')!==-1?'CD':'D'); cls = lv.indexOf('wfh')!==-1?'WFHG':(lv.indexOf('cc')!==-1?'CCG':'General'); }
  else if (lv.indexOf('afternoon')!==-1) { label = lv.indexOf('wfh')!==-1?'WA':(lv.indexOf('cc')!==-1?'CA':'A'); cls = lv.indexOf('wfh')!==-1?'WFHA':(lv.indexOf('cc')!==-1?'CCA':'Afternoon'); }
  else if (lv.indexOf('night')!==-1) { label = lv.indexOf('wfh')!==-1?'WN':(lv.indexOf('cc')!==-1?'CN':'N'); cls = lv.indexOf('wfh')!==-1?'WFHN':(lv.indexOf('cc')!==-1?'CCN':'Night'); }
  else if (lv.indexOf('weekoffadjust')!==-1) { label='WA'; cls='Weekoff'; }
  else if (lv.indexOf('weekoff')!==-1) { label='W'; cls='Weekoff'; }
  else if (lv.indexOf('sickleave')!==-1) { label='SL'; cls='SL'; }
  else if (lv.indexOf('casualleave')!==-1) { label='CL'; cls='CL'; }
  else if (lv.indexOf('earnedleave')!==-1) { label='EL'; cls='EL'; }
  else if (lv.indexOf('flexileave')!==-1) { label='FL'; cls='FlexiLeave'; }
  else if (lv.indexOf('holidayleave')!==-1) { label='HL'; cls='HolidayLeave'; }
  else if (lv.indexOf('leave')!==-1) { label='L'; cls='Leave'; }

  bd.textContent = label;
  bd.className = 'badge ' + cls;

  setTimeout(function(){ td.classList.remove('picking'); }, 200);
}

/* ============ SUBMIT — mnt_X_Y format preserved ============ */
function submitRoster(){
  // Collect all mnt_X_Y selects into JSON for compatibility, but ALSO
  // leave native form inputs (mnt_X_Y, employeeName, adId, position_X)
  // intact — the servlet will receive both. If it only reads mnt_X_Y,
  // nothing changes.
  var data = [];
  var rows = document.querySelectorAll('#rosterTable tbody tr.emp-row');
  rows.forEach(function(row, idx){
    var nm = row.querySelector('input[name="employeeName"]').value;
    var id = row.querySelector('input[name="adId"]').value;
    var posEl = row.querySelector('input[name="position_'+idx+'"]');
    var obj = { name: nm, adId: id, position: posEl ? posEl.value : '', days: {} };
    row.querySelectorAll('select[name^="mnt_"]').forEach(function(sel){
      var m = sel.name.match(/mnt_(\d+)_(\d+)/);
      if (m) obj.days[m[2]] = sel.value;
    });
    data.push(obj);
  });
  document.getElementById('tableData').value = JSON.stringify(data);
  document.getElementById('rosterForm').submit();
}
</script>

</body>
</html>

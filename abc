    color: var(--ink);
    letter-spacing: 0.5px;
    margin: 0;
}
.tx-chart-header p {
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    font-family: 'Courier New', monospace;
    margin: 0;
    letter-spacing: 0.5px;
}

/* ================================================================
   CHART AREA — fills remaining height
   ================================================================ */
.tx-chart-area {
    flex: 1;
    min-height: 0;
    padding: 0 12px 12px;
    background: var(--bg);
}
#myChart {
    width: 100%;
    height: 100%;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;

<!-- ============ LOADING OVERLAY ============ -->
<div class="loading-overlay" id="loadingOverlay">
  <div class="loader-cyber"></div>
  <div class="loader-text">LOADING</div>
  <div class="loader-sub">Establishing secure connection...</div>
</div>

<div class="new-wrapper">
<div class="dash-wrap">

  <!-- ============ PAGE HEAD ============ -->
  <section class="page-head">
    <div class="ttl-wrap">
      <h1 class="ttl">
        <span class="ttl-icon">
          <svg class="icon-svg" viewBox="0 0 24 24"><path d="M4.93 4.93a10 10 0 0 0 0 14.14M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M8.46 8.46a5 5 0 0 0 0 7.07M15.54 8.46a5 5 0 0 1 0 7.07"/><circle cx="12" cy="12" r="1.5"/></svg>
        </span>
        Source Monitor
      </h1>
      <p class="sub">
        Real-time source tracking
        <span class="partition-badge" id="partitionBadge">LOADING</span>
      </p>
    </div>
    <div class="head-actions">
      <div class="live-badge" id="liveBadge" style="display:none;">
        <span class="dot"></span>
        LIVE
      </div>
      <div class="timer-badge" id="timerBadge" style="display:none;">
        <svg class="icon-svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <div>
          <div class="time" id="timerDisplay">10:00</div>
          <div class="lbl">Next Refresh</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS ROW ============ -->
  <section class="stats-row" id="statsRow" style="display:none;">
    <div class="stat-card s-green">
      <div class="sicon">
        <svg class="icon-svg" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      </div>
      <div class="stext">
        <div class="snum" id="activeCount">0</div>
        <div class="slabel">Active Sources</div>
      </div>
    </div>
    <div class="stat-card s-red">
      <div class="sicon">
        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>
      </div>
      <div class="stext">
        <div class="snum" id="inactiveCount">0</div>
        <div class="slabel">Inactive Sources</div>
      </div>
    </div>
    <div class="stat-card s-blue">
      <div class="sicon">
        <svg class="icon-svg" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
      </div>
      <div class="stext">
        <div class="snum" id="totalSources">0</div>
        <div class="slabel">Total Sources</div>
      </div>
    </div>
    <div class="stat-card s-amber">
      <div class="sicon">
        <svg class="icon-svg" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      </div>
      <div class="stext">
        <div class="snum" id="uptimePercent">0<small>%</small></div>
        <div class="slabel">Uptime Rate</div>
      </div>
    </div>
  </section>

  <!-- ============ MAIN LAYOUT ============ -->
  <div class="monitor-main" id="mainGrid" style="display:none;">

    <!-- SOURCES PANEL -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">
          <svg class="icon-svg" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/></svg>
          Sources
          <span class="count-badge" id="sourceCount">0/0</span>
        </div>
        <div class="panel-legend">
          <span class="legend-item"><span class="swatch on"></span>Active</span>
          <span class="legend-item"><span class="swatch off"></span>Inactive</span>
        </div>
      </div>
      <div class="sources-grid" id="sourcesGrid"></div>
    </div>

    <!-- ACTIVITY PANEL -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">
          <svg class="icon-svg" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          Activity Log
        </div>
        <span style="font-size:.6rem;color:var(--muted);font-family:'JetBrains Mono',monospace;font-weight:800;letter-spacing:.5px;">LIVE</span>
      </div>
      <div class="activity-list" id="activityList">
        <div class="activity-empty">
          <svg class="icon-svg" viewBox="0 0 24 24"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
          <div>Waiting for signal...</div>
        </div>
      </div>
    </div>

  </div>

  <!-- ============ FOOTER ============ -->
  <footer class="foot">
    <div class="brandline"><b>EIS Portal</b> · Source Monitor</div>
    <div id="footTime">Loading...</div>
    <div>Designed &amp; Developed by EIS Automation Team</div>
  </footer>

</div>
</div>

<!-- ============ ERROR BANNER ============ -->
<div class="error-banner" id="errorBanner">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
  <span id="errorMessage">Connection Error</span>
</div>

<script>
/* ============================================================
   STATE
   ============================================================ */
var sourceData = {};
var activityLog = [];
var MAX_ACTIVITY = 30;
var timerSeconds = 600;
var timerInterval;
var retryCount = 0;
var maxRetries = 3;

/* ============================================================
   HELPERS
   ============================================================ */
function getPartition() {
  var months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
  var now = new Date();
  return months[now.getMonth()] + '_' + String(now.getFullYear()).slice(-2);
}

function formatTime(s) {
  var m = Math.floor(s / 60);
  var sec = s % 60;
  return String(m).padStart(2,'0') + ':' + String(sec).padStart(2,'0');
}

function updateTimer() {
  timerSeconds--;
  var el = document.getElementById('timerDisplay');
  if (el) el.textContent = formatTime(timerSeconds);
  if (timerSeconds <= 0) {
    location.reload();
  }
}

function updateFootTime() {
  var now = new Date();
  var hh = String(now.getHours()).padStart(2,'0');
  var mm = String(now.getMinutes()).padStart(2,'0');
  var footEl = document.getElementById('footTime');
  if (footEl) footEl.textContent = 'Session active · ' + hh + ':' + mm;
}

/* ============================================================
   ACTIVITY LOG
   ============================================================ */
function addActivity(source, status) {
  var now = new Date();
  var t = now.getHours().toString().padStart(2,'0') + ':' +
          now.getMinutes().toString().padStart(2,'0') + ':' +
          now.getSeconds().toString().padStart(2,'0');
  activityLog.unshift({ time: t, source: source, status: status });
  if (activityLog.length > MAX_ACTIVITY) activityLog.pop();
  renderActivity();
}

function renderActivity() {
  var c = document.getElementById('activityList');
  if (!c) return;

  if (activityLog.length === 0) {
    c.innerHTML = '<div class="activity-empty">' +
      '<svg class="icon-svg" viewBox="0 0 24 24"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>' +
      '<div>Waiting for signal...</div></div>';
    return;
  }

  var html = '';
  for (var i = 0; i < Math.min(activityLog.length, 20); i++) {
    var item = activityLog[i];
    var cls = item.status === 'Y' ? 'on' : 'off';
    var txt = item.status === 'Y' ? 'ON' : 'OFF';
    html += '<div class="activity-item ' + cls + '">' +
      '<span class="activity-time">' + item.time + '</span>' +
      '<span class="activity-source">' + item.source + '</span>' +
      '<span class="activity-status ' + cls + '">' + txt + '</span>' +
      '</div>';
  }
  c.innerHTML = html;
}

/* ============================================================
   HIDE LOADING
   ============================================================ */
function hideLoading() {
  var overlay = document.getElementById('loadingOverlay');
  if (overlay) overlay.classList.add('hide');

  var liveBadge = document.getElementById('liveBadge');
  if (liveBadge) liveBadge.style.display = 'flex';

  var timerBadge = document.getElementById('timerBadge');
  if (timerBadge) timerBadge.style.display = 'flex';

  var statsRow = document.getElementById('statsRow');
  if (statsRow) statsRow.style.display = 'grid';

  var mainGrid = document.getElementById('mainGrid');
  if (mainGrid) mainGrid.style.display = 'grid';

  var part = document.getElementById('partitionBadge');
  if (part) part.textContent = getPartition();

  var timerDisp = document.getElementById('timerDisplay');
  if (timerDisp) timerDisp.textContent = formatTime(timerSeconds);

  if (!timerInterval) {
    timerInterval = setInterval(updateTimer, 1000);
    setInterval(updateFootTime, 30000);
    updateFootTime();
  }
}

/* ============================================================
   ERROR BANNER
   ============================================================ */
function showError(msg) {
  var banner = document.getElementById('errorBanner');
  var msgEl = document.getElementById('errorMessage');
  if (msgEl) msgEl.textContent = msg || 'Connection Error - Retrying...';
  if (banner) banner.classList.add('show');

  setTimeout(function() {
    if (banner) banner.classList.remove('show');
  }, 5000);
}

/* ============================================================
   FETCH DATA
   ============================================================ */
function fetchData() {
  var url = '?action=fetchSourceStatus';
  console.log('Fetching: ' + url);

  fetch(url, {
    method: 'GET',
    cache: 'no-cache',
    headers: { 'Content-Type': 'application/json' }
  })
  .then(function(response) {
    if (!response.ok) {
      throw new Error('HTTP ' + response.status);
    }
    return response.json();
  })
  .then(function(data) {
    retryCount = 0;
    if (data.error) {
      showError('DB Error: ' + data.error);
      return;
    }
    renderSources(data);
    updateStats(data);
    updateActivity(data);
    hideLoading();
  })
  .catch(function(e) {
    console.error('Fetch Error:', e);
    retryCount++;

    if (retryCount <= maxRetries) {
      showError('Connection failed (Attempt ' + retryCount + '/' + maxRetries + ') - Retrying...');
      setTimeout(function() {
        fetchData();
      }, 3000);
    } else {
      showError('Connection Error - Please refresh the page');
      hideLoading();
      var grid = document.getElementById('sourcesGrid');
      if (grid) {
        grid.innerHTML =
          '<div style="text-align:center;padding:40px 20px;color:var(--red);grid-column:1/-1;">' +
          '<div style="font-size:1rem;font-weight:800;margin-bottom:4px;">Connection Lost</div>' +
          '<div style="font-size:.78rem;color:var(--muted);margin-bottom:16px;">Please refresh the page</div>' +
          '<button onclick="location.reload()" style="padding:10px 24px;background:var(--brand);color:#fff;border:none;border-radius:10px;font-weight:800;font-size:.78rem;cursor:pointer;text-transform:uppercase;letter-spacing:.5px;">Refresh</button>' +
          '</div>';
      }
    }
  });
}

/* ============================================================
   RENDER SOURCES
   ============================================================ */
function renderSources(data) {
  var c = document.getElementById('sourcesGrid');
  if (!c) return;

  if (!data || data.length === 0) {
    c.innerHTML = '<div style="text-align:center;padding:40px 20px;color:var(--muted);grid-column:1/-1;">' +
      '<div style="font-size:.85rem;font-weight:700;">No data available</div>' +
      '</div>';
    return;
  }

  var html = '';
  var active = 0;
  for (var i = 0; i < data.length; i++) {
    var item = data[i];
    var isActive = item.flag === 'Y';
    if (isActive) active++;
    var cls = isActive ? 'active' : 'inactive';
    var status = isActive ? 'ONLINE' : 'OFFLINE';
    var hits = isActive ? Math.floor(Math.random() * 50 + 10) : 0;

    html += '<div class="source-card ' + cls + '">' +
      '<span class="source-status-indicator"></span>' +
      '<div class="source-code">' + item.source_id + '</div>' +
      '<div class="source-status-text">' + status + '</div>' +
      '<span class="source-hits">' + (isActive ? '⚡ ' + hits : '⏸') + '</span>' +
      '</div>';
  }
  c.innerHTML = html;

  var countEl = document.getElementById('sourceCount');
  if (countEl) countEl.textContent = active + '/' + data.length;
}

/* ============================================================
   UPDATE STATS
   ============================================================ */
function updateStats(data) {
  var active = 0, inactive = 0;
  for (var i = 0; i < data.length; i++) {
    if (data[i].flag === 'Y') active++;
    else inactive++;
  }

  var activeEl = document.getElementById('activeCount');
  if (activeEl) activeEl.textContent = active;

  var inactiveEl = document.getElementById('inactiveCount');
  if (inactiveEl) inactiveEl.textContent = inactive;

  var totalEl = document.getElementById('totalSources');
  if (totalEl) totalEl.textContent = data.length;

  var uptime = data.length > 0 ? Math.round((active / data.length) * 100) : 0;
  var uptimeEl = document.getElementById('uptimePercent');
  if (uptimeEl) uptimeEl.innerHTML = uptime + '<small>%</small>';
}

/* ============================================================
   UPDATE ACTIVITY
   ============================================================ */
function updateActivity(data) {
  var current = {};
  for (var i = 0; i < data.length; i++) {
    if (data[i].flag === 'Y') current[data[i].source_id] = true;
  }

  for (var s in current) {
    if (!sourceData[s]) {
      addActivity(s, 'Y');
    } else if (sourceData[s] !== current[s]) {
      addActivity(s, current[s] ? 'Y' : 'N');
    }
  }

  for (var old in sourceData) {
    if (sourceData[old] && !current[old]) {
      addActivity(old, 'N');
    }
  }

  sourceData = current;
}

/* ============================================================
   CLEANUP
   ============================================================ */
window.addEventListener('beforeunload', function() {
  if (timerInterval) clearInterval(timerInterval);
});

/* ============================================================
   START
   ============================================================ */
fetchData();
</script>

</body>
</html>

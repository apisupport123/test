<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Team Roster - EIS Portal</title>

<style>
:root{
  --primary:#7C3AED;
  --primary-2:#8B5CF6;
  --primary-light:#F3E8FF;
  --accent:#EC4899;
  --accent-2:#F472B6;

  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F5F7FA;
  --card:#FFFFFF;
  --hover-bg:#F0F0F5;

  --morning:#FF8C00;
  --general:#696969;
  --afternoon:#DAA520;
  --night:#1E90FF;
  --weekoff:#1E40AF;
  --leave:#DC2626;
  --flexi:#EA580C;
  --holiday:#16A34A;
  --na:#111827;

  --success:#16A34A;
  --danger:#DC2626;
  --warning:#F59E0B;
}

html[data-theme="dark"]{
  --primary:#8B5CF6;
  --primary-2:#A78BFA;
  --primary-light:#2D1854;
  --accent:#F472B6;
  --accent-2:#F9A8D4;

  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#2A2A35;
  --bg:#0A0614;
  --card:#130A24;
  --hover-bg:#1F0E3D;

  --morning:#FB923C;
  --general:#9CA3AF;
  --afternoon:#FBBF24;
  --night:#60A5FA;
  --weekoff:#60A5FA;
  --leave:#F87171;
  --flexi:#FB923C;
  --holiday:#4ADE80;
  --na:#374151;
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-weight:600;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  transition:background .3s ease,color .3s ease;
  overflow-x:hidden;
}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none}

/* ============ TOP HEADER ============ */
.top-header{
  position:sticky;
  top:0;
  z-index:100;
  background:linear-gradient(135deg, #1A0B2E 0%, #2D1854 100%);
  color:#fff;
  padding:20px 32px;
  box-shadow:0 4px 20px rgba(0,0,0,.2);
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  flex-wrap:wrap;
}
html[data-theme="dark"] .top-header{
  background:linear-gradient(135deg, #0F0422 0%, #1A0B2E 100%);
}

.header-left{position:relative;z-index:2;}
.header-left .badge{
  display:inline-flex;align-items:center;gap:8px;
  padding:5px 12px;
  background:rgba(244,114,182,.2);
  border:1px solid rgba(244,114,182,.4);
  border-radius:999px;
  font-size:.68rem;font-weight:800;
  color:#F9A8D4;letter-spacing:1px;
  text-transform:uppercase;margin-bottom:10px;
}
.header-left .badge .dot{
  width:6px;height:6px;border-radius:50%;
  background:#F9A8D4;
  box-shadow:0 0 8px #F9A8D4;
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

.header-left h1{
  font-size:1.8rem;font-weight:900;
  letter-spacing:-.8px;line-height:1.15;
}
.header-left h1 .gradient{
  background:linear-gradient(135deg,#A78BFA,#F9A8D4);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.header-left .meta{
  font-size:.78rem;color:rgba(255,255,255,.7);
  margin-top:6px;display:flex;gap:14px;flex-wrap:wrap;
}
.header-left .meta span{display:inline-flex;align-items:center;gap:6px;}

.header-right{
  position:relative;z-index:2;
  display:flex;gap:10px;align-items:center;flex-wrap:wrap;
}

.month-picker{
  display:flex;gap:6px;align-items:center;
  background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.15);
  border-radius:12px;padding:5px 10px;
  backdrop-filter:blur(10px);
}
.month-picker select,
.month-picker input{
  padding:7px 10px;background:transparent;border:none;
  color:#fff;font-weight:700;font-size:.82rem;outline:none;
  cursor:pointer;font-family:inherit;
}
.month-picker select option{color:#0A0A0A;background:#fff}
.month-picker input[type="number"]{width:64px}

.btn-header{
  padding:9px 16px;border-radius:10px;
  font-weight:800;font-size:.75rem;
  text-transform:uppercase;letter-spacing:.5px;
  display:inline-flex;align-items:center;gap:8px;
  transition:all .2s ease;cursor:pointer;
  border:1px solid transparent;
}
.btn-header svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;}
.btn-primary-header{
  background:linear-gradient(135deg,#8B5CF6,#EC4899);
  color:#fff;box-shadow:0 6px 18px -6px #7C3AED;
}
.btn-primary-header:hover{transform:translateY(-2px);box-shadow:0 10px 24px -6px #7C3AED;}
.btn-ghost-header{
  background:rgba(255,255,255,.1);color:#fff;
  border-color:rgba(255,255,255,.2);
}
.btn-ghost-header:hover{background:rgba(255,255,255,.2);}

/* Theme toggle */
.theme-toggle{
  width:44px;height:44px;border-radius:12px;
  background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.2);
  color:#fff;
  display:grid;place-items:center;
  cursor:pointer;transition:all .25s ease;
  position:relative;overflow:hidden;
}
.theme-toggle:hover{
  background:rgba(255,255,255,.2);
  transform:scale(1.05);
}
.theme-toggle svg{
  width:22px;height:22px;
  stroke:currentColor;fill:none;
  stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;
  transition:transform .5s cubic-bezier(.4,0,.2,1);
}
.theme-toggle .icon-sun{display:none;}
.theme-toggle .icon-moon{display:block;}
html[data-theme="dark"] .theme-toggle .icon-sun{display:block;}
html[data-theme="dark"] .theme-toggle .icon-moon{display:none;}

/* ============ STATS BAR ============ */
.stats-bar{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(160px, 1fr));
  gap:12px;
  padding:16px 32px;
  background:var(--card);
  border-bottom:1px solid var(--line);
}
.stat-box{
  background:var(--bg);
  border:1px solid var(--line);
  border-radius:12px;
  padding:12px 16px;
  transition:all .2s ease;
}
.stat-box:hover{
  border-color:var(--primary);
  transform:translateY(-2px);
  box-shadow:0 8px 20px -8px rgba(124,58,237,.2);
}
.stat-box .st-lbl{
  font-size:.65rem;text-transform:uppercase;letter-spacing:.8px;
  color:var(--muted);font-weight:800;
}
.stat-box .st-val{
  font-size:1.35rem;font-weight:900;color:var(--ink);
  margin-top:4px;letter-spacing:-.5px;
}
.stat-box .st-val.primary{color:var(--primary);}

/* ============ LEGEND ============ */
.legend-bar{
  padding:12px 32px;
  background:var(--card);
  border-bottom:1px solid var(--line);
  display:flex;gap:10px;flex-wrap:wrap;align-items:center;
  font-size:.72rem;font-weight:700;
}
.legend-label{
  color:var(--muted);text-transform:uppercase;
  letter-spacing:1px;font-size:.65rem;font-weight:800;
  margin-right:8px;
}
.legend-item{
  display:inline-flex;align-items:center;gap:6px;
  padding:5px 12px;border-radius:999px;
  background:var(--bg);border:1px solid var(--line);
}
.legend-dot{
  width:12px;height:12px;border-radius:4px;flex-shrink:0;
}
.legend-dot.morning{background:var(--morning);}
.legend-dot.general{background:var(--general);}
.legend-dot.afternoon{background:var(--afternoon);}
.legend-dot.night{background:var(--night);}
.legend-dot.weekoff{background:var(--weekoff);}
.legend-dot.leave{background:var(--leave);}
.legend-dot.flexi{background:var(--flexi);}
.legend-dot.holiday{background:var(--holiday);}
.legend-dot.na{background:var(--na);}

/* ============ SEARCH ============ */
.search-bar{
  padding:12px 32px;
  background:var(--card);
  border-bottom:1px solid var(--line);
  display:flex;gap:12px;align-items:center;flex-wrap:wrap;
}
.search-box{
  position:relative;flex:1;max-width:420px;
}
.search-box svg{
  position:absolute;left:14px;top:50%;
  transform:translateY(-50%);
  width:16px;height:16px;
  stroke:var(--muted);fill:none;stroke-width:2.4;
  pointer-events:none;
}
.search-box input{
  width:100%;padding:10px 14px 10px 42px;
  background:var(--bg);border:1.5px solid var(--line);
  border-radius:11px;color:var(--ink);
  font-family:inherit;font-size:.85rem;font-weight:600;
  outline:none;transition:all .2s ease;
}
.search-box input:focus{
  border-color:var(--primary);background:var(--card);
  box-shadow:0 0 0 4px rgba(124,58,237,.1);
}
.search-info{
  color:var(--muted);font-size:.78rem;font-weight:700;
}

/* ============ ROSTER WRAP ============ */
.roster-wrap{
  padding:16px 32px 80px;
  overflow-x:auto;
}

.roster-table{
  width:100%;
  min-width:1200px;
  border-collapse:separate;
  border-spacing:0;
  background:var(--card);
  border-radius:14px;
  overflow:hidden;
  box-shadow:0 4px 20px rgba(0,0,0,.05);
}

.roster-table thead th{
  position:sticky;top:0;
  background:var(--card);z-index:10;
  padding:10px 6px;
  font-size:.7rem;font-weight:800;
  text-transform:uppercase;letter-spacing:.5px;
  color:var(--muted);
  border-bottom:2px solid var(--line);
  text-align:center;white-space:nowrap;
}
.roster-table thead th.emp-col{
  position:sticky;left:0;z-index:20;
  text-align:left;padding-left:16px;
  min-width:180px;background:var(--card);
  box-shadow:2px 0 8px -4px rgba(0,0,0,.1);
}
.roster-table thead th.pos-col{
  position:sticky;left:180px;z-index:20;
  text-align:left;min-width:110px;
  background:var(--card);
  box-shadow:2px 0 8px -4px rgba(0,0,0,.1);
}
.roster-table thead th.weekend-header{
  background:#FEF3C7;color:#92400E;
}
html[data-theme="dark"] .roster-table thead th.weekend-header{
  background:rgba(254,243,199,.15);color:#FCD34D;
}

.roster-table tbody tr{transition:background .15s ease;}
.roster-table tbody tr:hover{background:var(--hover-bg);}
.roster-table tbody td{
  padding:6px 4px;
  border-bottom:1px solid var(--line);
  text-align:center;
  font-size:.82rem;font-weight:700;
  color:var(--ink);
}
.roster-table tbody td.emp-col{
  position:sticky;left:0;z-index:5;
  text-align:left;padding-left:16px;
  background:var(--card);
  box-shadow:2px 0 8px -4px rgba(0,0,0,.1);
  font-weight:800;
}
.roster-table tbody tr:hover td.emp-col{
  background:var(--hover-bg);
}
.roster-table tbody td.pos-col{
  position:sticky;left:180px;z-index:5;
  text-align:left;background:var(--card);
  box-shadow:2px 0 8px -4px rgba(0,0,0,.1);
}
.roster-table tbody tr:hover td.pos-col{
  background:var(--hover-bg);
}

.emp-cell{display:flex;align-items:center;gap:10px;}
.emp-avatar{
  width:32px;height:32px;border-radius:50%;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#fff;display:grid;place-items:center;
  font-weight:900;font-size:.78rem;flex-shrink:0;
}
.emp-name{font-size:.82rem;color:var(--ink);line-height:1.2;}

/* ============ SHIFT SELECT (BIG, FULL-CELL) ============ */
.shift-cell{
  padding:0 !important;
  height:44px;
  position:relative;
}

.shift-select{
  width:100%;
  height:100%;
  min-height:44px;
  padding:8px 4px;
  border:none;
  border-radius:0;
  color:#fff;
  font-family:inherit;
  font-size:.78rem;
  font-weight:900;
  text-align:center;
  text-align-last:center;
  cursor:pointer;
  outline:none;
  transition:all .15s ease;
  appearance:none;
  -webkit-appearance:none;
  -moz-appearance:none;
  background-image:none;
}
.shift-select:hover{
  filter:brightness(1.15);
  box-shadow:inset 0 0 0 2px rgba(255,255,255,.4);
}
.shift-select:focus{
  box-shadow:inset 0 0 0 3px rgba(255,255,255,.6);
  z-index:2;
  position:relative;
}
.shift-select option{
  background:#fff;
  color:#0A0A0A;
  font-weight:700;
  padding:8px;
}

/* Shift colors */
.shift-select.morning{background:var(--morning);color:#fff;}
.shift-select.general{background:var(--general);color:#fff;}
.shift-select.afternoon{background:var(--afternoon);color:#1A1A1A;}
.shift-select.night{background:var(--night);color:#fff;}
.shift-select.weekoff{background:var(--weekoff);color:#fff;}
.shift-select.leave{background:var(--leave);color:#fff;}
.shift-select.flexi{background:var(--flexi);color:#fff;}
.shift-select.holiday{background:var(--holiday);color:#1A1A1A;}
.shift-select.na{background:var(--na);color:#fff;}

/* ============ SUMMARY ROWS ============ */
.roster-table tbody tr.summary-row{
  background:var(--primary-light);
  font-weight:900;
}
html[data-theme="dark"] .roster-table tbody tr.summary-row{
  background:rgba(124,58,237,.1);
}
.roster-table tbody tr.summary-row td{
  font-size:.8rem;
  color:var(--primary);
  border-bottom:1px solid var(--line);
  height:38px;
}
.roster-table tbody tr.summary-row td.emp-col{
  background:var(--primary-light);
  font-size:.78rem;
  text-transform:uppercase;
  letter-spacing:.5px;
}
html[data-theme="dark"] .roster-table tbody tr.summary-row td.emp-col{
  background:rgba(124,58,237,.1);
}

/* ============ FOOTER ============ */
.footer-actions{
  position:fixed;
  bottom:0;left:0;right:0;
  background:var(--card);
  border-top:1px solid var(--line);
  padding:12px 32px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  z-index:50;
  box-shadow:0 -4px 20px rgba(0,0,0,.08);
  flex-wrap:wrap;
}
.footer-info{
  font-size:.78rem;color:var(--muted);font-weight:700;
}
.btn-primary{
  padding:12px 28px;
  border-radius:12px;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  color:#fff;font-size:.82rem;font-weight:800;
  text-transform:uppercase;letter-spacing:.5px;
  display:inline-flex;align-items:center;gap:10px;
  transition:all .25s ease;
  box-shadow:0 8px 22px -8px var(--primary);
}
.btn-primary:hover{
  transform:translateY(-2px);
  box-shadow:0 14px 32px -8px var(--primary);
}
.btn-primary svg{
  width:18px;height:18px;
  stroke:currentColor;fill:none;stroke-width:2.4;
}

/* ============ EMPTY STATE ============ */
.empty-state{
  text-align:center;padding:80px 40px;color:var(--muted);
}
.empty-state svg{
  width:64px;height:64px;stroke:var(--primary);
  fill:none;stroke-width:1.5;opacity:.4;margin-bottom:16px;
}
.empty-state h3{
  font-size:1.2rem;color:var(--ink);margin-bottom:8px;
}

/* ============ RESPONSIVE ============ */
@media (max-width:900px){
  .top-header{padding:16px 16px;}
  .header-left h1{font-size:1.3rem;}
  .stats-bar{padding:12px 16px;grid-template-columns:repeat(2,1fr);}
  .legend-bar{padding:10px 16px;}
  .search-bar{padding:10px 16px;}
  .roster-wrap{padding:12px 8px 100px;}
  .footer-actions{padding:10px 16px;}
  .roster-table thead th.emp-col{min-width:140px;padding-left:10px;}
  .roster-table thead th.pos-col{left:140px;min-width:90px;}
  .roster-table tbody td.emp-col{padding-left:10px;}
  .roster-table tbody td.pos-col{left:140px;}
  .shift-select{font-size:.7rem;min-height:40px;}
}
</style>
</head>

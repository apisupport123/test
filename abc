}
html[data-theme="dark"] .tile-critical {
    background: rgba(231,76,60,.2);
}
html[data-theme="dark"] .tile-critical .val { color: #FF6B5B; }
html[data-theme="dark"] .tile-critical .sub-text { color: #FF6B5B; }

.tile-td {
    background: rgba(231,76,60,.2);
    border-color: rgba(231,76,60,.4);
}
.tile-td .val { color: #E74C3C; font-size: 1.15rem; font-weight: 900; text-shadow: 0 0 10px rgba(231,76,60,.4); }
.tile-td .sub-text { color: #E74C3C; }
.tile-td .bar .fill { background: #E74C3C; width: 80%; }
.tile-td.pulse { animation: td-pulse 2s ease-in-out infinite; }
@keyframes td-pulse {
    0%,100% { box-shadow: 0 0 0 rgba(231,76,60,0); }
    50% { box-shadow: 0 0 15px rgba(231,76,60,.5); }
}

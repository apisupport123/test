<script>
/* ============================================================
   ✅ ADMIN LOGOUT — session invalidate + login pe redirect
   ============================================================ */
function adminLogout(){
  window.__logoutInProgress = true;

  try{
    sessionStorage.clear();
    localStorage.removeItem('eis-sidebar-closed');
  }catch(e){}

  // ✅ logout=true parameter — server side session invalidate hoga
  window.location.replace('<%=ctx%>/login.action?logout=true');
}

/* ============================================================
   ✅ SIDEBAR TOGGLE (mobile)
   ============================================================ */
function toggleAdminSidebar(){
  var sb = document.getElementById('adminSidebar');
  var ov = document.getElementById('adminOverlay');
  sb.classList.toggle('expanded');
  if(ov) ov.classList.toggle('show');
}
function closeAdminSidebar(){
  var sb = document.getElementById('adminSidebar');
  var ov = document.getElementById('adminOverlay');
  sb.classList.remove('expanded');
  if(ov) ov.classList.remove('show');
}

/* ============================================================
   ✅ BACK BUTTON BLOCK — with logout exception
   ============================================================ */
(function(){
  window.history.pushState({ page: 'admin' }, '', window.location.href);
  window.addEventListener('popstate', function(e){
    if(window.__logoutInProgress === true) return;
    window.history.pushState({ page: 'admin' }, '', window.location.href);
  });
})();

/* ============================================================
   ✅ SESSION CHECK — agar role nahi hai toh login pe bhejo
   ============================================================ */
(function(){
  // Auto session check every 60s
  setInterval(function(){
    // Optional: /login.action se check kar sakte ho
  }, 60000);
})();
</script>

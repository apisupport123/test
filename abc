<title>Employee Registry · EIS Portal</title>

<style>
/* ================================================================
   THEME TOKENS — LIGHT & DARK
   ================================================================ */
:root,
html[data-theme="light"] {
    --brand-1: #6366f1;
    --brand-2: #8b5cf6;
    --brand-3: #ec4899;
    --brand-4: #06b6d4;
    --brand-5: #10b981;

    --bg:        #f5f6fb;
    --bg-solid:  #eef0f7;
    --surface:   #ffffff;
    --surface-2: #f9fafb;
    --surface-3: #f3f4f6;
    --border:    #e5e7eb;
    --border-2:  #d1d5db;

    --text:      #0f172a;
    --text-2:    #334155;
    --text-3:    #64748b;
    --text-4:    #94a3b8;

    --green:      #10b981;
    --green-bg:   #d1fae5;
    --green-text: #065f46;
    --red:        #ef4444;
    --red-bg:     #fee2e2;
    --red-text:   #991b1b;

    --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);
    --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
    --shadow:    0 4px 16px rgba(15, 23, 42, 0.06), 0 2px 6px rgba(15, 23, 42, 0.04);
    --shadow-md: 0 12px 32px rgba(15, 23, 42, 0.08), 0 4px 12px rgba(15, 23, 42, 0.04);
    --shadow-lg: 0 24px 60px rgba(15, 23, 42, 0.12);

    --nav-bg: rgba(255, 255, 255, 0.75);
    --nav-border: rgba(255, 255, 255, 0.6);

    --mesh-opacity: 0.35;
    --mesh-blend: multiply;
}

html[data-theme="dark"] {
    --brand-1: #818cf8;
    --brand-2: #a78bfa;
    --brand-3: #f472b6;
    --brand-4: #22d3ee;
    --brand-5: #34d399;

    --bg:        #0a0b14;
    --bg-solid:  #0f1020;
    --surface:   #16172a;
    --surface-2: #1c1d34;
    --surface-3: #232544;
    --border:    #2a2c48;
    --border-2:  #363858;

    --text:      #f1f5f9;
    --text-2:    #cbd5e1;
    --text-3:    #94a3b8;
    --text-4:    #64748b;

    --green:      #34d399;
    --green-bg:   rgba(16, 185, 129, 0.15);
    --green-text: #6ee7b7;
    --red:        #f87171;
    --red-bg:     rgba(239, 68, 68, 0.15);
    --red-text:   #fca5a5;

    --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.3);
    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4), 0 1px 2px rgba(0, 0, 0, 0.3);
    --shadow:    0 4px 16px rgba(0, 0, 0, 0.4), 0 2px 6px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 12px 32px rgba(0, 0, 0, 0.5), 0 4px 12px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 24px 60px rgba(0, 0, 0, 0.6);

    --nav-bg: rgba(22, 23, 42, 0.75);
    --nav-border: rgba(42, 44, 72, 0.8);

    --mesh-opacity: 0.25;
    --mesh-blend: screen;
}

/* ================================================================
   RESET
   ================================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --r-sm: 8px;
    --r:    14px;
    --r-lg: 20px;
    --r-xl: 28px;

    --font: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
            "Helvetica Neue", Arial, sans-serif;
    --mono: ui-monospace, "SF Mono", Consolas, "Liberation Mono", monospace;
}

html { transition: background-color 0.3s ease; }

body {
    font-family: var(--font);
    color: var(--text);
    background: var(--bg);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    transition: background-color 0.3s ease, color 0.3s ease;
}

/* ================================================================
   ANIMATED MESH BACKGROUND
   ================================================================ */
.mesh-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: var(--bg);
    transition: background 0.3s ease;
}
.mesh-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: var(--mesh-opacity);
    mix-blend-mode: var(--mesh-blend);
    will-change: transform;
    transition: opacity 0.3s ease;
}
.mesh-blob.m1 {
    width: 600px; height: 600px;
    background: radial-gradient(circle, var(--brand-1), transparent 65%);
    top: -15%; left: -10%;
    animation: meshMove 24s ease-in-out infinite;
}
.mesh-blob.m2 {
    width: 700px; height: 700px;
    background: radial-gradient(circle, var(--brand-3), transparent 65%);
    top: 20%; right: -20%;
    animation: meshMove 28s ease-in-out infinite reverse;
}
.mesh-blob.m3 {
    width: 500px; height: 500px;
    background: radial-gradient(circle, var(--brand-4), transparent 65%);
    bottom: -15%; left: 30%;
    animation: meshMove 32s ease-in-out infinite;
    animation-delay: -10s;
}
@keyframes meshMove {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(80px, -60px) scale(1.15); }
    66%      { transform: translate(-60px, 70px) scale(0.9); }
}

/* ================================================================
   TOP NAV
   ================================================================ */
.topnav {
    background: var(--nav-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--nav-border);
    padding: 0 28px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-xs);
    transition: background 0.3s ease, border-color 0.3s ease;
}
.nav-brand { display: flex; align-items: center; gap: 14px; }
.nav-logo {
    width: 40px; height: 40px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-3));
    display: grid; place-items: center;
    color: #fff;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: -0.5px;
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
}
.nav-title {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.3px;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-3));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}
.nav-subtitle {
    font-size: 11.5px;
    color: var(--text-3);
    margin-top: 1px;
}
.nav-actions { display: flex; gap: 10px; align-items: center; }

/* ================================================================
   BUTTONS
   ================================================================ */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 18px;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: -0.1px;
    border-radius: 10px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    text-decoration: none;
    white-space: nowrap;
    line-height: 1;
    height: 40px;
}
.btn-primary {
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    color: #fff;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
}
.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(99, 102, 241, 0.5);
}
.btn-secondary {
    background: var(--surface);
    color: var(--text-2);
    border-color: var(--border);
    box-shadow: var(--shadow-xs);
}
.btn-secondary:hover {
    background: var(--surface-2);
    color: var(--text);
    border-color: var(--border-2);
    transform: translateY(-1px);
}
.btn-danger {
    background: var(--surface);
    color: var(--red);
    border-color: var(--border);
    box-shadow: var(--shadow-xs);
}
.btn-danger:hover {
    background: var(--red-bg);
    border-color: var(--red);
    color: var(--red-text);
    transform: translateY(-1px);
}

/* Theme toggle */
.theme-toggle {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    cursor: pointer;
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-xs);
    transition: all 0.25s ease;
    overflow: hidden;
}
.theme-toggle:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
    border-color: var(--border-2);
}
.theme-toggle svg {
    position: absolute;
    width: 18px;
    height: 18px;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s;
    color: var(--text-2);
}
.theme-toggle .sun  { opacity: 0; transform: rotate(-90deg) scale(0.5); }
.theme-toggle .moon { opacity: 1; transform: rotate(0) scale(1); }
html[data-theme="dark"] .theme-toggle .sun  { opacity: 1; transform: rotate(0) scale(1); }
html[data-theme="dark"] .theme-toggle .moon { opacity: 0; transform: rotate(90deg) scale(0.5); }

/* ================================================================
   PAGE
   ================================================================ */
.page {
    max-width: 1440px;
    margin: 0 auto;
    padding: 32px 24px 60px;
}

.page-header {
    margin-bottom: 28px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
}
.page-header h1 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.1;
    background: linear-gradient(135deg, var(--text) 40%, var(--brand-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}
.page-header p {
    font-size: 14px;
    color: var(--text-3);
    margin-top: 8px;
}

/* ================================================================
   STATS — CLICKABLE FILTERS
   ================================================================ */
.stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}

.stat {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: 22px 22px 20px;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    cursor: pointer;
    user-select: none;
}
.stat::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    border-radius: var(--r-lg) var(--r-lg) 0 0;
}
.stat.indigo::before { background: linear-gradient(90deg, var(--brand-1), var(--brand-2)); }
.stat.green::before  { background: linear-gradient(90deg, #10b981, #34d399); }
.stat.pink::before   { background: linear-gradient(90deg, #ec4899, #f472b6); }
.stat.cyan::before   { background: linear-gradient(90deg, #06b6d4, #22d3ee); }

.stat:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-2);
}

/* ⭐ Selected filter state */
.stat.selected {
    border-color: var(--brand-1);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15), var(--shadow-md);
    transform: translateY(-2px);
}
.stat.selected::after {
    content: "✓ FILTERED";
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.8px;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    color: #fff;
    padding: 3px 8px;
    border-radius: 100px;
    box-shadow: 0 4px 10px rgba(99, 102, 241, 0.35);
}

.stat-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
}
.stat-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-size: 20px;
    flex-shrink: 0;
}
.stat.indigo .stat-icon { background: linear-gradient(135deg, #eef2ff, #e0e7ff); color: var(--brand-1); }
.stat.green  .stat-icon { background: linear-gradient(135deg, #d1fae5, #a7f3d0); color: #065f46; }
.stat.pink   .stat-icon { background: linear-gradient(135deg, #fce7f3, #fbcfe8); color: #be185d; }
.stat.cyan   .stat-icon { background: linear-gradient(135deg, #cffafe, #a5f3fc); color: #0e7490; }

html[data-theme="dark"] .stat.indigo .stat-icon { background: rgba(99, 102, 241, 0.15); color: #a5b4fc; }
html[data-theme="dark"] .stat.green  .stat-icon { background: rgba(16, 185, 129, 0.15); color: #6ee7b7; }
html[data-theme="dark"] .stat.pink   .stat-icon { background: rgba(236, 72, 153, 0.15); color: #f9a8d4; }
html[data-theme="dark"] .stat.cyan   .stat-icon { background: rgba(6, 182, 212, 0.15); color: #67e8f9; }

.stat-trend {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 100px;
    background: var(--green-bg);
    color: var(--green-text);
}
.stat-trend.neutral {
    background: var(--surface-3);
    color: var(--text-3);
}

.stat-value {
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -1.2px;
    color: var(--text);
    line-height: 1;
    margin-bottom: 4px;
}
.stat-label {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-3);
}

/* ================================================================
   ALERTS
   ================================================================ */
.alert {
    border-radius: var(--r);
    padding: 14px 20px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid;
    box-shadow: var(--shadow-xs);
    animation: alertIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes alertIn {
    from { opacity: 0; transform: translateY(-10px); }
    to   { opacity: 1; transform: translateY(0); }
}
.alert-error {
    background: var(--red-bg);
    border-color: var(--red);
    color: var(--red-text);
}
.alert-success {
    background: var(--green-bg);
    border-color: var(--green);
    color: var(--green-text);
}

/* ================================================================
   FILTER BAR (appears when filter active)
   ================================================================ */
.filter-bar {
    display: none;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.08), rgba(236, 72, 153, 0.05));
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: var(--r);
    margin-bottom: 20px;
    animation: filterIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.filter-bar.show { display: flex; }
@keyframes filterIn {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
}

.filter-icon {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    display: grid;
    place-items: center;
    color: #fff;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

.filter-text {
    flex: 1;
    font-size: 13.5px;
    color: var(--text-2);
    font-weight: 500;
}
.filter-text strong {
    color: var(--text);
    font-weight: 700;
}

.filter-clear {
    padding: 8px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-2);
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}
.filter-clear:hover {
    background: var(--brand-1);
    color: #fff;
    border-color: var(--brand-1);
    transform: translateY(-1px);
}

/* ================================================================
   LAYOUT
   ================================================================ */
.layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 480px;
    gap: 20px;
    align-items: start;
}
.card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: background 0.3s ease, border-color 0.3s ease;
}

.card-toolbar {
    padding: 18px 22px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--surface-2);
    transition: background 0.3s ease;
}

.search-input { position: relative; flex: 1; }
.search-input svg {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-4);
    pointer-events: none;
}
.search-input input {
    width: 100%;
    height: 44px;
    padding: 0 16px 0 42px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    outline: none;
    transition: all 0.2s ease;
}
.search-input input::placeholder { color: var(--text-4); font-weight: 400; }
.search-input input:focus {
    border-color: var(--brand-1);
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.12);
}

/* ================================================================
   EMPLOYEE LIST
   ================================================================ */
.list-head {
    display: grid;
    grid-template-columns: 48px 1fr 140px 110px 84px;
    align-items: center;
    gap: 14px;
    padding: 12px 22px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    font-size: 11px;
    font-weight: 700;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.7px;
}
.list-scroll { max-height: 640px; overflow-y: auto; }

.emp-row {
    display: grid;
    grid-template-columns: 48px 1fr 140px 110px 84px;
    align-items: center;
    gap: 14px;
    padding: 14px 22px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: all 0.15s ease;
    background: var(--surface);
    position: relative;
}
.emp-row:last-child { border-bottom: none; }
.emp-row:hover { background: var(--surface-2); }
.emp-row.active { background: linear-gradient(90deg, rgba(99, 102, 241, 0.08), rgba(139, 92, 246, 0.04)); }
.emp-row.active::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, var(--brand-1), var(--brand-2));
    border-radius: 0 4px 4px 0;
}
.emp-row.hidden { display: none; }

.avatar {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 14px;
    flex-shrink: 0;
    overflow: hidden;
    color: #fff;
    letter-spacing: -0.3px;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.15);
}
.avatar img { width: 100%; height: 100%; object-fit: cover; }
.avatar.c1 { background: linear-gradient(135deg, #6366f1, #8b5cf6); }
.avatar.c2 { background: linear-gradient(135deg, #ec4899, #f43f5e); }
.avatar.c3 { background: linear-gradient(135deg, #06b6d4, #0ea5e9); }
.avatar.c4 { background: linear-gradient(135deg, #10b981, #059669); }
.avatar.c5 { background: linear-gradient(135deg, #f59e0b, #f97316); }
.avatar.c6 { background: linear-gradient(135deg, #8b5cf6, #d946ef); }
.avatar.c7 { background: linear-gradient(135deg, #ef4444, #f43f5e); }
.avatar.c8 { background: linear-gradient(135deg, #14b8a6, #06b6d4); }

.emp-name {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.2px;
    margin-bottom: 3px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.emp-id {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text-3);
}

.emp-team {
    font-size: 12.5px;
    color: var(--text-2);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 4px 10px;
    background: var(--surface-3);
    border-radius: 100px;
    display: inline-block;
    max-width: 100%;
    justify-self: start;
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}
.badge::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 8px currentColor;
}
.badge.active { background: var(--green-bg); color: var(--green-text); }
.badge.inactive { background: var(--red-bg); color: var(--red-text); }

.row-actions {
    display: flex;
    gap: 4px;
    justify-content: flex-end;
    opacity: 0.5;
    transition: opacity 0.2s;
}
.emp-row:hover .row-actions { opacity: 1; }

.row-btn {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-3);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}
.row-btn.edit:hover {
    background: rgba(99, 102, 241, 0.1);
    color: var(--brand-1);
    border-color: rgba(99, 102, 241, 0.2);
    transform: scale(1.1);
}
.row-btn.delete:hover {
    background: var(--red-bg);
    color: var(--red);
    border-color: rgba(239, 68, 68, 0.2);
    transform: scale(1.1);
}

/* ================================================================
   DETAIL PANEL
   ================================================================ */
.detail-panel {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 108px);
    overflow-y: auto;
}

.empty-detail { padding: 90px 40px; text-align: center; }
.empty-detail h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-2);
    margin-bottom: 6px;
}
.empty-detail p { font-size: 13px; color: var(--text-3); line-height: 1.5; }
.empty-detail svg { color: var(--brand-1); margin-bottom: 18px; opacity: 0.7; }

.detail-head {
    padding: 24px 24px 20px;
    border-bottom: 1px solid var(--border);
    display: flex;
    gap: 16px;
    align-items: center;
    background: var(--surface-2);
}
.detail-avatar {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    font-size: 24px;
    font-weight: 800;
    overflow: hidden;
    flex-shrink: 0;
    color: #fff;
    box-shadow: 0 8px 24px rgba(99, 102, 241, 0.3);
}
.detail-avatar img { width: 100%; height: 100%; object-fit: cover; }
.detail-avatar.c1 { background: linear-gradient(135deg, #6366f1, #8b5cf6); }
.detail-avatar.c2 { background: linear-gradient(135deg, #ec4899, #f43f5e); }
.detail-avatar.c3 { background: linear-gradient(135deg, #06b6d4, #0ea5e9); }
.detail-avatar.c4 { background: linear-gradient(135deg, #10b981, #059669); }
.detail-avatar.c5 { background: linear-gradient(135deg, #f59e0b, #f97316); }
.detail-avatar.c6 { background: linear-gradient(135deg, #8b5cf6, #d946ef); }
.detail-avatar.c7 { background: linear-gradient(135deg, #ef4444, #f43f5e); }
.detail-avatar.c8 { background: linear-gradient(135deg, #14b8a6, #06b6d4); }

.detail-name {
    font-size: 19px;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.5px;
    margin-bottom: 6px;
}
.detail-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 12.5px;
}
.detail-meta .id {
    font-family: var(--mono);
    color: var(--text-3);
    background: var(--surface-3);
    padding: 2px 8px;
    border-radius: 6px;
}

.detail-body { padding: 20px 24px 24px; }
.detail-section {
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
}
.detail-section:last-child { border-bottom: none; }
.detail-section:first-child { padding-top: 0; }

.detail-section-title {
    font-size: 11px;
    font-weight: 800;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.detail-section-title .dot {
    width: 8px;
    height: 8px;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-3));
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(99, 102, 241, 0.6);
}

.detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 20px;
}
.detail-field { min-width: 0; }
.detail-field.full { grid-column: 1 / -1; }
.detail-field .k {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--text-3);
    margin-bottom: 4px;
}
.detail-field .v {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    word-break: break-word;
    overflow-wrap: anywhere;
    line-height: 1.4;
}
.detail-field .v.mono {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
}
.detail-field .v.empty {
    color: var(--text-4);
    font-style: italic;
    font-weight: 500;
}

.doc-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}
.doc-item {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    text-decoration: none;
    color: var(--text);
    transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    cursor: pointer;
}
.doc-item.has:hover {
    border-color: var(--brand-1);
    background: rgba(99, 102, 241, 0.06);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(99, 102, 241, 0.15);
}
.doc-item.none {
    opacity: 0.45;
    cursor: not-allowed;
    background: var(--surface-2);
    border-style: dashed;
}
.doc-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--surface-3);
    color: var(--text-3);
    flex-shrink: 0;
}
.doc-item.has .doc-icon {
    background: rgba(99, 102, 241, 0.12);
    color: var(--brand-1);
    box-shadow: 0 4px 10px rgba(99, 102, 241, 0.15);
}
.doc-meta { min-width: 0; flex: 1; }
.doc-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
}
.doc-status {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 2px;
    font-weight: 500;
}
.doc-item.has .doc-status { color: var(--brand-1); }

.detail-actions {
    padding: 16px 24px;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 10px;
    background: var(--surface-2);
}
.detail-actions .btn { flex: 1; }

/* ================================================================
   EMPTY LIST
   ================================================================ */
.empty-list { padding: 80px 24px; text-align: center; }
.empty-list svg { color: var(--brand-1); margin-bottom: 18px; opacity: 0.6; }
.empty-list h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-2);
    margin-bottom: 6px;
}
.empty-list p { font-size: 13.5px; color: var(--text-3); }

/* ================================================================
   TOAST
   ================================================================ */
.toast-host {
    position: fixed;
    top: 84px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 380px;
}
.toast {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 14px 18px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
    box-shadow: var(--shadow-lg);
    display: flex;
    align-items: center;
    gap: 12px;
    animation: toastIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
}
.toast::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
}
.toast.success::before { background: linear-gradient(180deg, #10b981, #34d399); }
.toast.error::before   { background: linear-gradient(180deg, #ef4444, #f87171); }
.toast.info::before    { background: linear-gradient(180deg, #6366f1, #8b5cf6); }

.toast-icon {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    font-size: 14px;
    font-weight: 700;
}
.toast.success .toast-icon { background: var(--green-bg); color: var(--green-text); }
.toast.error .toast-icon   { background: var(--red-bg); color: var(--red-text); }
.toast.info .toast-icon    { background: rgba(99, 102, 241, 0.15); color: var(--brand-1); }

@keyframes toastIn {
    from { opacity: 0; transform: translateX(30px) scale(0.95); }
    to   { opacity: 1; transform: translateX(0) scale(1); }
}

/* ================================================================
   FOOTER
   ================================================================ */
.footer {
    text-align: center;
    padding: 40px 20px;
    color: var(--text-4);
    font-size: 12.5px;
}
.footer strong {
    background: linear-gradient(135deg, var(--brand-1), var(--brand-3));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
}

/* ================================================================
   RESPONSIVE
   ================================================================ */
@media (max-width: 1100px) {
    .layout { grid-template-columns: 1fr; }
    .detail-panel {
        position: fixed;
        inset: 0;
        top: 68px;
        z-index: 200;
        max-height: none;
        border-radius: 0;
        display: none;
        background: var(--surface);
    }
    .detail-panel.open { display: block; }
    .close-btn { display: grid !important; }
}
@media (max-width: 720px) {
    .page { padding: 20px 16px 40px; }
    .list-head { display: none; }
    .emp-row {
        grid-template-columns: 48px 1fr auto;
        padding: 14px 16px;
    }
    .emp-team { display: none; }
    .topnav { padding: 0 16px; }
    .nav-subtitle { display: none; }
    .stats { grid-template-columns: 1fr 1fr; }
    .detail-grid { grid-template-columns: 1fr; }
    .doc-list { grid-template-columns: 1fr; }
    .toast-host { top: 76px; right: 12px; left: 12px; max-width: none; }
    .page-header h1 { font-size: 24px; }
    .filter-bar { flex-wrap: wrap; }
}

.close-btn {
    display: none;
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--surface-2);
    border: none;
    cursor: pointer;
    color: var(--text-2);
    place-items: center;
    z-index: 1;
}
.close-btn:hover {
    background: var(--surface-3);
    transform: rotate(90deg);
}

.list-scroll::-webkit-scrollbar,
.detail-panel::-webkit-scrollbar { width: 10px; }
.list-scroll::-webkit-scrollbar-track,
.detail-panel::-webkit-scrollbar-track { background: transparent; }
.list-scroll::-webkit-scrollbar-thumb,
.detail-panel::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, var(--brand-1), var(--brand-3));
    border-radius: 6px;
    border: 2px solid var(--surface);
    background-clip: padding-box;
}
</style>
</head>
<body>

<!-- MESH BG -->
<div class="mesh-bg">
    <div class="mesh-blob m1"></div>
    <div class="mesh-blob m2"></div>
    <div class="mesh-blob m3"></div>
</div>

<!-- TOP NAV -->
<nav class="topnav">
    <div class="nav-brand">
        <div class="nav-logo">EIS</div>
        <div>
            <div class="nav-title">Employee Registry</div>
            <div class="nav-subtitle">Enterprise Information System</div>
        </div>
    </div>
    <div class="nav-actions">
        <!-- ⭐ THEME TOGGLE -->
        <button type="button" class="theme-toggle" id="themeToggle" title="Toggle theme">
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
            </svg>
        </button>
        <button type="button" class="btn btn-secondary" onclick="location.reload();">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
            Refresh
        </button>
        <button type="button" class="btn btn-primary" onclick="goToRegistration();">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
            New Registration
        </button>
    </div>
</nav>

<div class="page">

    <!-- HEADER -->
    <div class="page-header">
        <div>
            <h1>Employee Directory</h1>
            <p>View, manage and export all registered employees</p>
        </div>
        <div class="page-header-actions">
            <button type="button" class="btn btn-secondary" onclick="exportToExcel();">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Export to Excel
            </button>
        </div>
    </div>

    <!-- BANNERS -->
    <% if ("error".equals(message)) { %>
        <div class="alert alert-error">
            <span>⚠️</span>
            <span>Something went wrong. Please try again.</span>
        </div>
    <% } %>
    <% if ("delete".equals(message)) { %>
        <div class="alert alert-success">
            <span>✓</span>
            <span>Employee record deleted successfully.</span>
        </div>
    <% } %>

    <!-- STATS — CLICKABLE -->
    <div class="stats">
        <div class="stat indigo" data-filter="all" onclick="applyFilter('all');">
            <div class="stat-top">
                <div class="stat-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><path d="M20 8v6M23 11h-6"/></svg>
                </div>
                <span class="stat-trend">Live</span>
            </div>
            <div class="stat-value"><%= employeeList.size() %></div>
            <div class="stat-label">Total Employees</div>
        </div>

        <div class="stat green" data-filter="active" onclick="applyFilter('active');">
            <div class="stat-top">
                <div class="stat-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <span class="stat-trend">Active</span>
            </div>
            <div class="stat-value"><%= activeCount %></div>
            <div class="stat-label">Active Employees</div>
        </div>

        <div class="stat pink" data-filter="inactive" onclick="applyFilter('inactive');">
            <div class="stat-top">
                <div class="stat-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                </div>
                <span class="stat-trend neutral">Inactive</span>
            </div>
            <div class="stat-value"><%= inactiveCount %></div>
            <div class="stat-label">Inactive Employees</div>
        </div>

        <div class="stat cyan">
            <div class="stat-top">
                <div class="stat-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <span class="stat-trend neutral">4 Types</span>
            </div>
            <div class="stat-value">4</div>
            <div class="stat-label">Document Types</div>
        </div>
    </div>

    <!-- ⭐ FILTER BAR — appears when filter active -->
    <div class="filter-bar" id="filterBar">
        <div class="filter-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
            </svg>
        </div>
        <div class="filter-text">
            Showing: <strong id="filterLabel">All Employees</strong>
            <span id="filterCount" style="opacity: 0.7;"></span>
        </div>
        <button type="button" class="filter-clear" onclick="clearFilter();">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
            Show All
        </button>
    </div>

    <!-- SPLIT LAYOUT -->
    <div class="layout">
        <!-- LEFT: LIST -->
        <div class="card">
            <div class="card-toolbar">
                <div class="search-input">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" id="searchInput" placeholder="Search by name, ID, or team..." autocomplete="off"/>
                </div>
            </div>

            <div class="list-head">
                <div></div>
                <div>Employee</div>
                <div>Team</div>
                <div>Status</div>
                <div style="text-align:right;">Actions</div>
            </div>

            <div class="list-scroll" id="employeeList">
            <% if (employeeList != null && !employeeList.isEmpty()) {
                   int idx = 0;
                   for (EmployeeDetailsBean e : employeeList) {
                       String empId = e.getM_strEmployee_ID() != null ? e.getM_strEmployee_ID() : "";
                       String fname = e.getM_strFirst_Name() != null ? e.getM_strFirst_Name() : "";
                       String lname = e.getM_strLast_Name() != null ? e.getM_strLast_Name() : "";
                       String fullName = (fname + " " + lname).trim();
                       if (fullName.isEmpty()) fullName = "Employee " + empId;
                       String initials = (fname.isEmpty() ? "?" : fname.substring(0,1)).toUpperCase()
                                       + (lname.isEmpty() ? "" : lname.substring(0,1).toUpperCase());
                       String team = e.getM_strTeam() != null ? e.getM_strTeam() : "—";
                       String isActive = e.getM_strISACTIVE() != null ? e.getM_strISACTIVE() : "";
                       boolean active = "Active".equalsIgnoreCase(isActive.trim());
                       int colorIdx = (Math.abs(empId.hashCode()) % 8) + 1;
                       String colorClass = "c" + colorIdx;
                       String photoPath = e.getM_strPhoto_Path();
                       boolean hasPhoto = photoPath != null && !photoPath.trim().isEmpty();
            %>
                <div class="emp-row" data-id="<%= empId %>"
                     data-index="<%= idx %>"
                     data-status="<%= active ? "active" : "inactive" %>"
                     data-search="<%= (fullName + " " + empId + " " + team).toLowerCase() %>"
                     onclick="selectEmployee(this, <%= idx %>);">

                    <div class="avatar <%= colorClass %>">
                        <% if (hasPhoto) { %>
                            <img src="<%=ctx%>/DocumentDownloadServlet?empid=<%= empId %>&type=PHOTO&_t=<%= System.currentTimeMillis() %>"
                                 alt=""
                                 onerror="this.style.display='none'; this.parentNode.textContent='<%= initials %>';"/>
                        <% } else { %>
                            <%= initials %>
                        <% } %>
                    </div>

                    <div style="min-width:0;">
                        <div class="emp-name"><%= fullName %></div>
                        <div class="emp-id">#<%= empId %></div>
                    </div>

                    <div class="emp-team"><%= team %></div>

                    <div>
                        <span class="badge <%= active ? "active" : "inactive" %>">
                            <%= active ? "Active" : "Inactive" %>
                        </span>
                    </div>

                    <div class="row-actions" onclick="event.stopPropagation();">
                        <button type="button" class="row-btn edit" title="Edit" onclick="editRecord('<%= empId %>');">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        </button>
                        <button type="button" class="row-btn delete" title="Delete" onclick="deleteRecord('<%= empId %>');">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </button>
                    </div>
                </div>
            <%     idx++;
                   }
               } else { %>
                <div class="empty-list">
                    <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 13V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7"/><path d="M22 17v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-2"/><path d="M2 17h20"/></svg>
                    <h3>No employees yet</h3>
                    <p>Click "New Registration" to add your first employee</p>
                </div>
            <% } %>
            </div>
        </div>

        <!-- RIGHT: DETAIL -->
        <aside class="card detail-panel" id="detailPanel">
            <button type="button" class="close-btn" onclick="closeDetail();">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>

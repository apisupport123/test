                    <div class="field">
                        <label class="field-label">TCS Joining Date</label>
                        <input class="field-input" type="date" name="m_strtcsjoiningdate"
                               value="<%=emp.getM_strTCS_Joining_Date() != null ? emp.getM_strTCS_Joining_Date() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">TCS Mail ID</label>
                        <input class="field-input" type="email" name="m_strtcsmailid"
                               value="<%=emp.getM_strTCS_mail_ID() != null ? emp.getM_strTCS_mail_ID() : ""%>"/>

<style>
:root{
  --brand:#F86F03;
  --brand-2:#FF9A3D;
  --ink:#0A0A0A;
  --ink-2:#1A1A1A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F7F7F5;
  --card:#FFFFFF;
  --radius:20px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{
  font-family:'Inter',system-ui,sans-serif;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  padding-top:72px;
}

/* ============ TOP NAV ============ */
.topnav{
  position:fixed;
  top:0;left:0;right:0;
  height:64px;
  background:rgba(255,255,255,.85);
  backdrop-filter:blur(20px) saturate(180%);
  -webkit-backdrop-filter:blur(20px) saturate(180%);
  border-bottom:1px solid var(--line);
  z-index:100;
  display:flex;
  align-items:center;
  padding:0 28px;
  gap:24px;
}
.nav-brand{
  display:flex;
  align-items:center;
  gap:12px;
  font-weight:800;
  font-size:1rem;
  letter-spacing:-.3px;
  flex-shrink:0;
}
.nav-brand-mark{
  width:36px;height:36px;
  background:linear-gradient(135deg, var(--brand), var(--brand-2));
  border-radius:10px;
  display:grid;place-items:center;
  color:#fff;
  font-size:.9rem;
  box-shadow:0 6px 16px -6px var(--brand);
}
.nav-brand span{
  display:block;
  font-size:.7rem;
  font-weight:500;
  color:var(--muted);
  letter-spacing:.5px;
  text-transform:uppercase;
  margin-top:1px;
}

/* Command trigger button (fake input) */
.cmd-trigger{
  flex:1;
  max-width:420px;
  height:40px;
  background:#F2F2EF;
  border:1px solid transparent;
  border-radius:12px;
  padding:0 14px;
  display:flex;
  align-items:center;
  gap:10px;
  color:var(--muted);
  font-size:.85rem;
  font-weight:500;
  cursor:pointer;
  transition:all .2s ease;
  font-family:inherit;
}
.cmd-trigger:hover{
  background:#fff;
  border-color:var(--line);
  color:var(--ink);
  box-shadow:0 4px 14px rgba(0,0,0,.04);
}
.cmd-trigger .kbd{
  margin-left:auto;
  display:flex;
  gap:4px;
}
.kbd{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:22px;
  height:22px;
  padding:0 6px;
  background:#fff;
  border:1px solid var(--line);
  border-radius:6px;
  font-size:.7rem;
  font-weight:600;
  color:var(--muted);
  font-family:inherit;
}

.nav-right{
  margin-left:auto;
  display:flex;
  align-items:center;
  gap:12px;
}
.nav-btn{
  width:38px;height:38px;
  display:grid;place-items:center;
  background:transparent;
  border:1px solid var(--line);
  border-radius:10px;
  color:var(--ink);
  cursor:pointer;
  font-size:.9rem;
  transition:all .2s ease;
}
.nav-btn:hover{
  background:var(--brand);
  border-color:var(--brand);
  color:#fff;
}
.nav-avatar{
  width:38px;height:38px;
  border-radius:50%;
  background:linear-gradient(135deg, var(--brand), var(--brand-2));
  display:grid;place-items:center;
  color:#fff;
  font-weight:700;
  font-size:.85rem;
  cursor:pointer;
  border:2px solid #fff;
  box-shadow:0 2px 8px rgba(0,0,0,.08);
}

/* ============ COMMAND PALETTE ============ */
.cmd-overlay{
  position:fixed;
  inset:0;
  background:rgba(10,10,10,.5);
  backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
  z-index:1000;
  display:none;
  align-items:flex-start;
  justify-content:center;
  padding-top:12vh;
}
.cmd-overlay.open{display:flex;animation:fadeIn .15s ease}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

.cmd-modal{
  width:100%;
  max-width:620px;
  background:#fff;
  border-radius:18px;
  box-shadow:
    0 0 0 1px rgba(0,0,0,.05),
    0 30px 80px rgba(0,0,0,.25);
  overflow:hidden;
  animation:slideUp .2s cubic-bezier(.4,0,.2,1);
}
@keyframes slideUp{
  from{opacity:0;transform:translateY(10px) scale(.98)}
  to{opacity:1;transform:translateY(0) scale(1)}
}

.cmd-input-wrap{
  display:flex;
  align-items:center;
  gap:12px;
  padding:18px 20px;
  border-bottom:1px solid var(--line);
}
.cmd-input-wrap i{
  color:var(--muted);
  font-size:1rem;
}
.cmd-input{
  flex:1;
  border:none;
  outline:none;
  background:transparent;
  font-family:inherit;
  font-size:1rem;
  font-weight:500;
  color:var(--ink);
}
.cmd-input::placeholder{color:#B4B4B4}

.cmd-list{
  max-height:60vh;
  overflow-y:auto;
  padding:8px;
}
.cmd-list::-webkit-scrollbar{width:8px}
.cmd-list::-webkit-scrollbar-thumb{background:#E5E5E5;border-radius:4px}

.cmd-group{
  padding:8px 12px 4px;
  font-size:.7rem;
  font-weight:700;
  color:var(--muted);
  letter-spacing:1px;
  text-transform:uppercase;
}
.cmd-item{
  display:flex;
  align-items:center;
  gap:14px;
  padding:11px 12px;
  border-radius:10px;
  cursor:pointer;
  transition:all .12s ease;
  text-decoration:none;
  color:var(--ink);
}
.cmd-item:hover,
.cmd-item.active{
  background:linear-gradient(135deg, var(--brand-light, #FFF4EC) 0%, #FFF8F2 100%);
  color:var(--brand);
}
.cmd-item:hover .cmd-icon,
.cmd-item.active .cmd-icon{
  background:var(--brand);
  color:#fff;
}
.cmd-icon{
  width:36px;height:36px;
  flex-shrink:0;
  display:grid;place-items:center;
  background:#F2F2EF;
  border-radius:9px;
  color:var(--ink);
  font-size:.85rem;
  transition:all .12s ease;
}
.cmd-text{
  flex:1;
  min-width:0;
}
.cmd-text .t{
  font-size:.88rem;
  font-weight:600;
  color:inherit;
  line-height:1.3;
}
.cmd-text .s{
  font-size:.72rem;
  color:var(--muted);
  margin-top:2px;
  font-weight:500;
}
.cmd-arrow{
  color:var(--muted);
  font-size:.75rem;
  opacity:0;
  transition:opacity .12s ease;
}
.cmd-item:hover .cmd-arrow,
.cmd-item.active .cmd-arrow{
  opacity:1;
  color:var(--brand);
}
.cmd-empty{
  padding:40px 20px;
  text-align:center;
  color:var(--muted);
  font-size:.85rem;
}

.cmd-footer{
  padding:10px 20px;
  border-top:1px solid var(--line);
  background:#FAFAFA;
  display:flex;
  align-items:center;
  gap:20px;
  font-size:.72rem;
  color:var(--muted);
}
.cmd-footer .hint{display:flex;align-items:center;gap:6px}

/* ============ HIDE OLD STUFF ============ */
.primary-nav,
.hamburger,
.menu,
.overflow-container,
.new-wrapper{
  display:none !important;
}
</style>
</head>

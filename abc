}
html[data-theme="dark"] .timestamp-display {
    background: rgba(248,111,3,.15);
}
.timestamp-display i { margin-right: 6px; }

/* ================================================================
   GRID MAIN — 5 columns, full height
   ================================================================ */
.grid-main {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
    min-height: 0;
}

/* ================================================================
   CARD — full height
   ================================================================ */
.card-modern {
    background: var(--card);
    border-radius: 12px;
    border: 1px solid var(--line);

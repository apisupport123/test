<!-- ============ ROSTER GRID ============ -->
<form id="rosterForm" method="post" action="<%=request.getContextPath()%>/RosterServlet">
<input type="hidden" name="tableData" id="tableData">
<input type="hidden" name="m_strroles" value="<%= m_strroles %>">
<input type="hidden" name="username" value="<%= username %>">
<input type="hidden" name="selectedMonth" value="<%= selectedMonth %>">
<input type="hidden" name="selectedYear" value="<%= selectedYear %>">

<div class="grid-wrap">
<% if (totalEmp == 0) { %>
  <div class="empty">
    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
    <h3>No employees found</h3>
    <p>No active employees in team <b><%= m_strroles %></b>.</p>
  </div>
<% } else { %>

<table class="roster-grid">
  <thead>
    <tr>
      <th class="col-emp">Employee</th>
      <th class="col-pos">Position</th>
      <% for (int d = 1; d <= noOfDays; d++) {
          LocalDate cd = LocalDate.of(year, month, d);
          DayOfWeek dow = cd.getDayOfWeek();
          boolean wknd = (dow == DayOfWeek.SATURDAY || dow == DayOfWeek.SUNDAY);
      %>
      <th class="<%= wknd ? "is-weekend" : "" %>">
        <span class="day-num"><%= d %></span>
        <span class="day-name"><%= dow.getDisplayName(TextStyle.SHORT, Locale.ENGLISH) %></span>
      </th>
      <% } %>
      <th class="col-sum">WO</th>
      <th class="col-sum">LV</th>
    </tr>
  </thead>
  <tbody>
    <% for (int i = 0; i < employees.size(); i++) {
        Map<String,Object> emp = employees.get(i);
        String name = (String) emp.get("name");
        String pos = (String) emp.get("position");
        String adId = (String) emp.get("adId");
        String init = (name != null && name.length() > 0) ? name.substring(0,1).toUpperCase() : "?";
    %>
    <tr class="emp-row-tr" data-name="<%= name != null ? name.toLowerCase() : "" %>" data-pos="<%= pos != null ? pos.toLowerCase() : "" %>">
      <td class="col-emp">
        <div class="emp-row">
          <div class="emp-avatar"><%= init %></div>
          <div style="min-width:0;">
            <div class="emp-name"><%= name %></div>
            <div class="emp-id"><%= adId != null ? adId : "" %></div>
            <input type="hidden" name="employeeName" value="<%= name %>">
            <input type="hidden" name="adId" value="<%= adId %>">
          </div>
        </div>
      </td>
      <td class="col-pos">
        <%= (pos != null && !pos.trim().isEmpty()) ? pos : "—" %>
        <input type="hidden" name="position_<%= i %>" value="<%= pos != null ? pos : "" %>">
      </td>
      <%
        int woCount = 0, lvCount = 0;
        for (int d = 1; d <= noOfDays; d++) {
          String shift = (String) emp.get("day_" + d);
          if (shift == null || shift.trim().isEmpty()) shift = "Morning";
          String lc = shift.toLowerCase();
          String cls = "morning", label = "M";
          if (lc.equals("morning"))                 {cls="morning";   label="M";}
          else if (lc.equals("wfh-morning"))        {cls="morning";   label="WFH-M";}
          else if (lc.equals("cc-morning"))         {cls="morning";   label="CC-M";}
          else if (lc.equals("general")||lc.equals("genral")) {cls="general"; label="D";}
          else if (lc.equals("wfh-general")||lc.equals("wfh-genral")) {cls="general"; label="WFH-D";}
          else if (lc.equals("cc-general"))         {cls="general";   label="CC-D";}
          else if (lc.equals("afternoon"))          {cls="afternoon"; label="A";}
          else if (lc.equals("wfh-afternoon"))      {cls="afternoon"; label="WFH-A";}
          else if (lc.equals("cc-afternoon"))       {cls="afternoon"; label="CC-A";}
          else if (lc.equals("night"))              {cls="night";     label="N";}
          else if (lc.equals("wfh-night"))          {cls="night";     label="WFH-N";}
          else if (lc.equals("cc-night"))           {cls="night";     label="CC-N";}
          else if (lc.equals("weekoff"))            {cls="weekoff";   label="W"; woCount++;}
          else if (lc.equals("weekoffadjust"))      {cls="weekoff";   label="WA";}
          else if (lc.equals("leave"))              {cls="leave";     label="L"; lvCount++;}
          else if (lc.equals("sickleave"))          {cls="leave";     label="SL"; lvCount++;}
          else if (lc.equals("casualleave"))        {cls="leave";     label="CL"; lvCount++;}
          else if (lc.equals("earnedleave"))        {cls="leave";     label="EL"; lvCount++;}
          else if (lc.equals("flexileave"))         {cls="flexi";     label="FL";}
          else if (lc.equals("holidayleave"))       {cls="holiday";   label="HL";}
          else if (lc.equals("na"))                 {cls="na";        label="—";}
      %>
      <td class="shift-cell" data-cell-id="<%= i %>_<%= d %>">
        <div class="shift-btn <%= cls %>" onclick="openDropdown(event, <%= i %>, <%= d %>, '<%= cls %>', '<%= label %>')"><%= label %></div>
        <select name="mnt_<%= i %>_<%= d %>" class="shift-hidden" id="sel_<%= i %>_<%= d %>">
          <option value="Morning"       <%= lc.equals("morning")?"selected":"" %>>Morning</option>
          <option value="WFH-Morning"   <%= lc.equals("wfh-morning")?"selected":"" %>>WFH-Morning</option>
          <option value="CC-Morning"    <%= lc.equals("cc-morning")?"selected":"" %>>CC-Morning</option>
          <option value="General"       <%= (lc.equals("general")||lc.equals("genral"))?"selected":"" %>>General</option>
          <option value="WFH-General"   <%= (lc.equals("wfh-general")||lc.equals("wfh-genral"))?"selected":"" %>>WFH-General</option>
          <option value="CC-General"    <%= lc.equals("cc-general")?"selected":"" %>>CC-General</option>
          <option value="Afternoon"     <%= lc.equals("afternoon")?"selected":"" %>>Afternoon</option>
          <option value="WFH-Afternoon" <%= lc.equals("wfh-afternoon")?"selected":"" %>>WFH-Afternoon</option>
          <option value="CC-Afternoon"  <%= lc.equals("cc-afternoon")?"selected":"" %>>CC-Afternoon</option>
          <option value="Night"         <%= lc.equals("night")?"selected":"" %>>Night</option>
          <option value="WFH-Night"     <%= lc.equals("wfh-night")?"selected":"" %>>WFH-Night</option>
          <option value="CC-Night"      <%= lc.equals("cc-night")?"selected":"" %>>CC-Night</option>
          <option value="Weekoff"       <%= lc.equals("weekoff")?"selected":"" %>>Weekoff</option>
          <option value="WeekoffAdjust" <%= lc.equals("weekoffadjust")?"selected":"" %>>WeekoffAdjust</option>
          <option value="Leave"         <%= lc.equals("leave")?"selected":"" %>>Leave</option>
          <option value="SickLeave"     <%= lc.equals("sickleave")?"selected":"" %>>SickLeave</option>
          <option value="CasualLeave"   <%= lc.equals("casualleave")?"selected":"" %>>CasualLeave</option>
          <option value="EarnedLeave"   <%= lc.equals("earnedleave")?"selected":"" %>>EarnedLeave</option>
          <option value="FlexiLeave"    <%= lc.equals("flexileave")?"selected":"" %>>FlexiLeave</option>
          <option value="HolidayLeave"  <%= lc.equals("holidayleave")?"selected":"" %>>HolidayLeave</option>
          <option value="NA"            <%= lc.equals("na")?"selected":"" %>>NA</option>
        </select>
      </td>
      <% } %>
      <td style="text-align:center;font-weight:700;font-variant-numeric:tabular-nums;color:var(--w-fg);"><%= woCount %></td>
      <td style="text-align:center;font-weight:700;font-variant-numeric:tabular-nums;color:var(--l-fg);"><%= lvCount %></td>
    </tr>
    <% } %>

    <tr class="summary-row">
      <td class="col-emp">Morning</td>
      <td class="col-pos"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int c = 0; for (Map<String,Object> e : employees) { String s = (String) e.get("day_" + d); if (s != null && s.toLowerCase().contains("morning")) c++; }
      %>
      <td><span class="pill"><%= c %></span></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
    <tr class="summary-row">
      <td class="col-emp">General</td>
      <td class="col-pos"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int c = 0; for (Map<String,Object> e : employees) { String s = (String) e.get("day_" + d); if (s != null && (s.toLowerCase().contains("general")||s.toLowerCase().contains("genral"))) c++; }
      %>
      <td><span class="pill"><%= c %></span></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
    <tr class="summary-row">
      <td class="col-emp">Afternoon</td>
      <td class="col-pos"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int c = 0; for (Map<String,Object> e : employees) { String s = (String) e.get("day_" + d); if (s != null && s.toLowerCase().contains("afternoon")) c++; }
      %>
      <td><span class="pill"><%= c %></span></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
    <tr class="summary-row">
      <td class="col-emp">Night</td>
      <td class="col-pos"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int c = 0; for (Map<String,Object> e : employees) { String s = (String) e.get("day_" + d); if (s != null && s.toLowerCase().contains("night")) c++; }
      %>
      <td><span class="pill"><%= c %></span></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
  </tbody>
</table>
<% } %>
</div>

<!-- ============ ACTION BAR ============ -->
<div class="action-bar">
  <div class="action-info">
    <span class="dot"></span>
    <span>All changes saved</span>
    <span>&middot;</span>
    <span><b><%= m_strroles %></b> &middot; <%= nameOfMonth %> <%= selectedYear %></span>
  </div>
  <div>
    <% boolean isFutureOrCurrent = (year > YearMonth.now().getYear() || (year == YearMonth.now().getYear() && month >= YearMonth.now().getMonthValue())); %>
    <% if (isFutureOrCurrent) { %>
      <button type="button" class="btn btn-primary" onclick="prepareData()" style="padding:8px 18px;">
        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        Save Roster
      </button>
    <% } else { %>
      <span style="font-size:12px;color:var(--text-tertiary);font-weight:500;">Past month &middot; read only</span>
    <% } %>
  </div>
</div>
</form>

<!-- ============ CUSTOM DROPDOWN (shared) ============ -->
<div class="dropdown-menu" id="dropdownMenu"></div>

<script>
/* ============================================================
   THEME
   ============================================================ */
(function(){
  try {
    var t = localStorage.getItem('eis-roster-theme') || 'light';
    document.documentElement.setAttribute('data-theme', t);
  } catch(e){}
})();
function toggleTheme() {
  var cur = document.documentElement.getAttribute('data-theme') || 'light';
  var next = cur === 'light' ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', next);
  try { localStorage.setItem('eis-roster-theme', next); } catch(e){}
}

/* ============================================================
   SEARCH
   ============================================================ */
function filterEmployees() {
  var v = document.getElementById('searchInput').value.toLowerCase();
  var rows = document.querySelectorAll('.emp-row-tr');
  var vis = 0;
  rows.forEach(function(r){
    var n = r.getAttribute('data-name') || '';
    var p = r.getAttribute('data-pos') || '';
    if (n.includes(v) || p.includes(v)) { r.style.display = ''; vis++; }
    else { r.style.display = 'none'; }
  });
  document.getElementById('searchInfo').innerHTML = 'Showing <b>' + vis + '</b> of ' + rows.length;
}


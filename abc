<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= m_strrole %> Roster &mdash; <%= nameOfMonth %> <%= year %></title>

<style>
:root{
  /* Surfaces — warm dark, not black */
  --bg-0:#0F1419;
  --bg-1:#1A1F2E;
  --bg-2:#232838;
  --bg-3:#2D3346;
  --bg-hover:#323A50;
  --line:#2F3648;
  --line-2:#3D4458;
  --line-hi:#4A5268;

  /* Ink */
  --ink:#F5F7FA;
  --ink-2:#C5CBD8;
  --ink-3:#8B92A5;
  --ink-4:#5E6678;

  /* Shift colors — bright BG, dark TEXT for readability */
  --morning:#FFB800;
  --morning-bg:#FFD966;
  --morning-text:#5C3D00;
  --general:#8892A6;
  --general-bg:#B0B8C8;
  --general-text:#1F2430;
  --afternoon:#FF8A3D;
  --afternoon-bg:#FFB380;
  --afternoon-text:#5C2600;
  --night:#4A90E2;
  --night-bg:#8FC0F5;
  --night-text:#00254D;
  --weekoff:#A371F7;
  --weekoff-bg:#C9A8FA;
  --weekoff-text:#2D0E5C;
  --leave:#FF4757;
  --leave-bg:#FF9CA5;
  --leave-text:#5C0008;
  --flexi:#FF7B72;
  --flexi-bg:#FFB0AA;
  --flexi-text:#5C0F08;
  --holiday:#2ECC71;
  --holiday-bg:#8FE5AF;
  --holiday-text:#0A4D22;
  --na:#5E6678;
  --na-bg:#3D4458;
  --na-text:#8B92A5;

  --accent:#4A90E2;
  --accent-2:#3B7DD8;
  --success:#2ECC71;

  --ff: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --ff-mono: 'SF Mono', 'JetBrains Mono', Consolas, monospace;
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;overflow:hidden}
body{
  font-family:var(--ff);
  background:var(--bg-0);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  font-size:14px;
  font-weight:500;
  line-height:1.5;
}
button{font-family:inherit;cursor:pointer}

.app{display:flex;flex-direction:column;height:100vh;overflow:hidden}

/* ============================================================
   HEADER
   ============================================================ */
.header{
  background:linear-gradient(135deg, #1A1F2E 0%, #232838 100%);
  padding:16px 28px;
  display:flex;
  align-items:center;
  gap:24px;
  border-bottom:1px solid var(--line-2);
  box-shadow:0 2px 12px rgba(0,0,0,0.3);
  flex-shrink:0;
  position:relative;
  z-index:100;
}
.header-title{display:flex;align-items:center;gap:14px;flex-shrink:0}
.header-logo{
  width:52px;height:52px;
  background:linear-gradient(135deg, #4A90E2, #A371F7);
  border-radius:14px;
  display:grid;place-items:center;
  color:#fff;
  box-shadow:0 8px 24px -6px rgba(74,144,226,0.6);
  flex-shrink:0;
}
.header-logo svg{width:28px;height:28px;stroke:#fff;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.header-text h1{
  font-size:22px;
  font-weight:800;
  color:#fff;
  letter-spacing:-0.4px;
  line-height:1.15;
}
.header-text p{
  font-size:13px;
  font-weight:600;
  color:var(--ink-3);
  margin-top:4px;
  letter-spacing:0.2px;
}
.header-spacer{flex:1}

.header-stats{display:flex;gap:10px;flex-shrink:0}
.hstat{
  padding:10px 18px;
  background:var(--bg-0);
  border:1px solid var(--line-2);
  border-radius:12px;
  text-align:center;
  min-width:90px;
}
.hstat-val{
  font-size:22px;
  font-weight:900;
  color:#fff;
  line-height:1;
  font-variant-numeric:tabular-nums;
  letter-spacing:-0.5px;
}
.hstat-val.cyan{color:#4A90E2}
.hstat-val.green{color:#2ECC71}
.hstat-val.purple{color:#A371F7}
.hstat-lbl{
  font-size:10px;
  font-weight:800;
  color:var(--ink-3);
  text-transform:uppercase;
  letter-spacing:1.2px;
  margin-top:5px;
}

/* ============================================================
   TOOLBAR
   ============================================================ */
.toolbar{
  background:var(--bg-1);
  padding:14px 28px;
  display:flex;
  align-items:flex-end;
  gap:16px;
  border-bottom:1px solid var(--line);
  flex-shrink:0;
  flex-wrap:wrap;
  position:relative;
  z-index:99;
}
.field{display:flex;flex-direction:column;gap:6px}
.field label{
  font-size:10px;
  font-weight:800;
  color:var(--ink-3);
  text-transform:uppercase;
  letter-spacing:1.2px;
}
.field select,
.field input{
  background:var(--bg-3);
  border:1px solid var(--line-2);
  border-radius:8px;
  padding:10px 14px;
  color:var(--ink);
  font-family:inherit;
  font-size:14px;
  font-weight:700;
  outline:none;
  transition:all .15s;
  min-width:130px;
  cursor:pointer;
}
.field select:hover,
.field input:hover{border-color:var(--line-hi)}
.field select:focus,
.field input:focus{
  border-color:var(--accent);
  box-shadow:0 0 0 3px rgba(74,144,226,0.2);
}

.btn{
  padding:11px 22px;
  border:none;
  border-radius:8px;
  font-size:13px;
  font-weight:800;
  letter-spacing:0.5px;
  text-transform:uppercase;
  transition:all .15s;
  display:inline-flex;
  align-items:center;
  gap:9px;
  font-family:inherit;
}
.btn svg{
  width:16px;height:16px;
  stroke:currentColor;fill:none;
  stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round;
}
.btn-primary{
  background:linear-gradient(135deg, #4A90E2, #3B7DD8);
  color:#fff;
  box-shadow:0 6px 18px -4px rgba(74,144,226,0.5);
}
.btn-primary:hover{
  transform:translateY(-1px);
  box-shadow:0 10px 26px -4px rgba(74,144,226,0.7);
}
.btn-success{
  background:linear-gradient(135deg, #2ECC71, #27AE60);
  color:#fff;
  box-shadow:0 6px 18px -4px rgba(46,204,113,0.5);
}
.btn-success:hover{
  transform:translateY(-1px);
  box-shadow:0 10px 26px -4px rgba(46,204,113,0.7);
}
.btn-ghost{
  background:var(--bg-3);
  border:1px solid var(--line-2);
  color:var(--ink-2);
}
.btn-ghost:hover{background:var(--bg-hover);border-color:var(--line-hi);color:var(--ink)}

.toolbar-spacer{flex:1}

.search-box{position:relative;flex-shrink:0}
.search-box svg{
  position:absolute;left:14px;top:50%;
  transform:translateY(-50%);
  width:16px;height:16px;
  stroke:var(--ink-3);fill:none;stroke-width:2.2;
  pointer-events:none;
}
.search-box input{
  background:var(--bg-3);
  border:1px solid var(--line-2);
  border-radius:8px;
  padding:11px 14px 11px 42px;
  color:var(--ink);
  font-family:inherit;
  font-size:13px;
  font-weight:600;
  outline:none;
  width:300px;
  transition:all .15s;
}
.search-box input::placeholder{color:var(--ink-4);font-weight:500}
.search-box input:focus{
  border-color:var(--accent);
  box-shadow:0 0 0 3px rgba(74,144,226,0.2);
  width:340px;
}

/* ============================================================
   LEGEND
   ============================================================ */
.legend-bar{
  background:var(--bg-2);
  padding:12px 28px;
  display:flex;
  align-items:center;
  gap:10px;
  border-bottom:1px solid var(--line);
  flex-shrink:0;
  flex-wrap:wrap;
  position:relative;
  z-index:98;
}
.legend-lbl{
  font-size:11px;
  font-weight:800;
  color:var(--ink-3);
  text-transform:uppercase;
  letter-spacing:1.5px;
  margin-right:6px;
}
.legend-chip{
  display:inline-flex;
  align-items:center;
  gap:9px;
  padding:6px 14px 6px 8px;
  background:var(--bg-1);
  border:1px solid var(--line);
  border-radius:999px;
  font-size:13px;
  font-weight:700;
  color:var(--ink-2);
  white-space:nowrap;
  transition:all .15s;
}
.legend-chip:hover{border-color:var(--line-hi);background:var(--bg-3)}
.legend-chip .sw{
  width:22px;height:22px;
  border-radius:6px;
  display:grid;place-items:center;
  font-size:11px;
  font-weight:900;
  font-family:var(--ff-mono);
  flex-shrink:0;
  letter-spacing:-0.3px;
}
.sw.morning{background:var(--morning-bg);color:var(--morning-text)}
.sw.general{background:var(--general-bg);color:var(--general-text)}
.sw.afternoon{background:var(--afternoon-bg);color:var(--afternoon-text)}
.sw.night{background:var(--night-bg);color:var(--night-text)}
.sw.weekoff{background:var(--weekoff-bg);color:var(--weekoff-text)}
.sw.leave{background:var(--leave-bg);color:var(--leave-text)}
.sw.holiday{background:var(--holiday-bg);color:var(--holiday-text)}
.sw.na{background:var(--na-bg);color:var(--na-text)}

/* ============================================================
   ROSTER AREA
   ============================================================ */
.roster-wrap{
  flex:1;
  overflow:auto;
  background:var(--bg-0);
  position:relative;
}
.roster-wrap::-webkit-scrollbar{width:14px;height:14px}
.roster-wrap::-webkit-scrollbar-track{background:var(--bg-1)}
.roster-wrap::-webkit-scrollbar-thumb{
  background:var(--line-hi);
  border-radius:7px;
  border:3px solid var(--bg-1);
}
.roster-wrap::-webkit-scrollbar-thumb:hover{background:var(--accent)}
.roster-wrap::-webkit-scrollbar-corner{background:var(--bg-1)}

table.roster{
  border-collapse:separate;
  border-spacing:0;
  font-size:14px;
  min-width:100%;
}

/* ============================================================
   TABLE HEADER
   ============================================================ */
table.roster thead th{
  position:sticky;
  top:0;
  z-index:50;
  background:linear-gradient(180deg, var(--bg-2), var(--bg-1));
  color:var(--ink);
  font-size:13px;
  font-weight:800;
  letter-spacing:0.5px;
  text-transform:uppercase;
  padding:12px 8px;
  text-align:center;
  border-bottom:1px solid var(--line-2);
  border-right:1px solid var(--line);
  white-space:nowrap;
  min-width:54px;
  height:48px;
}
table.roster thead tr:nth-child(2) th{
  top:48px;
  font-size:12px;
  font-weight:700;
  color:var(--ink-2);
  background:var(--bg-2);
  height:38px;
  min-width:54px;
  letter-spacing:1.2px;
}

table.roster thead th.weekend{
  background:linear-gradient(180deg, #3A2D5C, #2E234A);
  color:#C9A8FA;
}
table.roster thead tr:nth-child(2) th.weekend{
  background:linear-gradient(180deg, #332851, #2A2046);
  color:#B899F5;
}
table.roster thead th.today{
  background:linear-gradient(180deg, #FF8A3D, #E67425);
  color:#fff;
  box-shadow:0 0 0 2px #FF8A3D inset;
}
table.roster thead th.today.weekend{
  background:linear-gradient(180deg, #A371F7, #8957E5);
  color:#fff;
}

/* ============================================================
   STICKY COLUMNS
   ============================================================ */
table.roster th.col-emp,
table.roster td.col-emp{
  position:sticky;
  left:0;
  z-index:20;
  background:var(--bg-1);
  text-align:left;
  padding:10px 18px;
  border-right:1px solid var(--line-2);
  min-width:240px;
  max-width:260px;
  box-shadow:6px 0 12px -6px rgba(0,0,0,0.6);
}
table.roster thead th.col-emp{
  z-index:55;
  background:linear-gradient(180deg, var(--bg-2), var(--bg-1));
  color:var(--ink);
  font-size:13px;
  padding:12px 18px;
}
table.roster tbody tr:hover td.col-emp{background:var(--bg-2)}

table.roster th.col-role,
table.roster td.col-role{
  position:sticky;
  left:240px;
  z-index:19;
  background:var(--bg-1);
  text-align:left;
  padding:10px 14px;
  border-right:2px solid var(--line-hi);
  min-width:110px;
  max-width:130px;
  box-shadow:6px 0 12px -6px rgba(0,0,0,0.6);
  font-size:12px;
  font-weight:800;
  color:var(--ink-2);
  text-transform:uppercase;
  letter-spacing:0.6px;
}
table.roster thead th.col-role{
  z-index:54;
  background:linear-gradient(180deg, var(--bg-2), var(--bg-1));
  color:var(--ink);
  font-size:13px;
}
table.roster tbody tr:hover td.col-role{background:var(--bg-2)}

/* ============================================================
   TABLE BODY
   ============================================================ */
table.roster tbody td{
  background:var(--bg-0);
  border-bottom:1px solid var(--line);
  border-right:1px solid var(--line);
  padding:0;
  text-align:center;
  vertical-align:middle;
  height:58px;
  transition:background .1s;
}
table.roster tbody tr:nth-child(even) td:not(.col-emp):not(.col-role){
  background:#131820;
}
table.roster tbody tr:hover td:not(.col-emp):not(.col-role){
  background:#1D2430;
}
table.roster tbody td.weekend:not(.col-emp):not(.col-role){
  background:rgba(163,113,247,0.08);
}
table.roster tbody tr:nth-child(even) td.weekend:not(.col-emp):not(.col-role){
  background:rgba(163,113,247,0.12);
}
table.roster tbody tr:hover td.weekend:not(.col-emp):not(.col-role){
  background:rgba(163,113,247,0.18);
}
table.roster tbody td.today:not(.col-emp):not(.col-role){
  background:rgba(255,138,61,0.12);
  box-shadow:inset 2px 0 0 rgba(255,138,61,0.5), inset -2px 0 0 rgba(255,138,61,0.5);
}
table.roster tbody tr:hover td.today:not(.col-emp):not(.col-role){
  background:rgba(255,138,61,0.22);
}

/* ============================================================
   EMPLOYEE CELL
   ============================================================ */
.emp{display:flex;align-items:center;gap:12px}
.emp-av{
  width:38px;height:38px;
  border-radius:10px;
  background:linear-gradient(135deg, #4A90E2, #A371F7);
  color:#fff;
  font-weight:900;
  font-size:14px;
  display:grid;place-items:center;
  flex-shrink:0;
  letter-spacing:0.3px;
  box-shadow:0 4px 12px -2px rgba(74,144,226,0.5);
  border:1px solid rgba(255,255,255,0.15);
}
.emp-name{
  font-size:14px;
  font-weight:800;
  color:var(--ink);
  line-height:1.2;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  max-width:160px;
  letter-spacing:-0.2px;
}
.emp-id{
  font-size:11px;
  font-weight:700;
  color:var(--ink-4);
  margin-top:3px;
  font-family:var(--ff-mono);
  letter-spacing:0.5px;
}

/* ============================================================
   DAY CELL — BIG BOLD BADGE
   ============================================================ */
td.day{
  position:relative;
  cursor:pointer;
  padding:0 !important;
  width:56px;
  min-width:56px;
  height:58px;
}
td.day .badge{
  position:absolute;
  inset:8px;
  display:grid;
  place-items:center;
  border-radius:10px;
  font-size:15px;
  font-weight:900;
  letter-spacing:-0.3px;
  transition:all .15s cubic-bezier(.4,0,.2,1);
  border:1.5px solid transparent;
  font-family:var(--ff-mono);
  text-shadow:0 1px 0 rgba(255,255,255,0.3);
}
td.day:hover .badge{
  transform:scale(1.12);
  z-index:5;
  box-shadow:0 8px 20px rgba(0,0,0,0.5);
  border-color:rgba(255,255,255,0.3);
}

td.day .select-native{
  position:absolute;
  inset:0;
  width:100%;height:100%;
  opacity:0;
  cursor:pointer;
  appearance:none;-webkit-appearance:none;
  border:none;background:transparent;
  color:transparent;
  font-family:inherit;
  z-index:3;
}
td.day.picking{z-index:30}
td.day.picking .badge{opacity:0}
td.day.picking .select-native{
  opacity:1;
  color:var(--ink);
  background:var(--bg-3);
  border:2px solid var(--accent);
  border-radius:10px;
  inset:4px;
  width:calc(100% - 8px);
  height:calc(100% - 8px);
  padding:0 8px;
  font-size:13px;
  font-weight:700;
  box-shadow:0 0 0 5px rgba(74,144,226,0.25), 0 12px 32px rgba(0,0,0,0.7);
}

/* ============================================================
   BADGE COLORS — BRIGHT BG + DARK TEXT (readable!)
   ============================================================ */
.badge.Morning, .badge.WFHM, .badge.CCM{
  background:var(--morning-bg);
  color:var(--morning-text);
}
.badge.General, .badge.Genral, .badge.WFHG, .badge.CCG{
  background:var(--general-bg);
  color:var(--general-text);
}
.badge.Afternoon, .badge.WFHA, .badge.CCA{
  background:var(--afternoon-bg);
  color:var(--afternoon-text);
}
.badge.Night, .badge.WFHN, .badge.CCN{
  background:var(--night-bg);
  color:var(--night-text);
}
.badge.Weekoff{
  background:var(--weekoff-bg);
  color:var(--weekoff-text);
}
.badge.SL, .badge.CL, .badge.EL, .badge.Leave{
  background:var(--leave-bg);
  color:var(--leave-text);
}
.badge.FlexiLeave{
  background:var(--flexi-bg);
  color:var(--flexi-text);
}
.badge.HolidayLeave{
  background:var(--holiday-bg);
  color:var(--holiday-text);
}
.badge.NA, .badge.empty{
  background:var(--na-bg);
  color:var(--na-text);
}

/* ============================================================
   SUMMARY COLUMNS
   ============================================================ */
table.roster th.col-sum,
table.roster td.col-sum{
  min-width:72px;
  font-family:var(--ff-mono);
  font-size:16px;
  font-weight:900;
}
table.roster th.col-sum{
  font-family:var(--ff);
  font-size:12px;
  font-weight:800;
  letter-spacing:1.2px;
}
td.col-sum.wo{color:#C9A8FA;background:rgba(163,113,247,0.08)}
td.col-sum.lv{color:#FF9CA5;background:rgba(255,71,87,0.08)}

/* ============================================================
   AGGREGATE ROWS
   ============================================================ */
tr.agg td{
  background:var(--bg-2) !important;
  border-top:2px solid var(--line-hi);
  border-bottom:1px solid var(--line);
  padding:12px 8px;
  text-align:center;
  height:auto;
}
tr.agg td.col-emp,
tr.agg td.col-role{
  background:var(--bg-3) !important;
  font-family:var(--ff);
  font-size:12px;
  font-weight:900;
  color:var(--ink);
  text-transform:uppercase;
  letter-spacing:1.2px;
  text-align:left;
  padding:12px 18px;
}
tr.agg td .agg-pill{
  display:inline-block;
  padding:5px 12px;
  border-radius:8px;
  min-width:34px;
  font-weight:900;
  font-family:var(--ff-mono);
  font-size:14px;
  border:1px solid transparent;
}
.agg-pill.morning{background:var(--morning-bg);color:var(--morning-text);border-color:rgba(92,61,0,0.2)}
.agg-pill.general{background:var(--general-bg);color:var(--general-text);border-color:rgba(31,36,48,0.2)}
.agg-pill.afternoon{background:var(--afternoon-bg);color:var(--afternoon-text);border-color:rgba(92,38,0,0.2)}
.agg-pill.night{background:var(--night-bg);color:var(--night-text);border-color:rgba(0,37,77,0.2)}
.agg-pill.total{
  background:linear-gradient(135deg, #4A90E2, #3B7DD8);
  color:#fff;
  box-shadow:0 4px 12px -2px rgba(74,144,226,0.5);
}

/* ============================================================
   FOOTER
   ============================================================ */
.footer{
  background:var(--bg-1);
  border-top:1px solid var(--line-2);
  padding:14px 28px;
  display:flex;
  align-items:center;
  gap:16px;
  flex-shrink:0;
  box-shadow:0 -4px 16px rgba(0,0,0,0.4);
  position:relative;
  z-index:100;
}
.footer-info{
  font-size:14px;
  font-weight:600;
  color:var(--ink-2);
  display:flex;
  align-items:center;
  gap:10px;
}
.footer-info svg{
  width:16px;height:16px;
  stroke:var(--accent);fill:none;stroke-width:2.4;flex-shrink:0;
}
.footer-spacer{flex:1}

/* ============================================================
   EMPTY
   ============================================================ */
.empty{
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:80px 24px;text-align:center;color:var(--ink-3);height:100%;
}
.empty-icon{
  width:120px;height:120px;border-radius:28px;
  background:linear-gradient(135deg, var(--bg-2), var(--bg-1));
  border:2px solid var(--line-2);
  display:grid;place-items:center;margin-bottom:28px;
}
.empty-icon svg{width:56px;height:56px;stroke:var(--ink-4);fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.empty h3{font-size:24px;font-weight:800;color:var(--ink);margin-bottom:10px}
.empty p{font-size:15px;font-weight:500;color:var(--ink-3);line-height:1.7}

/* ============================================================
   RESPONSIVE
   ============================================================ */
@media (max-width:900px){
  .header{padding:14px 16px;flex-wrap:wrap;gap:14px}
  .header-logo{width:44px;height:44px}
  .header-logo svg{width:24px;height:24px}
  .header-text h1{font-size:17px}
  .header-text p{font-size:11px}
  .header-stats{width:100%;overflow-x:auto;padding-bottom:4px}
  .hstat{min-width:78px;padding:8px 12px}
  .hstat-val{font-size:18px}
  .hstat-lbl{font-size:9px}
  .toolbar{padding:12px 16px;gap:10px}
  .field select, .field input{min-width:110px;padding:9px 12px;font-size:13px}
  .search-box input{width:100%}
  .search-box input:focus{width:100%}
  .toolbar-spacer{display:none}
  .legend-bar{padding:10px 16px;gap:8px;overflow-x:auto;flex-wrap:nowrap}
  .legend-lbl{display:none}
  .footer{padding:12px 16px;flex-direction:column;align-items:stretch;gap:10px}
  .btn{width:100%;justify-content:center}
  table.roster th.col-emp, table.roster td.col-emp{
    min-width:180px;max-width:180px;padding:8px 12px;
  }
  table.roster th.col-role, table.roster td.col-role{
    left:180px;min-width:80px;max-width:80px;padding:8px 10px;font-size:11px;
  }
  .emp-av{width:32px;height:32px;font-size:12px;border-radius:8px}
  .emp-name{font-size:13px;max-width:120px}
  .emp-id{font-size:10px}
  td.day{width:44px;min-width:44px;height:52px}
  td.day .badge{inset:6px;font-size:13px;border-radius:8px}
  table.roster thead th{min-width:44px;padding:10px 4px;font-size:12px}
  table.roster thead tr:nth-child(2) th{min-width:44px;font-size:10px}
}
</style>
</head>
<body>

<div class="app">

  <!-- HEADER -->
  <header class="header">
    <div class="header-title">
      <div class="header-logo">
        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </div>
      <div class="header-text">
        <h1><%= m_strrole %> Roster</h1>
        <p><%= nameOfMonth %> <%= year %> &middot; <%= username %></p>
      </div>
    </div>

    <div class="header-spacer"></div>

    <div class="header-stats">
      <div class="hstat">
        <div class="hstat-val cyan"><%= noOfDays %></div>
        <div class="hstat-lbl">Days</div>
      </div>
      <div class="hstat">
        <div class="hstat-val purple" id="statEmp">0</div>
        <div class="hstat-lbl">Team</div>
      </div>
      <div class="hstat">
        <div class="hstat-val green" id="statAssigned">0</div>
        <div class="hstat-lbl">Assigned</div>
      </div>
    </div>
  </header>

  <!-- TOOLBAR -->
  <div class="toolbar">
    <form method="get" action="" style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap;">
      <div class="field">
        <label>Month</label>
        <select name="month">
          <% for (int m=1; m<=12; m++) { %>
            <option value="<%=m%>" <%= m==month ? "selected" : "" %>><%= monthNames[m] %></option>
          <% } %>
        </select>
      </div>
      <div class="field">
        <label>Year</label>
        <input type="number" name="year" min="2024" max="2100" value="<%=year%>" required style="min-width:110px;">
      </div>
      <input type="hidden" name="m_strroles" value="<%=m_strrole%>">
      <input type="hidden" name="username" value="<%=username%>">
      <button type="submit" class="btn btn-primary">
        <svg viewBox="0 0 24 24"><path d="M5 12h14"/><polyline points="12 5 19 12 12 19"/></svg>
        Load
      </button>
    </form>

    <div class="toolbar-spacer"></div>

    <div class="search-box">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" id="searchEmp" placeholder="Search employee name&hellip;" autocomplete="off">
    </div>
  </div>

  <!-- LEGEND -->
  <div class="legend-bar">
    <span class="legend-lbl">Legend</span>
    <span class="legend-chip"><span class="sw morning">M</span>Morning</span>
    <span class="legend-chip"><span class="sw general">D</span>General</span>
    <span class="legend-chip"><span class="sw afternoon">A</span>Afternoon</span>
    <span class="legend-chip"><span class="sw night">N</span>Night</span>
    <span class="legend-chip"><span class="sw weekoff">W</span>Weekoff</span>
    <span class="legend-chip"><span class="sw leave">SL</span>Leave</span>
    <span class="legend-chip"><span class="sw holiday">HL</span>Holiday</span>
  </div>

  <!-- ROSTER -->
  <div class="roster-wrap">

<%
    List<Map<String,Object>> employees = new ArrayList<>();
    Connection conn = null;
    PreparedStatement ps = null;
    ResultSet rsData = null;
    try {
        conn = DBUtilityAuto.getReportDBConnection();
        String q = "select * from rostertable where UPPER(TEAM) = UPPER(?) and UPPER(MONTHYEAR) = UPPER(?) order by id";
        ps = conn.prepareStatement(q);
        ps.setString(1, m_strrole);
        ps.setString(2, sort_MonthYear);
        rsData = ps.executeQuery();
        ResultSetMetaData md = rsData.getMetaData();
        int cc = md.getColumnCount();
        while (rsData.next()) {
            Map<String,Object> row = new HashMap<>();
            for (int i=1; i<=cc; i++) row.put(md.getColumnName(i).toUpperCase(), rsData.getObject(i));
            employees.add(row);
        }
    } catch (Exception e) { e.printStackTrace(); }
    finally {
        if (rsData != null) try { rsData.close(); } catch (Exception e) {}
        if (ps != null) try { ps.close(); } catch (Exception e) {}
    }
%>

<% if (employees.isEmpty()) { %>
    <div class="empty">
      <div class="empty-icon">
        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M9 16l2 2 4-4"/></svg>
      </div>
      <h3>No Roster Found</h3>
      <p>No shifts saved for <strong><%= nameOfMonth %> <%= year %></strong>.<br>Upload a roster file or select a different month.</p>
    </div>
<% } else { %>
    <form id="rosterForm" method="post" action="<%=request.getContextPath()%>/RosterServlet">
      <input type="hidden" name="tableData" id="tableData">
      <input type="hidden" name="selectedMonth" value="<%=selectedMonth%>">
      <input type="hidden" name="selectedYear" value="<%=selectedYear%>">
      <input type="hidden" name="m_strroles" value="<%=m_strrole%>">
      <input type="hidden" name="username" value="<%=username%>">

    <table class="roster" id="rosterTable">
      <thead>
        <tr>
          <th class="col-emp" rowspan="2">Employee</th>
          <th class="col-role" rowspan="2">Role</th>
          <% for (int d=1; d<=noOfDays; d++) {
               LocalDate dt = LocalDate.of(year, month, d);
               boolean wk = (dt.getDayOfWeek()==DayOfWeek.SATURDAY || dt.getDayOfWeek()==DayOfWeek.SUNDAY);
               boolean isToday = dt.equals(today);
          %>
            <th class="<%= wk?"weekend":"" %> <%= isToday?"today":"" %>"><%= d %></th>
          <% } %>
          <th class="col-sum" rowspan="2">WO</th>
          <th class="col-sum" rowspan="2">LV</th>
        </tr>
        <tr>
          <% for (int d=1; d<=noOfDays; d++) {
               LocalDate dt = LocalDate.of(year, month, d);
               String ds = dt.getDayOfWeek().getDisplayName(TextStyle.SHORT, Locale.ENGLISH).substring(0,2);
               boolean wk = (dt.getDayOfWeek()==DayOfWeek.SATURDAY || dt.getDayOfWeek()==DayOfWeek.SUNDAY);
               boolean isToday = dt.equals(today);
          %>
            <th class="<%= wk?"weekend":"" %> <%= isToday?"today":"" %>"><%= ds %></th>
          <% } %>
        </tr>
      </thead>
      <tbody>
      <%
         int empIdx = 0;
         for (Map<String,Object> emp : employees) {
             String nm = emp.get("NAME") != null ? emp.get("NAME").toString() : "";
             String id = emp.get("AD_ID") != null ? emp.get("AD_ID").toString() : "";
             String pos = emp.get("POSITION") != null ? emp.get("POSITION").toString() : "";
             String ini = "U";
             if (nm.length()>0) {
                 String[] p = nm.trim().split("\\s+");
                 ini = (p.length>=2) ? (p[0].substring(0,1)+p[p.length-1].substring(0,1)) : nm.substring(0,1);
                 ini = ini.toUpperCase();
             }
      %>
        <tr class="emp-row" data-name="<%= nm.toLowerCase() %>">
          <td class="col-emp">
            <div class="emp">
              <div class="emp-av"><%= ini %></div>
              <div>
                <div class="emp-name"><%= nm %></div>
                <div class="emp-id"><%= id %></div>
              </div>
            </div>
            <input type="hidden" name="employeeName" value="<%= nm %>">
            <input type="hidden" name="adId" value="<%= id %>">
            <input type="hidden" name="position_<%= empIdx %>" value="<%= pos %>">
          </td>
          <td class="col-role"><%= pos.isEmpty() ? "—" : pos %></td>
          <%
             int wo=0, lv=0;
             for (int d=1; d<=noOfDays; d++) {
                 String key = "DAY_" + d;
                 Object v = emp.get(key);
                 String shift = (v != null) ? v.toString().trim() : "";
                 if (shift.isEmpty()) shift = "NA";
                 String sl = shift.toLowerCase();
                 if (sl.contains("weekoff")) wo++;
                 if (sl.contains("leave")) lv++;

                 LocalDate dt = LocalDate.of(year, month, d);
                 boolean wk = (dt.getDayOfWeek()==DayOfWeek.SATURDAY || dt.getDayOfWeek()==DayOfWeek.SUNDAY);
                 boolean isToday = dt.equals(today);

                 String label = "·", bcls = "empty";
                 if (sl.contains("morning")) { label = sl.contains("wfh")?"WH":(sl.contains("cc")?"CC":"M"); bcls = sl.contains("wfh")?"WFHM":(sl.contains("cc")?"CCM":"Morning"); }
                 else if (sl.contains("general")||sl.contains("genral")) { label = sl.contains("wfh")?"WD":(sl.contains("cc")?"CD":"D"); bcls = sl.contains("wfh")?"WFHG":(sl.contains("cc")?"CCG":"General"); }
                 else if (sl.contains("afternoon")) { label = sl.contains("wfh")?"WA":(sl.contains("cc")?"CA":"A"); bcls = sl.contains("wfh")?"WFHA":(sl.contains("cc")?"CCA":"Afternoon"); }
                 else if (sl.contains("night")) { label = sl.contains("wfh")?"WN":(sl.contains("cc")?"CN":"N"); bcls = sl.contains("wfh")?"WFHN":(sl.contains("cc")?"CCN":"Night"); }
                 else if (sl.contains("weekoffadjust")) { label="WA"; bcls="Weekoff"; }
                 else if (sl.contains("weekoff")) { label="W"; bcls="Weekoff"; }
                 else if (sl.contains("sickleave")) { label="SL"; bcls="SL"; }
                 else if (sl.contains("casualleave")) { label="CL"; bcls="CL"; }
                 else if (sl.contains("earnedleave")) { label="EL"; bcls="EL"; }
                 else if (sl.contains("flexileave")) { label="FL"; bcls="FlexiLeave"; }
                 else if (sl.contains("holidayleave")) { label="HL"; bcls="HolidayLeave"; }
                 else if (sl.contains("leave")) { label="L"; bcls="Leave"; }
          %>
          <td class="day <%= wk?"weekend":"" %> <%= isToday?"today":"" %>">
            <div class="badge <%= bcls %>"><%= label %></div>
            <select name="mnt_<%= empIdx %>_<%= d %>" class="select-native" onchange="onPick(this)" onfocus="markPick(this)" onblur="unmarkPick(this)">
              <option value="Morning" <%= shift.equalsIgnoreCase("Morning")?"selected":"" %>>Morning</option>
              <option value="WFH-Morning" <%= shift.equalsIgnoreCase("WFH-Morning")?"selected":"" %>>WFH-Morning</option>
              <option value="CC-Morning" <%= shift.equalsIgnoreCase("CC-Morning")?"selected":"" %>>CC-Morning</option>
              <option value="General" <%= (shift.equalsIgnoreCase("General")||shift.equalsIgnoreCase("Genral"))?"selected":"" %>>General</option>
              <option value="WFH-General" <%= shift.equalsIgnoreCase("WFH-General")?"selected":"" %>>WFH-General</option>
              <option value="CC-General" <%= shift.equalsIgnoreCase("CC-General")?"selected":"" %>>CC-General</option>
              <option value="Afternoon" <%= shift.equalsIgnoreCase("Afternoon")?"selected":"" %>>Afternoon</option>
              <option value="WFH-Afternoon" <%= shift.equalsIgnoreCase("WFH-Afternoon")?"selected":"" %>>WFH-Afternoon</option>
              <option value="CC-Afternoon" <%= shift.equalsIgnoreCase("CC-Afternoon")?"selected":"" %>>CC-Afternoon</option>
              <option value="Night" <%= shift.equalsIgnoreCase("Night")?"selected":"" %>>Night</option>
              <option value="WFH-Night" <%= shift.equalsIgnoreCase("WFH-Night")?"selected":"" %>>WFH-Night</option>
              <option value="CC-Night" <%= shift.equalsIgnoreCase("CC-Night")?"selected":"" %>>CC-Night</option>
              <option value="Weekoff" <%= shift.equalsIgnoreCase("Weekoff")?"selected":"" %>>Weekoff</option>
              <option value="WeekoffAdjust" <%= shift.equalsIgnoreCase("WeekoffAdjust")?"selected":"" %>>Weekoff Adjust</option>
              <option value="SickLeave" <%= shift.equalsIgnoreCase("SickLeave")?"selected":"" %>>Sick Leave</option>
              <option value="CasualLeave" <%= shift.equalsIgnoreCase("CasualLeave")?"selected":"" %>>Casual Leave</option>
              <option value="EarnedLeave" <%= shift.equalsIgnoreCase("EarnedLeave")?"selected":"" %>>Earned Leave</option>
              <option value="FlexiLeave" <%= shift.equalsIgnoreCase("FlexiLeave")?"selected":"" %>>Flexi Leave</option>
              <option value="HolidayLeave" <%= shift.equalsIgnoreCase("HolidayLeave")?"selected":"" %>>Holiday</option>
              <option value="NA" <%= shift.equalsIgnoreCase("NA")?"selected":"" %>>Not Assigned</option>
            </select>
          </td>
          <% } %>
          <td class="col-sum wo"><%= wo %></td>
          <td class="col-sum lv"><%= lv %></td>
        </tr>
      <% empIdx++; } %>

      <tr class="agg">
        <td class="col-emp" colspan="2">Morning Count</td>
        <% for (int d=1; d<=noOfDays; d++) {
             int c=0;
             for (Map<String,Object> emp : employees) {
                 Object v = emp.get("DAY_"+d);
                 if (v!=null && v.toString().toLowerCase().contains("morning")) c++;
             }
        %>
          <td><span class="agg-pill morning"><%= c %></span></td>
        <% } %>
        <td colspan="2"></td>
      </tr>
      <tr class="agg">
        <td class="col-emp" colspan="2">General Count</td>
        <% for (int d=1; d<=noOfDays; d++) {
             int c=0;
             for (Map<String,Object> emp : employees) {
                 Object v = emp.get("DAY_"+d);
                 if (v!=null) { String s=v.toString().toLowerCase(); if (s.contains("general")||s.contains("genral")) c++; }
             }
        %>
          <td><span class="agg-pill general"><%= c %></span></td>
        <% } %>
        <td colspan="2"></td>
      </tr>
      <tr class="agg">
        <td class="col-emp" colspan="2">Afternoon Count</td>
        <% for (int d=1; d<=noOfDays; d++) {
             int c=0;
             for (Map<String,Object> emp : employees) {
                 Object v = emp.get("DAY_"+d);
                 if (v!=null && v.toString().toLowerCase().contains("afternoon")) c++;
             }
        %>
          <td><span class="agg-pill afternoon"><%= c %></span></td>
        <% } %>
        <td colspan="2"></td>
      </tr>
      <tr class="agg">
        <td class="col-emp" colspan="2">Night Count</td>
        <% for (int d=1; d<=noOfDays; d++) {
             int c=0;
             for (Map<String,Object> emp : employees) {
                 Object v = emp.get("DAY_"+d);
                 if (v!=null && v.toString().toLowerCase().contains("night")) c++;
             }
        %>
          <td><span class="agg-pill night"><%= c %></span></td>
        <% } %>
        <td colspan="2"></td>
      </tr>
      <tr class="agg">
        <td class="col-emp" colspan="2">Total Assigned</td>
        <% for (int d=1; d<=noOfDays; d++) {
             int c=0;
             for (Map<String,Object> emp : employees) {
                 Object v = emp.get("DAY_"+d);
                 if (v!=null && !v.toString().trim().isEmpty() && !v.toString().equalsIgnoreCase("NA")) c++;
             }
        %>
          <td><span class="agg-pill total"><%= c %></span></td>
        <% } %>
        <td colspan="2"></td>
      </tr>
      </tbody>
    </table>
    </form>
<% } %>

  </div>

  <!-- FOOTER -->
  <% if (!employees.isEmpty()) { %>
  <div class="footer">
    <div class="footer-info">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      Click any cell &rarr; pick a shift &rarr; click <strong>Save Roster</strong>
    </div>
    <div class="footer-spacer"></div>
    <button type="button" class="btn btn-ghost" onclick="location.reload()">
      <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
      Reset
    </button>
    <button type="button" class="btn btn-success" onclick="submitRoster()">
      <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      Save Roster
    </button>
  </div>
  <% } %>

</div>

<script>
(function(){
  var empCount = document.querySelectorAll('tr.emp-row').length;
  document.getElementById('statEmp').textContent = empCount;
  var assigned = 0;
  document.querySelectorAll('td.day .badge').forEach(function(b){
    if (!b.classList.contains('empty') && !b.classList.contains('NA')) assigned++;
  });
  document.getElementById('statAssigned').textContent = assigned;
})();

document.getElementById('searchEmp').addEventListener('input', function(e){
  var q = e.target.value.toLowerCase().trim();
  document.querySelectorAll('tr.emp-row').forEach(function(r){
    var n = r.getAttribute('data-name') || '';
    r.style.display = (!q || n.indexOf(q) !== -1) ? '' : 'none';
  });
});

function markPick(sel){
  var td = sel.closest('td.day');
  if (td) td.classList.add('picking');
}
function unmarkPick(sel){
  var td = sel.closest('td.day');
  if (td) setTimeout(function(){ td.classList.remove('picking'); }, 150);
}
function onPick(sel){
  var td = sel.closest('td.day');
  var bd = td.querySelector('.badge');
  var v  = sel.value;
  var lv = v.toLowerCase();
  var label = "·", cls = "empty";
  if (lv.indexOf('morning')!==-1) { label = lv.indexOf('wfh')!==-1?'WH':(lv.indexOf('cc')!==-1?'CC':'M'); cls = lv.indexOf('wfh')!==-1?'WFHM':(lv.indexOf('cc')!==-1?'CCM':'Morning'); }
  else if (lv.indexOf('general')!==-1 || lv.indexOf('genral')!==-1) { label = lv.indexOf('wfh')!==-1?'WD':(lv.indexOf('cc')!==-1?'CD':'D'); cls = lv.indexOf('wfh')!==-1?'WFHG':(lv.indexOf('cc')!==-1?'CCG':'General'); }
  else if (lv.indexOf('afternoon')!==-1) { label = lv.indexOf('wfh')!==-1?'WA':(lv.indexOf('cc')!==-1?'CA':'A'); cls = lv.indexOf('wfh')!==-1?'WFHA':(lv.indexOf('cc')!==-1?'CCA':'Afternoon'); }
  else if (lv.indexOf('night')!==-1) { label = lv.indexOf('wfh')!==-1?'WN':(lv.indexOf('cc')!==-1?'CN':'N'); cls = lv.indexOf('wfh')!==-1?'WFHN':(lv.indexOf('cc')!==-1?'CCN':'Night'); }
  else if (lv.indexOf('weekoffadjust')!==-1) { label='WA'; cls='Weekoff'; }
  else if (lv.indexOf('weekoff')!==-1) { label='W'; cls='Weekoff'; }
  else if (lv.indexOf('sickleave')!==-1) { label='SL'; cls='SL'; }
  else if (lv.indexOf('casualleave')!==-1) { label='CL'; cls='CL'; }
  else if (lv.indexOf('earnedleave')!==-1) { label='EL'; cls='EL'; }
  else if (lv.indexOf('flexileave')!==-1) { label='FL'; cls='FlexiLeave'; }
  else if (lv.indexOf('holidayleave')!==-1) { label='HL'; cls='HolidayLeave'; }
  else if (lv.indexOf('leave')!==-1) { label='L'; cls='Leave'; }
  bd.textContent = label;
  bd.className = 'badge ' + cls;
  setTimeout(function(){ td.classList.remove('picking'); }, 200);
}

function submitRoster(){
  var data = [];
  var rows = document.querySelectorAll('#rosterTable tbody tr.emp-row');
  rows.forEach(function(row, idx){
    var nm = row.querySelector('input[name="employeeName"]').value;
    var id = row.querySelector('input[name="adId"]').value;
    var posEl = row.querySelector('input[name="position_'+idx+'"]');
    var obj = { name: nm, adId: id, position: posEl ? posEl.value : '', days: {} };
    row.querySelectorAll('select[name^="mnt_"]').forEach(function(sel){
      var m = sel.name.match(/mnt_(\d+)_(\d+)/);
      if (m) obj.days[m[2]] = sel.value;
    });
    data.push(obj);
  });
  document.getElementById('tableData').value = JSON.stringify(data);
  document.getElementById('rosterForm').submit();
}
</script>


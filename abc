.hits-value { font-size:56px; font-weight:900; text-align:center; margin:10px 0 6px; background:linear-gradient(135deg, #fff, #a78bfa); -webkit-background-clip:text; -webkit-text-fill-color:transparent; line-height:1; letter-spacing:-2px; }
.hits-value .label { font-size:13px; font-weight:700; -webkit-text-fill-color:rgba(255,255,255,0.35); letter-spacing:2px; display:block; margin-top:6px; }
.hit-status { text-align:center; padding:9px; border-radius:14px; font-size:13px; font-weight:700; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.05); }
.hit-status.up { color:#34d399; }
.hit-status.down { color:#f87171; }
.cart.blink-zero { animation:blinkRed 1s ease-in-out infinite; border-color:#f87171; }
@keyframes blinkRed { 0%,100% { background:rgba(255,255,255,0.03); border-color:rgba(248,113,113,0.25); } 50% { background:rgba(248,113,113,0.10); border-color:#f87171; box-shadow:0 0 36px rgba(248,113,113,0.25); } }
.last-updated { margin-top:14px; font-size:10px; color:rgba(255,255,255,0.22); text-align:right; letter-spacing:0.4px; border-top:1px solid rgba(255,255,255,0.03); padding-top:12px; font-weight:600; }
.no-data { grid-column:1/-1; text-align:center; padding:60px 40px; background:rgba(255,255,255,0.02); border-radius:32px; border:1px solid rgba(255,255,255,0.05); }
.no-data h3 { font-size:24px; font-weight:800; margin-bottom:10px; background:linear-gradient(135deg, #fff, #a78bfa); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
.no-data p { color:rgba(255,255,255,0.45); font-size:15px; }
.audio-controls { position:fixed; bottom:30px; right:30px; z-index:1000; }
.mute-btn { width:66px; height:66px; border-radius:50%; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:#fff; font-size:12px; font-weight:900; cursor:pointer; transition:all 0.3s; backdrop-filter:blur(12px); box-shadow:0 12px 32px rgba(0,0,0,0.4); position:relative; display:flex; align-items:center; justify-content:center; text-decoration:none; font-family:'Inter',sans-serif; letter-spacing:1px; }
.mute-btn:hover { transform:scale(1.08); }
.mute-btn.sound-on { background:rgba(52,211,153,0.18); border-color:rgba(52,211,153,0.35); color:#34d399; }
.mute-btn.sound-off { background:rgba(248,113,113,0.15); border-color:rgba(248,113,113,0.3); color:#f87171; }
.mute-btn .indicator { position:absolute; top:-4px; right:-4px; width:16px; height:16px; border-radius:50%; background:#34d399; border:2px solid #0b0e1a; animation:pulseDot 1.6s ease-in-out infinite; }
.mute-btn.sound-off .indicator { background:#f87171; }
.footer { margin-top:40px; text-align:center; padding:24px; color:rgba(255,255,255,0.22); font-size:12px; letter-spacing:0.6px; border-top:1px solid rgba(255,255,255,0.04); font-weight:600; }
.footer strong { color:rgba(255,255,255,0.4); }
@media (max-width:768px) {
    body { padding:14px; }
    .header { padding:22px 20px; }
    .header h1 { font-size:22px; }
    .header-top { flex-direction:column; align-items:stretch; }
    .datetime-picker { flex-direction:column; }
    .datetime-input { min-width:100%; }
    .manual-btn { width:100%; justify-content:center; }
    .stats-panel { grid-template-columns:1fr 1fr; }
    .stat-value { font-size:28px; }
    .carts-container { grid-template-columns:1fr; }
    .hits-value { font-size:44px; }
    .partition-chip { margin-left:0; margin-top:8px; }
}
@media (max-width:480px) { .stats-panel { grid-template-columns:1fr; } }
::-webkit-scrollbar { width:6px; }
::-webkit-scrollbar-track { background:rgba(255,255,255,0.02); }
::-webkit-scrollbar-thumb { background:rgba(167,139,250,0.3); border-radius:10px; }
</style>
</head>
<body>
<div class="container">

<!-- ── HEADER ── -->
<div class="header">
<div class="header-top">
<h1>DMZ DPG Monitoring <small>Inbound &amp; Outbound · Real-time</small></h1>
<div class="header-actions">
<span class="live-badge"><span class="dot"></span> LIVE</span>
<button class="btn" onclick="refreshPage()" id="refreshBtn">
<svg viewBox="0 0 24 24"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg> Refresh
</button>
<a href="<%= request.getRequestURI() %>?action=refreshMaster&mute=<%= isMuted %><%= (manualFromTime!=null?"&fromTime="+manualFromTime:"") %><%= (manualToTime!=null?"&toTime="+manualToTime:"") %>" class="btn btn-refresh-ip" onclick="return confirm('Refresh IP list? This will delete and reload all IPs from API_LOG.');">
<svg viewBox="0 0 24 24"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg> Refresh IP List
</a>
<button class="btn btn-sql" onclick="toggleSqlBox()">
<svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg> Show SQL
</button>
<span style="font-size:12px;color:rgba(255,255,255,0.3);font-weight:700;letter-spacing:0.5px;"><%= currentTime %></span>
</div>
</div>

<!-- ── SQL BOX ── -->
<div id="sqlBox" class="sql-box">
<div class="section-label">🔵 Inbound Query (API_LOG)</div>
<pre id="sqlQueryText"><%= displayQuery %></pre>
<button class="copy-btn" onclick="copySql('sqlQueryText','copyMsg1')">Copy Inbound SQL</button>
<span id="copyMsg1" class="copy-msg">Copied!</span>

<div class="section-label">🟡 Outbound Query (BACKEND_LOG · port 7443)</div>
<pre id="outboundSqlText"><%= displayOutboundQuery %></pre>
<button class="copy-btn" onclick="copySql('outboundSqlText','copyMsg2')">Copy Outbound SQL</button>
<span id="copyMsg2" class="copy-msg">Copied!</span>
</div>

<!-- ── TIME RANGE + PARTITION CHIP ── -->
<div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px;">
<div class="time-range-display">
DATA FROM: <span class="time-value"><%= timeRangeDisplay %></span>
<span class="partition-chip">📅 PARTITION: <%= activePartition %></span>
</div>
</div>

<!-- ── DATETIME ── -->
<div class="datetime-section">
<form method="get" action="" id="mainForm">
<input type="hidden" name="mute" id="muteInput" value="<%= isMuted %>">
<div class="datetime-picker">
<div class="datetime-input"><label>FROM</label><input type="datetime-local" name="fromTime" id="fromTime" value="<%= manualFromTime!=null?manualFromTime:"" %>"></div>
<div class="datetime-input"><label>TO</label><input type="datetime-local" name="toTime" id="toTime" value="<%= manualToTime!=null?manualToTime:"" %>"></div>
<button type="submit" class="manual-btn">APPLY</button>
<% if(manualFromTime != null || manualToTime != null) { %>
<a href="<%= request.getRequestURI() %>?mute=<%= isMuted %>" class="manual-btn reset-btn">RESET</a>
<% } %>
</div>
</form>
</div>
</div>

<!-- ── STATS ── -->
<div class="stats-panel">
<div class="stat-card" id="totalHitsCard"><div class="stat-label">Total Hits (Inbound)</div><div class="stat-value purple" id="totalHits">0</div></div>
<div class="stat-card outbound-card" id="dpgOutboundCard"><div class="stat-label">Outbound Hits (Port 7443)</div><div class="stat-value orange" id="dpgOutboundHits">0</div></div>
<div class="stat-card" id="zeroHitsCard"><div class="stat-label">Zero Hit Carts</div><div class="stat-value red" id="zeroHitsCount">0</div></div>
<div class="stat-card"><div class="stat-label">Active Carts</div><div class="stat-value blue" id="totalCarts">0</div></div>
<div class="stat-card"><div class="stat-label">PR Mode</div><div class="stat-value green" id="prCount">0</div></div>
<div class="stat-card"><div class="stat-label">DR Mode</div><div class="stat-value" id="drCount" style="background:linear-gradient(135deg,#60a5fa,#3b82f6);-webkit-background-clip:text;">0</div></div>
</div>

<!-- ── CARTS ── -->
<div class="section-title"><span class="accent"></span>DPG Carts — Live Hit Status</div>
<div id="cartsContainer" class="carts-container">
<%
// ── Read master IP list ──
List<String> allIps = new ArrayList<>();
Connection connRead = null;
Statement stmtRead = null;
ResultSet rsRead = null;
try {
    connRead = DBUtilityAuto.getReportDBConnection();
    stmtRead = connRead.createStatement();
    rsRead = stmtRead.executeQuery("SELECT DPG_IP FROM DPG_IP_MASTER ORDER BY DPG_IP");
    while (rsRead.next()) allIps.add(rsRead.getString("DPG_IP"));
} catch (SQLException e) {
    e.printStackTrace();
} finally {
    try { if (rsRead != null) rsRead.close(); } catch (Exception e) {}
    try { if (stmtRead != null) stmtRead.close(); } catch (Exception e) {}
    try { if (connRead != null) connRead.close(); } catch (Exception e) {}
}

// ── Fetch outbound hits (independent of IP list) ──
try {
    dpgOutboundHits = getDpgOutboundHits(manualFromTime, manualToTime);
} catch (Exception e) {
    e.printStackTrace();
    dpgOutboundHits = 0;
}

if (allIps == null || allIps.isEmpty()) {
%>
<div class="no-data">
<h3>IP Master List is Empty</h3>
<p>Click <strong>"Refresh IP List"</strong> to populate the master table, or wait for auto-refresh (runs daily).</p>
</div>
<%
    prCount = 0; drCount = 0; totalHits = 0; totalCarts = 0; zeroHitCarts = 0;
} else {
    // ── Build IN clause ──
    StringBuilder inClause = new StringBuilder();
    for (int i = 0; i < allIps.size(); i++) {
        inClause.append("'").append(allIps.get(i)).append("'");
        if (i < allIps.size() - 1) inClause.append(",");
    }

    Connection connIIB = null;
    PreparedStatement pstmtIIB = null;
    ResultSet rsIIB = null;
    try {
        connIIB = DBUtilityAuto.getIIBDBConnection();

        // ── Inbound query WITH dynamic partition ──
        String countQuery =
            "SELECT /*+ PARALLEL(4) */ TRIM(DPG_IP) AS DPG_IP, COUNT(1) AS TOTAL_HITS " +
            "FROM EISAPP.API_LOG PARTITION (" + activePartition + ") " +
            "WHERE TRIM(DPG_IP) IN (" + inClause.toString() + ") " +
            buildTimeCondition(manualFromTime, manualToTime) +
            "GROUP BY TRIM(DPG_IP)";

        System.out.println("===== Inbound hit count query =====");
        System.out.println(countQuery);
        System.out.println("===================================");

        pstmtIIB = connIIB.prepareStatement(countQuery);
        rsIIB = pstmtIIB.executeQuery();
        Map<String, Integer> countMap = new HashMap<>();
        while (rsIIB.next()) {
            countMap.put(rsIIB.getString("DPG_IP"), rsIIB.getInt("TOTAL_HITS"));
        }

        for (String ip : allIps) {
            Map<String, Object> row = new HashMap<>();
            int hits = countMap.getOrDefault(ip, 0);
            row.put("dpgIp", ip);
            row.put("hits", hits);
            dataList.add(row);
            totalHits += hits;
            totalCarts++;
            if (hits == 0) zeroHitCarts++;
            String mode = getModeFromIp(ip);
            if ("PR".equals(mode)) prCount++;
            else if ("DR".equals(mode)) drCount++;
        }
    } catch (Exception e) {
        e.printStackTrace();
%>
<div class="no-data">
<h3>System Error</h3>
<p><%= e.getMessage() %></p>
</div>
<%
    } finally {
        try { if (rsIIB != null) rsIIB.close(); } catch (Exception e) {}
        try { if (pstmtIIB != null) pstmtIIB.close(); } catch (Exception e) {}
        try { if (connIIB != null) connIIB.close(); } catch (Exception e) {}
    }
}

if (dataList != null && !dataList.isEmpty()) {
    Collections.sort(dataList, (a,b) -> ((String)a.get("dpgIp")).compareTo((String)b.get("dpgIp")));
    for (Map<String, Object> row : dataList) {
        String fullIp = (String) row.get("dpgIp");
        String maskedIp = maskIp(fullIp);
        int hits = (Integer) row.get("hits");
        String mode = getModeFromIp(fullIp);
        boolean isPr = "PR".equals(mode);
        String badgeClass = isPr ? "pr" : "dr";
        String statusClass, statusText, cartExtraClass = "";
        if (hits == 0) {
            statusClass = "down"; statusText = "IP Down / No Traffic"; cartExtraClass = "blink-zero";
        } else {
            statusClass = "up"; statusText = "Up & Running";
        }
%>
<div class="cart <%= cartExtraClass %>" data-mode="<%= mode %>" data-hits="<%= hits %>">
<div class="cart-header">
<span class="dpg-ip"><%= maskedIp %><span class="full-ip"><%= fullIp %></span></span>
<span class="mode-badge <%= badgeClass %>"><%= mode %></span>
</div>
<div class="hits-value"><%= hits %><span class="label">HITS</span></div>
<div class="hit-status <%= statusClass %>"><%= statusText %></div>
<div class="last-updated">Updated: <%= currentTime %></div>
</div>
<%
    }
} else if (dataList != null && dataList.isEmpty() && allIps != null && !allIps.isEmpty()) {
%>
<div class="no-data">
<h3>No Data Available</h3>
<p>No DPG IP records found in the selected time range.</p>
</div>
<%
}
%>
</div>

<div class="footer">
<p>DMZ DPG Monitoring — <strong>PR</strong> (171.x) &amp; <strong>DR</strong> (176.x) — Auto-refresh every 10 min</p>
<p style="font-size:11px;margin-top:6px;color:rgba(255,255,255,0.15);">Data Range: <%= timeRangeDisplay %> &nbsp;|&nbsp; Partition: <strong style="color:#fbbf24;"><%= activePartition %></strong></p>
</div>
</div>

<!-- ── MUTE ── -->
<div class="audio-controls">
<%
String newMute = isMuted ? "false" : "true";
String muteUrl = request.getRequestURI() + "?mute=" + newMute;
if (manualFromTime != null) muteUrl += "&fromTime=" + manualFromTime;
if (manualToTime != null) muteUrl += "&toTime=" + manualToTime;
%>
<a href="<%= muteUrl %>" class="mute-btn <%= isMuted ? "sound-off" : "sound-on" %>">
<%= isMuted ? "OFF" : "ON" %>
<span class="indicator"></span>
</a>
</div>

<audio id="alertSound" preload="auto">
<source src="data:audio/wav;base64," type="audio/wav">
</audio>

<script>
const totalHits = <%= totalHits %>;
const zeroHits = <%= zeroHitCarts %>;
const dpgOutboundHits = <%= dpgOutboundHits %>;
document.getElementById('totalHits').textContent = totalHits;
document.getElementById('zeroHitsCount').textContent = zeroHits;
document.getElementById('totalCarts').textContent = '<%= totalCarts %>';
document.getElementById('prCount').textContent = '<%= prCount %>';
document.getElementById('drCount').textContent = '<%= drCount %>';
document.getElementById('dpgOutboundHits').textContent = dpgOutboundHits;

const zeroHitsCard = document.getElementById('zeroHitsCard');
if (zeroHits > 0) zeroHitsCard.classList.add('blink-zero-stat'); else zeroHitsCard.classList.remove('blink-zero-stat');

const totalHitsCard = document.getElementById('totalHitsCard');
if (totalHits === 0) totalHitsCard.classList.add('blink-zero-stat'); else totalHitsCard.classList.remove('blink-zero-stat');

const dpgOutboundCard = document.getElementById('dpgOutboundCard');
if (dpgOutboundHits === 0) dpgOutboundCard.classList.add('blink-zero-stat'); else dpgOutboundCard.classList.remove('blink-zero-stat');

// ── Audio ──
const audio = document.getElementById('alertSound');
let isMuted = <%= isMuted %>;
let alertPlayed = false;
audio.load();
function checkAndPlayAlert() {
    if (totalHits === 0 && !isMuted && !alertPlayed) {
        audio.currentTime = 0;
        audio.play().catch(e => console.log('Audio play failed:', e));
        alertPlayed = true;
        setTimeout(() => { alertPlayed = false; }, 5000);
    }
}
checkAndPlayAlert();
setInterval(checkAndPlayAlert, 3000);

function toggleSqlBox() { document.getElementById('sqlBox').classList.toggle('show'); }

function copySql(preId, msgId) {
    const text = document.getElementById(preId).innerText;
    navigator.clipboard.writeText(text).then(() => {
        const msg = document.getElementById(msgId);
        msg.style.display = 'inline';
        setTimeout(() => { msg.style.display = 'none'; }, 2500);
    }).catch(() => {
        const range = document.createRange();
        const pre = document.getElementById(preId);
        range.selectNode(pre);
        window.getSelection().removeAllRanges();
        window.getSelection().addRange(range);
        document.execCommand('copy');
        const msg = document.getElementById(msgId);
        msg.style.display = 'inline';
        setTimeout(() => { msg.style.display = 'none'; }, 2500);
    });
}

function refreshPage() {
    const btn = document.getElementById('refreshBtn');
    const svg = btn.querySelector('svg');
    svg.classList.add('spin');
    btn.disabled = true; btn.style.opacity = '0.6';
    document.getElementById('mainForm').submit();
    setTimeout(() => { svg.classList.remove('spin'); btn.disabled = false; btn.style.opacity = '1'; }, 3000);
}

document.addEventListener('DOMContentLoaded', () => {
    const from = document.getElementById('fromTime');
    const to = document.getElementById('toTime');
    if (!from.value) { const now = new Date(); from.value = new Date(now.getTime() - 10*60000).toISOString().slice(0,16); }
    if (!to.value) { to.value = new Date().toISOString().slice(0,16); }
});

document.querySelectorAll('.cart').forEach(card => {
    card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(1200px) rotateX(${y*5}deg) rotateY(${-x*5}deg) translateZ(10px)`;
    });
    card.addEventListener('mouseleave', () => { card.style.transform = 'perspective(1200px) rotateX(0deg) rotateY(0deg) translateZ(0px)'; });
});

console.log('DMZ DPG Monitoring — partition:', '<%= activePartition %>');
console.log('Inbound:', totalHits, '| Outbound:', dpgOutboundHits, '| Zero carts:', zeroHits);
</script>
</body>
</html>

}
.card-modern:hover {
    border-color: var(--brand);
    box-shadow: 0 12px 32px -10px rgba(248,111,3,.2);
}

.card-header-modern {
    padding: 8px 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
    height: 36px;
    background: var(--card);
    border-bottom: 1px solid var(--line);
}
.card-header-modern .title {
    font-weight: 800;
    font-size: 0.82rem;
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
    letter-spacing: 0.3px;
    text-transform: uppercase;
}
.card-header-modern .title i {
    color: var(--brand);
    font-size: 0.9rem;
}
.card-header-modern .badge-count {

<script>
var expData = { labels: [], values: [], apiNames: [], brokerNames: [], errorCodes: [], loaded: false };
var sysData = { labels: [], values: [], apiNames: [], sysBrokerNames: [], errorCodes: [], loaded: false };

/* ✅ Theme detect */
var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
var chartBg      = isDark ? '#000000' : '#FFFFFF';
var chartText    = isDark ? '#FFFFFF' : '#0A0A0A';
var chartGrid    = isDark ? '#333333' : '#E5E7EB';
var chartTick    = isDark ? '#333333' : '#D1D5DB';
var chartBorder  = isDark ? '#333333' : '#CCCCCC';

document.addEventListener('DOMContentLoaded', function() {
    var currentTime = new Date();
    var tenMinutesAgo = new Date();
    tenMinutesAgo.setMinutes(currentTime.getMinutes() - 10);
    var formatTime = function(date) {
        var hours = date.getHours();
        var minutes = date.getMinutes();
        hours = hours < 10 ? '0' + hours : hours;
        minutes = minutes < 10 ? '0' + minutes : minutes;
        return hours + ':' + minutes;
    };
    var message = 'Your session was from ' + formatTime(tenMinutesAgo) + ' to ' + formatTime(currentTime);
    document.getElementById('timeRangeMessage').innerText = message;
});

function initializeDashboards() {
    document.getElementById('expStatus').className = 'status-indicator status-loading';
    document.getElementById('sysStatus').className = 'status-indicator status-loading';

    expData.labels = [<%
        List<String> expLabelsList = (List<String>)request.getAttribute("expLabels");
        if(expLabelsList != null) { for(String label: expLabelsList) { out.print("\"" + label.replace("\\","\\\\").replace("\"", "\\\"").replace("\n","").replace("\r","") + "\","); } }
    %>];
    expData.values = [<%
        List<Double> expValuesList = (List<Double>)request.getAttribute("expValues");
        if(expValuesList != null) { for(Double value: expValuesList) { out.print(value + ","); } }
    %>];
    expData.apiNames = [<%
        List<String> expApiNamesList = (List<String>)request.getAttribute("expApiNames");
        if(expApiNamesList != null) { for(String name: expApiNamesList) { out.print("\"" + name.replace("\"", "\\\"") + "\","); } }
    %>];
    expData.brokerNames = [<%
        List<String> expBrokerNamesList = (List<String>)request.getAttribute("expBrokerNames");
        if(expBrokerNamesList != null) { for(String broker: expBrokerNamesList) { out.print("\"" + broker.replace("\"", "\\\"") + "\","); } }
    %>];
    expData.errorCodes = [<%
        List<String> expErrorCodesList = (List<String>)request.getAttribute("expErrorCodes");
        if(expErrorCodesList != null) { for(String codes: expErrorCodesList) { out.print("\"" + codes.replace("\"", "\\\"") + "\","); } }
    %>];
    expData.loaded = true;

    sysData.labels = [<%
        List<String> sysLabelsList = (List<String>)request.getAttribute("sysLabels");
        if(sysLabelsList != null) { for(String label: sysLabelsList) { out.print("\"" + label.replace("\\","\\\\").replace("\"", "\\\"").replace("\n","").replace("\r","") + "\","); } }
    %>];
    sysData.values = [<%
        List<Double> sysValuesList = (List<Double>)request.getAttribute("sysValues");
        if(sysValuesList != null) { for(Double value: sysValuesList) { out.print(value + ","); } }
    %>];
    sysData.apiNames = [<%
        List<String> sysApiNamesList = (List<String>)request.getAttribute("sysApiNames");
        if(sysApiNamesList != null) { for(String name: sysApiNamesList) { out.print("\"" + name.replace("\"", "\\\"") + "\","); } }
    %>];
    sysData.sysBrokerNames = [<%
        List<String> sysBrokerNamesList = (List<String>)request.getAttribute("sysBrokerNames");

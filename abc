html[data-theme="dark"] .section-title h2 .icon-svg{color:var(--ml-primary-2)}

.quick-actions{
  display:grid;grid-template-columns:repeat(4, 1fr);
  gap:16px;margin-bottom:28px;
}
.qa-card{
  background:var(--card);

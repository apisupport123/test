<script>
const cmdOverlay = document.getElementById('cmdOverlay');
const cmdInput = document.getElementById('cmdInput');
const cmdList = document.getElementById('cmdList');
const cmdEmpty = document.getElementById('cmdEmpty');
let activeIndex = -1;

function openCmd(){
  cmdOverlay.classList.add('open');
  setTimeout(() => cmdInput.focus(), 50);
  filterCmd('');
}
function closeCmd(){
  cmdOverlay.classList.remove('open');
  cmdInput.value = '';
  activeIndex = -1;
  filterCmd('');
}
function filterCmd(q){
  q = (q || '').toLowerCase().trim();
  const items = cmdList.querySelectorAll('.cmd-item');
  const groups = cmdList.querySelectorAll('.cmd-group');
  let visible = 0;
  items.forEach(it => {
    const txt = it.innerText.toLowerCase();
    const kw = (it.dataset.keywords || '').toLowerCase();
    const match = !q || txt.includes(q) || kw.includes(q);
    it.style.display = match ? 'flex' : 'none';
    if(match) visible++;
  });
  // Hide empty groups
  groups.forEach(g => {
    let next = g.nextElementSibling;
    let hasVisible = false;
    while(next && !next.classList.contains('cmd-group')){
      if(next.classList.contains('cmd-item') && next.style.display !== 'none'){ hasVisible = true; break; }
      next = next.nextElementSibling;
    }
    g.style.display = hasVisible ? 'block' : 'none';
  });
  cmdEmpty.style.display = visible === 0 ? 'block' : 'none';
  activeIndex = -1;
  if(visible > 0) setActive(0);
}
function setActive(i){
  const vis = [...cmdList.querySelectorAll('.cmd-item')].filter(x => x.style.display !== 'none');
  if(vis.length === 0) return;
  vis.forEach(v => v.classList.remove('active'));
  if(i < 0) i = vis.length - 1;
  if(i >= vis.length) i = 0;
  activeIndex = i;
  vis[i].classList.add('active');
  vis[i].scrollIntoView({block:'nearest'});
}
function activateItem(){
  const vis = [...cmdList.querySelectorAll('.cmd-item')].filter(x => x.style.display !== 'none');
  if(activeIndex >= 0 && vis[activeIndex]){
    window.location.href = vis[activeIndex].href;
  }
}

cmdInput.addEventListener('input', e => filterCmd(e.target.value));
cmdInput.addEventListener('keydown', e => {
  if(e.key === 'ArrowDown'){ e.preventDefault(); setActive(activeIndex + 1); }
  else if(e.key === 'ArrowUp'){ e.preventDefault(); setActive(activeIndex - 1); }
  else if(e.key === 'Enter'){ e.preventDefault(); activateItem(); }
  else if(e.key === 'Escape'){ closeCmd(); }
});
document.addEventListener('keydown', e => {
  if((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k'){
    e.preventDefault();
    if(cmdOverlay.classList.contains('open')) closeCmd();
    else openCmd();
  } else if(e.key === 'Escape' && cmdOverlay.classList.contains('open')){
    closeCmd();
  }
});
</script>
</body>
</html>



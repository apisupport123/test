                    expHolder.apiNames.add(resultSet.getString("API_NAME"));
                    expHolder.brokerNames.add(brokerNameOnly == null ? "N/A" : brokerNameOnly);
                    String activeErrorCodes = resultSet.getString("ACTIVE_ERROR_CODES");
                    if (activeErrorCodes == null || activeErrorCodes.trim().isEmpty()) {

    		if(conn != null) conn.close();
    	}catch(Exception e){
    		e.printStackTrace();
    	}
    }
    %> 
            </tbody>
        </table>
    </div>
    <div class="pagination">
        <button id="prevPage" onclick="changePage(-1)" disabled>Previous</button>
        <button id="nextPage" onclick="changePage(1)">Next</button>
    </div>

    <script>
        const globalSearch = document.getElementById('globalSearch');
        globalSearch.addEventListener('input', () => {
            const value = globalSearch.value.toLowerCase();
            const rows = document.querySelectorAll('#dataTable tbody tr');
            rows.forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(value) ? '' : 'none';
            });
        });

        // Define initial values
let currentPage = 1;
let rowsPerPage = 10; // Default value matches the initial dropdown selection

// Apply pagination on page load
window.onload = function () {
    const entriesSelect = document.getElementById('entriesSelect');
    entriesSelect.value = '10'; // Ensure the dropdown value is set to 10 initially
    paginateTable();
};

function updateEntries() {
    const select = document.getElementById('entriesSelect').value;
    if (select === 'all') {
        rowsPerPage = Infinity; // No limit for rows per page
    } else {
        rowsPerPage = parseInt(select);
    }
    currentPage = 1; // Reset to the first page
    paginateTable();
}

        function filterTable() {
            const inputs = document.querySelectorAll('.filters input');
            const rows = document.querySelectorAll('#dataTable tbody tr');
            rows.forEach(row => {
                let isVisible = true;
                inputs.forEach((input, index) => {
                    const value = input.value.toLowerCase();
                    const cell = row.cells[index];
                    if (cell && !cell.textContent.toLowerCase().includes(value)) {
                        isVisible = false;
                    }
                });
                row.style.display = isVisible ? '' : 'none';
            });
        }

        function paginateTable() {
    const rows = document.querySelectorAll('#dataTable tbody tr');
    const totalRows = rows.length;

    if (rowsPerPage === Infinity) {
        // Show all rows when "All" is selected
        rows.forEach(row => {
            row.style.display = '';
        });
        document.getElementById('prevPage').disabled = true; // Disable pagination
        document.getElementById('nextPage').disabled = true;
        return;
    }

    const start = (currentPage - 1) * rowsPerPage;
    const end = currentPage * rowsPerPage;

    rows.forEach((row, index) => {
        row.style.display = index >= start && index < end ? '' : 'none';
    });

    document.getElementById('prevPage').disabled = currentPage === 1;
    document.getElementById('nextPage').disabled = end >= totalRows;
}

        function changePage(direction) {
            currentPage += direction;
            paginateTable();
        }

        function paginateTable() {
    const rows = document.querySelectorAll('#dataTable tbody tr');
    const totalRows = rows.length;

    if (rowsPerPage === Infinity) {
        // Show all rows when "All" is selected
        rows.forEach(row => {
            row.style.display = '';
        });
        document.getElementById('prevPage').disabled = true; // Disable pagination
        document.getElementById('nextPage').disabled = true;
        return;
    }

    const start = (currentPage - 1) * rowsPerPage;
    const end = currentPage * rowsPerPage;

    rows.forEach((row, index) => {
        row.style.display = index >= start && index < end ? '' : 'none';
    });

    document.getElementById('prevPage').disabled = currentPage === 1;
    document.getElementById('nextPage').disabled = end >= totalRows;
}

        function downloadExcel() {
            let table = document.getElementById("dataTable");
            let wb = XLSX.utils.book_new();
            let ws = XLSX.utils.table_to_sheet(table);
            XLSX.utils.book_append_sheet(wb, ws, "Port Status");
            XLSX.writeFile(wb, "port_status.xlsx");
        }


        function downloadPDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            doc.text("Port Status Report", 10, 10);

            let table = document.getElementById("dataTable");
            let headers = [];
            let rows = [];

            // Extract headers
            table.querySelectorAll("thead th").forEach(th => headers.push(th.innerText));

            // Extract table rows
            table.querySelectorAll("tbody tr").forEach(tr => {
                let row = [];
                tr.querySelectorAll("td").forEach(td => row.push(td.innerText));
                rows.push(row);
            });

            // Add table to PDF
            doc.autoTable({
                head: [headers],
                body: rows,
                startY: 20
            });

            doc.save("port_status.pdf");
        }
    </script>
</body>

</html>

<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Deployment Sheet Master</title>

  <!-- DataTables CSS -->
  <!-- <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" /> -->
  <link rel="stylesheet" href="./css/Deployment.jquery.dataTables.min.css" />
  <!-- DataTables Buttons CSS -->
  <link rel="stylesheet" href="./css/Deployment.buttons.dataTables.min.css" />

   <!-- Scripts -->
  <script src="./js/Deployment.jquery-3.7.0.min.js"></script>
  <script src="./js/Deployment.1.13.6.jquery.dataTables.min.js"></script>
  <script src="./js/Deployment.2.4.1.dataTables.buttons.min.js"></script>
  <script src="./js/Deployment.2.4.1.buttons.html5.min.js"></script>
  <script src="./js/Deployment.2.4.1.buttons.print.min.js"></script>
  <script src="./js/Deployment.3.10.1.jszip.min.js"></script>
  <script src="./js/Deployment.0.2.7.pdfmake.min.js"></script>
  <script src="./js/Deployment.0.2.7.vfs_fonts.js"></script>
  <style>
    body {
      background-color: #121212;
      color: #eee;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 20px;
    }
    h1 {
      text-align: center;
      margin-bottom: 20px;
      font-weight: 700;
      color: #f0f0f0;
    }

    .table-actions {
      margin-bottom: 15px;
    }

    table.dataTable {
      width: 100% !important;
      color: #eee;
    }
    table.dataTable thead th {
      background-color: #1f1f1f;
      color: #eee;
      font-weight: 600;
      border-bottom: 2px solid #444;
    }
    table.dataTable tbody tr {
      background-color: #222;
      border-bottom: 1px solid #333;
    }
    table.dataTable tbody tr:hover {
      background-color: #333;
    }
    td, th {
      padding: 8px 10px;
      text-align: center;
      vertical-align: middle;
      white-space: nowrap;
    }

    .dt-buttons button, .custom-btn {
      background-color: #333;
      color: #eee;
      border: none;
      padding: 6px 12px;
      margin-right: 5px;
      cursor: pointer;
      border-radius: 4px;
      font-weight: 600;
    }
    .dt-buttons button:hover, .custom-btn:hover {
      background-color: #555;
    }

    #fileInput {
      display: none;
    }

    .dataTables_wrapper {
      width: 100%;
      overflow-x: auto;
    }
  </style>
</head>
<body>

  <h1>Deployment Sheet Master</h1>

  <div class="table-actions">
    <form id="uploadForm" enctype="multipart/form-data" method="post">
      <input type="file" id="fileInput" name="file" />
      <button type="button" class="custom-btn" id="submitFileBtn">Submit</button>
      <!-- <button type="button" class="custom-btn" id="sampleFormatBtn">Sample Format</button> -->
      <a href='<%=request.getContextPath() + "/XMLFile/Deployment_Sample_Format.xlsx"%>' class="custom-btn" download>Sample Format</a>
      
    </form>
  </div>

  <table id="deploymentTable" class="display nowrap" style="width:100%">
    <thead>
      <tr>
        <th>EXP URL</th>
        <th>EXP URL W.R.T SYS URL</th>
        <th>API_NAME</th>
        <th>SOURCE_ID</th>
        <th>Broker</th>
        <th>Broker EG</th>
        <th>New/Existing/NBC</th>
        <th>Hits in Production</th>
        <th>Failure(More than 50%)</th>
        <th>Success</th>
        <th>Changes Description</th>
        <th>Remarks</th>
        <th>Deployment Date Time</th>
      </tr>
    </thead>
    <tbody>
      <c:forEach var="row" items="${deploymentData}">
        <tr>
          <td>${row.EXP_URL}</td>
          <td>${row.SYS_URL}</td>
          <td>${row.API_NAME}</td>
          <td>${row.SOURCE_ID}</td>
          <td>${row.BROKER}</td>
          <td>${row.BROKER_EG}</td>
          <td>${row.STATUS}</td>
          <td>${row.HITS}</td>
          <td>${row.FAILURE}</td>
          <td>${row.SUCCESS}</td>
          <td>${row.CHANGES_DESC}</td>
          <td>${row.REMARKS}</td>
          <td>${row.DEPLOYMENT_DATE}</td>
        </tr>
      </c:forEach>
    </tbody>
  </table>

  <!-- Scripts -->
  <!-- <div class="">
      <button type="button" class="custom-btn" id="pushDataBtn">Push Data to Main Table</button>
   </div> -->
   <%-- <div style="margin-top: 20px; text-align: center;">
  <form id="pushForm" method="post" action="<%=request.getContextPath()%>/DeploymentSheetServlet">
    <input type="hidden" name="action" value="push" />
    <button type="submit" class="custom-btn">Push Data to Main Table</button>
  </form>
</div> --%>

<div style="margin-top: 20px; text-align: center;">
  <button type="button" class="custom-btn" id="pushDataBtn">Push Data to Main Table</button>
</div>

  <script>
    $(document).ready(function () {
      const table = $('#deploymentTable').DataTable({
        dom: 'Bfrtip',
        paging: true,
        scrollX: true,
        responsive: false,
        pageLength: 15,
        searching: true,
        ordering: true,
        order: [],
        lengthChange: false,
        buttons: [
          {
            extend: 'excelHtml5',
            text: 'Export Excel',
            exportOptions: { columns: ':visible' }
          },
          {
            extend: 'pdfHtml5',
            text: 'Export PDF',
            exportOptions: { columns: ':visible' },
            orientation: 'landscape',
            pageSize: 'A4'
          }
        ]
      });

      // File choose button
      $('#chooseFileBtn').on('click', function () {
        $('#fileInput').click();
      });

      // Submit file
      $('#submitFileBtn').on('click', function () {
        const file = $('#fileInput')[0].files[0];
        if (!file) {
          alert("Please choose a file first!");
          return;
        }
        const formData = new FormData();
        formData.append("file", file);
        formData.append("action", "upload");

        $.ajax({
          url: '<%=request.getContextPath()%>/DeploymentSheetServlet',
          type: "POST",
          data: formData,
          processData: false,
          contentType: false,
          success: function (res) {
            alert(res);
            /* location.reload(); */
			window.location.href='<%=request.getContextPath()%>/DeploymentSheetServlet';
          }
        });
      });

      <%-- // Push data button
      $('#pushDataBtn').on('click', function () {
        $.post("deployment", { action: "push" }, function (res) {
          alert(res);
          /* location.reload(); */
         window.location.href='<%=request.getContextPath()%>/DeploymentSheetServlet';
        });
      }); --%>

//Push data button
$('#pushDataBtn').on('click', function () {
    $.ajax({
        url: '<%=request.getContextPath()%>/DeploymentSheetServlet',
        type: "POST",
        data: { action: "push" },
        success: function (res) {
            alert(res);   // Show popup
            // Reload JSP to refresh table
            window.location.href = '<%=request.getContextPath()%>/DeploymentSheetServlet';
        },
        error: function () {
            alert("Error occurred while pushing data!");
        }
    });
});

      // Sample format (optional)
      $('#sampleFormatBtn').on('click', function () {
        alert("Download sample format!");
      });
    });
  </script>
</body>
</html>

<script>
(function () {
    'use strict';

    var CTX = '<%=ctx%>';
    var BASE_URL = CTX + '/ViewEISRegistrationDetailsActionNew';
    var currentFilter = 'all';

    /* ============================================================
       ⭐ THEME — Load saved preference immediately
       ============================================================ */
    (function initTheme() {
        var saved = localStorage.getItem('eis-theme') || 'light';
        document.documentElement.setAttribute('data-theme', saved);
    })();

    document.getElementById('themeToggle').addEventListener('click', function () {
        var current = document.documentElement.getAttribute('data-theme');
        var next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('eis-theme', next);
        toast('Switched to ' + next + ' mode', 'info');
    });

    /* ============================================================
       TOAST
       ============================================================ */
    var toastHost = document.getElementById('toastHost');
    function toast(msg, type) {
        var el = document.createElement('div');
        el.className = 'toast ' + (type || 'info');
        var icons = { success: '✓', error: '✕', info: 'ℹ' };
        el.innerHTML = '<div class="toast-icon">' + (icons[type] || icons.info) + '</div><span>' + msg + '</span>';
        toastHost.appendChild(el);
        setTimeout(function () {
            el.style.transition = 'all .3s';
            el.style.opacity = '0';
            el.style.transform = 'translateX(20px)';
            setTimeout(function () { el.remove(); }, 300);
        }, 3000);
    }
    window.eisToast = toast;

    /* ============================================================
       ⭐ FILTER SYSTEM — Click stat card to filter
       ============================================================ */
    window.applyFilter = function (filterType) {
        currentFilter = filterType;

        // Update stat card selected state
        document.querySelectorAll('.stat[data-filter]').forEach(function (s) {
            s.classList.toggle('selected', s.getAttribute('data-filter') === filterType);
        });

        // Apply filter to rows
        var rows = document.querySelectorAll('.emp-row');
        var visibleCount = 0;

        rows.forEach(function (row) {
            var status = row.getAttribute('data-status');
            var show = (filterType === 'all') || (status === filterType);
            row.classList.toggle('hidden', !show);
            if (show) visibleCount++;
        });

        // Update filter bar
        var filterBar   = document.getElementById('filterBar');
        var filterLabel = document.getElementById('filterLabel');
        var filterCount = document.getElementById('filterCount');

        if (filterType === 'all') {
            filterBar.classList.remove('show');
            // ⭐ Clean URL — no query params
            history.replaceState({}, '', BASE_URL);
        } else {
            filterBar.classList.add('show');
            filterLabel.textContent = filterType === 'active'
                ? 'Active Employees'
                : 'Inactive Employees';
            filterCount.textContent = '(' + visibleCount + ' results)';
            // ⭐ Update URL with filter param
            history.replaceState({}, '', BASE_URL + '?filter=' + filterType);
        }

        // Close any open detail if hidden
        if (filterType !== 'all') {
            var activeRow = document.querySelector('.emp-row.active');
            if (activeRow && activeRow.classList.contains('hidden')) {
                document.getElementById('detailContent').innerHTML =
                    '<div class="empty-detail">' +
                    '<svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>' +
                    '<h3>No employee selected</h3>' +
                    '<p>Select an employee from the list to view their full details</p>' +
                    '</div>';
                activeRow.classList.remove('active');
            }
        }
    };

    window.clearFilter = function () {
        applyFilter('all');
    };

    /* ============================================================
       ESCAPE
       ============================================================ */
    function esc(s) {
        if (s === null || s === undefined) return '';
        return String(s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function field(k, v, full, mono) {
        var empty = (v === null || v === undefined || v === '');
        var display = empty ? '—' : v;
        var cls = 'v' + (mono ? ' mono' : '') + (empty ? ' empty' : '');
        return '<div class="detail-field' + (full ? ' full' : '') + '">'
             +   '<div class="k">' + esc(k) + '</div>'
             +   '<div class="' + cls + '">' + esc(display) + '</div>'
             + '</div>';
    }

    window.openDocument = function (empId, docType) {
        if (!empId || !docType) return;
        var url = CTX + '/DocumentDownloadServlet'
                + '?empid=' + encodeURIComponent(empId)
                + '&type='  + encodeURIComponent(docType)
                + '&_t='    + Date.now();
        window.open(url, '_blank');
    };

    function docItem(label, hasFile, type, empId) {
        if (hasFile) {
            return '<a class="doc-item has" href="javascript:void(0);" '
                 +   'onclick="event.stopPropagation(); openDocument(\'' + esc(empId) + '\', \'' + type + '\');">'
                 +   '<div class="doc-icon">'
                 +     '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>'
                 +   '</div>'
                 +   '<div class="doc-meta">'
                 +     '<div class="doc-name">' + esc(label) + '</div>'
                 +     '<div class="doc-status">Click to view</div>'
                 +   '</div>'
                 + '</a>';
        } else {
            return '<div class="doc-item none">'
                 +   '<div class="doc-icon">'
                 +     '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
                 +   '</div>'
                 +   '<div class="doc-meta">'
                 +     '<div class="doc-name">' + esc(label) + '</div>'
                 +     '<div class="doc-status">Not uploaded</div>'
                 +   '</div>'
                 + '</div>';
        }
    }

    window.selectEmployee = function (rowEl, index) {
        document.querySelectorAll('.emp-row').forEach(function (r) { r.classList.remove('active'); });
        rowEl.classList.add('active');
        var data = window.EIS_DATA[index];
        if (!data) return;
        renderDetail(data);
        document.getElementById('detailPanel').classList.add('open');
    };

    window.closeDetail = function () {
        document.getElementById('detailPanel').classList.remove('open');
    };

    function renderDetail(d) {
        var html = '';
        html += '<div class="detail-head">';
        html +=   '<div class="detail-avatar ' + d.colorClass + '">';
        if (d.hasPhoto) {
            html += '<img src="' + CTX + '/DocumentDownloadServlet?empid=' + encodeURIComponent(d.empId)
                  + '&type=PHOTO&_t=' + Date.now()
                  + '" alt="" onerror="this.style.display=\'none\';this.parentNode.textContent=\''
                  + esc(d.initials) + '\';"/>';
        } else {
            html += esc(d.initials);
        }
        html +=   '</div>';
        html +=   '<div style="min-width:0;">';
        html +=     '<div class="detail-name">' + esc(d.fullName) + '</div>';
        html +=     '<div class="detail-meta">'
                  +   '<span class="id">#' + esc(d.empId) + '</span>'
                  +   '<span class="badge ' + (d.active ? 'active' : 'inactive') + '">'
                  +     (d.active ? 'Active' : 'Inactive')
                  +   '</span>'
                  + '</div>';
        html +=   '</div>';
        html += '</div>';

        html += '<div class="detail-body">';
        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title"><span class="dot"></span>Identity</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('Employee ID', d.empId, false, true);
        html +=     field('AD ID', d.adId, false, true);
        html +=     field('HID', d.hid, false, true);
        html +=     field('Asset ID', d.assetId, false, true);
        html +=   '</div>';
        html += '</div>';

        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title"><span class="dot"></span>Personal</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('First Name', d.firstName);
        html +=     field('Middle Name', d.middleName);
        html +=     field('Last Name', d.lastName);
        html +=     field('Gender', d.gender);
        html +=     field('Date of Birth', d.dob, false, true);
        html +=     field('Education', d.education);
        html +=   '</div>';
        html += '</div>';

        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title"><span class="dot"></span>Contact</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('Contact', d.contact, false, true);
        html +=     field('Emergency', d.emergency, false, true);
        html +=     field('TCS Mail', d.tcsMail, true);
        html +=     field('SBI Mail', d.sbiMail, true);
        html +=   '</div>';
        html += '</div>';

        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title"><span class="dot"></span>Address</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('State', d.state);
        html +=     field('City', d.city);
        html +=     field('Address', d.address, true);
        html +=   '</div>';
        html += '</div>';

        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title"><span class="dot"></span>Work</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('Team', d.team);
        html +=     field('Joining Date', d.joiningDate, false, true);
        html +=   '</div>';
        html += '</div>';

        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title"><span class="dot"></span>VPN / Laptop</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('VPN Host', d.vpnHost, false, true);
        html +=     field('Laptop Host', d.laptopHost, false, true);
        html +=     field('Remote Type', d.remoteType);
        html +=     field('MAC Address', d.mac, false, true);
        html +=     field('IP Address', d.ip, false, true);
        html +=   '</div>';
        html += '</div>';

        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title"><span class="dot"></span>Credentials</div>';
        html +=   '<div class="detail-grid">';
        html +=     field('Username', d.username, false, true);
        html +=     field('Password', d.password, false, true);
        html +=   '</div>';
        html += '</div>';

        html += '<div class="detail-section">';
        html +=   '<div class="detail-section-title"><span class="dot"></span>Documents</div>';
        html +=   '<div class="doc-list">';
        html +=     docItem('Photo', d.hasPhoto, 'PHOTO', d.empId);
        html +=     docItem('BGC Document', d.hasBgc, 'BGC', d.empId);
        html +=     docItem('Police Verification', d.hasPolice, 'POLICE', d.empId);
        html +=     docItem('CV', d.hasCv, 'CV', d.empId);
        html +=   '</div>';
        html += '</div>';

        html += '</div>';

        html += '<div class="detail-actions">';
        html +=   '<button type="button" class="btn btn-secondary" onclick="editRecord(\'' + esc(d.empId) + '\');">'
              +     '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>'
              +     'Edit'
              +   '</button>';
        html +=   '<button type="button" class="btn btn-danger" onclick="deleteRecord(\'' + esc(d.empId) + '\');">'
              +     '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>'
              +     'Delete'
              +   '</button>';
        html += '</div>';

        document.getElementById('detailContent').innerHTML = html;
    }

    window.editRecord = function (empId) {
        if (!empId) return;
        toast('Opening editor...', 'info');
        setTimeout(function () {
            window.location.href = CTX + '/jsp/EditProfileNew.jsp?action=edit&empid=' + encodeURIComponent(empId);
        }, 150);
    };

    window.deleteRecord = function (empId) {
        if (!empId) return;
        if (!confirm('Delete employee ' + empId + '?\nThis action cannot be undone.')) return;
        toast('Deleting ' + empId + '...', 'info');
        setTimeout(function () {
            window.location.href = BASE_URL + '?action=delete&empid=' + encodeURIComponent(empId);
        }, 150);
    };

    window.goToRegistration = function () {
        window.location.href = CTX + '/showregpage.action';
    };

    window.exportToExcel = function () {
        try {
            var elt = document.getElementById('exportTable');
            var wb = XLSX.utils.table_to_book(elt, { sheet: 'Employees' });
            XLSX.writeFile(wb, 'Employee_Registry_' + new Date().toISOString().slice(0,10) + '.xlsx');
            toast('Exported successfully', 'success');
        } catch (e) {
            toast('Export failed: ' + e.message, 'error');
        }
    };

    /* ============================================================
       SEARCH
       ============================================================ */
    document.getElementById('searchInput').addEventListener('input', function () {
        var q = this.value.trim().toLowerCase();
        document.querySelectorAll('.emp-row').forEach(function (r) {
            var hay = r.getAttribute('data-search') || '';
            var statusOk = true;
            if (currentFilter !== 'all') {
                statusOk = r.getAttribute('data-status') === currentFilter;
            }
            var searchOk = (q === '' || hay.indexOf(q) !== -1);
            r.classList.toggle('hidden', !(searchOk && statusOk));
        });
    });

    /* ============================================================
       INIT — Auto-select first visible row + restore filter from URL
       ============================================================ */
    document.addEventListener('DOMContentLoaded', function () {
        // Restore filter from URL if present
        var params = new URLSearchParams(window.location.search);
        var urlFilter = params.get('filter');
        if (urlFilter && ['active', 'inactive'].indexOf(urlFilter) !== -1) {
            applyFilter(urlFilter);
        }

        // Auto-select first visible row on desktop
        if (window.innerWidth > 1100) {
            var firstVisible = document.querySelector('.emp-row:not(.hidden)');
            if (firstVisible) firstVisible.click();
        }
    });

    /* ⭐ Clean URL on page unload / reload */
    window.addEventListener('beforeunload', function () {
        // Nothing — but the URL naturally resets on refresh because
        // the initial page load doesn't preserve ?filter= unless user shared it.
    });

})();
</script>

<%!
    private static String safe(String s) { return s != null ? s : ""; }

    private static String jsSafe(String s) {
        if (s == null) return "";
        return s.replace("\\", "\\\\")
                .replace("\"", "\\\"")
                .replace("\n", "\\n")
                .replace("\r", "\\r")
                .replace("<", "\\u003c")
                .replace(">", "\\u003e")
                .replace("&", "\\u0026");
    }
%>


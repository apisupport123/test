<%--
  ✅ BOOT SCRIPT — per-tab sidebar logic using window.name
  - window.name har tab me persist karta hai, new tab me empty hota hai
  - Original tab → panel OPEN
  - New tab (link click se) → panel CLOSED
--%>
<script>
(function(){
  try{
    // ============================================================
    // ✅ THEME: DEFAULT DARK
    // ============================================================
    var t = localStorage.getItem('eis-theme');
    if(!t){
      t = 'dark';
      localStorage.setItem('eis-theme', 'dark');
    }
    document.documentElement.setAttribute('data-theme', t);

    // ============================================================
    // ✅ SIDEBAR LOGIC — per-tab using window.name
    // ============================================================
    var tabName = window.name || '';

    if (tabName === 'eis-original-tab') {
      // ✅ Ye wahi original tab hai — panel OPEN rahe
      // Kuch mat karo — sidebar default open
    } else if (tabName === 'eis-sub-tab') {
      // ✅ Ye sub-tab hai (link click se khula) — panel CLOSED
      document.documentElement.classList.add('sb-collapsed');
    } else {
      // ✅ Fresh tab ya first load
      // Check karo: kya ye login ke turant baad ka pehla page hai?
      var freshLogin = sessionStorage.getItem('eis-fresh-login');

      if (freshLogin === '1') {
        // ✅ Login ke baad pehla page — panel OPEN
        sessionStorage.removeItem('eis-fresh-login');
        window.name = 'eis-original-tab';
        // kuch class add nahi — panel OPEN
      } else {
        // ✅ Koi aur naya tab (link click se) — panel CLOSED
        document.documentElement.classList.add('sb-collapsed');
        window.name = 'eis-sub-tab';
      }
    }
  }catch(e){
    // safe fallback — panel open
  }
})();
</script>


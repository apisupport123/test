@WebServlet("/EISRegistrationEditServletNew")
@MultipartConfig(
        maxFileSize = 1024 * 1024 * 10,     // 10 MB per file
        maxRequestSize = 1024 * 1024 * 50,  // 50 MB total
        fileSizeThreshold = 1024 * 1024     // 1 MB — switch to disk after this

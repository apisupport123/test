<%@ page import="java.sql.*, java.util.*, java.text.*" %>
<%@ page import="com.jdbc.DBUtilityAuto" %>
<%@ page pageEncoding="UTF-8" %>
<%
    // Parse start/end – default to previous hour
    String startParam = request.getParameter("start");
    String endParam = request.getParameter("end");
    String showQueries = request.getParameter("showQueries");
    
    java.util.Date startDate, endDate;
    
    if (startParam != null && !startParam.isEmpty() && endParam != null && !endParam.isEmpty()) {
        try {
            SimpleDateFormat iso = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm");
            startDate = iso.parse(startParam);
            endDate = iso.parse(endParam);
        } catch (Exception e) {
            Calendar defaultCal = Calendar.getInstance();
            defaultCal.set(Calendar.MINUTE, 0);
            defaultCal.set(Calendar.SECOND, 0);
            defaultCal.set(Calendar.MILLISECOND, 0);
            defaultCal.add(Calendar.HOUR_OF_DAY, -1);
            startDate = defaultCal.getTime();
            defaultCal.add(Calendar.HOUR_OF_DAY, 1);
            endDate = defaultCal.getTime();
        }
    } else {
        Calendar cal = Calendar.getInstance();
        cal.set(Calendar.MINUTE, 0);
        cal.set(Calendar.SECOND, 0);
        cal.set(Calendar.MILLISECOND, 0);
        cal.add(Calendar.HOUR_OF_DAY, -1);
        startDate = cal.getTime();
        cal.add(Calendar.HOUR_OF_DAY, 1);
        endDate = cal.getTime();
    }
    
    if (startDate == null || endDate == null) {
        Calendar defaultCal = Calendar.getInstance();
        defaultCal.set(Calendar.MINUTE, 0);
        defaultCal.set(Calendar.SECOND, 0);
        defaultCal.set(Calendar.MILLISECOND, 0);
        defaultCal.add(Calendar.HOUR_OF_DAY, -1);
        startDate = defaultCal.getTime();
        defaultCal.add(Calendar.HOUR_OF_DAY, 1);
        endDate = defaultCal.getTime();
    }

    SimpleDateFormat oracleFmt = new SimpleDateFormat("dd-MMM-yyyy HH:mm:ss");
    String fromStr = oracleFmt.format(startDate).toUpperCase();
    String toStr = oracleFmt.format(endDate).toUpperCase();
    
    SimpleDateFormat displayFmt = new SimpleDateFormat("dd-MMM-yyyy HH:mm");
    String rangeDisplay = displayFmt.format(startDate) + " to " + displayFmt.format(endDate);
    String startIso = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm").format(startDate);
    String endIso = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm").format(endDate);

    int selectedHour = startDate.getHours();

    Calendar partCal = Calendar.getInstance();
    partCal.setTime(startDate);
    String[] months = {"JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"};
    String partition = months[partCal.get(Calendar.MONTH)] + "_" + String.valueOf(partCal.get(Calendar.YEAR)).substring(2);

    String[] tables = {
        "EIS_TD_PERCENTAGE_HOURLY",
        "MAJOR_DOWNSTREAM_HOURLY",
        "CKYC_STATUS_HOURLY",
        "PAN_STATUS_HOURLY",
        "ACCOUNT_OPENING_HOURLY",
        "YONO_STATUS_HOURLY",
        "NON_YONO_STATUS_HOURLY",
        "NPCI_STATUS_HOURLY"
    };
    String[] displayNames = {
        "Overall EIS TD%",
        "Major Downstream",
        "CKYC Status",
        "PAN Status",
        "Account Opening",
        "YONO",
        "Non-YONO",
        "NPCI"
    };
    String[] sourceDB = {
        "IIB", "IIB", "IIB", "IIB", "IIB", "IIB", "IIB", "SIDB"
    };

    Map<String, List<Map<String, Object>>> tableData = new LinkedHashMap<>();
    try (Connection conn = DBUtilityAuto.getReportDBConnection()) {
        for (String tbl : tables) {
            String sql = "SELECT * FROM " + tbl + " WHERE START_TIME >= ? AND START_TIME < ? ORDER BY START_TIME";
            List<Map<String, Object>> rows = new ArrayList<>();
            try (PreparedStatement ps = conn.prepareStatement(sql)) {
                ps.setTimestamp(1, new java.sql.Timestamp(startDate.getTime()));
                ps.setTimestamp(2, new java.sql.Timestamp(endDate.getTime()));
                try (ResultSet rs = ps.executeQuery()) {
                    ResultSetMetaData meta = rs.getMetaData();
                    int colCount = meta.getColumnCount();
                    while (rs.next()) {
                        Map<String, Object> row = new LinkedHashMap<>();
                        for (int i = 1; i <= colCount; i++) {
                            row.put(meta.getColumnName(i).toUpperCase(), rs.getObject(i));
                        }
                        rows.add(row);
                    }
                }
            } catch (SQLException e) {
                System.err.println("Error fetching data for table: " + tbl);
                e.printStackTrace();
            }
            tableData.put(tbl, rows);
        }
    } catch (Exception e) {
        e.printStackTrace();
    }

    Set<String> hiddenCols = new HashSet<>(Arrays.asList("ID", "START_TIME", "END_TIME", "QUERY_DURATION_SEC"));

    String queriesDisplay = "";
    if ("true".equals(showQueries)) {
        StringBuilder sb = new StringBuilder();
        String part = " PARTITION(" + partition + ")";
        String fromDate = fromStr;
        String toDate = toStr;

        sb.append("-- Query 0: Overall EIS TD%\n");
        sb.append("SELECT /*+ PARALLEL(2) */ COUNT(*) AS TOTAL_COUNT,\n");
        sb.append("COUNT(CASE WHEN ERROR_CODE IN ('SI002','SI014','SI001','SI051','SI007','SI569','SI570') THEN 1 END) AS TD_COUNT,\n");
        sb.append("ROUND((COUNT(CASE WHEN ERROR_CODE IN ('SI002','SI014','SI001','SI051','SI007','SI569','SI570') THEN 1 END) * 100.0) / NULLIF(COUNT(*), 0), 2) AS TD_PERCENT\n");
        sb.append("FROM EISAPP.api_log" + part + "\n");
        sb.append("WHERE request_date_time BETWEEN TO_DATE('" + fromDate + "', 'DD-MON-YYYY HH24:MI:SS')\n");
        sb.append("AND TO_DATE('" + toDate + "', 'DD-MON-YYYY HH24:MI:SS');\n\n");

        sb.append("-- Query 1: Major Downstream\n");
        sb.append("SELECT /*+ PARALLEL(2) */ txn_endpoint, COUNT(*) AS TOTAL_COUNT,\n");
        sb.append("COUNT(CASE WHEN (ERROR_CODE IS NULL OR NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') OR error_code IN ('00014','70007','00017','CK001')) THEN 1 END) AS SUCCESS_COUNT,\n");
        sb.append("ROUND((COUNT(CASE WHEN (ERROR_CODE IS NULL OR NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') OR error_code IN ('00014','70007','00017','CK001')) THEN 1 END) * 100.0) / NULLIF(COUNT(*), 0), 2) AS SUCCESS_PERCENT,\n");
        sb.append("COUNT(CASE WHEN SUBSTR(error_code,3,3) IN ('001','002','007','051','014','111') AND error_code <> '00014' THEN 1 END) AS TD_COUNT,\n");
        sb.append("ROUND((COUNT(CASE WHEN SUBSTR(error_code,3,3) IN ('001','002','007','051','014','111') AND error_code <> '00014' THEN 1 END) * 100.0) / NULLIF(COUNT(*), 0), 2) AS TD_PERCENT\n");
        sb.append("FROM eisapp.BACKEND_LOG" + part + "\n");
        sb.append("WHERE (txn_endpoint IN ('DCMS','Vault','NSDL','HRMS') AND request_date_time BETWEEN TO_DATE('" + fromDate + "', 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE('" + toDate + "', 'DD-MON-YYYY HH24:MI:SS'))\n");
        sb.append("OR (txn_endpoint = 'ATM' AND creation_date_time BETWEEN TO_DATE('" + fromDate + "', 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE('" + toDate + "', 'DD-MON-YYYY HH24:MI:SS'))\n");
        sb.append("GROUP BY txn_endpoint ORDER BY txn_endpoint;\n\n");

        sb.append("-- Query 2: CKYC Status\n");
        sb.append("SELECT /*+ PARALLEL(2) */ COUNT(*) AS TOTAL_COUNT,\n");
        sb.append("COUNT(CASE WHEN ERROR_CODE IS NULL OR NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') OR error_code IN ('00014','70007','00017','CK001') THEN 1 END) AS SUCCESS_COUNT,\n");
        sb.append("ROUND((COUNT(CASE WHEN ERROR_CODE IS NULL OR NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') OR error_code IN ('00014','70007','00017','CK001') THEN 1 END) * 100.0) / NULLIF(COUNT(*), 0), 2) AS SUCCESS_PERCENTAGE\n");
        sb.append("FROM eisapp.BACKEND_LOG" + part + "\n");
        sb.append("WHERE txn_endpoint='CKYC' AND request_date_time BETWEEN TO_DATE('" + fromDate + "', 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE('" + toDate + "', 'DD-MON-YYYY HH24:MI:SS');\n\n");

        sb.append("-- Query 3: PAN Status\n");
        sb.append("SELECT /*+ PARALLEL(2) */ COUNT(*) AS TOTAL_COUNT,\n");
        sb.append("COUNT(CASE WHEN error_code IS NULL AND response_status = '0' THEN 1 END) AS SUCCESS_COUNT,\n");
        sb.append("COUNT(CASE WHEN (NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') OR error_code IN ('00014','70007')) AND RESPONSE_STATUS NOT IN ('0','SUCCESS') THEN 1 END) AS OTHER_COUNT,\n");
        sb.append("ROUND((COUNT(CASE WHEN error_code IS NULL AND response_status = '0' THEN 1 END) + COUNT(CASE WHEN (NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') OR error_code IN ('00014','70007')) AND RESPONSE_STATUS NOT IN ('0','SUCCESS') THEN 1 END)) * 100.0 / NULLIF(COUNT(*), 0), 2) AS PAN_SUCCESS\n");
        sb.append("FROM EISAPP.api_log" + part + "\n");
        sb.append("WHERE url IN ('http://eispri.sbi.co.in:3002/dedupOn_bth/PANMobile/customers', 'http://eispri.sbi.co.in:3002/dedupOn/PANMobile/customers', 'http://eispri.sbi.co.in:3016/misc/PAN/Enquiry/details/misc', 'http://eispri.sbi.co.in:3013/misc/PAN/Details/misc', 'http://eispri.sbi.co.in:3013/misc/PAN_bth/Details/misc', 'http://eispri.sbi.co.in:3002/dedupOn_th/PANMobile/customers', 'http://eispri.sbi.co.in:3002/dedupOn_bth/PANMobileCheck/customers', 'http://eispri.sbi.co.in:3013/misc/PAN_th/Details/misc')\n");
        sb.append("AND request_date_time BETWEEN TO_DATE('" + fromDate + "', 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE('" + toDate + "', 'DD-MON-YYYY HH24:MI:SS');\n\n");

        sb.append("-- Query 4: Account Opening\n");
        sb.append("WITH urls AS (SELECT 'http://eispri.sbi.co.in:3002/personal/cifCreation/customers' AS url FROM DUAL UNION ALL SELECT 'http://eispri.sbi.co.in:3002/personal_th/cifCreation/customers' FROM DUAL UNION ALL SELECT 'http://eispri.sbi.co.in:3002/ckyc/Creation/customers' FROM DUAL UNION ALL SELECT 'http://eispri.sbi.co.in:3002/ckyc_th/Creation/customers' FROM DUAL UNION ALL SELECT 'http://eispri.sbi.co.in:3011/amlockName/acknowledgeDetails/misc' FROM DUAL UNION ALL SELECT 'http://eispri.sbi.co.in:3011/amlockName_th/acknowledgeDetails/misc' FROM DUAL UNION ALL SELECT 'http://eispri.sbi.co.in:3002/depositAccounts_th/opening/customers' FROM DUAL UNION ALL SELECT 'http://eispri.sbi.co.in:3002/depositAccounts/opening/customers' FROM DUAL UNION ALL SELECT 'http://eispri.sbi.co.in:3001/upload/signature/misc' FROM DUAL UNION ALL SELECT 'http://eispri.sbi.co.in:3001/upload_th/signature/misc' FROM DUAL UNION ALL SELECT 'http://eispri.sbi.co.in:3001/nominee/create/accounts' FROM DUAL UNION ALL SELECT 'http://eispri.sbi.co.in:3001/nominee_th/create/accounts' FROM DUAL)\n");
        sb.append("SELECT COUNT(*) AS TOTAL_COUNT,\n");
        sb.append("COUNT(CASE WHEN (SUBSTR(error_code,3,3) IN ('002','014') OR error_code IN ('SI001','SI007','SI051','SI569','SI570')) AND error_code <> '00014' THEN 1 END) AS TD_COUNT,\n");
        sb.append("ROUND(COUNT(CASE WHEN (SUBSTR(error_code,3,3) IN ('002','014') OR error_code IN ('SI001','SI007','SI051','SI569','SI570')) AND error_code <> '00014' THEN 1 END) * 100.0 / NULLIF(COUNT(*), 0), 2) AS TD_PERCENT,\n");
        sb.append("COUNT(CASE WHEN (NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') OR error_code IN ('00014','70007')) AND RESPONSE_STATUS NOT IN ('0','SUCCESS') THEN 1 END) AS BD_COUNT,\n");
        sb.append("ROUND(COUNT(CASE WHEN (NVL(SUBSTR(error_code,3,3),'A') NOT IN ('001','002','007','051','014') OR error_code IN ('00014','70007')) AND RESPONSE_STATUS NOT IN ('0','SUCCESS') THEN 1 END) * 100.0 / NULLIF(COUNT(*), 0), 2) AS BD_PERCENT\n");
        sb.append("FROM eisapp.api_log" + part + "\n");
        sb.append("WHERE url IN (SELECT url FROM urls) AND request_date_time BETWEEN TO_DATE('" + fromDate + "', 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE('" + toDate + "', 'DD-MON-YYYY HH24:MI:SS');\n\n");

        sb.append("-- Query 5: YONO\n");
        sb.append("SELECT /*+ PARALLEL(2) */ COUNT(*) AS TOTAL_COUNT,\n");
        sb.append("COUNT(CASE WHEN (error_code IS NULL AND response_status IN ('0','SUCCESS')) OR SUBSTR(error_code,3,3) NOT IN ('001','002','007','051','014') THEN 1 END) AS SUCCESS_COUNT,\n");
        sb.append("ROUND(COUNT(CASE WHEN (error_code IS NULL AND response_status IN ('0','SUCCESS')) OR SUBSTR(error_code,3,3) NOT IN ('001','002','007','051','014') THEN 1 END) * 100.0 / NULLIF(COUNT(*), 0), 2) AS SUCCESS_PERCENT,\n");
        sb.append("COUNT(CASE WHEN error_code IS NOT NULL AND response_status NOT IN ('0','SUCCESS') THEN 1 END) AS FAILURE_COUNT\n");
        sb.append("FROM eisapp.api_log" + part + "\n");
        sb.append("WHERE source_id IN ('YA','YB') AND request_date_time BETWEEN TO_DATE('" + fromDate + "', 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE('" + toDate + "', 'DD-MON-YYYY HH24:MI:SS');\n\n");

        sb.append("-- Query 6: Non-YONO\n");
        sb.append("SELECT /*+ PARALLEL(2) */ COUNT(*) AS TOTAL_COUNT,\n");
        sb.append("COUNT(CASE WHEN (error_code IS NULL AND response_status IN ('0','SUCCESS')) OR SUBSTR(error_code,3,3) NOT IN ('001','002','007','051','014') THEN 1 END) AS SUCCESS_COUNT,\n");
        sb.append("ROUND(COUNT(CASE WHEN (error_code IS NULL AND response_status IN ('0','SUCCESS')) OR SUBSTR(error_code,3,3) NOT IN ('001','002','007','051','014') THEN 1 END) * 100.0 / NULLIF(COUNT(*), 0), 2) AS SUCCESS_PERCENT,\n");
        sb.append("COUNT(CASE WHEN error_code IS NOT NULL AND response_status NOT IN ('0','SUCCESS') THEN 1 END) AS FAILURE_COUNT\n");
        sb.append("FROM eisapp.api_log" + part + "\n");
        sb.append("WHERE source_id NOT IN ('YA','YB') AND request_date_time BETWEEN TO_DATE('" + fromDate + "', 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE('" + toDate + "', 'DD-MON-YYYY HH24:MI:SS');\n\n");

        sb.append("-- Query 7: NPCI\n");
        sb.append("SELECT /*+ PARALLEL(2) */ COUNT(*) AS TOTAL_COUNT,\n");
        sb.append("COUNT(CASE WHEN ERROR_CODE IS NULL OR error_code NOT IN ('SI207','SI392','SI001') THEN 1 END) AS SUCCESS_COUNT,\n");
        sb.append("ROUND(COUNT(CASE WHEN ERROR_CODE IS NULL OR error_code NOT IN ('SI207','SI392','SI001') THEN 1 END) * 100.0 / NULLIF(COUNT(*), 0), 2) AS SUCCESS_PERCENT,\n");
        sb.append("COUNT(CASE WHEN error_code IN ('SI207','SI392','SI001') THEN 1 END) AS TD_COUNT,\n");
        sb.append("COUNT(CASE WHEN error_code IN ('SI207','SI392') THEN 1 END) AS SPECIFIC_TD_COUNT,\n");
        sb.append("ROUND(COUNT(CASE WHEN error_code IN ('SI207','SI392') THEN 1 END) * 100.0 / NULLIF(COUNT(*), 0), 2) AS TD_PERCENT\n");
        sb.append("FROM SBISI.EKYC_log\n");
        sb.append("WHERE REQ_DATE_TIME BETWEEN TO_DATE('" + fromDate + "', 'DD-MON-YYYY HH24:MI:SS') AND TO_DATE('" + toDate + "', 'DD-MON-YYYY HH24:MI:SS');\n");

        queriesDisplay = sb.toString();
    }
    
    System.out.println("Stat Query:- "+ queriesDisplay);
%>

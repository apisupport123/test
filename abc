                    <div class="field">
                        <label class="field-label">VPN Hostname</label>
                        <input class="field-input" type="text" name="m_strvpnhostname"
                               value="<%=emp.getM_strVPN_Hostname() != null ? emp.getM_strVPN_Hostname() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">Laptop Hostname</label>
                        <input class="field-input" type="text" name="m_strlaptophostname"
                               value="<%=emp.getM_strLaptop_Hostname() != null ? emp.getM_strLaptop_Hostname() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">Remote Type</label>
                        <select class="field-select" name="m_strremotetype">
                            <option value="NONE" <%="NONE".equalsIgnoreCase(emp.getM_strRemote_Type()) ? "selected" : ""%>>NONE</option>
                            <option value="VPN" <%="VPN".equalsIgnoreCase(emp.getM_strRemote_Type()) ? "selected" : ""%>>VPN</option>
                            <option value="VDI" <%="VDI".equalsIgnoreCase(emp.getM_strRemote_Type()) ? "selected" : ""%>>VDI</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="field-label">MAC Address</label>
                        <input class="field-input" type="text" name="m_strvpnmacaddress"
                               value="<%=emp.getM_strVPN_VDI_MAC_Address() != null ? emp.getM_strVPN_VDI_MAC_Address() : ""%>"/>
                    </div>
                    <div class="field span-2">
                        <label class="field-label">IP Address</label>
                        <input class="field-input" type="text" name="m_strvpnipaddress"
                               value="<%=emp.getM_strVPN_VDI_IP_Address() != null ? emp.getM_strVPN_VDI_IP_Address() : ""%>"/>
                    </div>
                </div>
            </section>

            <!-- SECTION 06 — CREDENTIALS -->
            <section class="section" id="s6">
                <div class="section-head">
                    <span class="section-num">06</span>
                    <span class="section-title">Credentials</span>
                    <span class="section-line"></span>
                </div>
                <div class="fields">
                    <div class="field">
                        <label class="field-label">Username</label>
                        <input class="field-input" type="text" name="m_strUserName"
                               value="<%=emp.getM_strUserName() != null ? emp.getM_strUserName() : ""%>"/>
                    </div>
                    <div class="field">
                        <label class="field-label">Password</label>
                        <input class="field-input" type="text" name="m_strPassword"
                               value="<%=emp.getM_strPassword() != null ? emp.getM_strPassword() : ""%>"/>
                    </div>
                </div>
            </section>

            <!-- SECTION 07 — DOCUMENTS -->
            <section class="section" id="s7">
                <div class="section-head">
                    <span class="section-num">07</span>
                    <span class="section-title">Replace Documents</span>
                    <span class="section-line"></span>
                </div>
                <div class="fields">
                    <div class="field">
                        <label class="field-label">BGC Document</label>
                        <label class="file-drop" id="drop-BGC">
                            <input type="file" name="m_strtheBgcfile" onchange="onFileChange(this, 'BGC');"/>
                            <span class="file-label">upload_bgc_file...</span>
                        </label>
                    </div>
                    <div class="field">
                        <label class="field-label">Police Verification</label>
                        <label class="file-drop" id="drop-POLICE">
                            <input type="file" name="m_strthePoliceverificationfile" onchange="onFileChange(this, 'POLICE');"/>
                            <span class="file-label">upload_police_file...</span>
                        </label>
                    </div>
                    <div class="field">
                        <label class="field-label">CV Document</label>
                        <label class="file-drop" id="drop-CV">
                            <input type="file" name="m_strtheCvfile" onchange="onFileChange(this, 'CV');"/>
                            <span class="file-label">upload_cv_file...</span>
                        </label>
                    </div>
                </div>
                <p style="font-family:var(--mono);font-size:11px;color:var(--text-4);margin-top:16px;letter-spacing:.5px;">
                    // uploading a new file replaces the existing one. leave empty to keep current.
                </p>
            </section>

        </main>
    </div>

    <!-- ============================================================
         COMMIT BAR
         ============================================================ -->
    <div class="commit-bar">
        <div class="commit-info">
            <span class="dot"></span>
            <span>unsaved_changes</span>
            <span>·</span>
            <span id="commitHint">press Ctrl+S to save</span>
        </div>
        <div class="commit-actions">
            <a href="<%=ctx%>/ViewEISRegistrationDetailsActionNew" class="btn ghost">
                Discard
            </a>
            <button type="button" class="btn primary" onclick="submitEdit();">
                💾 Commit Changes
            </button>
        </div>
    </div>

    </form>

<% } %>

</div>

<div class="toast-host" id="toastHost"></div>

<script>
(function () {
    'use strict';
    var CTX = '<%=ctx%>';
    var EMP_ID = '<%= emp != null ? emp.getM_strEmployee_ID() : "" %>';

    /* Toast */
    var toastHost = document.getElementById('toastHost');
    function toast(msg, type) {
        var el = document.createElement('div');
        el.className = 'toast ' + (type || 'info');
        var prefix = { success: '[ ok ]', error: '[ err ]', info: '[ info ]' };
        el.innerHTML = '<span class="prefix">' + (prefix[type] || prefix.info) + '</span><span>' + msg + '</span>';
        toastHost.appendChild(el);
        setTimeout(function () {
            el.style.transition = 'all .25s';
            el.style.opacity = '0';
            el.style.transform = 'translateX(20px)';
            setTimeout(function () { el.remove(); }, 250);
        }, 3000);
    }

    /* Section navigation */
    window.scrollToSection = function (id, el) {
        document.querySelectorAll('.nav-item').forEach(function (n) { n.classList.remove('active'); });
        el.classList.add('active');
        var section = document.getElementById(id);
        if (section) section.scrollIntoView({behavior: 'smooth', block: 'start'});
    };

    /* Photo preview */
    window.previewPhoto = function (input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('profilePhoto').src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
            toast('New photo selected', 'info');
        }
    };

    /* File field */
    window.onFileChange = function (input, type) {
        var drop = document.getElementById('drop-' + type);
        var label = drop.querySelector('.file-label');
        if (input.files && input.files[0]) {
            var name = input.files[0].name;
            var sizeKb = Math.round(input.files[0].size / 1024);
            label.textContent = name + ' (' + sizeKb + 'KB)';
            drop.classList.add('has-file');
            toast(type + ' file staged', 'info');
        } else {
            label.textContent = 'upload_' + type.toLowerCase() + '_file...';
            drop.classList.remove('has-file');
        }
    };

    /* Open document */
    window.openDocument = function (empid, docType) {
        if (!empid || !docType) return;
        var url = CTX + '/DocumentDownloadServlet'
                + '?empid=' + encodeURIComponent(empid)
                + '&type=' + encodeURIComponent(docType)
                + '&_t=' + Date.now();
        window.open(url, '_blank');
    };

    /* Submit */
    window.submitEdit = function () {
        var form = document.getElementById('editForm');
        if (!form) { toast('form_not_found', 'error'); return; }

        var checks = [
            ['m_strfirstName', 'first_name'],
            ['m_strlastName', 'last_name'],
            ['m_strUserName', 'username'],
            ['m_strPassword', 'password']
        ];
        for (var i = 0; i < checks.length; i++) {
            var el = document.getElementsByName(checks[i][0])[0];
            if (el && !el.value.trim()) {
                toast('missing_field: ' + checks[i][1], 'error');
                el.focus();
                el.scrollIntoView({behavior: 'smooth', block: 'center'});
                return;
            }
        }

        form.action = CTX + '/EISRegistrationEditServletNew?action=edit&empid=' + encodeURIComponent(EMP_ID);
        form.submit();
    };

    /* Ctrl+S to submit */
    document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
            e.preventDefault();
            submitEdit();
        }
    });

    /* IntersectionObserver for nav highlight */
    var sections = ['s1','s2','s3','s4','s5','s6','s7'];
    var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
            if (entry.isIntersecting) {
                var id = entry.target.id;
                var idx = sections.indexOf(id);
                if (idx >= 0) {
                    var items = document.querySelectorAll('.nav-item');
                    items.forEach(function (n, i) {
                        n.classList.toggle('active', i === idx);
                    });
                }
            }
        });
    }, { rootMargin: '-30% 0px -60% 0px' });

    sections.forEach(function (id) {
        var el = document.getElementById(id);
        if (el) observer.observe(el);
    });

})();
</script>

</body>
</html>

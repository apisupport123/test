        font-weight: 800;
        color: #e74c3c;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    #alertBox .head h3 i { font-size: 22px; }
    #alertBox .head .close-btn {
        background: none;
        border: none;
        color: #4a6a8a;
        font-size: 22px;
        cursor: pointer;
        transition: 0.2s;
        padding: 0 4px;
        line-height: 1;
    }
    #alertBox .head .close-btn:hover { color: #fff; transform: rotate(90deg); }
    
    #alertBox .body-text {
        background: rgba(0,0,0,0.25);
        border-radius: 8px;
        padding: 12px 14px;
        margin: 6px 0 14px 0;
        border-left: 3px solid #4f9cf7;
        font-size: 12px;
        line-height: 1.9;
        color: #b0c8e0;
        max-height: 150px;
        overflow-y: auto;
    }
    #alertBox .body-text b { color: #ffffff; }
    #alertBox .body-text .highlight-td { color: #e74c3c; font-weight: 700; }
    #alertBox .body-text .highlight-bd { color: #f39c12; font-weight: 700; }
    #alertBox .body-text .highlight-mixed { color: #9b59b6; font-weight: 700; }
    
    #alertBox .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }
    #alertBox .field { margin-bottom: 4px; }
    #alertBox .field label {
        display: block;
        font-size: 8px;
        font-weight: 700;
        color: #4a6a8a;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 2px;
    }
    #alertBox .field select, #alertBox .field textarea {
        width: 100%;
        background: rgba(0,0,0,0.35);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 6px;
        padding: 6px 10px;
        color: #ffffff;
        font-size: 12px;
        font-family: 'Inter', sans-serif;
        transition: 0.2s;
    }
    #alertBox .field select:focus, #alertBox .field textarea:focus {
        outline: none;
        border-color: #4f9cf7;
        box-shadow: 0 0 0 3px rgba(79,156,247,0.04);
    }
    #alertBox .field textarea { min-height: 36px; resize: vertical; }
    #alertBox .field.full { grid-column: 1 / -1; }
    
    .modal-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        margin-top: 12px;
        flex-wrap: wrap;
    }
    .modal-actions .btn-m {
        padding: 6px 20px;
        border-radius: 40px;
        font-weight: 700;
        font-size: 10px;
        border: none;
        cursor: pointer;
        transition: 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-family: 'Inter', sans-serif;
    }
    .modal-actions .btn-m-primary {
        background: linear-gradient(135deg, #4f9cf7, #7c3aed);
        color: #fff;
        box-shadow: 0 4px 15px rgba(79,156,247,0.15);
    }
    .modal-actions .btn-m-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 25px rgba(79,156,247,0.2); }
    .modal-actions .btn-m-danger { background: linear-gradient(135deg, #e74c3c, #c0392b); color: #fff; }
    .modal-actions .btn-m-secondary {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.04);
        color: #6a8aaa;
    }
    .modal-actions .btn-m-secondary:hover { background: rgba(255,255,255,0.04); }
    
    /* RESPONSIVE */
    @media (max-width: 1400px) { 
        .grid-main { grid-template-columns: repeat(4, 1fr); } 
        .tile-grid { grid-template-columns: repeat(4, 1fr); }
    }
    @media (max-width: 1100px) { 
        .grid-main { grid-template-columns: repeat(3, 1fr); } 
        .tile-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 768px) { 
        .grid-main { grid-template-columns: repeat(2, 1fr); } 
        .tile-grid { grid-template-columns: repeat(2, 1fr); }
        .top-bar { flex-wrap: wrap; height: auto; }
    }
    
    ::-webkit-scrollbar { width: 2px; }
    ::-webkit-scrollbar-thumb { background: #2a3a50; border-radius: 10px; }
</style>
</head>
<body>

<!-- LOADER -->
<div id="loaderWrapper">
    <div class="loader-ring"></div>
    <div class="loader-text">Initializing <span>EIS Command</span></div>
</div>

<!-- BACKGROUND -->
<div class="bg-layer"></div>
<div class="bg-grid"></div>

<!-- WRAPPER -->
<div class="wrapper">

    <!-- TOP BAR -->
    <div class="top-bar">
        <div class="brand">
            <div class="logo"><i class="fas fa-shield-halved"></i></div>
            <div>
                <div class="name">EIS COMMAND</div>
                <div class="sub">Service Monitoring Center</div>
            </div>
        </div>
        <div class="top-actions">
            <div class="live-badge"><span class="dot"></span> LIVE</div>
            <span class="timer-glass" id="ten-countdown">5:00</span>
            
            <!-- SHORTCUT LINKS -->
            <div class="shortcut-links">
                <a href="<%=request.getContextPath() %>/jsp/ServiceWiseFailure.jsp" class="shortcut-link sw" target="_blank" title="View ServiceWise Failures">
                    <i class="fas fa-chart-line"></i> ServiceWise
                </a>
                <span class="shortcut-divider"></span>
                <a href="<%=request.getContextPath() %>/jsp/100PercentFailure.jsp" class="shortcut-link hundred" target="_blank" title="View 100% Failures">
                    <i class="fas fa-percent"></i> 100% Failure
                </a>
            </div>
            
            <button class="btn-glass btn-primary-glass" onclick="window.open('<%=request.getContextPath() %>/jsp/DisplayServiceWiseFailure.jsp','_blank')">
                <i class="fas fa-list"></i> SW
            </button>
            <button class="btn-glass btn-ghost-glass" onclick="window.open('<%=request.getContextPath() %>/jsp/DisplayTodayServiceWiseFailure.jsp','_blank')">
                <i class="fas fa-check-circle"></i> <span class="badge-count-glass"><%= swClosed %></span>
            </button>
            <button class="btn-glass btn-primary-glass" onclick="window.open('<%=request.getContextPath() %>/jsp/DisplayHundredPercentFailure.jsp','_blank')">
                <i class="fas fa-percent"></i> 100%
            </button>
            <button class="btn-glass btn-ghost-glass" onclick="window.open('<%=request.getContextPath() %>/jsp/DisplayTodayHundredPercentFailure.jsp','_blank')">
                <i class="fas fa-check-circle"></i> <span class="badge-count-glass"><%= hundredClosed %></span>
            </button>
        </div>
    </div>

    <!-- TICKER -->
    <div class="ticker-bar">
        <div class="ticker-wrap">
            <div class="ticker-text">
                <span>● <span class="hl">MONITORING:</span> ServiceWise (TD &gt; 1%) + <span class="hl2">100% Failure</span></span>
                <span>● <span class="hl">LEGEND:</span> <span style="color:#e74c3c;">● TD</span> <span style="color:#f39c12;">● BD</span> <span style="color:#9b59b6;">● Mixed</span> <span style="color:#2ecc71;">● Healthy</span></span>
                <span>● <span class="hl">REFRESH:</span> Every 5 minutes</span>
                <span>● <span class="hl">CLICK:</span> Any tile for detailed alert</span>
                <span>● <span class="hl">SHORTCUT:</span> ServiceWise · 100% Failure</span>
            </div>
        </div>
    </div>

    <!-- INFO BAR -->
    <div class="info-bar">
        <div class="legend">
            <span class="item"><span class="swatch sw-td"></span> TD</span>
            <span class="item"><span class="swatch sw-bd"></span> BD</span>
            <span class="item"><span class="swatch sw-mixed"></span> Mixed</span>
            <span class="item"><span class="swatch sw-health"></span> Healthy</span>
        </div>
        <div class="timestamp-display">
            <i class="fas fa-clock"></i> Last Update: <%= lastUpdate %>
        </div>
    </div>

    <!-- MAIN GRID - 5 CARDS -->
    <div class="grid-main">

        <!-- ============================================================ -->
        <!-- CARD 1: ServiceWise - GEN-5 -->
        <!-- ============================================================ -->
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="title"><i class="fas fa-server"></i> GEN-5</span>
                <span class="badge-count" id="swGen5Count">0</span>
            </div>
            <div class="tile-grid" id="sw-gen5">
                <%
                    List<Double> swGen5Per = new ArrayList<>();
                    List<String> swGen5Name = new ArrayList<>();
                    List<String> swGen5Source = new ArrayList<>();
                    List<String> swGen5Error = new ArrayList<>();
                    List<Integer> swGen5Hits = new ArrayList<>();
                    List<Integer> swGen5Td = new ArrayList<>();
                    List<String> swGen5Time = new ArrayList<>();
                    List<Integer> swGen5Si = new ArrayList<>();
                    
                    try {
                        String q = "SELECT * FROM(SELECT api_name,source_id, error_code,SUM(total_hits) AS total_hits,SUM(success) AS success,issue_time, SUM(td) AS td,round(AVG(td_per), 2) AS td_per, SUM(SI_EEROR) AS SI_EEROR FROM gen5_servicewise_fail temp WHERE TRIM(concat(temp.api_name, temp.source_id)) NOT IN (SELECT TRIM(concat(api_name, source_id) || error_description) FROM vaild_bd_master) AND trim(temp.error_code ) not in (select DISTINCT ERRCODE FROM cbs_err_map WHERE substr(errcode,3,3) NOT in ('002','014') OR errcode in ('SI001','SI007','SI051','SI569','SI570')) AND substr(api_name, 1, 3) NOT IN 'gen' AND insert_time >= sysdate - INTERVAL '10' MINUTE AND api_name NOT IN (SELECT service_name FROM service_temporary_pause_master WHERE service_name IS NOT NULL) GROUP BY api_name, source_id, error_code, issue_time ORDER BY 2 DESC) temp WHERE issue_time = (SELECT MAX(issue_time) FROM gen5_servicewise_fail temp_in WHERE temp_in.api_name = temp.api_name GROUP BY api_name)";
                        ResultSet rs = con.createStatement().executeQuery(q);
                        while(rs.next()) {
                            if(rs.getDouble("TD") >= 50) {
                                swGen5Per.add(rs.getDouble("TD_PER"));
                                swGen5Name.add(nvl(rs.getString("API_NAME"), "N/A"));
                                swGen5Source.add(nvl(rs.getString("SOURCE_ID"), "N/A"));
                                swGen5Error.add(nvl(rs.getString("ERROR_CODE"), "N/A"));
                                swGen5Hits.add(rs.getInt("TOTAL_HITS"));
                                swGen5Td.add(rs.getInt("TD"));
                                swGen5Time.add(nvl(rs.getString("ISSUE_TIME"), "N/A"));
                                swGen5Si.add(rs.getInt("SI_EEROR"));
                            }
                        }
                        rs.close();
                    } catch(Exception e) { e.printStackTrace(); }
                    
                    int maxTiles = Math.max(swGen5Per.size(), 35);
                    for(int i = 0; i < maxTiles; i++) {
                        String cls = "tile tile-healthy";
                        String val = "✓";
                        String sub = "HEALTHY";
                        String bar = "15%";
                        String tip = "✅ Healthy";
                        String tipClass = "tip-healthy";
                        String onclick = "";
                        if(i < swGen5Per.size()) {
                            Double pct = swGen5Per.get(i);
                            cls = "tile tile-critical pulse";
                            val = String.format("%.1f", pct) + "%";
                            sub = "TD";
                            bar = "80%";
                            tip = "⚠ " + swGen5Name.get(i) + " | TD: " + swGen5Td.get(i);
                            tipClass = "tip-critical";
                            String alertMsg = "<b>Service:</b> " + swGen5Name.get(i) + "<br><b>Source:</b> " + swGen5Source.get(i) + "<br><b>Error:</b> " + swGen5Error.get(i) + "<br><b>Hits:</b> " + swGen5Hits.get(i) + "<br><b>TD Count:</b> <span class='highlight-td'>" + swGen5Td.get(i) + "</span><br><b>Fail %:</b> <span class='highlight-td'>" + String.format("%.2f", pct) + "%</span><br><b>SI Error:</b> " + swGen5Si.get(i) + "<br><b>Time:</b> " + swGen5Time.get(i);
                            String name = swGen5Name.get(i).replace("'", "\\'");
                            onclick = "onclick=\"openModal('" + alertMsg.replace("'", "\\'") + "','" + name + "','GEN-5','ServiceWise','" + swGen5Source.get(i).replace("'", "\\'") + "','" + swGen5Error.get(i).replace("'", "\\'") + "','" + swGen5Hits.get(i) + "','" + swGen5Td.get(i) + "','" + swGen5Time.get(i).replace("'", "\\'") + "')\"";
                        }
                        out.print("<div class='" + cls + "' data-tip='" + tip + "' data-tip-class='" + tipClass + "' " + onclick + ">");
                        out.print("<span class='val'>" + val + "</span>");
                        out.print("<span class='sub-text'>" + sub + "</span>");
                        out.print("<div class='bar'><div class='fill' style='width:" + bar + ";'></div></div>");
                        out.print("</div>");
                    }
                %>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- CARD 2: ServiceWise - SI (COMMENTED) -->
        <%-- <div class="card-modern">...</div> --%>

        <!-- ============================================================ -->
        <!-- CARD 3: ServiceWise - ThirdParty -->
        <!-- ============================================================ -->
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="title"><i class="fas fa-plug"></i> ThirdParty</span>
                <span class="badge-count" id="swThirdCount">0</span>
            </div>
            <div class="tile-grid" id="sw-third">
                <%
                    List<Double> swThirdPer = new ArrayList<>();
                    List<String> swThirdName = new ArrayList<>();
                    List<String> swThirdSource = new ArrayList<>();
                    List<String> swThirdError = new ArrayList<>();
                    List<Integer> swThirdHits = new ArrayList<>();
                    List<Integer> swThirdTd = new ArrayList<>();
                    List<String> swThirdTime = new ArrayList<>();
                    List<Integer> swThirdSi = new ArrayList<>();
                    List<String> swThirdApiName = new ArrayList<>();
                    List<String> swThirdTransaction = new ArrayList<>();
                    List<String> swThirdSupUrl = new ArrayList<>();
                    
                    try {
                        String q = "select * from (select api_name,sup_url,transaction_urn,original_urn, sum(total_hits) as total_hits, sum(td) as td, round(avg(td_percent),2) as td_percent, SUM(SI_EEROR) AS SI_EEROR, error_code,source_id, issue_time from gen5_ThirdParty_servicewise_fail TEMP where trim(CONCAT(temp.sup_url,temp.SOURCE_ID)) not in(select trim(CONCAT(API_NAME,SOURCE_ID)||error_description) from vaild_bd_master) and insert_time >= SYSDATE - INTERVAL '10' minute and original_urn not in (select service_name from service_temporary_pause_master where service_name is not null) AND trim(temp.error_code ) not in (select DISTINCT trim(ERRCODE) FROM cbs_err_map WHERE substr(errcode,3,3) NOT in ('002','014') OR errcode in ('SI001','SI007','SI051','SI569','SI570')) GROUP BY api_name,sup_url,transaction_urn,original_urn,error_code,source_id,issue_time order by 2 desc) TEMP where issue_time = (select max(issue_time) from gen5_ThirdParty_servicewise_fail temp_in where temp_in.sup_url = temp.sup_url group by sup_url)";
                        ResultSet rs = con.createStatement().executeQuery(q);
                        while(rs.next()) {
                            if(rs.getDouble("TD") >= 50) {
                                swThirdPer.add(rs.getDouble("TD_PERCENT"));
                                swThirdName.add(nvl(rs.getString("original_urn"), "N/A"));
                                swThirdSource.add(nvl(rs.getString("source_id"), "N/A"));
                                swThirdError.add(nvl(rs.getString("error_code"), "N/A"));
                                swThirdHits.add(rs.getInt("TOTAL_HITS"));
                                swThirdTd.add(rs.getInt("TD"));
                                swThirdTime.add(nvl(rs.getString("issue_time"), "N/A"));
                                swThirdSi.add(rs.getInt("SI_EEROR"));
                                swThirdApiName.add(nvl(rs.getString("api_name"), "N/A"));
                                swThirdTransaction.add(nvl(rs.getString("transaction_urn"), "N/A"));
                                swThirdSupUrl.add(nvl(rs.getString("sup_url"), "N/A"));
                            }
                        }
                        rs.close();
                    } catch(Exception e) { e.printStackTrace(); }
                    
                    maxTiles = Math.max(swThirdPer.size(), 35);
                    for(int i = 0; i < maxTiles; i++) {
                        String cls = "tile tile-healthy";
                        String val = "✓";
                        String sub = "HEALTHY";
                        String bar = "15%";
                        String tip = "✅ Healthy";
                        String tipClass = "tip-healthy";
                        String onclick = "";
                        if(i < swThirdPer.size()) {
                            Double pct = swThirdPer.get(i);
                            cls = "tile tile-critical pulse";
                            val = String.format("%.1f", pct) + "%";
                            sub = "TD";
                            bar = "80%";
                            tip = "⚠ " + swThirdName.get(i) + " | TD: " + swThirdTd.get(i);
                            tipClass = "tip-critical";
                            String alertMsg = "<b>API Name:</b> " + swThirdApiName.get(i) + 
                                             "<br><b>Service:</b> " + swThirdName.get(i) + 
                                             "<br><b>Transaction URN:</b> " + swThirdTransaction.get(i) + 
                                             "<br><b>SUP URL:</b> " + swThirdSupUrl.get(i) + 
                                             "<br><b>Source:</b> " + swThirdSource.get(i) + 
                                             "<br><b>Error:</b> " + swThirdError.get(i) + 
                                             "<br><b>Hits:</b> " + swThirdHits.get(i) + 
                                             "<br><b>TD Count:</b> <span class='highlight-td'>" + swThirdTd.get(i) + "</span>" + 
                                             "<br><b>Fail %:</b> <span class='highlight-td'>" + String.format("%.2f", pct) + "%</span>" + 
                                             "<br><b>SI Error:</b> " + swThirdSi.get(i) + 
                                             "<br><b>Time:</b> " + swThirdTime.get(i);
                            String name = swThirdName.get(i).replace("'", "\\'");
                            String source = swThirdSource.get(i).replace("'", "\\'");
                            String error = swThirdError.get(i).replace("'", "\\'");
                            String time = swThirdTime.get(i).replace("'", "\\'");
                            String apiName = swThirdApiName.get(i).replace("'", "\\'");
                            String transaction = swThirdTransaction.get(i).replace("'", "\\'");
                            String supurl = swThirdSupUrl.get(i).replace("'", "\\'");
                            onclick = "onclick=\"openModal('" + alertMsg.replace("'", "\\'") + "','" + name + "','ThirdParty','ServiceWise','" + source + "','" + error + "','" + swThirdHits.get(i) + "','" + swThirdTd.get(i) + "','" + time + "','" + transaction + "','" + supurl + "','" + name + "','" + apiName + "')\"";
                        }
                        out.print("<div class='" + cls + "' data-tip='" + tip + "' data-tip-class='" + tipClass + "' " + onclick + ">");
                        out.print("<span class='val'>" + val + "</span>");
                        out.print("<span class='sub-text'>" + sub + "</span>");
                        out.print("<div class='bar'><div class='fill' style='width:" + bar + ";'></div></div>");
                        out.print("</div>");
                    }
                %>
            </div>
        </div>

        <!-- ============================================================ -->
        <!-- CARD 4: ServiceWise - Combined (I4C · IVR · CAPS)  -- UPDATED -->
        <!-- ============================================================ -->
        <div class="card-modern">
            <div class="card-header-modern">
                <span class="title"><i class="fas fa-layer-group"></i> I4C·IVR·CAPS</span>
                <span class="badge-count" id="swCombCount">0</span>
            </div>
            <div class="tile-grid" id="sw-comb">
                <%
                    List<Double> swCombPer = new ArrayList<>();
                    List<String> swCombName = new ArrayList<>();
                    List<String> swCombCat = new ArrayList<>();
                    List<String> swCombSource = new ArrayList<>();
                    List<String> swCombError = new ArrayList<>();
                    List<String> swCombHits = new ArrayList<>();
                    List<String> swCombTd = new ArrayList<>();
                    List<String> swCombTime = new ArrayList<>();
                    List<String> swCombTransaction = new ArrayList<>();
                    List<String> swCombSupUrl = new ArrayList<>();
                    
                    try {
                        // -------- I4C --------
                        String q = "select * from (select sup_url,transaction_urn,original_urn, sum(total_hits) as total_hits, sum(td) as td, round(avg(td_percent),2) as td_percent, SUM(SI_EEROR) AS SI_EEROR, error_code,source_id, issue_time from gen5_ThirdParty_servicewise_fail TEMP where trim(CONCAT(temp.sup_url,temp.SOURCE_ID)) not in(select trim(CONCAT(API_NAME,SOURCE_ID)||error_description) from vaild_bd_master) and insert_time >= SYSDATE - INTERVAL '10' minute AND source_id = 'I4' and original_urn not in (select service_name from service_temporary_pause_master where service_name is not null) AND trim(temp.error_code ) not in (select DISTINCT trim(ERRCODE) FROM cbs_err_map WHERE substr(errcode,3,3) NOT in ('002','014') OR errcode in ('SI001','SI007','SI051','SI569','SI570')) GROUP BY sup_url,transaction_urn,original_urn,error_code,source_id,issue_time order by 2 desc) TEMP where issue_time = (select max(issue_time) from gen5_ThirdParty_servicewise_fail temp_in where temp_in.sup_url = temp.sup_url group by sup_url)";
                        ResultSet rs = con.createStatement().executeQuery(q);
                        while(rs.next()) {
                            if(rs.getDouble("TD") >= 50) {
                                swCombPer.add(rs.getDouble("TD_PERCENT"));
                                swCombName.add(nvl(rs.getString("original_urn"), "N/A"));
                                swCombCat.add("ThirdParty");   // <-- category mapping for View button
                                swCombSource.add(nvl(rs.getString("Source_id"), "N/A"));
                                swCombError.add(nvl(rs.getString("error_code"), "N/A"));
                                swCombHits.add(String.valueOf(rs.getInt("TOTAL_HITS")));
                                swCombTd.add(String.valueOf(rs.getInt("TD")));
                                swCombTime.add(nvl(rs.getString("issue_time"), "N/A"));
                                swCombTransaction.add(nvl(rs.getString("transaction_urn"), "N/A"));
                                swCombSupUrl.add(nvl(rs.getString("sup_url"), "N/A"));
                            }
                        }
                        // -------- IVR --------
                        q = "SELECT * FROM (SELECT api_name, Source_id,error_code,SUM(total_hits) AS total_hits,sum(SUCCESS) as SUCCESS,issue_time,SUM(td) AS td,round(AVG(td_per), 2) AS td_per FROM gen5_ServiceWise_fail TEMP WHERE trim(CONCAT(temp.API_NAME,temp.SOURCE_ID)) not in(select trim(CONCAT(API_NAME,SOURCE_ID)||error_description) from vaild_bd_master) AND substr(api_name,1,3) not in 'gen' AND insert_time >= SYSDATE - INTERVAL '10' minute and Source_id = 'CC' and api_name NOT IN (SELECT service_name FROM service_temporary_pause_master WHERE service_name IS NOT NULL) AND trim(temp.error_code) not in (select DISTINCT trim(ERRCODE) FROM cbs_err_map WHERE substr(errcode,3,3) NOT in ('002','014') OR errcode in ('SI001','SI007','SI051','SI569','SI570')) GROUP BY api_name,Source_id,error_code, issue_time ORDER BY 2 DESC) TEMP WHERE issue_time =(select max(issue_time) from gen5_ServiceWise_fail temp_in where temp_in.api_name = temp.api_name group by api_name)";
                        rs = con.createStatement().executeQuery(q);
                        while(rs.next()) {
                            if(rs.getDouble("TD") >= 10) {
                                swCombPer.add(rs.getDouble("TD_PER"));
                                swCombName.add(nvl(rs.getString("API_NAME"), "N/A"));
                                swCombCat.add("IVR-Service");   // <-- category mapping
                                swCombSource.add(nvl(rs.getString("Source_id"), "N/A"));
                                swCombError.add(nvl(rs.getString("ERROR_CODE"), "N/A"));
                                swCombHits.add(String.valueOf(rs.getInt("TOTAL_HITS")));
                                swCombTd.add(String.valueOf(rs.getInt("TD")));
                                swCombTime.add(nvl(rs.getString("issue_time"), "N/A"));
                                swCombTransaction.add("N/A");
                                swCombSupUrl.add("N/A");
                            }
                        }
                        // -------- SBICAPS --------

<%@ page pageEncoding="UTF-8" language="java" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%
 // ✅ Session check
 if(session == null || session.getAttribute("role") == null) {
     response.sendRedirect(request.getContextPath() + "/login.action");
     return;
 }

 // ✅ Cache headers
 response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate, max-age=0, private");
 response.setHeader("Pragma", "no-cache");
 response.setDateHeader("Expires", 0);
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Deployment Sheet Master</title>

  <!-- ✅ SAME paths jo tumhare existing code me the — koi change nahi -->
  <link rel="stylesheet" href="./css/Deployment.jquery.dataTables.min.css" />
  <link rel="stylesheet" href="./css/Deployment.buttons.dataTables.min.css" />

  <!-- ✅ SAME order jo tumhare existing code me tha -->
  <script src="./js/Deployment.jquery-3.7.0.min.js"></script>
  <script src="./js/Deployment.1.13.6.jquery.dataTables.min.js"></script>
  <script src="./js/Deployment.2.4.1.dataTables.buttons.min.js"></script>
  <script src="./js/Deployment.2.4.1.buttons.html5.min.js"></script>
  <script src="./js/Deployment.2.4.1.buttons.print.min.js"></script>
  <script src="./js/Deployment.3.10.1.jszip.min.js"></script>
  <script src="./js/Deployment.0.2.7.pdfmake.min.js"></script>
  <script src="./js/Deployment.0.2.7.vfs_fonts.js"></script>

  <style>
    /* ✅ Tumhare existing styles — theme-aware banaye */
    :root, [data-theme="light"] {
      --pg-bg: #f7f7f5;
      --pg-card: #ffffff;
      --pg-text: #0f172a;
      --pg-text-2: #334155;
      --pg-muted: #64748b;
      --pg-line: #e5e7eb;
      --pg-line-2: #cbd5e1;
      --pg-hover: #f8fafc;
      --pg-head: #f8fafc;
      --pg-brand: #F86F03;
      --pg-brand-light: #FFF4EC;
    }
    [data-theme="dark"] {
      --pg-bg: #0F0F0F;
      --pg-card: #1E293B;
      --pg-text: #f1f5f9;
      --pg-text-2: #cbd5e1;
      --pg-muted: #94a3b8;
      --pg-line: #334155;
      --pg-line-2: #475569;
      --pg-hover: #293548;
      --pg-head: #1A2332;
      --pg-brand: #FF9A3D;
      --pg-brand-light: rgba(248, 111, 3, 0.15);
    }

    body {
      background-color: var(--bg) !important;
      color: var(--pg-text);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      font-weight: 700;
    }

    /* ✅ Page wrapper — sidebar ke right me */
    .page-wrap {
      padding: 24px 28px 40px;
      width: 100%;
    }

    h1 {
      text-align: center;
      margin-bottom: 20px;
      font-weight: 800;
      color: var(--pg-text);
      font-size: 1.6rem;
      letter-spacing: -0.4px;
    }

    .table-actions {
      margin-bottom: 15px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }

    /* ✅ DataTables styling — theme-aware */
    table.dataTable {
      width: 100% !important;
      color: var(--pg-text) !important;
      border-collapse: separate !important;
      border-spacing: 0 !important;
      font-size: 0.85rem !important;
    }
    table.dataTable thead th {
      background-color: var(--pg-head) !important;
      color: var(--pg-text-2) !important;
      font-weight: 800 !important;
      font-size: 0.72rem !important;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 14px 14px !important;
      border-bottom: 2px solid var(--pg-line-2) !important;
      white-space: nowrap;
      text-align: left !important;
    }
    table.dataTable tbody td {
      padding: 12px 14px !important;
      background-color: var(--pg-card) !important;
      color: var(--pg-text) !important;
      font-weight: 700 !important;
      font-size: 0.82rem !important;
      border-bottom: 1px solid var(--pg-line) !important;
      white-space: nowrap;
      text-align: left !important;
    }
    table.dataTable tbody tr:hover td {
      background-color: var(--pg-hover) !important;
    }
    table.dataTable tbody tr:last-child td {
      border-bottom: none !important;
    }

    /* ✅ Buttons */
    .dt-buttons button, .custom-btn {
      background-color: var(--pg-card) !important;
      color: var(--pg-text-2) !important;
      border: 1.5px solid var(--pg-line-2) !important;
      padding: 9px 16px !important;
      margin-right: 5px;
      cursor: pointer;
      border-radius: 10px;
      font-weight: 800;
      font-size: 0.82rem;
      font-family: inherit;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .dt-buttons button:hover, .custom-btn:hover {
      background-color: var(--pg-brand-light) !important;
      border-color: var(--pg-brand) !important;
      color: var(--pg-brand) !important;
    }

    /* Submit button — brand orange */
    #submitFileBtn {
      background: linear-gradient(135deg, var(--pg-brand), #FFA41B) !important;
      color: #fff !important;
      border: none !important;
      box-shadow: 0 6px 18px -6px var(--pg-brand);
    }
    #submitFileBtn:hover {
      transform: translateY(-2px);
      color: #fff !important;
    }

    /* Push button */
    #pushDataBtn {
      background: linear-gradient(135deg, #10B981, #059669) !important;
      color: #fff !important;
      border: none !important;
      padding: 12px 24px !important;
      font-size: 0.9rem !important;
      box-shadow: 0 6px 18px -6px #10B981;
    }
    #pushDataBtn:hover {
      transform: translateY(-2px);
      color: #fff !important;
    }

    #fileInput {
      display: none;
    }

    .dataTables_wrapper {
      width: 100%;
      overflow-x: auto;
      color: var(--pg-text);
    }

    /* Search input */
    .dataTables_filter input {
      padding: 8px 12px !important;
      border: 1.5px solid var(--pg-line-2) !important;
      border-radius: 8px !important;
      background: var(--pg-card) !important;
      color: var(--pg-text) !important;
      font-family: inherit !important;
      font-weight: 700 !important;
      outline: none !important;
      margin-left: 8px !important;
    }
    .dataTables_filter input:focus {
      border-color: var(--pg-brand) !important;
      box-shadow: 0 0 0 3px var(--pg-brand-light) !important;
    }

    /* Pagination */
    .dataTables_paginate {
      margin-top: 16px !important;
      padding-top: 12px !important;
      border-top: 1px solid var(--pg-line) !important;
      display: flex !important;
      justify-content: flex-end !important;
      gap: 4px !important;
    }
    .dataTables_paginate .paginate_button {
      padding: 7px 12px !important;
      border-radius: 8px !important;
      border: 1.5px solid var(--pg-line-2) !important;
      background: var(--pg-card) !important;
      color: var(--pg-text-2) !important;
      font-weight: 800 !important;
      font-size: 0.8rem !important;
      cursor: pointer !important;
      margin: 0 2px !important;
    }
    .dataTables_paginate .paginate_button.current {
      background: linear-gradient(135deg, var(--pg-brand), #FFA41B) !important;
      border-color: var(--pg-brand) !important;
      color: #fff !important;
    }
    .dataTables_info {
      font-size: 0.78rem !important;
      color: var(--pg-muted) !important;
      padding-top: 12px !important;
    }

    /* Sample format link */
    .sample-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
    }
  </style>
</head>
<body>

<%@include file="./userheader.jsp"%>

<div class="new-wrapper">
<div class="page-wrap">

  <h1>Deployment Sheet Master</h1>

  <div class="table-actions">
    <form id="uploadForm" enctype="multipart/form-data" method="post">
      <input type="file" id="fileInput" name="file" />
      <button type="button" class="custom-btn" id="submitFileBtn">Submit</button>
      <a href="<%=request.getContextPath() + "/XMLFile/Deployment_Sample_Format.xlsx"%>" class="custom-btn sample-link" download>Sample Format</a>
    </form>
  </div>

  <table id="deploymentTable" class="display nowrap" style="width:100%">
    <thead>
      <tr>
        <th>EXP URL</th>
        <th>EXP URL W.R.T SYS URL</th>
        <th>API_NAME</th>
        <th>SOURCE_ID</th>
        <th>Broker</th>
        <th>Broker EG</th>
        <th>New/Existing/NBC</th>
        <th>Hits in Production</th>
        <th>Failure(More than 50%)</th>
        <th>Success</th>
        <th>Changes Description</th>
        <th>Remarks</th>
        <th>Deployment Date Time</th>
      </tr>
    </thead>
    <tbody>
      <c:forEach var="row" items="${deploymentData}">
        <tr>
          <td>${row.EXP_URL}</td>
          <td>${row.SYS_URL}</td>
          <td>${row.API_NAME}</td>
          <td>${row.SOURCE_ID}</td>
          <td>${row.BROKER}</td>
          <td>${row.BROKER_EG}</td>
          <td>${row.STATUS}</td>
          <td>${row.HITS}</td>
          <td>${row.FAILURE}</td>
          <td>${row.SUCCESS}</td>
          <td>${row.CHANGES_DESC}</td>
          <td>${row.REMARKS}</td>
          <td>${row.DEPLOYMENT_DATE}</td>
        </tr>
      </c:forEach>
    </tbody>
  </table>

  <div style="margin-top: 20px; text-align: center;">
    <button type="button" class="custom-btn" id="pushDataBtn">Push Data to Main Table</button>
  </div>

</div>
</div>

<script>
  // ✅ SAME script — tumhare existing code ka
  $(document).ready(function () {

    // Safety check
    if (typeof jQuery.fn.DataTable === 'undefined') {
      console.error('❌ DataTables not loaded — check ./js/Deployment.1.13.6.jquery.dataTables.min.js');
      alert('Table library failed to load. Please refresh the page.');
      return;
    }

    const table = $('#deploymentTable').DataTable({
      dom: 'Bfrtip',
      paging: true,
      scrollX: true,
      responsive: false,
      pageLength: 15,
      searching: true,
      ordering: true,
      order: [],
      lengthChange: false,
      buttons: [
        {
          extend: 'excelHtml5',
          text: 'Export Excel',
          exportOptions: { columns: ':visible' }
        },
        {
          extend: 'pdfHtml5',
          text: 'Export PDF',
          exportOptions: { columns: ':visible' },
          orientation: 'landscape',
          pageSize: 'A4'
        }
      ]
    });

    // File input label
    $('#fileInput').on('change', function () {
      const file = this.files[0];
      if (file) {
        console.log('File chosen:', file.name);
      }
    });

    // Submit file
    $('#submitFileBtn').on('click', function () {
      const file = $('#fileInput')[0].files[0];
      if (!file) {
        alert("Please choose a file first!");
        return;
      }
      const formData = new FormData();
      formData.append("file", file);
      formData.append("action", "upload");

      const $btn = $(this);
      const orig = $btn.html();
      $btn.prop('disabled', true).html('Uploading...');

      $.ajax({
        url: '<%=request.getContextPath()%>/DeploymentSheetServlet',
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: function (res) {
          alert(res);
          window.location.href = '<%=request.getContextPath()%>/DeploymentSheetServlet';
        },
        error: function () {
          alert("Upload failed.");
          $btn.prop('disabled', false).html(orig);
        }
      });
    });

    // Push data
    $('#pushDataBtn').on('click', function () {
      const $btn = $(this);
      const orig = $btn.html();
      $btn.prop('disabled', true).html('Pushing...');

      $.ajax({
        url: '<%=request.getContextPath()%>/DeploymentSheetServlet',
        type: "POST",
        data: { action: "push" },
        success: function (res) {
          alert(res);
          window.location.href = '<%=request.getContextPath()%>/DeploymentSheetServlet';
        },
        error: function () {
          alert("Error occurred while pushing data!");
          $btn.prop('disabled', false).html(orig);
        }
      });
    });

  });
</script>

</body>
</html>

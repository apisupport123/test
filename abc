roleHeader.jsp

<%--
  ============================================================
  roleHeader.jsp — Central Role-Based Header Router
  ============================================================
  ✅ Auth guard: session.role missing → /login.action
  ✅ Role routing:
       Admin / ModuleLead → header.jsp
       EIS Bank           → Bankheader.jsp
       Everyone else      → userheader.jsp
  ============================================================
  USAGE (parent page ke TOP pe, koi HTML output se PEHLE):
      <jsp:include page="/jsp/roleHeader.jsp" />
  ============================================================
--%>
<%
    // ---- AUTH GUARD ----
    String __role = (session != null) ? (String) session.getAttribute("role") : null;
    if (__role == null || __role.trim().isEmpty()) {
        response.sendRedirect(request.getContextPath() + "/login.action");
        return;
    }

    // ---- ROLE CLASSIFICATION ----
    boolean __isAdmin  = "Admin".equalsIgnoreCase(__role)
                      || "ModuleLead".equalsIgnoreCase(__role);
    boolean __isBanker = "EIS Bank".equalsIgnoreCase(__role);
%>
<% if (__isAdmin) { %>
    <% request.setAttribute("EIS_HEADER_FRAGMENT", "true"); %>
    <jsp:include page="/jsp/header.jsp" />
<% } else if (__isBanker) { %>
    <% request.setAttribute("EIS_HEADER_FRAGMENT", "true"); %>
    <jsp:include page="/jsp/Bankheader.jsp" />
<% } else { %>
    <jsp:include page="/jsp/userheader.jsp" />
<% } %>

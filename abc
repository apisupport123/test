<style>
/* ============ THEME-AWARE OVERRIDES ============ */
body {
    font-family: Arial, sans-serif !important;
    background: var(--bg) !important;
    color: var(--ink) !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* Content wrapper — topnav ke neeche se */
.atm-wrap {
    padding: 20px 24px 40px;
    max-width: 3050px;
    margin: 0 auto;
}

/* Page heading */
.atm-head {
    text-align: center;
    margin-bottom: 16px;
}
.atm-head h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.5px;
    margin: 0 0 8px 0;
    text-align: center;
}
.atm-head .blink {
    font-size: 30px;
    text-align: center;
    color: var(--ink);
    margin: 0;
}

/* Timer badge */
.timer {
    border: 5px solid var(--brand);
    display: inline;
    padding: 5px 12px;
    color: var(--ink);
    font-family: Verdana, sans-serif, Arial;
    font-size: 40px;
    height: 50px;
    font-weight: bold;
    text-decoration: none;
    border-radius: 8px;
    background: var(--brand-light);
}
html[data-theme="dark"] .timer {
    background: rgba(248,111,3,.15);
    border-color: var(--brand);
    color: var(--brand);
}

/* Button container */
.button-container {
    display: flex;
    justify-content: flex-end;
    margin-right: 10px;
    margin-bottom: 20px;
}
.button {
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    margin-right: 10px;
    background-color: #ebe310;
    color: black;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    transition: all .2s ease;
}
.button:hover {
    background-color: #d4cc00;
    transform: translateY(-1px);
}

/* Card container — original flex */
.card-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    margin-bottom: 30px;
    gap: 0;
}

/* Card — original size */
.card {
    width: 310px !important;
    height: 180px !important;
    margin: 10px !important;
    text-align: center;
    transition: transform 0.3s ease, background-color 0.3s ease;
    border-radius: 10px !important;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
    color: white !important;
    cursor: pointer;
    border: none !important;
    padding: 0 !important;
}

.card:hover {
    transform: scale(1.05) !important;
}

.card-zero {
    background-color: #dc3545 !important;
}
.card-zero:hover {
    background-color: #c82333 !important;
}

.card-nonzero {
    background-color: #007bff !important;
}
.card-nonzero:hover {
    background-color: #0056b3 !important;
}

.card-body {
    display: flex !important;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    padding: 0 !important;
}

.card-info {
    font-size: 14px;
}

.card-title {
    font-weight: bold !important;
    margin-bottom: 10px !important;
    font-size: 18px !important;
    color: #fff !important;
    letter-spacing: 0 !important;
}

.card-text {
    font-size: 14px !important;
    color: #fff !important;
    margin: 4px 0 !important;
    opacity: 1 !important;
}

/* Section */
.section {
    margin-bottom: 30px;
}
.section h3 {
    text-align: center;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.3px;
    margin: 0 0 14px 0;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--line);
}

/* Empty state */
.empty-state {
    width: 100%;
    text-align: center;
    padding: 40px 20px;
    color: var(--muted);
    font-size: 0.95rem;
    font-style: italic;
}

/* ============ MODAL (theme-aware, original sizes) ============ */
.modal-content {
    background: var(--card) !important;
    color: var(--ink) !important;
    border: 1px solid var(--line) !important;
    border-radius: 10px !important;
}
.modal-header {
    border-bottom: 1px solid var(--line) !important;
    padding: 15px !important;
    background: var(--bg);
}
.modal-title {
    color: var(--ink) !important;
    font-size: 1.15rem;
    font-weight: 700;
}
.modal-body {
    padding: 20px !important;
    color: var(--ink) !important;
}
.modal-body p {
    color: var(--ink);
    font-size: 0.95rem;
    margin-bottom: 8px;
}
.modal-body strong {
    font-weight: 700;
    color: var(--ink);
}
.modal-body .form-control {
    background: var(--bg) !important;
    border: 1px solid var(--line) !important;
    border-radius: 6px !important;
    color: var(--ink) !important;
    font-family: inherit;
    font-size: 0.95rem;
    padding: 8px 12px;
}
.modal-body .form-control:focus {
    border-color: var(--brand) !important;
    box-shadow: 0 0 0 3px rgba(248,111,3,.12) !important;
    background: var(--card) !important;
    color: var(--ink) !important;
}
.modal-footer {
    border-top: 1px solid var(--line) !important;
    padding: 15px !important;
    background: var(--bg);
}
.modal-footer .btn-primary {
    background: var(--brand) !important;
    border-color: var(--brand) !important;
    color: #fff !important;
    border-radius: 6px !important;
    padding: 10px 24px !important;
    font-weight: 600 !important;
    font-size: 0.95rem !important;
}
.modal-footer .btn-primary:hover {
    background: var(--brand-2) !important;
    border-color: var(--brand-2) !important;
}
.modal-header .close {
    color: var(--muted) !important;
    opacity: 1 !important;
    text-shadow: none !important;
    font-size: 1.6rem;
}
.modal-header .close:hover {
    color: var(--ink) !important;
}

/* Textarea/select placeholder */
.modal-body textarea::placeholder {
    color: var(--muted);
    opacity: .6;
}

/* Responsive — chhota card on mobile */
@media (max-width: 700px) {
    .atm-wrap { padding: 16px; }
    .atm-head h1 { font-size: 1.4rem; }
    .atm-head .blink { font-size: 1.1rem; }
    .timer { font-size: 24px; padding: 3px 8px; border-width: 3px; }
    .card { width: calc(50% - 20px) !important; height: 160px !important; }
    .section h3 { font-size: 1.15rem; }
}
@media (max-width: 480px) {
    .card { width: 100% !important; }
}
</style>


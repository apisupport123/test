<style>
:root{
  --brand:#F86F03;
  --brand-2:#FF9A3D;
  --brand-light:#FFF4EC;
  --brand-glow:rgba(248,111,3,.4);
  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#272727;
  --bg:#0F0F0F;
  --card:#161616;
  --sidebar-bg:#0B0B0B;
  --sidebar-hover:#1A1A1A;
  --sidebar-text:#A1A1AA;
  --sidebar-active:#1E1408;
  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --topnav-h:60px;
  --sidebar-w:60px;
  --sidebar-w-expanded:260px;
}

/* Reset old styles */
.primary-nav,.hamburger,.main-menu,.menu,.overflow-container{display:none!important}

*{box-sizing:border-box}

/* ✅ Body — dark mode forced */
html,body{
  margin:0 !important;
  padding:0 !important;
  background:#0F0F0F !important;
  color:#F5F5F5 !important;
  font-family:var(--font-stack) !important;
  font-weight:700 !important;
  -webkit-font-smoothing:antialiased;
  min-height:100vh;
}
h1,h2,h3,h4,h5,h6,strong,b{font-weight:800;letter-spacing:-.3px}
a{color:inherit;text-decoration:none}

/* SVG icon helper */
.ah-icon{
  width:18px;height:18px;
  display:inline-block;flex-shrink:0;
  stroke:currentColor;fill:none;
  stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round;
}
.ah-icon-sm{width:14px;height:14px}

/* ============ ADMIN SIDEBAR ============ */
.admin-sidebar{
  position:fixed;
  top:0;left:0;bottom:0;
  width:var(--sidebar-w);
  background:var(--sidebar-bg);
  border-right:1px solid var(--line);
  z-index:60;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  transition:width .25s cubic-bezier(.4,0,.2,1),background .3s ease;
}
.admin-sidebar:hover,
.admin-sidebar.expanded{
  width:var(--sidebar-w-expanded);
  box-shadow:6px 0 24px rgba(0,0,0,.4);
}

/* Sidebar head */
.admin-sb-head{
  height:var(--topnav-h);
  display:flex;
  align-items:center;
  gap:12px;
  padding:0 18px;
  border-bottom:1px solid var(--line);
  flex-shrink:0;
  overflow:hidden;
  white-space:nowrap;
}
.admin-sb-logo{
  width:30px;height:30px;
  background:linear-gradient(135deg,var(--brand),var(--brand-2));
  display:grid;place-items:center;
  border-radius:9px;
  color:#fff;
  font-size:.75rem;
  box-shadow:0 6px 16px -6px var(--brand);
  flex-shrink:0;
}
.admin-sb-logo .ah-icon{width:16px;height:16px;stroke-width:2.4}
.admin-sb-title{
  font-size:.85rem;
  font-weight:900;
  color:#fff;
  letter-spacing:-.3px;
  opacity:0;
  transition:opacity .2s ease .05s;
}
.admin-sb-title small{
  display:block;
  font-size:.6rem;
  color:var(--brand);
  letter-spacing:1.5px;
  font-weight:700;
  text-transform:uppercase;
  margin-top:2px;
}
.admin-sidebar:hover .admin-sb-title,
.admin-sidebar.expanded .admin-sb-title{
  opacity:1;
}

/* Sidebar body */
.admin-sb-body{
  flex:1;
  overflow-y:auto;
  overflow-x:hidden;
  padding:10px 0 20px;
}
.admin-sb-body::-webkit-scrollbar{width:5px}
.admin-sb-body::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}

.admin-sb-group{
  padding:14px 22px 6px;
  font-size:.6rem;
  font-weight:800;
  color:var(--muted);
  letter-spacing:1.2px;
  text-transform:uppercase;
  white-space:nowrap;
  opacity:0;
  transition:opacity .2s ease;
}
.admin-sidebar:hover .admin-sb-group,
.admin-sidebar.expanded .admin-sb-group{
  opacity:1;
}

.admin-sb-item{
  display:flex;
  align-items:center;
  gap:14px;
  height:44px;
  padding:0 20px;
  color:var(--sidebar-text);
  font-size:.82rem;
  font-weight:700;
  white-space:nowrap;
  transition:all .15s ease;
  position:relative;
  cursor:pointer;
}
.admin-sb-item:hover{
  background:var(--sidebar-hover);
  color:#fff;
}
.admin-sb-item:hover::before{
  content:"";
  position:absolute;
  left:0;top:8px;bottom:8px;
  width:3px;
  background:var(--brand);
  border-radius:0 3px 3px 0;
}
.admin-sb-icon{
  width:22px;
  height:22px;
  display:grid;
  place-items:center;
  flex-shrink:0;
  transition:all .2s ease;
}
.admin-sb-icon .ah-icon{width:18px;height:18px;stroke-width:2}
.admin-sb-item:hover .admin-sb-icon{color:var(--brand);transform:scale(1.1)}
.admin-sb-label{
  opacity:0;
  transition:opacity .15s ease .05s;
  flex:1;
  overflow:hidden;
  text-overflow:ellipsis;
}
.admin-sidebar:hover .admin-sb-label,
.admin-sidebar.expanded .admin-sb-label{
  opacity:1;
}

/* Active item */
.admin-sb-item.active{
  background:var(--sidebar-active);
  color:var(--brand);
}
.admin-sb-item.active::before{
  content:"";
  position:absolute;
  left:0;top:8px;bottom:8px;
  width:3px;
  background:var(--brand);
  border-radius:0 3px 3px 0;
}

/* Logout item */
.admin-sb-logout{
  color:#FF6B6B !important;
  margin-top:8px;
  border-top:1px solid var(--line);
  padding-top:8px;
  height:52px;
}
.admin-sb-logout:hover{
  background:rgba(229,57,53,.12) !important;
  color:#FF6B6B !important;
}
.admin-sb-logout:hover::before{
  background:#E53935 !important;
}
.admin-sb-logout .admin-sb-icon{color:#FF6B6B}

/* Logo tooltip (collapsed) — visible only when collapsed */
.admin-sidebar:not(:hover):not(.expanded) .admin-sb-item::after{
  content:attr(data-tooltip);
  position:absolute;
  left:70px;
  top:50%;
  transform:translateY(-50%);
  background:#1A1A1A;
  color:#F5F5F5;
  padding:6px 12px;
  border-radius:8px;
  font-size:.72rem;
  font-weight:700;
  white-space:nowrap;
  border:1px solid var(--line);
  box-shadow:0 4px 14px rgba(0,0,0,.3);
  opacity:0;
  pointer-events:none;
  transition:opacity .15s ease;
  z-index:100;
}
.admin-sidebar:not(:hover):not(.expanded) .admin-sb-item:hover::after{
  opacity:1;
}

/* ============ TOP BAR ============ */
.admin-topbar{
  position:fixed;
  top:0;
  left:var(--sidebar-w);
  right:0;
  height:var(--topnav-h);
  background:rgba(15,15,15,.85);
  backdrop-filter:blur(14px) saturate(180%);
  -webkit-backdrop-filter:blur(14px) saturate(180%);
  border-bottom:1px solid var(--line);
  z-index:50;
  display:flex;
  align-items:center;
  padding:0 24px;
  gap:16px;
  transition:left .25s cubic-bezier(.4,0,.2,1);
}
.admin-sidebar:hover ~ .admin-topbar,
.admin-sidebar.expanded ~ .admin-topbar{
  left:var(--sidebar-w-expanded);
}

.admin-tb-toggle{
  width:34px;height:34px;
  background:var(--sidebar-hover);
  border:1px solid var(--line);
  border-radius:9px;
  color:#F5F5F5;
  cursor:pointer;
  display:grid;
  place-items:center;
  transition:all .15s ease;
}
.admin-tb-toggle:hover{
  background:var(--brand);
  border-color:var(--brand);
  color:#fff;
}
.admin-tb-toggle .ah-icon{width:16px;height:16px}

.admin-tb-title{
  font-size:.85rem;
  font-weight:800;
  color:#F5F5F5;
  letter-spacing:-.3px;
  display:flex;
  align-items:center;
  gap:8px;
}
.admin-tb-title .badge-admin{
  background:rgba(248,111,3,.15);
  color:var(--brand);
  font-size:.62rem;
  font-weight:800;
  padding:3px 9px;
  border-radius:999px;
  text-transform:uppercase;
  letter-spacing:.5px;
  border:1px solid rgba(248,111,3,.3);
}

.admin-tb-right{
  margin-left:auto;
  display:flex;
  align-items:center;
  gap:10px;
}
.admin-tb-btn{
  width:34px;height:34px;
  background:transparent;
  border:1px solid var(--line);
  border-radius:9px;
  color:#F5F5F5;
  cursor:pointer;
  display:grid;
  place-items:center;
  transition:all .15s ease;
  text-decoration:none;
}
.admin-tb-btn:hover{
  background:var(--brand);
  border-color:var(--brand);
  color:#fff;
}
.admin-tb-btn .ah-icon{width:16px;height:16px}

/* ============ CONTENT WRAPPER ============ */
.admin-content-wrap{
  margin-left:var(--sidebar-w);
  padding-top:var(--topnav-h);
  transition:margin-left .25s cubic-bezier(.4,0,.2,1);
  min-height:100vh;
  background:#0F0F0F;
}
.admin-sidebar:hover ~ .admin-content-wrap,
.admin-sidebar.expanded ~ .admin-content-wrap{
  margin-left:var(--sidebar-w-expanded);
}

/* Overlay for mobile */
.admin-overlay{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.5);
  z-index:55;
  backdrop-filter:blur(2px);
}

@media (max-width:900px){
  .admin-sidebar{
    width:var(--sidebar-w-expanded);
    transform:translateX(-100%);
    box-shadow:6px 0 24px rgba(0,0,0,.5);
  }
  .admin-sidebar.expanded{
    transform:translateX(0);
    width:var(--sidebar-w-expanded);
  }
  .admin-sidebar .admin-sb-title,
  .admin-sidebar .admin-sb-label,
  .admin-sidebar .admin-sb-group{opacity:1}
  .admin-sidebar:hover ~ .admin-topbar,
  .admin-sidebar.expanded ~ .admin-topbar{left:0}
  .admin-topbar{left:0 !important}
  .admin-content-wrap{margin-left:0 !important}
  .admin-overlay.show{display:block}
}
</style>


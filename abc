// ── Automatic Refresh Logic (runs on every page load) ──
boolean masterRefreshed = false;
Connection connReportAuto = null;
Connection connIIBAuto = null;
try {
    connReportAuto = DBUtilityAuto.getReportDBConnection();
    connIIBAuto = DBUtilityAuto.getIIBDBConnection();
    ensureTableExists(connReportAuto);

    // Check if we need to refresh (new day)
    boolean needsRefresh = false;
    Statement stmtCheck = connReportAuto.createStatement();
    ResultSet rsCheck = stmtCheck.executeQuery("SELECT MAX(LAST_UPDATED) FROM DPG_IP_MASTER");
    Date lastUpdated = null;
    if (rsCheck.next()) {
        lastUpdated = rsCheck.getDate(1);
    }
    rsCheck.close();
    stmtCheck.close();

    if (lastUpdated == null || lastUpdated.before(new java.util.Date(System.currentTimeMillis() - 24*60*60*1000))) {
        needsRefresh = true;
    }

    if (needsRefresh) {
        connReportAuto.setAutoCommit(false);
        refreshMasterTable(connReportAuto, connIIBAuto);
        connReportAuto.commit();
        connReportAuto.setAutoCommit(true);
        masterRefreshed = true;
    }
} catch (Exception e) {
    e.printStackTrace();
    try { if (connReportAuto != null) connReportAuto.rollback(); } catch (Exception ex) {}
} finally {
    try { if (connReportAuto != null) connReportAuto.close(); } catch (Exception e) {}
    try { if (connIIBAuto != null) connIIBAuto.close(); } catch (Exception e) {}

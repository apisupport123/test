<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="s" uri="/struts-tags" %>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EIS Registration · 2026</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
/* ================================================================
   RESET & TOKENS
   ================================================================ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
    --brand-1:    #ff6a00;
    --brand-2:    #ff2d95;
    --brand-3:    #7c3aed;
    --brand-4:    #06b6d4;
    --brand-5:    #10b981;

    --text:       #0a0a0f;
    --text-muted: #6b7280;
    --bg-1:       #f5f3ff;
    --bg-2:       #ecfeff;
    --white:      #ffffff;

    --glass-bg:     rgba(255,255,255,.55);
    --glass-border: rgba(255,255,255,.75);
    --glass-shadow: 0 8px 32px rgba(15,23,42,.08), 0 2px 8px rgba(15,23,42,.04);

    --radius-sm: 12px;
    --radius:    18px;
    --radius-lg: 28px;

    --ease-out:    cubic-bezier(.22,1,.36,1);
    --ease-spring: cubic-bezier(.34,1.56,.64,1);
}

[data-theme="dark"] {
    --text:       #f1f5f9;
    --text-muted: #94a3b8;
    --bg-1:       #0a0a14;
    --bg-2:       #0f0f1e;
    --white:      #16161f;
    --glass-bg:     rgba(22,22,31,.55);
    --glass-border: rgba(255,255,255,.08);
    --glass-shadow: 0 8px 32px rgba(0,0,0,.5), 0 2px 8px rgba(0,0,0,.3);
}

html { scroll-behavior: smooth; }

body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: var(--text);
    background: var(--bg-1);
    min-height: 100vh;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    transition: background .4s var(--ease-out), color .4s var(--ease-out);
}

/* ================================================================
   ANIMATED MESH GRADIENT BACKGROUND
   ================================================================ */
.mesh-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: var(--bg-1);
}
.mesh-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: .6;
    mix-blend-mode: multiply;
    will-change: transform;
}
[data-theme="dark"] .mesh-blob {
    mix-blend-mode: screen;
    opacity: .45;
}
.mesh-blob.m1 {
    width: 560px; height: 560px;
    background: radial-gradient(circle, var(--brand-1), transparent 65%);
    top: -10%; left: -10%;
    animation: meshMove 22s ease-in-out infinite;
}
.mesh-blob.m2 {
    width: 620px; height: 620px;
    background: radial-gradient(circle, var(--brand-2), transparent 65%);
    top: 30%; right: -15%;
    animation: meshMove 26s ease-in-out infinite reverse;
}
.mesh-blob.m3 {
    width: 520px; height: 520px;
    background: radial-gradient(circle, var(--brand-3), transparent 65%);
    bottom: -12%; left: 25%;
    animation: meshMove 30s ease-in-out infinite;
    animation-delay: -8s;
}
.mesh-blob.m4 {
    width: 480px; height: 480px;
    background: radial-gradient(circle, var(--brand-4), transparent 65%);
    top: 15%; left: 40%;
    animation: meshMove 24s ease-in-out infinite reverse;
    animation-delay: -12s;
}
@keyframes meshMove {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(80px, -60px) scale(1.15); }
    66%      { transform: translate(-60px, 70px) scale(.9); }
}

/* Noise texture overlay */
.mesh-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml;utf8,<svg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='.4'/></svg>");
    opacity: .035;
    pointer-events: none;
}

/* Cursor spotlight */
.spotlight {
    position: fixed;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,106,0,.12), transparent 60%);
    pointer-events: none;
    z-index: -1;
    transform: translate(-50%, -50%);
    transition: opacity .3s;
    will-change: transform;
}
[data-theme="dark"] .spotlight {
    background: radial-gradient(circle, rgba(255,106,0,.18), transparent 60%);
}

/* ================================================================
   FLOATING TOOLBAR (top-right)
   ================================================================ */
.top-bar {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 100;
    display: flex;
    gap: 10px;
}
.icon-btn {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    color: var(--text);
    cursor: pointer;
    display: grid; place-items: center;
    transition: all .3s var(--ease-spring);
    font-size: 16px;
}
.icon-btn:hover {
    transform: scale(1.08) rotate(6deg);
    box-shadow: 0 12px 40px rgba(255,106,0,.35);
    color: var(--brand-1);
}

/* Theme toggle animation */
.theme-sun, .theme-moon {
    transition: all .5s var(--ease-spring);
    position: absolute;
}
[data-theme="dark"] .theme-sun  { opacity: 0; transform: rotate(180deg) scale(0); }
[data-theme="light"] .theme-moon{ opacity: 0; transform: rotate(-180deg) scale(0); }

/* ================================================================
   PAGE
   ================================================================ */
.page-wrap {
    max-width: 1520px;
    margin: 0 auto;
    padding: 60px 24px 40px;
}

/* ---------- HERO HEADER (Bento style) ---------- */
.hero {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 20px;
    margin-bottom: 32px;
    animation: heroIn 1s var(--ease-out) both;
}
@keyframes heroIn {
    from { opacity: 0; transform: translateY(-20px); }
    to   { opacity: 1; transform: translateY(0); }
}

.hero-main {
    background: var(--glass-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 36px 40px;
    position: relative;
    overflow: hidden;
    box-shadow: var(--glass-shadow);
}
.hero-main::before {
    content: "";
    position: absolute;
    top: -50%; right: -20%;
    width: 400px; height: 400px;
    background: radial-gradient(circle, var(--brand-1), transparent 70%);
    opacity: .18;
    border-radius: 50%;
    filter: blur(40px);
    animation: heroOrbit 12s ease-in-out infinite;
}
@keyframes heroOrbit {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(-40px, 40px); }
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: linear-gradient(135deg, rgba(255,106,0,.12), rgba(255,45,149,.12));
    border: 1px solid rgba(255,106,0,.25);
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    color: var(--brand-1);
    margin-bottom: 18px;
    position: relative;
    z-index: 1;
}
.hero-badge .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--brand-5);
    box-shadow: 0 0 12px var(--brand-5);
    animation: dotPulse 1.8s ease-in-out infinite;
}
@keyframes dotPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50%      { transform: scale(1.4); opacity: .7; }
}

.hero-main h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -.03em;
    position: relative;
    z-index: 1;
}
.hero-main h1 .gradient-text {
    background: linear-gradient(120deg, var(--brand-1), var(--brand-2), var(--brand-3), var(--brand-1));
    background-size: 300% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradientShift 6s linear infinite;
}
@keyframes gradientShift {
    to { background-position: 300% center; }
}

.hero-main p {
    margin-top: 14px;
    font-size: 15px;
    color: var(--text-muted);
    max-width: 520px;
    line-height: 1.6;
    position: relative;
    z-index: 1;
}

.hero-meta {
    display: flex;
    gap: 24px;
    margin-top: 24px;
    position: relative;
    z-index: 1;
    flex-wrap: wrap;
}
.meta-item {
    display: flex;
    align-items: center;
    gap: 10px;
}
.meta-icon {
    width: 36px; height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(255,106,0,.15), rgba(255,45,149,.10));
    display: grid; place-items: center;
    color: var(--brand-1);
    font-size: 14px;
}
.meta-text {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.3;
}
.meta-text strong {
    display: block;
    font-size: 13px;
    color: var(--text);
    font-weight: 600;
}

/* Hero side card — LIVE PROGRESS */
.hero-side {
    background: linear-gradient(160deg, #1a1a2e, #0f0f1e);
    border-radius: var(--radius-lg);
    padding: 32px 32px 28px;
    color: #fff;
    position: relative;
    overflow: hidden;
    box-shadow: var(--glass-shadow);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 260px;
}
.hero-side::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 100% 0%, rgba(255,106,0,.45), transparent 55%),
        radial-gradient(circle at 0% 100%, rgba(124,58,237,.45), transparent 55%);
    animation: heroSideGlow 8s ease-in-out infinite alternate;
}
@keyframes heroSideGlow {
    from { opacity: .7; }
    to   { opacity: 1; }
}

.hero-side-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: .7;
    position: relative;
    z-index: 1;
}
.progress-ring-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 16px 0;
}
.progress-ring {
    position: relative;
    width: 100px;
    height: 100px;
    flex-shrink: 0;
}
.progress-ring svg {
    transform: rotate(-90deg);
    width: 100%;
    height: 100%;
}
.progress-ring circle {
    fill: none;
    stroke-width: 8;
    stroke-linecap: round;
}
.ring-bg { stroke: rgba(255,255,255,.15); }
.ring-fg {
    stroke: url(#ringGrad);
    stroke-dasharray: 283;
    stroke-dashoffset: 283;
    transition: stroke-dashoffset 1s var(--ease-out);
}
.progress-num {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: #fff;
}
.progress-text {
    font-size: 13px;
    line-height: 1.5;
    opacity: .85;
}
.progress-text strong {
    display: block;
    font-size: 15px;
    color: #fff;
    margin-bottom: 4px;
    font-weight: 600;
}

.hero-side-foot {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 6px;
    font-size: 12px;
    opacity: .7;
    font-family: 'JetBrains Mono', monospace;
    align-items: center;
}
.kbd {
    padding: 2px 7px;
    border-radius: 5px;
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.15);
    font-size: 10.5px;
    font-weight: 600;
}

@media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
}

/* ================================================================
   BENTO FORM GRID
   ================================================================ */
.bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
}

.bento-card {
    background: var(--glass-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    padding: 26px 28px;
    box-shadow: var(--glass-shadow);
    position: relative;
    overflow: hidden;
    transition: all .4s var(--ease-out);
    opacity: 0;
    transform: translateY(24px);
    animation: bentoIn .7s var(--ease-out) forwards;
}
.bento-card:nth-child(1) { animation-delay: .05s; }
.bento-card:nth-child(2) { animation-delay: .10s; }
.bento-card:nth-child(3) { animation-delay: .15s; }
.bento-card:nth-child(4) { animation-delay: .20s; }
.bento-card:nth-child(5) { animation-delay: .25s; }
.bento-card:nth-child(6) { animation-delay: .30s; }
.bento-card:nth-child(7) { animation-delay: .35s; }
.bento-card:nth-child(8) { animation-delay: .40s; }

@keyframes bentoIn {
    to { opacity: 1; transform: translateY(0); }
}

.bento-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand-1), var(--brand-2), var(--brand-3));
    opacity: 0;
    transition: opacity .3s;
}
.bento-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 60px rgba(15,23,42,.12), 0 8px 24px rgba(15,23,42,.06);
    border-color: rgba(255,106,0,.35);
}
.bento-card:hover::before { opacity: 1; }

.bento-card.col-12 { grid-column: span 12; }
.bento-card.col-8  { grid-column: span 8; }
.bento-card.col-6  { grid-column: span 6; }
.bento-card.col-4  { grid-column: span 4; }
.bento-card.col-3  { grid-column: span 3; }

@media (max-width: 1024px) {
    .bento-card.col-8, .bento-card.col-6, .bento-card.col-4, .bento-card.col-3 {
        grid-column: span 12;
    }
}

/* ---------- CARD HEADER ---------- */
.card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
}
.card-head .num {
    width: 32px; height: 32px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    color: #fff;
    display: grid; place-items: center;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 8px 20px rgba(255,106,0,.35);
}
.card-head h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -.01em;
    flex: 1;
}
.card-head .badge {
    font-size: 10.5px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 100px;
    background: rgba(16,185,129,.12);
    color: var(--brand-5);
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ---------- FIELDS ---------- */
.fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
}
.fields .span-2 { grid-column: span 2; }
@media (max-width: 640px) {
    .fields .span-2 { grid-column: span 1; }
}

.field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: relative;
}
.field label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
    letter-spacing: .01em;
}
.field label .req { color: var(--brand-2); }

.field input[type="text"],
.field input[type="number"],
.field input[type="date"],
.field input[type="password"],
.field input[type="email"],
.field input[type="file"],
.field select {
    width: 100%;
    padding: 13px 16px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    background: rgba(255,255,255,.6);
    border: 1.5px solid transparent;
    border-radius: var(--radius-sm);
    transition: all .25s var(--ease-out);
    outline: none;
    box-shadow: inset 0 1px 2px rgba(15,23,42,.04);
}
[data-theme="dark"] .field input,
[data-theme="dark"] .field select {
    background: rgba(0,0,0,.25);
}
.field input::placeholder { color: #9ca3af; font-weight: 400; }

.field input:focus,
.field select:focus {
    background: var(--white);
    border-color: var(--brand-1);
    box-shadow:
        0 0 0 4px rgba(255,106,0,.15),
        inset 0 1px 2px rgba(15,23,42,.04);
    transform: translateY(-1px);
}

.field input[type="file"] {
    padding: 10px 14px;
    cursor: pointer;
}
.field input[type="file"]::file-selector-button {
    padding: 7px 14px;
    margin-right: 12px;
    border: none;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    color: #fff;
    border-radius: 8px;
    font-weight: 600;
    font-size: 12px;
    cursor: pointer;
    transition: all .2s;
}
.field input[type="file"]::file-selector-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(255,106,0,.4);
}

.field select {
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236b7280' stroke-width='2'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat: no-repeat;
    background-position: right 14px center;
    background-size: 18px;
    padding-right: 42px;
}

/* ---------- RADIO PILLS ---------- */
.radio-group {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}
.radio-pill {
    flex: 1;
    min-width: 90px;
    position: relative;
    cursor: pointer;
}
.radio-pill input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
}
.radio-pill span {
    display: block;
    padding: 12px 14px;
    text-align: center;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-muted);
    background: rgba(255,255,255,.5);
    border: 1.5px solid transparent;
    border-radius: var(--radius-sm);
    transition: all .25s var(--ease-spring);
}
[data-theme="dark"] .radio-pill span {
    background: rgba(0,0,0,.25);
}
.radio-pill input:checked + span {
    background: linear-gradient(135deg, rgba(255,106,0,.15), rgba(255,45,149,.10));
    border-color: var(--brand-1);
    color: var(--brand-1);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255,106,0,.2);
}
.radio-pill:hover span { border-color: rgba(255,106,0,.3); }

/* ---------- BUTTONS ---------- */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 14px 28px;
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 700;
    border-radius: var(--radius-sm);
    border: none;
    cursor: pointer;
    transition: all .3s var(--ease-spring);
    text-decoration: none;
    letter-spacing: .01em;
    position: relative;
    overflow: hidden;
    white-space: nowrap;
}
.btn-primary {
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2), var(--brand-3));
    background-size: 200% auto;
    color: #fff;
    box-shadow: 0 12px 30px rgba(255,106,0,.4);
}
.btn-primary:hover {
    background-position: right center;
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 20px 45px rgba(255,106,0,.5);
}
.btn-primary:active { transform: translateY(-1px) scale(1); }
.btn-primary:disabled {
    opacity: .7;
    cursor: not-allowed;
    transform: none;
}

.btn-ghost {
    background: var(--glass-bg);
    backdrop-filter: blur(12px);
    color: var(--text);
    border: 1.5px solid var(--glass-border);
}
.btn-ghost:hover {
    background: var(--white);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(15,23,42,.08);
}

/* ---------- FORM ACTIONS BAR ---------- */
.action-bar {
    grid-column: span 12;
    display: flex;
    gap: 12px;
    justify-content: space-between;
    align-items: center;
    padding: 24px 28px;
    background: var(--glass-bg);
    backdrop-filter: blur(24px);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius);
    box-shadow: var(--glass-shadow);
    position: sticky;
    bottom: 20px;
    z-index: 10;
    animation: bentoIn .7s var(--ease-out) .45s forwards;
    opacity: 0;
}
.action-info {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-muted);
}
.action-info .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--brand-5);
    box-shadow: 0 0 10px var(--brand-5);
    animation: dotPulse 1.8s ease-in-out infinite;
}
.action-buttons {
    display: flex;
    gap: 10px;
}

/* ================================================================
   MODAL
   ================================================================ */
.modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(10,10,20,.55);
    backdrop-filter: blur(10px);
    z-index: 1000;
    padding: 24px;
    overflow-y: auto;
}
.modal-overlay.open { display: grid; place-items: center; }

.modal-box {
    background: var(--white);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 80px rgba(0,0,0,.4);
    width: 100%;
    max-width: 720px;
    max-height: 90vh;
    overflow-y: auto;
    animation: modalIn .4s var(--ease-spring);
    border: 1px solid var(--glass-border);
}
@keyframes modalIn {
    from { opacity: 0; transform: scale(.88) translateY(30px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
}

.modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 28px;
    border-bottom: 1px solid rgba(15,23,42,.06);
    background: linear-gradient(135deg, rgba(255,106,0,.06), rgba(255,45,149,.03));
}
.modal-head h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 19px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 12px;
}
.modal-head h3 .num {
    width: 34px; height: 34px;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
    color: #fff;
    display: grid; place-items: center;
    font-size: 14px;
    box-shadow: 0 6px 16px rgba(255,106,0,.35);
}
.modal-close {
    width: 40px; height: 40px;
    border-radius: 12px;
    border: none;
    background: rgba(15,23,42,.05);
    color: var(--text-muted);
    cursor: pointer;
    display: grid;
    place-items: center;
    font-size: 16px;
    transition: all .3s var(--ease-spring);
}
.modal-close:hover {
    background: rgba(239,68,68,.12);
    color: #ef4444;
    transform: rotate(90deg);
}

.modal-body {
    padding: 26px 28px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 20px;
}
.modal-body .span-2 { grid-column: span 2; }
@media (max-width: 640px) {
    .modal-body { grid-template-columns: 1fr; }
    .modal-body .span-2 { grid-column: span 1; }
}

.modal-foot {
    padding: 20px 28px;
    border-top: 1px solid rgba(15,23,42,.06);
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    background: rgba(15,23,42,.02);
}

/* ================================================================
   TOAST
   ================================================================ */
.toast-host {
    position: fixed;
    top: 80px;
    right: 24px;
    z-index: 2000;
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.toast {
    background: var(--white);
    color: var(--text);
    padding: 14px 20px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 500;
    box-shadow: 0 20px 50px rgba(0,0,0,.15);
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 280px;
    border: 1px solid rgba(15,23,42,.06);
    animation: toastIn .4s var(--ease-spring);
    position: relative;
    overflow: hidden;
}
.toast::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    background: var(--brand-1);
}
.toast.toast-error::before   { background: #ef4444; }
.toast.toast-success::before { background: var(--brand-5); }
.toast.toast-info::before    { background: var(--brand-4); }
.toast i { font-size: 16px; }
.toast.toast-error i   { color: #ef4444; }
.toast.toast-success i { color: var(--brand-5); }
.toast.toast-info i    { color: var(--brand-4); }
@keyframes toastIn {
    from { opacity: 0; transform: translateX(40px) scale(.9); }
    to   { opacity: 1; transform: translateX(0) scale(1); }
}

/* ================================================================
   CONFETTI
   ================================================================ */
.confetti {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1500;
    overflow: hidden;
}
.confetti-piece {
    position: absolute;
    width: 10px; height: 10px;
    animation: confettiFall 2.8s linear forwards;
}
@keyframes confettiFall {
    to {
        transform: translateY(110vh) rotate(720deg);
        opacity: 0;
    }
}

/* ================================================================
   FOOTER
   ================================================================ */
.site-footer {
    text-align: center;
    padding: 40px 20px 30px;
    color: var(--text-muted);
    font-size: 13px;
}
.site-footer strong {
    background: linear-gradient(120deg, var(--brand-1), var(--brand-2), var(--brand-3));
    background-size: 300% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradientShift 6s linear infinite;
    font-weight: 700;
}

/* ================================================================
   RESPONSIVE
   ================================================================ */
@media (max-width: 640px) {
    .page-wrap { padding: 80px 16px 30px; }
    .hero-main { padding: 26px 22px; }
    .bento-card { padding: 22px 20px; }
    .action-bar {
        flex-direction: column;
        align-items: stretch;
        padding: 18px;
    }
    .action-buttons { flex-direction: column; }
    .action-buttons .btn { width: 100%; }
    .toast-host { top: 70px; right: 12px; left: 12px; }
    .toast { min-width: auto; }
}

/* ================================================================
   REDUCED MOTION
   ================================================================ */
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
    }
}

/* ================================================================
   SCROLLBAR
   ================================================================ */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, var(--brand-1), var(--brand-3));
    border-radius: 10px;
    border: 2px solid var(--bg-1);
}
</style>

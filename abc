        ensureTableExists(connReport);
        connReport.setAutoCommit(false);
        refreshMasterTable(connReport, connIIB);
        connReport.commit();
        connReport.setAutoCommit(true);
    } catch (Exception e) {
        e.printStackTrace();
        try { if (connReport != null) connReport.rollback(); } catch (Exception ex) {}
    } finally {
        try { if (connReport != null) connReport.close(); } catch (Exception e) {}
        try { if (connIIB != null) connIIB.close(); } catch (Exception e) {}
    }
    String redirectUrl = request.getRequestURI() + "?mute=" + isMuted;
    if (request.getParameter("fromTime") != null) redirectUrl += "&fromTime=" + request.getParameter("fromTime");
    if (request.getParameter("toTime") != null) redirectUrl += "&toTime=" + request.getParameter("toTime");
    response.sendRedirect(redirectUrl);
    return;
}

// ── Auto Refresh IP List ──
Connection connReportAuto = null, connIIBAuto = null;
try {
    connReportAuto = DBUtilityAuto.getReportDBConnection();
    connIIBAuto = DBUtilityAuto.getIIBDBConnection();
    ensureTableExists(connReportAuto);

    boolean needsRefresh = false;
    Statement stmtCheck = connReportAuto.createStatement();
    ResultSet rsCheck = stmtCheck.executeQuery("SELECT MAX(LAST_UPDATED) FROM DPG_IP_MASTER");
    Date lastUpdated = null;
    if (rsCheck.next()) lastUpdated = rsCheck.getDate(1);
    rsCheck.close();
    stmtCheck.close();

    if (lastUpdated == null || lastUpdated.before(new java.util.Date(System.currentTimeMillis() - 24*60*60*1000))) {
        needsRefresh = true;
    }
    if (needsRefresh) {
        connReportAuto.setAutoCommit(false);
        refreshMasterTable(connReportAuto, connIIBAuto);
        connReportAuto.commit();
        connReportAuto.setAutoCommit(true);
    }
} catch (Exception e) {
    e.printStackTrace();
    try { if (connReportAuto != null) connReportAuto.rollback(); } catch (Exception ex) {}
} finally {
    try { if (connReportAuto != null) connReportAuto.close(); } catch (Exception e) {}
    try { if (connIIBAuto != null) connIIBAuto.close(); } catch (Exception e) {}
}


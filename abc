<script src="<%=request.getContextPath()%>/js/jquery.min.js"></script>

<style>
:root{
  --brand:#F86F03;
  --brand-2:#FF9A3D;
  --brand-light:#FFF4EC;
  --brand-glow:rgba(248,111,3,.35);

  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F7F7F5;
  --card:#FFFFFF;
  --sidebar-bg:#FFFFFF;
  --sidebar-text:#4B5563;
  --sidebar-text-hover:#0A0A0A;
  --sidebar-hover:#F5F5F4;
  --sidebar-active:#FFF4EC;
  --topnav-bg:rgba(247,247,245,.85);

  --topnav-h:64px;
  --sidebar-w:260px;

  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
html[data-theme="dark"]{
  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#272727;
  --bg:#0F0F0F;
  --card:#161616;
  --sidebar-bg:#131313;
  --sidebar-text:#A1A1AA;
  --sidebar-text-hover:#FFFFFF;
  --sidebar-hover:#1F1F1F;
  --sidebar-active:#1E1408;
  --topnav-bg:rgba(15,15,15,.85);
}

*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--font-stack);
  font-weight:700;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  transition:background .3s ease,color .3s ease;
}
.primary-nav,.hamburger,.menu,.overflow-container{display:none!important}
h1,h2,h3,h4,h5,h6,strong,b{font-weight:800;letter-spacing:-.3px}

.icon-svg{
  width:16px;height:16px;
  display:inline-block;flex-shrink:0;
  stroke:currentColor;fill:none;
  stroke-width:2.2;
  stroke-linecap:round;stroke-linejoin:round;
}

/* ============ SIDEBAR ============ */
.sidebar{
  position:fixed;top:0;left:0;bottom:0;
  width:var(--sidebar-w);
  background:var(--sidebar-bg);
  border-right:1px solid var(--line);
  z-index:60;
  display:flex;flex-direction:column;
  transition:transform .3s cubic-bezier(.4,0,.2,1),background .3s ease,border-color .3s ease;
}
html.sb-collapsed .sidebar{transform:translateX(-100%)}
html.sb-collapsed .topnav{left:0}
html.sb-collapsed .new-wrapper{margin-left:0}

.sb-head{
  padding:16px 16px 16px 20px;
  height:var(--topnav-h);
  display:flex;align-items:center;gap:11px;
  border-bottom:1px solid var(--line);
  flex-shrink:0;
}
.sb-logo{
  width:36px;height:36px;
  background:linear-gradient(135deg,var(--brand),var(--brand-2));
  border-radius:10px;
  display:grid;place-items:center;color:#fff;font-size:.9rem;
  box-shadow:0 6px 16px -6px var(--brand);
  flex-shrink:0;
}
.sb-logo .icon-svg{width:18px;height:18px;stroke-width:2.6}
.sb-title{
  font-weight:900;font-size:.95rem;
  letter-spacing:-.3px;line-height:1.1;
  flex:1;min-width:0;
  text-transform:uppercase;
}
.sb-title small{
  display:block;font-size:.68rem;font-weight:700;
  color:var(--brand);letter-spacing:.6px;text-transform:uppercase;margin-top:2px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.sb-collapse-btn{
  width:28px;height:28px;
  display:grid;place-items:center;
  background:transparent;
  border:1px solid var(--line);
  border-radius:7px;
  color:var(--muted);
  cursor:pointer;
  transition:all .15s ease;
  flex-shrink:0;
}
.sb-collapse-btn .icon-svg{width:14px;height:14px}
.sb-collapse-btn:hover{
  background:var(--brand);
  border-color:var(--brand);
  color:#fff;
}

/* HOME BUTTON */
.sb-home-btn{
  display:flex;align-items:center;gap:10px;
  margin:12px 12px 4px 12px;
  padding:12px 14px;
  background:linear-gradient(135deg, var(--brand), var(--brand-2));
  color:#fff;
  border-radius:10px;
  font-weight:800;
  font-size:.85rem;
  text-decoration:none;
  transition:all .2s ease;
  box-shadow:0 6px 18px -6px var(--brand);
  flex-shrink:0;
  text-transform:uppercase;
  letter-spacing:.5px;
}
.sb-home-btn:hover{
  transform:translateY(-1px);
  box-shadow:0 10px 24px -6px var(--brand);
  color:#fff;
}
.sb-home-btn .icon-svg{width:16px;height:16px;stroke-width:2.4}

.sb-search{padding:8px 16px 8px;flex-shrink:0}
.sb-search-box{position:relative;display:flex;align-items:center}
.sb-search-box .icon-svg{
  position:absolute;left:12px;color:var(--muted);
  width:14px;height:14px;pointer-events:none;
}
.sb-search-box input{
  width:100%;padding:10px 12px 10px 36px;
  background:var(--sidebar-hover);
  border:1px solid transparent;
  border-radius:9px;
  color:var(--ink);
  font-family:inherit;font-size:.82rem;font-weight:700;outline:none;
  transition:all .2s ease;
}
.sb-search-box input::placeholder{color:var(--muted);opacity:.7;font-weight:600}
.sb-search-box input:focus{
  background:var(--card);
  border-color:var(--brand);
  box-shadow:0 0 0 3px rgba(248,111,3,.12);
}

.sb-body{
  flex:1;overflow-y:auto;padding:8px 12px 20px;
}
.sb-body::-webkit-scrollbar{width:6px}
.sb-body::-webkit-scrollbar-thumb{background:var(--line);border-radius:3px}

.sb-group{
  padding:14px 10px 6px;
  font-size:.68rem;font-weight:800;
  color:var(--muted);letter-spacing:1px;text-transform:uppercase;
}
.sb-item{
  display:flex;align-items:center;gap:11px;
  padding:9px 10px;border-radius:8px;
  font-size:.83rem;font-weight:700;
  color:var(--sidebar-text);text-decoration:none;
  transition:all .15s ease;cursor:pointer;line-height:1.35;
}
.sb-item:hover{
  background:var(--sidebar-hover);
  color:var(--sidebar-text-hover);
}
.sb-item .sb-icon{
  width:26px;height:26px;
  display:grid;place-items:center;
  background:var(--sidebar-hover);
  border-radius:7px;
  color:var(--sidebar-text);flex-shrink:0;
  transition:all .15s ease;
}
.sb-item .sb-icon .icon-svg{width:14px;height:14px;stroke-width:2.4}
.sb-item:hover .sb-icon{
  background:var(--brand-light);color:var(--brand);
}
html[data-theme="dark"] .sb-item:hover .sb-icon{
  background:rgba(248,111,3,.15);color:var(--brand);
}
.sb-item.sb-active{
  background:var(--sidebar-active);
  color:var(--brand);font-weight:800;
}
.sb-item.sb-active .sb-icon{background:var(--brand);color:#fff}
.sb-item.sb-logout{color:#E53935;margin-top:6px}
.sb-item.sb-logout .sb-icon{background:#FFEBEE;color:#E53935}
.sb-item.sb-logout:hover{background:#FFEBEE;color:#C62828}
.sb-item.sb-logout:hover .sb-icon{background:#E53935;color:#fff}
html[data-theme="dark"] .sb-item.sb-logout{color:#FF6B6B}
html[data-theme="dark"] .sb-item.sb-logout .sb-icon{background:rgba(229,57,53,.15);color:#FF6B6B}

/* ============ TOPNAV ============ */
.topnav{
  position:fixed;top:0;left:var(--sidebar-w);right:0;
  height:var(--topnav-h);
  background:var(--topnav-bg);
  backdrop-filter:blur(14px) saturate(180%);
  -webkit-backdrop-filter:blur(14px) saturate(180%);
  border-bottom:1px solid var(--line);
  z-index:50;
  display:flex;align-items:center;padding:0 24px;gap:16px;
  transition:left .3s cubic-bezier(.4,0,.2,1),background .3s ease,border-color .3s ease;
}
.tn-toggle{
  display:none;width:36px;height:36px;
  background:transparent;border:1px solid var(--line);
  border-radius:9px;color:var(--ink);cursor:pointer;
  place-items:center;
}
.tn-toggle .icon-svg{width:16px;height:16px}
.tn-menu-btn{
  display:grid;place-items:center;
  width:36px;height:36px;
  background:var(--sidebar-hover);
  border:1px solid var(--line);
  border-radius:9px;color:var(--ink);
  cursor:pointer;
  transition:all .15s ease;
}
.tn-menu-btn .icon-svg{width:16px;height:16px;stroke-width:2.4}
.tn-menu-btn:hover{
  background:var(--brand);border-color:var(--brand);color:#fff;
}
.tn-title{
  font-size:.85rem;font-weight:900;color:var(--ink);
  display:flex;align-items:center;gap:8px;
  letter-spacing:-.3px;
}
.tn-title .badge-bank{
  background:rgba(248,111,3,.15);
  color:var(--brand);
  font-size:.62rem;font-weight:800;
  padding:3px 9px;border-radius:999px;
  text-transform:uppercase;letter-spacing:.5px;
  border:1px solid rgba(248,111,3,.3);
}
.tn-right{margin-left:auto;display:flex;align-items:center;gap:10px}
.tn-btn{
  width:36px;height:36px;
  display:grid;place-items:center;
  background:transparent;border:1px solid var(--line);
  border-radius:9px;color:var(--ink);
  cursor:pointer;
  transition:all .15s ease;text-decoration:none;
}
.tn-btn .icon-svg{width:16px;height:16px}
.tn-btn:hover{background:var(--brand);border-color:var(--brand);color:#fff}
.tn-avatar{
  width:36px;height:36px;border-radius:50%;
  background:linear-gradient(135deg,var(--brand),var(--brand-2));
  display:grid;place-items:center;color:#fff;
  font-weight:900;font-size:.85rem;cursor:pointer;
  border:2px solid var(--card);
  box-shadow:0 2px 8px rgba(0,0,0,.08);
}

.new-wrapper{
  margin-left:var(--sidebar-w);
  padding-top:var(--topnav-h);
  transition:margin-left .3s cubic-bezier(.4,0,.2,1);
  min-height:100vh;
}
html.sb-collapsed .new-wrapper{margin-left:0}

.sb-overlay{
  position:fixed;inset:0;
  background:rgba(10,10,10,.4);
  backdrop-filter:blur(2px);
  z-index:55;opacity:0;pointer-events:none;
  transition:opacity .25s ease;
}
html.sb-open .sb-overlay{opacity:1;pointer-events:auto}

@media (max-width:900px){
  .sidebar{transform:translateX(-100%);box-shadow:0 0 40px rgba(0,0,0,.1)}
  html.sb-open .sidebar{transform:translateX(0)}
  .topnav{left:0}
  .tn-toggle{display:grid;place-items:center}
  .tn-menu-btn{display:none}
  .new-wrapper{margin-left:0}
  .sb-collapse-btn{display:none}
}
</style>

<script>
(function(){
  try{
    // ✅ Default DARK theme
    var t = localStorage.getItem('eis-theme');
    if(!t){
      t = 'dark';
      localStorage.setItem('eis-theme', 'dark');
    }
    document.documentElement.setAttribute('data-theme', t);

    // ✅ Sidebar state
    var sbClosed = localStorage.getItem('eis-sidebar-closed');
    if (sbClosed === 'true') {
      document.documentElement.classList.add('sb-collapsed');
    }
  }catch(e){}
})();
</script>


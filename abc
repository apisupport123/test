      <span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        <%= totalEmp %> Employees
      </span>
      <span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <%= noOfDays %> Days
      </span>
      <span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <%= username %>
      </span>
    </div>
  </div>

  <div class="header-right">
    <form method="get" style="display:flex;gap:8px;align-items:center;">
      <div class="month-picker">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <select name="month" id="month">
          <option value="">Month</option>
          <% for (int m = 1; m <= 12; m++) {
              String mn = String.format("%02d", m);
              String sel = (m == month) ? "selected" : "";
              String[] mNames = {"","Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"};
          %>
          <option value="<%= mn %>" <%= sel %>><%= mNames[m] %></option>
          <% } %>
        </select>
        <input type="number" name="year" min="2024" max="2100" value="<%= selectedYear %>" required>
      </div>
      <input type="hidden" name="m_strroles" value="<%= m_strroles %>">
      <input type="hidden" name="username" value="<%= username %>">
      <button type="submit" class="btn-header btn-primary-header">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        View
      </button>
    </form>
  </div>
</header>

<!-- ============ STATS BAR ============ -->
<section class="stats-bar">
  <div class="stat-box">
    <div class="st-lbl">Total Employees</div>
    <div class="st-val primary"><%= totalEmp %></div>
  </div>
  <div class="stat-box">
    <div class="st-lbl">Days in Month</div>
    <div class="st-val"><%= noOfDays %></div>
  </div>
  <div class="stat-box">
    <div class="st-lbl">Team</div>
    <div class="st-val primary" style="font-size:1rem;margin-top:8px;"><%= m_strroles %></div>
  </div>
  <div class="stat-box">
    <div class="st-lbl">Period</div>
    <div class="st-val" style="font-size:1rem;margin-top:8px;"><%= nameOfMonth %> <%= selectedYear %></div>
  </div>
</section>

<!-- ============ LEGEND ============ -->
<section class="legend-bar">
  <span class="legend-label">Shift Legend:</span>
  <span class="legend-item"><span class="legend-dot morning"></span>Morning</span>
  <span class="legend-item"><span class="legend-dot general"></span>General</span>
  <span class="legend-item"><span class="legend-dot afternoon"></span>Afternoon</span>
  <span class="legend-item"><span class="legend-dot night"></span>Night</span>
  <span class="legend-item"><span class="legend-dot weekoff"></span>Weekoff</span>
  <span class="legend-item"><span class="legend-dot leave"></span>Leave</span>
  <span class="legend-item"><span class="legend-dot flexi"></span>Flexi</span>
  <span class="legend-item"><span class="legend-dot holiday"></span>Holiday</span>
</section>

<!-- ============ SEARCH BAR ============ -->
<section class="search-bar">
  <div class="search-box">
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="text" id="searchInput" placeholder="Search employee by name or position..." oninput="filterEmployees()">
  </div>
  <div class="search-info" id="searchInfo">Showing <b><%= totalEmp %></b> employees</div>
</section>

<!-- ============ ROSTER TABLE ============ -->
<form id="rosterForm" method="post" action="<%=request.getContextPath()%>/RosterServlet">
<input type="hidden" name="tableData" id="tableData">
<input type="hidden" name="m_strroles" value="<%= m_strroles %>">
<input type="hidden" name="username" value="<%= username %>">
<input type="hidden" name="selectedMonth" value="<%= selectedMonth %>">
<input type="hidden" name="selectedYear" value="<%= selectedYear %>">

<div class="roster-wrap">
<% if (totalEmp == 0) { %>
  <div class="empty-state">
    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    <h3>No Employees Found</h3>
    <p>No active employees found in team <b><%= m_strroles %></b>.</p>
  </div>
<% } else { %>

<table class="roster-table" id="rosterTable">
  <thead>
    <tr>
      <th class="emp-col">Employee</th>
      <th class="pos-col">Position</th>
      <% for (int d = 1; d <= noOfDays; d++) {
          LocalDate curDate = LocalDate.of(year, month, d);
          DayOfWeek dow = curDate.getDayOfWeek();
          boolean isWeekend = (dow == DayOfWeek.SATURDAY || dow == DayOfWeek.SUNDAY);
          String dayShort = dow.getDisplayName(TextStyle.SHORT, Locale.ENGLISH);
      %>
      <th class="<%= isWeekend ? "weekend-header" : "" %>" title="<%= curDate %> - <%= dayShort %>">
        <%= d %><br><span style="font-size:.6rem;opacity:.7;"><%= dayShort %></span>
      </th>
      <% } %>
      <th title="Weekoffs">WO</th>
      <th title="Leaves">LV</th>
    </tr>
  </thead>
  <tbody>
    <% for (int i = 0; i < employees.size(); i++) {
        Map<String,Object> emp = employees.get(i);
        String name = (String) emp.get("name");
        String pos = (String) emp.get("position");
        String initial = (name != null && name.length() > 0) ? name.substring(0,1).toUpperCase() : "?";
    %>
    <tr class="emp-row" data-name="<%= name != null ? name.toLowerCase() : "" %>" data-pos="<%= pos != null ? pos.toLowerCase() : "" %>">
      <td class="emp-col">
        <div class="emp-cell">
          <div class="emp-avatar"><%= initial %></div>
          <div class="emp-name">
            <%= name %>
            <input type="hidden" name="employeeName" value="<%= name %>">
            <input type="hidden" name="adId" value="<%= emp.get("adId") %>">
          </div>
        </div>
      </td>
      <td class="pos-col">
        <% if (pos != null) { %>
          <%= pos %>
          <input type="hidden" name="position_<%= i %>" value="<%= pos %>">
        <% } else { %>
          <span style="color:var(--muted);font-size:.72rem;">-</span>
          <input type="hidden" name="position_<%= i %>" value="">
        <% } %>
      </td>
      <%
        int woCount = 0, lvCount = 0;
        for (int d = 1; d <= noOfDays; d++) {
          String shift = (String) emp.get("day_" + d);
          String shiftLc = (shift != null) ? shift.toLowerCase() : "";

          String cls = "general";
          String label = shift != null ? shift : "-";
          if (shiftLc.contains("morning")) { cls = "morning"; label = "M"; }
          else if (shiftLc.contains("general") || shiftLc.contains("genral")) { cls = "general"; label = "D"; }
          else if (shiftLc.contains("afternoon")) { cls = "afternoon"; label = "A"; }
          else if (shiftLc.contains("night")) { cls = "night"; label = "N"; }
          else if (shiftLc.contains("weekoff")) { cls = "weekoff"; label = "W"; woCount++; }
          else if (shiftLc.contains("leave")) { cls = "leave"; label = "L"; lvCount++; }
          else if (shiftLc.contains("flexi")) { cls = "flexi"; label = "F"; }
          else if (shiftLc.contains("holiday")) { cls = "holiday"; label = "H"; }
          else if (shiftLc.equals("na") || shiftLc.trim().isEmpty()) { cls = "na"; label = "-"; }

          String tooltip = (shift != null) ? shift : "Not Set";
      %>
      <td>
        <span class="shift-badge <%= cls %>" title="<%= tooltip %>"><%= label %></span>
        <input type="hidden" name="mnt_<%= i %>_<%= d %>" value="<%= shift != null ? shift : "" %>">
      </td>
      <% } %>
      <td style="font-weight:900;color:var(--weekoff);"><%= woCount %></td>
      <td style="font-weight:900;color:var(--leave);"><%= lvCount %></td>
    </tr>
    <% } %>

    <!-- ============ SUMMARY ROWS ============ -->
    <tr class="summary-row">
      <td class="emp-col">Morning Total</td>
      <td class="pos-col"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int cnt = 0;
          for (Map<String,Object> emp : employees) {
              String s = (String) emp.get("day_" + d);
              if (s != null && s.toLowerCase().contains("morning")) cnt++;
          }
      %>
      <td><%= cnt %></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
    <tr class="summary-row">
      <td class="emp-col">General Total</td>
      <td class="pos-col"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int cnt = 0;
          for (Map<String,Object> emp : employees) {
              String s = (String) emp.get("day_" + d);
              if (s != null && (s.toLowerCase().contains("general") || s.toLowerCase().contains("genral"))) cnt++;
          }
      %>
      <td><%= cnt %></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
    <tr class="summary-row">
      <td class="emp-col">Afternoon Total</td>
      <td class="pos-col"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int cnt = 0;
          for (Map<String,Object> emp : employees) {
              String s = (String) emp.get("day_" + d);
              if (s != null && s.toLowerCase().contains("afternoon")) cnt++;
          }
      %>
      <td><%= cnt %></td>
      <% } %>
      <td colspan="2"></td>
    </tr>
    <tr class="summary-row">
      <td class="emp-col">Night Total</td>
      <td class="pos-col"></td>
      <% for (int d = 1; d <= noOfDays; d++) {
          int cnt = 0;
          for (Map<String,Object> emp : employees) {
              String s = (String) emp.get("day_" + d);
              if (s != null && s.toLowerCase().contains("night")) cnt++;
          }
      %>
      <td><%= cnt %></td>
      <% } %>
      <td colspan="2"></td>
    </tr>

  </tbody>
</table>
<% } %>
</div>

<!-- ============ FOOTER ACTIONS ============ -->
<div class="footer-actions">
  <div class="footer-info">
    <b><%= m_strroles %></b> &middot; <%= nameOfMonth %> <%= selectedYear %> &middot; <%= totalEmp %> employees
  </div>
  <div>
    <% if (year > YearMonth.now().getYear() || (year == YearMonth.now().getYear() && month >= YearMonth.now().getMonthValue())) { %>
      <button type="button" class="btn-primary" onclick="prepareData()">
        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
        Submit Roster
      </button>
    <% } else { %>
      <span class="footer-info" style="color:var(--warning);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" style="vertical-align:middle;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        Past month - read only
      </span>
    <% } %>
  </div>
</div>
</form>

<script>
function filterEmployees() {
  var input = document.getElementById('searchInput').value.toLowerCase();
  var rows = document.querySelectorAll('.emp-row');
  var visible = 0;
  rows.forEach(function(row) {
    var name = row.getAttribute('data-name') || '';
    var pos = row.getAttribute('data-pos') || '';
    if (name.includes(input) || pos.includes(input)) {
      row.style.display = '';
      visible++;
    } else {
      row.style.display = 'none';
    }
  });
  document.getElementById('searchInfo').innerHTML = 'Showing <b>' + visible + '</b> employees';
}

function prepareData() {
  document.getElementById('rosterForm').action = '<%=request.getContextPath()%>/RosterServlet';
  document.getElementById('rosterForm').submit();
}
</script>

</body>
</html>

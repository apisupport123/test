<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    background: #03040a;
    color: #fff;
    font-family: 'Inter', sans-serif;
  }

  /* subtle radial backdrop for depth */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(circle at 20% 0%, rgba(99, 102, 241, 0.10), transparent 45%),
      radial-gradient(circle at 80% 100%, rgba(139, 92, 246, 0.08), transparent 45%);
    pointer-events: none;
    z-index: 0;
  }

  .app {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    height: 100vh;
    width: 100vw;
  }

  /* ============================================================
     TOPBAR
     ============================================================ */
  .topbar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: stretch;
    gap: 16px;
    padding: 10px 20px;
    background: linear-gradient(180deg, #0b0d18 0%, #070912 100%);
    border-bottom: 1px solid #1c2030;
    flex-shrink: 0;
    box-shadow: 0 4px 20px rgba(0,0,0,0.5);
  }

  /* Timer block */
  .timer-block {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .timer-label {
    font-size: 14px;
    font-weight: 700;
    color: #8b90b0;
    text-transform: uppercase;
    letter-spacing: 1px;
    line-height: 1.25;
  }
  .timer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 110px;
    padding: 6px 14px;
    border: 3px solid #6366f1;
    border-radius: 8px;
    color: #fff;
    font-family: 'Courier New', monospace;
    font-size: 32px;
    font-weight: 900;
    background: rgba(99, 102, 241, 0.10);
    letter-spacing: 1px;
    line-height: 1;
    box-shadow:
      0 0 20px rgba(99, 102, 241, 0.35),
      inset 0 0 12px rgba(99, 102, 241, 0.15);
    transition: all 0.3s;
  }
  .timer.low {
    border-color: #ef4444;
    background: rgba(239, 68, 68, 0.15);
    box-shadow:
      0 0 20px rgba(239, 68, 68, 0.6),
      inset 0 0 12px rgba(239, 68, 68, 0.2);
    animation: blinkRed 1s infinite;
  }
  @keyframes blinkRed {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.55; }
  }

  /* KPI row */
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .kpi {
    background: #0a0d1a;
    border: 1px solid #1c2030;
    border-radius: 8px;
    padding: 8px 14px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
    transition: all 0.4s;
  }
  .kpi::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: #1c2030;
  }
  .kpi.crit::before { background: #ef4444; box-shadow: 0 0 12px #ef4444; }
  .kpi.warn::before { background: #f59e0b; box-shadow: 0 0 12px #f59e0b; }
  .kpi.good::before { background: #10b981; box-shadow: 0 0 12px #10b981; }

  .kpi-label {
    font-size: 11px;
    font-weight: 700;
    color: #8b90b0;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    white-space: nowrap;
  }
  .kpi-value {
    font-family: 'Courier New', monospace;
    font-size: 34px;
    font-weight: 900;
    line-height: 1;
    margin-top: 4px;
    letter-spacing: -1px;
    color: #fff;
  }
  .kpi-value.red {
    color: #ef4444;
    text-shadow: 0 0 15px rgba(239, 68, 68, 0.6);
    animation: pulseRed 2s ease-in-out infinite;
  }
  .kpi-value.orange {
    color: #f59e0b;
    text-shadow: 0 0 15px rgba(245, 158, 11, 0.5);
  }
  .kpi-value.green {
    color: #10b981;
    text-shadow: 0 0 15px rgba(16, 185, 129, 0.5);
  }
  @keyframes pulseRed {
    0%, 100% {
      text-shadow: 0 0 15px rgba(239, 68, 68, 0.6);
      opacity: 1;
    }
    50% {
      text-shadow: 0 0 25px rgba(239, 68, 68, 0.9);
      opacity: 0.8;
    }
  }

  /* Right block */
  .right-block {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sev-chips { display: flex; gap: 6px; }
  .sev-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    background: #0a0d1a;
    border: 1px solid #1c2030;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
  }
  .sev-dot {
    width: 9px;
    height: 9px;
    border-radius: 2px;
  }

  .live-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    color: #10b981;
    letter-spacing: 1.5px;
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.25);
    animation: livePulse 2s ease-in-out infinite;
  }
  .live-badge .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: pulseDot 1.5s infinite;
  }
  @keyframes livePulse {
    0%, 100% { box-shadow: 0 0 15px rgba(16, 185, 129, 0.25); }
    50%      { box-shadow: 0 0 25px rgba(16, 185, 129, 0.6); }
  }
  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.4; transform: scale(0.8); }
  }

  /* ============================================================
     CRITICAL CHIPS BAR
     ============================================================ */
  .crit-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px;
    background: linear-gradient(180deg, #070912 0%, #05070f 100%);
    border-bottom: 1px solid #1c2030;
    flex-shrink: 0;
    overflow-x: auto;
  }
  .crit-bar::-webkit-scrollbar { height: 3px; }
  .crit-bar::-webkit-scrollbar-thumb { background: #1c2030; border-radius: 2px; }

  .crit-bar .title {
    font-size: 12px;
    font-weight: 800;
    color: #ef4444;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    white-space: nowrap;
    padding-right: 12px;
    border-right: 1px solid #1c2030;
    flex-shrink: 0;
    text-shadow: 0 0 10px rgba(239, 68, 68, 0.5);
  }

  .crit-chip {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
    background: linear-gradient(180deg, rgba(239, 68, 68, 0.10), rgba(239, 68, 68, 0.04));
    border: 1px solid rgba(239, 68, 68, 0.30);
    border-radius: 8px;
    white-space: nowrap;
    flex-shrink: 0;
    animation: chipPulse 3s ease-in-out infinite;
    transition: transform 0.2s;
  }
  .crit-chip:nth-child(2) { animation-delay: 0s; }
  .crit-chip:nth-child(3) { animation-delay: 0.4s; }
  .crit-chip:nth-child(4) { animation-delay: 0.8s; }
  .crit-chip:nth-child(5) { animation-delay: 1.2s; }
  .crit-chip:nth-child(6) { animation-delay: 1.6s; }

  @keyframes chipPulse {
    0%, 100% {
      border-color: rgba(239, 68, 68, 0.30);
      box-shadow: 0 0 0px rgba(239, 68, 68, 0);
    }
    50% {
      border-color: rgba(239, 68, 68, 0.65);
      box-shadow: 0 0 14px rgba(239, 68, 68, 0.35);
    }
  }

  .crit-chip .name {
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    max-width: 170px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .crit-chip .pct {
    font-family: 'Courier New', monospace;
    font-size: 20px;
    font-weight: 900;
    color: #ef4444;
    text-shadow: 0 0 10px rgba(239, 68, 68, 0.5);
  }

  /* ============================================================
     CHART AREA
     ============================================================ */
  .chart-area {
    flex: 1;
    min-height: 0;
    padding: 8px;
    background: #03040a;
  }
  #myChart {
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at 50% 100%, #0d1020 0%, #05070f 100%);
    border: 1px solid #1c2030;
    border-radius: 10px;
    box-shadow:
      0 0 40px rgba(99, 102, 241, 0.08),
      inset 0 0 40px rgba(0, 0, 0, 0.5);
  }

  /* Responsive */
  @media (max-width: 1280px) {
    .timer-label { font-size: 12px; }
    .timer { font-size: 26px; min-width: 95px; }
    .kpi-value { font-size: 28px; }
    .sev-chip { padding: 4px 8px; font-size: 10px; }
  }
  @media (max-width: 900px) {
    .topbar { grid-template-columns: 1fr 1fr; gap: 10px; }
    .right-block { display: none; }
    .kpi-row { grid-column: span 2; grid-template-columns: repeat(2, 1fr); }
  }
</style>

</head>


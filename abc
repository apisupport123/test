<script>
/* ============================================================
   ✅ LOGOUT HANDLER — sabse pehle register karo (capture phase)
   ============================================================ */
document.addEventListener('click', function(e){
  // Logout link ya home button dhoondo
  var target = e.target.closest('.sb-logout, a[href*="login.action"], .sb-home-btn, a[href*="userhomescreen.action"]');

  if(target){
    e.preventDefault();
    e.stopPropagation();

    // ✅ Logout flag set — back-block disable
    window.__logoutInProgress = true;

    // Storage clear
    try{
      sessionStorage.clear();
      localStorage.removeItem('eis-sidebar-closed');
    }catch(err){}

    // Check karo: logout ya home
    var isLogout = target.classList.contains('sb-logout') 
                || (target.href && target.href.indexOf('login.action') !== -1);

    if(isLogout){
      // ✅ Logout — session invalidate hoga
      window.location.replace('<%=request.getContextPath()%>/login.action?logout=true');
    } else {
      // ✅ Home button — same page reload
      window.location.href = '<%=request.getContextPath()%>/userhomescreen.action';
    }
  }
}, true);  // ← 'true' matlab capture phase — kisi aur script se pehle chalega

/* ============================================================
   ✅ BACK BUTTON BLOCK — logout exception ke saath
   ============================================================ */
(function(){
  window.history.pushState({ page: 'home' }, '', window.location.href);

  window.addEventListener('popstate', function(e){
    // Agar logout ho raha hai toh block mat karo
    if(window.__logoutInProgress === true) return;
    // Warna back block karo
    window.history.pushState({ page: 'home' }, '', window.location.href);
  });
})();
</script>


<div class="field">
    <label class="field-label"><span class="dot"></span>State / Province</label>
    <select class="field-select" name="m_strstate" id="m_strstate">
        <option value="">Select State</option>
        <%
            String[] chinaStates = {
                "Anhui", "Beijing", "Chongqing", "Fujian", "Gansu",
                "Guangdong", "Guangxi", "Guizhou", "Hainan", "Hebei",
                "Heilongjiang", "Henan", "Hong Kong", "Hubei", "Hunan",
                "Inner Mongolia", "Jiangsu", "Jiangxi", "Jilin", "Liaoning",
                "Macau", "Ningxia", "Qinghai", "Shaanxi", "Shandong",
                "Shanghai", "Shanxi", "Sichuan", "Taiwan", "Tianjin",
                "Tibet", "Xinjiang", "Yunnan", "Zhejiang"
            };
            String currentState = emp.getM_strState() != null ? emp.getM_strState() : "";
            for (String s : chinaStates) {
        %>
            <option value="<%=s%>" <%=s.equals(currentState) ? "selected" : ""%>><%=s%></option>
        <% } %>
    </select>
</div>

<%@page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%
 response.setHeader("Cache-Control", "no-cache, no-store, must-revalidate");
 response.setHeader("Pragma", "no-cache");
 response.setDateHeader("Expires", 0);
%>
<%@ taglib prefix="s" uri="/struts-tags" %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>EIS Portal — Sign In</title>
<script src="<%=request.getContextPath()%>/js/jquery.min.js"></script>
<style>
:root{
  --brand:#F86F03;
  --brand-2:#FF9A3D;
  --brand-light:#FFF4EC;
  --ink:#0A0A0A;
  --muted:#6B7280;
  --line:#EAEAEA;
  --bg:#F7F7F5;
  --card:#FFFFFF;
  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}
html[data-theme="dark"]{
  --ink:#F5F5F5;
  --muted:#9CA3AF;
  --line:#272727;
  --bg:#0F0F0F;
  --card:#161616;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--font-stack);
  font-weight:700;
  background:var(--bg);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  transition:background .3s ease,color .3s ease;
  min-height:100vh;
}
a{color:inherit;text-decoration:none}
h1,h2,h3,h4,h5,h6,strong,b{font-weight:800;letter-spacing:-.3px}

.icon-svg{
  width:16px;height:16px;
  display:inline-block;flex-shrink:0;
  stroke:currentColor;fill:none;
  stroke-width:2.2;
  stroke-linecap:round;stroke-linejoin:round;
}

/* ============ LOGIN SHELL ============ */
.login-shell{
  min-height:100vh;
  display:grid;
  grid-template-columns: 1.05fr 1fr;
}

/* LEFT — Brand panel */
.brand-side{
  background:linear-gradient(135deg, #F86F03 0%, #FF9A3D 100%);
  padding:48px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  position:relative;
  overflow:hidden;
  color:#fff;
}
.brand-side::before{
  content:"";position:absolute;
  top:-100px;right:-100px;
  width:400px;height:400px;
  border-radius:50%;
  background:rgba(255,255,255,.08);
}
.brand-side::after{
  content:"";position:absolute;
  bottom:-150px;left:-80px;
  width:350px;height:350px;
  border-radius:50%;
  background:rgba(255,255,255,.06);
}

.brand-logo{
  display:flex;align-items:center;gap:12px;
  font-weight:900;font-size:1.15rem;
  letter-spacing:-.3px;
  position:relative;z-index:2;
  text-transform:uppercase;
}
.brand-logo-mark{
  width:40px;height:40px;
  background:#fff;
  color:var(--brand);
  display:grid;place-items:center;
  border-radius:10px;
  box-shadow:0 8px 24px rgba(0,0,0,.15);
}
.brand-logo-mark .icon-svg{width:18px;height:18px;stroke-width:2.4}

.brand-content{
  position:relative;z-index:2;
  max-width:440px;
}
.brand-content h1{
  font-size:2.6rem;
  font-weight:900;
  line-height:1.15;
  letter-spacing:-1px;
  margin-bottom:20px;
}
.brand-content p{
  font-size:1rem;
  line-height:1.7;
  opacity:.95;
  font-weight:700;
}

.brand-features{
  display:flex;
  flex-direction:column;
  gap:14px;
  margin-top:32px;
}
.feature{
  display:flex;align-items:center;gap:12px;
  font-size:.9rem;
  font-weight:700;
  opacity:.98;
}
.feature .ficon{
  width:26px;height:26px;
  display:grid;place-items:center;
  background:rgba(255,255,255,.2);
  border-radius:7px;
  flex-shrink:0;
}
.feature .ficon .icon-svg{width:14px;height:14px;stroke-width:2.6}

.brand-footer{
  position:relative;z-index:2;
  font-size:.8rem;
  opacity:.9;
  font-weight:700;
}

/* RIGHT — Form panel */
.form-side{
  display:flex;
  align-items:center;
  justify-content:center;
  padding:48px;
  background:var(--card);
}
.form-wrap{
  width:100%;
  max-width:400px;
}

.form-head h2{
  font-size:1.85rem;
  font-weight:900;
  letter-spacing:-.6px;
  margin-bottom:8px;
  color:var(--ink);
}
.form-head p{
  color:var(--muted);
  font-size:.92rem;
  margin-bottom:32px;
  font-weight:700;
}

.tabs{
  display:flex;
  gap:4px;
  background:var(--bg);
  padding:4px;
  border-radius:12px;
  margin-bottom:28px;
  border:1px solid var(--line);
}
.tab{
  flex:1;
  padding:10px;
  border:none;
  background:transparent;
  color:var(--muted);
  font-family:inherit;
  font-size:.85rem;
  font-weight:800;
  border-radius:8px;
  cursor:pointer;
  transition:all .2s ease;
  display:flex;align-items:center;justify-content:center;gap:8px;
  text-transform:uppercase;
  letter-spacing:.5px;
}
.tab .icon-svg{width:14px;height:14px}
.tab.active{
  background:var(--card);
  color:var(--brand);
  box-shadow:0 2px 8px rgba(0,0,0,.06);
}

.field{margin-bottom:18px}
.field label{
  display:block;
  font-size:.78rem;
  font-weight:800;
  color:var(--ink);
  margin-bottom:8px;
  text-transform:uppercase;
  letter-spacing:.6px;
}
.input-box{
  position:relative;
  display:flex;align-items:center;
  border:1.5px solid var(--line);
  background:var(--bg);
  border-radius:11px;
  transition:all .2s ease;
}
.input-box:focus-within{
  border-color:var(--brand);
  background:var(--card);
  box-shadow:0 0 0 4px var(--brand-light);
}
.input-box > .icon-svg{
  color:var(--muted);
  margin-left:14px;
  transition:color .2s ease;
}
.input-box:focus-within > .icon-svg{color:var(--brand)}
.input-box input,
.input-box select{
  flex:1;
  padding:14px 16px 14px 12px;
  background:transparent;
  border:none;
  outline:none;
  font-family:inherit;
  font-size:.92rem;
  font-weight:700;
  color:var(--ink);
  width:100%;
}
.input-box select{
  cursor:pointer;
  appearance:none;
  padding-right:40px;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%236B7280' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
  background-repeat:no-repeat;
  background-position:right 16px center;
}
.input-box input::placeholder{color:var(--muted);font-weight:600;opacity:.7}

.pw-toggle{
  background:transparent;border:none;
  color:var(--muted);
  padding:0 16px;
  cursor:pointer;
  transition:color .2s ease;
  display:grid;place-items:center;
}
.pw-toggle .icon-svg{width:16px;height:16px}
.pw-toggle:hover{color:var(--brand)}

.alert{
  display:none;
  padding:12px 16px;
  border-radius:10px;
  font-size:.85rem;
  font-weight:700;
  margin-bottom:18px;
  align-items:center;gap:10px;
}
.alert.error{display:flex;background:#FEF2F2;color:#B91C1C;border:1px solid #FECACA}
.alert.success{display:flex;background:#F0FDF4;color:#15803D;border:1px solid #BBF7D0}
.alert .icon-svg{width:16px;height:16px}

.btn-primary{
  width:100%;
  padding:15px;
  border:none;
  border-radius:11px;
  background:linear-gradient(135deg, var(--brand), var(--brand-2));
  color:#fff;
  font-family:inherit;
  font-weight:800;
  font-size:.95rem;
  letter-spacing:.5px;
  text-transform:uppercase;
  cursor:pointer;
  transition:all .2s ease;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:10px;
  box-shadow:0 4px 14px rgba(248,111,3,.35);
}
.btn-primary:hover{
  transform:translateY(-1px);
  box-shadow:0 6px 20px rgba(248,111,3,.45);
}
.btn-primary:active{transform:translateY(0)}
.btn-primary:disabled{opacity:.65;cursor:not-allowed;transform:none}

.spinner{
  width:16px;height:16px;
  border:2px solid rgba(255,255,255,.35);
  border-top-color:#fff;
  border-radius:50%;
  animation:spin .7s linear infinite;
  display:none;
}
.btn-primary.loading .spinner{display:block}
@keyframes spin{to{transform:rotate(360deg)}}

.form-view{display:none;animation:fadeIn .3s ease}
.form-view.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

.foot-note{
  margin-top:32px;
  text-align:center;
  font-size:.8rem;
  color:var(--muted);
  font-weight:700;
}
.foot-note a{
  color:var(--brand);
  text-decoration:none;
  font-weight:800;
}

/* ============ QUICK LINKS SECTION ============ */
.quick-links-section{
  grid-column: 1 / -1;
  padding:32px 48px 40px;
  background:var(--bg);
  border-top:1px solid var(--line);
}
.quick-title{
  display:flex;
  align-items:center;
  gap:10px;
  font-size:1rem;
  font-weight:900;
  color:var(--ink);
  margin-bottom:18px;
  text-transform:uppercase;
  letter-spacing:.5px;
}
.quick-title .icon-svg{width:18px;height:18px;color:var(--brand)}

.quick-grid{
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap:12px;
}

.quick-card{
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px 16px;
  background:var(--card);
  border:1.5px solid var(--line);
  border-radius:12px;
  color:var(--ink);
  text-decoration:none;
  font-weight:800;
  font-size:.85rem;
  transition:all .2s ease;
  cursor:pointer;
  position:relative;
}
.quick-card:hover{
  border-color:var(--brand);
  background:var(--brand-light);
  color:var(--brand);
  transform:translateY(-2px);
  box-shadow:0 8px 20px -8px rgba(248,111,3,.35);
}
html[data-theme="dark"] .quick-card:hover{
  background:rgba(248,111,3,.15);
}
.quick-card .qicon{
  width:36px;height:36px;
  display:grid;place-items:center;
  background:var(--brand-light);
  color:var(--brand);
  border-radius:10px;
  flex-shrink:0;
  transition:all .2s ease;
}
html[data-theme="dark"] .quick-card .qicon{
  background:rgba(248,111,3,.15);
}
.quick-card .qicon .icon-svg{width:16px;height:16px;stroke-width:2.4}
.quick-card:hover .qicon{
  background:var(--brand);
  color:#fff;
}
.quick-card .qtext{
  display:flex;
  flex-direction:column;
  gap:2px;
  min-width:0;
  flex:1;
}
.quick-card .qname{
  font-weight:800;
  font-size:.85rem;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.quick-card .qsub{
  font-size:.68rem;
  font-weight:700;
  color:var(--muted);
  text-transform:uppercase;
  letter-spacing:.4px;
}

/* ✅ DROPDOWN CARDS */
.quick-card.dropdown{
  flex-direction:column;
  align-items:stretch;
  padding:0;
  cursor:default;
}
.quick-card.dropdown:hover{
  transform:none;
  box-shadow:0 4px 12px -6px rgba(248,111,3,.2);
}
.quick-card .drop-head{
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px 16px;
  border-bottom:1px solid var(--line);
}
.quick-card .drop-head .qicon{
  width:36px;height:36px;
}
.quick-card .drop-arrow{
  margin-left:auto;
  color:var(--muted);
  transition:transform .25s ease;
}
.quick-card .drop-arrow .icon-svg{width:14px;height:14px}
.quick-card.dropdown.open .drop-arrow{
  transform:rotate(180deg);
}
.quick-card .drop-body{
  display:none;
  flex-direction:column;
}
.quick-card.dropdown.open .drop-body{
  display:flex;
}
.quick-card .drop-item{
  padding:11px 18px;
  font-size:.82rem;
  font-weight:700;
  color:var(--ink);
  text-decoration:none;
  display:flex;
  align-items:center;
  gap:10px;
  transition:all .15s ease;
  border-top:1px solid var(--line);
}
.quick-card .drop-item:hover{
  background:var(--brand-light);
  color:var(--brand);
  padding-left:24px;
}
html[data-theme="dark"] .quick-card .drop-item:hover{
  background:rgba(248,111,3,.15);
}
.quick-card .drop-item .bullet{
  width:6px;height:6px;
  border-radius:50%;
  background:var(--brand);
  flex-shrink:0;
}

/* ============ RESPONSIVE ============ */
@media (max-width: 900px){
  .login-shell{grid-template-columns:1fr}
  .brand-side{padding:36px 28px;min-height:auto}
  .brand-content h1{font-size:1.9rem}
  .brand-features{display:none}
  .form-side{padding:36px 24px}
  .quick-links-section{padding:24px 20px 32px}
}
@media (max-width: 480px){
  .brand-side{padding:28px 22px}
  .brand-content h1{font-size:1.5rem}
  .form-side{padding:28px 20px}
  .form-head h2{font-size:1.5rem}
  .quick-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>

<div class="login-shell">

  <!-- ============ LEFT: BRAND PANEL ============ -->
  <aside class="brand-side">
    <div class="brand-logo">
      <div class="brand-logo-mark">
        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <span>EIS Portal</span>
    </div>

    <div class="brand-content">
      <h1>Enterprise Information Systems</h1>
      <p>One secure gateway to dashboards, monitoring, reports and operational tools — designed for the EIS team.</p>

      <div class="brand-features">
        <div class="feature">
          <span class="ficon"><svg class="icon-svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
          Single sign-on access
        </div>
        <div class="feature">
          <span class="ficon"><svg class="icon-svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
          Real-time monitoring dashboards
        </div>
        <div class="feature">
          <span class="ficon"><svg class="icon-svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></span>
          Enterprise-grade security
        </div>
      </div>
    </div>

    <div class="brand-footer">
      © <%= java.time.Year.now() %> EIS Portal · Internal use only
    </div>
  </aside>

  <!-- ============ RIGHT: FORM PANEL ============ -->
  <main class="form-side">
    <div class="form-wrap">

      <div class="form-head">
        <h2 id="formTitle">Welcome back</h2>
        <p id="formSubtitle">Sign in to continue to your workspace</p>
      </div>

      <div class="tabs">
        <button class="tab active" data-tab="user">
          <svg class="icon-svg" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          User
        </button>
        <button class="tab" data-tab="admin">
          <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Admin
        </button>
      </div>

      <s:form action="login" method="post" theme="simple" id="loginForm">

        <!-- USER FORM -->
        <div class="form-view active" id="view-user">
          <div class="alert error" id="userAlert">
            <svg class="icon-svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span></span>
          </div>

          <div class="field">
            <label>Username</label>
            <div class="input-box">
              <svg class="icon-svg" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <input type="text" placeholder="Enter your username" name="m_strUserName" id="m_strUserName" autocomplete="username" />
            </div>
          </div>

          <div class="field">
            <label>Password</label>
            <div class="input-box">
              <svg class="icon-svg" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <input type="password" placeholder="Enter your password" name="m_struserPassword" id="m_struserPassword" autocomplete="current-password" />
              <button type="button" class="pw-toggle" onclick="togglePw('m_struserPassword', this)">
                <svg class="icon-svg" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <div class="field">
            <label>Role</label>
            <div class="input-box">
              <svg class="icon-svg" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <s:select name="m_strRole" id="m_strRole" list="rolelist" headerKey="" headerValue="Select your role" theme="simple" />
            </div>
          </div>

          <button type="button" class="btn-primary" id="btnUserLogin" onclick="usersign()">
            <span class="spinner"></span>
            <span class="btn-text">Sign In</span>
          </button>
        </div>

        <!-- ADMIN FORM -->
        <div class="form-view" id="view-admin">
          <div class="alert error" id="adminAlert">
            <svg class="icon-svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span></span>
          </div>

          <div class="field">
            <label>Admin Username</label>
            <div class="input-box">
              <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <input type="text" placeholder="Enter admin username" name="m_stradminUserName" id="m_stradminUserName" autocomplete="username" />
            </div>
          </div>

          <div class="field">
            <label>Admin Password</label>
            <div class="input-box">
              <svg class="icon-svg" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <input type="password" placeholder="Enter admin password" name="m_stradminPassword" id="m_stradminPassword" autocomplete="current-password" />
              <button type="button" class="pw-toggle" onclick="togglePw('m_stradminPassword', this)">
                <svg class="icon-svg" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
          </div>

          <button type="button" class="btn-primary" id="btnAdminLogin" onclick="adminsign()">
            <span class="spinner"></span>
            <span class="btn-text">Sign In as Admin</span>
          </button>
        </div>

      </s:form>

      <div class="foot-note">
        Having trouble? <a href="https://www.ultimatix.net/" target="_blank" rel="noopener noreferrer">Contact support</a>
      </div>

    </div>
  </main>

  <!-- ============ QUICK LINKS (RESTORED — 15 items + 2 dropdowns) ============ -->
  <section class="quick-links-section">
    <div class="quick-title">
      <svg class="icon-svg" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
      Quick Links
    </div>

    <div class="quick-grid">

      <!-- 1. Dynatrace -->
      <a class="quick-card" href="https://10.189.37.183/" target="_blank" rel="noopener noreferrer">
        <span class="qicon"><svg class="icon-svg" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></span>
        <span class="qtext">
          <span class="qname">Dynatrace</span>
          <span class="qsub">Monitoring</span>
        </span>
      </a>

      <!-- 2. LB Web UI -->
      <a class="quick-card" href="https://10.188.10.106:2443/login" target="_blank" rel="noopener noreferrer">
        <span class="qicon"><svg class="icon-svg" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></span>
        <span class="qtext">
          <span class="qname">LB Web UI</span>
          <span class="qsub">Load Balancer</span>
        </span>
      </a>

      <!-- 3. SCORE -->
      <a class="quick-card" href="https://score.sbi/" target="_blank" rel="noopener noreferrer">
        <span class="qicon"><svg class="icon-svg" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>
        <span class="qtext">
          <span class="qname">SCORE</span>
          <span class="qsub">Reporting</span>
        </span>
      </a>

      <!-- 4. NSPM (FAR) -->
      <a class="quick-card" href="https://nspm.sbi/algosec/suite/login.html" target="_blank" rel="noopener noreferrer">
